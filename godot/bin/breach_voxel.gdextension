[configuration]

entry_symbol = "breach_voxel_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

windows.editor.x86_64 = "res://bin/libbreach_voxel.windows.template_release.x86_64.dll"
windows.debug.x86_64 = "res://bin/libbreach_voxel.windows.template_release.x86_64.dll"
windows.release.x86_64 = "res://bin/libbreach_voxel.windows.template_release.x86_64.dll"
android.debug.arm64 = "res://bin/libbreach_voxel.android.template_release.arm64.so"
android.release.arm64 = "res://bin/libbreach_voxel.android.template_release.arm64.so"
android.debug.arm32 = "res://bin/libbreach_voxel.android.template_release.arm32.so"
android.release.arm32 = "res://bin/libbreach_voxel.android.template_release.arm32.so"
android.debug.x86_64 = "res://bin/libbreach_voxel.android.template_release.x86_64.so"
android.release.x86_64 = "res://bin/libbreach_voxel.android.template_release.x86_64.so"
linux.debug.x86_64 = "res://bin/libbreach_voxel.linux.template_release.x86_64.so"
linux.release.x86_64 = "res://bin/libbreach_voxel.linux.template_release.x86_64.so"
macos.debug = "res://bin/libbreach_voxel.macos.template_release.universal.dylib"
macos.release = "res://bin/libbreach_voxel.macos.template_release.universal.dylib"
ios.debug = "res://bin/libbreach_voxel.ios.template_release.universal.dylib"
ios.release = "res://bin/libbreach_voxel.ios.template_release.universal.dylib"
