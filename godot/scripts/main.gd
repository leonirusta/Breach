func _start_free_mode() -> void:
	if current_map in Settings.MAPAS_ATRACO:
		_ciudad_tres_equipos()
		return
	Net.choose_team(Net.TEAM_T)
	# BATTLE ROYALE POR ESCUADRAS (Net, "LOS SUBMODOS"): la escuadra la pone el anfitrion al empezar; se espera su
	# respuesta y el jugador se queda con ella (las balas a los bots, las explosiones y los compañeros miran player.team)
	if Net.es_escuadras():
		if Net.is_online() and not Net.es_escuadra(Net.my_team()):
			for _i in 60:
				await get_tree().create_timer(0.05).timeout
				if Net.es_escuadra(Net.my_team()):
					break
		player.apply_team(Net.my_team())
		if not Net.teams_changed.is_connected(_bando_de_red_cambia):
			Net.teams_changed.connect(_bando_de_red_cambia)
		print("[escuadras] %s en la %s" % [_mi_nombre(), Net.nombre_equipo(Net.my_team())])
	else:
		player.apply_team(Net.TEAM_T)
	# CON BOTIN, CADA UNO NACE EN UN SITIO DISTINTO del mapa (ver _aparicion_inicial)
	if hay_botin:
		var sitio := _aparicion_inicial()
		if sitio != Vector3.ZERO:
			player.global_position = _sitio_libre(sitio + Vector3(0, 0.6, 0))
			player.velocity = Vector3.ZERO
			world.set_player_position(player.global_position)
	if Settings.bots_enabled and _me_toca_crear_bots():
		for e in enemies.get_children():
			e.queue_free()
		await get_tree().process_frame
		spawn_enemies()
	# BATTLE ROYALE: con botin se empieza en el avion y se salta (salto_br.gd)
	if hay_botin and SaltoScript.quiere_avion():
		_empezar_salto()
	# EL ATRACO, SOLO DONDE TOCA. Este `_start_heist()` estaba suelto al final, sin comprobar nada: la
	# lista `MAPAS_ATRACO` solo decidia si ir por el camino de los TRES EQUIPOS, y cualquier otro mapa
	# que cayera aqui -o sea, cualquiera sin sitios de bomba ni .dm.json, como nuke, que todavia tiene
	# su `sites` en "pendiente"- acababa con caja fuerte, cubo y terminal en un mapa que no los pide.
	# La lista tiene que mandar en las DOS ramas, no solo en la primera.
	if not (current_map in Settings.MAPAS_ATRACO):
		if hay_botin and is_instance_valid(salto_br):
			hud.flash_message("%s · BATTLE ROYALE: salta, busca botín y no te quedes fuera de la zona" % Settings.map_title(current_map))
		else:
			hud.flash_message("%s · sin objetivo: partida libre" % Settings.map_title(current_map))
		return
	hud.flash_message("%s · ATRACO: busca la caja fuerte" % Settings.map_title(current_map))
	_start_heist()


