				await get_tree().process_frame
				var b_q: float = await medir_p.call(2.5)
				for m in mats_l:
					(m as ShaderMaterial).set_shader_parameter(String(prueba[1]), prueba[3])
				await get_tree().process_frame
				print("[gpupausa]   %s: %+.2f ms" % [prueba[0], b_q - a_q])
			get_tree().quit()
			return
		if "--gpupausaluces" in OS.get_cmdline_user_args():
			var luces_p: Array = []
			var pila_l: Array = [get_tree().root]
