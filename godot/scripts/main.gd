## --mazotrozosfoto (2026-10-11): el mazo contra la pared que tengas delante, golpe a golpe hasta que cede; cuenta los
## bloques antes y despues (sin --mazobloques no tiene que salir ninguno) y fotos en user://mazotrozos_*.png
func _mazo_trozos_foto() -> void:
	await get_tree().create_timer(7.0).timeout
	player.set("invulnerable", true)
	var camd: Camera3D = player.get_node("Head/Camera3D")
	var w: Dictionary = {}
	for x in Weapons.LIST:
		if bool(x.get("melee", false)):
			w = x
	var pared: Dictionary = {}
	for k in 16:
		var ang := k * TAU / 16.0
		var dir := Vector3(cos(ang), -0.1, sin(ang)).normalized()
		var h: Dictionary = world.raycast(camd.global_position, dir, 2.6)
		if h.get("hit", false):
			player.look_at_point(camd.global_position + dir * 3.0)
			pared = h
			break
	if pared.is_empty():
		print("[mazotrozos] sin pared cerca")
		get_tree().quit()
		return
	await get_tree().create_timer(0.3).timeout
	var fwd := -camd.global_transform.basis.z
	pared = world.raycast(camd.global_position, fwd, 3.0)
	var b0 := int(world.get_stats().get("bodies_active", 0))
	var cedio := false
	for g in 6:
		player._mazazo_pared(pared, fwd, w)
		if player._mazo_golpes == 0:
			cedio = true
			break
	await get_tree().create_timer(0.15).timeout
	get_viewport().get_texture().get_image().save_png("user://mazotrozos_1.png")
	await get_tree().create_timer(1.5).timeout
	get_viewport().get_texture().get_image().save_png("user://mazotrozos_2.png")
	await get_tree().create_timer(1.5).timeout
	var b1 := int(world.get_stats().get("bodies_active", 0))
	print("[mazotrozos] cedio %s · bloques antes %d despues %d · trozos vivos %d" % [str(cedio), b0, b1, effects._trozos.size()])
