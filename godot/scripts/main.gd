## --bloquegrandetest (2026-10-11, bug: "al dañar un pedazo gigante ya caido el juego se pausa un instante"): corta las
## paredes a 1 m en un rectangulo (lo de encima cae en bloques gigantes), espera, y le da 10 golpes al mayor midiendo el
## peor fotograma de los 10 siguientes a cada golpe. VX_LOG_RECONSTRUIR=1 dice cuanto cuesta cada parte.
func _bloque_grande_test() -> void:
	await get_tree().create_timer(7.0).timeout
	player.set("invulnerable", true)
	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
	Engine.max_fps = 0
	var corte_y := 0.9
	for a_c in OS.get_cmdline_user_args():
		if String(a_c).begins_with("--cortey="):
			corte_y = float(String(a_c).substr(9))
	for z10 in range(450, 800, 7):
		world.carve_beam(Vector3(8.0, corte_y, z10 * 0.1), Vector3.RIGHT, 40.0, 0.45, 255, true)
	await get_tree().create_timer(12.0).timeout
	var mayor: Dictionary = {}
	for bi in world.bodies_info():
		if mayor.is_empty() or int(bi.voxels) > int(mayor.voxels):
			mayor = bi
	if mayor.is_empty():
		print("[bloquegrande] no cayo nada")
		get_tree().quit()
		return
	print("[bloquegrande] el mayor: %d voxels en %s · congelado %s" % [int(mayor.voxels), str(mayor.pos), str(mayor.congelado)])
	var peores: Array = []
	var base := 0.0
	for f in 30:
		var tb0 := Time.get_ticks_usec()
		await get_tree().process_frame
		base = maxf(base, (Time.get_ticks_usec() - tb0) / 1000.0)
	print("[bloquegrande] peor fotograma SIN golpes (30): %.1f ms" % base)
	for g in 10:
		var p0: Vector3 = mayor.pos
		world.carve_body_near(p0 + Vector3(randf_range(-1, 1), randf_range(-0.5, 0.5), randf_range(-1, 1)), 0.5, 255)
		var peor := 0.0
		for f in 10:
			var t0 := Time.get_ticks_usec()
			await get_tree().process_frame
			peor = maxf(peor, (Time.get_ticks_usec() - t0) / 1000.0)
		peores.append(snappedf(peor, 0.1))
		await get_tree().create_timer(0.3).timeout
		for bi in world.bodies_info():
			if int(bi.voxels) > int(mayor.voxels) * 0.5 and (bi.pos as Vector3).distance_to(p0) < 3.0:
				mayor = bi
	print("[bloquegrande] peor fotograma tras cada golpe (ms): %s" % str(peores))
	get_tree().quit()


