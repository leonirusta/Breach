				b.global_position = Vector3(sitio.x, suelo_y + 6.0, sitio.z)
				b.radio = 4.0
				b.potencia = 255
				b.lanzar(world, null, g, Vector3(sitio.x, suelo_y, sitio.z), 14.0, 0.0, 1.6, Color.GRAY)
				for _f in 90:
					await get_tree().process_frame
				var despues := 0
				for i in range(-6, 7):
					for k in range(-6, 7):
						if int(world.get_material_at(Vector3(sitio.x + i * 0.2, suelo_y - 0.1, sitio.z + k * 0.2))) > 0:
							despues += 1
				print("[golpemanos] roca: suelo solido bajo el impacto %d -> %d (tiene que bajar: rompe)" % [antes, despues])
		for _f in 30:
			await get_tree().process_frame
		print("[golpemanos] %s: explosiones %d (tiene que ser 0) · material bajo antes %d" % [nombre, _explosiones_vistas - e0, suelo0])
	print("[golpemanos] eventos %s" % str(CriaturaScript.eventos))
	get_tree().quit(0)


func _desatasco_test() -> void:
	await get_tree().create_timer(8.0).timeout
	if pve == null:
		print("[desatasco] FALLO: hace falta --map=pve_cuarentena")
		get_tree().quit(1)
		return
	pve.empezar_ya(10)
	var g = null
	for _w in 40:
		await get_tree().create_timer(1.0).timeout
		for c in get_tree().get_nodes_in_group("criaturas"):
			if is_instance_valid(c) and String(c.get("tipo")) == "goliat":
				g = c
		if g != null:
			break
	if g == null:
		print("[desatasco] FALLO: no ha salido el Goliat")
		get_tree().quit(1)
		return
	g.set_physics_process(false)
	var sitio := Vector3(93.0, 1.0, 161.0)
	for f in OS.get_cmdline_user_args():
		if String(f).begins_with("--desatasco="):
			var xyz := String(f).substr(12).split(",")
			sitio = Vector3(float(xyz[0]), float(xyz[1]), float(xyz[2]))
	print("[desatasco] en %s" % str(sitio))
	g.global_position = sitio
	var radio: float = float(g.datos.get("radio", 1.8))
	var alto: float = float(g.datos.get("alto", 6.5))
	var info_cache := {}
	var rompible := func(pt: Vector3) -> bool:
		var m: int = int(world.get_material_at(pt))
		if m <= 0:
			return false
		if not info_cache.has(m):
			info_cache[m] = not bool((world.get_material_info(m) as Dictionary).get("indestructible", false))
		return bool(info_cache[m])
	var cuenta := func() -> Array:
		var anillo := 0
		var suelo := 0
		var x := -radio - 1.2
		while x <= radio + 1.2:
			var z := -radio - 1.2
			while z <= radio + 1.2:
				var dist := Vector2(x, z).length()
				if dist <= radio + 1.2:
					var h := 0.25
					while h <= alto - 0.25:
						if dist > radio * 0.5 and rompible.call(sitio + Vector3(x, h, z)):
							anillo += 1
						h += 0.5
					if dist <= radio and rompible.call(sitio + Vector3(x, -0.25, z)):
						suelo += 1
				z += 0.5
			x += 0.5
		return [anillo, suelo]
	var antes: Array = cuenta.call()
	for _f in 10:
		await get_tree().process_frame
	var expl0 := _explosiones_vistas
	g._romper_t = 0.0
	g._romper_delante(Vector3.FORWARD)
	for _f in 30:
		await get_tree().process_frame
	print("[desatasco] explosiones con fuego durante el golpe: %d (tiene que ser 0: golpea con las manos)" % (_explosiones_vistas - expl0))
	var despues: Array = cuenta.call()
	# DONDE QUEDA: por sector (8) y por altura (baja <2 m, media 2-4,5, alta >4,5), para ajustar el golpe
	var mapa := {}
	var x2 := -radio - 1.2
	while x2 <= radio + 1.2:
		var z2 := -radio - 1.2
		while z2 <= radio + 1.2:
			var dd := Vector2(x2, z2).length()
			if dd <= radio + 1.2 and dd > radio * 0.5:
				var h2 := 0.25
				while h2 <= alto - 0.25:
					if rompible.call(sitio + Vector3(x2, h2, z2)):
						var sec := int(round(rad_to_deg(atan2(z2, x2)) / 45.0)) * 45
						var banda := "baja" if h2 < 2.0 else ("media" if h2 < 4.5 else "alta")
						var clave := "%d°/%s/%.1fm" % [(sec + 360) % 360, banda, dd]
						mapa[clave] = int(mapa.get(clave, 0)) + 1
					h2 += 0.5
			z2 += 0.5
		x2 += 0.5
	var claves := mapa.keys()
	claves.sort()
	print("[desatasco] queda: %s" % str(claves.map(func(k): return "%s x%d" % [k, mapa[k]])))
	print("[desatasco] solido rompible alrededor: %d -> %d · suelo bajo sus pies: %d -> %d" % [
		int(antes[0]), int(despues[0]), int(antes[1]), int(despues[1])])
	var libre: float = 1.0 - float(despues[0]) / maxf(1.0, float(antes[0]))
	print("[desatasco] %s · %s" % [
		("BIEN: se ha quitado el %.0f %% de lo que le encerraba" % (libre * 100.0)) if libre >= 0.6 else ("MAL: solo se ha quitado el %.0f %%" % (libre * 100.0)),
		"BIEN: el suelo no se toca" if int(despues[1]) >= int(antes[1]) else "MAL: ha roto el suelo"])
	get_tree().quit(0)


## --desatascovivo: LO QUE IMPORTA DE VERDAD, ¿SE LIBERA? Se planta al Goliat donde se atasco, al
## jugador al otro lado de la pared -hacia donde estaba el hormigon que le encerraba-, se le deja pensar
## y se mira cuanto se ha movido y cuantas rutas y golpes ha necesitado.
func _desatasco_vivo_test() -> void:
	await get_tree().create_timer(8.0).timeout
	if pve == null:
		print("[vivo] FALLO: hace falta --map=pve_cuarentena")
		get_tree().quit(1)
		return
	pve.empezar_ya(10)
	var g = null
	for _w in 40:
		await get_tree().create_timer(1.0).timeout
		for c in get_tree().get_nodes_in_group("criaturas"):
			if is_instance_valid(c) and String(c.get("tipo")) == "goliat":
				g = c
		if g != null:
			break
	if g == null:
		print("[vivo] FALLO: no ha salido el Goliat")
		get_tree().quit(1)
		return
	var sitio := Vector3(93.0, 1.0, 161.0)
	var angulo := 225.0
	for f in OS.get_cmdline_user_args():
		if String(f).begins_with("--vivoen="):
			var v := String(f).substr(9).split(",")
			sitio = Vector3(float(v[0]), float(v[1]), float(v[2]))
			angulo = float(v[3])
		if String(f) == "--singolpe":
			g.set("_romper_t", 1.0e9)       # se le prohibe romper: se mide SOLO si pasa andando
	print("[vivo] Goliat en %s · jugador hacia %.0f grados" % [str(sitio), angulo])
	g.global_position = sitio
	g.velocity = Vector3.ZERO
	g.diag_fps = true
	# el jugador, al otro lado del obstaculo y a salvo
	if is_instance_valid(player):
		player.invulnerable = true
		var d := Vector3(cos(deg_to_rad(angulo)), 0.0, sin(deg_to_rad(angulo)))
		var destino: Vector3 = sitio + d * 14.0
		var suelo: Dictionary = world.raycast(destino + Vector3.UP * 20.0, Vector3.DOWN, 40.0)
		if bool(suelo.get("hit", false)):
			destino.y = float((suelo["position"] as Vector3).y) + 0.1
		player.global_position = destino
	var paths := 0
	var golpes := 0
	var ms := 0
	var fps_min := 9999.0
	for seg in 10:
		g.dg_paths = 0
		g.dg_us = 0
		g.dg_romper = 0
		var f0 := Engine.get_frames_drawn()
		var t0 := Time.get_ticks_msec()
		await get_tree().create_timer(1.0).timeout
		var fps: float = float(Engine.get_frames_drawn() - f0) / maxf(0.001, (Time.get_ticks_msec() - t0) / 1000.0)
		fps_min = minf(fps_min, fps)
		paths += int(g.dg_paths)
		golpes += int(g.dg_romper)
		ms += int(g.dg_us)
		print("[vivo] t=%ds · se ha movido %.1f m · rutas %d (%.1f ms) · golpes %d" % [
			seg + 1, g.global_position.distance_to(sitio), int(g.dg_paths), int(g.dg_us) / 1000.0, int(g.dg_romper)])
	var movido: float = g.global_position.distance_to(sitio)
	print("[vivo] en 10 s: %.1f m desde el atasco · %d rutas (%.1f ms) · %d golpes" % [movido, paths, ms / 1000.0, golpes])
	print("[vivo] %s" % ("BIEN: se ha liberado" if movido > 3.0 else "MAL: sigue clavado"))
	get_tree().quit(0)


## --dondeatasco: ¿QUE TENIA ALREDEDOR EL GOLIAT DONDE SE ATASCO EN LA PARTIDA DEL USUARIO?
## (93, 1, 161), medido en vivo con --diagfps. Rayos en 16 direcciones a tres alturas.
func _donde_atasco() -> void:
	await get_tree().create_timer(8.0).timeout
	var c := Vector3(93.0, 1.0, 161.0)
	for f in OS.get_cmdline_user_args():
		if String(f).begins_with("--dondeatasco="):
			var xyz := String(f).substr(14).split(",")
			c = Vector3(float(xyz[0]), float(xyz[1]), float(xyz[2]))
	print("[donde] mirando alrededor de %s" % str(c))
	for h in [0.5, 2.5, 5.0]:
		var linea := PackedStringArray()
		for k in 16:
			var a := TAU * float(k) / 16.0
			var d := Vector3(cos(a), 0.0, sin(a))
			var r: Dictionary = world.raycast(c + Vector3.UP * h, d, 6.0)
			if bool(r.get("hit", false)):
				linea.append("%d°:%.1fm(m%d)" % [int(rad_to_deg(a)), float(r["distance"]),
					int(world.get_material_at((r["position"] as Vector3) + d * 0.05))])
		print("[donde] altura %.1f m: %s" % [h, " ".join(linea) if not linea.is_empty() else "nada a menos de 6 m"])
	var vistos := {}
	for h in [0.5, 2.5, 5.0]:
		for k in 16:
			var a2 := TAU * float(k) / 16.0
			var d2 := Vector3(cos(a2), 0.0, sin(a2))
			var r2: Dictionary = world.raycast(c + Vector3.UP * h, d2, 6.0)
			if bool(r2.get("hit", false)):
				vistos[int(world.get_material_at((r2["position"] as Vector3) + d2 * 0.05))] = true
	for m in vistos.keys():
		print("[donde] material %d: %s · %s" % [m, String(world.get_material_name(m)), str(world.get_material_info(m))])
	var abajo: Dictionary = world.raycast(c + Vector3.UP * 2.0, Vector3.DOWN, 6.0)
	print("[donde] suelo bajo el: %s" % (("a %.1f m, material %d" % [float(abajo["distance"]), int(world.get_material_at((abajo["position"] as Vector3) - Vector3.UP * 0.05))]) if bool(abajo.get("hit", false)) else "no hay"))
	get_tree().quit(0)


## --goliatgolpe: EL GOLPE DE DESATASCO, ¿ABRE UN HUECO POR EL QUE QUEPA?
##
## Lo pidio el usuario: "cuando se atasca quiero que rompa el entorno con un golpe". Se busca una pared
## de verdad del mapa, se planta al Goliat pegado a ella mirandola, da UN golpe, y se cuenta cuanto
## solido queda en el volumen que su cuerpo necesita para avanzar (su ancho, su alto, metro y medio
## hacia delante), en cubos de medio metro.
func _goliat_golpe_test() -> void:
	await get_tree().create_timer(8.0).timeout
	if pve == null:
		print("[golpe] FALLO: hace falta --map=pve_cuarentena")
		get_tree().quit(1)
		return
	pve.empezar_ya(10)
	var g = null
	for _w in 40:
		await get_tree().create_timer(1.0).timeout
		for c in get_tree().get_nodes_in_group("criaturas"):
			if is_instance_valid(c) and String(c.get("tipo")) == "goliat":
				g = c
		if g != null:
			break
	if g == null:
		print("[golpe] FALLO: no ha salido el Goliat")
		get_tree().quit(1)
		return
	g.set_physics_process(false)
	var radio: float = float(g.datos.get("radio", 1.8))
	var alto: float = float(g.datos.get("alto", 6.5))
	# UNA PARED, LA MISMA SIEMPRE: el Goliat sale en un sitio al azar, y comparando golpes cada prueba
	# pillaba un muro distinto (18 m en una, 8 m en otra) y no se podia comparar nada. Se parte del
	# punto de salida del jugador, que es fijo.
	var base: Vector3 = world.get_spawn_position()
	var mejor_d := INF
	var dir := Vector3.ZERO
	var punto := Vector3.ZERO
	for k in 16:
		var a := TAU * float(k) / 16.0
		var d := Vector3(cos(a), 0.0, sin(a))
		var r: Dictionary = world.raycast(base + Vector3.UP * 1.5, d, 40.0)
		if bool(r.get("hit", false)) and float(r["distance"]) < mejor_d and float(r["distance"]) > radio + 0.5:
			mejor_d = float(r["distance"])
			dir = d
			punto = r["position"]
	if dir == Vector3.ZERO:
		print("[golpe] FALLO: no hay ninguna pared cerca")
		get_tree().quit(1)
		return
	# delante de la pared, mirandola, SIN TOCARLA: pegado del todo su caja se mete en el muro, entra por
	# la rama de "enterrado" (que revienta alrededor de el y no delante) y no se mide el golpe de verdad
	var pie: Vector3 = Vector3(punto.x, base.y, punto.z) - dir * (radio + 0.3)
	g.global_position = pie
	print("[golpe] enterrado=%s (debe ser false para medir el golpe de frente)" % str(bool(g._blocked_at(pie))))
	var cuenta := func() -> Array:
		var solidos := 0
		var total := 0
		var lado := dir.cross(Vector3.UP).normalized()
		var f := 0.25
		while f <= radio + 1.5:
			var l := -radio + 0.25
			while l <= radio - 0.25:
				var h := 0.25
				while h <= alto - 0.25:
					var c: Vector3 = pie + dir * (radio + f) + lado * l + Vector3.UP * h
					total += 1
					if world.box_solid(c - Vector3(0.24, 0.24, 0.24), c + Vector3(0.24, 0.24, 0.24)):
						solidos += 1
					h += 0.5
				l += 0.5
			f += 0.5
		return [solidos, total]
	var antes: Array = cuenta.call()
	print("[golpe] material de la pared: %d · potencia del golpe: %d" % [
		int(world.get_material_at(punto + dir * 0.1)), int(g.datos.get("potencia_romper", 120))])
	for f in OS.get_cmdline_user_args():
		if String(f).begins_with("--golpepot="):
			g.datos = (g.datos as Dictionary).duplicate()   # viene de una constante: de solo lectura
			g.datos["potencia_romper"] = int(String(f).substr(11))
			print("[golpe] potencia forzada a %d" % int(g.datos["potencia_romper"]))
	g._romper_t = 0.0
	g._romper_delante(dir)
	for _f in 20:
		await get_tree().process_frame
	var despues: Array = cuenta.call()
	print("[golpe] pared a %.1f m · en el paso de su cuerpo (%.1f m de ancho x %.1f de alto): solido %d de %d antes del golpe -> %d despues" % [
		mejor_d, radio * 2.0, alto, int(antes[0]), int(antes[1]), int(despues[0])])
	var queda: float = float(despues[0]) / maxf(1.0, float(antes[0]))
	print("[golpe] %s (queda el %.0f %% de lo que estorbaba)" % [
		"BIEN: cabe por el hueco" if queda <= 0.15 else "MAL: sigue sin caber", queda * 100.0])
	get_tree().quit(0)


## --goliatatasco: ¿CUANTAS RUTAS PIDE UN BICHO ATASCADO?
##
## Medido en vivo con el usuario jugando: el Goliat atascado pedia 44 rutas por segundo, a 35-50 ms cada
## una, y el juego caia a 8 fps. Pasaba cuando la ruta nueva se gastaba al instante -todos sus puntos a
## menos de 0,6 m-, y eso se consigue a proposito poniendo el objetivo JUSTO ENCIMA del bicho.
##
## Se llama a su `_seguir` 120 veces seguidas con un paso de 1/60 s (dos segundos de partida) y se
## cuentan las rutas. Sin enfriamiento: una por tick. Con el: un punado.
func _goliat_atasco_test() -> void:
	await get_tree().create_timer(8.0).timeout
	if pve == null:
		print("[atasco] FALLO: hace falta --map=pve_cuarentena")
		get_tree().quit(1)
		return
	pve.empezar_ya(10)
	var g = null
	for _w in 40:
		await get_tree().create_timer(1.0).timeout
		for c in get_tree().get_nodes_in_group("criaturas"):
			if is_instance_valid(c) and String(c.get("tipo")) == "goliat":
				g = c
		if g != null:
			break
	if g == null:
		print("[atasco] FALLO: no ha salido el Goliat")
		get_tree().quit(1)
		return
	g.set_physics_process(false)          # que no piense por su cuenta mientras se mide
	g.diag_fps = true
	g.dg_paths = 0
	g.dg_us = 0
	var arriba: Vector3 = g.global_position + Vector3(0.2, 6.0, 0.0)
	var t0 := Time.get_ticks_usec()
	for _i in 120:
		g._seguir(arriba, 2.4, 1.0 / 60.0)
	var ms := (Time.get_ticks_usec() - t0) / 1000.0
	print("[atasco] 120 ticks (2 s) con el objetivo encima: %d rutas pedidas · %.1f ms en A* · %.1f ms en total" % [
		int(g.dg_paths), int(g.dg_us) / 1000.0, ms])
	print("[atasco] %s" % ("BIEN: no recalcula en bucle" if int(g.dg_paths) <= 10 else "MAL: recalcula en cada tick"))
	get_tree().quit(0)


