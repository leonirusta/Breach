	for k in ["day_bottom_color", "sunset_bottom_color", "night_bottom_color"]:
		_cielo_mat.set_shader_parameter(k, Color(0.22, 0.06, 0.03))
	_cielo_mat.set_shader_parameter("horizon_color", Color(0.55, 0.14, 0.05))
	_cielo_mat.set_shader_parameter("clouds_bottom_color", Color(0.3, 0.08, 0.04))
	_cielo_mat.set_shader_parameter("clouds_middle_color", Color(0.14, 0.06, 0.05))
	_cielo_mat.set_shader_parameter("clouds_top_color", Color(0.08, 0.05, 0.05))
	_cielo_mat.set_shader_parameter("clouds_weight", 0.85)


## EL ANOCHECER (episodio 7, 2026-10-01): la hora azul. El sol ya se ha ido pero queda luz; cielo azul oscuro y
## morado con el ultimo resplandor en el horizonte, y las luces del mapa (los neones del parque) encendidas. De noche
## cerrada el parque salia negro en las capturas: solo se veia lo que tenia un neon al lado.
func cielo_anochecer(azimut: float) -> void:
	if night:
		set_night(false)
	if raining:
		set_rain(false)
	if _day.is_empty():
		_save_day()
	_cielo_modo = ["anochecer", azimut]
	sun.rotation_degrees = Vector3(-6.0, azimut, 0.0)
	sun.light_color = Color(0.62, 0.52, 0.95)
	sun.light_energy = float(_day["sun_e"]) * 0.32
	_avisar_sol_sombras()
	var e: Environment = env.environment
	e.ambient_light_color = Color(0.46, 0.42, 0.72)
