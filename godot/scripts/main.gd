		var img := get_viewport().get_texture().get_image()
		img.resize(64, 32, Image.INTERPOLATE_BILINEAR)
		var suma := 0.0
		for y in 32:
			for x in 64:
				suma += img.get_pixel(x, y).get_luminance()
		v.append(suma / 2048.0)
	var mn: float = v.min()
	var mx: float = v.max()
	var saltos := 0
	for i in range(1, v.size()):
		if absf(float(v[i]) - float(v[i - 1])) > 0.004:
			saltos += 1
	print("[parpadeo] brillo %.4f..%.4f (variacion %.4f) · saltos entre fotogramas seguidos: %d de 59" % [mn, mx, mx - mn, saltos])
	get_tree().quit()



