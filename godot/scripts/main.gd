## --treparfoto (con --map=muros, tools/generar_mapa_muros.py): LA SUBIDA DE BLENDER CONTRA MUROS DE VERDAD
## (tools/blender/trepar_real_anim.py). Para cada muro el jugador se pone delante y trepa, y cuadro a cuadro
## se mide: cuanto se separan las munecas del canto mientras apoyan, si un pie, una rodilla o la cadera se
## meten en el muro, cuanto tarda y si acaba de pie encima. Fotos de lado: user://trepar_<cm>_<n>.png.
func _trepar_foto() -> void:
	await get_tree().create_timer(3.0).timeout
	var y0 := 0.8
	var cara_x := 8.0
	var altos := [1.3, 1.55, 1.75, 2.3]
	player.invulnerable = true
	for e in enemies.get_children():
		e.queue_free()
	# --primera: lo que ve el jugador (brazos al canto, arma bajada, temblor), con su propia camara
	var primera: bool = "--primera" in OS.get_cmdline_user_args()
	if player.has_method("set_third_person"):
		player.set_third_person(not primera)
	if primera:
		altos = [1.75]
	var cam_prueba := Camera3D.new()
	cam_prueba.fov = 42.0
	add_child(cam_prueba)
	var fotos := [0.15, 0.8, 1.6, 2.4, 3.2, 3.8, 4.3, 4.8, 5.3]
	for ai in altos.size():
		var alto: float = altos[ai]
		var z: float = 2.0 + [1.3, 1.55, 1.75, 2.3].find(alto) * 4.0
		var canto: float = y0 + alto
		player.velocity = Vector3.ZERO
		player.global_position = Vector3(7.45, y0 + 0.02, z)
		player.look = Vector2(-PI * 0.5, 0.0)
		player.rotation.y = -PI * 0.5
		for _f in 20:
			await get_tree().physics_frame
		player.diag_escalon = true
		player.diag_paso = {}
		var ok: bool = player._intentar_trepar()
		player.diag_escalon = false
		var porque: Array = []
		for k3 in player.diag_paso.keys():
			porque.append(String(k3))
		print("[trepar] muro %.2f m: %s · entra por el segundo %.2f del clip · dura %.2f s%s" % [
			alto, "TREPA" if ok else "NO TREPA", float(player._trepa_desde), float(player._trepa_dur),
			("  (" + " · ".join(porque) + ")") if not porque.is_empty() else ""])
		if not ok:
			continue
		# el canto de verdad (el mapa va a voxels de 10 cm: el muro no mide exactamente lo que dice su calle)
		canto = float(player._trepa_borde.y)
		# de tres cuartos desde el lado del jugador: por detras de la cara la camara caia dentro del muro vecino
		cam_prueba.global_position = Vector3(cara_x - 1.9, canto + 0.35, z + 2.6)
		cam_prueba.look_at(Vector3(cara_x + 0.1, canto - 0.35, z), Vector3.UP)
		cam_prueba.current = not primera
		var t := 0.0
		var fi := 0
		var peor_mano := 0.0
		var metido := {}
		var av = player.avatar
		while float(player._trepa_t) >= 0.0 and t < 9.0:
			await get_tree().physics_frame
			t += get_physics_process_delta_time()
			if not primera:
				cam_prueba.current = true
			else:
				player.look.y = -0.35      # mirando un poco abajo, al canto
			if av and av.skeleton:
				var sk: Skeleton3D = av.skeleton
				# despues de la entrada (hasta ahi el cuerpo aun viene de donde lo pillo el salto)
				if float(av.manos_borde_w) > 0.95 and t > 0.35:
					for par in [["hand_r", av._mano_borde_gatillo], ["hand_l", av._mano_borde_apoyo]]:
						var pm: Vector3 = sk.global_transform * sk.get_bone_global_pose(av.bone_idx[par[0]]).origin
						peor_mano = maxf(peor_mano, pm.distance_to(par[1]))
				for b in ["foot_l", "foot_r", "toes_l", "toes_r", "leg_lower_l", "leg_lower_r", "pelvis", "chest"]:
					if not av.bone_idx.has(b):
						continue
					var pb: Vector3 = sk.global_transform * sk.get_bone_global_pose(av.bone_idx[b]).origin
					if pb.x > cara_x + 0.02 and pb.y < canto - 0.03:
						metido[b] = maxf(float(metido.get(b, 0.0)), pb.x - cara_x)
			if fi < fotos.size() and t >= float(fotos[fi]):
				await RenderingServer.frame_post_draw
				get_viewport().get_texture().get_image().save_png("user://trepar_%d_%d.png" % [roundi(alto * 100.0), fi])
				fi += 1
		var tarda := t
		for _f in 30:
			await get_tree().physics_frame
		var p: Vector3 = player.global_position
		await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("user://trepar_%d_%d.png" % [roundi(alto * 100.0), 9])
		var metidos := []
		for b in metido:
			metidos.append("%s %.0f cm" % [b, float(metido[b]) * 100.0])
		print("[trepar]   tarda %.2f s · acaba %.2f m pasado la cara y %.2f m sobre el canto · en el suelo %s · munecas a %.1f cm del canto como mucho · dentro del muro: %s" % [
			tarda, p.x - cara_x, p.y - canto, str(player.is_on_floor()), peor_mano * 100.0,
			"nada" if metidos.is_empty() else ", ".join(metidos)])
	print("[trepar] fotos en %s" % ProjectSettings.globalize_path("user://"))
	get_tree().quit(0)


## LOS TRES EQUIPOS DE LA CIUDAD: tarjetas de eleccion, bases alrededor de la caja, bots repartidos.
## --escalontest (con --map=escalones, tools/generar_mapa_escalones.py): "LAS COSAS DE 1 O 2 VOXELS DEL
## PISO LAS TIENE QUE ESCALAR COMO UNA ESCALERA, Y LAS ESCALERAS NO LAS SUBE BIEN". El jugador anda en
## linea recta por cada calle -con el joystick del movil y con teclado- y se mide: si pasa, cuanto
## tarda, cuanto se frena contra el escalon y cuantos tirones verticales da (subir-bajar-subir).
func _escalon_test() -> void:
	await get_tree().create_timer(3.0).timeout
	var y0 := 0.8
	var calles := [["10 cm", 1.6, 0.1], ["20 cm", 4.4, 0.2], ["30 cm", 7.2, 0.3], ["40 cm", 10.0, 0.4],
		["60 cm", 12.8, 0.6], ["ESCALERA", 15.6, 2.0]]
	# sin bots (en "libre" salen y te matan a mitad de prueba) y sin morir
	player.invulnerable = true
	for e in enemies.get_children():
		e.queue_free()
	print("[escalon] voxel %.2f m" % world.get_voxel_size())
	for zz in [1.6, 15.6]:
		for xx in [5.5, 8.5, 12.0]:
			var r: Dictionary = world.raycast(Vector3(xx, 6.0, zz), Vector3.DOWN, 10.0)
			print("[escalon]   suelo en x=%.1f z=%.1f -> y=%s" % [xx, zz, str(r.position.y) if r.hit else "nada"])
	print("[escalon]   jugador en %s · camara %s" % [str(player.global_position), str(player.get("spectating"))])
	for control in ["joystick", "teclado"]:
		for c in calles:
			player.velocity = Vector3.ZERO
			player.global_position = Vector3(5.5, y0 + 0.05, float(c[1]))
			player.rotation.y = -PI * 0.5
			player.look.x = -PI * 0.5
			player.look.y = 0.0
			for _f in 10:
				await get_tree().physics_frame
			var meta_x: float = 11.2 if String(c[0]) == "ESCALERA" else 8.6
			var arriba_y: float = y0 + float(c[2]) - 0.05
			var t := 0.0
			var paso_t := -1.0
			var min_vel := 99.0
			var tirones := 0
			var sube_prev := 0
			var y_prev: float = player.global_position.y
			var trepo := false
			var en_aire := 0
			var x_prev: float = player.global_position.x
			while t < 6.0:
				if control == "joystick":
					player.touch_move = Vector2(0, -0.6)
				else:
					Input.action_press("move_forward")
				await get_tree().physics_frame
				var dt := get_physics_process_delta_time()
				t += dt
				var p: Vector3 = player.global_position
				if p.x > 7.2 and p.x < meta_x:
					min_vel = minf(min_vel, (p.x - x_prev) / dt)
				x_prev = p.x
				var dy: float = p.y - y_prev
				var sube: int = 1 if dy > 0.004 else (-1 if dy < -0.004 else 0)
				if sube != 0 and sube_prev != 0 and sube != sube_prev:
					tirones += 1
				if sube != 0:
					sube_prev = sube
				y_prev = p.y
				if float(player.get("_trepa_t")) >= 0.0:
					trepo = true
				if not player.is_on_floor() and float(player.get("_escalon_t")) <= 0.0:
					en_aire += 1
				var encima: bool = (p.x >= 11.2) if String(c[0]) == "ESCALERA" else (p.x >= 8.4 and p.x <= 9.1)
				if encima and p.y >= arriba_y and paso_t < 0.0:
					paso_t = t
					break
			player.touch_move = Vector2.ZERO
			Input.action_release("move_forward")
			print("[escalon] %-8s %-9s %s · tarda %s · vel minima al cruzar %.2f m/s · tirones arriba/abajo %d · cuadros 'en el aire' %d%s" % [
				control, String(c[0]), "PASA" if paso_t >= 0.0 else "NO PASA (x %.2f y %.2f)" % [player.global_position.x, player.global_position.y - y0],
				("%.2f s" % paso_t) if paso_t >= 0.0 else "-", maxf(min_vel, 0.0) if min_vel < 99.0 else 0.0,
				tirones, en_aire, " · TREPO" if trepo else ""])
	get_tree().quit(0)


## --interiorfoto: LOS INTERIORES EN PENUMBRA Y LA VISTA QUE SE ADAPTA. Tres fotos: dentro de un
## edificio nada mas entrar (oscuro), dentro con la vista ya adaptada (normal) y en la calle (normal).
func _interior_foto() -> void:
	for _i in 120:
		if heist != null and heist.vault != null:
			break
		await get_tree().create_timer(0.5).timeout
	for e in enemies.get_children():
		e.queue_free()
	player.invulnerable = true
	var sacar := func(nombre: String):
		for _f in 3:
			await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("user://%s.png" % nombre)
		print("[interior] %s · adaptado %.2f · techo %.2f · penumbra dentro %.2f · aclarado fuera %.2f · salida a %.1f m" % [nombre, _vista_adapt, _techo_frac, _interior_oscuro_puesto * (1.0 - _vista_adapt), (_vista - 1.0), _dist_afuera])
	var dentro: Vector3 = heist.vault.global_position + Vector3(0, 0.1, 2.2)
	# en la calle primero, para que la vista este "de fuera"
	# una calle de verdad: se busca alrededor un punto cuyo primer choque desde el cielo este a ras de suelo
	var calle: Vector3 = _ground_near(Vector3(dentro.x + 14.0, 0.6, dentro.z))
	var tam: Vector3 = world.get_world_size()
	for radio in [10.0, 16.0, 22.0, 30.0]:
		var hallado := false
		for ang in 12:
			var pxz: Vector3 = dentro + Vector3(cos(ang * TAU / 12.0), 0, sin(ang * TAU / 12.0)) * radio
			var r0: Dictionary = world.raycast(Vector3(pxz.x, tam.y - 1.0, pxz.z), Vector3.DOWN, tam.y)
			if r0.get("hit", false) and float(r0.position.y) < 1.3:
				calle = r0.position + Vector3(0, 0.05, 0)
				hallado = true
				break
		if hallado:
			break
	player.global_position = calle
	var vc: Vector3 = dentro - calle
	player.look.x = atan2(-vc.x, -vc.z)
	player.look.y = 0.1
	await get_tree().create_timer(6.0).timeout
	await sacar.call("interior_0_calle")
	player.global_position = dentro
	var v: Vector3 = heist.vault.global_position + Vector3(0, 0.8, 0) - (dentro + Vector3(0, 1.6, 0))
	player.look.x = atan2(-v.x, -v.z)
	player.look.y = -0.15
	await get_tree().create_timer(0.5).timeout
	await sacar.call("interior_1_al_entrar")
	await get_tree().create_timer(6.0).timeout
	await sacar.call("interior_2_adaptado")
	# PEGADO A LA SALIDA: un sitio libre, a ras de calle, BAJO TECHO, con cielo a menos de 1,5 m
	var junto := Vector3.ZERO
	var tam2: Vector3 = world.get_world_size()
	for rr in range(2, 40):
		for ang2 in 24:
			var pc: Vector3 = calle + Vector3(cos(ang2 * TAU / 24.0), 0, sin(ang2 * TAU / 24.0)) * float(rr)
			var suelo_r: Dictionary = world.raycast(Vector3(pc.x, calle.y + 2.0, pc.z), Vector3.DOWN, 3.5)
			if not suelo_r.get("hit", false):
				continue
			var pie: Vector3 = suelo_r.position
			if world.box_solid(pie + Vector3(-0.35, 0.15, -0.35), pie + Vector3(0.35, 1.9, 0.35)):
				continue
			if not world.raycast(pie + Vector3(0, 1.9, 0), Vector3.UP, 30.0).get("hit", false):
				continue          # sin techo
			for ang3 in 8:
				var dd := Vector3(cos(ang3 * TAU / 8.0), 0, sin(ang3 * TAU / 8.0))
				var fuera: Vector3 = pie + dd * 1.2
				if not world.raycast(fuera + Vector3(0, 1.9, 0), Vector3.UP, 30.0).get("hit", false) 						and not world.raycast(pie + Vector3(0, 1.4, 0), dd, 1.2).get("hit", false):
					junto = pie
					break
			if junto != Vector3.ZERO:
				break
		if junto != Vector3.ZERO:
			break
	if junto == Vector3.ZERO:
		print("[interior] no encuentro un sitio bajo techo junto a una salida")
		get_tree().quit(0)
		return
	player.global_position = junto + Vector3(0, 0.05, 0)
	player.velocity = Vector3.ZERO
	await get_tree().create_timer(6.0).timeout
	await sacar.call("interior_3_junto_a_la_salida")
	get_tree().quit(0)


## --botsreparto: "MIS BOTS SE QUEDAN SIN HACER NADA". Cada 10 s, durante 60 s, el anfitrion mira cada bot:
## de quien es (quien piensa por el), cuanto se ha movido y cuanta vida tiene. Un bot con dueño que en 10
## s no se mueve NADA estando vivo es un bot abandonado.
func _bots_reparto_test() -> void:
	for _i in 120:
		if team_overlay != null or loading == false:
			break
		await get_tree().create_timer(0.5).timeout
	await get_tree().create_timer(3.0).timeout
	if team_overlay != null:
		Net.choose_team(Net.TEAM_T if (Net.hosting or not Net.is_online()) else Net.TEAM_CT)
		_close_team_select()
	print("[reparto] %s · equipo %s · bots activados %s" % ["HOST" if Net.hosting else "INV", Net.my_team(), str(Settings.bots_enabled)])
	await get_tree().create_timer(20.0).timeout
	var antes := {}
	for ronda in 6:
		var quietos := 0
		var total := 0
		var por_dueno := {}
		for e in enemies.get_children():
			if not is_instance_valid(e) or not ("red_id" in e) or not ("team" in e):
				continue
			var bid := int(e.red_id)
			var dueno := int(Net.duenos_bot.get(bid, 1))
			var movido: float = e.global_position.distance_to(antes.get(bid, e.global_position))
			antes[bid] = e.global_position
			if ronda == 0:
				continue
			total += 1
			var k := str(dueno)
			if not por_dueno.has(k):
				por_dueno[k] = [0, 0]
			por_dueno[k][0] += 1
			if movido < 0.3 and float(e.health) > 0.0:
				quietos += 1
				por_dueno[k][1] += 1
		if ronda > 0:
			print("[reparto] t=%ds · bots %d · QUIETOS 10 s estando vivos %d · por dueño (bots, quietos) %s · jugadores %s · en pie T %d CT %d" % [
				25 + ronda * 10, total, quietos, str(por_dueno), str(Net.players.keys()), Net.en_pie(Net.TEAM_T), Net.en_pie(Net.TEAM_CT)])
		if ronda > 0:
			for e in enemies.get_children():
				if is_instance_valid(e) and "remoto" in e and not e.remoto and "state" in e:
					var d_obj: float = e.global_position.distance_to(e.move_target) if "move_target" in e else -1.0
					print("[reparto]    mio bot %d eq %s estado %s vel %.2f camino %d/%d a %.1f m del destino · objetivo %s · vida %.0f" % [
						int(e.red_id), String(e.team), str(e.state), Vector2(e.velocity.x, e.velocity.z).length(),
						int(e.path_i), (e.path as PackedVector3Array).size(), d_obj,
						("si" if is_instance_valid(e.target) else "no"), float(e.health)])
		await get_tree().create_timer(10.0).timeout
	# Y SI MATO A TODOS LOS BOTS DEL OTRO BANDO, ¿GANO LA RONDA? (anfitrion, o sin red)
	if Net.hosting or not Net.is_online():
		var ronda0 := [Net.score_t, Net.score_ct]
		var fin := [""]
		Net.round_over.connect(func(g, _r): fin[0] = String(g), CONNECT_ONE_SHOT)
		for e in enemies.get_children():
			if is_instance_valid(e) and "team" in e and String(e.team) == Net.TEAM_CT and e.has_method("take_damage"):
				e.take_damage(9999.0)
		await get_tree().create_timer(4.0).timeout
		print("[reparto] estado: round_live %s · bomb_mode %s · equipos personas %s · muertos %s" % [str(Net.round_live), str(bomb_mode), str(Net.players.values().map(func(p): return p.get("team", ""))), str(Net.dead_players)])
		print("[reparto] mato a todos los bots CT: fin de ronda %s (ganador '%s') · marcador antes %s despues %s · en pie CT %d" % [
			str(fin[0] != ""), fin[0], str(ronda0), str([Net.score_t, Net.score_ct]), Net.en_pie(Net.TEAM_CT)])
	get_tree().quit(0)


## --astarpartida: EL A* EN PARTIDA DE VERDAD. En la cuarentena con la oleada 4 (muchos bichos) o en un mapa
## con bots, durante 40 s: cuanto A* se gasta por FOTOGRAMA DE FISICA (el tiron es eso, no la media) y
## cuantos fotogramas se pasan de 16 ms solo en A*. Con --sinturno se desactiva el reparto por turnos.
func _astar_partida() -> void:
	await get_tree().create_timer(4.0).timeout
	player.invulnerable = true
	if pve != null:
		pve.empezar_ya(4)
	await get_tree().create_timer(6.0).timeout
	AstarTurno.peor_us = 0
	AstarTurno.fotogramas_sobre_16 = 0
	AstarTurno.por_quien = {}
	var f0 := Engine.get_physics_frames()
	await get_tree().create_timer(40.0).timeout
	var frames := Engine.get_physics_frames() - f0
	var peor := AstarTurno.peor_us
	var sobre16 := AstarTurno.fotogramas_sobre_16
	print("[astarpartida] %s · %d fotogramas · peor A* en un fotograma %.1f ms · fotogramas con mas de 16 ms de A*: %d · enemigos %d" % [
		current_map, frames, peor / 1000.0, sobre16, enemies.get_child_count()])
	for q in AstarTurno.por_quien.keys():
		var st: Array = AstarTurno.por_quien[q]
		print("[astarpartida]   %-11s %4d busquedas · media %.1f ms · peor %.1f ms · vacias %d" % [q, st[0], float(st[1]) / maxf(1.0, st[0]) / 1000.0, st[2] / 1000.0, st[3]])
	get_tree().quit(0)


## --astarmide: CUANTO CUESTA BUSCAR CAMINO. 60 busquedas deterministas (semilla fija) desde puntos de suelo
## a puntos de suelo del mapa: tiempo medio, peor, cuantas acaban y cuantas se rinden.
func _astar_mide() -> void:
	await get_tree().create_timer(4.0).timeout
	var rng := RandomNumberGenerator.new()
	rng.seed = 12345
	var tam: Vector3 = world.get_world_size()
	var puntos: Array = []
	var intentos := 0
	while puntos.size() < 120 and intentos < 5000:
		intentos += 1
		var q := Vector3(rng.randf_range(2.0, tam.x - 2.0), tam.y - 1.0, rng.randf_range(2.0, tam.z - 2.0))
		var r: Dictionary = world.raycast(q, Vector3.DOWN, tam.y)
		if r.get("hit", false):
			puntos.append((r.position as Vector3) + Vector3(0, 0.05, 0))
	# DOS PASADAS con las mismas busquedas: la segunda ya tiene recordado donde cabe el cuerpo (vx_nav.cpp, `cabe_`)
	for pasada in 2:
		var tiempos: Array = []
		var completas := 0
		var t_total := 0.0
		var huella := 0      # de todos los caminos: para ver que una optimizacion da EXACTAMENTE los mismos
		for i in 60:
			var a: Vector3 = puntos[i * 2]
			var b: Vector3 = puntos[i * 2 + 1]
			var t0 := Time.get_ticks_usec()
			var camino: PackedVector3Array = world.find_path(a, b)
			var ms := (Time.get_ticks_usec() - t0) / 1000.0
			tiempos.append(ms)
			t_total += ms
			if camino.size() > 0 and (camino[camino.size() - 1] as Vector3).distance_to(b) < 2.0:
				completas += 1
			huella = hash([huella, camino])
		tiempos.sort()
		print("[astar] %s voxel %.2f · pasada %d · 60 busquedas: media %.1f ms · mediana %.1f · p90 %.1f · peor %.1f · llegan %d · huella %d" % [
			current_map, world.get_voxel_size(), pasada + 1, t_total / 60.0, tiempos[30], tiempos[54], tiempos[59], completas, huella])
	get_tree().quit(0)


## --interiormapa (cualquier mapa, p.ej. dust2): se buscan tres sitios con el propio mapa de techos -la
## calle, el fondo de un interior y bajo techo junto a una salida- y en cada uno se mide cuanto se adapta
## la vista y se hace foto.
func _interior_mapa() -> void:
	await get_tree().create_timer(4.0).timeout
	for _i in 60:
		if _techo_fila >= TECHO_PX:
			break
		await get_tree().create_timer(0.5).timeout
	for e in enemies.get_children():
		e.queue_free()
	player.invulnerable = true
	var tam: Vector3 = world.get_world_size()
	var spawn: Vector3 = world.get_spawn_position()
	var sitios := {}
	var paso := 2.0
	var x := paso
	while x < tam.x - paso and sitios.size() < 3:
		var z := paso
		while z < tam.z - paso and sitios.size() < 3:
			var r0: Dictionary = world.raycast(Vector3(x, spawn.y + 1.5, z), Vector3.DOWN, 4.0)
			z += paso
			if not r0.get("hit", false):
				continue
			var pie: Vector3 = r0.position
			if world.box_solid(pie + Vector3(-0.35, 0.15, -0.35), pie + Vector3(0.35, 1.9, 0.35)):
				continue
			player.global_position = pie + Vector3(0, 0.05, 0)
			_techo_t = 0.0
			_update_techo(0.0)
			var clave := ""
			if _techo_frac < 0.01 and not sitios.has("calle"):
				clave = "calle"
			elif _techo_frac > 0.99 and _dist_afuera >= 7.5 and not sitios.has("fondo"):
				clave = "fondo"
			elif _techo_frac > 0.99 and _dist_afuera <= 1.6 and not sitios.has("junto"):
				clave = "junto"
			if clave != "":
				sitios[clave] = pie
		x += paso
	print("[intmapa] sitios: %s" % str(sitios))
	for clave in ["calle", "fondo", "junto"]:
		if not sitios.has(clave):
			print("[intmapa] no encuentro sitio %s" % clave)
			continue
		player.global_position = sitios[clave] + Vector3(0, 0.05, 0)
		player.velocity = Vector3.ZERO
		await get_tree().create_timer(7.0).timeout
		for _f in 3:
			await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("user://intmapa_%s.png" % clave)
		print("[intmapa] %-6s en %s · techo %.2f · salida a %.1f m · vista adaptada %.2f (0 = calle, 1 = interior del todo)" % [
			clave, str(sitios[clave].round()), _techo_frac, _dist_afuera, _vista_adapt])
	get_tree().quit(0)


## --botsanda: "LOS BOTS NO CAMINAN, VAN DUROS". Durante 15 s se mira a cada bot que se esta moviendo
## (mas de 1 m/s) y que clip lleva puesto: tiene que ser de andar/correr, no el de estar quieto.
func _bots_anda_test() -> void:
	for _i in 120:
		if heist != null and heist.vault != null and enemies.get_child_count() > 0:
			break
		await get_tree().create_timer(0.5).timeout
	player.invulnerable = true
	await get_tree().create_timer(3.0).timeout
	var muestras := 0
	var quietos := 0
	var clips := {}
	for _k in 60:
		await get_tree().create_timer(0.25).timeout
		for e in enemies.get_children():
			if not is_instance_valid(e) or not ("avatar" in e) or e.avatar == null:
				continue
			if Vector2(e.velocity.x, e.velocity.z).length() > 1.0:
