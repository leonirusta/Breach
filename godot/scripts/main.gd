						toca += " [%s en %s%s]" % [("bloque" if bool(world.info_cuerpo(otro).get("existe", false)) else "mundo"),
							str(ds.get_contact_collider_position(k).snapped(Vector3.ONE * 0.1)), (" sin cuerpo?" if not otro.is_valid() else "")]
				print("[traza] fr %d modo %d dormido %s anclado %s congelado %s pos %s vel %s giro %s grav %.2f contactos %d%s" % [fr,
					PhysicsServer3D.body_get_mode(r2), str(PhysicsServer3D.body_get_state(r2, PhysicsServer3D.BODY_STATE_SLEEPING)),
					str(inf2.get("anclado")), str(inf2.get("congelado")),
					str((PhysicsServer3D.body_get_state(r2, PhysicsServer3D.BODY_STATE_TRANSFORM) as Transform3D).origin.snapped(Vector3.ONE * 0.01)),
					str((PhysicsServer3D.body_get_state(r2, PhysicsServer3D.BODY_STATE_LINEAR_VELOCITY) as Vector3).snapped(Vector3.ONE * 0.01)),
					str((PhysicsServer3D.body_get_state(r2, PhysicsServer3D.BODY_STATE_ANGULAR_VELOCITY) as Vector3).snapped(Vector3.ONE * 0.01)),
					float(PhysicsServer3D.body_get_param(r2, PhysicsServer3D.BODY_PARAM_GRAVITY_SCALE)),
					ds.get_contact_count() if ds else -1, toca.substr(0, 400)])
		if not rapido:
			await get_tree().create_timer(2.0).timeout
	for s in 26:
		var techo: int = world.contar_voxels(Vector3(6.5, 4.75, 6.5), Vector3(15.5, 5.7, 15.5))
		var lado_neg: int = world.contar_voxels(Vector3(6.5, 4.75, 6.5), Vector3(11.0, 5.7, 15.5))
		var lado_pos: int = world.contar_voxels(Vector3(11.0, 4.75, 6.5), Vector3(15.5, 5.7, 15.5))
		var gran := ""
		for bd in world.get_bodies_debug():
			if int(bd.voxels) > 5000:          # el tablero: ~37.000 a 10 cm, ~9.400 a 20 cm
				gran = " · TABLERO SUELTO %d vox en %s" % [int(bd.voxels), str(Vector3(bd.pos).snapped(Vector3.ONE * 0.01))]
				var rid_t: RID = bd.rid
				if rid_t.is_valid():
					var inf_t: Dictionary = world.info_cuerpo(rid_t)
					var xf_t: Transform3D = PhysicsServer3D.body_get_state(rid_t, PhysicsServer3D.BODY_STATE_TRANSFORM)
					gran += " (rigido %s congelado %s anclado %s modo %d formas %d vel %.2f giro %.1f grados)" % [str(bd.rigid),
						str(inf_t.get("congelado")), str(inf_t.get("anclado")), PhysicsServer3D.body_get_mode(rid_t),
						PhysicsServer3D.body_get_shape_count(rid_t),
						(PhysicsServer3D.body_get_state(rid_t, PhysicsServer3D.BODY_STATE_LINEAR_VELOCITY) as Vector3).length(),
						rad_to_deg(xf_t.basis.get_rotation_quaternion().get_angle())]
				else:
					gran += " (SIN CUERPO JOLT: barato)"
		var st: Dictionary = world.get_stats()
		print("[mesamazo] t %.1f tablero en su sitio %d voxels (lado -x %d, lado +x %d)%s · analisis %s fallos %s peor %.2f" % [
			(Time.get_ticks_msec() - t0) / 1000.0, techo, lado_neg, lado_pos, gran, str(st.get("struct_active")),
			str(st.get("struct_failures")), float(st.get("struct_worst_ratio", 0.0))])
		await get_tree().create_timer(0.5 if s < 8 else 1.0).timeout
	get_tree().quit()


## --pisabloque: ¿SE PUEDE PISAR UN BLOQUE? Donde los datos dicen que hay superficie de bloque (el rayo
## con piezas), la fisica tiene que tener suelo a la misma altura; si no, el jugador lo atraviesa. Se mide
## la COBERTURA (muestras con suelo de fisica / muestras con bloque) en todos los bloques parados tras las
## explosiones de --congelatest, recien caidos y ya dormidos, y en el mas grande a mazazos (carve_body,
## como el mazo), que es el caso que encontro --diagcaida.
func _cobertura(centro: Vector3, lado: float, n: int) -> Vector2i:
	var space := get_world_3d().direct_space_state
	var datos := 0
	var fisica := 0
	for gx in n:
		for gz in n:
			var fx: float = (float(gx) / float(n - 1) - 0.5) * lado
			var fz: float = (float(gz) / float(n - 1) - 0.5) * lado
			var p := centro + Vector3(fx, 6.0, fz)
			var d: Dictionary = world.raycast_con_piezas(p, Vector3.DOWN, 14.0)
			if not (bool(d.get("hit", false)) and bool(d.get("pieza", false))):
				continue
			datos += 1
			var q := PhysicsRayQueryParameters3D.create(p, p + Vector3.DOWN * 14.0)
			q.exclude = [player.get_rid()]
			var f: Dictionary = space.intersect_ray(q)
			if not f.is_empty() and absf((f.position as Vector3).y - (d.position as Vector3).y) < 0.15:
				fisica += 1
	return Vector2i(datos, fisica)


func _cobertura_parados(etiqueta: String) -> void:
	var vs: float = world.get_voxel_size()
	var total := Vector2i.ZERO
	var peor := 1.0
	var peor_txt := ""
	var n_bloques := 0
	for bd in world.get_bodies_debug():
		var rid = bd.get("rid")
		if rid == null or not (rid as RID).is_valid():
			continue
		var inf: Dictionary = world.info_cuerpo(rid)
		if not bool(inf.get("parado", false)) or int(bd.get("voxels", 0)) < 12:
			continue
		var sz: Vector3 = bd.get("size")
		var c := _cobertura(Vector3(bd.pos), maxf(sz.x, sz.z) * vs, 7)
		if c.x == 0:
			continue
		n_bloques += 1
		total += c
		var k: float = float(c.y) / float(c.x)
		if k < peor:
			peor = k
			peor_txt = "vox %d congelado %s formas %d" % [int(bd.voxels), str(inf.get("congelado")), PhysicsServer3D.body_get_shape_count(rid)]
	print("[pisabloque] %s: %d bloques parados · cobertura %.1f %% (%d de %d muestras) · peor %.0f %% (%s)" % [
		etiqueta, n_bloques, 100.0 * float(total.y) / maxf(float(total.x), 1.0), total.y, total.x, peor * 100.0, peor_txt])


## EL JUGADOR DE PIE EN 16 PUNTOS del bloque: se le pone encima de la superficie que dicen los datos y se
## mira si a los 25 frames sigue ahi o se ha colado. Devuelve cuantos se colaron.
func _de_pie_encima(centro: Vector3, radio: float) -> Vector2i:
	var probados := 0
	var colados := 0
	for gx in 4:
		for gz in 4:
			var p := centro + Vector3((float(gx) / 3.0 - 0.5) * 2.0 * radio, 6.0, (float(gz) / 3.0 - 0.5) * 2.0 * radio)
			var d: Dictionary = world.raycast_con_piezas(p, Vector3.DOWN, 14.0)
			if not bool(d.get("pieza", false)):
				continue
			var sup: Vector3 = d.position
			player.global_position = sup + Vector3(0.0, 0.05, 0.0)
			player.velocity = Vector3.ZERO
			for i in 25:
				await get_tree().physics_frame
			probados += 1
			if player.global_position.y < sup.y - 0.3:
				colados += 1
	return Vector2i(probados, colados)


func _pisa_bloque_test() -> void:
	await get_tree().create_timer(3.0).timeout
	player.invulnerable = true
	# LA MESA DEL MAPA DE PRUEBAS: fuera las cuatro patas y el tablero de 9 x 9 m cae entero (--mesatest)
	player.global_position = Vector3(25.0, 1.0, 25.0)
	var patas: Array = [Vector3(-3, 0, -3), Vector3(-3, 0, 3), Vector3(3, 0, -3), Vector3(3, 0, 3)]
	for pt in patas:
		world.explode(Vector3(11.0, 1.35, 11.0) + pt, 1.15, 255)
	# el tablero, cada medio segundo mientras cae y se asienta
	var ultimo := ""
	for k in 36:
		await get_tree().create_timer(0.5).timeout
		var gr = null
		for bd in world.get_bodies_debug():
			if gr == null or int(bd.voxels) > int(gr.voxels):
				gr = bd
		if gr == null or not (gr.rid as RID).is_valid():
			continue
		var inf: Dictionary = world.info_cuerpo(gr.rid)
		var linea := "vox %d congelado %s anclado %s parado %s formas %d" % [int(gr.voxels), str(inf.get("congelado")),
			str(inf.get("anclado")), str(inf.get("parado")), PhysicsServer3D.body_get_shape_count(gr.rid)]
		if linea != ultimo:
			ultimo = linea
			print("[pisabloque]   t %.1f tablero: %s en %s" % [0.5 * (k + 1), linea, str(Vector3(gr.pos).snapped(Vector3.ONE * 0.01))])
		if k == 7:
			_cobertura_parados("recien caidos (4 s)")
	_cobertura_parados("dormidos (18 s)")
	# el mas grande, a mazazos
	var grande = null
	for bd in world.get_bodies_debug():
		var rid = bd.get("rid")
		if rid == null or not (rid as RID).is_valid() or not bool(world.info_cuerpo(rid).get("parado", false)):
			continue
		if grande == null or int(bd.voxels) > int(grande.voxels):
			grande = bd
	if grande == null:
		print("[pisabloque] no hay bloques")
		get_tree().quit()
		return
	var vs: float = world.get_voxel_size()
	var sz: Vector3 = grande.get("size")
	var lado: float = maxf(sz.x, sz.z) * vs
	var centro := Vector3(grande.pos)
	var arriba: Dictionary = world.raycast_con_piezas(centro + Vector3(0, 6, 0), Vector3.DOWN, 14.0)
	var golpe: Vector3 = arriba.get("position", centro)
	var r: RID = grande.rid
	var estado := func() -> String:
		var inf: Dictionary = world.info_cuerpo(r)
		return "vox %s congelado %s anclado %s formas %d" % [str(inf.get("voxels")), str(inf.get("congelado")),
			str(inf.get("anclado")), PhysicsServer3D.body_get_shape_count(r)]
	var radio: float = minf(lado * 0.4, 3.5)
	var dp0: Vector2i = await _de_pie_encima(centro, radio)
	print("[pisabloque] el grande (%s, %.1f m): de pie en %d puntos, se colo en %d (dormido, sin picar)" % [estado.call(), lado, dp0.x, dp0.y])
	var colados := 0
	var probados := 0
	for g in 4:
		# un mazazo junto al centro y, ENSEGUIDA (dentro de la gracia de 2,5 s), de pie por encima
		world.carve_body(r, golpe + Vector3(0.4 * g, 0, 0.3 * g), 0.4, 255)
		for i in 6:
			await get_tree().process_frame
		var dp: Vector2i = await _de_pie_encima(centro, radio)
		probados += dp.x
		colados += dp.y
		print("[pisabloque]   mazazo %d (%s): de pie en %d puntos, se colo en %d" % [g + 1, estado.call(), dp.x, dp.y])
	print("[pisabloque] RESULTADO a mazazos: se colo en %d de %d puntos" % [colados, probados])
	await get_tree().create_timer(3.0).timeout
	var dp2: Vector2i = await _de_pie_encima(centro, radio)
	print("[pisabloque]   pasada la gracia (%s): de pie en %d, se colo en %d" % [estado.call(), dp2.x, dp2.y])
	_cobertura_parados("al final")
	get_tree().quit()


