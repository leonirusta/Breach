		return ""
	if n == player:
		return _mi_nombre()
	if "nombre_marcador" in n:
		return String(n.nombre_marcador)
	if "peer_id" in n:
		return _nombre_peer(int(n.peer_id))
	return ""


func _equipo_nodo(n) -> String:
