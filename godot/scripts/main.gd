## --botescudotest: UN BOT CON ESCUDO BLINDADO. Delante del jugador, mirandole y disparando (fotos en tercera persona:
## user://botescudo_<n>.png, para ver el gesto de disparar con el escudo). Luego el jugador le tira DE FRENTE (el
## escudo se lo tiene que comer: vida del bot igual, la del escudo baja) y POR LA ESPALDA (ahi si le hace dano).
func _bot_escudo_test() -> void:
	await get_tree().create_timer(7.0).timeout
	player.invulnerable = true
	for e0 in enemies.get_children():
		e0.queue_free()
	await get_tree().physics_frame
	var fwd: Vector3 = -player.global_transform.basis.z
	fwd.y = 0.0
	fwd = fwd.normalized()
	var sitio: Vector3 = _ground_near(player.global_position + fwd * 6.0)
	var e := ENEMY_SCENE.instantiate()
	enemies.add_child(e)
	e.demo = true
	e.demo_target = player.global_position + Vector3(0, 1.5, 0)
	e.demo_apunta = true
	e.demo_gun = true
	e.demo_rate = 0.7
	e.demo_fx = effects
	e.global_position = sitio + Vector3(0, 0.4, 0)
	e.setup(world, player, 960)
	e.arma_modelo = "escudo_pistola"
	e.arma_tipo = "escudo"
	e._montar_arma("rifle")
	e.health = 300.0
	await get_tree().create_timer(1.5).timeout
	print("[botescudo] el bot lleva escudo: %s" % str(e.avatar.escudo_activo()))
	# las fotos del bot disparando, desde un lado
	var cam := Camera3D.new()
	add_child(cam)
	var lado := fwd.cross(Vector3.UP)
	cam.global_position = e.global_position + lado * 3.2 - fwd * 1.2 + Vector3.UP * 1.5
	cam.look_at(e.global_position + Vector3.UP * 1.2)
	cam.fov = 50.0
	cam.current = true
	for i in 8:
		await get_tree().create_timer(0.12).timeout
		await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("user://botescudo_%d.png" % i)
	cam.queue_free()
	await get_tree().physics_frame
	e.demo_rate = 9999.0
	# el jugador le tira de frente (al pecho), y luego por la espalda
	for pasada in ["DE FRENTE", "POR LA ESPALDA"]:
		if pasada == "POR LA ESPALDA":
			player.global_position = _ground_near(e.global_position + fwd * 5.0) + Vector3(0, 0.1, 0)
			await get_tree().create_timer(0.8).timeout
		var vida0: float = e.health
		var esc0: float = e.escudo_vida
		for k in 10:
			var ojo: Vector3 = player.cam.global_position
			var dir: Vector3 = (e.global_position + Vector3.UP * 1.2 - ojo).normalized()
			player.look = Vector2(atan2(-dir.x, -dir.z), asin(dir.y))
			await get_tree().physics_frame
			player.fire()
			await get_tree().create_timer(0.25).timeout
		print("[botescudo] %s: vida del bot %.0f -> %.0f · escudo %.0f -> %.0f%s" % [pasada, vida0, e.health, esc0,
			e.escudo_vida, " (ROTO)" if e.escudo_roto else ""])
	get_tree().quit()


## --punetazofoto: EL PUÑETAZO DE BLENDER EN LA PARTIDA. Primero en primera persona y luego, con una camara delante de
## tres cuartos, en tercera (lo que ven los demas). -> user://punio_fp_<ms>.png / punio_tp_<ms>.png
## --rafagafoto (con --map=pruebas): gira hasta tener una pared a 6-16 m, suelta el PUÑETAZO y fotografia desde un lado
## la rafaga de viento y los cascotes empujados (user://rafaga_*.png)
func _rafaga_foto() -> void:
	await get_tree().create_timer(7.0).timeout
	player.invulnerable = true
	for e in enemies.get_children():
		e.queue_free()
	var h = player.get("_hab")
	var yaw := 0.0
	for k in 36:
		player.look = Vector2(yaw, 0.0)
		player.rotation.y = yaw
		var fr := Vector3(-sin(yaw), 0, -cos(yaw))
		var r: Dictionary = world.raycast(player.global_position + Vector3.UP * 1.4, fr, 30.0)
		if bool(r.get("hit", false)) and float(r["distance"]) > 6.0 and float(r["distance"]) < 16.0:
			break
		yaw += TAU / 36.0
	await get_tree().create_timer(0.5).timeout
	var fr2: Vector3 = Vector3(-sin(yaw), 0, -cos(yaw))
	var der := fr2.cross(Vector3.UP)
	player.set_third_person(true)
	await get_tree().create_timer(0.3).timeout
	var cam := Camera3D.new()
	add_child(cam)
	cam.global_position = player.global_position + fr2 * 3.0 + der * 7.0 + Vector3.UP * 2.2
	cam.look_at(player.global_position + fr2 * 7.0 + Vector3.UP * 1.3)
	cam.fov = 60.0
	cam.current = true
	h.tipo = "punetazo"
	h.recarga = 0.0
	h.activar()
	var t0 := Time.get_ticks_msec()
	while String(h.fase) == "carga" and Time.get_ticks_msec() - t0 < 15000:
		await get_tree().process_frame
	var t1 := Time.get_ticks_msec()
	for m in [0.08, 0.2, 0.35, 0.6, 1.2]:
		while (Time.get_ticks_msec() - t1) / 1000.0 < float(m):
			await get_tree().process_frame
		await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("user://rafaga_%04d.png" % int(float(m) * 1000.0))
		print("[rafagafoto] t=%.2f" % float(m))
	print("[rafagafoto] listo")
	get_tree().quit()


## --personaje=<indice de Lobby.SKINS o nombre> (con --map=...): PARA PROBAR UN PERSONAJE A MANO. Se pone su skin (solo en
## memoria: esta partida no guarda nada), con la habilidad que trae, y sin conexion municion infinita (la habilidad no
## espera la recarga: se puede apretar la X sin parar). --map=pruebas --personaje=7 (Puño de Oro), =8 (Golpe de Suelo).
func _personaje_prueba(cual: String) -> void:
	await get_tree().process_frame
	await get_tree().process_frame
	var lista: Array = load("res://scripts/lobby.gd").SKINS
	var nombre := cual
	if cual.is_valid_int():
		nombre = String(lista[clampi(int(cual), 0, lista.size() - 1)]["n"])
