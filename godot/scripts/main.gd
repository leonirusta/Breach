## Salto y aterrizaje: la mezcla entre clips tiene que salir de la postura en la que estaba el
## cuerpo. Se mide el SALTO de rotacion de un hueso entre fotogramas al cambiar de clip: si es
## grande, hay tiron.
func _jump_blend_test() -> void:
	await get_tree().create_timer(4.0).timeout
	if team_overlay:
		Net.choose_team(Net.TEAM_CT)
		_close_team_select()
	await get_tree().create_timer(1.5).timeout
	if not player.third_person:
		player.toggle_third_person()
	var av = player.avatar
	var sk: Skeleton3D = av.skeleton
	# un hueso de la PIERNA: los del brazo los reescribe la IK del arma cada fotograma
	var nombre := "leg_upper_r"
	for cand in ["leg_upper_r", "thigh_r", "leg_r", "leg_lower_r", "spine", "stomach"]:
		if av.bone_idx.has(cand):
			nombre = cand
			break
	print("[salto] huesos: %s ... (se vigila '%s')" % [", ".join(av.bone_idx.keys().slice(0, 8)), nombre])
	var hueso: int = av.bone_idx.get(nombre, 0)
	# corriendo y saltando: se vigila el salto angular del brazo entre fotogramas
	player.touch_move = Vector2(0, -1)
	Input.action_press("sprint")
	await get_tree().create_timer(1.0).timeout
	# Se compara el salto de rotacion EN EL CAMBIO DE CLIP contra el salto normal del propio clip:
	# si el del cambio es parecido al normal, la mezcla esta bien; si es mucho mayor, hay tiron.
	var peor_normal := 0.0
	var peor_cambio := 0.0
	var clips: Array = []
	var prev: Quaternion = sk.get_bone_pose_rotation(hueso)
	var prev_clip := String(av.current_clip)
	var tras_cambio := 0
	var t0 := Time.get_ticks_msec()
	var salto_hecho := false
	while Time.get_ticks_msec() - t0 < 4000:
		await get_tree().process_frame
		if not salto_hecho and Time.get_ticks_msec() - t0 > 700:
			player.do_touch_jump()
			salto_hecho = true
		var cl := String(av.current_clip)
		if cl != prev_clip:
			tras_cambio = 3
			prev_clip = cl
			if not clips.has(cl):
				clips.append(cl)
		var q: Quaternion = sk.get_bone_pose_rotation(hueso)
		var d: float = rad_to_deg(prev.angle_to(q))
		if d > 0.001:
			if tras_cambio > 0:
				peor_cambio = maxf(peor_cambio, d)
				tras_cambio -= 1
			else:
				peor_normal = maxf(peor_normal, d)
		prev = q
	Input.action_release("sprint")
	player.touch_move = Vector2.ZERO
	print("[salto] clips: %s" % ", ".join(clips))
	print("[salto] salto de rotacion normal del clip: %.1f grados · en el CAMBIO de clip: %.1f -> %s" % [
		peor_normal, peor_cambio,
		"la mezcla esta bien" if peor_cambio <= peor_normal * 1.4 + 2.0 else "TIRON en el cambio"])
	get_tree().quit()


