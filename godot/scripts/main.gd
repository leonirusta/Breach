## --puertas: MIDE SI SE PASA POR LOS HUECOS. El jugador bajo de 1,80 a 1,60 porque las puertas de los
## mapas eran mas bajas que el. Esto barre una rejilla, y en cada suelo que encuentra echa un rayo hacia
## arriba para saber cuanto hueco hay. Lo que interesa es el tramo 1,60-1,80: son los sitios por los que
## ANTES no se pasaba y ahora si. Los que sigan por debajo de 1,60 son huecos que no cabe nadie.
func _puertas_test() -> void:
	await get_tree().create_timer(2.0).timeout
	var mx: Vector3 = world.get_world_size()
	var mn := Vector3.ZERO
	var paso := 1.0
	var bajo := 0      # menos de 1,60: sigue sin pasarse
	var gana := 0      # 1,60 a 1,80: antes no cabia, ahora si
	var libre := 0     # 1,80 o mas: se pasaba de siempre
	var minimo := 99.0
	var x := mn.x + 1.0
	while x < mx.x - 1.0:
		var z := mn.z + 1.0
		while z < mx.z - 1.0:
			for piso in _floors_at(x, z, mx.y):
				var techo: Dictionary = world.raycast(Vector3(x, piso + 0.15, z), Vector3.UP, 4.0)
				var h: float = (techo.position.y - piso) if techo.hit else 4.0
				if h < 0.9:
					continue          # no es sitio de andar: es un hueco entre forjados
				if h < 1.60:
					bajo += 1
					minimo = minf(minimo, h)
				elif h < 1.80:
					gana += 1
				else:
					libre += 1
			z += paso
		x += paso
	var tot: int = bajo + gana + libre
	print("[puertas] %s: %d sitios medidos" % [current_map, tot])
	print("[puertas]   se pasaba ya (>=1,80 m): %d (%.1f%%)" % [libre, 100.0 * libre / maxi(tot, 1)])
	print("[puertas]   GANADO (1,60-1,80 m):    %d (%.1f%%)  <- antes chocabas, ahora pasas" % [gana, 100.0 * gana / maxi(tot, 1)])
	print("[puertas]   sigue sin caber (<1,60): %d (%.1f%%), el mas bajo %.2f m" % [bajo, 100.0 * bajo / maxi(tot, 1), minimo if bajo > 0 else 0.0])
	get_tree().quit()


## --tardetest: ENTRAR A UNA PARTIDA YA EMPEZADA Y QUITARLE EL SITIO A UN BOT.
##
## Banco de dos instancias. El anfitrion arranca solo (`--empiezaya`) y cuenta sus bots; el invitado
## llega tarde y tiene que aparecer EN EL MAPA, no en el lobby. Luego el anfitrion vuelve a contar:
## con una persona mas en el bando, el reparto pide un bot menos.
func _tarde_test() -> void:
	Settings.bots_enabled = true      # el anfitrion tiene que TENER bots para que haya algo que mandar
	await get_tree().create_timer(6.0).timeout
	if not Net.hosting:
		print("[tarde] INVITADO: he entrado a la partida en marcha · mapa «%s» · jugadores %d" % [
			current_map, Net.player_count()])
		print("[tarde] INVITADO: %s" % ("OK, estoy en el mundo" if world != null and player != null
			else "FALLO, no hay mundo ni jugador"))
		# se da tiempo al censo y a un par de tandas de posiciones
		await get_tree().create_timer(12.0).timeout
		var vistos := enemies.get_child_count() if enemies else 0
		print("[tarde] INVITADO: bots que veo = %d · jugadores %d · avisos recibidos %d (repetidos %d, sin sitio %d)" % [
			vistos, Net.player_count(), _red_bots_recibidos, _red_bots_repetidos, _red_bots_sin_sitio])
		print("[tarde] INVITADO: %s" % ("OK, veo los bots que ya estaban" if vistos > 0
			else "FALLO, la partida tiene bots y yo no veo ninguno"))
		get_tree().quit(0 if vistos > 0 else 1)
		return

	var mio := Net.my_team()
	if mio == "":
		mio = Net.TEAM_T
	print("[tarde] ANFITRION: equipo «%s» · tope de bots por equipo = %d · piden %d · jugadores %d" % [
		mio, _bots_por_equipo(), _faltan_bots(mio), Net.player_count()])
	var piden0 := _faltan_bots(mio)
	_tarde_total0 = 0
	for e2 in Net.equipos:
		_tarde_total0 += _faltan_bots(String(e2))
	for i in 40:
		await get_tree().create_timer(1.0).timeout
		if Net.player_count() >= 2:
			break
	if Net.player_count() < 2:
		print("[tarde] ANFITRION: FALLO, no ha entrado nadie a la partida en marcha")
		get_tree().quit(1)
		return
	# SE ESPERA A QUE ELIJA EQUIPO. Conectarse y tener bando son dos cosas distintas: el que llega
	# elige al cargar el mapa, segundos despues de aparecer en la lista. Midiendo antes, el reparto
	# todavia no le habia contado y parecia que las personas no quitaban bots.
	for i in 30:
		var con_equipo := 0
		for id2 in Net.players.keys():
			if String(Net.players[id2].get("team", "")) != "":
				con_equipo += 1
		if con_equipo >= 2:
			break
		await get_tree().create_timer(1.0).timeout
	# el que llega puede caer en cualquiera de los dos bandos: se mira el suyo
	var suyo := ""
	for id in Net.players.keys():
		if int(id) != 1:
			suyo = String(Net.team_of(int(id))) if Net.has_method("team_of") else mio
	if suyo == "":
		suyo = mio
	var piden1 := _faltan_bots(suyo)
	var total1 := 0
	for e2 in Net.equipos:
		total1 += _faltan_bots(String(e2))
	print("[tarde] ANFITRION: bots que pide el reparto en total = %d (antes %d)" % [total1, _tarde_total0])
	print("[tarde] ANFITRION: ha entrado alguien (jugadores %d) · en «%s» ahora piden %d bots" % [
		Net.player_count(), suyo, piden1])
	var bien := total1 < _tarde_total0
	print("[tarde] ANFITRION: %s" % ("OK, la persona ocupa el sitio de un bot (%d -> %d en total)" % [
		_tarde_total0, total1] if bien else "FALLO: el reparto sigue pidiendo %d bots" % total1))
	print("[tarde] ANFITRION: bots en escena = %d" % (enemies.get_child_count() if enemies else 0))
	# NO SE SALE ANTES QUE EL INVITADO. La primera version cerraba a los 8 segundos y el invitado media
	# con el anfitrion ya muerto: veia "jugadores 0" y ningun bot, y no era eso lo que fallaba.
	await get_tree().create_timer(30.0).timeout
	get_tree().quit(0 if bien else 1)


## --botsolotest: LOS BOTS SON DEL SERVIDOR.
##
## Se apaga la excepcion del banco de pruebas (`Settings.banco_de_pruebas`) para medir lo que ve un
## jugador de verdad, no lo que ve una prueba con flags.
func _bots_solo_online_test() -> void:
	await get_tree().process_frame
	var antes_banco := Settings.banco_de_pruebas
	var antes_bots := Settings.bots_enabled
	var fallos := 0

	Settings.banco_de_pruebas = false
	Settings.bots_enabled = true

	for e in enemies.get_children():
		e.queue_free()
	await get_tree().process_frame
	spawn_enemies()
	await get_tree().process_frame
	if enemies.get_child_count() > 0:
		print("[botsolo] FALLO: en solitario han salido %d bots" % enemies.get_child_count())
		fallos += 1
	else:
		print("[botsolo] OK  en solitario no sale ningun bot")

	if Settings.bots_activos():
		print("[botsolo] FALLO: sin red, bots_activos() dice que si")
		fallos += 1
	else:
		print("[botsolo] OK  sin red, bots_activos() dice que no")

	# el boton tampoco los enciende: antes guardaba el ajuste y no pasaba nada
	Settings.bots_enabled = false
	set_bots(true)
	await get_tree().process_frame
	if Settings.bots_enabled or enemies.get_child_count() > 0:
		print("[botsolo] FALLO: el boton BOTS los ha encendido sin red")
		fallos += 1
	else:
		print("[botsolo] OK  el boton BOTS no hace nada sin red (y lo dice)")

	# Y EL BANCO DE PRUEBAS SIGUE TENIENDO LOS SUYOS. Es la unica excepcion, y si se rompiera, media
	# docena de flags mediria cero sin decir por que. Solo tiene sentido en un mapa con bots.
	Settings.banco_de_pruebas = true
	Settings.bots_enabled = true
	if Settings.map in Settings.MAPAS_SIN_BOTS or Settings.modo == "pve":
		print("[botsolo] (el mapa «%s» no lleva bots: prueba el banco con --map=dust)" % Settings.map)
	else:
		for e in enemies.get_children():
			e.queue_free()
		await get_tree().process_frame
		spawn_enemies()
		await get_tree().process_frame
		if enemies.get_child_count() == 0:
			print("[botsolo] FALLO: el banco de pruebas se ha quedado sin bots en «%s»" % Settings.map)
			fallos += 1
		else:
			print("[botsolo] OK  el banco de pruebas sigue teniendo bots (%d en «%s»)" % [
				enemies.get_child_count(), Settings.map])

	# CON PARTIDA ONLINE SI, que es de lo que se trata
	var err := Net.create_room("prueba bots", Settings.map, 8)
	if err != "":
		print("[botsolo] AVISO: no se pudo montar sala (%s), el caso online queda sin comprobar" % err)
	else:
		Settings.bots_enabled = true
		if not Settings.bots_activos():
			print("[botsolo] FALLO: con partida online siguen sin permitirse")
			fallos += 1
		else:
			print("[botsolo] OK  con partida online (y de anfitrion) si hay bots")
		if not _me_toca_crear_bots():
			print("[botsolo] FALLO: siendo anfitrion no me toca crearlos")
			fallos += 1
		else:
			print("[botsolo] OK  siendo anfitrion los creo yo")
		Net.leave()

	Settings.banco_de_pruebas = antes_banco
	Settings.bots_enabled = antes_bots
	Settings.save()
	print("[botsolo] %s (%d fallos)" % ["TODO BIEN" if fallos == 0 else "HAY FALLOS", fallos])
	get_tree().quit(0 if fallos == 0 else 1)


## --herramientastest: LAS TRAMPAS NO PUEDEN ESTAR EN ONLINE.
##
## Comprueba las tres situaciones que importan y, sobre todo, que EL MENU NO LAS CONSTRUYE: esconder
## un boton no basta -queda vivo y se puede pulsar-, tiene que no existir.
func _herramientas_test() -> void:
	await get_tree().process_frame
	var antes := Settings.modo_pruebas
	var fallos := 0

	_comprobar_herramientas("de fabrica, sin nada puesto", false, false)

	Settings.modo_pruebas = true
	if not Settings.herramientas():
		print("[herramientas] FALLO: con PROBAR OFFLINE y sin red deberian estar disponibles")
		fallos += 1
	else:
		print("[herramientas] OK  pruebas + sin red -> disponibles")

	# cuantos botones tiene el menu con las herramientas puestas y sin ellas
	# `toggle_menu` ABRE O CIERRA segun este: se fuerza el estado en vez de suponerlo.
	var abrir := func() -> void:
		if hud.menu_panel == null:
			hud.toggle_menu()
		await get_tree().process_frame
	var cerrar := func() -> void:
		if hud.menu_panel != null:
			hud.toggle_menu()
		await get_tree().process_frame

	await cerrar.call()
	Settings.modo_pruebas = true
	await abrir.call()
	var con := _contar_botones(hud)
	var hay_noclip := _texto_en(hud, "NOCLIP")
	await cerrar.call()
	Settings.modo_pruebas = false
	await abrir.call()
	var sin := _contar_botones(hud)
	var hay_noclip2 := _texto_en(hud, "NOCLIP") or _texto_en(hud, "VIDA INFINITA")
	var hay_salida := _texto_en(hud, "VOLVER AL LOBBY")
	await cerrar.call()
	if not hay_noclip:
		print("[herramientas] FALLO: con pruebas puestas NOCLIP tampoco sale; el test no mide nada")
		fallos += 1
	if sin >= con:
		print("[herramientas] FALLO: el menu sin pruebas tiene %d botones y con pruebas %d" % [sin, con])
		fallos += 1
	else:
		print("[herramientas] OK  el menu pasa de %d botones a %d: la rejilla NO se construye" % [con, sin])
	if not hay_salida:
		print("[herramientas] FALLO: sin la rejilla no queda forma de salir de la partida")
		fallos += 1
	else:
		print("[herramientas] OK  VOLVER AL LOBBY sigue estando (no es una herramienta, es la puerta)")
	if hay_noclip2:
		print("[herramientas] FALLO: quedan botones de trampa en el menu")
		fallos += 1
	else:
		print("[herramientas] OK  ni NOCLIP ni VIDA INFINITA en el menu normal")

	# sin premio mientras se prueba
	Settings.modo_pruebas = true
	var oro0 := Settings.monedas
	var r := Settings.premiar(true, 500, 500)
	if int(r.get("oro", 0)) != 0 or Settings.monedas != oro0:
		print("[herramientas] FALLO: el modo pruebas ha pagado %d de oro" % int(r.get("oro", 0)))
		fallos += 1
	else:
		print("[herramientas] OK  con el modo pruebas puesto no se gana nada")

	# Y LO QUE DE VERDAD IMPORTA: CON RED, NI AUNQUE ESTE PUESTO. Se monta una sala de verdad para que
	# `Net.is_online()` diga que si; no vale con simularlo, porque es justo esa llamada la que decide.
	Settings.modo_pruebas = true
	var err := Net.create_room("prueba herramientas", Settings.map, 8)
	if err != "":
		print("[herramientas] AVISO: no se pudo montar sala (%s), el caso online queda sin comprobar" % err)
	elif Settings.herramientas():
		print("[herramientas] FALLO: con partida online las herramientas siguen disponibles")
		fallos += 1
	else:
		print("[herramientas] OK  pruebas + ONLINE -> ocultas (manda la red)")
	Net.leave()

	Settings.modo_pruebas = antes
	Settings.save()
	print("[herramientas] %s (%d fallos)" % ["TODO BIEN" if fallos == 0 else "HAY FALLOS", fallos])
	get_tree().quit(0 if fallos == 0 else 1)


func _comprobar_herramientas(que: String, pruebas: bool, espero: bool) -> void:
	Settings.modo_pruebas = pruebas
	if Settings.herramientas() == espero:
		print("[herramientas] OK  %s -> %s" % [que, "disponibles" if espero else "ocultas"])
	else:
		print("[herramientas] FALLO: %s" % que)


func _contar_botones(n: Node) -> int:
	var c := 1 if n is Button else 0
	for h in n.get_children():
		c += _contar_botones(h)
	return c


func _texto_en(n: Node, t: String) -> bool:
	if n is Button and String((n as Button).text).contains(t):
		return true
	for h in n.get_children():
		if _texto_en(h, t):
			return true
	return false


## --congelatest: DESPUES DE VARIOS DERRUMBES, ¿SIGUEN CAYENDOSE LAS COSAS?
##
## Los trozos que se paran torcidos se quedan congelados como cuerpo y NO desaparecen nunca. Si esos
## cuerpos cuentan para el presupuesto de fisica, el cupo se llena y a partir de ahi ninguna pieza
## nueva vuelve a ser rigida: el jugador lo ve como "rompo algo y ya no se cae nada". Esto revienta
## seis veces seguidas en sitios distintos y mira si la ultima tanda sigue soltando cuerpos rigidos.
## Cuantos bloques parados no tienen NADA debajo en 4 m. El rayo ve tambien las piezas.
func _contar_flotando() -> int:
	var n := 0
	for bd in world.get_bodies_debug():
		var rid = bd.get("rid")
		if rid == null or not rid.is_valid():
			continue
		if not bool(world.info_cuerpo(rid).get("parado", false)):
			continue
		var r: Dictionary = world.raycast_con_piezas(Vector3(bd.pos) + Vector3(0, -0.1, 0), Vector3(0, -1, 0), 4.0)
		if r.is_empty() or not bool(r.get("hit", false)):
			n += 1
	return n


## --escombrodormido: "DEJE DORMIR LOS ESCOMBROS Y CUANDO LOS QUISE ROMPER SALIERON LAS PARTICULAS PERO
## QUEDO EL BLOQUE SIN FISICAS, LOS TRASPASABA, ALGUNOS DESAPARECIERON AL RATO". Se rompe, se espera a que
## todo duerma, se le dispara a cada bloque dormido como lo hace la bala (impulso + carve_body) y luego
## se audita cada bloque: ¿tiene cuerpo de fisica, con formas, y esta DONDE SE DIBUJA?
func _escombro_dormido_test() -> void:
	await get_tree().create_timer(3.0).timeout
	var puntos := [Vector3(11, 2.0, 11), Vector3(30, 2.0, 8), Vector3(30, 2.0, 19)]
	var invitado: bool = Net.is_online() and not Net.hosting
	if Net.is_online():
		await get_tree().create_timer(12.0).timeout      # a que el otro este dentro
	if not invitado:
		for pt in puntos:
			Net.net_explode(world, pt, 3.0, 255)
			Net.net_explode(world, pt + Vector3(0, 1.6, 0), 2.6, 255)
	if Net.is_online() and Net.hosting:
		print("[dormido] ANFITRION: roto, me quedo mirando")
		await get_tree().create_timer(200.0).timeout
		get_tree().quit(0)
		return
	for _s in 90:
		await get_tree().create_timer(1.0).timeout
		var st: Dictionary = world.get_stats()
		if int(st.get("bodies_rigid", 0)) == 0 and int(st.get("bodies_congelados", 0)) > 0 and _s > 10:
			break
	var st0: Dictionary = world.get_stats()
	print("[dormido] antes: cuerpos %d · congelados %d · rigidos %d · borrados void %d carve %d" % [
		world.get_bodies_debug().size(), int(st0.get("bodies_congelados", 0)), int(st0.get("bodies_rigid", 0)),
		int(st0.get("removed_void", 0)), int(st0.get("removed_carve", 0))])
	var ids_antes := {}
	for bd in world.get_bodies_debug():
		ids_antes[int(bd.id)] = int(bd.voxels)
	# A TIROS, como player.gd: rayo de fisica, impulso y carve_body con el radio del fusil
	var space := get_world_3d().direct_space_state
	var ps := PhysicsServer3D
	var tiros := 0
	var r_talla: float = Net.radio_talla_escombro(160)
	var victimas := []
	var lista_b: Array = world.get_bodies_debug()
	lista_b.sort_custom(func(x, y): return int(x.voxels) > int(y.voxels))
	print("[dormido] tamaños (voxels) de los mayores: %s" % str(lista_b.slice(0, 10).map(func(x): return int(x.voxels))))
	for bd in lista_b:
		var rid = bd.get("rid")
		if rid == null or not rid.is_valid():
			continue
		if not bool(world.info_cuerpo(rid).get("congelado", false)):
			continue
		if int(bd.voxels) < 150 and victimas.size() > 0:
			continue
		victimas.append(int(bd.id))
		if victimas.size() >= 8:
			break
	for vid in victimas:
		for k in 24:
			var objetivo := Vector3.ZERO
			var halla := false
			for bd in world.get_bodies_debug():
				if int(bd.id) == vid:
					objetivo = Vector3(bd.pos)
					halla = true
			if not halla:
				break
			var desde := objetivo + Vector3(randf_range(-1.5, 1.5), 2.5, randf_range(-1.5, 1.5))
			objetivo += Vector3(randf_range(-0.6, 0.6), randf_range(-0.3, 0.3), randf_range(-0.6, 0.6))
			var dir := (objetivo - desde).normalized()
			var q := PhysicsRayQueryParameters3D.create(desde, desde + dir * 6.0)
			var hit := space.intersect_ray(q)
			if hit.is_empty() or not hit.has("rid"):
				continue
			var t: Transform3D = ps.body_get_state(hit.rid, PhysicsServer3D.BODY_STATE_TRANSFORM)
			ps.body_apply_impulse(hit.rid, dir * 30.0, hit.position - t.origin)
			world.carve_body(hit.rid, hit.position, r_talla, 255)
			Net.net_escombro(hit.position, r_talla)
			tiros += 1
			await get_tree().create_timer(0.12).timeout
	print("[dormido] tiros que dieron a un bloque: %d (a %d bloques dormidos)" % [tiros, victimas.size()])
	var malos_total := {}
	for seg in [1, 4, 10, 25]:
		while Time.get_ticks_msec() < 0:
			pass
		await get_tree().create_timer(float(seg) - (0.0 if seg == 1 else float([1, 4, 10, 25][[1, 4, 10, 25].find(seg) - 1]))).timeout
		var sin_cuerpo := 0
		var sin_formas := 0
		var desplazado := 0
		var peor := 0.0
		var total := 0
		var ejemplos := []
		for bd in world.get_bodies_debug():
			total += 1
			var rid = bd.get("rid")
			var inf: Dictionary = world.info_cuerpo(rid) if (rid != null and rid.is_valid()) else {}
			var etiqueta := "id %d vox %d rigid %s solid %s congelado %s" % [int(bd.id), int(bd.voxels), str(bd.rigid), str(bd.solid), str(inf.get("congelado", "?"))]
			if rid == null or not rid.is_valid():
				sin_cuerpo += 1
				if ejemplos.size() < 6: ejemplos.append("SIN CUERPO " + etiqueta)
				continue
			if ps.body_get_shape_count(rid) == 0:
				sin_formas += 1
				if ejemplos.size() < 6: ejemplos.append("SIN FORMAS " + etiqueta)
				continue
			var tb: Transform3D = ps.body_get_state(rid, PhysicsServer3D.BODY_STATE_TRANSFORM)
			var dd: float = tb.origin.distance_to(Vector3(bd.pos))
			peor = maxf(peor, dd)
			if dd > 0.3:
				desplazado += 1
				if ejemplos.size() < 6: ejemplos.append("COLISION A %.2f m DEL DIBUJO modo %d %s" % [dd, ps.body_get_mode(rid), etiqueta])
		var stn: Dictionary = world.get_stats()
		var desaparecidos := 0
		var vivos := {}
		for bd in world.get_bodies_debug():
			vivos[int(bd.id)] = true
		for vid in victimas:
			if not vivos.has(vid):
				desaparecidos += 1
		var nuevos := 0
		var nuevos_sin := 0
		for bd in world.get_bodies_debug():
			if not ids_antes.has(int(bd.id)):
				nuevos += 1
				if bd.get("rid") == null or not bd.rid.is_valid():
					nuevos_sin += 1
		print("[dormido]    pedazos nuevos (partidos al disparar): %d · de ellos sin cuerpo de fisica: %d" % [nuevos, nuevos_sin])
		print("[dormido] a los %2d s: cuerpos %d · sin cuerpo %d · sin formas %d · colision lejos del dibujo %d (peor %.2f m) · victimas que ya no estan %d · rigidos %d · borrados void %d carve %d age %d" % [
			seg, total, sin_cuerpo, sin_formas, desplazado, peor, desaparecidos, int(stn.get("bodies_rigid", 0)),
			int(stn.get("removed_void", 0)), int(stn.get("removed_carve", 0)), int(stn.get("removed_age", 0))])
		for e in ejemplos:
			print("[dormido]     " + e)
	get_tree().quit(0)


var _ciegos_max := 0

func _congela_test() -> void:
	await get_tree().create_timer(3.0).timeout
	var puntos := [Vector3(11, 2.0, 11), Vector3(30, 2.0, 8), Vector3(30, 2.0, 19),
		Vector3(9, 2.0, 28), Vector3(19, 2.0, 30), Vector3(29, 2.0, 30)]
	for n in puntos.size():
		world.explode(puntos[n], 3.0, 255)
		world.explode(puntos[n] + Vector3(0, 1.6, 0), 2.6, 255)
		var pico := 0
		for i in 150:
			await get_tree().process_frame
			var st0: Dictionary = world.get_stats()
			pico = maxi(pico, int(st0.get("bodies_rigid", 0)))
			_ciegos_max = maxi(_ciegos_max, int(st0.get("congel_sin_dibujo", 0)))
		var st: Dictionary = world.get_stats()
		print("[congela] tanda %d -> rigidos pico %2d · vivos %2d · congelados %3d · grupos %2d (draw calls) · cajas %4d" % [
			n + 1, pico, int(st.get("bodies_rigid", 0)),
			int(st.get("bodies_congelados", 0)), int(st.get("grupos_congelado", 0)),
			int(st.get("cajas_congelado", 0))])
	# ¿QUE VE EL MAZO? Un cuerpo "parado" (congelado o anclado) tiene que picarse como una pared, con
	# sus 2-3 golpes; uno que sigue volando se talla de un golpe, que es lo correcto para un cascote.
	var parados := 0
	var volando := 0
	var sin_info := 0
	for bd in world.get_bodies_debug():
		var rid = bd.get("rid")
		if rid == null or not rid.is_valid():
			sin_info += 1
			continue
		var inf: Dictionary = world.info_cuerpo(rid)
		if not bool(inf.get("existe", false)):
			sin_info += 1
		elif bool(inf.get("parado", false)):
			parados += 1
		else:
			volando += 1
	print("[congela] bloques dormidos que NO DIBUJA NADIE (parpadeo), maximo visto: %d" % _ciegos_max)
	# EL CONTRARIO: DIBUJO SIN BLOQUE. Se tallan del todo unos bloques pequeños DORMIDOS (como el mazo o
	# las balas a un cascote caido): el bloque se borra y su dibujo, que vive en la malla comun de su celda,
	# tiene que irse con el. Antes se quedaba pintado sin fisica hasta que otra cosa ensuciara la celda.
	var tallados := 0
	for bd8 in world.get_bodies_debug():
		var rid8 = bd8.get("rid")
		if tallados >= 8 or rid8 == null or not rid8.is_valid() or int(bd8.get("voxels", 0)) > 60:
			continue
		if not bool(world.info_cuerpo(rid8).get("congelado", false)):
			continue
		world.carve_body(rid8, Vector3(bd8.pos), 3.0, 255)
		tallados += 1
	var fant := []
	for f8 in 180:
		await get_tree().process_frame
		if f8 in [0, 9, 59, 179]:
			fant.append(int(world.get_stats().get("grupo_fantasmas", 0)))
	print("[congela] bloques dormidos tallados del todo: %d · DIBUJO SIN BLOQUE a 1/10/60/180 frames: %s" % [tallados, str(fant)])
	if world.has_method("set_diag_bloques"):
		world.set_diag_bloques(true)          # el dato caro, solo mientras se mide (ver get_stats)
	await get_tree().physics_frame
	var sf2: Dictionary = world.get_stats()
	if world.has_method("set_diag_bloques"):
		world.set_diag_bloques(false)
	print("[congela] apoyos cedidos bajo peso: %d · BLOQUES METIDOS DENTRO DE OTRO (los han atravesado): %d" % [
		int(sf2.get("apoyos_rotos", 0)), int(sf2.get("bloques_dentro_de_otro", 0))])
	# EL CASO DEL JUGADOR: un bloque DORMIDO al que le sierro el apoyo SIN TOCARLO A EL. Antes nadie se
	# lo contaba (duerme hasta recibir daño, y el daño se lo hago a la columna) y se quedaba colgado
	# sobre nada. Se busca un bloque parado que tenga mundo debajo, se talla ese mundo, y se mira si baja.
	var victima = null
	for bd6 in world.get_bodies_debug():
		var rid6 = bd6.get("rid")
		if rid6 == null or not rid6.is_valid() or not bool(world.info_cuerpo(rid6).get("parado", false)):
			continue
		# ¿tiene VOXELES DEL MUNDO debajo? (no otro bloque)
		var rv6: Dictionary = world.raycast(Vector3(bd6.pos), Vector3(0, -1, 0), 3.0)
		if rv6.get("hit", false) and int(bd6.get("voxels", 0)) > 60:
			victima = bd6
			break
	if victima == null:
		print("[congela] no hay ningun bloque dormido apoyado en el mundo para probar")
	else:
		var y0v: float = Vector3(victima.pos).y
		var punto: Vector3 = world.raycast(Vector3(victima.pos), Vector3(0, -1, 0), 3.0).position
		# se sierra el apoyo CON EL LASER, que no toca al bloque
		for k6 in 6:
			world.carve_beam(punto + Vector3(-2.0, -0.15 * float(k6), 0), Vector3(1, 0, 0), 4.0, 0.5, 255, true)
			for _q in 3:
				await get_tree().process_frame
		for _q2 in 240:
			await get_tree().process_frame
		var y1v := y0v
		for bd7 in world.get_bodies_debug():
			if int(bd7.get("id", 0)) == int(victima.id):
				y1v = Vector3(bd7.pos).y
		print("[congela] bloque DORMIDO al que le sierro el apoyo sin tocarlo: bajó %.2f m" % (y0v - y1v))
		print("[congela] %s" % ("OK: se entera y cae" if (y0v - y1v) > 0.15 else "MAL: se queda colgado sobre nada"))
	print("[congela] lo que ve el mazo: %d parados (se pican como pared) · %d volando (1 golpe) · %d sin cuerpo" % [
		parados, volando, sin_info])
	# ¿HAY BLOQUES CLAVADOS EN EL AIRE? Desde cada bloque parado se tira un rayo hacia abajo QUE VE
	# TAMBIEN LAS PIEZAS (`raycast_con_piezas`): si por debajo no hay nada en varios metros, ese
	# bloque esta flotando y el jugador lo ve como "pegado en el aire".
	var flotando := 0
	var mirados := 0
	for bd3 in world.get_bodies_debug():
		var rid3 = bd3.get("rid")
		if rid3 == null or not rid3.is_valid():
			continue
		if not bool(world.info_cuerpo(rid3).get("parado", false)):
			continue
		mirados += 1
		var r3: Dictionary = world.raycast_con_piezas(Vector3(bd3.pos) + Vector3(0, -0.1, 0), Vector3(0, -1, 0), 4.0)
		if r3.is_empty() or not bool(r3.get("hit", false)):
			flotando += 1
	print("[congela] bloques parados %d · SIN NADA DEBAJO en 4 m: %d" % [mirados, flotando])
	# ¿SE ENTERA UN TROZO CONGELADO DE QUE LE ESTAN DANDO? Se le pega diez veces en el mismo sitio y
	# se mira si pierde voxels. Si no los pierde, el jugador ve que "no le hace nada"; y si los pierde
	# pero el grupo no se rehace, los pierde SIN QUE SE VEA, que es peor: el dibujo se queda entero y
	# la colision se encoge, asi que lo atraviesas.
	var elegido = null
	var cajas0: int = int(world.get_stats().get("cajas_congelado", 0))
	for bd in world.get_bodies_debug():
		var rid = bd.get("rid")
		if rid == null or not rid.is_valid():
			continue
		if bool(world.info_cuerpo(rid).get("congelado", false)) and int(bd.get("voxels", 0)) > 200:
			elegido = bd
			break
	if elegido == null:
		print("[congela] no hay ningun congelado grande que tallar")
	else:
		var v0: int = int(elegido.voxels)
		var pos: Vector3 = elegido.pos
		for k in 10:
			world.carve_body(elegido.rid, pos, 0.4, 200)
			for _f in 4:
				await get_tree().process_frame
		var v1 := -1
		for bd2 in world.get_bodies_debug():
			if int(bd2.get("id", 0)) == int(elegido.id):
				v1 = int(bd2.get("voxels", 0))
		var cajas1: int = int(world.get_stats().get("cajas_congelado", 0))
		print("[congela] tallando un congelado: %d -> %d voxels (%d menos) · cajas totales %d -> %d" % [
			v0, v1, v0 - v1, cajas0, cajas1])
		print("[congela] %s" % ("OK: pierde voxels al tallarlo" if v1 >= 0 and v1 < v0 else "MAL: no le pasa nada"))
		# ¿SE DESPIERTA Y SE CAE? Es EL caso del jugador: un bloque que ya se acomodó, se le vuelve a
		# romper lo de debajo, y tiene que caerse igual que la primera vez en vez de quedarse
		# flotando. No se sigue un bloque por id (los hay repetidos): se cuenta cuantos bloques
		# quedan colgados en el aire, que es justo lo que se ve en pantalla.
		var flot_antes := _contar_flotando()
		var pos_v: Vector3 = Vector3(elegido.pos)
		world.explode(pos_v - Vector3(0, 1.4, 0), 2.6, 255)
		world.explode(pos_v - Vector3(0, 2.4, 0), 2.6, 255)
		for _f2 in 240:
			await get_tree().process_frame
		var flot_despues := _contar_flotando()
		print("[congela] tras romper lo de DEBAJO de bloques dormidos: flotando %d -> %d" % [
			flot_antes, flot_despues])
		print("[congela] %s" % ("OK: se despiertan y caen" if flot_despues <= flot_antes + 1 else "MAL: se quedan flotando"))
	get_tree().quit()


## --estructuralan: EL INVITADO GOLPEA, ¿CEDE LA ESTRUCTURA EN LAS DOS PANTALLAS?
##
## `--fisicalan` solo prueba el caso facil: revienta el ANFITRION, que es quien tiene autoridad.
## El caso que falla de verdad es el contrario, y es el que cuenta el jugador: tu amigo pega
## mazazos a un pilar y en tu pantalla no pasa nada (ni trozos cayendo, ni derrumbe).
##
## El invitado talla como el mazo (`Net.net_carve_beam`, que es lo que llama `_mazazo_pared`) hasta
## abrir un boquete que obligue a la estructura a ceder. Las dos maquinas cuentan lo mismo:
##   cuerpos vivos      -> ¿se ve CAER algo, o aparece ya asentado?
##   groups_structural  -> ¿ha desprendido el analizador estructural?
##   struct_*           -> ¿ha llegado a EVALUARSE la estructura en esta maquina?
##   voxels_destroyed   -> ¿acaban los dos mundos igual?
func _estructura_lan_test() -> void:
	await get_tree().create_timer(5.0).timeout
	var quien := "ANFITRION" if Net.hosting else "INVITADO"
	print("[estructuralan] %s: en_red=%s hosting=%s" % [quien, str(Net.is_online()), str(Net.hosting)])
	var p: Vector3 = player.global_position
	var fwd: Vector3 = -player.global_transform.basis.z
	# se busca pared de verdad delante: si se talla al aire no se prueba nada
	# EL BLANCO TIENE QUE SER EL MISMO EN LAS DOS MAQUINAS. Cada una reaparece donde quiere y mira
	# a donde quiere, asi que buscarlo con un rayo desde el jugador daba dos blancos distintos (y el
	# invitado, mirando al aire, ni siquiera encontraba pared). Va fijo, y se puede dar por bandera.
	var blanco := Vector3(31, 2, 30)
	for f in OS.get_cmdline_user_args():
		if f.begins_with("--estructurablanco="):
			var c: PackedStringArray = f.split("=")[1].split(",")
			if c.size() >= 3:
				blanco = Vector3(float(c[0]), float(c[1]), float(c[2]))
	fwd = Vector3(0, 0, -1)
	print("[estructuralan] %s: blanco en %s, a %.1f m de mi" % [quien, str(blanco.round()), p.distance_to(blanco)])
	if not Net.hosting:
		# EL INVITADO es quien pega. Mismo camino exacto que el mazo: carve_beam replicado.
		if "--estructurabomba" in OS.get_cmdline_user_args():
			# cinturon de cargas: obliga a la estructura a ceder de verdad, no solo a agujerearse
			print("[estructuralan] INVITADO: cinturon de 10 cargas en la base")
			for i in 10:
				var lado: Vector3 = fwd.cross(Vector3.UP).normalized()
				Net.net_explode(world, blanco + lado * (float(i) - 4.5) * 1.6 + Vector3(0, 0.6, 0), 2.4, 240)
				await get_tree().process_frame
		else:
			print("[estructuralan] INVITADO: 40 mazazos en la base")
			for i in 40:
				var off := Vector3(float(i % 8) * 0.25 - 1.0, float(i / 8) * 0.25, 0.0)
				Net.net_carve_beam(world, blanco + off - fwd * 0.15, fwd, 0.35, 0.30, 180, false)
				await get_tree().process_frame
	var max_bodies := 0
	var max_pend := 0
	var trozos_pico := PackedStringArray()
	for i in 420:
		await get_tree().process_frame
		var st: Dictionary = world.get_stats()
		var viv: int = int(st.get("bodies_active", 0))
		if viv > max_bodies:
			# foto de los trozos en el momento de mayor actividad: luego se congelan y desaparecen
			trozos_pico = PackedStringArray()
			for bd in world.get_bodies_debug():
				trozos_pico.append("%d:%d" % [int(bd.get("id", 0)), int(bd.get("voxels", 0))])
			trozos_pico.sort()
		max_bodies = maxi(max_bodies, viv)
		max_pend = maxi(max_pend, int(st.get("pieces_pending", 0)))
	print("[estructuralan] %s: trozos en el pico %d -> %s" % [quien, trozos_pico.size(), " ".join(trozos_pico)])
	var f: Dictionary = world.get_stats()
	print("[estructuralan] %s: cuerpos vivos max=%d  pendientes max=%d" % [quien, max_bodies, max_pend])
	print("[estructuralan] %s: struct iteraciones=%d celdas=%d fallos=%d fragmentos=%d" % [
		quien, int(f.get("struct_iterations", 0)), int(f.get("struct_cells", 0)),
		int(f.get("struct_failures", 0)), int(f.get("struct_fragments", 0))])
	print("[estructuralan] %s: grupos estructurales=%d planos=%d  voxels de grupo=%d" % [
		quien, int(f.get("groups_structural", 0)), int(f.get("groups_plain", 0)), int(f.get("group_voxels", 0))])
	print("[estructuralan] %s: congelados=%d  desconocidos=%d  pendientes=%d" % [
		quien, int(f.get("bodies_congelados", 0)), int(f.get("congel_desconocidos", 0)),
		int(f.get("congel_pendientes", 0))])
	print("[estructuralan] %s: voxels destruidos=%d  piezas=%d  revoxelizadas=%d" % [
		quien, int(f.get("voxels_destroyed", 0)), int(f.get("pieces_total", 0)), int(f.get("revox_total", 0))])
	print("[estructuralan] %s: sueltas out=%d in=%d  celdas in=%d ya aire=%d  asientos in=%d" % [
		quien, int(f.get("sync_sueltas_out", 0)), int(f.get("sync_sueltas_in", 0)),
		int(f.get("sync_celdas_sueltas_in", 0)), int(f.get("sync_celdas_ya_aire", 0)),
		int(f.get("sync_celdas_asiento_in", 0))])
	print("[estructuralan] %s: %s" % [quien, "OK, ve caer cosas" if max_bodies > 0 else "MAL: no ha visto caer NADA"])
	# ¿SON LOS MISMOS TROZOS EN LAS DOS MAQUINAS? El id es un hash del primer voxel de la pieza, asi
	# que si las dos desprenden lo mismo tiene que salir la MISMA lista. Es lo que decide si se puede
	# sincronizar la postura final de cada trozo por id en vez de celda a celda.
	var trozos := PackedStringArray()
	for bd in world.get_bodies_debug():
		trozos.append("%d:%d" % [int(bd.get("id", 0)), int(bd.get("voxels", 0))])
	trozos.sort()
	print("[estructuralan] %s: trozos vivos %d -> %s" % [quien, trozos.size(), " ".join(trozos)])
	# LA HUELLA DEL MAPA, chunk a chunk. Los contadores dicen si cada maquina ha hecho lo mismo; esto
	# dice si han acabado con el MISMO MAPA, que es lo unico que de verdad importa. Se compara con
	# tools/comparar_huella.py.
	if world.has_method("resumen_chunks"):
		var lineas := PackedStringArray()
		for fila in world.resumen_chunks():
			lineas.append("%d %d %d %d" % [fila[0], fila[1], fila[2], fila[3]])
		lineas.sort()
		var fh := FileAccess.open("user://huella_%s.txt" % ("host" if Net.hosting else "cliente"), FileAccess.WRITE)
		if fh:
			fh.store_string("
".join(lineas))
			fh.close()
			print("[estructuralan] %s: huella escrita, %d chunks" % [quien, lineas.size()])
	get_tree().quit()


## --fisicalan: EN LAN, ¿CAEN LAS COSAS EN LAS DOS PANTALLAS? El invitado no desprende nada por su
## cuenta (se lo dice el anfitrion celda a celda), asi que si ese aviso no llega o llega mal, el
## invitado ve el edificio intacto y luego los escombros APARECEN ya en el suelo, sin caida.
##
## Se revienta algo delante del jugador y se cuentan los cuerpos fisicos vivos durante unos segundos.
## Si el anfitrion cuenta y el invitado no, el fallo esta en la replica de trozos sueltos.
## --escombrolan: DISPARAR A LO QUE CAE, EN RED. El anfitrion revienta la mesa del mapa de pruebas (llega a
## las dos maquinas por Net.net_explode) y durante 3 s le dispara a los bloques QUE AUN SE MUEVEN por el
## camino de player.gd (rayo de fisica, carve_body y Net.net_escombro). A los 25 s cada maquina escribe sus
## bloques (id, voxels, donde) en user://escombrolan_<rol>.txt y sus posturas pendientes y desconocidas.
## Si dos maquinas acaban con bloques distintos, el anfitrion manda posturas que el otro nunca aplica.
func _escombro_lan_test() -> void:
	var quien := "ANFITRION" if Net.hosting else "INVITADO"
	for i in 600:
		await get_tree().create_timer(0.1).timeout
		if Net.remotes.size() > 0 and not world.is_loading():
			break
	await get_tree().create_timer(4.0).timeout
	player.invulnerable = true
	if Net.hosting:
		# las cuatro patas de la mesa (como --mesatest=4): cae el tablero entero y los trozos de pata
		for pt in [Vector3(-3, 0, -3), Vector3(-3, 0, 3), Vector3(3, 0, -3), Vector3(3, 0, 3)]:
			Net.net_explode(world, Vector3(11.0, 1.35, 11.0) + pt, 1.3, 255)
		await get_tree().create_timer(0.3).timeout
		var space := get_world_3d().direct_space_state
		var r_talla: float = Net.radio_talla_escombro(160)
		var tiros := 0
		var fin := Time.get_ticks_msec() + 3000
		while Time.get_ticks_msec() < fin:
			for bd in world.get_bodies_debug():
				var rid = bd.get("rid")
				if rid == null or not (rid as RID).is_valid() or bool(world.info_cuerpo(rid).get("parado", false)):
					continue
				var objetivo := Vector3(bd.pos)
				var desde := objetivo + Vector3(0.0, 3.0, 0.0)
				var q := PhysicsRayQueryParameters3D.create(desde, objetivo + Vector3(0.0, -1.0, 0.0))
				q.exclude = [player.get_rid()]
				var hit := space.intersect_ray(q)
				if hit.is_empty() or not bool(world.info_cuerpo(hit.rid).get("existe", false)):
					continue
				Net.tallar_bloque(world, hit.rid, hit.position, r_talla, 255)
				tiros += 1
				break
			await get_tree().create_timer(0.08).timeout
		print("[escombrolan] ANFITRION: %d tiros a bloques en movimiento" % tiros)
	await get_tree().create_timer(25.0).timeout
	var lineas := PackedStringArray()
	for bd in world.get_bodies_debug():
		var p: Vector3 = bd.pos
		lineas.append("%d %d %.1f %.1f %.1f" % [int(bd.id), int(bd.voxels), p.x, p.y, p.z])
	lineas.sort()
	var f := FileAccess.open("user://escombrolan_%s.txt" % ("anfitrion" if Net.hosting else "invitado"), FileAccess.WRITE)
	if f:
		f.store_string("\n".join(lineas))
		f.close()
	var st: Dictionary = world.get_stats()
	print("[escombrolan] %s: bloques %d · congelados %d · pendientes %d · desconocidos %d" % [quien,
		lineas.size(), int(st.get("bodies_congelados", 0)), int(st.get("congel_pendientes", 0)), int(st.get("congel_desconocidos", 0))])
	await get_tree().create_timer(2.0).timeout
	get_tree().quit()


