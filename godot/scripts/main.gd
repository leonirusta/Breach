			await get_tree().process_frame
			ff += 1
		print("[enfoque] modo %d -> %.0f fps (activo=%s)" % [modo, ff / 2.5,
			str(player._cam_attr.dof_blur_far_enabled) if player._cam_attr else "-"])
	# --- desenfoque de movimiento: fps quieto vs girando
	var t0 := Time.get_ticks_msec()
	var f0 := 0
	while Time.get_ticks_msec() - t0 < 2500:
		await get_tree().process_frame
		f0 += 1
	print("[estela] quieto: %.0f fps · shader dibujandose=%s" % [
		f0 / 2.5, str(hud.mblur.visible) if hud.mblur else "no creado"])
	# el mismo giro con y sin estela, en la misma sesion: eso si compara
	for mb in [0.0, 0.22]:
		Settings.motion_blur = mb
		await get_tree().create_timer(0.6).timeout
		var tm := Time.get_ticks_msec()
		var fm := 0
		while Time.get_ticks_msec() - tm < 3000:
			player.rotate_look(Vector2(0.05, 0.0))
			await get_tree().process_frame
			fm += 1
		print("[estela] girando con densidad %.2f -> %.0f fps (dibujando=%s)" % [
			mb, fm / 3.0, str(hud.mblur.visible) if hud.mblur else "-"])
	await shot.call("4_estela")
	get_tree().quit()


## EL MAZO: que este en el equipamiento, que se vea a dos manos, que el arco pase por el golpe y
## que ROMPA la pared que tenga delante.
func _sledge_test() -> void:
	await get_tree().create_timer(4.0).timeout
	if team_overlay:
		Net.choose_team(Net.TEAM_CT)
		_close_team_select()
		await get_tree().create_timer(0.5).timeout
	var dir_out := "user://mazo"
	DirAccess.make_dir_recursive_absolute(dir_out)
	var shot := func(name: String):
		await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("%s/%s.png" % [dir_out, name])
	var idx := -1
	for i in Weapons.LIST.size():
		if String(Weapons.LIST[i].get("kind", "")) == "sledge":
			idx = i
	if idx < 0:
		print("[mazo] NO esta en el equipamiento")
		get_tree().quit()
		return
	player.switch_weapon(idx)
	await get_tree().create_timer(1.0).timeout
	var wm = player.weapon_model
	var camd2: Camera3D = player.get_node("Head/Camera3D")
	var local: Vector3 = camd2.to_local(wm.global_position)
	print("[mazo] ranura %d de %d · '%s' · clase '%s' · a dos manos=%s" % [idx + 1, Weapons.LIST.size(),
		Weapons.LIST[idx].name, String(wm.kind), str(not wm.one_handed)])
	var nombres: Array = []
	for ch in wm.get_children():
		nombres.append("%s(%s)" % [ch.name, ch.get_class()])
	print("[mazo] hijos del modelo: %s" % "; ".join(nombres))
	var aabb: AABB = wm.get_parent().get_viewport().get_camera_3d().global_transform.affine_inverse() * AABB()
	print("[mazo] modelo: visible=%s · hijos=%d · en camara (%.2f, %.2f, %.2f) · pivote visible=%s" % [
		str(wm.visible), wm.get_child_count(), local.x, local.y, local.z, str(player.weapon_pivot.visible)])
	await shot.call("1_en_mano")
	player.toggle_third_person()
	await get_tree().create_timer(0.8).timeout
	await shot.call("1b_tercera")
	player.toggle_third_person()
	await get_tree().create_timer(0.5).timeout
	# de cara a una pared
	var camd: Camera3D = player.get_node("Head/Camera3D")
	var llano: Vector3 = -player.global_transform.basis.z
	llano.y = 0.0
	player.look_at_point(player.global_position + Vector3(0, 1.5, 0) + llano.normalized() * 6.0)
	await get_tree().process_frame
	var pared: Dictionary = world.raycast(camd.global_position, -camd.global_transform.basis.z, 8.0)
	# pegarse a la pared: el mazo tiene 3 m de alcance, no es un rifle
	if pared.hit:
		var dpar: float = camd.global_position.distance_to(pared.position)
		if dpar > 1.6:
			player.global_position += llano.normalized() * (dpar - 1.4)
			world.set_player_position(player.global_position)
			await get_tree().create_timer(0.4).timeout
			pared = world.raycast(camd.global_position, -camd.global_transform.basis.z, 8.0)
	var d0: int = int(world.get_stats()["voxels_destroyed"])
	print("[mazo] pared a %.1f m" % (camd.global_position.distance_to(pared.position) if pared.hit else -1.0))
	player.fire()
	await get_tree().process_frame
	await get_tree().process_frame
	print("[mazo] al apretar: arco=%.2f s restantes, impacto pendiente=%s" % [player.swing_t, str(not player._swing_hit)])
	# fotos del arco entero: carga, golpe y vuelta
	for paso in [0.10, 0.20, 0.30, 0.36, 0.44]:
		while (player.SLEDGE_SWING - player.swing_t) < paso and player.swing_t > 0.0:
			await get_tree().process_frame
		await shot.call("arco_%03d" % int(paso * 1000.0))
	await get_tree().create_timer(0.22).timeout
	print("[mazo] tras 0,22 s: impacto dado=%s · voxels rotos %d" % [
		str(player._swing_hit), int(world.get_stats()["voxels_destroyed"]) - d0])
	await shot.call("3_golpe")
	await get_tree().create_timer(0.6).timeout
	var st2: Dictionary = world.get_stats()
	print("[mazo] al terminar el arco: arco=%.2f · voxels vaporizados %d · piezas %d · escombros %d · grupos %d" % [
		player.swing_t, int(st2["voxels_destroyed"]) - d0, world.get_body_count(),
		int(st2.get("debris_active", 0)), int(st2.get("groups_plain", 0))])
	get_tree().quit()


