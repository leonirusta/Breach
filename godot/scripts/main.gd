## --atracolan (anfitrion con --lanhost=sala --lanmap=city, invitado con --lanjoin): EL ATRACO ES UNO SOLO.
## El INVITADO abre la caja, coge el cubo y lo lleva al terminal; el ANFITRION, de otro equipo, se lo roba
## quedandose al lado; y el ingreso da los puntos al anfitrion en las DOS pantallas. Cada maquina imprime
## lo que ve para compararlo.
func _atraco_lan_test() -> void:
	var soy_host: bool = Net.hosting
	var tag := "[atracolan %s]" % ("HOST" if soy_host else "INV")
	for _i in 240:
		await get_tree().create_timer(0.5).timeout
		if heist != null and heist.vault != null and (soy_host or int(heist.heist_id) > 0):
			break
	# sin bots: aqui se mide a las personas
	var limpiar := func():
		for e in enemies.get_children():
			e.queue_free()
	limpiar.call()
	Net.choose_team(Net.TEAM_T if soy_host else Net.TEAM_CT)
	player.apply_team(Net.my_team())
	player.invulnerable = true
	await get_tree().create_timer(2.0).timeout
	print("%s atraco %d · caja en %s · terminal en %s · yo %s" % [tag, heist.heist_id, str(heist.vault.global_position.round()),
		str(heist.cashout.global_position.round()), Net.my_team()])
	var esperar := func(cond: Callable, max_s: float) -> bool:
		var t := 0.0
		while t < max_s:
			if cond.call():
				return true
			limpiar.call()
			await get_tree().create_timer(0.25).timeout
			t += 0.25
		return false
	if not soy_host:
		# 1) ABRIR: al lado de la caja, quieto
		player.global_position = heist.vault.global_position + Vector3(0, 0.1, 1.4)
		player.velocity = Vector3.ZERO
		await get_tree().create_timer(1.5).timeout
		heist.pedir("abrir")
		var abrio: bool = await esperar.call(func(): return heist.vault_state == 2, 40.0)
		print("%s caja abierta: %s" % [tag, str(abrio)])
		# 2) COGER el cubo
		await esperar.call(func(): return heist.cube != null and is_instance_valid(heist.cube), 5.0)
		player.global_position = heist.cube.global_position + Vector3(0, -0.5, 1.2)
		await get_tree().create_timer(1.5).timeout
		heist.pedir("coger")
		var cogido: bool = await esperar.call(func(): return heist.carrier == heist.mi_id(), 6.0)
		print("%s cubo cogido: %s" % [tag, str(cogido)])
		# 3) LLEVARLO al terminal: andando a saltos cortos para que el anfitrion vea el camino
		var destino: Vector3 = heist.cashout.global_position + Vector3(0, 0.0, 1.4)
		var desde: Vector3 = player.global_position
		for k in 30:
			player.global_position = desde.lerp(destino, float(k + 1) / 30.0) + Vector3(0, 0.2, 0)
			player.velocity = Vector3.ZERO
			var v: Vector3 = heist.cashout.global_position + Vector3(0, 0.9, 0) - player.cam.global_position
			player.look.x = atan2(-v.x, -v.z)
			player.look.y = atan2(v.y, Vector2(v.x, v.z).length())
			await get_tree().create_timer(0.1).timeout
		var ingresando: bool = await esperar.call(func(): return heist.out_state == 2, 15.0)
		print("%s ingresando: %s · del equipo %s" % [tag, str(ingresando), heist.out_equipo])
		# me aparto para que el anfitrion lo robe
		player.global_position = heist.cashout.global_position + Vector3(25, 1, 0)
		var robado: bool = await esperar.call(func(): return heist.out_equipo == Net.TEAM_T, 20.0)
		print("%s veo el terminal robado por el amarillo: %s" % [tag, str(robado)])
		var cobrado: bool = await esperar.call(func(): return int(puntos_equipo.get(Net.TEAM_T, 0)) >= 1000, 30.0)
		print("%s puntos: %s (cobrado %s)" % [tag, str(puntos_equipo), str(cobrado)])
		await get_tree().create_timer(7.0).timeout
		print("%s CAJA SIGUIENTE: atraco %d en %s · terminal %s" % [tag, heist.heist_id, str(heist.vault.global_position.round()), str(heist.cashout.global_position.round())])
	else:
		player.global_position = heist.vault.global_position + Vector3(30, 1, 30)
		var abrio2: bool = await esperar.call(func(): return heist.vault_state == 2, 60.0)
		print("%s el invitado ha abierto la caja: %s" % [tag, str(abrio2)])
		var lleva: bool = await esperar.call(func(): return heist.carrier != 0 and heist.carrier != heist.mi_id(), 30.0)
		print("%s el invitado lleva el cubo: %s (carrier %d)" % [tag, str(lleva), heist.carrier])
		var dep: bool = await esperar.call(func(): return heist.out_state == 2, 40.0)
		print("%s ingresando: %s · del equipo %s · cubo en %s" % [tag, str(dep), heist.out_equipo,
			str(heist.cube.global_position.round()) if heist.cube else "-"])
		await get_tree().create_timer(2.0).timeout
		# 4) ROBARLO: el anfitrion (amarillo) se queda al lado
		player.global_position = heist.cashout.global_position + Vector3(1.5, 0.3, 0)
		var robo: bool = await esperar.call(func(): return heist.out_equipo == Net.TEAM_T, 15.0)
		print("%s robado: %s" % [tag, str(robo)])
		await get_tree().create_timer(2.0).timeout
		heist.out_t = heist.DEPOSIT_TIME - 0.5
		await esperar.call(func(): return int(puntos_equipo.get(Net.TEAM_T, 0)) >= 1000, 10.0)
		print("%s puntos: %s" % [tag, str(puntos_equipo)])
		await get_tree().create_timer(7.0).timeout
		print("%s CAJA SIGUIENTE: atraco %d en %s · terminal %s" % [tag, heist.heist_id, str(heist.vault.global_position.round()), str(heist.cashout.global_position.round())])
		await get_tree().create_timer(4.0).timeout
	get_tree().quit(0)


## --cajacae: "ROMPO EL PISO Y NO CAEN". Se abre un agujero bajo la caja fuerte y bajo el terminal y se
## mira cuanto bajan y si quedan apoyados.
func _caja_cae_test() -> void:
	for _i in 120:
		if team_overlay != null:
			break
		await get_tree().create_timer(0.5).timeout
	Net.choose_team(Net.TEAM_V)
