## Los cinco efectos nuevos: mira del francotirador, sangre, sordera, crujidos y polvo persistente.
func _fx5_test() -> void:
	await get_tree().create_timer(4.0).timeout
	if team_overlay:
		Net.choose_team(Net.TEAM_CT)
		_close_team_select()
		await get_tree().create_timer(0.5).timeout
	var dir_out := "user://fx5"
	DirAccess.make_dir_recursive_absolute(dir_out)
	var shot := func(name: String):
		await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("%s/%s.png" % [dir_out, name])
	# --- 5) mira del francotirador
	var sni := -1
	for i in Weapons.LIST.size():
		if String(Weapons.LIST[i].get("sound", "")) == "sniper":
			sni = i
	if sni < 0:
		# el equipamiento no lleva francotirador: se le pone el sonido a la primaria, que es lo que
		# mira el HUD para decidir si toca mira telescopica
		Weapons.LIST[0]["sound"] = "sniper"
		Weapons.LIST[0]["ads_fov"] = 0.35
		sni = 0
	player.switch_weapon(sni)
	await get_tree().create_timer(0.8).timeout
	player.touch_aim = true
	await get_tree().create_timer(0.8).timeout
	print("[fx5] mira: activa=%s · arma oculta=%s · fov %.0f · arma '%s' sonido '%s' · apuntando=%s" % [
		str(hud.scope_on), str(not player.weapon_model.visible), player.get_node("Head/Camera3D").fov,
		Weapons.LIST[player.current].name, String(Weapons.LIST[player.current].get("sound", "")), str(player.aiming)])
	await shot.call("1_mira")
	player.touch_aim = false
	await get_tree().create_timer(0.5).timeout
	# --- 4) sangre. Se comprueba el efecto en si: salpicadura + mancha pegada a la pared que haya
	# detras. (El punto de llamada es la misma rama que ya emite el marcador de acierto.)
	var camd: Camera3D = player.get_node("Head/Camera3D")
	var fw: Vector3 = -camd.global_transform.basis.z
	var pared: Dictionary = world.raycast(camd.global_position, fw, 30.0)
	effects.blood_n = 0
	if pared.hit:
		# la victima, medio metro por delante de la pared
		var vict: Vector3 = pared.position - fw * 0.5
		for k in 3:
			effects.blood(vict, fw)
			await get_tree().process_frame
	print("[fx5] sangre: llamadas %d · manchas pegadas en la pared %d · pared a %.1f m" % [
		effects.blood_n, effects._blood_pool.size(), camd.global_position.distance_to(pared.position) if pared.hit else -1.0])
	await shot.call("2_sangre")
	# --- 3) sordera
	Audio.deafen(1.0)
	await get_tree().create_timer(0.4).timeout
	print("[fx5] sordera: corte del filtro %.0f Hz · pitido %s dB" % [
		Audio._lowpass.cutoff_hz, str(int(Audio._tinnitus.volume_db))])
	# --- 1 y 2) crujidos y polvo persistente: se corta un edificio
	var size: Vector3 = world.get_world_size()
	seed(3)
	var best := Vector3.ZERO
	var best_h := -1.0
	for attempt in 600:
		var x := randf_range(size.x * 0.15, size.x * 0.85)
		var z := randf_range(size.z * 0.15, size.z * 0.85)
		var top: Dictionary = world.raycast(Vector3(x, size.y - 1.0, z), Vector3.DOWN, size.y)
		if top.hit and top.position.y > best_h and top.position.y > 5.0:
			best_h = top.position.y
			best = Vector3(x, top.position.y, z)
	player.global_position = best + Vector3(-14, 1.0, 0)
	player.look_at_point(best)
	world.set_player_position(player.global_position)
	await get_tree().create_timer(0.6).timeout
	world.carve_beam(best + Vector3(-16, -1.5, 0), Vector3(1, 0, 0), 32.0, 1.2, 255, true)
	var t0 := Time.get_ticks_msec()
	while Time.get_ticks_msec() - t0 < 12000:
		await get_tree().process_frame
	print("[fx5] piezas %d · peor ratio %.2f · iteraciones %d · celdas fallidas %d" % [
		world.get_body_count(), float(world.get_stats()["struct_worst_ratio"]),
		int(world.get_stats()["struct_iterations"]), int(world.get_stats()["struct_failures"])])
	await shot.call("3_derrumbe")
	get_tree().quit()


## VARIOS MISILES seguidos: cuatro impactos en el mismo edificio (a distintas alturas y caras) y
## uno en el de al lado. Se vigila que ninguno provoque el derrumbe en cadena.
func _multi_missile_test() -> void:
	await get_tree().create_timer(4.0).timeout
	Settings.bots_enabled = false
	for e in enemies.get_children():
		e.queue_free()
	var size: Vector3 = world.get_world_size()
	var centers: PackedVector3Array = world.get_building_centers()
	# los dos edificios mas altos
	var alt: Array = []
	for c in centers:
		var r: Dictionary = world.raycast(Vector3(c.x, size.y - 1.0, c.z), Vector3.DOWN, size.y)
		if r.hit and r.position.y > 12.0:
			alt.append([r.position.y, Vector3(c.x, r.position.y, c.z)])
	if alt.size() < 2:
		print("[misiles] no hay edificios suficientes")
		get_tree().quit()
		return
	alt.sort_custom(func(a, b): return a[0] > b[0])
	var A: Vector3 = alt[0][1]
	var B: Vector3 = alt[1][1]
	var col_a0: int = _domino_solid_column(A.x, A.z, size.y)
	var col_b0: int = _domino_solid_column(B.x, B.z, size.y)
	print("[misiles] edificio A %.0f m en %.0f,%.0f (columna %d) · edificio B %.0f m en %.0f,%.0f (columna %d)" % [
		alt[0][0], A.x, A.z, col_a0, alt[1][0], B.x, B.z, col_b0])
	player.global_position = world.find_ground(Vector3(A.x - 40.0, 2.0, A.z)) + Vector3(0, 1.0, 0)
	player.look_at_point(A)
	player.invulnerable = true
	world.set_player_position(player.global_position)
	await get_tree().create_timer(1.0).timeout
	# la cara oeste del edificio A, a cuatro alturas
	var impactos: Array = []
	for f in [0.25, 0.45, 0.65, 0.85]:
		var y: float = alt[0][0] * f
		var xx: float = A.x
		var aire := 0.0
		var last := A.x
		var x2: float = A.x
		while x2 > A.x - 60.0:
			if int(world.get_material_at(Vector3(x2, y, A.z))) != 0:
				last = x2
				aire = 0.0
			else:
				aire += 0.25
				if aire >= 2.0 and last < A.x:
					xx = last
					break
			x2 -= 0.25
		var pimp := Vector3(xx + 0.4, y, A.z)
		print("[dbg] altura %.0f -> fachada x=%.1f (centro %.1f) · material ahi=%d, 0,4 m dentro=%d" % [
			y, xx, A.x, int(world.get_material_at(Vector3(xx, y, A.z))), int(world.get_material_at(pimp))])
		impactos.append(pimp)
	var st0: Dictionary = world.get_stats()
	var d0: int = int(st0["voxels_destroyed"])
	for i in impactos.size():
		Net.net_explode(world, impactos[i], 4.0, 255)
		if effects:
			effects.explosion(impactos[i], 4.5)
		await get_tree().create_timer(3.0).timeout
		var st: Dictionary = world.get_stats()
		print("[misiles] cohete %d a %.0f m de altura -> columna A %d/%d · fallidas %d · piezas %d · destruidos %d" % [
			i + 1, impactos[i].y, _domino_solid_column(A.x, A.z, size.y), col_a0,
			int(st["struct_failures"]), world.get_body_count(), int(st["voxels_destroyed"]) - d0])
	# y uno al edificio de al lado, para ver que no se contagia
	Net.net_explode(world, B + Vector3(0, -alt[1][0] * 0.5, 0) + Vector3(-3.0, 0, 0), 4.0, 255)
	await get_tree().create_timer(6.0).timeout
	print("[misiles] FIN · columna A %d/%d · columna B %d/%d · piezas vivas %d · destruidos %d" % [
		_domino_solid_column(A.x, A.z, size.y), col_a0, _domino_solid_column(B.x, B.z, size.y), col_b0,
		world.get_body_count(), int(world.get_stats()["voxels_destroyed"]) - d0])
	get_tree().quit()


