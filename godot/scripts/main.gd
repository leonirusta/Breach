	print("[cartuchos] faltan 4, disparo a media recarga: tenia %d, tras el tiro %d, recargando %s -> %s" % [antes, a2, str(player.reloading), "bien" if ok2 else "MAL"])
	print("[cartuchos] %s" % ("TODO BIEN" if ok1 and ok2 else "MAL"))
	get_tree().quit()



