## LA CAMARA DE CUERPO, EN PARTIDA Y DE VERDAD. Es la unica forma de saber si el interruptor llega
## al efecto: en una escena de prueba el shader se ve, pero eso no dice nada de si el camino
## configuracion -> apply_graphics -> hud llega entero.
## EL INTERRUPTOR DE LA CAMARA DE CUERPO, en un solo sitio. Son tres cosas que tienen que ir juntas
## o el efecto queda a medias: la imagen (HUD), el bamboleo de la camara (jugador) y el tope de campo
## de vision. Lo llaman tanto la configuracion grafica como el boton del menu en partida.
func set_bodycam(nivel: int) -> void:
	if hud and hud.has_method("set_bodycam"):
		hud.set_bodycam(nivel)
	if player and ("_bc_k" in player):
		player._bc_k = [0.0, 1.0, 2.0][nivel]
		# GRAN ANGULAR: UN SUELO, NO UN TOPE. Esto era `minf(Settings.fov, _bc_fov)` con 78/72, o sea
		# que encender la bodycam ESTRECHABA la vista: con el campo de vision por defecto en 90 se
		# bajaba a 72, justo lo contrario de un gran angular. Una camara de cuerpo de verdad ronda los
		# 120 grados horizontales; aqui son verticales, asi que 88 y 96 (unos 115 y 125 en horizontal)
		# dan esa sensacion. Y sigue siendo un minimo: si tu tienes 105 puestos, se respetan.
		# EL GRAN ANGULAR, CON SU PROPIO MANDO (Graficos -> BODYCAM -> "Gran angular"): Normal deja tu
		# campo de vision tal cual, y los otros tres lo ensanchan por debajo con un minimo.
		var anchos: Array = [0.0, 88.0, 96.0, 104.0]
		var ia: int = clampi(Settings.gfx_value("bc_fov", quality), 0, anchos.size() - 1)
		player._bc_fov = 0.0 if nivel <= 0 else float(anchos[ia])
		# y el balanceo de camara tiene el suyo
		if "_bc_sway" in player:
			player._bc_sway = [0.0, 0.5, 1.0, 1.5, 2.1, 3.0][clampi(Settings.gfx_value("bc_balanceo", quality), 0, 5)]


func _bc_foto() -> void:
	await get_tree().create_timer(3.0).timeout
	# --bcui=0|1 fuerza el ajuste "afecta a la interfaz" para poder comparar las dos capturas
	for f in OS.get_cmdline_user_args():
		if f.begins_with("--bcui="):
			Settings.gfx_custom = true
			Settings.gfx["bc_ui"] = int(f.substr(7))
			set_bodycam(Settings.gfx_value("bodycam", quality))
			await get_tree().process_frame
			await get_tree().process_frame
	print("[bc] Settings.gfx_value(bodycam) = %d   gfx_custom=%s" % [
		Settings.gfx_value("bodycam", quality), str(Settings.gfx_custom)])
	print("[bc] hud tiene set_bodycam: %s   player tiene _bc_k: %s" % [
		str(hud != null and hud.has_method("set_bodycam")), str(player != null and ("_bc_k" in player))])
	for caso in [["off", 0], ["completa", 2]]:
		hud.set_bodycam(int(caso[1]))
		player._bc_k = [0.0, 1.0, 2.0][int(caso[1])]
		for _f in 25:
			await get_tree().process_frame
		var im := get_viewport().get_texture().get_image()
		im.save_png("user://bc_%s.png" % String(caso[0]))
		print("[bc] %s  ojo_rect=%s visible=%s -> %s" % [String(caso[0]),
			str(hud.ojo_rect != null), str(hud.ojo_rect != null and hud.ojo_rect.visible),
			ProjectSettings.globalize_path("user://bc_%s.png" % String(caso[0]))])
	get_tree().quit()


func _lagbench() -> void:
	await get_tree().create_timer(2.5).timeout
	# --vsync: como juega la gente (con sincronizacion vertical). Sin ella la grafica trabaja al 100 % sin
	# descanso, se calienta y frena: medido, todo sale a 20-22 ms de GPU cuando jugando eran 12-16.
	if not "--vsync" in OS.get_cmdline_user_args():
		DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
		Engine.max_fps = 0
	# CADA CASO APAGA UNA COSA, SE MIDE Y SE VUELVE A ENCENDER (--lagbench): asi cada numero es lo que cuesta
	# esa cosa sola, no la suma de las anteriores. Se mide el cuadro entero y el tiempo de la GRAFICA (GPU), que
	# es donde se va el presupuesto en la maquina de referencia (medido en la cuarentena: 15-16 ms de GPU).
	var e: Environment = env.environment
	var vp_rid := get_viewport().get_viewport_rid()
	RenderingServer.viewport_set_measure_render_time(vp_rid, true)
	var vp := get_viewport()
	var casos: Array = [
		["todo encendido", func(): pass, func(): pass],
		["sin oclusion volumetrica", func(): set_voxel_ao(false), func(): set_voxel_ao(true)],
		["sin sombras del sol", func(): sun.shadow_enabled = false, func(): sun.shadow_enabled = true],
		["sombra de 1 tramo", func(): sun.directional_shadow_mode = DirectionalLight3D.SHADOW_ORTHOGONAL,
			func(): sun.directional_shadow_mode = DirectionalLight3D.SHADOW_PARALLEL_2_SPLITS if quality >= 2 else DirectionalLight3D.SHADOW_ORTHOGONAL],
		["sin resplandor (glow)", func(): e.glow_enabled = false, func(): e.glow_enabled = quality >= 2],
		["sin niebla", func(): e.fog_enabled = false, func(): e.fog_enabled = true],
		["sin niebla volumetrica", func(): e.volumetric_fog_enabled = false, func(): e.volumetric_fog_enabled = true],
		["sin cielo (color liso)", func(): _cielo_on = false; _aplicar_cielo(), func(): _cielo_on = true; _aplicar_cielo()],
		["escala 3D 0,85", func(): vp.scaling_3d_scale = 0.85, func(): vp.scaling_3d_scale = [0.75, 0.85, 1.0, 1.0][quality]],
		["sin lente (ojo de pez + grano)", func(): hud.set_ojo_pez(false); hud.set_grano(false), func(): pass],
		["sin enfoque (profundidad de campo)", func(): Settings.focus_mode = 0, func(): Settings.focus_mode = Settings.gfx_value("focus", quality)],
		["sin vineta", func(): hud.set_vineta(0), func(): hud.set_vineta(Settings.gfx_value("vineta", quality))],
		["escala 3D al 50 %", func(): vp.scaling_3d_scale = 0.5, func(): vp.scaling_3d_scale = [0.25, 0.33, 0.4, 0.5, 0.65, 0.75, 0.85, 1.0][Settings.gfx_value("render_scale", quality)]],
		["todo encendido otra vez", func(): pass, func(): pass],
	]
	# --gpuserie: la GPU cuadro a cuadro, en tramos de 0,25 s, sin tocar nada (para ver si va a saltos)
	if "--gpuserie" in OS.get_cmdline_user_args():
		for q in OS.get_cmdline_user_args():
			if q.begins_with("--gpuquitar="):
				for k in q.substr(12).split(","):
					match k:
						"cielo": _cielo_on = false; _aplicar_cielo()
						"volfog": e.volumetric_fog_enabled = false
						"ao": set_voxel_ao(false)
						"glow": e.glow_enabled = false
						"niebla": e.fog_enabled = false
						"sombras": sun.shadow_enabled = false
						"lod1": world.set_lod_distance_scale(0.25)
						"lod0": world.set_lod_distance_scale(0.15)
						"particulas":
							if effects:
								effects.process_mode = Node.PROCESS_MODE_DISABLED
								effects.visible = false
				print("[gpu] quitado: %s" % q.substr(12))
		var linea := ""
		await get_tree().create_timer(4.0).timeout      # que termine de rehacer mallas si se cambio el detalle
		for tramo in 48:
			var g2 := 0.0
			var n2 := 0
			var mx := 0.0
			var t2 := 0.0
			while t2 < 0.25:
				await get_tree().process_frame
				t2 += get_process_delta_time()
				var gg := RenderingServer.viewport_get_measured_render_time_gpu(vp_rid)
				g2 += gg
				mx = maxf(mx, gg)
				n2 += 1
			linea += "%.0f/%.0f " % [g2 / maxi(n2, 1), mx]
			if tramo % 8 == 7:
				print("[gpu] %s" % linea)
				linea = ""
		get_tree().quit()
		return
	# ABAB: el i3 se calienta y va perdiendo velocidad mientras mide (medido: "todo encendido" de 17,8 a 23,9 ms
	# de GPU sin tocar nada). Cada caso se apaga y enciende 3 veces seguidas y se compara la media de cada lado:
	# la deriva cae igual en los dos.
	for c in casos.slice(1, casos.size() - 1):
		var con := 0.0
		var sin := 0.0
		for _r in 3:
			for lado in [0, 1]:
				if lado == 1:
					(c[1] as Callable).call()
				for _f in 20:
					await get_tree().process_frame
				var g := 0.0
				for _f in 60:
					await get_tree().process_frame
					g += RenderingServer.viewport_get_measured_render_time_gpu(vp_rid)
				if lado == 1:
					sin += g / 60.0
					(c[2] as Callable).call()
				else:
					con += g / 60.0
		print("[lag] %-34s  GPU con %5.2f ms · sin %5.2f ms · ahorra %5.2f ms" % [String(c[0]), con / 3.0, sin / 3.0, (con - sin) / 3.0])
	get_tree().quit()


## Llena el cristal de grietas (o lo limpia) para poder medir lo que cuesta el peor caso.
func _bench_cristal(lleno: bool) -> void:
	if world == null or world.glass_material == null:
		return
	var v := PackedVector4Array()
	v.resize(16)
	if lleno and player:
		for i in 16:
			var a: float = float(i) * 0.4
			v[i] = Vector4(player.global_position.x + cos(a) * 6.0, player.global_position.y + 1.0,
				player.global_position.z + sin(a) * 6.0, 0.55)
	(world.glass_material as ShaderMaterial).set_shader_parameter("impactos", v)


## CUANDO EMPEZO LA PARTIDA. El servidor de cuentas no paga partidas cortas (es el freno contra
## entrar y salir en bucle para farmear), asi que hay que decirle cuanto ha durado de verdad.
var _inicio_partida := 0.0


## Segundos jugados. Se mide desde que el mapa esta listo, no desde que arranca el proceso: cargar
## Monaco son 17 s y no son partida.
func segundos_partida() -> int:
	if _inicio_partida <= 0.0:
		return 0
	return int(Time.get_ticks_msec() * 0.001 - _inicio_partida)


## ARCHIVOS EN FRIO (2026-10-01, medido): la PRIMERA vez que se abre un archivo del proyecto en esta maquina cuesta
## 10-134 ms (el sistema lo revisa y lo lee del disco); la segunda, 0,4 ms. Jugando desde la carpeta del proyecto
## (JUGAR.bat) eso eran tirones de ~120 ms la primera vez que salia cada cosa en la partida. Aqui un hilo de baja
## prioridad lee una vez, durante la carga, lo que el juego carga en partida (texturas, escenas, sombreados y guiones;
## los sonidos los precarga el audio por bancos). En el APK todo va en un paquete y no hace falta.
static var _archivos_calentados := false
static var _tarea_calentar := -1
static var _cancelar_calentar := false

## al salir (de la partida o del juego) el hilo se avisa y se espera: si sigue corriendo cuando el nodo ya se ha
## liberado, el proceso muere (ver Audio._tareas)
func _exit_tree() -> void:
	AvatarScript.almacen_activo = false
	AvatarScript.vaciar_almacen()   # las armas guardadas de los bots muertos (avatar_animator, ALMACEN)
	if _lamp_tarea >= 0:
		WorkerThreadPool.wait_for_task_completion(_lamp_tarea)
		_lamp_tarea = -1
	if _tarea_calentar >= 0:
		_cancelar_calentar = true
		WorkerThreadPool.wait_for_task_completion(_tarea_calentar)
		_tarea_calentar = -1

func _calentar_archivos() -> void:
	if _archivos_calentados or OS.has_feature("template") or "--sincalentar" in OS.get_cmdline_user_args():
		return
	_archivos_calentados = true
	_tarea_calentar = WorkerThreadPool.add_task(func() -> void:
		var t0 := Time.get_ticks_msec()
		var n := 0
		var bytes := 0
		var pila: Array = ["res://.godot/imported", "res://shaders", "res://scripts", "res://armas", "res://assets"]
		while not pila.is_empty() and not _cancelar_calentar:
			var dir: String = pila.pop_back()
			var da := DirAccess.open(dir)
			if da == null:
				continue
			for sub in da.get_directories():
				pila.append(dir + "/" + sub)
			for f in da.get_files():
				var ext := String(f).get_extension()
				if dir.begins_with("res://.godot/imported"):
					if not ext in ["ctex", "scn", "sample", "mp3str", "ctexarray", "res"]:
						continue
				elif not ext in ["gdshader", "gd", "glb", "png", "tres", "res"]:
					continue
				var fh := FileAccess.open(dir + "/" + f, FileAccess.READ)
				if fh == null:
					continue
				while fh.get_position() < fh.get_length():
					bytes += fh.get_buffer(1 << 20).size()
				fh.close()
				n += 1
		print("[calentar] %d archivos (%.0f MB) leidos en %d ms, en segundo plano" % [n, bytes / 1048576.0, Time.get_ticks_msec() - t0])
	, false, "calentar archivos")


## EL CADAVER QUE SE DISUELVE, ESTRENADO EN LA CARGA (2026-10-01): el sombreado de disolver sobre el muñeco y su arma
## son pipelines que Godot compila la primera vez que se dibujan (5, ~65 ms de tiron con el primer muerto). Un muñeco
## armado y medio disuelto, bajo el suelo y dentro del encuadre, unos fotogramas.
## Y LO PRIMERO DE CADA TIROTEO (2026-10-01, medido con bots): el primer cohete (su material se generaba y compilaba
## al instanciarlo: 44-56 ms), el primer fogonazo, trazador, humo de boca, casquillo e impacto. Un cohete quieto (sin
## proceso: no vuela ni revienta nada) y el muñeco disparando unos fotogramas, todo bajo el suelo.
func _precalentar_disolver(pos: Vector3) -> void:
	var t0 := Time.get_ticks_msec()
	var av := AvatarScript.new()
	add_child(av)
	av.build(AvatarScript.ALTURA, false, Color(1.0, 0.75, 0.7), false)
	av.equip_weapon("rifle", "carabina_556")
	av.global_position = pos
	av.disolucion(0.5)
	var cohete: Node3D = EnemyScript.ROCKET_SCENE.instantiate()
	cohete.process_mode = Node.PROCESS_MODE_DISABLED
	add_child(cohete)
	cohete.global_position = pos + Vector3(1.0, 0.5, 0.0)
	var esc_roto: Node3D = preload("res://scripts/escudo.gd").precalentar(self, pos + Vector3(-1.0, 0.8, 0.0))
	# el PRIMER duplicate() de un cargador (el que cae al recargar) eran 16 ms; los siguientes 0,2-0,4 de cualquier arma
	if av._wm != null and is_instance_valid(av._wm) and av._wm.cargador != null and is_instance_valid(av._wm.cargador):
		(av._wm.cargador.duplicate() as Node).free()
	# los datos de las recargas, la caida y el escudo (json que se abrian la primera vez EN PARTIDA: un archivo en
	# frio en este PC son 10-130 ms; medido con --botsprof, av.a.recarga 18 ms la primera recarga de cada arma)
	for _tipo in AvatarScript.RECARGAS.keys():
		AvatarScript._recarga_datos(String(_tipo))
	AvatarScript._caida_datos()
	preload("res://scripts/escudo.gd").datos()
	var rd_pre: Node3D = null
	if av.skeleton != null and not "--sinprecalentarragdoll" in OS.get_cmdline_user_args():
		rd_pre = preload("res://scripts/ragdoll.gd").crear(self, av.skeleton, Vector3.ZERO, Vector3.ZERO, true)
	for _f in 4:
		var wm = av._wm
		if wm != null and is_instance_valid(wm) and wm.has_method("fire_flash"):
			wm.fire_flash(true)
		if effects:
			effects.tracer(pos + Vector3(0, 1.2, 0), pos + Vector3(0, 1.2, 6.0))
			effects.muzzle_smoke(pos + Vector3(0, 1.2, 0), Vector3.FORWARD, 0.55)
			if wm != null and is_instance_valid(wm):
				effects.shell_ajena(wm, Vector3.FORWARD)
			effects.sparks(pos + Vector3(0, 1.0, 1.0), Vector3.UP)
			# (2026-10-12, bug del movil: "al disparar o al darle a uno por primera vez se congela"): la sangre, las
			# manchas, el impacto en pared y el cartucho de escopeta tambien, que se compilaban en pleno juego
			effects.blood(pos + Vector3(0, 1.2, 1.5), Vector3.FORWARD)
			effects.impact(pos + Vector3(0, 1.0, 1.2), Vector3.UP, 0, Color(0.6, 0.6, 0.6))
			effects.shell(pos + Vector3(0, 1.2, 0.5), Vector3.UP, true)
			effects.shell(pos + Vector3(0, 1.2, 0.5), Vector3.UP, false, true)
		# y el fogonazo del arma de PRIMERA persona (la tuya), que es otra malla y otras particulas
		if player and player.weapon_model and is_instance_valid(player.weapon_model) and player.weapon_model.has_method("fire_flash"):
			player.weapon_model.fire_flash(true)
		await get_tree().process_frame
	if is_instance_valid(av):
		av.queue_free()
	if is_instance_valid(cohete):
		cohete.queue_free()
	if is_instance_valid(esc_roto):
		esc_roto.queue_free()
	if rd_pre != null and is_instance_valid(rd_pre):
		rd_pre.queue_free()
	print("[precalentar] muñeco, disparo y cohete en %d ms" % (Time.get_ticks_msec() - t0))


func _on_world_ready() -> void:
	# LA OCLUSION POR RAYOS (voxel_world.cpp oclusionRayos, 2026-10-14): lo que tapa una pared no se dibuja.
	# 300 rayos por fotograma en el movil, 500 en el PC; --sinoclusionrayos = sin ella, --oclusionrayos=N otro numero
	if world.has_method("set_oclusion_rayos"):
		var _nr := 300 if Settings.is_mobile() else 500
		for _a in OS.get_cmdline_user_args():
			if String(_a).begins_with("--oclusionrayos="):
				_nr = int(String(_a).substr(16))
		if "--sinoclusionrayos" in OS.get_cmdline_user_args():
			_nr = 0
		world.set_oclusion_rayos(_nr)
	# RESCATE de compañeros caidos (rescate.gd): recoger, cargar, soltar y revivir
	if rescate == null:
		rescate = preload("res://scripts/rescate.gd").new()
		rescate.name = "Rescate"
		rescate.main = self
		rescate.player = player
		add_child(rescate)
	for _fm in OS.get_cmdline_user_args():
		if _fm.begins_with("--fotomira="):
			_foto_mira(_fm.substr(11))
	Estadisticas.empieza_partida(String(Settings.map))
	_inicio_partida = Time.get_ticks_msec() * 0.001
	_aplicar_texturas()      # el lado del voxel del mapa ya es el bueno (10 o 20 cm)
	WeaponModelScript.recoger_pedidas()   # las armas de los bots que ya se leyeron en sus hilos
	SkinsArmas.recoger_texturas()
	loading = false
	_empezar_autoajuste()
	# ya en partida: el audio que quede por precalentar va a cuentagotas, y los efectos se estrenan
	# AHORA bajo el suelo (20 m delante, 9 m abajo: dentro del encuadre, tapado por el terreno)
	Audio.presupuesto_precalentar_ms = 4.0
	# SONIDO SIN BAJONES: desde aqui el audio no carga nada en el hilo principal, y los bancos del modo se cargan
	# en hilos (en unos segundos estan todos: la primera voz de cada criatura ya no para el juego)
	Audio._en_partida = true
	# (gen/hab: las habilidades; sin esto el primer puñetazo de la partida sonaba mudo: se cargaba en un hilo y
	# sonaba la vez siguiente)
	var bancos: Array = ["bf/soldado", "bf/yo", "bf/gadget", "bf/destru", "bf/bala", "bf/proyectil", "armas", "bf/ui", "gen/hab"]
	if Settings.modo == "pve":
		bancos += ["l4d2/criaturas", "l4d2/armas", "l4d2/musica", "bf/amb", "gen"]
		bancos.append("l4d2/heli")
	else:
		bancos += ["bf/voz", "bf/modo"]
	Audio.precalentar_bancos(bancos)
	Audio.musica_lobby(false)   # se acabo la carga: fuera la musica del lobby
	# EL JUGADOR, EN EL MAPA ANTES DE LOS EFECTOS DE PRUEBA (2026-10-10, bug: "al entrar se ve el cielo azul sin nada y
	# una explosion en el medio"): los efectos se estrenan 9 m BAJO EL SUELO delante del jugador, pero se lanzaban con el
	# jugador todavia en el aire (antes de ponerlo en su salida): no habia suelo que los tapara.
	if player:
		player.global_position = world.get_spawn_position() + Vector3(0, 0.6, 0)
	if effects and player and effects.has_method("precalentar"):
		effects.precalentar(player.global_position - player.global_transform.basis.z * 20.0 + Vector3(0, -9, 0))
	# y los del puñetazo y el salto (hab_fx.gd): sus sombreados, ahora y no en el primer golpe
	if player:
		var hfx = HabFxScript.de(self)
		if hfx != null:
			hfx.precalentar(player.global_position - player.global_transform.basis.z * 20.0 + Vector3(0, -9, 0))
	_montar_cielo()
	_techo_iniciar()
	# LA NIEBLA VOLUMETRICA, ENCENDIDA. Sin ella los FogVolume del humo de las explosiones no se
	# dibujan: son volumenes que solo existen si el motor esta haciendo esa pasada.
	# Solo en PC y con calidad media o alta: en un movil esa pasada se come el presupuesto entero.
	var we := get_node_or_null("WorldEnvironment") as WorldEnvironment
	if we and we.environment and not Settings.is_mobile() and quality >= 1:
		we.environment.volumetric_fog_enabled = true
		we.environment.volumetric_fog_density = 0.0     # nada de niebla de fondo: solo el humo
		we.environment.volumetric_fog_length = 48.0
		we.environment.volumetric_fog_gi_inject = 0.0
		we.environment.volumetric_fog_sky_affect = 0.0  # el humo no tapa el cielo, por lo mismo
