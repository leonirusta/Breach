## --micfps: ABAB de 8 s con el microfono del chat de voz apagado / encendido (sin hablar): fotogramas por segundo y el peor
func _mic_fps() -> void:
	await get_tree().create_timer(10.0).timeout
	var cv = hud.root.get_node_or_null("ChatVoz") if hud else null
	if cv == null:
		return
	for vuelta in 4:
		var on := vuelta % 2 == 1
		cv.poner_mic(on)
		if on and "--micfpshabla" in OS.get_cmdline_user_args() and cv._mic:
			cv._mic.set_vox_threshhold(0.0)       # como si hablara todo el rato: comprime y manda siempre
		await get_tree().create_timer(1.0).timeout
		var n := 0
		var peor := 0.0
		var t0 := Time.get_ticks_usec()
		var ult := t0
		while Time.get_ticks_usec() - t0 < 8000000:
			await get_tree().process_frame
			var a := Time.get_ticks_usec()
			peor = maxf(peor, (a - ult) / 1000.0)
			ult = a
			n += 1
		print("[micfps] microfono %s: %.0f fps · peor %.1f ms" % ["ENCENDIDO" if on else "apagado", n / 8.0, peor])
	cv.poner_mic(false)


## EL AJUSTE AUTOMATICO DE GRAFICOS, UNA VEZ (autoajuste_graficos.gd). No en el tutorial, espectando, sin ventana ni en
## las pruebas (cualquier flag de banco o de fotos cambiaria lo que mide); `--autoajustetest` lo fuerza.
func _empezar_autoajuste() -> void:
	var args := OS.get_cmdline_user_args()
	if "--sinautoajuste" in args or DisplayServer.get_name() == "headless":
		return
	var prueba := "--autoajustetest" in args
	if not prueba:
		if Settings.autoajuste_hecho or Settings.tutorial_activo or bool(player and player.get("solo_mirar")):
			return
		for a in args:
			if a.begins_with("--") and not a.begins_with("--servidor") and not a.begins_with("--map=") and not a.begins_with("--lan"):
				return
	var aa = load("res://scripts/autoajuste_graficos.gd").new()
	aa.name = "AutoajusteGraficos"
	aa.main = self
	add_child(aa)


## --bombamigratest (en las DOS copias LAN, en bomba): EL ANFITRION SE VA EN MITAD DE LA PARTIDA (2026-10-20, bug: "mi
## amigo se fue, gano un equipo al instante, no reaparecia, y despues yo solo sin bots y sin las rondas ganadas").
## El anfitrion se cae a los 45 s; el que queda apunta cada 2 s la ronda, el marcador, los bots y su jugador.
func _bomba_migra_test() -> void:
	await get_tree().create_timer(12.0).timeout
	if Net.hosting:
		# que haya marcador: dos rondas ganadas por los T antes de caer
		for i in 2:
			await get_tree().create_timer(6.0).timeout
			if bomb_mode:
				Net.end_round(Net.TEAM_T, "prueba")
			await get_tree().create_timer(9.0).timeout
		print("[bombamigra] ANFITRION: %d-%d, me caigo AHORA" % [Net.score_t, Net.score_ct])
		OS.kill(OS.get_process_id())
		return
	for i in 45:
		await get_tree().create_timer(2.0).timeout
		var bots := 0
		for e in enemies.get_children():
			if "team" in e and is_instance_valid(e) and float(e.get("health")) > 0.0:
				bots += 1
		print("[bombamigra] t=%d hosting=%s ronda_viva=%s marcador=%d-%d duelo=%s bots_vivos=%d en_pie T=%d CT=%d yo: vida=%d espectando=%s" % [
			i * 2, str(Net.hosting), str(Net.round_live), Net.score_t, Net.score_ct, str(dm_bajas), bots, Net.en_pie(Net.TEAM_T),
			Net.en_pie(Net.TEAM_CT), int(player.health), str(player.get("spectating"))])
	get_tree().quit(0)



## EL PLANO DEL MAPA DESDE ARRIBA para la pantalla de carga de la partida (carga_partida.gd, 2026-10-28): camara
## ortografica en una SubViewport aparte, una foto y se guarda en res://ui/planos/<mapa>.png. --planofoto
const PLANO_CORTE_M := 4.0
var _plano_suelo := 0.0

func _plano_foto() -> void:
	while loading:
		await get_tree().process_frame
	var tam: Vector3 = world.get_world_size()
	# la CAMARA DEL JUGADOR, ortografica y mirando abajo desde el centro: el motor esconde lo que su camara no ve, asi que
	# una camara aparte solo sacaba lo que miraba el jugador. Se espera a que malle todo y se recorta al mapa.
	_plano_suelo = player.global_position.y
	player.set_physics_process(false)
	player.set_process(false)
	hud.visible = false
	for n in get_tree().get_nodes_in_group("hud_capas"):
		n.visible = false
	var c: Camera3D = player.cam
	c.projection = Camera3D.PROJECTION_ORTHOGONAL
	c.keep_aspect = Camera3D.KEEP_HEIGHT
	c.size = tam.z
	# CORTADO A 4 M SOBRE EL SUELO DE LA SALIDA (plano de arquitecto): lo de mas arriba (techos del hangar, de las casas)
	# queda por encima de la camara y no se dibuja
	var corte: float = _plano_suelo + PLANO_CORTE_M
	c.near = 0.05
	c.far = corte + 50.0
	c.global_transform = Transform3D(Basis.looking_at(Vector3.DOWN, Vector3.FORWARD), Vector3(tam.x * 0.5, corte, tam.z * 0.5))
	# fondo de un color que no existe en el mapa, para recortar lo que no es mapa; sin bots ni nadie
	if env and env.environment:
		env.environment.background_mode = Environment.BG_COLOR
		env.environment.background_color = Color(1, 0, 1)
		env.environment.fog_enabled = false
	await get_tree().create_timer(12.0).timeout
	for g in ["enemies", "criaturas", "aliados", "remotos", "bots"]:
		for n in get_tree().get_nodes_in_group(g):
			if n is Node3D:
				(n as Node3D).visible = false
	if player.avatar:
		player.avatar.visible = false
	for i in 3:
		await RenderingServer.frame_post_draw
	var img := get_viewport().get_texture().get_image()
	img.convert(Image.FORMAT_RGBA8)
	# lo magenta QUE TOCA EL BORDE, transparente (relleno desde fuera); los huecos de dentro, gris oscuro (si no, la carga
	# les dibujaba el contorno rojo por dentro). Y la imagen recortada a lo que si es mapa.
	var iw := img.get_width(); var ih := img.get_height()
	var es_fondo := func(c: Color) -> bool: return c.r > 0.8 and c.b > 0.8 and c.g < 0.55 and absf(c.r - c.b) < 0.12
	var fuera := PackedByteArray(); fuera.resize(iw * ih)
	var pila: Array[int] = []
	for x in iw:
		pila.append(x); pila.append(x + (ih - 1) * iw)
	for y in ih:
		pila.append(y * iw); pila.append(iw - 1 + y * iw)
	while not pila.is_empty():
		var i: int = pila.pop_back()
		if fuera[i] != 0:
			continue
		var px := i % iw; var py := i / iw
		if not es_fondo.call(img.get_pixel(px, py)):
			continue
		fuera[i] = 1
		if px > 0: pila.append(i - 1)
		if px < iw - 1: pila.append(i + 1)
		if py > 0: pila.append(i - iw)
		if py < ih - 1: pila.append(i + iw)
	var x0 := iw; var y0 := ih; var x1 := 0; var y1 := 0
	for y in ih:
		for x in iw:
			if fuera[x + y * iw] != 0:
				img.set_pixel(x, y, Color(0, 0, 0, 0))
				continue
			if es_fondo.call(img.get_pixel(x, y)):
				img.set_pixel(x, y, Color(0.16, 0.17, 0.19))
			x0 = mini(x0, x); y0 = mini(y0, y); x1 = maxi(x1, x); y1 = maxi(y1, y)
	var vs := Vector2(img.get_width(), img.get_height())
	var px_m := vs.y / tam.z
	img = img.get_region(Rect2i(x0, y0, x1 - x0 + 1, y1 - y0 + 1))
	# en el json, donde cae cada metro del mundo en la imagen (para marcar las salidas en la carga)
	var ox: float = vs.x * 0.5 - tam.x * 0.5 * px_m
	var meta := {"px_m": px_m, "x0": (x0 - ox) / px_m, "z0": y0 / px_m, "ancho_m": (x1 - x0 + 1) / px_m, "alto_m": (y1 - y0 + 1) / px_m}
	var fj := FileAccess.open("res://ui/planos/%s.json" % current_map, FileAccess.WRITE)
	if fj:
		fj.store_string(JSON.stringify(meta))
		fj.close()
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://ui/planos"))
	img.save_png("res://ui/planos/%s.png" % current_map)
	print("[plano] res://ui/planos/%s.png (%.0f x %.0f m, %dx%d)" % [current_map, tam.x, tam.z, img.get_width(), img.get_height()])
	get_tree().quit()



## --camarafintest=<carpeta>: unas explosiones, el final de partida y fotos de la camara de cine cada pocos segundos
## --botfotos=<carpeta> (2026-10-28): SEGUIR A UN BOT con una camara al lado mientras corre y dispara (como espectando),
## para revisar sus animaciones en partida: <carpeta>/bot_<nn>.png. Elige al que corre mas rapido y cambia si muere.
func _bot_fotos(carpeta: String) -> void:
	DirAccess.make_dir_recursive_absolute(carpeta)
	await get_tree().create_timer(12.0).timeout
	var cam := Camera3D.new()
	cam.fov = 42.0
	add_child(cam)
	cam.current = true
	var bot: Node3D = null
	var n := 0
	var cuadro := 0
	while n < 90:
		await get_tree().process_frame
		if bot == null or not is_instance_valid(bot) or float(bot.get("health")) <= 0.0:
			bot = null
			var mejor := -1.0
			for b in get_tree().get_nodes_in_group("enemies"):
				if b is CharacterBody3D and float(b.get("health")) > 0.0:
					var v: float = Vector2((b as CharacterBody3D).velocity.x, (b as CharacterBody3D).velocity.z).length()
					if v > mejor:
						mejor = v
						bot = b
			if bot == null:
				continue
		var bas: Basis = bot.global_basis
		var foco: Vector3 = bot.global_position + Vector3(0, 0.95, 0)
		cam.global_position = foco + bas.x * 3.0 + bas.z * 1.2 + Vector3(0, 0.35, 0)
		cam.look_at(foco, Vector3.UP)
		cuadro += 1
		if cuadro % 3 == 0:
			await RenderingServer.frame_post_draw
			get_viewport().get_texture().get_image().save_png("%s/bot_%02d.png" % [carpeta, n])
			var cb := bot as CharacterBody3D
			print("[botfotos] %02d v %.1f dispara %s" % [n, Vector2(cb.velocity.x, cb.velocity.z).length(),
				str(bot.get("avatar") != null and float(bot.avatar.get("_since_fire")) < 0.3)])
			n += 1
	get_tree().quit()


func _camara_fin_test(carpeta: String) -> void:
	while loading:
		await get_tree().process_frame
	await get_tree().create_timer(4.0).timeout
	DirAccess.make_dir_recursive_absolute(carpeta)
	var base: Vector3 = player.global_position
	for k in 8:
		var a := TAU * k / 8.0
		var p := base + Vector3(cos(a), 0, sin(a)) * (8.0 + 4.0 * (k % 3)) + Vector3(0, 1.0, 0)
		Net.net_explode(world, p, 3.0, 255)
		await get_tree().create_timer(0.3).timeout
	await get_tree().create_timer(3.0).timeout
	secuencia_fin({"gane": true, "mios": 50, "rivales": 31, "filas": []})
	if carpeta == "":
		return   # --camarafinver: solo mirarla, sin fotos ni salir
	var t0 := Time.get_ticks_msec()
	for seg in [1.5, 4.0, 8.0, 12.0, 18.0, 26.0, 34.0]:
		while Time.get_ticks_msec() - t0 < seg * 1000.0:
			await get_tree().process_frame
		await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("%s/fin_%02d.png" % [carpeta, int(seg)])
	print("[camarafin] fotos en ", carpeta)
	get_tree().quit()
