		var mia: Vector3 = c_base if es_ct else t_base
		var otra: Vector3 = t_base if es_ct else c_base
		var d: float = q.distance_to(mia)
		lejos = maxf(lejos, d)
		if d > q.distance_to(otra):
			mal_base += 1
		rol_n[String(e.rol)] = int(rol_n.get(String(e.rol), 0)) + 1
		if es_ct and "site_pos" in e:
			var k := "%.0f,%.0f" % [e.site_pos.x, e.site_pos.z]
			por_sitio[k] = int(por_sitio.get(k, 0)) + 1
	print("[base] %d bots · dentro de geometria: %d · en la base equivocada: %d · el mas lejos de su base: %.1f m" % [
		enemies.get_child_count(), dentro, mal_base, lejos])
	print("[base] policias por sitio: %s" % str(por_sitio))
	print("[base] cometidos: %s" % str(rol_n))
	get_tree().quit()


## DONDE ACABAN LOS POLICIAS. El jugador mato a ocho y no encontro a los dos ultimos: hay que ver si
## los diez salen, adonde van, y si alguno se queda clavado (sin moverse) o encaramado en un tejado.
func _polis_test() -> void:
	await get_tree().create_timer(4.0).timeout
	if team_overlay != null:
		Net.choose_team(Net.TEAM_T)
		_close_team_select()
	for _i in 40:
		if enemies.get_child_count() > 0:
			break
		await get_tree().create_timer(0.5).timeout
	var p0: Dictionary = {}
	var cts: Array = []
	for e in enemies.get_children():
		if String(e.team) == Net.TEAM_CT:
			cts.append(e)
			p0[e] = e.global_position
	print("[polis] policias al empezar: %d" % cts.size())
	# Sin terroristas: si no llegan a su sitio, es cosa del camino, no de que les hayan disparado.
	for e in enemies.get_children():
		if String(e.team) != Net.TEAM_CT:
			e.queue_free()
	await get_tree().create_timer(45.0).timeout
	var quietos: int = 0
	for e in cts:
		if not is_instance_valid(e):
			continue
		var q: Vector3 = e.global_position
		var rec: float = q.distance_to(p0[e])
		if rec < 1.0:
			quietos += 1
		print("[polis] rol=%-8s  anduvo %5.1f m  ahora (%.0f, %.1f, %.0f)  su sitio (%.0f, %.0f) a %5.1f m  estado %d" % [
			str(e.rol), rec, q.x, q.y, q.z, e.site_pos.x, e.site_pos.z, q.distance_to(e.site_pos), int(e.state)])
	print("[polis] vivos %d de %d · clavados (menos de 1 m en 45 s) %d" % [
		cts.filter(func(x): return is_instance_valid(x)).size(), cts.size(), quietos])
	get_tree().quit()


