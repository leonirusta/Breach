	cielo_noche_cerrada()
	apply_graphics()          # sin sombras de noche (ver apply_graphics)
	# MAS LUZ QUE LA DE LA CAMPAÑA (2026-10-14, bug: "la cafeteria de noche no se ve nada, muy oscuro"): la noche cerrada es
	# la de los zombis, hecha para dar miedo. En una partida normal hay que ver al rival: el ambiente y la luna, casi el
	# doble. --nocheoscura = como antes.
	if not ("--nocheoscura" in args):
		if env and env.environment:
			env.environment.ambient_light_energy = NOCHE_PARTIDA_AMBIENTE
		if sun:
			sun.light_energy = NOCHE_PARTIDA_LUNA
	print("[noche] esta partida es de noche")
	_vista_bots(VISTA_BOTS_NOCHE)
	if Settings.is_touch() or "--lucesfijas" in args:
		_poner_luz_fija()
	if raining:
		_lluvia_noche_ligera()



## NOCHE Y LLUVIA A LA VEZ, MAS LIGERA (2026-10-12, pedido: "de noche y lloviendo anda lento: que la lluvia no llegue tan
## lejos, menos mojado y que la luz no rebote en el agua"): medido en la cafeteria (bancofps, quieto), la lluvia de noche
## suma ~1 ms de GPU mas que de dia: lo mojado va farol a farol (el reflejo de cada farola en los charcos). Aqui: sin ese
## reflejo exacto (las farolas siguen alumbrando el suelo por el volumen cocinado), el suelo mojado a la mitad y la lluvia
## en una caja mas chica y con menos gotas. --lluvianochecompleta = como de dia.
var _mojado_tope := 1.0

const NOCHE_PARTIDA_AMBIENTE := 1.0    ## era 0,55 (la noche cerrada de la campaña)
const NOCHE_PARTIDA_LUNA := 0.9        ## era 0,55

func _lluvia_noche_ligera() -> void:
	if "--lluvianochecompleta" in OS.get_cmdline_user_args():
		return
	_mojado_tope = minf(_mojado_tope, 0.55)
	if world and world.opaque_material is ShaderMaterial:
