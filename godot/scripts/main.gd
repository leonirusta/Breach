func _tiro_lan_test() -> void:
	var quien := "ANFITRION" if Net.hosting else "INVITADO"
	Net._diag_tiro = true
	# esperar a que los dos esten dentro y con avatar
	for _i in 600:
		await get_tree().process_frame
		if not Net.remotes.is_empty():
			break
	await get_tree().create_timer(2.0).timeout
	if Net.remotes.is_empty():
		print("[tirolan] %s: no veo a nadie mas, no se puede probar" % quien)
		get_tree().quit()
		return
	var otro_id: int = int(Net.remotes.keys()[0])
	var otro = Net.remotes[otro_id]
	print("[tirolan] %s: veo a %d · reloj %.2f · ping %.0f ms" % [quien, otro_id, Net.tiempo_servidor(), Net._rtt * 1000.0])
	if Net.hosting:
		# el anfitrion se queda quieto de blanco y va contando su vida
		print("[tirolan] ANFITRION: equipos -> yo '%s', el otro '%s'" % [Net.team_of(multiplayer.get_unique_id()), Net.team_of(otro_id)])
		print("[tirolan] ANFITRION: de blanco en %s con %.0f de vida · historial de %d jugadores" % [
			str(player.global_position.round()), player.health, Net._hist.size()])
		var vida0: float = player.health
		for _f in 900:
			await get_tree().process_frame
		print("[tirolan] ANFITRION: vida %.0f -> %.0f (%s)" % [vida0, player.health,
			"RECIBE EL TIRO: el servidor resolvio" if player.health < vida0 else "NO le ha llegado nada"])
		print("[tirolan] ANFITRION: historial %d jugadores, %d muestras del rival" % [
			Net._hist.size(), (Net._hist[otro_id] as Array).size() if Net._hist.has(otro_id) else 0])
	else:
		# el invitado se pone delante, apunta y dispara
		for _f in 120:
			await get_tree().process_frame
		var blanco: Vector3 = otro.global_position + Vector3(0, 1.0, 0)
		player.global_position = blanco + Vector3(0, 0, 6.0) - Vector3(0, 1.0, 0)
		player.look_at_point(blanco)
		for _f in 30:
			await get_tree().process_frame
		var dir: Vector3 = (blanco - (player.global_position + Vector3(0, 1.45, 0))).normalized()
		print("[tirolan] INVITADO: a %.1f m del rival, disparando 10 veces" % player.global_position.distance_to(otro.global_position))
		for _f in 10:
			# SE VUELVE A COLOCAR EN CADA TIRO. El jugador sigue simulando entre disparo y disparo (cae,
			# resbala) y al hundirse un poco el origen del rayo se metia DENTRO del suelo: el servidor
			# veia "pared a 0 m" y descartaba el tiro. Eso era la prueba, no el juego.
			var blanco2: Vector3 = otro.global_position + Vector3(0, 1.0, 0)
			player.global_position = Vector3(blanco2.x, otro.global_position.y, blanco2.z) + Vector3(0, 0, 6.0)
			player.velocity = Vector3.ZERO
			var ojo: Vector3 = player.global_position + Vector3(0, 1.45, 0)
			var dir2: Vector3 = (blanco2 - ojo).normalized()
			Net.pedir_disparo(ojo, dir2, 60.0, 24.0, 5.0)
			for _g in 20:
				await get_tree().process_frame
		print("[tirolan] INVITADO: 10 disparos mandados al servidor")
		for _f in 300:
			await get_tree().process_frame
	get_tree().quit()


## --cartaslan (en las DOS copias, como --tirolan; 2026-09-30, pedido: "¿las cartas funcionan en el online? ¿van a ver
## mis saltos altos, el daño...?"): el INVITADO se equipa todas las cartas a nivel 10 (en memoria) y dispara al
## anfitrion, rompe pared, tira un cohete, salta y camina; el ANFITRION mide lo que LE LLEGA: el daño de cada tiro, la
## salud maxima del otro, la potencia de sus balas contra la pared, el radio de su cohete, y la altura del salto y la
## velocidad de la copia del otro en su pantalla. Compara con lo de fabrica.
func _cartas_lan_test() -> void:
	var quien := "ANFITRION" if Net.hosting else "INVITADO"
	for _i in 600:
		await get_tree().process_frame
		if not Net.remotes.is_empty():
			break
	await get_tree().create_timer(2.0).timeout
	if Net.remotes.is_empty():
		print("[cartaslan] %s: no veo a nadie, no se puede probar" % quien)
		get_tree().quit()
		return
	var otro_id: int = int(Net.remotes.keys()[0])
	var otro = Net.remotes[otro_id]
	if not Net.hosting:
		# TODAS LAS CARTAS A NIVEL 10, en memoria (no se guarda)
		var todas := {}
		for id in Cartas.ids():
			todas[id] = {"n": 10, "c": 0}
		Settings.cartas = todas
		Settings.cartas_equipadas = Cartas.ids().slice(0, Cartas.RANURAS)
		player._leer_cartas()
		player.health = player.vida_max()
		Net.net_vida(player.health, player.vida_max())
		print("[cartaslan] INVITADO: cartas nv10 -> daño +%.1f%% · vida max %.1f · salto +%.1f%% · velocidad +%.1f%% · destruccion +%.0f%% · explosion +%.0f%%" % [
			player._carta_dano * 100.0, player.vida_max(), player._carta_salto * 100.0, player._carta_velocidad * 100.0,
			player._carta_destruccion * 100.0, player._carta_explosion * 100.0])
		# 1) tres tiros al anfitrion con el daño de verdad del arma (player._dmg)
		var w: Dictionary = Weapons.LIST[player.current]
		for k in 3:
			var blanco: Vector3 = otro.global_position + Vector3(0, 1.0, 0)
			player.global_position = Vector3(blanco.x, otro.global_position.y, blanco.z) + Vector3(0, 0, 2.5)
			player.velocity = Vector3.ZERO
			var ojo: Vector3 = player.global_position + Vector3(0, 1.45, 0)
			Net.pedir_disparo(ojo, (blanco - ojo).normalized(), 60.0, player._dmg(w), 3.0)
			print("[cartaslan] INVITADO: tiro %d con daño %.2f (el arma da %.2f)" % [k + 1, player._dmg(w), float(w.damage)])
			for _g in 40:
				await get_tree().process_frame
		# 2) una bala contra el suelo con la potencia de la carta (como en player.fire)
		var pot: int = mini(999, int(round(float(w.power) * (1.0 + player._carta_destruccion))))
		Net.net_shoot(world, player.global_position + Vector3(0, 1.5, 0), Vector3(0.3, -1, 0.2).normalized(), 10.0, pot)
		print("[cartaslan] INVITADO: bala a la pared con potencia %d (el arma da %d)" % [pot, int(w.power)])
		await get_tree().create_timer(1.0).timeout
		# 3) un cohete con el radio de la carta
		var cohete: Dictionary = Weapons.get_def("bazooka_rpg")
		Net.net_cohete(player.global_position + Vector3(0, 1.5, 3), Vector3(0, -0.3, 1).normalized(), player._radio_expl(float(cohete.radius)), int(cohete.power), player._dmg(cohete))
		print("[cartaslan] INVITADO: cohete con radio %.2f (el arma da %.2f)" % [player._radio_expl(float(cohete.radius)), float(cohete.radius)])
		await get_tree().create_timer(2.0).timeout
		# 4) EL SALTO (por el camino de verdad: el boton de saltar)
		var y0: float = player.global_position.y
		var ymax := y0
		player.touch_jump = true
		for _g in 90:
			await get_tree().physics_frame
			if _g == 3:
				player.touch_jump = false
			ymax = maxf(ymax, player.global_position.y)
		print("[cartaslan] INVITADO: salto de %.2f m en mi pantalla (sin carta serian %.2f)" % [ymax - y0, 5.6 * 5.6 / (2.0 * 15.0)])
		await get_tree().create_timer(1.5).timeout
		# 5) ANDAR dos segundos
		var p0: Vector3 = player.global_position
		Input.action_press("move_back")
		await get_tree().create_timer(2.0).timeout
		var p1: Vector3 = player.global_position
		Input.action_release("move_back")
		print("[cartaslan] INVITADO: ando a %.2f m/s en mi pantalla" % (Vector2(p1.x - p0.x, p1.z - p0.z).length() / 2.0))
		await get_tree().create_timer(8.0).timeout
	else:
		# EL ANFITRION mira lo que le llega
		Net._diag_tiro = true
		var vida_ant: float = player.health
		var golpes: Array = []
		var base_y: float = otro.global_position.y
		var alto_max := 0.0
		var vel_max := 0.0
		var hist: Array = []
		var t := 0.0
		while t < 28.0:
			await get_tree().physics_frame
			if not is_instance_valid(otro):
				break          # el otro ya ha acabado y se ha ido
			var dt := get_physics_process_delta_time()
			t += dt
			if player.health < vida_ant - 0.01:
				golpes.append(vida_ant - player.health)
				vida_ant = player.health
			var pos: Vector3 = otro.global_position
			# los TELETRANSPORTES de la prueba (el invitado se coloca para disparar) no cuentan: se vacia la historia
			if hist.size() > 0 and (pos - (hist[hist.size() - 1][1] as Vector3)).length() > 1.5:
				hist.clear()
			hist.append([t, pos])
			while hist.size() > 0 and t - float(hist[0][0]) > 1.0:
				hist.pop_front()
			# EL SALTO: la altura sobre el punto mas bajo del ultimo segundo y medio
			var ymin := pos.y
			for e in hist:
				ymin = minf(ymin, (e[1] as Vector3).y)
			if hist.size() > 20:
				alto_max = maxf(alto_max, pos.y - ymin)
			# LA VELOCIDAD: en un segundo entero sin teletransporte y sin saltar
			if hist.size() > 40 and t - float(hist[0][0]) > 0.9 and pos.y - ymin < 0.05:
				var a: Vector3 = hist[0][1]
				vel_max = maxf(vel_max, Vector2(pos.x - a.x, pos.z - a.z).length() / (t - float(hist[0][0])))
		var vm: Array = Net.vidas.get(otro_id, [0.0, 0.0])
		print("[cartaslan] ANFITRION: daño de cada tiro recibido %s" % str(golpes))
		print("[cartaslan] ANFITRION: vida maxima del otro que me llega: %.1f (de fabrica 100)" % float(vm[1]))
		print("[cartaslan] ANFITRION: potencia de bala que me llega %d · radio de cohete %.2f" % [Net.diag_ultima_potencia, Net.diag_ultimo_radio])
		print("[cartaslan] ANFITRION: el otro salta %.2f m en MI pantalla · anda a %.2f m/s (de fabrica %.2f)" % [alto_max, vel_max, player.vel_modo("andar")])
	get_tree().quit()


## --rutatest: ¿por donde va el A* del spawn policia a cada sitio? Y a lo largo de la linea recta, hasta
## donde llega (para encontrar el tramo que el A* cree cerrado).
func _ruta_test() -> void:
	await get_tree().create_timer(8.0).timeout
	var o: Vector3 = _ground_near(ct_spawn)
	for zf in [36.4, 36.8, 37.2]:
		var fila3 := []
		for xi in range(0, 31):
			var xx := 57.2 - xi * 0.1
			var rd: Dictionary = world.raycast(Vector3(xx, 4.5, zf), Vector3(0, -1, 0), 4.0)
			var fy: float = rd.position.y if rd.get("hit", false) else -1.0
			var ru: Dictionary = world.raycast(Vector3(xx, fy + 0.15, zf), Vector3(0, 1, 0), 4.0)
			fila3.append("%.1f:%.1f/%.1f" % [xx, fy, ru.position.y if ru.get("hit", false) else 99.0])
		print("[ruta] z=%.1f %s" % [zf, " ".join(fila3)])
	for sdx in bomb_sites:
		var t0 := Time.get_ticks_usec()
		var pr: PackedVector3Array = world.find_path(o, sdx.pos)
		var us := Time.get_ticks_usec() - t0
		var lr := 0.0
		for j in range(1, pr.size()):
			lr += pr[j].distance_to(pr[j - 1])
		print("[ruta] SPAWN %s -> SITIO %s: %.0f m (recta %.0f) en %.1f ms" % [str(o.snapped(Vector3.ONE)), str(sdx.pos.snapped(Vector3.ONE)), lr, o.distance_to(sdx.pos), us / 1000.0])
	var cam := [Vector3(83.0, 0.8, 34.2), Vector3(80.1, 0.6, 36.7), Vector3(75.2, 0.6, 37.3), Vector3(70.1, 0.6, 36.6), Vector3(67.6, 0.6, 36.4), Vector3(64.8, 1.2, 36.2), Vector3(62.1, 2.0, 35.9), Vector3(59.2, 2.6, 35.9), Vector3(56.8, 2.6, 36.6), Vector3(54.5, 2.6, 37.1), Vector3(52.6, 2.6, 35.4), Vector3(51.3, 3.7, 33.2), Vector3(50.7, 3.6, 30.8), Vector3(51.8, 2.8, 28.8)]
	for k in range(1, cam.size()):
		var pp: PackedVector3Array = world.find_path(cam[k - 1], cam[k])
		var ll := 0.0
		for j in range(1, pp.size()):
			ll += pp[j].distance_to(pp[j - 1])
		print("[ruta] %s -> %s: %d puntos %.0f m (recta %.1f)" % [str(cam[k - 1]), str(cam[k]), pp.size(), ll, cam[k - 1].distance_to(cam[k])])
	get_tree().quit(0)
	return
	for zf in [31.0, 32.0, 33.0]:
		var fila2 := []
		for xi in range(0, 21):
			var xx := 58.0 - xi * 0.1
			# desde la altura del pecho hacia abajo, y hacia arriba: suelo y techo en esa columna
			var rd: Dictionary = world.raycast(Vector3(xx, 5.0, zf), Vector3(0, -1, 0), 5.0)
			var ru: Dictionary = world.raycast(Vector3(xx, 3.6, zf), Vector3(0, 1, 0), 4.0)
			fila2.append("%.1f:%.1f-%.1f" % [xx, rd.position.y if rd.get("hit", false) else -1.0, ru.position.y if ru.get("hit", false) else 99.0])
		print("[ruta] z=%.0f %s" % [zf, " ".join(fila2)])
	for par in [[Vector3(60, 3.3, 33), Vector3(54, 2.7, 33)], [Vector3(60, 3.3, 32), Vector3(58, 3.1, 32)], [Vector3(58, 3.1, 32), Vector3(56.5, 2.7, 32)], [Vector3(56.5, 2.7, 32), Vector3(54, 2.7, 32)], [Vector3(54, 2.7, 32), Vector3(53, 2.7, 29.3)], [Vector3(54, 2.7, 33), Vector3(60, 3.3, 33)]]:
		var pp: PackedVector3Array = world.find_path(par[0], par[1])
		var ll := 0.0
		for k in range(1, pp.size()):
			ll += pp[k].distance_to(pp[k - 1])
		print("[ruta] %s -> %s: %d puntos %.0f m" % [str(par[0]), str(par[1]), pp.size(), ll])
	for sd in bomb_sites:
		var dst: Vector3 = sd.pos
		var pth: PackedVector3Array = world.find_path(o, dst)
		var largo := 0.0
		for k in range(1, pth.size()):
			largo += pth[k].distance_to(pth[k - 1])
		var pts := []
		for k in range(0, pth.size(), maxi(1, pth.size() / 12)):
			pts.append(str(pth[k].snapped(Vector3(1, 1, 1))))
		print("[ruta] %s -> %s: %d puntos, %.0f m (recta %.0f m): %s" % [str(o.snapped(Vector3.ONE)), str(dst.snapped(Vector3.ONE)), pth.size(), largo, o.distance_to(dst), " ".join(pts)])
		for f in range(1, 11):
			var q: Vector3 = _ground_near(o.lerp(dst, f / 10.0))
			var pq: PackedVector3Array = world.find_path(o, q)
			var lq := 0.0
			for k in range(1, pq.size()):
				lq += pq[k].distance_to(pq[k - 1])
			print("[ruta]    tramo %d/10 punto %s: %d puntos %.0f m (recta %.0f)" % [f, str(q.snapped(Vector3(0.1, 0.1, 0.1))), pq.size(), lq, o.distance_to(q)])
	get_tree().quit(0)


## --grabacamino: apunta por donde anda el jugador (cada 0,5 s), para copiar sus caminos a los bots.
