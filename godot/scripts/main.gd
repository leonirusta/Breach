## LAS PIERNAS EN TERCERA PERSONA, FASE A FASE (--piernasfoto). Un soldado en una cinta -no avanza,
## pero las piernas hacen lo mismo que corriendo de verdad- a la velocidad de cada modo de la tabla
## CAL, colgado en el cielo sobre un suelo y un fondo lisos para que nada tape las piernas. Por modo
## saca una hoja con ocho fases del ciclo, de perfil y desde detras (donde va la camara de tercera
## persona), con la zancada elastica y sin ella. Apunta los angulos de cadera, rodilla y pie y cuanto
## patina el pie apoyado, y graba fotograma a fotograma el cambio de caminar a esprintar y vuelta.
## --piernasdir=<carpeta> deja las fotos en otro sitio (por defecto user://piernas).
func _piernas_foto() -> void:
	await get_tree().create_timer(4.0).timeout
	if team_overlay != null:
		Net.choose_team(Net.TEAM_T)
		_close_team_select()
	await get_tree().create_timer(1.0).timeout
	var dir_out := "user://piernas"
	for f in OS.get_cmdline_user_args():
		if f.begins_with("--piernasdir="):
			dir_out = f.substr(13)
	DirAccess.make_dir_recursive_absolute(dir_out)
	hud.visible = false
	player.process_mode = Node.PROCESS_MODE_DISABLED
	player.visible = false
	_vista_fuerza = 0.0
	if env and env.environment:
		env.environment.adjustment_brightness = 1.0
	var base := Vector3(player.global_position.x, 160.0, player.global_position.z)
	var suelo := MeshInstance3D.new()
	var bm := BoxMesh.new()
	bm.size = Vector3(10.0, 0.04, 10.0)
	suelo.mesh = bm
	var mat_suelo := StandardMaterial3D.new()
	mat_suelo.albedo_color = Color(0.30, 0.31, 0.33)
	suelo.material_override = mat_suelo
	add_child(suelo)
	suelo.global_position = base - Vector3(0, 0.02, 0)
	var fondo := MeshInstance3D.new()
	var qm := QuadMesh.new()
	qm.size = Vector2(16.0, 10.0)
	fondo.mesh = qm
	var mat_fondo := StandardMaterial3D.new()
	mat_fondo.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat_fondo.albedo_color = Color(0.62, 0.68, 0.74)
	mat_fondo.cull_mode = BaseMaterial3D.CULL_DISABLED
	fondo.material_override = mat_fondo
	add_child(fondo)
	var sol := DirectionalLight3D.new()
	sol.light_energy = 1.2
	add_child(sol)
	sol.global_rotation = Vector3(deg_to_rad(-45.0), deg_to_rad(40.0), 0.0)
	var cam := Camera3D.new()
	add_child(cam)
	cam.fov = 34.0
	cam.far = 500.0
	cam.make_current()
	var AvCls = load("res://scripts/avatar_animator.gd")
	var av = AvCls.new()
	add_child(av)
	av.build(1.75, false, Color.WHITE, true)
	av.equip_rifle()
	av._first_person = true          # sin LOD: lo anima este test a mano
	av.set_process(false)
	av.global_position = base
	var dt := 1.0 / 60.0
	print("[piernas] ZANCADA_MAX %.2f · CAL %s" % [AvCls.ZANCADA_MAX, str(AvCls.CAL)])
	# medidas de las dos piernas en el marco del cuerpo (-Z adelante), en metros y grados
	var medir := func(a) -> Dictionary:
		var sk: Skeleton3D = a.skeleton
		var s: float = a.scale.x
		var pel: Vector3 = (sk.get_bone_global_pose(a.bone_idx["pelvis"]).origin + sk.position) * s
		var out := {}
		for lado in ["l", "r"]:
			var cad: Vector3 = (sk.get_bone_global_pose(a.bone_idx["leg_upper_" + lado]).origin + sk.position) * s
			var rod: Vector3 = (sk.get_bone_global_pose(a.bone_idx["leg_lower_" + lado]).origin + sk.position) * s
			var tob: Vector3 = (sk.get_bone_global_pose(a.bone_idx["foot_" + lado]).origin + sk.position) * s
			var pun: Vector3 = (sk.get_bone_global_pose(a.bone_idx["toes_" + lado]).origin + sk.position) * s
			var muslo: Vector3 = rod - cad
			var linea: Vector3 = tob - cad
			var u: float = clampf(muslo.dot(linea) / maxf(linea.length_squared(), 1e-8), 0.0, 1.0)
			var fuera: Vector3 = rod - (cad + linea * u)
			var afuera: float = signf(cad.x - pel.x)
			out[lado] = {
				"muslo": rad_to_deg(atan2(-muslo.z, -muslo.y)),            # + = muslo adelantado
				"flex": rad_to_deg(muslo.angle_to(tob - rod)),             # 0 = pierna recta
				"rod_del": -fuera.z * 100.0,                                # cm; - = rodilla hiperextendida
				"rod_lat": fuera.x * afuera * 100.0,                        # cm; + = rodilla hacia fuera
				"pie_yaw": rad_to_deg(atan2((pun.x - tob.x) * afuera, -(pun.z - tob.z))),   # + = punta afuera
				"ancho": (tob.x - pel.x) * afuera * 100.0,                  # cm del tobillo al centro
				"tob": tob,
			}
		return out
	var prueba := get_viewport().get_texture().get_image()
	var th: int = int(prueba.get_height() * 0.92)
	var tw: int = int(th * 0.62)
	var foto := func(vista: int) -> void:
		if vista == 0:          # de perfil
			cam.global_position = base + Vector3(3.8, 0.9, 0.0)
			fondo.global_position = base + Vector3(-3.0, 0.9, 0.0)
			fondo.global_rotation = Vector3(0.0, PI * 0.5, 0.0)
		else:                   # desde detras y por encima, donde va la camara de tercera persona
			cam.global_position = base + Vector3(0.5, 1.85, 3.0)
			fondo.global_position = base + Vector3(0.0, 0.9, -4.0)
			fondo.global_rotation = Vector3.ZERO
		cam.look_at(base + Vector3(0.0, 0.85, 0.0), Vector3.UP)
	var recorte := func(img: Image) -> Image:
		img.convert(Image.FORMAT_RGB8)
		var c: Vector2 = cam.unproject_position(base + Vector3(0.0, 0.85, 0.0))
		var x0: int = clampi(int(c.x - tw * 0.5), 0, img.get_width() - tw)
		var y0: int = clampi(int(c.y - th * 0.5), 0, img.get_height() - th)
		return img.get_region(Rect2i(x0, y0, tw, th))
	var hoja_de := func(filas: Array, nombre: String) -> void:
		var cols := 0
		for fl in filas:
			cols = maxi(cols, (fl as Array).size())
		var hoja := Image.create(tw * cols, th * filas.size(), false, Image.FORMAT_RGB8)
		for fi in filas.size():
			for k in (filas[fi] as Array).size():
				var t: Image = filas[fi][k]
				hoja.blit_rect(t, Rect2i(0, 0, tw, th), Vector2i(k * tw, fi * th))
		hoja.resize(int(hoja.get_width() * 0.5), int(hoja.get_height() * 0.5), Image.INTERPOLATE_BILINEAR)
		hoja.save_png("%s/%s.png" % [dir_out, nombre])
		print("[piernas] hoja %s/%s.png" % [dir_out, nombre])
	for mm in [["andar", false], ["esprintar", false], ["agachado", true]]:
		for e in enemies.get_children():
			e.queue_free()
		var modo: String = mm[0]
		var crouch: bool = mm[1]
		var v: float = float(AvCls.CAL[modo]["vel"])
		var lv := Vector3(0.0, 0.0, -v)
		var tiras := {}
		for warp in [true, false]:
			for i in 90:
				av.drive_locomotion(lv, crouch, true, 0, dt)
				if not warp:
					av.zancada = 1.0
				av._process(dt)
			var dur: float = av.clip_dur(av.current_clip)
			var paso: float = dur / maxf(av.anim_speed, 0.01) / 96.0
			var muestras: Array = []
			for i in 96:
				av.drive_locomotion(lv, crouch, true, 0, paso)
				if not warp:
					av.zancada = 1.0
				av._process(paso)
				muestras.append(medir.call(av))
			var r := {"muslo": [999.0, -999.0], "flex": [999.0, -999.0], "rod_del": [999.0, -999.0],
				"rod_lat": [999.0, -999.0], "pie_yaw": [999.0, -999.0], "ancho": [999.0, -999.0]}
			var y_min := 999.0
			for mu in muestras:
				for lado in ["l", "r"]:
					for key in r.keys():
						r[key][0] = minf(r[key][0], float(mu[lado][key]))
						r[key][1] = maxf(r[key][1], float(mu[lado][key]))
					y_min = minf(y_min, (mu[lado]["tob"] as Vector3).y)
			# el tobillo apoyado (a menos de 2 cm del suelo) tiene que irse hacia atras a la velocidad del cuerpo
			var rel: Array = []
			for i in range(1, muestras.size()):
				for lado in ["l", "r"]:
					var a0: Vector3 = muestras[i - 1][lado]["tob"]
					var a1: Vector3 = muestras[i][lado]["tob"]
					if a0.y > y_min + 0.02 or a1.y > y_min + 0.02:
						continue
					rel.append((a1.z - a0.z) / paso / v * 100.0)
			rel.sort()
			var med: float = float(rel[int(rel.size() * 0.5)]) if not rel.is_empty() else 0.0
			print("[piernas] %-9s %.2f m/s %-18s %s zancada %.2f anim %.2f | muslo %+.0f..%+.0f  rodilla %.0f..%.0f  rodilla delante %+.1f..%+.1f cm  rodilla afuera %+.1f..%+.1f cm  pie afuera %+.0f..%+.0f  tobillo-centro %+.1f..%+.1f cm | pie apoyado barre %.0f %% de v (%d)" % [
				modo, v, av.current_clip, "CON" if warp else "SIN", av.zancada, av.anim_speed,
				r["muslo"][0], r["muslo"][1], r["flex"][0], r["flex"][1], r["rod_del"][0], r["rod_del"][1],
				r["rod_lat"][0], r["rod_lat"][1], r["pie_yaw"][0], r["pie_yaw"][1], r["ancho"][0], r["ancho"][1],
				med, rel.size()])
			for k in 8:
				av.drive_locomotion(lv, crouch, true, 0, dt)
				if not warp:
					av.zancada = 1.0
				av._time = dur * float(k) / 8.0
				av._process(0.0)
				var mk: Dictionary = medir.call(av)
				print("[piernas]   fase %d/8  muslo I %+4.0f D %+4.0f  rodilla I %3.0f D %3.0f  rodilla afuera I %+5.1f D %+5.1f  pie afuera I %+4.0f D %+4.0f" % [
					k, mk["l"]["muslo"], mk["r"]["muslo"], mk["l"]["flex"], mk["r"]["flex"],
					mk["l"]["rod_lat"], mk["r"]["rod_lat"], mk["l"]["pie_yaw"], mk["r"]["pie_yaw"]])
				for vista in [0, 1]:
					foto.call(vista)
					await RenderingServer.frame_post_draw
					await RenderingServer.frame_post_draw
					var clave := "%s_%d" % ["con" if warp else "sin", vista]
					if not tiras.has(clave):
						tiras[clave] = []
					tiras[clave].append(recorte.call(get_viewport().get_texture().get_image()))
		hoja_de.call([tiras["con_0"], tiras["sin_0"], tiras["con_1"], tiras["sin_1"]], modo)
	# DE CAMINAR A ESPRINTAR Y VUELTA, con la misma aceleracion que el jugador (player.gd, ACCEL)
	var va: float = float(AvCls.CAL["andar"]["vel"])
	var ve: float = float(AvCls.CAL["esprintar"]["vel"])
	for i in 120:
		av.drive_locomotion(Vector3(0.0, 0.0, -va), false, true, 0, dt)
		av._process(dt)
	var vv := va
	var tira_a: Array = []
	var tira_b: Array = []
	for i in 90:
		vv = lerpf(vv, ve if i < 45 else va, 14.0 * dt)
		av.drive_locomotion(Vector3(0.0, 0.0, -vv), false, true, 0, dt)
		av._process(dt)
		var mc: Dictionary = medir.call(av)
		print("[piernas-cambio] %2d v %.2f %-8s desde %-8s mezcla %.2f t %.3f zancada %.2f anim %.2f | muslo I %+4.0f D %+4.0f rodilla I %3.0f D %3.0f" % [
			i, vv, av.current_clip, av._blend_from, clampf(av._blend_time / maxf(av._blend_duration, 0.001), 0.0, 1.0),
			av._time, av.zancada, av.anim_speed, mc["l"]["muslo"], mc["r"]["muslo"], mc["l"]["flex"], mc["r"]["flex"]])
		if (i < 16 or (i >= 45 and i < 61)) and i % 2 == 0:
			foto.call(0)
			await RenderingServer.frame_post_draw
			await RenderingServer.frame_post_draw
			(tira_a if i < 45 else tira_b).append(recorte.call(get_viewport().get_texture().get_image()))
	hoja_de.call([tira_a, tira_b], "cambio")
	get_tree().quit()


## CAMINAR DEL JUEGO CONTRA EL DE BLENDER (--caminarmide). Mide fase a fase del ciclo lo mismo que se
## saca del .blend: arma (origen, culata, boca y giro), munecas, codos, giros de pelvis, estomago, pecho,
## cuello y cabeza, y vaiven de la pelvis; en ejes del esqueleto, metros y respecto a la pelvis. Con la
## mirada al frente y sin disparar, que es donde el juego tiene que dar lo mismo que Blender. Un JSON
## por clip y velocidad en --caminardir=<carpeta> (por defecto user://caminar).
func _caminar_mide() -> void:
	await get_tree().create_timer(3.0).timeout
	var dir_out := "user://caminar"
	for f in OS.get_cmdline_user_args():
		if f.begins_with("--caminardir="):
			dir_out = f.substr(13)
	DirAccess.make_dir_recursive_absolute(dir_out)
	var AvCls = load("res://scripts/avatar_animator.gd")
	var av = AvCls.new()
	add_child(av)
	av.build(1.75, false, Color.WHITE, false)
	av.equip_rifle()
	av._first_person = true          # sin LOD: lo anima este test a mano
	av.set_process(false)
	await get_tree().process_frame
	var sk: Skeleton3D = av.skeleton
	var s: float = av.scale.x
	var v3 := func(p: Vector3) -> Array:
		return [p.x, p.y, p.z]
	var q4 := func(q: Quaternion) -> Array:
		return [q.x, q.y, q.z, q.w]
	print("[caminar] arma %s malla '%s' agarre %s guardamanos %s" % [
		av.weapon_kind, av._arma_id, str(av._wm.grip_pos), str(av._wm.foregrip_pos)])
	for caso in [["caminar", false, 1.44], ["caminar", false, 3.10],
			["crouch_fwd_tactico", true, 0.96], ["crouch_fwd_tactico", true, 1.55]]:
		var clip: String = caso[0]
		var crouch: bool = caso[1]
		var vel: float = caso[2]
		var lv := Vector3(0.0, 0.0, -vel)
		for i in 90:
			av.drive_locomotion(lv, crouch, true, 0, 1.0 / 60.0)
			av._process(1.0 / 60.0)
		if av.current_clip != clip:
			print("[caminar] OJO: suena %s y no %s" % [av.current_clip, clip])
		var fps: float = float(AvCls._shared_clips[clip]["fps"])
		var dur: float = av.clip_dur(clip)
		var n: int = int(round(dur * fps))
		# cada paso avanza justo un frame del clip, asi la fase k es el frame k+1 de Blender
		var paso: float = (1.0 / fps) / maxf(av.anim_speed, 0.01)
		av._time = dur - 1.0 / fps
		var frames: Array = []
		for i in 3 * n:
			av.drive_locomotion(lv, crouch, true, 0, paso)
			av._process(paso)
			if i < 2 * n:
				continue                  # dos ciclos para que lo amortiguado se asiente
			var pel_i: int = av.bone_idx["pelvis"]
			var pel: Vector3 = sk.get_bone_global_pose(pel_i).origin
			var fr := {"t": av._time}
			fr["pelvis_off"] = v3.call((sk.get_bone_pose_position(pel_i) - sk.get_bone_rest(pel_i).origin) * s)
			for b in ["pelvis", "stomach", "chest", "neck", "head", "hand_r", "hand_l"]:
				var bi: int = av.bone_idx[b]
				fr["rot_" + b] = q4.call(sk.get_bone_global_pose(bi).basis.get_rotation_quaternion()
					* sk.get_bone_global_rest(bi).basis.get_rotation_quaternion().inverse())
			for b in ["neck", "head", "hand_r", "hand_l", "arm_lower_r", "arm_lower_l"]:
				fr["pos_" + b] = v3.call((sk.get_bone_global_pose(av.bone_idx[b]).origin - pel) * s)
			var wt: Transform3D = av.weapon_root.transform
			fr["arma_origen"] = v3.call((wt.origin - pel) * s)
			fr["culata"] = v3.call((wt * (Vector3(0.0, -0.02, 0.376) / s) - pel) * s)
			fr["boca"] = v3.call((wt * (Vector3(0.0, 0.012, -0.71) / s) - pel) * s)
			fr["arma_rot"] = q4.call(wt.basis.get_rotation_quaternion())
			fr["sway_deg"] = rad_to_deg(av._sway_ang)
			fr["lower_w"] = av._lower_w
			fr["hombro_bob"] = v3.call(av._bone_anim_offset("shoulder_r") * s)
			fr["suelo"] = sk.position.y * s
			frames.append(fr)
		var nombre := "%s/juego_%s_%.2f.json" % [dir_out, clip, vel]
		var fh := FileAccess.open(nombre, FileAccess.WRITE)
		fh.store_string(JSON.stringify({"clip": clip, "vel": vel, "anim": av.anim_speed, "zancada": av.zancada, "frames": frames}))
		fh.close()
		print("[caminar] %s a %.2f m/s -> %s (%d fases, anim %.2f, zancada %.2f)" % [
			clip, vel, nombre, frames.size(), av.anim_speed, av.zancada])
	get_tree().quit()


## CUANTO SALTAN LOS BOTS Y CUANTO TE SIGUEN. El jugador se queda QUIETO a proposito: hay que ver
## que los que le acompañan acaban soltandole y yendose a lo suyo.
func _salto_bots_test() -> void:
	await get_tree().create_timer(4.0).timeout
	if team_overlay != null:
		Net.choose_team(Net.TEAM_T)
		_close_team_select()
	for _i in 40:
		if enemies.get_child_count() > 0:
			break
		await get_tree().create_timer(0.5).timeout
	player.invulnerable = true
	var saltos := 0
	var siguiendo0 := 0
	var en_aire: Dictionary = {}
	for e in enemies.get_children():
		en_aire[e] = true
		if e.sigue != null:
			siguiendo0 += 1
	print("[salto] %d bots · %d te siguen o siguen a alguien al empezar" % [
		enemies.get_child_count(), siguiendo0])
	var t := 0.0
	while t < 60.0:
		await get_tree().physics_frame
		t += get_physics_process_delta_time()
		for e in enemies.get_children():
			var suelo: bool = bool(e.on_floor)
			if bool(en_aire.get(e, true)) and not suelo and e.velocity.y > 1.0:
				saltos += 1
			en_aire[e] = suelo
	var siguiendo1 := 0
	for e in enemies.get_children():
		if e.sigue != null:
			siguiendo1 += 1
	print("[salto] en 60 s: %d saltos entre %d bots = %.2f saltos por bot y minuto" % [
		saltos, enemies.get_child_count(), float(saltos) / maxf(enemies.get_child_count(), 1)])
	print("[salto] siguen a alguien: %d al empezar -> %d al final (el jugador no se movio)" % [
		siguiendo0, siguiendo1])
	get_tree().quit()


## RETRATO DEL MAPA para el lobby. Camara en alto, mirando al centro en diagonal -no cenital, que
## aplana todo y no se reconoce nada-, sin HUD y sin bots. Sale un PNG por mapa a `user://`, que
## luego se copia a assets/mapas/.
func _mapa_foto() -> void:
	await get_tree().create_timer(2.0).timeout
	if team_overlay != null:
		Net.choose_team(Net.TEAM_CT)
		_close_team_select()
	for e in enemies.get_children():
		e.queue_free()
	hud.visible = false
	if is_instance_valid(player):
		player.set_process_input(false)
		# FUERA EL ARMA Y LAS MANOS. Cuelgan de la camara, asi que salian atravesadas en medio del
		# retrato: en la primera tanda se veia un fusil cruzando el mapa entero.
		if player.fp_arms:
			player.fp_arms.visible = false
		if player.weapon_model:
			player.weapon_model.visible = false
	# Y NADA DE EXPOSICION AUTOMATICA. Con la camara en alto media pantalla es cielo, el ajuste de
	# brillo se abre del todo y el mapa sale lavado, blanco. Se fija a 1.0 para el retrato.
	_vista_fuerza = 0.0
	if env and env.environment:
		env.environment.adjustment_brightness = 1.0
	var size: Vector3 = world.get_world_size()
	var centro := Vector3(size.x * 0.5, 0.0, size.z * 0.5)
	var g: Vector3 = world.find_ground(centro)
	if g.y > 0.0:
		centro.y = g.y
	# A LA ALTURA DE UN TEJADO, NO DESDE UN SATELITE. Antes la camara subia a 0,72 veces el ancho del
	# mapa -sesenta y tantos metros en dust2- y desde ahi todo es una maqueta plana que no se
	# reconoce. Bajando el angulo se ven las paredes, los pasillos y el cielo al fondo, que es lo que
	# hace reconocible un sitio.
	var lejos: float = maxf(size.x, size.z) * 0.42
	var cam: Camera3D = player.cam
	cam.global_position = centro + Vector3(-lejos * 0.80, maxf(12.0, lejos * 0.26), lejos * 0.80)
	cam.look_at(centro + Vector3(0, 3.0, 0), Vector3.UP)
	cam.fov = 60.0
	cam.far = maxf(cam.far, lejos * 4.0)
	await get_tree().create_timer(2.5).timeout
	for i in 8:
		await RenderingServer.frame_post_draw
	var img := get_viewport().get_texture().get_image()
	var w := img.get_width()
	var h := img.get_height()
	var ah := int(w * 2.0 / 3.0)
	if ah < h:
		img = img.get_region(Rect2i(0, (h - ah) / 2, w, ah))
	img.resize(384, 256, Image.INTERPOLATE_LANCZOS)
	var nombre := "user://mapa_%s.png" % current_map
	img.save_png(nombre)
	print("[mapafoto] %s -> %s  camara a %.0f m de alto" % [current_map, nombre, cam.global_position.y - centro.y])
	get_tree().quit()


## --mapafotos=ruta.png;x;y;z;mira_x;mira_y;mira_z[;fov][|otra;...] (2026-09-30, mapa CAFETERIA URBANA): una camara
## LIBRE en cada punto mirando al otro, sin HUD, sin arma y sin bots, y la captura. Vale para cualquier mapa (la de la
## campaña, --campanafoto, solo existe en el PvE y mueve al jugador, que se cae si el punto esta en el aire). El jugador
## se planta en el suelo debajo de la camara (las farolas y el detalle del mundo van con el). --fotohud deja el HUD.
## Un 9o campo es la espera antes de la foto (2,5 s de fabrica), y un tramo "explota;x;y;z;radio" revienta ahi: asi se
## fotografian los escombros cayendo y ya parados (2026-09-30, texturas de material).
func _mapa_fotos(arg: String) -> void:
	Settings.focus_mode = 0          # fotos nitidas (solo esta sesion: no se guarda en los ajustes)
	await get_tree().create_timer(4.0).timeout
	if team_overlay != null:
		Net.choose_team(Net.TEAM_CT)
		_close_team_select()
	await get_tree().create_timer(1.0).timeout
	for e in enemies.get_children():
		e.queue_free()
	if hud and not ("--fotohud" in OS.get_cmdline_user_args()):
		hud.visible = false
	player.invulnerable = true
	player.set_process_input(false)
	# --mapafotosnoche: de noche (la noche de siempre, con los faroles encendidos), para ver como quedaria
	if "--mapafotosnoche" in OS.get_cmdline_user_args():
		await get_tree().create_timer(3.0).timeout
		_faroles_tarde = true
		set_night(true)
		cielo_noche_cerrada()
		if "--mapafotoslinterna" in OS.get_cmdline_user_args():
			alternar_linterna()
		await get_tree().create_timer(3.0).timeout
	if player.fp_arms:
		player.fp_arms.visible = false
	if player.weapon_model:
		player.weapon_model.visible = false
	for n in ["weapon_pivot", "avatar"]:           # el cuerpo y el arma del jugador, que se queda bajo la camara
		var nd = player.get(n)
		if nd != null and is_instance_valid(nd) and nd is Node3D:
			(nd as Node3D).visible = false
	var cam := Camera3D.new()
	add_child(cam)
	cam.attributes = player.cam.attributes
	cam.far = maxf(player.cam.far, 400.0)
	cam.near = 0.05
	cam.make_current()
	# --sololamparas: SOLO LA LUZ DE LAS FAROLAS (para calibrar las cocinadas contra las de Godot, foto contra foto):
	# sin sol ni luna, sin cielo ni luz ambiente, sin niebla ni resplandor y con el tono lineal
	if "--sololamparas" in OS.get_cmdline_user_args():
		for dl in find_children("*", "DirectionalLight3D", true, false):
			(dl as DirectionalLight3D).light_energy = 0.0
		var e3: Environment = env.environment
		e3.background_mode = Environment.BG_COLOR
		e3.background_color = Color.BLACK
		e3.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
		e3.ambient_light_color = Color.BLACK
		e3.ambient_light_energy = 0.0
		e3.reflected_light_source = Environment.REFLECTION_SOURCE_DISABLED
		e3.fog_enabled = false
		e3.glow_enabled = false
		e3.tonemap_mode = Environment.TONE_MAPPER_LINEAR
		e3.tonemap_exposure = 1.0
	for tramo in arg.split("|"):
		var p := tramo.split(";")
		# "explota;x;y;z;radio": una explosion ahi (para ver los escombros en las fotos siguientes)
		if p.size() >= 5 and p[0] == "explota":
			var quitados: int = world.explode(Vector3(float(p[1]), float(p[2]), float(p[3])), float(p[4]), 255)
			if effects and p.size() >= 6 and p[5] == "fx":     # "explota;x;y;z;radio;fx": tambien la imagen (quemadura...)
				effects.explosion(Vector3(float(p[1]), float(p[2]), float(p[3])), float(p[4]))
			print("[mapafotos] explosion en (%s, %s, %s): %d voxels" % [p[1], p[2], p[3], quitados])
			continue
		if p.size() < 7:
			continue
		var desde := Vector3(float(p[1]), float(p[2]), float(p[3]))
		var hacia := Vector3(float(p[4]), float(p[5]), float(p[6]))
		cam.fov = float(p[7]) if p.size() >= 8 else 70.0
		var suelo: Vector3 = world.find_ground(Vector3(desde.x, desde.y, desde.z))
		player.global_position = (suelo if suelo.y > -1.0 else desde) + Vector3(0, 0.2, 0)
		player.velocity = Vector3.ZERO
		world.set_player_position(desde)
		cam.global_position = desde
		cam.look_at(hacia, Vector3.UP)
		# 9o campo: segundos de espera antes de la foto (2,5 de fabrica; menos, para pillar escombros en el aire)
		await get_tree().create_timer(float(p[8]) if p.size() >= 9 else 2.5).timeout
		if "--ocldiag" in OS.get_cmdline_user_args():
			await get_tree().process_frame
			for px in [Vector2(60, 150), Vector2(120, 220), Vector2(200, 260), Vector2(300, 240), Vector2(1250, 270)]:
				var d := cam.project_ray_normal(px)
				var h: Dictionary = world.raycast(cam.global_position, d, 200.0)
				var info := {}
				if bool(h.get("hit", false)) and world.has_method("get_material_info"):
					info = world.get_material_info(int(h.get("material", 0)))
				print("[ocldiag] pixel %s: %s dist %.1f mat %s %s" % [str(px), str(h.get("hit", false)), float(h.get("distance", -1.0)), str(h.get("material", "?")), str(info.get("name", ""))])
		for i in 4:
			await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png(p[0])
		print("[mapafotos] ", p[0])
	get_tree().quit()


## EL MICROCORTE DEL SALTO, FOTOGRAMA A FOTOGRAMA. Se salta corriendo y se apunta, en cada tick de
## fisica, si el motor cree que esta en el suelo, la velocidad vertical y que clip esta sonando. El
## fallo se ve solo: un "jump_land" suelto en medio de la subida.
func _salto_anim_test() -> void:
	await get_tree().create_timer(4.0).timeout
	if team_overlay != null:
		Net.choose_team(Net.TEAM_CT)
		_close_team_select()
	await get_tree().create_timer(1.0).timeout
	player.invulnerable = true
	for intento in 3:
		# corriendo de frente, que es como se salta de verdad
		Input.action_press("move_forward")
		Input.action_press("sprint")
		await get_tree().create_timer(1.2).timeout
		var reg: Array = []
		player.touch_jump = true
		var t := 0.0
		while t < 1.4:
			await get_tree().physics_frame
			t += get_physics_process_delta_time()
			# EL ESQUELETO. `skeleton.position.y` es el ajuste que baja el cuerpo para que el pie
			# mas bajo del clip toque el suelo. En un clip DE VUELO eso no tiene sentido, y si
			# pega un salto es justo el tiron que se ve.
			var sk: Skeleton3D = player.avatar.skeleton
			reg.append("%s %-6s sk.y=%+.3f" % [
				"SUELO" if player.is_on_floor() else "aire ",
				String(player.avatar.current_clip).replace("jump_", ""),
				sk.position.y])
		Input.action_release("move_forward")
		Input.action_release("sprint")
		# se resume: solo se imprimen los CAMBIOS, si no son 84 lineas por salto
		if intento == 0:
			var ant_y := 0.0
			for i in reg.size():
				var r: String = reg[i]
				var y: float = float(r.split("sk.y=")[1])
				# solo se imprime cuando el esqueleto DA UN SALTO de mas de 2 cm en un tick
				var marca: String = "   <-- TIRON de %+.0f mm" % ((y - ant_y) * 1000.0) if i > 0 and absf(y - ant_y) > 0.02 else ""
				if i < 4 or marca != "" or i % 6 == 0:
					print("[saltoanim] t=%2d  %s%s" % [i, r, marca])
				ant_y = y
		await get_tree().create_timer(1.0).timeout
	print("[saltoanim] (S = el motor dice 'en el suelo', . = en el aire)")
	get_tree().quit()


