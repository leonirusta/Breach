## Ritmo del analisis de cargas: se vuela un edificio y se mide cuantas iteraciones se encadenan y
## que tal van los fotogramas. Con --structsleep=N se prueba otro descanso (0 = ritmo antiguo).
func _struct_rate_test() -> void:
	await get_tree().create_timer(3.0).timeout
	var sleep := 3.0
	for f in OS.get_cmdline_user_args():
		if String(f).begins_with("--structsleep="):
			sleep = float(String(f).substr(14))
	world.set_structural_sleep(sleep)
	# edificio alto de verdad (dust2 no tiene get_building_centers)
	var size: Vector3 = world.get_world_size()
	seed(3)
	var best := Vector3.ZERO
	var best_h := -1.0
	for attempt in 900:
		var x := randf_range(size.x * 0.15, size.x * 0.85)
		var z := randf_range(size.z * 0.15, size.z * 0.85)
		var top: Dictionary = world.raycast(Vector3(x, size.y - 1.0, z), Vector3.DOWN, size.y)
		if not top.hit or top.position.y < 4.0 or top.position.y <= best_h:
			continue
		var under: Dictionary = world.raycast(top.position - Vector3(0, 0.6, 0), Vector3.DOWN, top.position.y)
		if not under.hit or (top.position.y - under.position.y) < 2.0:
			continue
		best_h = top.position.y
		best = Vector3(x, top.position.y, z)
	if best_h < 3.0:
		print("[cargas] no encontre edificio")
		get_tree().quit()
		return
	player.global_position = Vector3(best.x, best_h + 1.2, best.z - 16.0)
	world.set_player_position(player.global_position)
	await get_tree().create_timer(1.0).timeout
	# se empieza a contar ANTES de cortar: las iteraciones que importan son las del derrumbe
	var it0: int = int(world.get_stats()["struct_iterations"])
	var t0: int = Time.get_ticks_msec()
	# corte horizontal a media altura: es lo que deja la planta de arriba sin apoyos
	var y: float = best_h - 1.5
	for a in [0.0, PI * 0.5]:
		var dir := Vector3(cos(a), 0, sin(a))
		world.carve_beam(Vector3(best.x, y, best.z) - dir * 22.0, dir, 44.0, 1.1, 1.0, true)
		await get_tree().process_frame
	var worst := 0.0
	var frames := 0
	while Time.get_ticks_msec() - t0 < 12000:
		await get_tree().process_frame
		frames += 1
		worst = maxf(worst, Performance.get_monitor(Performance.TIME_PROCESS) * 1000.0)
	var it: int = int(world.get_stats()["struct_iterations"]) - it0
	var secs: float = float(Time.get_ticks_msec() - t0) / 1000.0
	print("[cargas] descanso %.1f s -> %d iteraciones en %.1f s (%.2f/s) · %.1f fps medios · peor proceso %.1f ms" % [
		sleep, it, secs, it / secs, frames / secs, worst])
	get_tree().quit()


## EFECTO DOMINO. Un misil abre un agujero en UNA pared de un edificio de la ciudad y se mira si
## el edificio entero se viene abajo (mal) o solo cede lo que ha perdido el apoyo (bien). Se
## fotografia la secuencia y se registra altura, piezas e iteraciones del analisis.
func _domino_test() -> void:
	await get_tree().create_timer(4.0).timeout
	Settings.bots_enabled = false
	for e in enemies.get_children():
		e.queue_free()
	var dir_out := "user://domino"
	DirAccess.make_dir_recursive_absolute(dir_out)
	var size: Vector3 = world.get_world_size()
	var centers: PackedVector3Array = world.get_building_centers()
	# el edificio mas alto con sitio alrededor
	var best := Vector3.ZERO
	var best_h := 0.0
	for c in centers:
		var r: Dictionary = world.raycast(Vector3(c.x, size.y - 1.0, c.z), Vector3.DOWN, size.y)
		if r.hit and r.position.y > best_h:
			best_h = r.position.y
			best = Vector3(c.x, r.position.y, c.z)
	if best_h < 6.0:
		print("[domino] no encontre edificio")
		get_tree().quit()
		return
	# LA FACHADA de verdad: rayo desde MUY FUERA hacia el centro; el primer impacto es el muro
	# exterior (antes se lanzaba desde el propio centro y chocaba con el primer tabique de dentro,
	# asi que el misil reventaba una pared interior con el jugador dentro del edificio)
	# se camina desde el centro hacia -X consultando el material voxel a voxel: el ultimo solido
	# antes de 2 m seguidos de aire es la CARA EXTERIOR de la fachada
	var y_hit: float = best_h * 0.5
	var wall := Vector3(best.x, y_hit, best.z)
	var found := false
	var air := 0.0
	var last_solid := best.x
	var xx: float = best.x
	while xx > best.x - 60.0:
		if int(world.get_material_at(Vector3(xx, y_hit, best.z))) != 0:
			last_solid = xx
			air = 0.0
		else:
			air += 0.25
			if air >= 2.0 and last_solid < best.x:
				wall = Vector3(last_solid, y_hit, best.z)
				found = true
				break
		xx -= 0.25
	print("[domino] edificio en %.1f,%.1f (%.1f m de alto) · fachada en %.1f,%.1f,%.1f · %s" % [
		best.x, best.z, best_h, wall.x, wall.y, wall.z, "ok" if found else "NO la encontre"])
	# el jugador mira desde la calle, lo bastante lejos para ver el edificio entero
	var street: Vector3 = world.find_ground(Vector3(wall.x - 42.0, 2.0, wall.z))
	player.global_position = street + Vector3(0, 1.0, 0)
	player.velocity = Vector3.ZERO
	player.look_at_point(wall)
	world.set_player_position(player.global_position)
	player.invulnerable = true
	await get_tree().create_timer(1.0).timeout
	# estado de partida: altura del edificio y piezas sueltas
	var col0: int = _domino_solid_column(best.x, best.z, size.y)
	var shot := func(name: String):
		await RenderingServer.frame_post_draw
		var img := get_viewport().get_texture().get_image()
		img.save_png("%s/%s.png" % [dir_out, name])
	await shot.call("0_antes")
	# EL MISIL: se lanza como el del juego, contra la pared
	# impacto de misil contra la fachada (mismo radio y potencia que el cohete del juego)
	# EL COHETE DE VERDAD: radio 4,0 y potencia 255 (weapons.gd). Antes ponia 3 de potencia, que
	# no pasa de la resistencia del hormigon (170): la explosion no rompia nada.
	Net.net_explode(world, wall + Vector3(0.4, 0.0, 0.0), 4.0, 255)
	if effects and effects.has_method("explosion"):
		effects.explosion(wall, 4.5)
	var t0: int = Time.get_ticks_msec()
	var log_rows: Array = []
	var last_shot := 0
	while Time.get_ticks_msec() - t0 < 22000:
		await get_tree().create_timer(0.5).timeout
		var st: Dictionary = world.get_stats()
		var secs: float = float(Time.get_ticks_msec() - t0) / 1000.0
		log_rows.append([secs, _domino_solid_column(best.x, best.z, size.y), int(st["struct_iterations"]),
			int(st["struct_failures"]), int(st["struct_fragments"]), world.get_body_count(),
			int(st.get("voxels_destroyed", 0)), float(st.get("struct_worst_ratio", 0.0))])
		if int(secs) >= last_shot + 3 and int(secs) <= 21:
			last_shot = int(secs)
			await shot.call("%d_s" % last_shot)
	print("[domino] columna solida del centro del edificio ANTES: %d voxels" % col0)
	print("[domino]   t(s) columna iteraciones fallidas fragmentos piezas destruidos peor_ratio")
	for r2 in log_rows:
		print("[domino]  %5.1f %7d %11d %8d %10d %6d %10d %10.2f" % r2)
	get_tree().quit()


## Cuantos voxels solidos hay en la vertical del centro del edificio: si el edificio se cae entero,
## este numero se desploma.
func _domino_solid_column(x: float, z: float, ytop: float) -> int:
	var n := 0
	var y := 0.5
	while y < ytop:
		var r: Dictionary = world.raycast(Vector3(x, y, z), Vector3.UP, 0.3)
		if r.hit:
			n += 1
		y += 0.5
	return n


## EFECTOS DE DISPARO: trazador, casquillo, luz del fogonazo, marcador segun donde das, sacudida y
## flechas de daño. Se dispara contra una pared y se fotografia el momento exacto.
func _fx_test() -> void:
	await get_tree().create_timer(4.0).timeout
	Settings.bots_enabled = false
	var dir_out := "user://fx"
	DirAccess.make_dir_recursive_absolute(dir_out)
	var size: Vector3 = world.get_world_size()
	# una pared cualquiera delante del jugador
	var fwd: Vector3 = -player.global_transform.basis.z
	var r: Dictionary = world.raycast(player.global_position + Vector3(0, 1.5, 0), fwd, 60.0)
	if not r.hit:
		for a in range(0, 8):
			fwd = Vector3(cos(TAU * a / 8.0), 0, sin(TAU * a / 8.0))
			r = world.raycast(player.global_position + Vector3(0, 1.5, 0), fwd, 60.0)
			if r.hit:
				break
	if r.hit:
		player.look_at_point(r.position)
	await get_tree().create_timer(0.5).timeout
	var shot := func(name: String):
		await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("%s/%s.png" % [dir_out, name])
	player.current = 0
	player.fire()
	# se mide EN EL MISMO instante del disparo: el trazador de un tiro a 5 m dura 20 ms y el
	# fogonazo 45 ms; esperando dos fotogramas ya se habian apagado y parecia que no funcionaban
	var dist_pared: float = player.global_position.distance_to(r.position) if r.hit else 0.0
	print("[fx] al disparar: trazadores %d · casquillos %d · luz del fogonazo %s · pared a %.1f m" % [
		effects._tracers.size(), effects._shells.size(),
		str(player.weapon_model.flash_light.visible) if player.weapon_model else "sin arma", dist_pared])
	await get_tree().process_frame
	await shot.call("1_disparo")
	await get_tree().create_timer(0.35).timeout
	await shot.call("2_casquillo")
	print("[fx] a 0,35 s: trazadores %d · casquillos %d" % [effects._tracers.size(), effects._shells.size()])
	# daño: flecha direccional + viñeta + aberracion
	player.invulnerable = false
	player.take_damage(72.0, (player.global_transform.basis.z).normalized())
	await get_tree().create_timer(0.15).timeout
	await shot.call("3_dano")
	print("[fx] vida %d · flechas de daño %d · viñeta alfa %.2f · aberracion %s · sacudida %.3f" % [
		int(player.health), hud.dmg_dirs.size(), hud.vignette.modulate.a, str(hud.aberration.visible), player._shake])
	# explosion cerca: sacudida
	var before: float = player._shake
	effects.explosion(player.global_position + Vector3(3, 0.5, 0), 4.0)
	await get_tree().process_frame
	print("[fx] explosion a 3 m: sacudida %.3f -> %.3f" % [before, player._shake])
	await get_tree().create_timer(0.6).timeout
	await shot.call("4_vida_baja")
	# el menu de la partida: un solo boton de COMBATE que abre su panel con las opciones dentro
	hud.toggle_menu()
	await get_tree().process_frame
	var entrada: Button = null
	var n_menu := 0
	for b in hud.menu_panel.find_children("*", "Button", true, false) if hud.menu_panel else []:
		n_menu += 1
		if String(b.text).findn("COMBATE") >= 0:
			entrada = b
	if entrada == null:
		print("[fx] menu: NO esta el boton de combate")
		get_tree().quit()
		return
	entrada.pressed.emit()
	await get_tree().process_frame
	await get_tree().process_frame
	var opciones: Array = []
	for b in hud.combat_panel.find_children("*", "Button", true, false) if hud.combat_panel else []:
		opciones.append(String(b.text))
	print("[fx] menu: %d botones, con 1 entrada de COMBATE -> el panel trae %d opciones: %s" % [
		n_menu, opciones.size(), "; ".join(opciones)])
	# y que el interruptor funcione de verdad
	var antes: bool = Settings.fire_ads
	for b in hud.combat_panel.find_children("*", "Button", true, false):
		if String(b.text).findn("APUNTAR AL DISPARAR") >= 0:
			b.pressed.emit()
			break
	await get_tree().process_frame
	await get_tree().process_frame
	print("[fx] apuntar al disparar: %s -> %s" % [str(antes), str(Settings.fire_ads)])
	get_tree().quit()


