			break
	for e in enemies.get_children():
		e.queue_free()
	heist._open_vault()
	await get_tree().create_timer(0.5).timeout
	for nombre in ["caja", "terminal"]:
		var n: Node3D = heist.vault if nombre == "caja" else heist.cashout
