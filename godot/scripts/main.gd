## UN COMPAÑERO HA CAIDO (2026-11-01): en bomba, el aviso con su nombre
func _companero_caido(_a: String, _ea: String, _k: String, _i: String, victima: String, eq_v: String, _c: bool) -> void:
	# CAMARA LENTA EN UNA BAJA (2026-11-01, pedido: "que tambien aparezca al eliminar a un enemigo, con poca
	# probabilidad"): la tira quien manda, para todos, compartiendo la espera con la de los derrumbes
	if victima != "" and not _sin_camara_lenta and not (Net.is_online() and not Net.hosting) and randf() < LENTA_BAJA_PROB:
		var ahora := Time.get_ticks_msec()
		if ahora - _derr_ultima > int(DERRUMBE_ENFRIA_S * 1000.0):
			_derr_ultima = ahora
			Net.net_camara_lenta("")
	# ¡A LA CABEZA! (2026-11-01): tu baja de un tiro a la cabeza; y segun el arma, su cartel
	if hud and _a != "" and _a == Net.nombre_propio() and victima != _a:
		var k := (_k + "|" + _i).to_lower()
		if _c:
			hud.anuncio("¡A LA CABEZA!")
		elif "sledge" in k or "mazo" in k or "melee" in k:
			hud.anuncio("¡MAZAZO!")
		elif "grenade" in k:
			hud.anuncio("¡GRANADAZO!")
		elif "rocket" in k or "bazooka" in k:
			hud.anuncio("¡COHETAZO!")
	if not bomb_mode or hud == null or victima == "" or victima == Net.nombre_propio():
		return
	if eq_v != "" and eq_v == Net.my_team():
		hud.anuncio("%s HA CAÍDO" % Net.nombre_para_ver(victima, "UN COMPAÑERO").to_upper())


func _ultimo_en_pie_tick() -> void:
	if not Net.baja_feed.is_connected(_companero_caido):
		Net.baja_feed.connect(_companero_caido)
	if not Net.players_changed.is_connected(_quien_entra):
		Net.players_changed.connect(_quien_entra)
		_quien_entra()
	elif not _gente_lista and not loading:
		_quien_entra()          # (la lista de quien esta, tomada ya con la partida en marcha)
	# RONDA N (2026-11-01): al empezar cada ronda de bomba, su numero y el marcador
	if bomb_mode and Net.round_live and Net.ronda_t0_ms != _ronda_anunciada and hud and not loading and Net.score_t + Net.score_ct > 0:
		_ronda_anunciada = Net.ronda_t0_ms
		var mio_t := Net.my_team()
		var a := Net.score_t if mio_t != Net.TEAM_CT else Net.score_ct
		var b := Net.score_ct if mio_t != Net.TEAM_CT else Net.score_t
		hud.anuncio("RONDA %d · %d - %d" % [Net.score_t + Net.score_ct + 1, a, b])
	if not bomb_mode or not Net.round_live or player == null or float(player.health) <= 0.0:
		_ultimo_avisado = _ultimo_avisado and Net.round_live
		return
	if _ultimo_avisado or Engine.get_physics_frames() % 15 != 0:
		return
	var mio := Net.my_team()
	if not (mio in [Net.TEAM_T, Net.TEAM_CT]):
		return
	var otro := Net.TEAM_CT if mio == Net.TEAM_T else Net.TEAM_T
	var ellos := Net.en_pie(otro)
	if Net.en_pie(mio) == 1 and ellos >= 2:
		_ultimo_avisado = true
		hud.anuncio("¡ERES EL ÚLTIMO! · 1 contra %d" % ellos)
		Audio.ui("intro_golpe", -6.0)


func _reloj_ronda_tick() -> void:
	if not bomb_mode or _bomba_terminada or Net.ronda_sin_tiempo:
		return
	# el reloj arranca cuando ya se juega: mapa cargado y bando elegido (la carga de dust son decenas de segundos)
	if Net.ronda_t0_ms == 0:
		if loading or not (Net.my_team() in [Net.TEAM_T, Net.TEAM_CT]):
			return
		Net.ronda_t0_ms = Time.get_ticks_msec()
	if Net.is_online() and not Net.hosting:
		return
	if not Net.round_live or is_instance_valid(Net.bomb_node):
		return
	if (Time.get_ticks_msec() - Net.ronda_t0_ms) * 0.001 >= Net.RONDA_S:
		Net.end_round(Net.TEAM_CT, "Se acabó el tiempo")


func _mandar_bots(dt: float) -> void:
	if not Net.is_online() and enemies != null and bomb_mode:
		# SIN SALA TAMBIEN SE CUENTA. La cuenta de bots vivos por bando solo se hacia en red, asi que
		# jugando solo el arbitro creia que no habia bots y eliminar al equipo contrario no ganaba nada.
		_bots_red_t += dt
		if _bots_red_t >= 0.25:
			_bots_red_t = 0.0
			var cuenta := {Net.TEAM_T: 0, Net.TEAM_CT: 0}
			for e in enemies.get_children():
				if is_instance_valid(e) and "team" in e and cuenta.has(String(e.team)) 						and (not ("health" in e) or float(e.health) > 0.0):
					cuenta[String(e.team)] += 1
			Net.bots_por_bando = cuenta
			Net.revisar_eliminacion()
		return
	if not (Net.is_online() and Net.hosting) or enemies == null:
		return
	_bots_red_t += dt
	if _bots_red_t < 1.0 / BOTS_RED_HZ:
		return
	_bots_red_t = 0.0
	var datos: Array = []
	var vivos: Dictionary = {}
	# CUANTOS BOTS SIGUEN EN PIE EN CADA BANDO. El arbitro es `Net`, pero los bots son de aqui: sin
	# esta cuenta, en cuanto caia la ultima PERSONA de un bando se daba el bando por eliminado con
	# cinco bots suyos vivos. Se manda desde aqui y no se calcula alli para no obligar a `Net` a
	# conocer la escena.
	var por_bando := {Net.TEAM_T: 0, Net.TEAM_CT: 0}
	for e in enemies.get_children():
		# LAS CRIATURAS VIVEN EN ESTE MISMO NODO. `pve.setup(player, world, hud, enemies)` le pasa al
		# modo oleadas el contenedor de los bots, asi que en una partida de zombis esta lista trae
		# criaturas, que TAMBIEN tienen `red_id` y colaban por el filtro: cada tick se intentaba
		# anunciarlas como bots y reventaba en `e.team` y en `e.health`. Un bot tiene bando; una
		# criatura no. (Medido: el log del anfitrion se llenaba de "Invalid access to property".)
		if not is_instance_valid(e) or not ("red_id" in e) or not ("team" in e):
			continue
		if not ("health" in e) or float(e.health) > 0.0:
			var eq := String(e.team)
			if por_bando.has(eq):
				por_bando[eq] += 1
		# POR SI ALGUNO NACIO POR UN CAMINO QUE NO PASA POR `setup` (los de prueba, los del PvE): sin
		# numero de red no se puede replicar, y mandarlo con el 0 seria mandarlos todos como el mismo.
		if int(e.red_id) == 0:
			e.red_id = _nuevo_id_bot()
		var bid := int(e.red_id)
		vivos[bid] = true
		# si de este bot piensa OTRO, su postura la manda el: yo solo la retransmito cuando llega
		var dueno := int(Net.duenos_bot.get(bid, 1))
		if not _bots_anunciados.has(bid):
			_bots_anunciados[bid] = true
			anunciar_bot(e)
			_reparto_pendiente = true
		var clip := ""
		if "avatar" in e and e.avatar != null and "current_clip" in e.avatar:
			clip = String(e.avatar.current_clip)
		if dueno == 1:
			datos.append_array([bid, e.global_position.x, e.global_position.y, e.global_position.z,
				e.rotation.y, clip, float(e.health)])
	Net.net_bots_estado(datos)
	# y con la cuenta al dia se vuelve a mirar si algun bando se ha quedado sin nadie: la ultima
	# muerte puede ser la de un BOT, y esa no pasa por `Net._death`
	Net.bots_por_bando = por_bando
	Net.revisar_eliminacion()
	if _reparto_pendiente:
		_reparto_pendiente = false
		_rehacer_reparto()      # han nacido bots: hay que repartirlos
	# los que estaban y ya no estan: han caido
	for bid in _bots_anunciados.keys():
		if not vivos.has(bid):
			_bots_anunciados.erase(bid)
			Net.net_bot_muerto(int(bid), Vector3.ZERO)


## INVITADO: un bot del anfitrion ha disparado: su copia pinta la bala, el fogonazo y el humo, y suena
var red_tiros_bot := 0
func _red_bot_tiro(id: int, dir: Vector3, largo: float) -> void:
	red_tiros_bot += 1
	var e = _bots_copia.get(id)
	if e == null or not is_instance_valid(e):
		# EN EL ANFITRION NO HAY COPIAS: el bot que el reparto le dio a un invitado sigue en su lista de bots
		e = null
		if enemies != null:
			for b in enemies.get_children():
				if is_instance_valid(b) and "red_id" in b and "team" in b and int(b.red_id) == id:
					e = b
					break
	if e == null or not is_instance_valid(e):
		return
	# si de este bot pienso YO, el disparo ya lo he pintado al hacerlo
	if (Net.hosting and int(Net.duenos_bot.get(id, 1)) == 1) or _bots_mios_red.has(id):
		return
	if e.has_method("_disparo_visible"):
		e._disparo_visible(dir, largo)
	Audio.gunshot("rifle", e.global_position + Vector3(0, 1.3, 0), false, String(e.get("_arma_sonido")))


## INVITADO: nace una copia. No piensa: `remoto = true` apaga toda la IA de `enemy.gd`.
func _red_bot_nuevo(id: int, equipo: String, pos: Vector3, nombre: String) -> void:
	_red_bots_recibidos += 1
	if _bots_copia.has(id):
		_red_bots_repetidos += 1
		return
	if enemies == null:
		_red_bots_sin_sitio += 1
		return
	var e := ENEMY_SCENE.instantiate()
	enemies.add_child(e)
	e.remoto = true
	e.red_id = id
	e.team = equipo
	e.bot_name = nombre
	if "nombre_marcador" in e:
		e.nombre_marcador = nombre
	e.global_position = pos
	e.setup(world, player, id)
	# CON BOTIN SE EMPIEZA SIN ARMA, tambien los bots. Antes caian del avion con el fusil puesto y te
	# disparaban nada mas tocar el suelo mientras tu buscabas la primera pistola. Ahora van a buscarla
	# como tu (`_bots_a_por_armas`).
	if hay_botin and e.has_method("desarmar"):
		e.desarmar()
	if e.red_id == 0:
		e.red_id = _nuevo_id_bot()   # el numero que viaja por la red
	_bots_copia[id] = e


## IGUAL QUE CON LOS BICHOS: si el anfitrion manda la postura de un bot que yo no tengo, es que me
## perdi su nacimiento, y un bot que no esta es un bot que te dispara desde ninguna parte. Se pide el
## censo otra vez en vez de intentar adivinar por que se perdio el aviso.
const RECENSO_BOTS_S := 2.0
var _recenso_bots_t := -RECENSO_BOTS_S


## INVITADO: 7 numeros por bot, en el mismo orden en que los puso el anfitrion.
func _red_bot_estado(datos: Array) -> void:
	var i := 0
	var faltan := 0
	while i + 6 < datos.size():
		var e = _bots_copia.get(int(datos[i]))
		if is_instance_valid(e):
			e.poner_estado_red(Vector3(datos[i + 1], datos[i + 2], datos[i + 3]),
				float(datos[i + 4]), String(datos[i + 5]), float(datos[i + 6]))
		else:
			faltan += 1
		i += 7
	if faltan > 0:
		var ahora: float = float(Time.get_ticks_msec()) / 1000.0
		if ahora - _recenso_bots_t >= RECENSO_BOTS_S:
			_recenso_bots_t = ahora
			print("[net] me faltan %d bot(s) que el anfitrion si tiene: pido el censo" % faltan)
			Net.pedir_censo_bots()


func _red_bot_muerto(id: int, empuje: Vector3) -> void:
	var e = _bots_copia.get(id)
	_bots_copia.erase(id)
	if is_instance_valid(e) and e.has_method("take_damage"):
		e.remoto = false        # para que la muerte corra de verdad (ragdoll, sonido, marcador)
		e.take_damage(9999.0, empuje)


## DAÑO MAXIMO QUE UN CLIENTE PUEDE PEDIR PARA UN BOT, de una vez.
##
## Los bots NO se rebobinan: seria guardar la posicion de cada uno 20 veces por segundo y recorrer ese
## historial en CADA disparo de CADA jugador, y para un bot no compensa. La consecuencia es que el
## impacto lo decide el que dispara, y hay que vivir con dos cosas:
##
##   * apuntas a donde el bot ESTUVO (tu copia va un poco por detras). Con 15 envios por segundo y el
##     suavizado son unos 80 ms: a la distancia de un tiroteo no se nota, pero a un bot corriendo de
##     lado por delante hay que adelantarle un poco.
##   * el anfitrion se fia de lo que le mandan.
##
## Lo segundo NO hay que tragarselo entero aunque no haya rebobinado: comprobar que el numero es
## razonable cuesta una comparacion. Sin esto, un cliente modificado manda 99999 y borra la partida de
## bots de un tiro; con esto, lo peor que puede hacer es pegar mas fuerte de lo que deberia.
const DANO_BOT_MAX := 200.0


## ANFITRION: alguien dice que le ha dado a un bot. La vida la llevo yo, asi que la aplico aqui.
func _dano_a_bot(id: int, dmg: float, push: Vector3, _de_quien: int) -> void:
	if enemies == null:
		return
	dmg = clampf(dmg, 0.0, DANO_BOT_MAX)
	push = push.limit_length(60.0)
	for e in enemies.get_children():
		if is_instance_valid(e) and "red_id" in e and int(e.red_id) == id:
			# quien le dio (para la tabla y el registro de bajas): la copia de ese invitado
			if Net.remotes.has(_de_quien) and is_instance_valid(Net.remotes[_de_quien]) and "ultimo_atacante" in e:
				e.ultimo_atacante = Net.remotes[_de_quien]
			e.take_damage(dmg, push)
			return


func spawn_enemies() -> void:
	if Settings.modo == "pve":
		return                # en PvE los enemigos son las criaturas de las oleadas
	# LA SALA SIGUE ABIERTA (Net.ESPERA_SALA_S): los bots nacen al arrancar, contando a los que hayan entrado
	if Net.hosting and Net.espera_hasta_ms > 0 and not Net.partida_arrancada:
		_bots_aplazados = true
		return
	# LOS BOTS SON DEL SERVIDOR: sin partida online no se crea ninguno. Un solo corte aqui y en los
	# dos repuestos, en vez de repartir la condicion por las cinco llamadas.
	if not Settings.bots_permitidos():
		return
	Escuadra.reiniciar()      # los avisos de la ronda anterior no valen nada
	Audio.empezar_ronda()     # el primer minuto, las pisadas ajenas al 20 %
	if ciudad3:
		_bots_ciudad()
		return
	if Settings.es_battle_royale(current_map):
		_bots_battle_royale()
		return
	# DUELO TODOS CONTRA TODOS: cada bot va a lo suyo
	if dm_mode and Net.es_dm_todos():
		_bots_dm_todos()
		return
	var mio := Net.my_team()
	if mio == "":
		mio = Net.TEAM_T
	var otro := Net.TEAM_CT if mio == Net.TEAM_T else Net.TEAM_T
	_bots_mios = _faltan_bots(mio)
	var count: int = _bots_mios + _faltan_bots(otro)
	if bomb_sites.is_empty():
		_load_bomb_sites()
	var centers: PackedVector3Array = world.get_building_centers()
	if bomb_sites.is_empty() and not centers.is_empty():
		for i in range(mini(count, centers.size())):
			_spawn_enemy_at(Vector3(centers[i].x, 0.9, centers[i].z), i)   # planta baja, dentro del edificio
		_assign_bot_teams()
		return
	for i in count:
		_spawn_enemy_at(Vector3.ZERO, i)
	_assign_bot_teams()

## LOS BOTS DEL BATTLE ROYALE: los que falten para llegar a 30 con las personas que haya (en solitario, 29).
## TODOS CONTRA TODOS: cada bot va en su propio bando ("br1", "br2"...), asi que ninguno es aliado de nadie
## (ni de ti, que eres "T", ni de otro bot) y ninguno lleva la etiqueta de compañero. Nacen repartidos por
## los puntos de salida; el avion (salto_br.gd) los recoge enseguida.
func _bots_battle_royale() -> void:
	var humanos: int = maxi(1, Net.players.size()) if Net.is_online() else 1
	# EL TOPE POR MAPA (2026-10-22, pedido: "la habitacion da mucho lag"): el .br.json puede traer "jugadores" y
	# "jugadores_movil" (en el movil, 29 bots con sus muñecos eran la mayor parte del lag)
	var cfg_j: Dictionary = SaltoScript.config_br(current_map)
	var tope_j: int = int(cfg_j.get("jugadores_movil" if Settings.is_mobile() else "jugadores", Settings.BR_MAX_JUGADORES))
	var n: int = maxi(0, tope_j - humanos)
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--bots_br="):
			n = int(a.substr(10))           # para medir con menos (o mas)
	var pts: Array = _puntos_aparicion()
	_bots_mios = 0
	for i in n:
		var sitio: Vector3 = pts[i % pts.size()] if not pts.is_empty() else Vector3.ZERO
		_spawn_enemy_at(sitio, i)
	var i := 0
	# POR ESCUADRAS (Net.es_escuadras): los bots RELLENAN las escuadras, primero los huecos de las que tienen personas y
	# luego escuadras nuevas de cuatro. Los de la tuya son compañeros (sin fuego amigo, con su vida a la vista).
	var escuadras: bool = Net.es_escuadras()
	var cuenta: Dictionary = Net.personas_por_escuadra() if escuadras else {}
	for e in enemies.get_children():
		if not ("team" in e):
			continue
		var aliado := false
		if escuadras:
			e.team = _escuadra_para_bot(cuenta)
			aliado = String(e.team) == Net.my_team()
		else:
			e.team = "br%d" % (i + 1)
		_pintar_bot(e, aliado, i)          # (su nombre de jugador: nombre_bot)
		if not pts.is_empty():
			e.global_position = _ground_near(pts[(i * 7 + 3) % pts.size()]) + Vector3(randf_range(-3, 3), 0.5, randf_range(-3, 3))
		i += 1
	if escuadras:
		print("[br] %d bots en escuadras para %d persona(s): %s" % [i, humanos, str(cuenta)])
	else:
		print("[br] %d bots (todos contra todos) para %d persona(s): %d en la partida" % [i, humanos, i + humanos])


## LOS BOTS RELLENAN LAS ESCUADRAS: primero la que tenga personas y este mas llena (asi nadie juega solo), luego escuadras
## nuevas de Net.ESCUADRA_MAX. `cuenta` (equipo -> cuantos lleva) se va sumando.
func _escuadra_para_bot(cuenta: Dictionary) -> String:
	var mejor := ""
	var alta := Net.escuadra_mas_alta
	for eq in cuenta.keys():
		var n := int(cuenta[eq])
		alta = maxi(alta, int(String(eq).substr(1)))
		if n < Net.ESCUADRA_MAX and (mejor == "" or n > int(cuenta[mejor])):
			mejor = String(eq)
	if mejor == "":
		Net.escuadra_mas_alta = alta + 1
		mejor = "e%d" % Net.escuadra_mas_alta
	cuenta[mejor] = int(cuenta.get(mejor, 0)) + 1
	return mejor


