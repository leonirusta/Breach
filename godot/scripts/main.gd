## Editor de controles CON EL DEDO (eventos tactiles de verdad, que es donde fallaba): el panel de
## anadir tiene que quedar dentro de la pantalla y sus botones responder al toque, y la barra de
## tamano tiene que moverse al arrastrarla.
## Los eventos inyectados van en coordenadas de VENTANA; los rect de la interfaz estan en las del
## lienzo (stretch canvas_items). Sin convertir, en una ventana mas pequena que el lienzo el toque
## caia desplazado y parecia que los botones no respondian.
func _to_window(p: Vector2) -> Vector2:
	var vp: Vector2 = get_viewport().get_visible_rect().size
	var win: Vector2 = Vector2(DisplayServer.window_get_size())
	return p * Vector2(win.x / maxf(1.0, vp.x), win.y / maxf(1.0, vp.y))


func _touch_toque(p: Vector2, down: bool) -> void:
	var e := InputEventScreenTouch.new()
	e.index = 0
	e.position = _to_window(p)
	e.pressed = down
	Input.parse_input_event(e)
	await get_tree().process_frame
	await get_tree().process_frame


