## UN CUBO INGRESADO: 1000 puntos para tu equipo. Si llega a 3000, gana; si no, a los tres segundos sale
## otra caja fuerte en otro edificio.
func _ciudad_ingreso(pts: int, equipo: String = "") -> void:
	if ciudad_terminada:
		return
	# LOS PUNTOS SON DEL EQUIPO QUE TENIA EL TERMINAL AL ACABAR, que no tiene por que ser el que metio el
	# cubo: otro color se lo pudo robar por el camino (heist.gd, CAPTURE_TIME).
	var eq := equipo if equipo != "" else Net.my_team()
	if eq == Net.my_team():
		Combat.partida_objetivos += 1          # ingresar un cubo es hacer el objetivo
	puntos_equipo[eq] = int(puntos_equipo.get(eq, 0)) + pts
	hud.set_puntos_equipos(puntos_equipo, PUNTOS_GANAR)
	if int(puntos_equipo[eq]) >= PUNTOS_GANAR:
		_ciudad_fin(eq)
		return
	hud.flash_message("+%d para el %s · sale otra caja fuerte en otro sitio" % [pts, Net.nombre_equipo(eq)])
	await get_tree().create_timer(3.0).timeout
	if not is_inside_tree() or ciudad_terminada:
		return
	_start_heist()


## EL ATRACO SE ACABA: pantalla de victoria con el podio de bajas y los puntos de los tres equipos.
func _ciudad_fin(ganador: String) -> void:
	if ciudad_terminada:
		return
	ciudad_terminada = true
	# Igual que duelo y bomba: el anfitrion conserva y repite el resultado. Si
	# un invitado pierde el evento de ingreso ganador, puede pedir este final.
	Net.net_fin_partida(ganador, "atraco")
	hud.quitar_objetivo_mundo()
	if is_instance_valid(heist):
		heist.queue_free()
	if is_instance_valid(player):
		player.invulnerable = true
		player.set_process_input(false)
		player.set_process_unhandled_input(false)
	if enemies != null:
		for e in enemies.get_children():
			if "nombre_marcador" in e and String(e.nombre_marcador) != "":
				_dm_fila(String(e.nombre_marcador), String(e.team))
			e.process_mode = Node.PROCESS_MODE_DISABLED
	_dm_fila(_mi_nombre(), Net.my_team())
	var mi := _mi_nombre()
	var filas: Array = []
	for nombre in dm_stats.keys():
		var st: Dictionary = dm_stats[nombre]
		filas.append({"nombre": nombre, "equipo": st["equipo"], "bajas": st["bajas"],
			"muertes": st["muertes"], "es_yo": nombre == mi})
	var linea := ""
	for eq in Net.equipos:
		if linea != "":
			linea += "   ·   "
		linea += "%s %d" % [Net.nombre_equipo(eq).replace("EQUIPO ", ""), int(puntos_equipo.get(eq, 0))]
	# PREMIO DEL ATRACO, como en los demas modos: ganar paga, perder no.
	var gane_atraco: bool = ganador == Net.my_team()
	var mvp_atraco: bool = _soy_mvp(filas)
	var premio_atraco: Dictionary = Settings.premiar(gane_atraco, 500, 300,
		{"modo": "atraco", "segundos": segundos_partida(),
		"bajas": int(dm_stats.get(mi, {}).get("bajas", 0)),
		"dano": int(Combat.partida_dano), "objetivos": Combat.partida_objetivos, "mvp": mvp_atraco})
	# TRES TABLAS: la tuya primero y luego los otros dos equipos, del que mas puntos lleva al que menos
	var mio_eq := Net.my_team()
	var otros: Array = Net.equipos.filter(func(e): return String(e) != mio_eq)
	otros.sort_custom(func(a, b): return int(puntos_equipo.get(a, 0)) > int(puntos_equipo.get(b, 0)))
	var tablas: Array = []
	for eq in [mio_eq] + otros:
		var col: Color = Net.color_equipo(String(eq))
		# el amarillo, mas oscuro: con la letra blanca encima no se leia
		var claro: Color = col.darkened(0.3) if col.get_luminance() > 0.6 else col
		tablas.append({"equipo": String(eq), "nombre": "TU EQUIPO" if eq == mio_eq else Net.nombre_equipo(String(eq)),
			"tanteo": int(puntos_equipo.get(eq, 0)), "claro": claro, "oscuro": claro.darkened(0.3)})
	var mejor_rival: String = String(otros[0]) if not otros.is_empty() else ""
	var mis_p: int = int(puntos_equipo.get(mio_eq, 0))
	var suyos_p: int = int(puntos_equipo.get(mejor_rival, 0))
	secuencia_fin({"gane": gane_atraco, "mios": mis_p, "rivales": suyos_p, "filas": filas,
		"logros": preload("res://scripts/logros.gd").lista(gane_atraco, mvp_atraco), "premio": premio_atraco,
		"marcador": [mis_p, suyos_p], "equipos": tablas,
		"intro": {"etiqueta_rival": Net.nombre_equipo(mejor_rival) if mejor_rival != "" else "EQUIPO RIVAL"}})


