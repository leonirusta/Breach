## Sondas de frame (sólo benchmark): miden cuánto del frame se va en _process / _physics_process de TODOS los
## nodos (primer y último nodo en procesar) y lo imprimen cada 5 s junto a los tiempos de vxcore y del render.
var _probe_acc := {}
var _probe_n := 0
var _probe_t0 := 0
var _probe_p0 := 0
func _install_frame_probes() -> void:
	var first := Node.new(); first.name = "ProbeFirst"; first.process_priority = -10000; first.process_physics_priority = -10000
	var last := Node.new(); last.name = "ProbeLast"; last.process_priority = 10000; last.process_physics_priority = 10000
	get_tree().root.add_child(first); get_tree().root.add_child(last)
	first.set_process(true); last.set_process(true); first.set_physics_process(true); last.set_physics_process(true)
	first.process_mode = Node.PROCESS_MODE_ALWAYS; last.process_mode = Node.PROCESS_MODE_ALWAYS
	first.tree_exiting.connect(func(): pass)
	# Node no tiene _process en script: usamos señales del árbol + timers manuales vía callables
	get_tree().process_frame.connect(func(): _probe_t0 = Time.get_ticks_usec())
	get_tree().physics_frame.connect(func(): _probe_p0 = Time.get_ticks_usec())
	last.set_script(preload("res://scripts/frame_probe.gd"))
	last.main = self

func _probe_report(key: String, usec: int) -> void:
	_probe_acc[key] = _probe_acc.get(key, 0) + usec
	if key == "process":
		_probe_n += 1
		if _probe_n >= 300:
			var parts: PackedStringArray = []
			for k in _probe_acc.keys():
				parts.append("%s %.2f ms" % [k, _probe_acc[k] / 1000.0 / _probe_n])
			var st: Dictionary = world.get_stats()
			parts.append("host %.2f" % st.get("t_host_ms", 0.0))
			parts.append("static_bodies %d" % st.get("static_bodies", 0))
			parts.append("upd %.2f (enq %.2f col %.2f st %.2f solve %.2f debris %.2f)" % [st.get("t_update_ms", 0.0), st.get("t_upd_enqueue_ms", 0.0), st.get("t_upd_collect_ms", 0.0), st.get("t_upd_stats_ms", 0.0), st.get("t_solve_ms", 0.0), st.get("t_debris_ms", 0.0)])
			parts.append("phys_active %d" % Performance.get_monitor(Performance.PHYSICS_3D_ACTIVE_OBJECTS))
			parts.append("phys_pairs %d" % Performance.get_monitor(Performance.PHYSICS_3D_COLLISION_PAIRS))
			parts.append("render_cpu %.2f" % RenderingServer.viewport_get_measured_render_time_cpu(get_viewport().get_viewport_rid()))
			parts.append("TIME_PROCESS %.2f" % (Performance.get_monitor(Performance.TIME_PROCESS) * 1000.0))
			parts.append("frame %.2f" % (1000.0 / maxf(1.0, Engine.get_frames_per_second())))
			print("[probe] ", " | ".join(parts))
			_probe_acc.clear(); _probe_n = 0

## Recorrido automático de capturas: vista general aérea + varias vistas a pie por el mapa.
## Prueba de esfuerzo automática (`--stress`): recorre el mapa por teletransporte disparando
## cohetes en todas direcciones y graba el CSV. Sirve para medir el peor caso real (destrucción
## + escombros + humo + luces) sin depender de que alguien juegue igual dos veces.
const RocketScene := preload("res://scenes/rocket.tscn")
## Prueba de derrumbe (`--collapse`): el jugador se sube a un edificio, corta los muros que lo
## sostienen (por fuera a ras de suelo y por dentro) y se registra qué le pasa a ÉL: si baja con
## la estructura, si atraviesa el suelo o si se queda flotando. Es lo que no se puede comprobar
## a ojo, porque hay que mirar la Y del jugador frame a frame.
## Comprueba que el láser BORRA de verdad: se coloca frente a una pared, mide su material y
## dispara medio segundo comprobando que el vóxel del punto de impacto pasa a ser aire.
## Comprueba que las piezas desprendidas son SOLIDAS mientras caen: se vuela un muro con cohetes
## y cada segundo se cuenta cuantas piezas tienen cuerpo en el servidor de fisica y si un rayo de
## Jolt las alcanza. Antes las piezas "baratas" eran solo dibujo: se atravesaban.
func _run_bodytest() -> void:
	for i in 60:
		await get_tree().process_frame
	set_quality_manual(2)
	for i in 30:
		await get_tree().process_frame
	var size: Vector3 = world.get_world_size()
	seed(11)
	var eye := Vector3.ZERO
	var dir := Vector3.FORWARD
	var found := false
	for attempt in 800:
		var pp := Vector3(randf_range(size.x * 0.2, size.x * 0.8), 0.0, randf_range(size.z * 0.2, size.z * 0.8))
		var g: Vector3 = world.find_ground(pp)
		if g.y < 0.0:
			continue
		var e: Vector3 = g + Vector3(0, 1.6, 0)
		for k in range(16):
			var ang := TAU * k / 16.0
			var d := Vector3(cos(ang), 0, sin(ang))
			var r: Dictionary = world.raycast(e, d, 14.0)
			if r.hit and e.distance_to(r.position) > 4.0:
				eye = e; dir = d; found = true
				break
		if found:
			break
	if not found:
		print("[bodytest] no encontré un muro adecuado")
		get_tree().quit()
		return
	player.global_position = eye - Vector3(0, 1.6, 0)
	world.set_player_position(player.global_position)
	print("[bodytest] muro a %.1f m; disparando 24 cohetes" % eye.distance_to(world.raycast(eye, dir, 14.0).position))
	for i in 24:
		var rk := preload("res://scenes/rocket.tscn").instantiate() if ResourceLoader.exists("res://scenes/rocket.tscn") else null
		if rk == null:
			world.explode(eye + dir * (6.0 + randf() * 3.0) + Vector3(randf_range(-2, 2), randf_range(-1, 4), randf_range(-2, 2)), 3.5, 255)
		await get_tree().process_frame
	var space := get_world_3d().direct_space_state
	for sec in range(8):
		for f in 60:
			await get_tree().process_frame
		var st: Dictionary = world.get_stats()
		# ¿un rayo de Jolt alcanza alguna pieza que este cayendo?
		var jolt_hits := 0
		for k in range(24):
			var ang2 := TAU * k / 24.0
			var q := PhysicsRayQueryParameters3D.create(eye, eye + Vector3(cos(ang2), -0.2, sin(ang2)) * 14.0)
			q.exclude = [player.get_rid()]
			var h := space.intersect_ray(q)
			if h and h.collider == null:
				jolt_hits += 1
		print("[bodytest] t=%ds  rígidos %d  baratos %d (con colisión %d)  rayos Jolt que tocan escombro suelto %d  fps %d" % [
			sec + 1, st.get("bodies_rigid", 0), st.get("bodies_cheap", 0), st.get("bodies_cheap_solid", 0),
			jolt_hits, Engine.get_frames_per_second()])
	print("[bodytest] FIN")
	get_tree().quit()

func _run_lasertest() -> void:
	for i in 60:
		await get_tree().process_frame
	var size: Vector3 = world.get_world_size()
	var found := false
	seed(5)
	for attempt in 600:
		var p := Vector3(randf_range(size.x * 0.2, size.x * 0.8), 0.0, randf_range(size.z * 0.2, size.z * 0.8))
		var g: Vector3 = world.find_ground(p)
		if g.y < 0.0:
			continue
		var eye: Vector3 = g + Vector3(0, 1.6, 0)
		for k in range(12):
			var ang := TAU * k / 12.0
			var d := Vector3(cos(ang), 0, sin(ang))
			var r: Dictionary = world.raycast(eye, d, 12.0)
			if not r.hit or eye.distance_to(r.position) < 2.0:
				continue
			var mat_before: int = world.get_material_at(r.position + d * 0.05)
			if mat_before <= 0:
				continue
			print("[laser] pared a %.1f m, material %d (%s)" % [eye.distance_to(r.position), mat_before, world.get_material_name(mat_before)])
			# 30 frames de haz continuo, igual que mantener pulsado medio segundo
			for f in 30:
				world.carve_beam(r.position - d * 0.25, d, 1.6, 0.15, 255, true)
				await get_tree().process_frame
			var mat_after: int = world.get_material_at(r.position + d * 0.05)
			var deep: int = world.get_material_at(r.position + d * 0.8)
			print("[laser] tras disparar: material en el impacto %d, a 0,8 m dentro %d" % [mat_after, deep])
			print("[laser] RESULTADO: %s" % ("BORRA la pared" if mat_after == 0 else "NO borra nada"))
			found = true
			break
		if found:
			break
	if not found:
		print("[laser] no encontré una pared para la prueba")
	get_tree().quit()

func _run_collapse() -> void:
	for i in 60:
		await get_tree().process_frame
	set_quality_manual(2)
	for i in 30:
		await get_tree().process_frame
	var size: Vector3 = world.get_world_size()
	var best := Vector3.ZERO
	var best_h := -1.0
	# --collapseat=x,y,z : edificio elegido a mano. Se toma su XZ y se busca el techo justo encima,
	# que es más fiable que buscar "el edificio más alto" a ciegas.
	for f in OS.get_cmdline_user_args():
		if f.begins_with("--collapseat="):
			var pp := f.substr(13).split(",")
			if pp.size() >= 3:
				var at := Vector3(float(pp[0]), float(pp[1]), float(pp[2]))
				var roof: Dictionary = world.raycast(Vector3(at.x, size.y - 1.0, at.z), Vector3.DOWN, size.y)
				if roof.hit:
					best = Vector3(at.x, roof.position.y, at.z)
					best_h = roof.position.y
					print("[collapse] coordenadas dadas (%.1f, %.1f, %.1f) -> techo encima a %.2f m" % [at.x, at.y, at.z, best_h])
	# si no se dieron coordenadas: get_building_centers() solo lo llena la ciudad procedural, así
	# que en un mapa importado se busca por rayos el techo más alto con hueco debajo
	seed(3)
	if best_h > 0.0:
		pass
	else:
		for attempt in 900:
			var x := randf_range(size.x * 0.15, size.x * 0.85)
			var z := randf_range(size.z * 0.15, size.z * 0.85)
			var top: Dictionary = world.raycast(Vector3(x, size.y - 1.0, z), Vector3.DOWN, size.y)
			if not top.hit or top.position.y < 4.0 or top.position.y <= best_h:
				continue
			var under: Dictionary = world.raycast(top.position - Vector3(0, 0.6, 0), Vector3.DOWN, top.position.y)
			if not under.hit or (top.position.y - under.position.y) < 2.0:
				continue
			best_h = top.position.y
			best = Vector3(x, top.position.y, z)
	if best_h < 3.0:
		print("[collapse] no encontré un edificio con altura suficiente (mejor techo a %.1f m)" % best_h)
		get_tree().quit()
		return
	# --inside : el jugador se queda DENTRO, a la altura dada, en vez de en el tejado
	var inside_y := -1.0
	for f2 in OS.get_cmdline_user_args():
		if f2.begins_with("--collapseat=") and ("--inside" in OS.get_cmdline_user_args()):
			var qq := f2.substr(13).split(",")
			if qq.size() >= 3:
				inside_y = float(qq[1])
	# EL JUGADOR VA ARRIBA DEL TODO. Se busca el punto más alto del edificio en 10 m a la redonda:
	# el rayo vertical en la coordenada dada podía caer en una cornisa baja.
	var topy := best_h
	var topxz := Vector2(best.x, best.z)
	for k4 in range(40):
		var a4 := TAU * k4 / 8.0
		var rr := 2.5 * float(1 + k4 / 8)
		var px := best.x + cos(a4) * rr
		var pz := best.z + sin(a4) * rr
		var tp: Dictionary = world.raycast(Vector3(px, size.y - 1.0, pz), Vector3.DOWN, size.y)
		if tp.hit and tp.position.y > topy + 0.2:
			topy = tp.position.y
			topxz = Vector2(px, pz)
	print("[collapse] punto más alto del edificio: %.2f m en (%.1f, %.1f)" % [topy, topxz.x, topxz.y])
	player.global_position = Vector3(topxz.x, topy + 1.2, topxz.y)
	if inside_y > 0.0:
		print("[collapse] (se ignora --inside: el jugador va ARRIBA del edificio, a %.2f m)" % (topy + 1.2))
	player.velocity = Vector3.ZERO
	world.set_player_position(player.global_position)
	for i in 40:
		await get_tree().process_frame
	var y0: float = player.global_position.y
	print("[collapse] tejado a %.2f m; jugador en %.2f" % [best_h, y0])
	for f5 in OS.get_cmdline_user_args():
		if f5.begins_with("--cheapsolid="):
			world.set_cheap_solid_max(int(f5.substr(13)))
			print("[collapse] tope de piezas baratas con colisión = %d" % world.get_cheap_solid_max())
	print("[collapse] piezas ANTES de cortar (control de derrumbes espontáneos): %d" % world.get_body_count())
	hud.start_csv("collapse")
	# ¿Hasta dónde llega este tejado? Se sondea a la altura del techo en 16 direcciones: mientras
	# haya suelo justo debajo, seguimos sobre él. Sin esto el corte se quedaba corto y el techo
	# seguía APOYADO DE VERDAD más allá del área serrada, así que el solver hacía bien en no soltarlo.
	var reach := 2.0
	for k in range(16):
		var ang3 := TAU * k / 16.0
		var dirp := Vector3(cos(ang3), 0, sin(ang3))
		var d := 2.0
		while d < 30.0:
			var probe: Dictionary = world.raycast(best + dirp * d + Vector3(0, 0.8, 0), Vector3.DOWN, 2.0)
			if not probe.hit or absf(probe.position.y - best_h) > 0.6:
				break
			d += 1.0
		reach = maxf(reach, d)
	print("[collapse] el tejado se extiende hasta %.1f m del centro" % reach)
	# CORTE CON LÁSER, no con explosiones: un haz borra en línea recta y atraviesa varias paredes,
	# así que sierra limpio toda la planta bajo el tejado en vez de dejar un cráter esférico.
	# El corte va cerca de la BASE del edificio, no bajo el tejado: así se derrumba entero con el
	# jugador encima, en vez de caer sólo la losa de arriba.
	# find_ground() devuelve la PRIMERA superficie desde arriba, que en un edificio es el tejado.
	# La base real es el voxel sólido más bajo de la columna: se recorre hacia abajo.
	var base_y := best_h
	var yy := best_h
	while yy > 0.2:
		if world.get_material_at(Vector3(best.x, yy, best.z)) > 0:
			base_y = yy
		yy -= 0.2
	var cut_h := 3.0
	for f6 in OS.get_cmdline_user_args():
		if f6.begins_with("--cuth="):
			cut_h = float(f6.substr(7))
	var cut_y: float = base_y + cut_h
	print("[collapse] corte a %.2f m (base del edificio a %.2f, techo a %.2f)" % [cut_y, base_y, best_h])
	# El alcance del tejado NO sirve para dimensionar el corte: los muros que lo sostienen pueden
	# estar más afuera. Se mide la planta A LA ALTURA DEL CORTE, buscando hasta dónde hay materia.
	var span := 4.0
	for k2 in range(24):
		var ang4 := TAU * k2 / 24.0
		var dp := Vector3(cos(ang4), 0, sin(ang4))
		var far := 0.0
		var dd := 1.0
		while dd < 45.0:
			if world.get_material_at(best + dp * dd + Vector3(0, cut_y - best.y, 0)) > 0:
				far = dd
			dd += 0.5
		span = maxf(span, far)
	span = minf(span + 4.0, 45.0)
	for fs in OS.get_cmdline_user_args():
		if fs.begins_with("--span="):
			span = float(fs.substr(7))
	# PASADAS SOLAPADAS. Antes iban cada 1,0 m con radio 0,35: entre haz y haz quedaban puentes de
	# 0,3 m de material sin cortar y el edificio seguía colgado de ellos ("faltaron paredes que cortar").
	# Con paso 0,6 m y radio 0,4 los tubos se solapan y la ranura es continua.
	const CUT_R := 0.4
	const CUT_STEP := 0.6
	var ncuts := 0
	var npass := int(span / CUT_STEP)
	# --bridge : deja A PROPOSITO un puente de ~0,2 m (2-3 voxels) sin cortar en el centro del plano.
	# Es la prueba del jugador: "un solo voxel no puede sostener un edificio de toneladas".
	var bridge := "--bridge" in OS.get_cmdline_user_args()
	var BR := 0.10   # medio ancho del puente
	for fb in OS.get_cmdline_user_args():
		if fb.begins_with("--br="):
			BR = float(fb.substr(5))
		elif fb.begins_with("--buckling="):
			world.set_struct_param("buckling_min", float(fb.substr(11)))
			print("[collapse] buckling_min = %.2f" % world.get_struct_param("buckling_min"))
	# El puente hay que dejarlo DONDE HAY MATERIAL: el centro del edificio a esa altura suele ser
	# aire (una habitacion). Se busca el punto con material mas cercano al centro.
	var bx := 0.0
	var bz := 0.0
	if bridge:
		var bestd := 1e9
		for i2 in range(-npass, npass + 1):
			for j2 in range(-npass, npass + 1):
				var ox := float(i2) * CUT_STEP
				var oz := float(j2) * CUT_STEP
				var dd2 := ox * ox + oz * oz
				if dd2 >= bestd:
					continue
				if world.get_material_at(Vector3(best.x + ox, cut_y, best.z + oz)) > 0:
					bestd = dd2
					bx = ox
					bz = oz
		print("[collapse] puente elegido en offset (%.1f, %.1f) del centro" % [bx, bz])
	for i in range(-npass, npass + 1):
		var off := float(i) * CUT_STEP
		if bridge and (absf(off - bz) < CUT_STEP * 0.5 or absf(off - bx) < CUT_STEP * 0.5):
			# esta pasada rozaria el puente: se parte en dos tramos y se deja el hueco
			# pasada en X que roza la fila del puente: se parte dejando el hueco en x = bx
			if absf(off - bz) < CUT_STEP * 0.5:
				world.carve_beam(Vector3(best.x - span, cut_y, best.z + off), Vector3.RIGHT, span + bx - BR - CUT_R, CUT_R, 255, true)
				world.carve_beam(Vector3(best.x + bx + BR + CUT_R, cut_y, best.z + off), Vector3.RIGHT, span - bx - BR - CUT_R, CUT_R, 255, true)
			else:
				world.carve_beam(Vector3(best.x - span, cut_y, best.z + off), Vector3.RIGHT, span * 2.0, CUT_R, 255, true)
			# pasada en Z que roza la columna del puente: hueco en z = bz
			if absf(off - bx) < CUT_STEP * 0.5:
				world.carve_beam(Vector3(best.x + off, cut_y, best.z - span), Vector3.BACK, span + bz - BR - CUT_R, CUT_R, 255, true)
				world.carve_beam(Vector3(best.x + off, cut_y, best.z + bz + BR + CUT_R), Vector3.BACK, span - bz - BR - CUT_R, CUT_R, 255, true)
			else:
				world.carve_beam(Vector3(best.x + off, cut_y, best.z - span), Vector3.BACK, span * 2.0, CUT_R, 255, true)
			ncuts += 4
		else:
			world.carve_beam(Vector3(best.x - span, cut_y, best.z + off), Vector3.RIGHT, span * 2.0, CUT_R, 255, true)
			world.carve_beam(Vector3(best.x + off, cut_y, best.z - span), Vector3.BACK, span * 2.0, CUT_R, 255, true)
			ncuts += 2
		if (i % 4) == 0:
			await get_tree().process_frame
	if bridge:
		var nleft := 0
		for a in range(-4, 5):
			for b in range(-4, 5):
				if world.get_material_at(Vector3(best.x + bx + a * 0.05, cut_y, best.z + bz + b * 0.05)) > 0:
					nleft += 1
		print("[collapse] PUENTE dejado a proposito: %d muestras con material en el centro del corte" % nleft)
	print("[collapse] %d pasadas de láser en la losa (planta medida a la altura del corte: %.1f m)" % [ncuts, span])
	# Verificación del corte: ¿queda materia en el plano cortado?
	var leftovers := 0
	for i in range(-npass, npass + 1):
		for j in range(-npass, npass + 1):
			if world.get_material_at(Vector3(best.x + i * CUT_STEP, cut_y, best.z + j * CUT_STEP)) > 0:
				leftovers += 1
	print("[collapse] puntos con material en el plano de corte tras serrar: %d" % leftovers)
	print("[collapse] muros cortados; observando 6 s")
	var ymin := y0
	var fell_through := false
	var t := 0.0
	var space_state := get_world_3d().direct_space_state
	for i in 360:
		await get_tree().process_frame
		t += get_process_delta_time()
		var y: float = player.global_position.y
		ymin = minf(ymin, y)
		if y < -3.0:
			fell_through = true
		if (i % 60) == 0:
			var st: Dictionary = world.get_stats()
			print("[collapse] t=%.1fs  jugador y=%.2f (bajó %.2f)  suelo=%s  rígidos %d  baratos %d (sólidos %d)  fps %d" % [
				t, y, y0 - y, str(player.is_on_floor()), st.get("bodies_rigid", 0), st.get("bodies_cheap", 0),
				st.get("bodies_cheap_solid", 0), Engine.get_frames_per_second()])
			print("[collapse]   piezas creadas: rígidas %d, baratas con colisión %d, baratas fantasma %d, revoxelizadas al instante %d" % [
				st.get("spawn_rigid", 0), st.get("spawn_cheap_solid", 0), st.get("spawn_cheap_ghost", 0), st.get("spawn_instant", 0)])
			print("[collapse]   piezas retiradas: devueltas al mundo %d, congeladas por edad %d, caídas al vacío %d, deshechas a tiros %d | regulador cascotes %.2f" % [
				st.get("removed_revox", 0), st.get("removed_age", 0), st.get("removed_void", 0), st.get("removed_carve", 0), st.get("clump_scale", 1.0)])
			print("[collapse]   estructura: %s it %d celdas %d islas %d fallos %d fragmentos %d peor ratio %.2f  %.1f ms/it" % [
				"ACTIVA" if st.get("struct_active", 0) > 0 else "dormida", st.get("struct_iterations", 0),
				st.get("struct_cells", 0), st.get("struct_islands", 0), st.get("struct_failures", 0),
				st.get("groups_structural", 0), st.get("struct_worst_ratio", 0.0), st.get("t_struct_ms", 0.0)])
			# ¿Las piezas que caen son sólidas de verdad? Un rayo de Jolt desde el jugador hacia cada
			# pieza debe devolver SU cuerpo: si no, las balas la atraviesan y el jugador también.
			var bl: Array = world.get_bodies_debug()
			var reach_ok := 0
			var reach_no := 0
			for bd in bl:
				var bp: Vector3 = bd["pos"]
				# rayo CORTO desde justo fuera de la pieza hacia su centro: nada puede taparlo salvo
				# otra pieza, así que mide la solidez de la pieza y no la línea de visión
				var sz: Vector3 = bd["size"]
				var out_d: float = 0.05 * maxf(sz.x, maxf(sz.y, sz.z)) + 0.8
				var qq := PhysicsRayQueryParameters3D.create(bp + Vector3(0, out_d, 0), bp)
				qq.exclude = [player.get_rid()]
				var hh := space_state.intersect_ray(qq)
				if hh and hh.has("rid") and hh["rid"] == bd["rid"]:
					reach_ok += 1
				else:
					reach_no += 1
			if bl.size() > 0:
				print("[collapse]   piezas vivas %d: alcanzables por rayo de bala %d, fantasma para el rayo %d" % [bl.size(), reach_ok, reach_no])
	hud.stop_csv()
	print("[collapse] FIN: jugador bajó %.2f m (de %.2f a %.2f). ¿Atravesó el mundo? %s" % [
		y0 - player.global_position.y, y0, player.global_position.y, "SÍ" if fell_through else "no"])
	get_tree().quit()

func _run_stress() -> void:
	for i in 60:
		await get_tree().process_frame
	set_quality_manual(2)                     # ALTA: es el objetivo a sostener
	for i in 30:
		await get_tree().process_frame
	var size: Vector3 = world.get_world_size()
	var pts: Array = []
	for s in world.get_spawn_points():
		pts.append(s)
	seed(11)
	while pts.size() < 8:
		pts.append(_random_ground_point())
	hud.start_csv("stress")
	var fps_min := 999
	var fps_sum := 0
	var fps_n := 0
	var shots := 0
	for k in range(mini(8, pts.size())):
		var p: Vector3 = pts[k]
		player.global_position = p + Vector3(0, 0.6, 0)
		player.velocity = Vector3.ZERO
		world.set_player_position(p)
		for i in 20:
			await get_tree().process_frame
		# 6 cohetes en abanico desde cada punto: destrucción por todos lados
		for a in 6:
			var ang := TAU * float(a) / 6.0 + float(k) * 0.4
			var dir := Vector3(cos(ang), 0.06, sin(ang)).normalized()
			player.look_at_point(p + Vector3(0, 1.6, 0) + dir * 10.0)
			var rk := RocketScene.instantiate()
			add_child(rk)
			rk.global_position = p + Vector3(0, 1.6, 0) + dir * 0.8
			rk.setup(world, dir, player, 4.0, 255, 0.0)
			shots += 1
			for i in 22:
				await get_tree().process_frame
				var f := Engine.get_frames_per_second()
				if f > 0:
					fps_min = mini(fps_min, f); fps_sum += f; fps_n += 1
		# lluvia de misiles: caen del cielo alrededor del punto, para castigar tejados y calles
		for a in 5:
			var off := Vector3(randf_range(-14.0, 14.0), 0.0, randf_range(-14.0, 14.0))
			var rk2 := RocketScene.instantiate()
			add_child(rk2)
			rk2.global_position = p + off + Vector3(0, 34.0, 0)
			rk2.setup(world, Vector3(randf_range(-0.12, 0.12), -1.0, randf_range(-0.12, 0.12)).normalized(), player, 4.0, 255, 0.0)
			shots += 1
			for i in 10:
				await get_tree().process_frame
				var f2 := Engine.get_frames_per_second()
				if f2 > 0:
					fps_min = mini(fps_min, f2); fps_sum += f2; fps_n += 1
		var s2: Dictionary = world.get_stats()
		print("[stress] punto %d/%d cohetes %d fps %d (min %d) | host %.1f ms = upload %.1f blocks %.1f regions %.1f phys %.1f spawn %.1f bodies %.1f debris %.1f | cuerpos %d escombros %d" % [
			k + 1, mini(8, pts.size()), shots, Engine.get_frames_per_second(), fps_min,
			s2.get("t_host_ms", 0.0), s2.get("t_h_upload", 0.0), s2.get("t_h_blocks", 0.0), s2.get("t_h_regions", 0.0),
			s2.get("t_h_phys", 0.0), s2.get("t_h_spawn", 0.0), s2.get("t_h_bodies", 0.0), s2.get("t_h_debris", 0.0),
			s2.get("bodies_active", 0), s2.get("debris_active", 0)])
	hud.stop_csv()
	var st: Dictionary = world.get_stats()
	print("[stress] FIN: %d cohetes | fps min %d, medio %.1f | cuerpos %d, escombros %d" % [
		shots, fps_min, float(fps_sum) / maxf(1.0, float(fps_n)), st.get("bodies_active", 0), st.get("debris_active", 0)])
	get_tree().quit()

func _run_tour() -> void:
	for i in 30:
		await get_tree().process_frame
	var size: Vector3 = world.get_world_size()
	var cam: Camera3D = player.get_node("Head/Camera3D")
	var shots: Array = []
	# 1) aérea diagonal
	shots.append([Vector3(size.x * 0.5, size.y * 0.9 + 20.0, size.z * 1.05), Vector3(size.x * 0.5, 0.0, size.z * 0.45)])
	# 2) aérea desde la esquina opuesta
	shots.append([Vector3(size.x * -0.05, size.y * 0.7 + 12.0, size.z * -0.05), Vector3(size.x * 0.5, 0.0, size.z * 0.5)])
	# 3..6) a pie: puntos de spawn y de suelo aleatorios
	var spawns: PackedVector3Array = world.get_spawn_points()
	var ground_pts: Array = []
	for s in spawns:
		ground_pts.append(s)
	seed(7)
	while ground_pts.size() < 6:
		ground_pts.append(_random_ground_point())
	for k in range(mini(4, ground_pts.size())):
		var p: Vector3 = ground_pts[k]
		var look := Vector3(size.x * 0.5, p.y + 2.0, size.z * 0.5)
		shots.append([p + Vector3(0, 1.7, 0), look])
	# 7) interior: un punto de suelo con techo a menos de 4 m (túnel / pasillo cubierto)
	for attempt in 400:
		var q := Vector3(randf_range(size.x * 0.1, size.x * 0.9), 0.0, randf_range(size.z * 0.1, size.z * 0.9))
		var g: Vector3 = world.find_ground(q)
		if g.y < 0.0:
			continue
		var up: Dictionary = world.raycast(g + Vector3(0, 0.3, 0), Vector3.UP, 4.0)
		var clear: Dictionary = world.raycast(g + Vector3(0, 0.3, 0), Vector3.UP, 2.0)
		if up.hit and not clear.hit:
			# mirar hacia donde el pasillo está más despejado
			var best_dir := Vector3.FORWARD
			var best_d := 0.0
			for a in 12:
				var d := Vector3(cos(a * TAU / 12.0), 0, sin(a * TAU / 12.0))
				var rr: Dictionary = world.raycast(g + Vector3(0, 1.5, 0), d, 40.0)
				var dist: float = rr.distance if rr.hit else 40.0
				if dist > best_d:
					best_d = dist
					best_dir = d
			shots.append([g + Vector3(0, 1.6, 0), g + Vector3(0, 1.4, 0) + best_dir * 8.0])
			break
	var n := 0
	for s in shots:
		var eye: Vector3 = s[0]
		player.global_position = eye - Vector3(0, 1.6, 0)
		player.look_at_point(s[1])
		world.set_player_position(eye)
		for i in 25:
			await get_tree().process_frame
		var img := get_viewport().get_texture().get_image()
		var path := "user://tour_%d.png" % n
		img.save_png(path)
		print("[Breach] tour %d guardada en %s (FPS %d)" % [n, ProjectSettings.globalize_path(path), Engine.get_frames_per_second()])
		n += 1
	# última: destrucción real en el mapa. Cohete contra lo que haya delante y captura a los 0,6 s.
	var fwd: Vector3 = -cam.global_transform.basis.z
	var r: Dictionary = world.raycast(cam.global_position, fwd, 60.0)
	if r.hit:
		world.explode(r.position - fwd * 0.3, 3.5, 255)
		for i in 36:
			await get_tree().process_frame
		var img2 := get_viewport().get_texture().get_image()
		img2.save_png("user://tour_%d.png" % n)
		var st: Dictionary = world.get_stats()
		print("[Breach] tour %d (explosión): destruidos %d, cuerpos %d, escombros %d, FPS %d" % [n, int(st.get("voxels_destroyed", 0)), st.get("bodies_active", 0), st.get("debris_active", 0), Engine.get_frames_per_second()])
	get_tree().quit()

# ---------------------------------------------------------------------------
# Sitios de bomba (tipo CS2): los bots defienden dos zonas del mapa con puestos de guardia alrededor.
# Coordenadas por mapa en res://maps/<mapa>.sites.json ({"sites": [[x,y,z], ...], "radius": 12}); si no
# existe, se eligen dos puntos de suelo lejos entre sí y del spawn del jugador.
# ---------------------------------------------------------------------------
var bomb_sites: Array = []      # [{"pos": Vector3, "posts": [Vector3...]}]

# --- faroles del mapa ---
# El horneador descarta las entidades <light> de Teardown, así que los mapas no traen ninguna
# fuente de luz: los faroles brillan (el shader les pone EMISSION) pero no iluminan.
# res://maps/<mapa>.lights.json las repone. Se generan con dos herramientas:
#   extract_xml_lights.py  - del XML original del mod (color, intensidad y tag "night" reales)
#   extract_map_lights.py  - de los voxels emisivos del .vxmap, si no está el mod original
# Aquí se encienden sólo las más cercanas al jugador.
var _lamp_pos: PackedVector3Array = PackedVector3Array()
var _lamp_col: Array[Color] = []
var _lamp_energy: PackedFloat32Array = PackedFloat32Array()
var _lamp_range: PackedFloat32Array = PackedFloat32Array()
## FAROLES QUE ALUMBRAN COMO UNA LINTERNA. Si la luz del mapa trae "dir" (hacia donde apunta) y "cono"
## (medio angulo en grados), se crea un FOCO en vez de una bombilla: se ve el haz y el charco de luz en
## el suelo, que es lo que hace una farola de verdad. Sin esos datos se queda la bombilla de siempre,
## asi que los mapas viejos no cambian.
var _lamp_dir: PackedVector3Array = PackedVector3Array()
var _lamp_cono: PackedFloat32Array = PackedFloat32Array()
## A QUE DISTANCIA TIENE CADA FAROL SU LAMPARA, medido al crearlo. Ver _radio_farol y _kill_lamps_near.
var _lamp_probe: PackedFloat32Array = PackedFloat32Array()
var _lamp_pool: Array[Light3D] = []
const LAMP_PER_FRAME := 6     # se crean poco a poco: 205 de golpe daban un tirón al cargar
# Existen todas, pero el renderizador sólo paga por las cercanas: más allá de LAMP_FADE se
# desvanecen y dejan de costar. Es mejor que apagarlas por distancia a mano, porque el
# desvanecido evita el "pop" de que aparezcan de golpe al acercarte.
# El alcance depende de la calidad: medido con el perfilador, el juego va limitado por GPU
# (15.4 ms de GPU frente a 3.4 de CPU), así que las luces se pagan en el lado caro.
const LAMP_FADE := [12.0, 18.0, 24.0, 30.0]        # LOW, MEDIUM, HIGH, ULTRA
const LAMP_FADE_LEN := [6.0, 9.0, 13.0, 18.0]
var _lamp_next := 0
var _lamp_dead: PackedByteArray = PackedByteArray()

func _load_lamps() -> void:
	_lamp_pos = PackedVector3Array()
	_lamp_col = []
	_lamp_energy = PackedFloat32Array()
	_lamp_range = PackedFloat32Array()
	_lamp_dir = PackedVector3Array()
	_lamp_cono = PackedFloat32Array()
	var f := FileAccess.open("res://maps/%s.lights.json" % current_map, FileAccess.READ)
	if f == null:
		return
	var d = JSON.parse_string(f.get_as_text())
	if typeof(d) != TYPE_DICTIONARY:
		return
	for l in d.get("lights", []):
		var p: Array = l.get("pos", [])
		var c: Array = l.get("color", [1, 1, 1])
		if p.size() < 3:
			continue
		_lamp_pos.append(Vector3(float(p[0]), float(p[1]), float(p[2])))
		_lamp_col.append(Color(float(c[0]), float(c[1]), float(c[2])))
		_lamp_energy.append(float(l.get("energy", 2.0)))
		_lamp_range.append(float(l.get("range", 10.0)))
		var dv: Array = l.get("dir", [])
		var dir := Vector3.ZERO
		if dv.size() >= 3:
			dir = Vector3(float(dv[0]), float(dv[1]), float(dv[2]))
			dir = dir.normalized() if dir.length_squared() > 1e-6 else Vector3.ZERO
		_lamp_dir.append(dir)
		_lamp_cono.append(clampf(float(l.get("cono", 35.0)), 5.0, 89.0))
	_spawn_lamps()
	print("[luces] %s: %d faroles (%s)" % [current_map, _lamp_pos.size(), d.get("source", "?")])

## Se crean TODAS las luces del mapa, pero repartidas en varios frames: de golpe (205 en dust2)
## daban un tirón al cargar. Godot ya descarta por frustum y por alcance las que no se ven, así
## que el coste real lo fija lo que hay en pantalla, no cuántas existan.
## Sin sombras dinámicas: en móvil cada sombra cuesta más que la propia luz.
func _spawn_lamps() -> void:
	for o in _lamp_pool:
		o.queue_free()
	_lamp_pool.clear()
	_lamp_next = 0
	_lamp_dead = PackedByteArray()
	_lamp_dead.resize(_lamp_pos.size())
	_lamp_probe = PackedFloat32Array()
	_lamp_probe.resize(_lamp_pos.size())

func _tick_lamps() -> void:
	if _lamp_next >= _lamp_pos.size():
		return
	var stop: int = mini(_lamp_next + LAMP_PER_FRAME, _lamp_pos.size())
	while _lamp_next < stop:
		var dir: Vector3 = _lamp_dir[_lamp_next] if _lamp_next < _lamp_dir.size() else Vector3.ZERO
		var o: Light3D
		if dir == Vector3.ZERO:
			var om := OmniLight3D.new()
			om.omni_range = _lamp_range[_lamp_next]
			o = om
		else:
			# FOCO: el haz sale por el -Z del nodo, asi que se apunta con look_at. La atenuacion del
			# borde va suave para que se vea el cono y no un recorte de cartulina.
			var sp := SpotLight3D.new()
			sp.spot_range = _lamp_range[_lamp_next]
			sp.spot_angle = _lamp_cono[_lamp_next]
			sp.spot_angle_attenuation = 0.8
			sp.spot_attenuation = 1.2
			o = sp
		o.shadow_enabled = false
		o.light_bake_mode = Light3D.BAKE_DISABLED
		o.light_color = _lamp_col[_lamp_next]
		o.light_energy = _lamp_energy[_lamp_next]
		o.distance_fade_enabled = true
		o.distance_fade_begin = LAMP_FADE[clampi(quality, 0, 3)]
		o.distance_fade_length = LAMP_FADE_LEN[clampi(quality, 0, 3)]
		# EN LA CAMPAÑA LAS FAROLAS SE VEN DE LEJOS (pedido: "no se ve nada"): es noche cerrada y son lo unico
		# que alumbra la calle; apagarlas a 12-18 m dejaba la calle en negro a partir de la farola siguiente
		if FileAccess.file_exists("res://maps/%s.campana.json" % current_map):
			o.distance_fade_begin = maxf(o.distance_fade_begin, 40.0)
			o.distance_fade_length = maxf(o.distance_fade_length, 15.0)
		o.visible = night or _faroles_tarde
		# (calibrar las cocinadas: --lucessinesp quita el especular de los faroles y --lucessinfade su desvanecido)
		if "--lucessinesp" in OS.get_cmdline_user_args():
			o.light_specular = 0.0
		if "--lucessinfade" in OS.get_cmdline_user_args():
			o.distance_fade_enabled = false
		add_child(o)
		o.global_position = _lamp_pos[_lamp_next]
		if dir != Vector3.ZERO:
			# apuntando recto abajo, la vertical no sirve de referencia y look_at se queja
			var arriba: Vector3 = Vector3.UP if absf(dir.dot(Vector3.UP)) < 0.95 else Vector3.FORWARD
			o.look_at(o.global_position + dir, arriba)
		_lamp_probe[_lamp_next] = _radio_farol(_lamp_pos[_lamp_next])
		_lamp_pool.append(o)
		_lamp_next += 1
	if _lamp_next >= _lamp_pos.size():
		_cocinar_lamparas()


## DONDE ESTA LA LAMPARA DE ESTE FAROL. Se mide una sola vez, al crearlo, probando cajas cada vez mas
## grandes alrededor de la bombilla. Hace falta porque la bombilla no esta dentro de la lampara: el
## generador la saca justo por delante del cristal, y ademas hay bombillas colgando de un cable que no
## tienen nada solido hasta un metro. Guardando el radio de CADA UNA se puede apagar la luz cuando
## desaparece SU lampara, en vez de mirar siempre a 0,7 m y encontrar la pared o el techo de detras
## (ese era el fallo: volabas el farol de la pared y la luz seguia encendida).
func _radio_farol(p: Vector3) -> float:
	if world == null:
		return 0.7
	for r in [0.35, 0.7, 1.0]:
		var h := Vector3(r, r, r)
		if world.box_solid(p - h, p + h):
			return r
	return 1.0

## Si vuelan el farol, su luz se apaga. Los OmniLight3D son nodos aparte de los voxels, así que
## sin esto podías destrozar la lámpara y seguía alumbrando. Se comprueba sólo donde hubo un
## impacto, no cada frame.
func _kill_lamps_near(pos: Vector3, radius: float) -> void:
	if _lamp_pool.is_empty() or _lamp_next < _lamp_pos.size():
		return   # sin farolas creadas todavía: nada que apagar
	var r2: float = (radius + 1.5) * (radius + 1.5)
	for i in _lamp_pool.size():
		if _lamp_dead[i] != 0:
			continue
		var p: Vector3 = _lamp_pos[i]
		if p.distance_squared_to(pos) > r2:
			continue
		var rr: float = _lamp_probe[i] if i < _lamp_probe.size() and _lamp_probe[i] > 0.01 else 0.7
		var h := Vector3(rr, rr, rr)
		# SE APAGA de dos maneras: porque su lampara ya no esta, o porque lo que ha reventado ha sido AHI
		# MISMO. Hace falta la segunda: una bombilla colgada de un cable no tiene nada solido cerca que
		# mirar, y el muro que tiene enfrente aguanta la explosion, asi que con la primera regla sola se
		# quedaba encendida flotando en el aire. 45 cm para un balazo, un metro para una explosion.
		var cerca: float = maxf(radius * 0.4, 0.45)
		if p.distance_to(pos) <= cerca or not world.box_solid(p - h, p + h):
			_lamp_dead[i] = 1
			_lamp_pool[i].visible = false
			_lamparas_estado()

## Reajusta el alcance de las luces ya creadas cuando cambia la calidad gráfica.
func _refresh_lamp_fade() -> void:
	# EL AJUSTE DEL JUGADOR MANDA SOBRE EL PRESET. El alcance salia solo de la calidad, asi que en un
	# mapa con 240 faroles (Monaco) no habia forma de apagar los lejanos sin bajar TODO lo demas.
	# "Off" apaga los faroles del mapa del todo: en Monaco son 240 y en gama baja se nota.
	var niv: int = clampi(Settings.gfx_value("light_distance", quality), 0, 5)
	var k: float = [0.0, 0.35, 0.6, 1.0, 1.4, 2.0][niv]
	if niv == 0:
		_show_lamps(false)
		return
	_show_lamps(night)    # sin pisar el dia/noche: de dia los faroles siguen apagados
	var b: float = LAMP_FADE[clampi(quality, 0, 3)] * k
	var l: float = LAMP_FADE_LEN[clampi(quality, 0, 3)] * k
	for o in _lamp_pool:
		o.distance_fade_begin = b
		o.distance_fade_length = l
	_lamparas_estado()

func _show_lamps(on: bool) -> void:
	_lamps_on = on
	for i in _lamp_pool.size():
		_lamp_pool[i].visible = on and _lamp_dead[i] == 0 and not _lamp_tapada(i)
	_lamparas_estado()


# ---------------------------------------------------------------------------
# LAS FAROLAS COCINADAS (2026-10-01, pedido: "cocina las luces de farolas y bombillas... es fija"). Ver
# shaders/lamparas.gdshaderinc. Una vez creados todos los faroles, sus datos (sacados de cada Light3D tal cual: color
# pasado a lineal como hace Godot, energia, alcance, decaimiento, cono) van a una textura y, por cada parcela de
# LAMP_CELDA m del mapa, la lista de los que la alcanzan a otra. El sombreado del mundo las evalua solo donde tocan, y
# las Light3D dejan de alumbrar la capa del mundo (CAPA_MUNDO, la 11: voxel_world.cpp) pero siguen con personajes,
# armas y objetos. Romper una farola la apaga tambien aqui (`_lamparas_estado`). A/B: --sinlucescocinadas.
# ---------------------------------------------------------------------------
const CAPA_MUNDO_BIT := 1 << 10
const LAMP_CELDA := 4.0
const LAMP_POR_CELDA := 16
## EL VOLUMEN (lamparas.gdshaderinc): celdas de 1 m; lo que esta a menos de LAMP_R1 de un farol lo hace el sombreado exacto
const LAMP_VOL_CELDA := 1.0
const LAMP_R0 := 0.6
const LAMP_R1 := 2.5
const LAMP_R1_MAX := 6.0
const LAMP_CELDA_CERCA := 1.0             ## las parcelas de la lista de la parte cercana (finas: solo los que tienes encima)
const LAMP_VOL_MAX_CELDAS := 4000000      ## (10 bytes por celda: 40 MB) mas grande, sin volumen: todo exacto
static var _sin_volumen_luces: bool = "--sinvolumenluces" in OS.get_cmdline_user_args()
var _lamp_vol_a: ImageTexture3D = null
var _lamp_vol_b: ImageTexture3D = null
var _lamp_vol_c: ImageTexture3D = null
var _lamp_vol_d: ImageTexture3D = null
var _lamp_vol_dims := Vector3i.ZERO
var _lamp_muertas_horneadas := -1
var _lamp_cocinadas := false
var _lamp_img: Image = null
var _lamp_tex: ImageTexture = null
var _lamp_rej_tex: ImageTexture = null
static var _sin_lamp_cocinadas: bool = "--sinlucescocinadas" in OS.get_cmdline_user_args()
## lo que Godot multiplica a la energia de una omni/foco (la difusa de Lambert lleva 1/pi): calibrado con --lucescalibrar
var lamp_k := PI

## EN UN HILO (2026-10-01): hornear en el hilo principal eran 62-477 ms de parón al empezar la partida (Monaco 477, nuke
## 372: el volumen y las listas) y otros 35-400 cada vez que se rompia un farol. Ahora el hilo principal solo lee los
## Light3D, y un WorkerThreadPool hace las listas, las imagenes y el volumen (`_cocinar_en_hilo`, `_volumen_en_hilo`);
## al acabar, `_lamp_tarea_tick` sube las texturas y cambia las Light3D en el MISMO fotograma (antes de eso las luces
## de Godot siguen alumbrando el mundo: nunca falta ni sobra luz). Mientras se rehornea tras romper un farol, su parte
## cercana ya esta apagada (exacta) y el volumen viejo sigue unas decimas.
var _lamp_tarea := -1
var _lamp_tarea_res: Dictionary = {}
var _lamp_rehornear := false

func _cocinar_lamparas() -> void:
	if _lamp_cocinadas or _lamp_tarea >= 0 or _sin_lamp_cocinadas or world == null or _lamp_pool.is_empty() or _lamp_pool.size() > 255:
		return
	if not (world.opaque_material is ShaderMaterial):
		return
	var t0 := Time.get_ticks_usec()
	# lo que hay que leer de los Light3D (solo en el hilo principal)
	var lam: Array = []
	var borde_directo: bool = "--lucesbordedirecto" in OS.get_cmdline_user_args()
	for o in _lamp_pool:
		var l := o as Light3D
		var p: Vector3 = l.global_position
		var alcance := 10.0
		var decae := 1.0
		var cono := -2.0
		var borde := 1.0
		var dir := Vector3.ZERO
		if l is SpotLight3D:
			var sp := l as SpotLight3D
			alcance = sp.spot_range
			decae = sp.spot_attenuation
			cono = cos(deg_to_rad(sp.spot_angle))
			# (el renderizador de Godot usa el INVERSO de spot_angle_attenuation: comprobado foto contra foto con
			# --lucescalibrar; con el exponente tal cual, el charco del foco salia un 5-11 % mas oscuro)
			borde = 1.0 / maxf(sp.spot_angle_attenuation, 0.01) if not borde_directo else sp.spot_angle_attenuation
			dir = -sp.global_transform.basis.z.normalized()
		elif l is OmniLight3D:
			alcance = (l as OmniLight3D).omni_range
			decae = (l as OmniLight3D).omni_attenuation
		var col: Color = l.light_color.srgb_to_linear()
		lam.append([p, alcance, decae, cono, borde, dir, col, l.light_energy, l.light_specular])
	var muertas: PackedByteArray = _lamp_dead.duplicate()
	var tam: Vector3 = world.get_world_size()
	var k := lamp_k
	_lamp_tarea_res = {}
	_lamp_tarea = WorkerThreadPool.add_task(func() -> void:
		_lamp_tarea_res = _cocinar_en_hilo(lam, muertas, tam, k), false, "luces cocinadas")
	print("[luces] %d faroles leidos en %d ms; se cocinan en un hilo" % [lam.size(), (Time.get_ticks_usec() - t0) / 1000])


## La parte del hilo: los datos de cada farol, las listas por parcela y el volumen. No toca el arbol ni el mundo.
func _cocinar_en_hilo(lam: Array, muertas: PackedByteArray, tam: Vector3, k: float) -> Dictionary:
	var t0 := Time.get_ticks_usec()
	var n := lam.size()
	var img := Image.create(n, 4, false, Image.FORMAT_RGBAF)
	var cx: int = maxi(1, int(ceil(tam.x / LAMP_CELDA)))
	var cz: int = maxi(1, int(ceil(tam.z / LAMP_CELDA)))
	var listas: Array = []
	listas.resize(cx * cz)
	var r1_max := LAMP_R1
	var ccx: int = maxi(1, int(ceil(tam.x / LAMP_CELDA_CERCA)))
	var ccz: int = maxi(1, int(ceil(tam.z / LAMP_CELDA_CERCA)))
	var cercas: Array = []
	cercas.resize(ccx * ccz)
	for i in n:
		var d: Array = lam[i]
		var p: Vector3 = d[0]
		var alcance: float = d[1]
		var decae: float = d[2]
		var cono: float = d[3]
		var borde: float = d[4]
		var dir: Vector3 = d[5]
		var col: Color = d[6]
		var e: float = d[7]
		img.set_pixel(i, 0, Color(p.x, p.y, p.z, 1.0 / maxf(alcance, 0.01)))
		img.set_pixel(i, 1, Color(col.r * e, col.g * e, col.b * e, decae))
		img.set_pixel(i, 2, Color(dir.x, dir.y, dir.z, cono))
		# el radio de su parte cercana (exacta): el 25 % del alcance, entre LAMP_R1 y LAMP_R1_MAX
		var r1_l: float = clampf(alcance * 0.25, LAMP_R1, LAMP_R1_MAX)
		r1_max = maxf(r1_max, r1_l)
		img.set_pixel(i, 3, Color(borde, 1.0, float(d[8]) * 2.0, r1_l))
		# las parcelas que alcanza (en planta: un farol de un piso de arriba cuenta tambien, la distancia ya lo apaga)
		# la parte cercana: las parcelas finas a menos de su radio cercano
		var cx0: int = clampi(int(floor((p.x - r1_l) / LAMP_CELDA_CERCA)), 0, ccx - 1)
		var cx1: int = clampi(int(floor((p.x + r1_l) / LAMP_CELDA_CERCA)), 0, ccx - 1)
		var cz0: int = clampi(int(floor((p.z - r1_l) / LAMP_CELDA_CERCA)), 0, ccz - 1)
		var cz1: int = clampi(int(floor((p.z + r1_l) / LAMP_CELDA_CERCA)), 0, ccz - 1)
		for zz in range(cz0, cz1 + 1):
			for xx in range(cx0, cx1 + 1):
				var qx2: float = clampf(p.x, xx * LAMP_CELDA_CERCA, (xx + 1) * LAMP_CELDA_CERCA)
				var qz2: float = clampf(p.z, zz * LAMP_CELDA_CERCA, (zz + 1) * LAMP_CELDA_CERCA)
				var dd2: float = Vector2(p.x - qx2, p.z - qz2).length()
				if dd2 >= r1_l:
					continue
				var k2: int = zz * ccx + xx
				if cercas[k2] == null:
					cercas[k2] = []
				(cercas[k2] as Array).append([e / maxf(dd2, 0.3), i])
		var x0: int = clampi(int(floor((p.x - alcance) / LAMP_CELDA)), 0, cx - 1)
		var x1: int = clampi(int(floor((p.x + alcance) / LAMP_CELDA)), 0, cx - 1)
		var z0: int = clampi(int(floor((p.z - alcance) / LAMP_CELDA)), 0, cz - 1)
		var z1: int = clampi(int(floor((p.z + alcance) / LAMP_CELDA)), 0, cz - 1)
		for zz in range(z0, z1 + 1):
			for xx in range(x0, x1 + 1):
				# la distancia en planta del farol al cuadrado de la parcela (0 si esta dentro)
				var qx: float = clampf(p.x, xx * LAMP_CELDA, (xx + 1) * LAMP_CELDA)
				var qz: float = clampf(p.z, zz * LAMP_CELDA, (zz + 1) * LAMP_CELDA)
				var dd: float = Vector2(p.x - qx, p.z - qz).length()
				if dd >= alcance:
					continue
				var kk: int = zz * cx + xx
				if listas[kk] == null:
					listas[kk] = []
				# por si una parcela tuviera mas de LAMP_POR_CELDA: se quedan las que mas alumbran en su centro
				var cen := Vector3((xx + 0.5) * LAMP_CELDA, p.y, (zz + 0.5) * LAMP_CELDA)
				(listas[kk] as Array).append([e * maxf(0.0, 1.0 - cen.distance_to(p) / alcance), i])
	var res := {}
	res["img"] = img
	res["rej"] = _lamp_rejilla_img(listas, cx, cz)
	res["rej_cerca"] = _lamp_rejilla_img(cercas, ccx, ccz)
	res["cx"] = cx
	res["cz"] = cz
	res["ccx"] = ccx
	res["ccz"] = ccz
	res["r1_max"] = r1_max
	var llenas := 0
	var maximo := 0
	var maximo_cerca := 0
	for li in listas:
		if li != null:
			llenas += 1
			maximo = maxi(maximo, (li as Array).size())
	for li in cercas:
		if li != null:
			maximo_cerca = maxi(maximo_cerca, (li as Array).size())
	res["llenas"] = llenas
	res["maximo"] = maximo
	res["maximo_cerca"] = maximo_cerca
	res["ms_listas"] = (Time.get_ticks_usec() - t0) / 1000
	var datos := _lamp_datos_volumen(img, muertas)
	res["vol"] = _volumen_en_hilo(datos, muertas, tam, k)
	res["ms_hilo"] = (Time.get_ticks_usec() - t0) / 1000
	return res


## Lo que se le pasa a CocinaLuces: las 4 filas de cada farol, con "encendida" = no rota (de dia se apagan todas con
## lamp_on, sin hornear)
func _lamp_datos_volumen(img: Image, muertas: PackedByteArray) -> PackedFloat32Array:
	var n := img.get_width()
	var datos := PackedFloat32Array()
	datos.resize(n * 16)
	for i in n:
		for fila in 4:
			var c: Color = img.get_pixel(i, fila)
			datos[i * 16 + fila * 4 + 0] = c.r
			datos[i * 16 + fila * 4 + 1] = c.g
			datos[i * 16 + fila * 4 + 2] = c.b
			datos[i * 16 + fila * 4 + 3] = c.a
		datos[i * 16 + 13] = 0.0 if i < muertas.size() and muertas[i] != 0 else 1.0
	return datos


## EL VOLUMEN DE LUZ LEJANA (CocinaLuces, en C++ y en hilos), en el hilo: el volumen y sus capas ya hechas imagenes.
## Devuelve {} si no se puede, y {"grande": dims} si el mapa es demasiado grande (todo exacto).
func _volumen_en_hilo(datos: PackedFloat32Array, muertas: PackedByteArray, tam: Vector3, k: float) -> Dictionary:
	if _sin_volumen_luces or not ClassDB.class_exists("CocinaLuces"):
		return {}
	var t0 := Time.get_ticks_usec()
	var n := datos.size() / 16
	var techo := 0.0
	var rotas := 0
	for i in n:
		techo = maxf(techo, datos[i * 16 + 1] + 1.0 / maxf(datos[i * 16 + 3], 0.0001))
		rotas += 1 if i < muertas.size() and muertas[i] != 0 else 0
	var dims := Vector3i(int(ceil(tam.x / LAMP_VOL_CELDA)), int(ceil(minf(tam.y, techo) / LAMP_VOL_CELDA)) + 1, int(ceil(tam.z / LAMP_VOL_CELDA)))
	if dims.x * dims.y * dims.z > LAMP_VOL_MAX_CELDAS:
		return {"grande": dims}
	# LUZ FIJA: el volumen llega hasta el mismo farol (sin el hueco que dejaba para la parte cercana, que no se calcula)
	if _lamp_fija:
		datos = datos.duplicate()
		for i in n:
			datos[i * 16 + 15] = 0.01
	var r: Dictionary = ClassDB.instantiate("CocinaLuces").hornear(datos, Vector3.ZERO, LAMP_VOL_CELDA, dims, LAMP_R0, LAMP_R1, k)
	if r.is_empty():
		return {}
	var capas_a: Array[Image] = []
	var capas_b: Array[Image] = []
	var capas_c: Array[Image] = []
	var pa: PackedByteArray = r["a"]
	var pb: PackedByteArray = r["b"]
	var pc: PackedByteArray = r["c"]
	var cap: int = dims.x * dims.y * 4
	var cap2: int = dims.x * dims.y * 2
	for z in dims.z:
		capas_a.append(Image.create_from_data(dims.x, dims.y, false, Image.FORMAT_RGBE9995, pa.slice(z * cap, (z + 1) * cap)))
		capas_b.append(Image.create_from_data(dims.x, dims.y, false, Image.FORMAT_RGBE9995, pb.slice(z * cap, (z + 1) * cap)))
		capas_c.append(Image.create_from_data(dims.x, dims.y, false, Image.FORMAT_RG8, pc.slice(z * cap2, (z + 1) * cap2)))
	var dd: Vector3i = r["dims_d"]
	var pd: PackedByteArray = r["d"]
	var capas_d: Array[Image] = []
	var cap_d: int = dd.x * dd.y * 8
	for z in dd.z:
		capas_d.append(Image.create_from_data(dd.x, dd.y, false, Image.FORMAT_RGBAH, pd.slice(z * cap_d, (z + 1) * cap_d)))
	return {"dims": dims, "dims_d": dd, "a": capas_a, "b": capas_b, "c": capas_c, "d": capas_d, "max": float(r["max"]),
		"rotas": rotas, "ms": (Time.get_ticks_usec() - t0) / 1000}


## Rehornear el volumen (se rompio un farol): en un hilo; si ya hay uno en marcha, otra vez al acabar.
func _lamp_hornear_volumen() -> void:
	if _sin_volumen_luces or not ClassDB.class_exists("CocinaLuces") or _lamp_img == null:
		return
	if _lamp_tarea >= 0:
		_lamp_rehornear = true
		return
	var muertas: PackedByteArray = _lamp_dead.duplicate()
	var datos := _lamp_datos_volumen(_lamp_img, muertas)
	var tam: Vector3 = world.get_world_size()
	var k := lamp_k
	_lamp_tarea_res = {}
	_lamp_tarea = WorkerThreadPool.add_task(func() -> void:
		_lamp_tarea_res = {"vol": _volumen_en_hilo(datos, muertas, tam, k)}, false, "volumen de luces")


## Cada fotograma: si el hilo acabo, se sube lo suyo A TROZOS, una textura del volumen por fotograma (crear las cuatro
## de golpe eran 30-100 ms en Monaco, 1,5 M celdas: la primera sola 7-17), y en el quinto se cambia todo a la vez (la
## primera vez, las Light3D dejan de alumbrar el mundo en ese mismo fotograma).
var _lamp_subida: Dictionary = {}
var _lamp_subida_paso := 0
var _lamp_subida_peor := 0.0
var _lamp_vol_nuevas: Array = [null, null, null, null]

func _lamp_tarea_tick() -> void:
	if _lamp_subida.is_empty():
		if _lamp_tarea < 0 or not WorkerThreadPool.is_task_completed(_lamp_tarea):
			return
		WorkerThreadPool.wait_for_task_completion(_lamp_tarea)
		_lamp_tarea = -1
		_lamp_subida = _lamp_tarea_res
		_lamp_tarea_res = {}
		_lamp_subida_paso = 0
		_lamp_subida_peor = 0.0
	var t0 := Time.get_ticks_usec()
	var r: Dictionary = _lamp_subida
	var v: Dictionary = r.get("vol", {})
	var paso := _lamp_subida_paso
	_lamp_subida_paso += 1
	if paso < 4 and v.has("dims"):
		_lamp_subir_textura(paso, v)
		_lamp_subida_peor = maxf(_lamp_subida_peor, (Time.get_ticks_usec() - t0) / 1000.0)
		return
	# el ultimo paso: todo a la vez
	_lamp_subida = {}
	if r.has("img"):
		_aplicar_lamparas(r)
	else:
		_volumen_final(v)
	_lamp_subida_peor = maxf(_lamp_subida_peor, (Time.get_ticks_usec() - t0) / 1000.0)
	if r.has("img"):
		print("[luces] %d faroles cocinados: hilo %d ms (listas %d, volumen %s), en el hilo principal %.1f ms en el peor fotograma · %d parcelas de %.0f m con luz (hasta %d faroles en una, %d de cerca) · volumen %s" % [
			_lamp_pool.size(), int(r["ms_hilo"]), int(r["ms_listas"]), str(v.get("ms", "-")), _lamp_subida_peor, int(r["llenas"]), LAMP_CELDA,
			int(r["maximo"]), int(r["maximo_cerca"]),
			("%dx%dx%d celdas de %.1f m" % [_lamp_vol_dims.x, _lamp_vol_dims.y, _lamp_vol_dims.z, LAMP_VOL_CELDA]) if _lamp_vol_a != null else "no (todo exacto)"])
	elif v.has("dims"):
		print("[luces] volumen rehorneado: hilo %s ms, en el hilo principal %.1f ms en el peor fotograma (%d rotas)" % [str(v.get("ms", "-")), _lamp_subida_peor, int(v.get("rotas", 0))])
	if _lamp_rehornear:
		_lamp_rehornear = false
		_lamparas_estado()   # vuelve a hornear solo si las rotas siguen sin cuadrar con lo horneado


## Una de las cuatro texturas del volumen: si ya existe (rehornear), se actualiza en su sitio (unos fotogramas con una
## ya nueva y otra aun vieja: ni se nota); si no, se crea aparte y se ata en `_volumen_final`.
func _lamp_subir_textura(k: int, v: Dictionary) -> void:
	var dims: Vector3i = v["dims"] if k < 3 else v["dims_d"]
	var fmt: int = [Image.FORMAT_RGBE9995, Image.FORMAT_RGBE9995, Image.FORMAT_RG8, Image.FORMAT_RGBAH][k]
	var capas: Array[Image] = v[["a", "b", "c", "d"][k]]
	var actual: ImageTexture3D = [_lamp_vol_a, _lamp_vol_b, _lamp_vol_c, _lamp_vol_d][k]
	if actual != null and _lamp_vol_dims == v["dims"]:
		actual.update(capas)
		_lamp_vol_nuevas[k] = null
	else:
		var t := ImageTexture3D.new()
		t.create(fmt, dims.x, dims.y, dims.z, false, capas)
		_lamp_vol_nuevas[k] = t


## El alcance del farol que mas llega (el corte del camino exacto de lamparas.gdshaderinc). --sincortelamparas: sin corte.
func _lamp_alcance_max() -> float:
	if "--sincortelamparas" in OS.get_cmdline_user_args():
		return 1e6
	var m := 0.0
	for o in _lamp_pool:
		if o is OmniLight3D:
			m = maxf(m, (o as OmniLight3D).omni_range)
		elif o is SpotLight3D:
			m = maxf(m, (o as SpotLight3D).spot_range)
	return m + 0.5 if m > 0.0 else 1e6


func _aplicar_lamparas(r: Dictionary) -> void:
	_lamp_img = r["img"]
	# lo encendido/apagado de ahora (pudo cambiar mientras cocinaba) lo pone _lamparas_estado al final
	_lamp_tex = ImageTexture.create_from_image(_lamp_img)
	_lamp_rej_tex = ImageTexture.create_from_image(r["rej"])
	var rej_cerca_tex := ImageTexture.create_from_image(r["rej_cerca"])
	for m in [world.opaque_material, world.glass_material]:
		if m is ShaderMaterial:
			var sm := m as ShaderMaterial
			sm.set_shader_parameter("lamp_datos", _lamp_tex)
			sm.set_shader_parameter("lamp_rejilla", _lamp_rej_tex)
			sm.set_shader_parameter("lamp_org", Vector2.ZERO)
			sm.set_shader_parameter("lamp_celda", LAMP_CELDA)
			sm.set_shader_parameter("lamp_celdas", Vector2i(int(r["cx"]), int(r["cz"])))
			sm.set_shader_parameter("lamp_k", lamp_k)
			sm.set_shader_parameter("lamp_cerca", rej_cerca_tex)
			sm.set_shader_parameter("lamp_celda_cerca", LAMP_CELDA_CERCA)
			sm.set_shader_parameter("lamp_celdas_cerca", Vector2i(int(r["ccx"]), int(r["ccz"])))
			sm.set_shader_parameter("lamp_r0", LAMP_R0)
			sm.set_shader_parameter("lamp_r1", float(r["r1_max"]))
			sm.set_shader_parameter("lamp_alcance_max", _lamp_alcance_max())
			sm.set_shader_parameter("lamp_dbg", 1 if _lamp_fija else 0)
	var v: Dictionary = r["vol"]
	if v.has("grande"):
		var g: Vector3i = v["grande"]
		print("[luces] volumen de %dx%dx%d celdas: demasiado grande, todo exacto" % [g.x, g.y, g.z])
	_volumen_final(v)
	# las Light3D ya no alumbran el mundo: solo lo demas
	for o in _lamp_pool:
		o.light_cull_mask = 0xFFFFF & ~CAPA_MUNDO_BIT
	_lamp_cocinadas = true
	_lamparas_estado()


## El volumen ya subido (por `_lamp_subir_textura`): si son texturas nuevas, se atan al material.
func _volumen_final(v: Dictionary) -> void:
	if not v.has("dims"):
		return
	var dims: Vector3i = v["dims"]
	var dd: Vector3i = v["dims_d"]
	_lamp_muertas_horneadas = int(v["rotas"])
	if _lamp_vol_nuevas[0] == null:
		return   # se actualizaron las que ya estaban atadas
	_lamp_vol_a = _lamp_vol_nuevas[0]
	_lamp_vol_b = _lamp_vol_nuevas[1]
	_lamp_vol_c = _lamp_vol_nuevas[2]
	_lamp_vol_d = _lamp_vol_nuevas[3]
	_lamp_vol_nuevas = [null, null, null, null]
	_lamp_vol_dims = dims
	for m in [world.opaque_material, world.glass_material]:
		if m is ShaderMaterial:
			var sm := m as ShaderMaterial
			sm.set_shader_parameter("lamp_vol_a", _lamp_vol_a)
			sm.set_shader_parameter("lamp_vol_b", _lamp_vol_b)
			sm.set_shader_parameter("lamp_vol_c", _lamp_vol_c)
			sm.set_shader_parameter("lamp_vol_d", _lamp_vol_d)
			sm.set_shader_parameter("lamp_vol_tam_d", Vector3(dd) * (LAMP_VOL_CELDA * 2.0))
			sm.set_shader_parameter("lamp_vol_org", Vector3.ZERO)
			sm.set_shader_parameter("lamp_vol_tam", Vector3(dims) * LAMP_VOL_CELDA)
			sm.set_shader_parameter("lamp_vol_max", float(v["max"]))
			sm.set_shader_parameter("lamp_vol_on", 1.0)


## Hasta LAMP_POR_CELDA indices por parcela (las que mas alumbran primero), en 4 pixeles RGBA8 seguidos; 255 = no hay mas
func _lamp_rejilla_img(listas: Array, cx: int, cz: int) -> Image:
	var rej := Image.create(cx * 4, cz, false, Image.FORMAT_RGBA8)
	rej.fill(Color(1, 1, 1, 1))
	for k in listas.size():
		var li = listas[k]
		if li == null:
			continue
		var arr: Array = li
		arr.sort_custom(func(a, b): return float(a[0]) > float(b[0]))
		var xx: int = k % cx
		var zz: int = k / cx
		for t in 4:
			var c := Color(1, 1, 1, 1)
			for q in 4:
				var j: int = t * 4 + q
				if j < arr.size() and j < LAMP_POR_CELDA:
					c[q] = float(int(arr[j][1])) / 255.0
			rej.set_pixel(xx * 4 + t, zz, c)
	return rej


## Encendidas (de noche, o la tarde de la cafeteria), rotas y desvanecido, al sombreado
func _lamparas_estado() -> void:
	if not _lamp_cocinadas or _lamp_img == null:
		return
	if _lamp_vol_a != null:
		var muertas := 0
		for i in _lamp_dead.size():
			muertas += 1 if _lamp_dead[i] != 0 else 0
		if muertas != _lamp_muertas_horneadas:
			_lamp_hornear_volumen()
	var alguna := false
	for i in _lamp_pool.size():
		# (encendida, no el nodo visible: la tapada por una pared se esconde pero al mundo le sigue alumbrando)
		var viva: bool = _lamps_on and _lamp_dead[i] == 0
		alguna = alguna or viva
		var c := _lamp_img.get_pixel(i, 3)
		if (c.g > 0.5) != viva:
			c.g = 1.0 if viva else 0.0
			_lamp_img.set_pixel(i, 3, c)
	_lamp_tex.update(_lamp_img.duplicate())   # copia: con el hilo de render separado la subida se hace despues y la imagen se sigue tocando
	var o0: Light3D = _lamp_pool[0]
	for m in [world.opaque_material, world.glass_material]:
		if m is ShaderMaterial:
			var sm := m as ShaderMaterial
			sm.set_shader_parameter("lamp_on", 1.0 if alguna else 0.0)
			sm.set_shader_parameter("lamp_fade_ini", o0.distance_fade_begin if o0.distance_fade_enabled else 1e6)
			sm.set_shader_parameter("lamp_fade_len", o0.distance_fade_length)


## --lucesprueba: REVIENTA FAROLES Y MIRA SI SE APAGAN. Se hace con la misma explosion que el juego y
## sin llamar al apagado a mano: si la luz sigue encendida despues de volar la lampara, es el bug.
## Tambien mide la caja de 0,35 m, para saber si la comprobacion de 0,7 m se esta comiendo la pared o
## el techo que hay detras del farol.
func _luces_prueba() -> void:
	await get_tree().create_timer(3.0).timeout
	while _lamp_next < _lamp_pos.size():
		await get_tree().process_frame
	if world == null or _lamp_pos.is_empty():
		print("[luces] sin faroles que probar")
		get_tree().quit()
		return
	if not night:
		set_night(true)
	if is_instance_valid(player):
		player.invulnerable = true
	var paso := 1                      # todos los faroles del mapa, uno por uno
	var vivas := 0
	var probadas := 0
	var falsos := 0
	for k in range(0, _lamp_pos.size(), paso):
		var p: Vector3 = _lamp_pos[k]
		var h7 := Vector3(0.7, 0.7, 0.7)
		var h3 := Vector3(0.35, 0.35, 0.35)
		# la carcasa esta DETRAS de la bombilla: el generador la saca justo por delante del cristal
		var det: Vector3 = p - _lamp_dir[k] * 0.25
		if _lamp_dead[k] != 0:
			continue                   # ya la apago la explosion de una vecina: no cuenta
		var a7: bool = world.box_solid(p - h7, p + h7)
		var a3: bool = world.box_solid(p - h3, p + h3)
		var ad: bool = world.box_solid(det - h3, det + h3)
		# PRIMERO, UNA EXPLOSION LEJOS: a 4,5 m, que con radio 2,5 no llega a tocar la lampara. Un farol
		# sano NO se puede apagar por esto; si se apaga, la regla de cercania se esta pasando.
		world.explode(p + Vector3(4.5, 0.0, 0.0), 2.5, 255)
		for _f in 3:
			await get_tree().physics_frame
		if _lamp_dead[k] != 0:
			falsos += 1
			print("[luces] FALSO APAGADO %3d %-9s alto %4.1f radio %.2f" % [
				k, "foco" if _lamp_dir[k] != Vector3.ZERO else "bombilla", p.y, _lamp_probe[k]])
			continue
		var quitados: int = world.explode(p, 2.5, 255)
		for _f in 5:
			await get_tree().physics_frame
		var s7: bool = world.box_solid(p - h7, p + h7)
		var s3: bool = world.box_solid(p - h3, p + h3)
		var sd: bool = world.box_solid(det - h3, det + h3)
		var muerta: bool = _lamp_dead[k] != 0
		if not muerta:
			vivas += 1
		probadas += 1
		if not muerta:                 # solo se listan las que se quedan encendidas rotas
			print("[luces] SIGUE ENCENDIDA %3d %-9s alto %4.1f radio %.2f  vox %5d  0.7 %s->%s  0.35 %s->%s  detras %s->%s" % [
				k, "foco" if _lamp_dir[k] != Vector3.ZERO else "bombilla", p.y, _lamp_probe[k], quitados,
				str(a7), str(s7), str(a3), str(s3), str(ad), str(sd)])
	print("[luces] probadas %d · siguen alumbrando rotas %d · apagadas sin tocarlas %d" % [probadas, vivas, falsos])
	get_tree().quit()

## MODO BOMBA. Sólo en los mapas que traen sitios de bomba de verdad en su .sites.json (dust2).
## En la ciudad no hay bandos ni C4: antes se generaban dos sitios al azar y salía la pantalla de
## terroristas/policía en un mapa donde eso no tiene sentido.
var bomb_mode := false

# --- DUELO A MUERTE POR EQUIPOS ------------------------------------------------------------------
# Un mapa entra en este modo si trae un `<mapa>.dm.json` al lado, igual que el modo bomba entra por
# su `.sites.json`. Ahi vienen las dos bases y cuantas bajas hacen falta para ganar.
#
# Las diferencias con el modo bomba son tres, y las tres estan en el mismo sitio: aqui SI se
# reaparece -en tu propia base, en cuanto mueres-, la partida no va por rondas sino por un marcador
# de bajas corrido, y los bots no defienden nada: van al centro a buscarse.
var dm_mode := false
var dm_objetivo := 50
var dm_bajas := {"t": 0, "ct": 0}
var dm_terminado := false
## nombre -> {"equipo", "bajas", "muertes"}. Para la pantalla de victoria y el MVP.
var dm_stats := {}
## equipo -> [Vector3]: los puntos de reaparicion del .dm.json (vacio: se reaparece en la base)
var dm_salidas := {}
var _dm_ya_salio := false
var _bomba_terminada := false

# --- LA CIUDAD: ATRACO A TRES EQUIPOS --------------------------------------------------------------
# Amarillo, Azul y Violeta. Las tres bases estan repartidas en circulo alrededor de la caja fuerte, a
# ras de calle, asi que los tres salen a la misma distancia de ella y se encuentran por el camino.
var ciudad3 := false
const ESPERA_ATRACO := 15.0     ## segundos muerto en el atraco antes de reaparecer (si no te reviven)
var bases_equipo := {}            ## equipo -> Vector3
## PUNTOS: cada cubo ingresado vale 1000 (heist.gd) y gana el primer equipo en llegar a 3000.
const PUNTOS_GANAR := 3000
var puntos_equipo := {}           ## equipo -> puntos
var ciudad_terminada := false
var _cajas_usadas: Array = []     ## donde han salido ya cajas: la siguiente sale lejos de todas
var _caja_siguiente := Vector3.ZERO   ## la primera caja se elige antes (las bases van alrededor de ella)
var t_spawn := Vector3.ZERO        # base terrorista (ZERO = la del propio mapa)
var dm_centro := Vector3.ZERO      # el punto medio entre las dos bases: ahi se pelea
var _ct_i := 0        # cuantos policias llevo repartidos en esta ronda
var _t_i := 0         # y cuantos terroristas

## Lee `<mapa>.dm.json` si existe: dos bases y el numero de bajas para ganar.
func _cargar_dm() -> void:
	dm_mode = false
	Net.dm_mode = false
	# Net es un autoload y sobrevive al cambio de escena: sin esto, volver de la ciudad a hangar dejaba
	# tres equipos en un mapa de dos
	Net.equipos = [Net.TEAM_T, Net.TEAM_CT]
	ciudad3 = false
	bases_equipo = {}
	Net.dm_altura_minima = -INF
	dm_objetivo = 50
	dm_bajas = {"t": 0, "ct": 0}
	dm_terminado = false
	dm_stats = {}
	_bomba_terminada = false
	t_spawn = Vector3.ZERO
	dm_centro = Vector3.ZERO
	var f := FileAccess.open("res://maps/%s.dm.json" % current_map, FileAccess.READ)
	if f == null:
		return
	var d = JSON.parse_string(f.get_as_text())
	if typeof(d) != TYPE_DICTIONARY:
		return
	dm_mode = true
	Net.dm_mode = true
	dm_objetivo = int(d.get("objetivo_bajas", 50))
	# TODOS CONTRA TODOS (submodo "todos"): las bajas son de cada uno, asi que hacen falta menos
	dm_objetivo_todos = int(d.get("objetivo_todos", maxi(10, int(round(dm_objetivo * 0.4)))))
	_puntos_todos.clear()
	# --dmobjetivo=N: las dos cuentas a N (los bancos no esperan a 50 bajas)
	for a in OS.get_cmdline_user_args():
		if String(a).begins_with("--dmobjetivo="):
			dm_objetivo = maxi(1, int(String(a).substr(13)))
			dm_objetivo_todos = dm_objetivo
	# LOS PUNTOS DE REAPARICION DE CADA EQUIPO (opcionales, 2026-09-30, mapa CAFETERIA URBANA): se empieza en la base
	# y se reaparece en el punto del propio lado mas alejado de los rivales (ver _salida_dm). Sin ellos, en la base.
	dm_salidas = {}
	_dm_ya_salio = false
	for eq in [Net.TEAM_T, Net.TEAM_CT]:
		var lista: Array = []
		for q in d.get("salidas_t" if eq == Net.TEAM_T else "salidas_ct", []):
			if typeof(q) == TYPE_ARRAY and q.size() >= 3:
				lista.append(_ground_near(Vector3(float(q[0]), float(q[1]), float(q[2]))))
		if not lista.is_empty():
			dm_salidas[eq] = lista
	# LA HORA DEL MAPA (opcional): "tarde" = el sol de media tarde (cielo_tarde)
	if String(d.get("hora", "")) == "tarde" and not _noche_partida:
		cielo_tarde(float(d.get("sol_azimut", 250.0)))
	var st = d.get("spawn_t", null)
	if typeof(st) == TYPE_ARRAY and st.size() >= 3:
		t_spawn = _ground_near(Vector3(float(st[0]), float(st[1]), float(st[2])))
	var sc = d.get("spawn_ct", null)
	if typeof(sc) == TYPE_ARRAY and sc.size() >= 3:
		ct_spawn = _ground_near(Vector3(float(sc[0]), float(sc[1]), float(sc[2])))
	# LADOS QUE ROTAN (2026-10-28, pedido: "siempre salgo en el mismo punto"): cada partida, a cara o cruz, los dos
	# bandos se cambian la base y sus salidas. Por red decide la semilla de la partida (igual en todas las maquinas).
	if t_spawn != Vector3.ZERO and ct_spawn != Vector3.ZERO and not "--dmladosfijos" in OS.get_cmdline_user_args():
		var en_red: bool = multiplayer.has_multiplayer_peer() and not (multiplayer.multiplayer_peer is OfflineMultiplayerPeer)
		var cambia: bool = ((Net.semilla_partida >> 5) & 1) == 1 if en_red else randf() < 0.5
		if cambia:
			var tmp := t_spawn
			t_spawn = ct_spawn
			ct_spawn = tmp
			var st2 = dm_salidas.get(Net.TEAM_T, null)
			var sc2 = dm_salidas.get(Net.TEAM_CT, null)
			dm_salidas.erase(Net.TEAM_T)
			dm_salidas.erase(Net.TEAM_CT)
			if sc2 != null:
				dm_salidas[Net.TEAM_T] = sc2
			if st2 != null:
				dm_salidas[Net.TEAM_CT] = st2
			print("[Breach] duelo: lados cambiados esta partida")
	if t_spawn != Vector3.ZERO and ct_spawn != Vector3.ZERO:
		dm_centro = _ground_near((t_spawn + ct_spawn) * 0.5)
	# ALTURA MINIMA JUGABLE: por debajo, un bot se da por caido del mapa (ver Net.dm_altura_minima).
	# Si el .dm.json no la trae, seis metros por debajo de la base mas baja.
	var base_baja: float = minf(t_spawn.y, ct_spawn.y) if t_spawn != Vector3.ZERO and ct_spawn != Vector3.ZERO else 0.0
	Net.dm_altura_minima = float(d.get("altura_minima", base_baja - 6.0))
	print("[Breach] DUELO A MUERTE en %s · %d bajas · T %s · CT %s · centro %s" % [
		current_map, dm_objetivo, str(t_spawn), str(ct_spawn), str(dm_centro)])


func _load_bomb_sites() -> void:
	bomb_sites.clear()
	bomb_mode = false
	var sites: Array = []
	var radius := 6.0     # por defecto si el mapa no lo trae en su .sites.json
	var f := FileAccess.open("res://maps/%s.sites.json" % current_map, FileAccess.READ)
	if f:
		bomb_mode = true
		var d = JSON.parse_string(f.get_as_text())
		if typeof(d) == TYPE_DICTIONARY:
			for sp in d.get("sites", []):
				if typeof(sp) == TYPE_ARRAY and sp.size() >= 3:
					sites.append(_ground_near(Vector3(float(sp[0]), float(sp[1]), float(sp[2]))))
			radius = float(d.get("radius", radius))
			var cs = d.get("ct_spawn", null)
			if typeof(cs) == TYPE_ARRAY and cs.size() >= 3:
				ct_spawn = _ground_near(Vector3(float(cs[0]), float(cs[1]), float(cs[2])))
	site_radius = radius
	_cargar_dm()
	if sites.is_empty():
		# automático: dos puntos de suelo a >35 % del mapa del spawn y lejos entre sí
		var spawn: Vector3 = world.get_spawn_position()
		var size: Vector3 = world.get_world_size()
		seed(current_map.hash())
		var best: Array = []
		for attempt in 60:
			var p := _random_ground_point()
			if p.distance_to(spawn) < size.x * 0.35:
				continue
			if best.is_empty():
				best.append(p)
			elif best.size() == 1 and p.distance_to(best[0]) > size.x * 0.3:
				best.append(p)
			if best.size() == 2:
				break
		sites = best
		randomize()
	for sp in sites:
		var posts: Array = []
		for k in 40:
			if posts.size() >= 6:
				break
			var a := randf() * TAU
			var r := randf_range(3.0, radius)
			var g: Vector3 = world.find_ground(sp + Vector3(cos(a) * r, 0.0, sin(a) * r))
			if g.y < 0.0 or absf(g.y - sp.y) > 4.0:
				continue
			var up: Dictionary = world.raycast(g + Vector3(0, 0.3, 0), Vector3.UP, 2.0)
			if up.hit:
				continue
			posts.append(g)
		if posts.is_empty():
			posts.append(sp)
		bomb_sites.append({"pos": sp, "posts": posts})
	print("[Breach] sitios de bomba: ", bomb_sites.size(), " ", bomb_sites.map(func(b): return b.pos), " · spawn policías: ", ct_spawn)
	player.bomb_sites = bomb_sites
	player.dm_mode = dm_mode
	player.site_radius = site_radius
	player.ct_spawn = ct_spawn
	player.check_bomb_spawn_rule()

## BOTS POR BANDOS: 4 de tu equipo y 4 del contrario. Los tuyos no te disparan ni te ven como
## enemigo; van a por los del otro bando. Se llama al elegir bando, no al cargar el mapa, porque
## hasta entonces no se sabe de qué lado estás.
## DIEZ POR BANDO, menos los humanos que ya estén. Los bots RELLENAN el equipo, no se suman a él: si
## entran cuatro personas de policía, salen seis bots de policía y el bando sigue siendo de diez. Sin
## esto, una partida con gente acabaría con dieciséis contra diez.
## Lo minimo que se dibuja del mundo en una partida con gente: "Media" (indice 3). Es lo que ya usan
## los presets ALTO y ULTRA, asi que en PC no cambia nada.
const VISTA_MINIMA_EN_RED := 3
## Metros que se dibujan, iguales para todos (ver apply_graphics).
const DISTANCIA_DIBUJO := 120.0

const BOTS_PER_TEAM := 10

## CUANTOS BOTS CABEN EN UN EQUIPO, SEGUN EL MODO.
##
## Diez por bando era un numero de cuando los bots solo servian para tener a alguien a quien disparar.
## Ahora hacen de jugadores mientras llega gente, asi que el equipo tiene que tener el tamano de un
## equipo de verdad: cinco por bando en bomba y en duelo a muerte, tres en el atraco -que son tres
## bandos, no dos, y quince bots en una iGPU no los mueve nadie-.
const BOTS_BOMBA_DM := 5
const BOTS_ATRACO := 3


func _bots_por_equipo() -> int:
	if ciudad3 or Settings.modo == "atraco" or Settings.map in Settings.MAPAS_ATRACO:
		return BOTS_ATRACO
	return BOTS_BOMBA_DM

## Cuántos bots salieron de MI bando. Antes se daba por hecho que era `BOTS_PER_TEAM` y el reparto se
## hacía por índice; con relleno variable eso ya no vale y hay que recordarlo.
var _bots_mios := 0

## Cuántos bots hacen falta en un bando para llegar a diez contando a las personas que ya hay.
func _faltan_bots(t: String) -> int:
	var humanos := 1 if (player != null and "team" in player and String(player.team) == t) else 0
	if Net.has_method("team_count"):
		humanos = maxi(humanos, int(Net.team_count(t)))
	var objetivo := _bots_por_equipo()
	# EN EL MOVIL, 6 BOTS Y NO 9 (2026-10-14, pedido: la CPU del movil no llega): tu bando de 4 (tu + 3) contra 4. El atraco,
	# como siempre. --bots9 = como en el PC
	if _bots_movil() and objetivo == BOTS_BOMBA_DM:
		var mio_t := String(player.team) if player != null and "team" in player else ""
		objetivo = BOTS_MOVIL_MIO if t == mio_t else BOTS_MOVIL_RIVAL
	return maxi(objetivo - humanos, 0)

# ---------------------------------------------------------------------------
# BOTS EN PARTIDA ONLINE
#
# El reparto es el mismo que con las criaturas del PvE, que es el unico que ha funcionado en este
# proyecto: la IA corre SOLO en el anfitrion y los invitados dibujan copias mudas.
#
# Lo de "un humano ocupa el sitio de un bot" ya estaba resuelto sin saberlo: `_faltan_bots(t)` calcula
# cuantos faltan para llegar al tamano de equipo RESTANDO LAS PERSONAS que ya hay. Al entrar alguien,
# el siguiente reparto pone un bot menos.
# ---------------------------------------------------------------------------

## Envios por segundo del estado de los bots. 15 es el punto donde deja de verse a tirones con el
## suavizado del otro lado; subirlo solo gasta red.
const BOTS_RED_HZ := 15.0
var _bots_red_t := 0.0
## EL NUMERO DE RED DE UN BOT. Sube y no baja nunca.
##
## Antes se mandaba `e.id`, que es `700 + cuantos bots hay` -o el indice dentro del equipo-: dos bots
## de equipos distintos podian llevar el mismo, y en cuanto uno moria el siguiente en nacer heredaba
## el suyo. En la pantalla del otro eso es un bot que se descarta por repetido y unas posiciones que
## se le aplican al bot equivocado. Medido en el banco: 8 avisos recibidos, 1 descartado por repetido.
var _bot_red_seq := 0


func _nuevo_id_bot() -> int:
	_bot_red_seq += 1
	return _bot_red_seq
var _tarde_total0 := 0
var _reparto_pendiente := false
var _bots_copia: Dictionary = {}    ## invitado: red_id -> bot que solo se dibuja
## Contadores del invitado, para saber por que falta un bot en vez de suponerlo.
var _red_bots_recibidos := 0
var _red_bots_repetidos := 0
var _red_bots_sin_sitio := 0
var _bots_anunciados: Dictionary = {}   ## anfitrion: los que ya saben los demas


## ¿CREO YO LOS BOTS? Sin red, si. Con red, SOLO EL ANFITRION: los invitados reciben copias.
##
## Esto era `not Net.is_online()` en tres sitios, o sea "en red no hay bots". Era correcto cuando cada
## maquina simulaba los suyos y divergian; ahora que la IA vive solo en el anfitrion, el anfitrion
## tiene que crearlos y los demas NO.
func _me_toca_crear_bots() -> bool:
	return (not Net.is_online()) or Net.hosting


func _montar_bots_de_red() -> void:
	# los disparos de los bots los pinta todo el mundo (tambien el anfitrion: los que piensa un invitado)
	if not Net.bot_tiro.is_connected(_red_bot_tiro):
		Net.bot_tiro.connect(_red_bot_tiro)
	if Net.hosting:
		# el anfitrion los crea como siempre (spawn_enemies) y ademas los ANUNCIA
		return
	# el invitado no crea ninguno por su cuenta: espera a que se los manden
	Net.bot_nuevo.connect(_red_bot_nuevo)
	Net.bot_estado.connect(_red_bot_estado)
	Net.bot_muerto.connect(_red_bot_muerto)
	Net.bot_escudo_roto.connect(func(id: int):
		var eb = _bots_copia.get(id)
		if is_instance_valid(eb) and eb.has_method("_romper_escudo_bot"):
			eb._romper_escudo_bot())
	Net.bots_repartidos.connect(_mis_bots_ahora)
	Settings.bots_enabled = false
	# Y EL DAÑO QUE YA SE HA HECHO AL MUNDO. Sin esto, quien entra a una partida empezada ve paredes
	# donde los demas ven agujeros, y ya no se arregla en toda la partida.
	Net.pedir_historial()
	# ya estan enganchadas las señales: ahora si se puede pedir el censo de los que ya existen
	Net.pedir_censo_bots()


## EL ANFITRION SE HA IDO Y LA PARTIDA SIGUE.
##
## Si el relevo me toca a mi, tengo que hacerme cargo de los bots. Hasta ahora eran COPIAS MUDAS: no
## piensan, solo repiten lo que decia el anfitrion, y el que se ha ido ya no dice nada.
##
## Se tiran y se crean de nuevo. Reaparecen, y se nota; pero la alternativa -convertir cada copia en
## un bot pensante a media partida, con su camino, su objetivo y su arma a medio usar- es mucho mas
## fragil, y lo que importa es que la partida no se corte.
func _al_migrar(soy_yo: bool) -> void:
	hud.flash_message("El anfitrión se fue · %s" % ("tomas el mando" if soy_yo else "reenganchando..."))
	# EN BOMBA, EL RELEVO NO DECIDE LA RONDA (2026-10-20, bug: "mi amigo se fue, gano un equipo al instante, no
	# reaparecia, despues solo sin bots y sin las rondas"): mientras los bots se borran y vuelven a nacer no se arbitra
	# nada, la sala tenia bots -> vuelve a tenerlos (aunque mi ajuste de bots este apagado: era la sala del otro), el
	# marcador se queda y se empieza una ronda nueva con todos vivos en su base.
	var habia_bots := 0
	if enemies != null:
		for e in enemies.get_children():
			if "team" in e:
				habia_bots += 1
	var marcador := [Net.score_t, Net.score_ct]
	Net.relevo_hasta_ms = Time.get_ticks_msec() + 8000
	_bots_copia.clear()
	_bots_anunciados.clear()
	# SOLO LOS BOTS. Aqui se tiraba TODO lo que colgara de `enemies`, y en una partida de oleadas ahi
	# viven tambien las criaturas (`pve.setup(..., enemies)`): se fuera el anfitrion y todos los zombis
	# desaparecian de golpe en todas las pantallas. Un bot tiene bando; una criatura no. Las criaturas
	# las recoge `pve.gd`, que es quien sabe que hacer con ellas en el relevo.
	if enemies != null:
		for e in enemies.get_children():
			if "team" in e:
				e.queue_free()
	if not soy_yo:
		return
	# AHORA MANDO YO EN EL MUNDO: donde acaban los bloques y que se derrumba por su peso
	if world != null and world.has_method("set_red"):
		world.set_settle_authority(true)
		world.set_red(true, true)
	# los bots vuelven a nacer cuando ya soy servidor de verdad, no antes
	await get_tree().create_timer(2.5).timeout
	# Y EN OLEADAS NO HAY BOTS. `spawn_enemies()` saca SOLDADOS, y en la cuarentena eso metia una
	# cuadrilla de soldados entre los zombis al irse el anfitrion. El modo lo dice el mapa.
	if Net.hosting and (Settings.bots_activos() or habia_bots > 0) and pve == null:
		spawn_enemies()
	if bomb_mode and Net.hosting and not "--sinrelevoronda" in OS.get_cmdline_user_args():
		Net.score_t = maxi(Net.score_t, int(marcador[0]))
		Net.score_ct = maxi(Net.score_ct, int(marcador[1]))
		Net.new_round()
		if is_instance_valid(player) and player.has_method("revive"):
			player.revive()
		spawn_at_team_base(Net.my_team())
		Net.net_bomb_carrier(0)
		spawn_loose_c4()
		print("[relevo] bomba: ronda nueva con %d bots y el marcador %d-%d" % [habia_bots, Net.score_t, Net.score_ct])
	hud.flash_message("Partida recuperada · ahora el servidor eres tú")


# ---------------------------------------------------------------------------
# BOTS REPARTIDOS
# ---------------------------------------------------------------------------

## Los bots por los que pienso yo. En el anfitrion, los que se ha quedado; en un invitado, los que le
## han tocado. Vacio en un invitado = no piensa por ninguno, que es como estaba antes.
var _bots_mios_red: Dictionary = {}


## ANFITRION: vuelve a repartir. Se llama cuando entra o sale gente, y cuando nacen bots nuevos.
func _rehacer_reparto() -> void:
	if not (Net.is_online() and Net.hosting) or enemies == null:
		return
	var ids: Array = []
	for e in enemies.get_children():
		# SOLO BOTS (`"team" in e`). Las criaturas comparten este nodo y tienen `red_id`, asi que en una
		# partida de oleadas cada vez que entraba o salia alguien se REPARTIAN LOS ZOMBIS entre los
		# jugadores como si fueran bots: a un invitado le tocaba "pensar" por el zombi numero 3.
		# (ni los COMPAÑEROS BOT de los modos zombi: su cerebro, aliado_pve.gd, solo lo tiene el anfitrion)
		if is_instance_valid(e) and "red_id" in e and "team" in e and int(e.red_id) != 0 and not e.is_in_group("aliados_pve"):
			ids.append(int(e.red_id))
	if ids.is_empty():
		return
	Net.repartir_bots(ids)


## Me dicen de que bots me toca pensar.
##
## En el anfitrion los bots ya existen y solo hay que marcarlos. En un invitado, los suyos dejan de
## ser copias mudas y pasan a pensar: `remoto = false` enciende toda la IA que estaba apagada.
func _mis_bots_ahora(mios: Array) -> void:
	_bots_mios_red.clear()
	for bid in mios:
		_bots_mios_red[int(bid)] = true
	if enemies == null:
		return
	var encendidos := 0
	for e in enemies.get_children():
		if not is_instance_valid(e) or not ("red_id" in e) or not ("team" in e):
			continue                       # las criaturas del mismo nodo no son bots repartibles
		var mio: bool = _bots_mios_red.has(int(e.red_id))
		if Net.hosting:
			continue                       # los del anfitrion ya piensan
		if "remoto" in e and e.remoto == mio:
			e.remoto = not mio
			if mio:
				e.setup(world, player, int(e.red_id) % 12)
				e.red_id = int(e.red_id)   # setup no debe cambiarlo
				encendidos += 1
	if encendidos > 0:
		print("[bots] me toca pensar por %d bot(s)" % encendidos)


## DUEÑO INVITADO: manda la postura de los bots que le tocan, al mismo ritmo que el anfitrion.
func _mandar_mis_bots(dt: float) -> void:
	if not Net.is_online() or Net.hosting or _bots_mios_red.is_empty() or enemies == null:
		return
	_bots_red_t += dt
	if _bots_red_t < 1.0 / BOTS_RED_HZ:
		return
	_bots_red_t = 0.0
	var datos: Array = []
	for e in enemies.get_children():
		# `"team" in e` DESCARTA LAS CRIATURAS, que viven en este mismo nodo y tienen `red_id` propio.
		# Sus numeros van por su cuenta (1, 2, 3...) y pueden coincidir con los de un bot repartido:
		# sin este filtro, un invitado acababa mandando la postura de un ZOMBI por el canal de los
		# bots. El log del invitado se llenaba de "Invalid access to property 'health'".
		if not is_instance_valid(e) or not ("red_id" in e) or not ("team" in e):
			continue
		if not _bots_mios_red.has(int(e.red_id)):
			continue
		var clip := ""
		if "avatar" in e and e.avatar != null and "current_clip" in e.avatar:
			clip = String(e.avatar.current_clip)
		datos.append_array([int(e.red_id), e.global_position.x, e.global_position.y,
			e.global_position.z, e.rotation.y, clip, float(e.health)])
	Net.net_bots_mios(datos)


## --diagposturas: cuatro veces por segundo, donde esta el bloque mas grande (id y posicion). Se lanza en las
## dos copias y se comparan los logs: con las posturas del anfitrion tienen que caer igual.
var _diagpost_t := 0.0

func _diag_posturas(dt: float) -> void:
	if not ("--diagposturas" in OS.get_cmdline_user_args()) or world == null:
		return
	_diagpost_t += dt
	if _diagpost_t < 0.25:
		return
	_diagpost_t = 0.0
	var mejor = null
	for bd in world.get_bodies_debug():
		if mejor == null or int(bd.voxels) > int(mejor.voxels):
			mejor = bd
	if mejor != null and int(mejor.voxels) > 500:
		print("[posturas] t %.2f id %d vox %d pos %s · voxels del mundo %d · crateres mandados %d recibidos %d" % [Time.get_ticks_msec() / 1000.0 - _diagpost_t0, int(mejor.id), int(mejor.voxels), str(Vector3(mejor.pos).snapped(Vector3.ONE * 0.01)),
			int(world.get_stats().get("voxels_solid", 0)), Net.craters_mandados, Net.craters_recibidos])
		if _diagpost_t0 == 0.0:
			_diagpost_t0 = Time.get_ticks_msec() / 1000.0

var _diagpost_t0 := 0.0


## EL ANFITRION CAMBIA DE MAPA CON TODOS DENTRO. Pasa al acabar la sala de espera del battle royale: los
## que estan en el mapa de pruebas reciben `match_starting` (Net._begin) y aqui se recarga la partida con
## el mapa nuevo (Settings.map ya lo trae). En el lobby eso lo hacia lobby.gd; dentro de la partida no lo
## escuchaba nadie y el invitado se quedaba en pruebas mientras los demas saltaban a la isla.
func _enganchar_cambio_de_mapa() -> void:
	if not Net.match_starting.is_connected(_net_cambia_mapa):
		Net.match_starting.connect(_net_cambia_mapa)
	# EL AVISO LLEGO MIENTRAS CARGABA: la espera se acabo antes de que este mapa (el de pruebas) terminara
	# de montarse, y nadie estaba escuchando. `_begin` ya dejo el mapa nuevo en Settings.map.
	if Net.is_online() and Net.en_partida and not Net.en_espera and Settings.map != current_map and current_map == Net.MAPA_ESPERA:
		_net_cambia_mapa(Settings.map)
		return
	if Net.en_espera:
		_cartel_espera_montar()


func _net_cambia_mapa(mapa: String) -> void:
	print("[red] el anfitrion cambia de mapa: %s -> %s" % [current_map, mapa])
	get_tree().change_scene_to_file.call_deferred("res://scenes/main.tscn")


## LA CUENTA ATRAS DE LA SALA DE ESPERA, arriba en el centro: cuanto falta para el avion y cuantos hay.
var _cartel_espera: Label = null

func _cartel_espera_montar() -> void:
	if _cartel_espera != null:
		return
	var capa := CanvasLayer.new()
	capa.layer = 50
	add_child(capa)
	_cartel_espera = Label.new()
	_cartel_espera.set_anchors_preset(Control.PRESET_CENTER_TOP)
	_cartel_espera.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_cartel_espera.position = Vector2(-300, 56)
	_cartel_espera.size = Vector2(600, 60)
	_cartel_espera.add_theme_font_size_override("font_size", 26)
	_cartel_espera.add_theme_color_override("font_outline_color", Color.BLACK)
	_cartel_espera.add_theme_constant_override("outline_size", 8)
	_cartel_espera.mouse_filter = Control.MOUSE_FILTER_IGNORE
	capa.add_child(_cartel_espera)
	var t := Timer.new()
	t.wait_time = 0.25
	t.autostart = true
	add_child(t)
	t.timeout.connect(_cartel_espera_tick)
	_cartel_espera_tick()


func _cartel_espera_tick() -> void:
	if _cartel_espera == null:
		return
	if not Net.en_espera:
		_cartel_espera.text = "¡AL AVIÓN!"
		return
	var r := int(ceil(Net.espera_restante()))
	_cartel_espera.text = "BATTLE ROYALE · el avión sale en %d:%02d\n%d jugador%s en la sala · esperando a que entre gente" % [
		r / 60, r % 60, Net.players.size(), "" if Net.players.size() == 1 else "es"]


## NADIE EMPIEZA HASTA QUE TODOS HAYAN CARGADO.
##
## El que carga rapido podia llevar medio minuto rompiendo cosas antes de que apareciera el otro, y
## todo eso SE PIERDE: la destruccion se replica en el momento, no se guarda. El que llega tarde se
## queda con un mundo distinto para el resto de la partida, y eso ya no se arregla solo.
##
## Mientras faltan, no se mueve nadie: el jugador se queda quieto tras un velo que dice a cuantos se
## espera. Es mejor esperar diez segundos que jugar media partida contra un mundo que los demas no ven.
func _esperar_a_los_demas() -> void:
	_enganchar_cambio_de_mapa()
	if Net.soy_espectador:
		return          # el espectador no hace esperar a nadie ni espera a nadie: mira desde ya
	if not Net.is_online() or Net.partida_arrancada:
		Net.avisar_cargado()
		return
	_velo_espera_poner()
	if not Net.listos_cambian.is_connected(_velo_espera_texto):
		Net.listos_cambian.connect(_velo_espera_texto)
	if not Net.espera_cambia.is_connected(_velo_espera_cuenta):
		Net.espera_cambia.connect(_velo_espera_cuenta)
	Net.todos_listos.connect(_velo_espera_quitar, CONNECT_ONE_SHOT)
	Net.todos_listos.connect(_bots_tras_espera, CONNECT_ONE_SHOT)
	if Net.hosting and Net.espera_hasta_ms > 0:
		_espera_tick()
	if is_instance_valid(player):
		player.set_process_input(false)
		player.set_process_unhandled_input(false)
	Net.avisar_cargado()
	# RED DE SEGURIDAD: si alguien se cuelga cargando y no llega a avisar, no se puede dejar a los
	# demas mirando un velo para siempre.
	await get_tree().create_timer(60.0).timeout
	if _velo_espera != null:
		print("[red] alguien no ha terminado de cargar en 60 s: se empieza igualmente")
		_velo_espera_quitar()


## LA ESPERA ES LA MISMA PANTALLA DE CARGA (2026-10-04, bug: "entre encontrar partida y jugar veo mi arma y el mapa sin
## terminar de cargar"): era un velo propio al 92 %, y a traves se veia el mapa a medio mallar con el arma (y en el movil
## los botones tactiles, que van en una capa mas alta, salian encima). Ahora la carga del HUD se queda puesta, opaca y con
## su imagen, y dice a cuantos se espera; se quita cuando estan todos. Mientras, el mapa sigue mallandose detras.
var _velo_espera: Variant = null          ## true mientras se espera (antes, la capa del velo)
var _velo_espera_label: Label = null


func _velo_espera_poner() -> void:
	_velo_espera = true
	if hud == null:
		return
	hud.set_loading(true)
	_velo_espera_label = hud.loading_label
	if is_instance_valid(_velo_espera_label):
		_velo_espera_label.text = "ESPERANDO A LOS DEMÁS · cargando el mapa..."
	if hud.loading_bar:
		hud.loading_bar.value = 1.0


var _bots_aplazados := false


## ANFITRION, MIENTRAS LA SALA ESTA ABIERTA: cuenta atras y los bots que "van entrando" (solo nombres en la carga; los de
## verdad nacen al arrancar). Cada persona que entra se come el hueco de un bot: se recalcula con _faltan_bots.
func _espera_tick() -> void:
	var t0 := Time.get_ticks_msec()
	var total_s: float = maxf(1.0, (Net.espera_hasta_ms - t0) / 1000.0)
	while is_inside_tree() and Net.hosting and not Net.partida_arrancada:
		var restante: float = maxf(0.0, (Net.espera_hasta_ms - Time.get_ticks_msec()) / 1000.0)
		# los bots se suman de a poco: ninguno los 2 primeros segundos, todos al 85 % de la espera
		var f: float = clampf(((Time.get_ticks_msec() - t0) / 1000.0 - 2.0) / maxf(1.0, total_s * 0.85 - 2.0), 0.0, 1.0)
		Net.mandar_espera(restante, _bots_de_la_espera(f))
		Net.mirar_arranque()
		await get_tree().create_timer(0.5).timeout


func _bots_de_la_espera(f: float) -> Array:
	var huecos: Array = []      # [bando, ...] uno por bot que haria falta
	if dm_mode and Net.es_dm_todos():
		for i in maxi(0, _dm_todos_jugadores() - _personas_en_partida()):
			huecos.append("")
	else:
		var por: Dictionary = {}
		var mas := 0
		for eq in Net.equipos:
			por[eq] = _faltan_bots(String(eq))
			mas = maxi(mas, int(por[eq]))
		for k in mas:              # alternando bandos: los dos se llenan a la vez
			for eq in Net.equipos:
				if k < int(por[eq]):
					huecos.append(String(eq))
	var n: int = int(floor(huecos.size() * f))
	var out: Array = []
	for i in n:
		out.append([nombre_bot(i), huecos[i]])
	return out


func _bots_tras_espera() -> void:
	print("[sala] arranca a los %d ms (bots aplazados: %s)" % [Time.get_ticks_msec(), str(_bots_aplazados)])
	if _bots_aplazados and Net.hosting:
		_bots_aplazados = false
		if Settings.bots_enabled and enemies != null and enemies.get_child_count() == 0:
			spawn_enemies()


func _velo_espera_cuenta() -> void:
	if _velo_espera != null and is_instance_valid(_velo_espera_label) and Net.sala_restante > 0.0:
		_velo_espera_label.text = "BUSCANDO JUGADORES · empieza en %d s" % ceili(Net.sala_restante)


func _velo_espera_texto(cuantos: int, de: int) -> void:
	if _velo_espera != null and is_instance_valid(_velo_espera_label):
		_velo_espera_label.text = "ESPERANDO A LOS DEMÁS · %d de %d ya han cargado" % [cuantos, de]


func _velo_espera_quitar() -> void:
	var estaba: bool = _velo_espera != null
	_velo_espera = null
	_velo_espera_label = null
	if estaba and hud:
		hud.set_loading(false)
	if is_instance_valid(player):
		player.set_process_input(true)
		player.set_process_unhandled_input(true)
	hud.flash_message("¡A jugar!")


## ANFITRION: TODOS MIS BOTS, A QUIEN ACABA DE LLEGAR.
##
## El aviso de nacimiento sale una sola vez, cuando el bot nace. Quien entra a una partida en marcha
## se perdio todos esos avisos y veia el mapa sin un solo bot -medido: 0-, aunque para el resto
## estuvieran ahi. Se le manda el censo entero solo a el.
func _censo_de_bots(a_quien: int) -> void:
	# EL MARCADOR DEL DUELO, A QUIEN ENTRA: hasta la siguiente baja lo veia a cero (medido: 0-0 contra 12-7)
	if dm_mode or not dm_stats.is_empty():
		Net.net_dm_marcador(dm_bajas, dm_stats)
	if enemies == null:
		return
	var n := 0
	for e in enemies.get_children():
		# `"team" in e`: las criaturas viven en este mismo nodo y tienen `red_id`, asi que colaban y el
		# censo reventaba en `e.team` a mitad de la lista -y el que acababa de entrar se quedaba sin
		# los bots que venian detras del primer zombi-.
		if not is_instance_valid(e) or not ("red_id" in e) or not ("team" in e):
			continue
		Net.net_bot_nuevo(int(e.red_id), String(e.team), e.global_position, _nombre_red_bot(e), a_quien)
		n += 1
	print("[net] jugador %d entra en marcha: le mando %d bots" % [a_quien, n])


## ANFITRION: anuncia un bot recien nacido para que los demas creen su copia.
func anunciar_bot(e: Node) -> void:
	if not (Net.is_online() and Net.hosting) or not is_instance_valid(e):
		return
	Net.net_bot_nuevo(int(e.red_id), String(e.team), e.global_position, _nombre_red_bot(e))


## El nombre que viaja con un bot: el de su etiqueta (aliados) o el del marcador (rivales)
func _nombre_red_bot(e: Node) -> String:
	if String(e.get("bot_name")) != "":
		return String(e.bot_name)
	return String(e.get("nombre_marcador")) if "nombre_marcador" in e and e.get("nombre_marcador") != null else ""


## ANFITRION: anuncia los nuevos, manda donde esta cada bot, y avisa de los que han muerto.
##
## Los NACIMIENTOS y las MUERTES se detectan comparando la lista con la del tick anterior, en vez de
## poner avisos en los cinco sitios donde se crean bots y en el camino de la muerte. Asi no hay forma
## de olvidarse uno: cualquier bot que aparezca o desaparezca, por el motivo que sea, se replica.
## EL RELOJ DE LA RONDA DE BOMBA (Net.RONDA_S): empieza con la primera ronda y, si llega a cero sin la C4
## plantada, la ronda es de los policias, como en CS2. Solo lo aplica el anfitrion (o el juego sin sala).
## ERES EL ULTIMO (2026-11-01): en bomba, cuando de tu bando solo quedas tu y enfrente quedan dos o mas, un aviso por
## ronda: "1 contra N"
var _ultimo_avisado := false
var _ronda_anunciada := -1

## TODOS CONTRA TODOS: VAS PRIMERO (2026-11-01): al ponerte primero (sin empate) y al perder el puesto
var _yo_primero := false

func _dm_primero_tick() -> void:
	var yo := Net.nombre_propio()
	var mio := int(dm_stats.get(yo, {}).get("bajas", 0)) if dm_stats.get(yo) is Dictionary else 0
	var otro_max := 0
	for n in dm_stats.keys():
		if String(n) != yo and dm_stats[n] is Dictionary:
			otro_max = maxi(otro_max, int(dm_stats[n].get("bajas", 0)))
	var primero: bool = mio >= 2 and mio > otro_max
	if primero != _yo_primero and hud:
		hud.anuncio("¡VAS PRIMERO!" if primero else "TE HAN QUITADO EL PRIMER PUESTO")
	_yo_primero = primero


## A UNA BAJA DE GANAR (2026-11-01): en el duelo por equipos, un aviso para todos cuando un bando se queda a una
