## --teclasspectertest (con --personaje=9): LAS TECLAS DEL SPECTER, como las pulsa el jugador (eventos de teclado de verdad):
## X enciende y APAGA la invisibilidad (bug del 2026-10-03: la segunda X no hacia nada) y Z enciende y apaga el blindaje.
## --muertehabilidadtest (un duelo, con --personaje=9): MORIR CON LA HABILIDAD PUESTA (bug del 2026-10-03: se reaparecia
## con el blindaje o la invisibilidad encendidos). Blindaje y luego invisibilidad: morir, reaparecer y mirar que todo
## esta apagado (la habilidad, el jugador, el muñeco y la lente)
func _muerte_habilidad_test() -> void:
	await get_tree().create_timer(14.0).timeout
	var h = player.get("_hab")
	var ok := true
	for que in ["blindaje", "invisible"]:
		h.energia = h.energia_max
		h.recarga = 0.0
		if que == "blindaje":
			h.alternar_blindaje()
		else:
			h.activar()
		await get_tree().create_timer(0.6).timeout
		var puesto: bool = bool(h.blindaje) if que == "blindaje" else h.fase == "invisible"
		player.invulnerable = false
		print("[muertehab] antes: vida %.0f · espectando %s · invulnerable %s · vida_infinita %s · caido %.1f" % [
			float(player.health), str(player.spectating), str(player.invulnerable), str(player.vida_infinita), float(player.caido_t)])
		var vida_antes: float = float(player.health)
		player.take_damage(99999.0, Vector3.ZERO)
		print("[muertehab] despues: vida %.0f · espectando %s" % [float(player.health), str(player.spectating)])
		var t := 0.0
		# en el duelo, sin quien te mate, se reaparece EN EL ACTO (player.die -> _respawn sin resumen): la vida vuelve llena
		var murio: bool = bool(player.spectating) or float(player.health) <= 0.0 			or (float(player.health) >= player.vida_max() - 0.5 and vida_antes < 99999.0)
		while t < 25.0:
			await get_tree().process_frame
			t += get_process_delta_time()
			if bool(player.spectating) or float(player.health) <= 0.0:
				murio = true
			elif murio:
				break
		await get_tree().create_timer(0.5).timeout
		var av = player.avatar
		var nano = h.nano
		var lente_on: bool = nano != null and (float(nano._blindaje) > 0.01 or float(nano._invis) > 0.01)
		var apagado: bool = not bool(h.blindaje) and h.fase != "invisible" and not bool(player.invisible) 			and not bool(av._traje_blindaje) and not bool(av.invisible) and not lente_on
		print("[muertehab] %s %s: puesto %s · murio %s · al reaparecer apagado %s (blindaje %s, fase '%s', invisible %s, muñeco %s/%s, lente %s)" % [
			"ok  " if (puesto and murio and apagado) else "MAL ", que, str(puesto), str(murio), str(apagado), str(h.blindaje), h.fase,
			str(player.invisible), str(av._traje_blindaje), str(av.invisible), str(lente_on)])
		ok = ok and puesto and murio and apagado
		await get_tree().create_timer(8.0).timeout     # que acabe de reaparecer (rellena la vida al final)
	print("[muertehab] %s" % ("TODO BIEN" if ok else "HAY FALLOS"))
	get_tree().quit(0 if ok else 1)


