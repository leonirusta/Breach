## Rueda el video promocional (ver scripts/promo.gd). Se espera a que el mundo este mallado del
## todo: si se empieza antes, los primeros planos salen con el mapa a medio dibujar.
func _rodar_promo() -> void:
	# el anuncio se rueda SIEMPRE en lo mas alto: el mapa de 10 cm y la calidad maxima, aunque el
	# jugador tenga los ajustes en bajo. Es el escaparate del juego.
	Settings.bots_enabled = false
	for e in enemies.get_children():
		e.queue_free()
	# En dust2 (modo bomba) sale la pantalla de ELEGIR BANDO y se colaba encima del anuncio.
	if team_overlay:
		team_overlay.queue_free()
		team_overlay = null
	_team_cards.clear()
	Net.choose_team(Net.TEAM_T)
	await get_tree().process_frame
	var d = preload("res://scripts/promo.gd").new()
	add_child(d)
	d.arrancar(self)
	# ESPERAR A QUE EL MAPA ESTE ENTERO. Antes eran 6 segundos a ojo y nuke tarda 13 en cargar:
	# los primeros planos salian con el edificio a medio mallar. Ahora se espera de verdad: a que
	# termine la carga y a que se vacie la cola de mallado alrededor de la camara del primer plano.
	var t0 := Time.get_ticks_msec()
	while world.is_loading() and Time.get_ticks_msec() - t0 < 120000:
		await get_tree().process_frame
	# Esperar a que este MALLADO, no solo cargado. Dos intentos fallidos antes de dar con esto:
	#  - "cola vacia" a secas paso en 0,9 s, porque justo despues de mover la camara todavia no se
	#    habia PEDIDO ningun chunk y la cola salia vacia de vacia.
	#  - "chunks_visible > 0" nunca se cumplio: ese contador de get_stats() se queda a cero aqui
	#    aunque el mundo se dibuje perfectamente, asi que no sirve de semaforo.
	# Lo que si funciona: un minimo de tiempo con la camara ya en su sitio (para que le de tiempo a
	# PEDIR el mallado) y despues la cola vacia y quieta un buen rato.
	const MINIMO_MS := 9000
	const QUIETO_FRAMES := 60
	var quietos := 0
	while Time.get_ticks_msec() - t0 < 90000:
		await get_tree().process_frame
		var st: Dictionary = world.get_stats()
		var pendiente: bool = int(st.get("jobs_pending", 0)) > 0 or int(st.get("mesh_results_pending", 0)) > 0
		quietos = 0 if pendiente else quietos + 1
		if quietos >= QUIETO_FRAMES and Time.get_ticks_msec() - t0 >= MINIMO_MS:
			break
	print("[promo] mapa mallado en %.1f s -> accion" % ((Time.get_ticks_msec() - t0) / 1000.0))
	d.rodar()
	print("[promo] rodando %.1f s" % d.duracion_total())



## Datos de un mapa para colocar las camaras del anuncio: tamano, spawn, centros de edificio y los
## puntos altos (tejados). Colocar los planos a ojo salio mal: los bots aparecian contra el cielo.
func _promo_datos() -> void:
	await get_tree().create_timer(4.0).timeout
	var tam: Vector3 = world.get_world_size()
	print("[datos] mapa %s · mundo %.0f x %.0f x %.0f · spawn %s" % [
		current_map, tam.x, tam.y, tam.z, str(world.get_spawn_position().round())])
	var centros: PackedVector3Array = world.get_building_centers()
	print("[datos] centros de edificio: %d" % centros.size())
	for i in range(mini(6, centros.size())):
		print("[datos]   centro %d: %s" % [i, str(Vector3(centros[i]).round())])
	# rejilla de sondeo: la altura del suelo dice donde estan las moles
	var altos: Array = []
	var paso: float = maxf(tam.x, tam.z) / 26.0
	var x := paso
	while x < tam.x:
		var z := paso
		while z < tam.z:
			var g: Vector3 = world.find_ground(Vector3(x, tam.y - 1.0, z))
			if g.y > -100.0:
				altos.append(g)
			z += paso
		x += paso
	altos.sort_custom(func(a, b): return a.y > b.y)
	print("[datos] sondeos con suelo: %d · los 8 puntos mas altos:" % altos.size())
	for i in range(mini(8, altos.size())):
		print("[datos]   alto %d: %s" % [i, str(Vector3(altos[i]).round())])
	if not altos.is_empty():
		var mediana: float = altos[altos.size() / 2].y
		print("[datos] altura mediana del suelo: %.1f · maxima: %.1f" % [mediana, altos[0].y])
	get_tree().quit()


