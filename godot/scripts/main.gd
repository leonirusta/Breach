## Frames en los que se captura con --screenshot (por defecto 260): --shotframes=130,240,300
var _shot_frames: Array[int] = _parse_shot_frames()
var _falltest: Array[float] = _parse_falltest()
static func _parse_falltest() -> Array[float]:
	var out: Array[float] = []
	for f in OS.get_cmdline_user_args():
		if f.begins_with("--falltest="):
			for v in f.substr(11).split(","):
				if v.is_valid_float():
					out.append(float(v))
	return out
static func _parse_shot_frames() -> Array[int]:
	var out: Array[int] = []
	for f in OS.get_cmdline_user_args():
		if f.begins_with("--shotframes="):
			for v in f.substr(13).split(","):
				if v.is_valid_int():
					out.append(int(v))
	if out.is_empty():
		out.append(260)
	return out

var _lantiro_dir: Array[Vector3] = []


func _rayo_fisico(q: PhysicsRayQueryParameters3D) -> Dictionary:
	return get_world_3d().direct_space_state.intersect_ray(q)


## Informe de --balastest (ver el gancho en _diag_frames).
func _balastest_informe() -> void:
	var space := get_world_3d().direct_space_state
	var vs := 0.1
	var cuerpos: Array = world.get_bodies_debug()
	var n_jolt := 0
	var n_solo_voxel := 0
	var n_nada := 0
	var muestra := ""
	for b in cuerpos:
		var c: Vector3 = b.get("pos", Vector3.ZERO)
		var tam: Vector3 = b.get("size", Vector3.ONE) * vs
		var radio: float = maxf(0.15, tam.length() * 0.5)
		var desde: Vector3 = c + Vector3(0.6, 0.35, 0.6).normalized() * (radio + 0.5)
		var dir: Vector3 = (c - desde).normalized()
		var largo: float = desde.distance_to(c) + radio
		var q := PhysicsRayQueryParameters3D.create(desde, desde + dir * largo)
		var hj := space.intersect_ray(q)
		var hv: Dictionary = world.raycast(desde, dir, largo)
		if hj.size() > 0:
			n_jolt += 1
		elif hv.get("hit", false):
			n_solo_voxel += 1
		else:
			n_nada += 1
			if muestra == "":
				muestra = " · ejemplo en %s (%d voxels, rigido %s)" % [str(c), int(b.get("voxels", 0)), str(b.get("rigid", false))]
	# y los que ya son voxels del mapa: se busca material solido por encima del suelo y se comprueba
	# que el rayo de voxels lo encuentra
	var sondas := 0
	var fallos := 0
	var centro: Vector3 = player.global_position if player else Vector3.ZERO
	for i in 900:
		var p := centro + Vector3(randf_range(-9.0, 9.0), randf_range(0.4, 3.5), randf_range(-9.0, 9.0))
		if int(world.get_material_at(p)) == 0:
			continue
		sondas += 1
		var d2 := Vector3(randf_range(-1.0, 1.0), randf_range(-0.3, 0.6), randf_range(-1.0, 1.0)).normalized()
		var h2: Dictionary = world.raycast(p + d2 * 0.7, -d2, 1.4)
		if not h2.get("hit", false):
			fallos += 1
	print("[balastest] frame %d · cuerpos %d: los ve Jolt %d, solo voxels %d, NADIE %d%s | voxels sondeados %d, sin respuesta al rayo %d" % [
		_diag_frames, cuerpos.size(), n_jolt, n_solo_voxel, n_nada, muestra, sondas, fallos])
	# ¿LA BALA SE PARA EN EL ESCOMBRO O SIGUE? Se dispara desde el ojo del jugador a cada cuerpo y se
	# compara lo que ve Jolt (el cascote) con lo que ve el rayo de voxels (la pared de detras). Si el
	# segundo esta mas lejos, el disparo del juego estaba agujereando esa pared ADEMAS de dar al
	# cascote: eso es lo que se ve como "la bala lo atraviesa".
	var ojo: Vector3 = player.global_position + Vector3(0, 1.6, 0)
	var atraviesa := 0
	var probados := 0
	var peor := 0.0
	for b in cuerpos:
		var c: Vector3 = b.get("pos", Vector3.ZERO)
		var dd: Vector3 = (c - ojo).normalized()
		var largo: float = ojo.distance_to(c) + 6.0
		var qq := PhysicsRayQueryParameters3D.create(ojo, ojo + dd * largo)
		qq.exclude = [player.get_rid()]
		var hj2 := _rayo_fisico(qq)
		if hj2.is_empty():
			continue
		probados += 1
		var dj: float = ojo.distance_to(hj2.position)
		# el MISMO tope que usa ahora el disparo de verdad (player.gd::fire)
		var hv2: Dictionary = world.raycast(ojo, dd, minf(largo, dj + 0.10))
		var dv: float = float(hv2.distance) if hv2.get("hit", false) else 1e9
		if dv > dj + 0.05 and dv < 1e8:
			atraviesa += 1
			peor = maxf(peor, dv - dj)
	print("[balastest]   disparos simulados: %d con cuerpo delante · en %d el rayo de voxels seguia hasta %.2f m MAS ALLA (la bala agujereaba lo de detras)" % [probados, atraviesa, peor])
	# CUANTO SE ADELANTA LA COLISION AL VOXEL en el mapa de siempre (paredes, suelo). Es el margen que
	# hay que dejar al limitar el disparo: si se recorta mas que esto, las balas dejan de agujerear
	# las paredes, que seria mucho peor que el bug que se esta arreglando.
	var rids := {}
	for b in cuerpos:
		rids[b.get("rid")] = true
	var n_mapa := 0
	var peor_mapa := 0.0
	var suma := 0.0
	for i in 400:
		var dd := Vector3(randf_range(-1, 1), randf_range(-0.5, 0.3), randf_range(-1, 1)).normalized()
		var qq := PhysicsRayQueryParameters3D.create(ojo, ojo + dd * 40.0)
		qq.exclude = [player.get_rid()]
		var hj3 := _rayo_fisico(qq)
		if hj3.is_empty() or rids.has(hj3.get("rid")) or hj3.get("collider") != null:
			continue
		# con el tope puesto: si aqui deja de acertar, las paredes se habrian vuelto a prueba de balas
		var hv3: Dictionary = world.raycast(ojo, dd, ojo.distance_to(hj3.position) + 0.10)
		if not hv3.get("hit", false):
			n_mapa += 1
			peor_mapa = 999.0
			continue
		var dif: float = float(hv3.distance) - ojo.distance_to(hj3.position)
		n_mapa += 1
		suma += dif
		peor_mapa = maxf(peor_mapa, dif)
	print("[balastest]   mapa liso: %d rayos · el voxel va de media %.3f m por detras de la colision, peor caso %.3f m" % [n_mapa, suma / maxf(1.0, n_mapa), peor_mapa])


func _take_screenshot() -> void:
	# Vista elevada desde el spawn hacia el centro de la ciudad: suelo, varias manzanas y el edificio explotado.
	var size: Vector3 = world.get_world_size()
	var spawn: Vector3 = world.get_spawn_position()
	var stand_at := ""
	var look_at := ""
	for f in OS.get_cmdline_user_args():
		if f.begins_with("--standat="):
			stand_at = f.substr(10)
		elif f.begins_with("--lookat="):
			look_at = f.substr(9)
	if stand_at != "" or look_at != "":
		# cámara libre para verificar zonas concretas: --standat=x,y,z --lookat=x,y,z (metros, coords del juego)
		if stand_at != "":
			var sp := stand_at.split(",")
			player.global_position = Vector3(float(sp[0]), float(sp[1]), float(sp[2]))
		if look_at != "":
			var lp := look_at.split(",")
			if lp.size() == 1:   # --lookat=<yaw en grados>: mirar en esa dirección desde donde esté
				var ang := deg_to_rad(float(lp[0]))
				player.look_at_point(player.global_position + Vector3(sin(ang) * 20.0, 1.6, cos(ang) * 20.0))
			else:
				player.look_at_point(Vector3(float(lp[0]), float(lp[1]), float(lp[2])))
	elif "--pveposts" in OS.get_cmdline_user_args() and pve != null and not pve._puestos.is_empty():
		# LOS PUESTOS DEL PvE de frente: empezar, tienda y la palanca del jefe. Es la foto que dice si
		# los tres se ven, si estan centrados delante de ti y si se leen sus carteles.
		var cen := Vector3.ZERO
		for x in pve._puestos:
			cen += (x["nodo"] as Node3D).global_position
		cen /= float(pve._puestos.size())
		var hacia: Vector3 = player.global_position - cen
		hacia.y = 0.0
		hacia = hacia.normalized() if hacia.length() > 0.2 else Vector3.BACK
		player.global_position = cen + hacia * 5.0 + Vector3(0, 0.6, 0)
		player.look_at_point(cen + Vector3(0, 1.2, 0))
	elif "--botshot" in OS.get_cmdline_user_args():
		pass   # la cámara ya está colocada frente a un bot
	elif "--dust" in OS.get_cmdline_user_args():
		# desde el cruce del spawn, mirando calle abajo hacia la esquina del primer edificio
		player.global_position = Vector3(spawn.x + 1.0, 1.2, spawn.z)
		player.look_at_point(Vector3(spawn.x + 12.0, 1.0, spawn.z + 5.0))
	elif enemies.get_child_count() > 0:
		# encuadre cercano: un bot con la skin del avatar y el edificio explotado detrás
		var e: Node3D = enemies.get_child(0)
		player.global_position = Vector3(spawn.x + 1.5, 1.2, spawn.z)   # en medio de la calle
		e.global_position = Vector3(spawn.x + 6.0, 0.55, spawn.z)
		player.look_at_point(e.global_position + Vector3(0, 0.9, 0))
		print("[Breach] captura: bot a %.1f m" % player.global_position.distance_to(e.global_position))
	else:
		player.global_position = Vector3(spawn.x + 2.0, 9.0, spawn.z + 2.0)
		player.look_at_point(Vector3(size.x * 0.45, 2.0, size.z * 0.45))
	world.set_player_position(player.global_position)
	for f in OS.get_cmdline_user_args():
		if f.begins_with("--weapon="):
			player.switch_weapon(int(f.substr(9)))
			for i in 10:
				await get_tree().process_frame
	if "--ads" in OS.get_cmdline_user_args():
		player.set_touch_aim(true)
		for i in 30:
			await get_tree().process_frame
	if "--dust" in OS.get_cmdline_user_args():
		# explosión en la pared más cercana delante de la cámara: capturar el polvo en pleno vuelo
		var cam: Camera3D = player.get_node("Head/Camera3D")
		var fwd: Vector3 = -cam.global_transform.basis.z
		var r: Dictionary = world.raycast(cam.global_position, fwd, 40.0)
		var target: Vector3 = r.position if r.hit else cam.global_position + fwd * 8.0
		print("[Breach] explosión de captura en %s (dist %.1f)" % [target, cam.global_position.distance_to(target)])
		world.explode(target, 2.5, 220)
		await get_tree().process_frame
		var f2 := Vector3(fwd.x, 0, fwd.z).normalized()
		var right := f2.cross(Vector3.UP)
		var ground := cam.global_position + f2 * 6.0
		var rg: Dictionary = world.raycast(ground + Vector3(0, 2, 0), Vector3.DOWN, 30.0)
		ground.y = (rg.position.y + 0.3) if rg.hit else 0.5
		# explosión secundaria en el suelo, a 6 m, para ver la nube de cerca
		world.explode(ground + right * 1.5, 1.8, 200)
		for i in 10:
			await get_tree().process_frame
	# ESCUDO: --tercera (vista en tercera persona), --escudogolpe (le llegan tiros de frente),
	# --escudoromper (tanto dano que revienta), --escudoapunta (apuntando), --escudodisparo (dispara)
	if "--tercera" in OS.get_cmdline_user_args() and player.has_method("set_third_person"):
		player.set_third_person(true)
		for i in 30:
			await get_tree().process_frame
	if "--escudoapunta" in OS.get_cmdline_user_args():
		player.set_touch_aim(true)
		for i in 30:
			await get_tree().process_frame
	if "--escudodisparo" in OS.get_cmdline_user_args():
		player.fire()
		for i in 5:
			await get_tree().process_frame
	var frente_jugador: Vector3 = -(Basis(Vector3.UP, player.look.x).z)
	# --escudogatillo: mantener el gatillo con el escudo saca la pistola y dispara al acabar; un toque corto no
	if "--escudogatillo" in OS.get_cmdline_user_args():
		for i in 90:
			await get_tree().process_frame
		var m0: int = player.ammo[player.current]
		player.set_touch_fire(true)
		var t0 := Time.get_ticks_msec()
		var t_tiro := -1
		while Time.get_ticks_msec() - t0 < 700:
			await get_tree().process_frame
			if t_tiro < 0 and player.ammo[player.current] < m0:
				t_tiro = Time.get_ticks_msec() - t0
		player.set_touch_fire(false)
		print("[gatillo] mantenido: primer tiro a los %d ms" % t_tiro)
		await get_tree().create_timer(1.5).timeout
		var m1: int = player.ammo[player.current]
		player.set_touch_fire(true)
		await get_tree().create_timer(0.15).timeout
		player.set_touch_fire(false)
		await get_tree().create_timer(0.8).timeout
		print("[gatillo] toque de 150 ms: %d tiros" % (m1 - player.ammo[player.current]))
	# --lenteexplosion: revienta algo a 4 m delante y cuenta la tierra que llega a la lente
	if "--lenteexplosion" in OS.get_cmdline_user_args():
		for i in 90:
			await get_tree().process_frame
		var boom: Vector3 = player.global_position + frente_jugador * 4.0 + Vector3(0.0, 0.6, 0.0)
		world.explode(boom, 1.5, 200)
		effects.explosion(boom, 1.5)
		for i in 3:
			await get_tree().process_frame
		print("[lente] con escudo %s: en pantalla %s, tierra %d grumos, vida %.0f, escudo %.0f" % [
			str(player.con_escudo()), str(player.cam.is_position_in_frustum(boom)), hud.lens_dirt_amount(),
			player.health, player.escudo_vida])
	if "--escudogolpe" in OS.get_cmdline_user_args():
		for i in 3:
			player.take_damage(30.0, -frente_jugador * 2.0)
			for j in 4:
				await get_tree().process_frame
		print("[escudo] vida del escudo %.0f, vida %.0f" % [player.escudo_vida, player.health])
		player.take_damage(30.0, frente_jugador * 2.0)
		print("[escudo] por la espalda: vida del escudo %.0f, vida %.0f" % [player.escudo_vida, player.health])
	# --escudorecarga (--recargaespera=<s>): recarga con el escudo y foto a mitad
	if "--escudorecarga" in OS.get_cmdline_user_args():
		player.set_ammo(player.current, 3)
		player.reload()
		var espera_rec := 0.9
		for f in OS.get_cmdline_user_args():
			if f.begins_with("--recargaespera="):
				espera_rec = float(f.substr(16))
		await get_tree().create_timer(espera_rec).timeout
	# --sorderatest: una sordera a tope y lo que cuesta el primer paso del pitido (rellenar el bufer vacio)
	if "--sorderatest" in OS.get_cmdline_user_args():
		Audio.deafen(1.0)
		await get_tree().process_frame
		var _ts0 := Time.get_ticks_usec()
		Audio._update_deafness(0.016)
		print("[sorderatest] primer paso del pitido %.2f ms" % ((Time.get_ticks_usec() - _ts0) / 1000.0))
	if "--escudoromper" in OS.get_cmdline_user_args():
		player.take_damage(600.0, -frente_jugador * 2.0)
		var espera_rotura := 0.35
		for f in OS.get_cmdline_user_args():
			if f.begins_with("--roturaespera="):
				espera_rotura = float(f.substr(15))
		await get_tree().create_timer(espera_rotura).timeout
		print("[escudo] roto: vida del escudo %.0f, roto %s, vida %.0f" % [player.escudo_vida, str(player.escudo_roto), player.health])
		for n in get_tree().current_scene.find_children("EscudoRoto*", "RigidBody3D", true, false):
			print("[escudo] suelto en %s (jugador en %s), velocidad %s, dormido %s" % [str((n as Node3D).global_position.snapped(Vector3.ONE * 0.01)),
				str(player.global_position.snapped(Vector3.ONE * 0.01)), str((n as RigidBody3D).linear_velocity.snapped(Vector3.ONE * 0.01)), str((n as RigidBody3D).sleeping)])
	# --menushot: la captura con el MENU abierto (--combate: el panel de combate), para revisar su diseño
	if "--menushot" in OS.get_cmdline_user_args() and hud and hud.menu_panel == null:
		hud.toggle_menu()
		if "--combate" in OS.get_cmdline_user_args():
			hud.toggle_menu()
			hud.open_combat_panel()
		for _i in 6:
			await get_tree().process_frame
	await get_tree().process_frame
	await get_tree().process_frame
	await get_tree().process_frame
	var img := get_viewport().get_texture().get_image()
	var path := "user://breach_shot.png"
	img.save_png(path)
	if _shot_frames.size() > 1:
		img.save_png("user://breach_shot_%d.png" % _diag_frames)
	print("[Breach] captura guardada en ", ProjectSettings.globalize_path(path))
	print("[audio] sonidos reproducidos por clave: ", Audio.played, " | espacio cerrado: %.2f" % Audio.enclosure)
	var stt: Dictionary = world.get_stats()
	var phys := {}
	for k in stt.keys():
		if "bod" in String(k) or "piece" in String(k) or "debris" in String(k) or "smoke" in String(k):
			phys[k] = stt[k]
	print("[Breach] física: ", phys)
	if world.has_method("get_smoke_debug"):
		print("[Breach] humo: ", world.get_smoke_debug(4), " cámara ", player.get_node("Head/Camera3D").global_position)
	print("[Breach] render: draw calls %d, objetos %d, primitivas %d" % [
		RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_DRAW_CALLS_IN_FRAME),
		RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_OBJECTS_IN_FRAME),
		RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_PRIMITIVES_IN_FRAME)])
	if _diag_frames < _shot_frames.max():
		return   # quedan capturas (--shotframes=a,b,c)
	await get_tree().process_frame
	get_tree().quit()

## Utilidad de pruebas (F6): cinturón de cargas alrededor de la planta baja del edificio más cercano.
func demolish_nearest() -> void:
	var centers: PackedVector3Array = world.get_building_centers()
	if centers.is_empty():
		return
	var best := centers[0]
	var bd := INF
	for c in centers:
		var d := Vector2(c.x - player.global_position.x, c.z - player.global_position.z).length()
		if d < bd:
			bd = d
			best = c
	for k in range(20):
		var ang := TAU * k / 20.0
		world.explode(Vector3(best.x + cos(ang) * 9.5, 1.9, best.z + sin(ang) * 9.5), 3.4, 255)
	world.explode(Vector3(best.x, 1.9, best.z), 6.0, 255)
	hud.flash_message("Demolición")

## Benchmark reproducible en motor: cámara fija, secuencia de explosiones, CSV automático, salida.
func _run_bench() -> void:
	hud.start_csv("bench")
	var centers: PackedVector3Array = world.get_building_centers()
	var t := 0.0
	var i := 0
	while t < 40.0 and is_inside_tree():
		await get_tree().process_frame
		var dt := get_process_delta_time()
		t += dt
		if i < centers.size() and t > 5.0 + i * 1.5:
			var c := centers[i]
			player.global_position = Vector3(c.x + 14.0, 1.7, c.z + 10.0)
			player.look_at_point(Vector3(c.x, 3.0, c.z))
			world.explode(Vector3(c.x + 6.0, 2.5, c.z), 3.5, 255)
			if i % 3 == 2:
				demolish_nearest()
			i += 1
	hud.stop_csv()
