## --pruebasentado: ¿SE VE BIEN EL MUÑECO DENTRO DEL COCHE? Se sube al jugador de PASAJERO, se pone la
## camara fuera para verlo, y se sacan fotos: sentado quieto y asomado disparando. Ademas se mide si la
## cabeza se sale del techo del vehiculo, que es lo que no se puede ver en una captura de lejos.
##   --map=isla --pruebasentado [--tipo=coche] [--fotos]
func _prueba_sentado() -> void:
	for i in 150:
		await get_tree().physics_frame
	player.invulnerable = true
	if is_instance_valid(salto_br):
		salto_br.queue_free()
	player.br_control = null
	var tipo := "coche"
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--tipo="):
			tipo = a.substr(7)
	if vehiculos == null or not is_instance_valid(vehiculos):
		print("[sentado] el mapa no trae vehiculos")
		get_tree().quit()
		return
	var idx := -1
	for i in vehiculos.puntos.size():
		if String(vehiculos.puntos[i]["tipo"]) == tipo:
			idx = i
			break
	var p: Vector3 = vehiculos.puntos[idx]["pos"]
	player.global_position = Vector3(p.x + 2.0, 20.0, p.z)
	world.set_player_position(player.global_position)
	for i in 240:
		await get_tree().physics_frame
	var v = vehiculos.nodos.get(idx)
	if v == null or not is_instance_valid(v):
		print("[sentado] no se ha creado el %s" % tipo)
		get_tree().quit()
		return
	# de PASAJERO (el asiento 1), que es el que se asoma a disparar
	v.ocupados[0] = 99                      # el volante, ocupado por otro
	player.global_position = v.global_position + Vector3(1.5, 0.6, 0.0)
	if not vehiculos.usar_desde_jugador(player):
		print("[sentado] no me he podido subir")
		get_tree().quit()
		return
	player.set_third_person(true)
	# UNA CAMARA FUERA PARA VERLO. La de tercera persona se queda dentro del coche y la foto no vale
	# para juzgar nada (se ve el techo y ya).
	var cam := Camera3D.new()
	cam.fov = 55.0
	add_child(cam)
	cam.make_current()
	for i in 60:
		await get_tree().physics_frame
		cam.global_position = v.global_position + v.global_transform.basis * Vector3(3.2, 1.5, 2.6)
		cam.look_at(v.to_global(v.asiento_pos(maxi(0, v.mi_asiento))), Vector3.UP)
	var alto_v: float = float(v.ficha["tamano"][1])
	# LA CABEZA, POR EL HUESO. Sumar 1,55 a la posicion del jugador vale de pie, no sentado: sentado la
	# coronilla esta mucho mas abajo y el aviso salia siempre en rojo aunque cupiera de sobra.
	var cabeza: float = alto_v
	if player.avatar and player.avatar.skeleton and player.avatar.bone_idx.has("head"):
		var g: Vector3 = (player.avatar.global_transform * player.avatar.skeleton.transform
			* player.avatar.skeleton.get_bone_global_pose(player.avatar.bone_idx["head"])).origin
		cabeza = v.to_local(g).y + 0.12                     # + media cabeza
	print("[sentado] asiento %d · coronilla a %.2f m sobre el suelo del coche (el techo esta a %.2f) · %s" % [
		v.mi_asiento, cabeza, alto_v, "DENTRO" if cabeza < alto_v else "SE SALE POR EL TECHO"])
	print("[sentado] avatar: sentado %.2f · volante %s · visible %s" % [player.avatar.sentado,
		str(player.avatar.sentado_volante), str(player.avatar.visible)])
	_huesos_en_el_coche(v)
	if "--fotos" in OS.get_cmdline_user_args():
		await get_tree().create_timer(0.5).timeout
		get_viewport().get_texture().get_image().save_png("user://sentado.png")
	# DISPARANDO: dentro del coche no se dispara, asi que no tiene que pasar nada
	Input.action_press("fire")
	for i in 60:
		await get_tree().physics_frame
		cam.global_position = v.global_position + v.global_transform.basis * Vector3(3.2, 1.5, 2.6)
		cam.look_at(v.to_global(v.asiento_pos(maxi(0, v.mi_asiento))), Vector3.UP)
	print("[sentado] gatillo apretado: %s · deja disparar: %s (tiene que ser false)" % [
		str(Input.is_action_pressed("fire")), str(v.deja_disparar())])
	# OJO CON EL ORDEN: medir los huesos DESPUES de `salir()` decia "FUERA" y parecia un bug del coche.
	# Lo que estaba fuera era el jugador, que ya se habia bajado. Se mide aqui, todavia dentro.
	_huesos_en_el_coche(v)
	print("[sentado] con el gatillo apretado: sentado %.2f · balas %d (no se gastan)" % [
		player.avatar.sentado, int(player.ammo[player.current])])
	if "--fotos" in OS.get_cmdline_user_args():
		await get_tree().create_timer(0.5).timeout
		get_viewport().get_texture().get_image().save_png("user://asomado.png")
		print("[sentado] fotos en %s" % ProjectSettings.globalize_path("user://"))
	Input.action_release("fire")
	v.salir()
	await get_tree().physics_frame
	for i in 10:
		await get_tree().physics_frame
	print("[sentado] al bajar: sentado %.2f (0) · tercera persona %s (la que tenia) · cuerpo visible %s · arma %s · colision %d" % [
		player.avatar.sentado, str(player.third_person), str(player.avatar.visible),
		str(player.weapon_pivot.visible), player.collision_layer])
	get_tree().quit()


## DONDE ESTA CADA HUESO RESPECTO AL COCHE. Una foto no vale para esto (el propio coche tapa al muñeco):
## lo que se mira es si la cabeza, la pelvis y los pies caen dentro de la caja del vehiculo.
func _huesos_en_el_coche(v) -> void:
	var av = player.avatar
	if av == null or not is_instance_valid(av) or av.skeleton == null:
		print("[sentado] sin esqueleto que medir")
		return
	var tam: Array = v.ficha["tamano"]
	var caja := Vector3(float(tam[0]) * 0.5, float(tam[1]), float(tam[2]) * 0.5)
	var partes: Array = []
	for hueso in ["head", "pelvis", "foot_l", "hand_r"]:
		if not av.bone_idx.has(hueso):
			continue
		var g: Vector3 = (av.global_transform * av.skeleton.transform * av.skeleton.get_bone_global_pose(av.bone_idx[hueso])).origin
		var l: Vector3 = v.to_local(g)
		# el suelo de la cabina es el limite de abajo: por debajo, las piernas atraviesan la chapa
		var suelo_cab: float = float(v.ficha.get("suelo_cabina", 0.0)) - 0.12
		var dentro: bool = absf(l.x) <= caja.x + 0.05 and l.y >= suelo_cab and l.y <= caja.y and absf(l.z) <= caja.z
		partes.append("%s (%.2f, %.2f, %.2f) %s" % [hueso, l.x, l.y, l.z, "dentro" if dentro else "FUERA"])
	print("[sentado] huesos: %s" % " · ".join(partes))


## --pruebagolpes: ¿SE ABOLLA EL COCHE Y ME MATA LA ZONA DENTRO DE EL? Dos cosas de una: se estrella un
## coche contra una pared a fondo (tiene que perder vida y poder reventar) y se saca al jugador fuera del
## circulo METIDO EN EL COCHE, que tiene que seguir quitando vida.
##   --map=isla --pruebagolpes
func _prueba_golpes() -> void:
	for i in 150:
		await get_tree().physics_frame
	if is_instance_valid(salto_br):
		salto_br.queue_free()
	player.br_control = null
	player.invulnerable = false
	if vehiculos == null or not is_instance_valid(vehiculos):
		print("[golpes] el mapa no trae vehiculos")
		get_tree().quit()
		return
	# --- 1) estrellarse
	var centro := Vector3(CX_PRUEBA, 6.0, CZ_PRUEBA)
	player.global_position = centro
	world.set_player_position(centro)
	for i in 120:
		await get_tree().physics_frame
	var dir := Vector3.ZERO
	for g in 72:
		var d := Vector3(cos(TAU * g / 72.0), 0.0, sin(TAU * g / 72.0))
		var rr: Dictionary = world.raycast(centro + Vector3(0, 1.2, 0), d, 60.0)
		if rr.hit and centro.distance_to(rr.position) > 24.0:
			dir = d
			break
	var v = vehiculos._crear_en(centro - dir * 2.0, dir, "coche")
	await get_tree().physics_frame
	player.global_position = v.global_position + Vector3(0, 1.0, 0)
	v.entrar(player, 0)
	var vida0: float = v.vida
	var punta := 0.0
	for i in 420:
		Input.action_press("move_forward")
		await get_tree().physics_frame
		punta = maxf(punta, v.linear_velocity.length())
		if v.vida <= 0.0:
			break
	Input.action_release("move_forward")
	print("[golpes] estrellado a %.0f km/h: vida %.0f -> %.0f (%s)" % [punta * 3.6, vida0, v.vida,
		"REVENTADO" if v.vida <= 0.0 else "abollado"])
	# --- 2) la zona, yendo en coche
	if is_instance_valid(v) and v.conductor != null:
		pass
	else:
		v = vehiculos._crear_en(player.global_position + Vector3(2, 0, 0), Vector3.FORWARD, "coche")
		v.entrar(player, 0)
	if zona_br == null or not is_instance_valid(zona_br):
		print("[golpes] sin zona que probar")
		get_tree().quit()
		return
	zona_br.t = 260.0                       # ya hay muro y hace daño
	var lejos: Vector3 = zona_br.circulos[0] + Vector3(zona_br.circulos[0].y + 60.0, 0, 0)
	v.global_position = Vector3(lejos.x, v.global_position.y, lejos.z)
	player.health = 300.0
	for i in 240:
		await get_tree().physics_frame
	print("[golpes] fuera de la zona EN COCHE durante 4 s: vida %.0f de 300 (%s)" % [
		player.health, "la zona me hace daño" if player.health < 299.0 else "NO ME HACE NADA"])
	get_tree().quit()


## --pruebabotcoche: ¿SE VE UN BOT SENTADO POR LA VENTANILLA? Se sienta un bot en el asiento del
## conductor y se saca una foto desde fuera, a la altura de la ventanilla. Ademas se mide si sus huesos
## caen dentro de la caja del coche.
##   --map=isla --pruebabotcoche [--fotos]
func _prueba_bot_coche() -> void:
	for i in 150:
		await get_tree().physics_frame
	player.invulnerable = true
	if is_instance_valid(salto_br):
		salto_br.queue_free()
	player.br_control = null
	if vehiculos == null or not is_instance_valid(vehiculos):
		print("[botcoche] el mapa no trae vehiculos")
		get_tree().quit()
		return
	var idx := -1
	for i in vehiculos.puntos.size():
		if String(vehiculos.puntos[i]["tipo"]) == "coche":
			idx = i
			break
	var p: Vector3 = vehiculos.puntos[idx]["pos"]
	player.global_position = Vector3(p.x + 4.0, 20.0, p.z)
	world.set_player_position(player.global_position)
	for i in 240:
		await get_tree().physics_frame
	var v = vehiculos.nodos.get(idx)
	if v == null or not is_instance_valid(v):
		print("[botcoche] no se ha creado el coche")
		get_tree().quit()
		return
	# el bot mas cercano
	var bot = null
	var md := 1e9
	for e in enemies.get_children():
		if not is_instance_valid(e) or not ("health" in e) or float(e.health) <= 0.0:
			continue
		var d: float = e.global_position.distance_to(v.global_position)
		if d < md:
			md = d
			bot = e
	if bot == null:
		print("[botcoche] no hay bots vivos")
		get_tree().quit()
		return
	v.sentar_bot(bot, 0)
	# la camara, a la altura de la ventanilla del conductor y mirandola de frente
	var cam := Camera3D.new()
	cam.fov = 48.0
	add_child(cam)
	cam.make_current()
	for i in 90:
		await get_tree().physics_frame
		# un poco mas lejos y mas alto: pegada a la chapa solo se veia carroceria
		cam.global_position = v.global_position + v.global_transform.basis * Vector3(-5.5, 2.4, 2.2)
		cam.look_at(v.to_global(Vector3(0.0, 1.05, 0.1)), Vector3.UP)
	var caja := Vector3(float(v.ficha["tamano"][0]) * 0.5, float(v.ficha["tamano"][1]), float(v.ficha["tamano"][2]) * 0.5)
	var av = bot.get("avatar")
	var partes: Array = []
	if av != null and is_instance_valid(av) and av.skeleton != null:
		for hueso in ["head", "pelvis", "foot_l"]:
			if not av.bone_idx.has(hueso):
				continue
			var g: Vector3 = (av.global_transform * av.skeleton.transform * av.skeleton.get_bone_global_pose(av.bone_idx[hueso])).origin
			var l: Vector3 = v.to_local(g)
			var dentro: bool = absf(l.x) <= caja.x + 0.05 and l.y >= float(v.ficha.get("suelo_cabina", 0.0)) - 0.15 and l.y <= caja.y
			partes.append("%s (%.2f, %.2f, %.2f) %s" % [hueso, l.x, l.y, l.z, "dentro" if dentro else "FUERA"])
	print("[botcoche] bot sentado: %s" % " · ".join(partes))
	# diagnostico: materiales del coche (¿el cristal es transparente de verdad en Godot?) y la luz
	var mats: Array = []
	for n in v._mallas_de(v._cuerpo):
		var mi: MeshInstance3D = n
		for i in mi.mesh.get_surface_count():
			var mt: Material = mi.get_active_material(i)
			if mt == null:
				continue
			var tr := -1
			if mt is BaseMaterial3D:
				tr = int((mt as BaseMaterial3D).transparency)
			mats.append("%s(transp %d)" % [String(mt.resource_name), tr])
	print("[botcoche] materiales: %s" % " ".join(mats))
	print("[botcoche] luz interior: %s · avatar del bot visible %s" % [
		str(v._luz_dentro.visible) if v._luz_dentro else "-",
		str(bot.get("avatar").visible) if bot.get("avatar") else "-"])
	print("[botcoche] avatar del bot: sentado %.2f · volante %s" % [
		float(av.sentado) if av else -1.0, str(av.sentado_volante) if av else "-"])
	if "--fotos" in OS.get_cmdline_user_args():
		await get_tree().create_timer(0.5).timeout
		get_viewport().get_texture().get_image().save_png("user://bot_en_coche.png")
		print("[botcoche] foto: %sbot_en_coche.png" % ProjectSettings.globalize_path("user://"))
	get_tree().quit()


## --pruebaentrada: "APENAS ENTRO VEO TODO AGUA". Mira, segundo a segundo desde que empieza la partida,
## que hay debajo del avion (tierra o mar) y cuanto mundo se esta dibujando. Asi se distingue si el avion
## va sobre el mar (problema de ruta) o si va sobre la isla pero todavia no hay chunks (problema de
## carga), que desde dentro se ven igual: azul.
##   --map=isla --pruebaentrada
func _prueba_entrada() -> void:
	var filas: Array = []
	for seg in 14:
		await get_tree().create_timer(1.0).timeout
		var p: Vector3 = player.global_position
		if is_instance_valid(salto_br) and salto_br.has_method("punto_de_vista"):
			p = salto_br.punto_de_vista()
		var tam: Vector3 = world.get_world_size()
		var r: Dictionary = world.raycast(Vector3(p.x, tam.y - 0.5, p.z), Vector3.DOWN, tam.y)
		var suelo: float = float(r.position.y) if r.get("hit", false) else -1.0
		var mar: float = 3.0
		if is_instance_valid(agua) and agua.get("mar_y") != null:
			mar = float(agua.get("mar_y"))
		var st: Dictionary = world.get_stats()
		filas.append("t=%2d  (%4.0f,%4.0f) suelo %5.1f %s · chunks %d · regiones %d · ktris %d · fps %d" % [
			seg + 1, p.x, p.z, suelo, "TIERRA" if suelo > mar + 0.3 else "mar   ",
			int(st.get("chunks_visible", 0)), int(st.get("regions_visible", 0)),
			int(st.get("tris_visible", 0)) / 1000, Engine.get_frames_per_second()])
	for f in filas:
		print("[entrada] %s" % f)
	var estado := "?"
	if is_instance_valid(salto_br):
		estado = str(salto_br.estado)
	print("[entrada] estado del salto: %s (0 espera, 1 avion, 2 caida, 3 paracaidas)" % estado)
	get_tree().quit()


## --pruebabotszona: ¿SABEN LOS BOTS METERSE EN LA ZONA? Se adelanta el reloj de la zona, se deja correr
## y se cuenta cuantos bots estaban dentro al principio, cuantos al final y cuantos se quedaron fuera
## muriendose. Sin esto, lo unico que se sabe es que el codigo existe.
##   --map=isla --pruebabotszona [--minutos=N]
func _prueba_bots_zona() -> void:
	for i in 200:
		await get_tree().physics_frame
	player.invulnerable = true
	if zona_br == null or not is_instance_valid(zona_br):
		print("[botszona] no hay zona")
		get_tree().quit()
		return
	# NO SE QUITA EL AVION: los bots saltan de el. Quitandolo se quedaban congelados esperando y la
	# medicion decia "0 bots dentro" siempre, que no era culpa de la IA sino de la prueba.
	# SE ESPERA A QUE HAYAN SALTADO TODOS. Los bots empiezan congelados dentro del avion y van saltando
	# a lo largo de la ruta; cortando antes, los que quedaban dentro del avion no se movian ni recibian
	# daño, y la medicion decia "los bots no entran en la zona" cuando lo que pasaba es que ni existian.
	var esperados := 0
	var igual := 0
	for seg in 120:
		await get_tree().create_timer(1.0).timeout
		var en_suelo := 0
		for e in enemies.get_children():
			if is_instance_valid(e) and ("health" in e) and float(e.health) > 0.0 and e.process_mode != Node.PROCESS_MODE_DISABLED:
				en_suelo += 1
		igual = igual + 1 if en_suelo == esperados else 0
		esperados = en_suelo
		if igual >= 8 and esperados > 0:
			break
	var total := 0
	for e in enemies.get_children():
		if is_instance_valid(e) and ("health" in e) and float(e.health) > 0.0:
			total += 1
	print("[botszona] tras el salto: %d de %d bots andando por el mapa" % [esperados, total])
	if is_instance_valid(salto_br):
		salto_br.queue_free()
	player.br_control = null
	var minutos := 2.0
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--minutos="):
			minutos = float(a.substr(10))
	# a los bots se les pone ya en el suelo, repartidos, y el reloj de zona bien avanzado
	# --relojzona: en que segundo de la partida se pone la zona. Con un reloj alto el circulo ya es
	# pequeño, que es cuando de verdad se ve si los bots saben migrar.
	var reloj := 200.0
	for a2 in OS.get_cmdline_user_args():
		if a2.begins_with("--relojzona="):
			reloj = float(a2.substr(12))
	zona_br.t = reloj
	await get_tree().create_timer(1.0).timeout
	var objetivo: Vector3 = zona_br.muro()
	var vivos_ini := 0
	var dentro_ini := 0
	for e in enemies.get_children():
		if not is_instance_valid(e) or not ("health" in e) or float(e.health) <= 0.0:
			continue
		vivos_ini += 1
		if zona_br.dentro(e.global_position):
			dentro_ini += 1
	print("[botszona] al empezar: %d bots vivos, %d dentro del circulo (centro %.0f,%.0f radio %.0f)" % [
		vivos_ini, dentro_ini, objetivo.x, objetivo.z, objetivo.y])
	var pasos := int(minutos * 6.0)
	for k in pasos:
		await get_tree().create_timer(10.0).timeout
		var dentro := 0
		var vivos := 0
		for e in enemies.get_children():
			if not is_instance_valid(e) or not ("health" in e) or float(e.health) <= 0.0:
				continue
			vivos += 1
			if zona_br.dentro(e.global_position):
				dentro += 1
		print("[botszona] t+%3ds · vivos %2d · dentro %2d (%d%%) · radio %.0f" % [
			(k + 1) * 10, vivos, dentro, int(100.0 * dentro / maxi(1, vivos)), zona_br.muro().y])
	get_tree().quit()


## --pruebaskinpartida: ¿SE VE LA SKIN EN PARTIDA, Y SUS EFECTOS? Equipa una skin en el arma que llevas,
## y cuenta cuantas piezas del arma estan pintadas y cuantas llevan la pasada de luz, en el arma de
## primera persona Y en el muñeco de tercera (que es lo que ven los demas). Con --fotos, dos capturas.
##   --map=isla --pruebaskinpartida [--skin=sk_dragon] [--fotos]
func _prueba_balas_vehiculo() -> void:
	for i in 260:
		await get_tree().physics_frame
	player.invulnerable = true
	if is_instance_valid(salto_br):
		salto_br.queue_free()
	player.br_control = null
	var g = get_tree().get_first_node_in_group("vehiculos_gestor")
	if g == null:
		print("[balasveh] no hay gestor de vehiculos en este mapa")
		get_tree().quit()
		return
	# LOS VEHICULOS SOLO EXISTEN CERCA DEL JUGADOR (lejos no hay ni suelo de fisica), asi que primero
	# hay que ir hasta su sitio y esperar a que el gestor los monte.
	var quiero := {"coche": null, "helicoptero": null}
	for tipo in ["coche", "helicoptero"]:
		var punto := Vector3.ZERO
		var hay := false
		for pt in g.puntos:
			if String(pt.get("tipo", "")) == tipo or (tipo == "coche" and String(pt.get("tipo", "")) == "todoterreno"):
				punto = pt["pos"]
				hay = true
				break
		if not hay:
			continue
		# LA Y DEL PUNTO ES 0 en el archivo (el gestor ya lo posa en el suelo): hay que buscar la
		# altura de verdad o el jugador aparece bajo tierra y el vehiculo no llega a montarse.
		var yt := _altura_en(punto.x + 7.0, punto.z)
		player.global_position = Vector3(punto.x + 7.0, (yt if not is_nan(yt) else 0.0) + 1.2, punto.z)
		for _f in 300:
			await get_tree().physics_frame
		for k in g.nodos.keys():
			var v = g.nodos[k]
			if is_instance_valid(v) and Vector2(v.global_position.x - punto.x, v.global_position.z - punto.z).length() < 12.0:
				quiero[tipo] = v
				break
	var coche = quiero["coche"]
	var heli = quiero["helicoptero"]
	if coche == null:
		print("[balasveh] no he encontrado ningun coche")
	else:
		var v0: float = coche.vida
		player.global_position = coche.global_position + Vector3(6.0, 0.6, 0)
		player.coger_arma("carabina_556", 0)
		player.switch_weapon(0)
		await get_tree().create_timer(0.6).timeout
		player.look_at_point(coche.global_position + Vector3(0, 0.9, 0))
		await get_tree().create_timer(0.4).timeout
		var tiros := 0
		for k2 in 90:
			if not is_instance_valid(coche) or coche._roto:
				break
			player.fire()
			tiros += 1
			await get_tree().create_timer(0.09).timeout
		var reventado: bool = not is_instance_valid(coche) or coche._roto
		var vida_fin: float = 0.0 if reventado else coche.vida
		var balazos: int = 0 if reventado else int(coche.balazos)
		print("[balasveh] coche: vida %.0f -> %.0f con %d tiros · %s" % [
			v0, vida_fin, tiros, "REVENTADO" if reventado else "sigue entero"])
		if not reventado and balazos == 0:
			print("[balasveh] MAL: ni un balazo le ha entrado (sigue siendo a prueba de balas)")
	# --- 2) LA HELICE CORTA ------------------------------------------------------------------------
	if heli == null:
		print("[balasveh] no hay helicoptero en el mapa")
	else:
		# se le pone una pared delante, a la altura del rotor, y se arranca
		var w = g.world
		var centro: Vector3 = heli.global_position
		heli._motor_on = true
		heli._colectivo = 1.0
		var antes: int = int(heli.cortados)
		var vida0: float = heli.vida
		# un bot justo en el disco del rotor: tiene que morir
		var victima = null
		for e in enemies.get_children():
			victima = e
			break
		if victima != null and is_instance_valid(victima):
			victima.global_position = centro + Vector3(2.2, 1.6, 0)
		await get_tree().create_timer(1.5).timeout
		var rad: float = float(heli._rotores[0][3]) if not heli._rotores.is_empty() else -1.0
		var cen: Vector3 = (heli._rotores[0][0] as Node3D).global_position if not heli._rotores.is_empty() else Vector3.ZERO
		print("[balasveh]    motor %s · colectivo %.2f · %d rotores · radio %.2f · el bot a %.2f m del centro del disco · en grupo enemies: %s" % [
			str(heli._motor_on), float(heli._colectivo), heli._rotores.size(), rad,
			victima.global_position.distance_to(cen) if victima != null and is_instance_valid(victima) else -1.0,
			str(victima.is_in_group("enemies")) if victima != null and is_instance_valid(victima) else "?"])
		var muerto: bool = victima == null or not is_instance_valid(victima) or float(victima.health) <= 0.0
		print("[balasveh] helice: %d cosas cortadas en 1,5 s · el bot de al lado %s · el heli se ha gastado %.0f de vida" % [
			int(heli.cortados) - antes, "MUERTO" if muerto else "sigue vivo", vida0 - heli.vida])
		# --- 3) Y CONTRA UNA PARED: el disco metido en el terreno tiene que abrir boquete -----------
		var c2: Vector3 = heli.global_position
		var yt2 := _altura_en(c2.x, c2.z)
		if not is_nan(yt2):
			# EL GESTOR SACA DEL SUELO lo que se hunde (vehiculos.gd, "SE HA HUNDIDO"), asi que hay que
			# decirle que este lo lleva alguien: es lo que pasa de verdad cuando vuelas contra un muro.
			g.conduciendo = heli
			heli.freeze = true
			heli.global_position = Vector3(c2.x, yt2 - 1.6, c2.z)      # el rotor, dentro del suelo
			var caja_a: Vector3 = heli.global_position + Vector3(-6.0, 1.0, -6.0)
			var caja_b: Vector3 = heli.global_position + Vector3(6.0, 4.0, 6.0)
			var antes_vox: int = int(world.contar_voxels(caja_a, caja_b))
			var cortados0: int = int(heli.cortados)
			var vida1: float = heli.vida
			await get_tree().create_timer(2.5).timeout
			var ahora_vox: int = int(world.contar_voxels(caja_a, caja_b))
			print("[balasveh] helice contra el suelo: %d mordiscos, %d voxels menos, el heli se gasta %.0f de vida en 2,5 s" % [
				int(heli.cortados) - cortados0, antes_vox - ahora_vox, vida1 - heli.vida])
			print("[balasveh] %s" % ("BIEN: corta" if antes_vox - ahora_vox > 200 else "MAL: no corta el mundo"))
	get_tree().quit()


# ---------------------------------------------------------------------------------------------------
# --diagvivo: MIRAR LA PARTIDA POR ENCIMA DEL HOMBRO.
#
# Se juega normal y el juego va contando por la consola lo que pasa. Dos cosas:
#   * sale un aviso si el marcador de acierto (las cuatro rayas de la mira) se queda puesto;
#   * con F9 se vuelca lo que hay JUSTO DELANTE: los bloques caidos que tienes a mano, su tamaño, si
#     estan quietos, y -lo importante- si la FISICA los ve. Un tronco que se atraviesa andando es
#     un bloque que el rayo si encuentra y la capsula no.
# ---------------------------------------------------------------------------------------------------
var _vivo := false

func _diag_vivo_listo() -> void:
	_vivo = "--diagvivo" in OS.get_cmdline_user_args()
	if _vivo:
		print("[vivo] diagnostico en vivo encendido. F9 (o L, o la coma) vuelca lo que tengas delante.")
		if world != null and not world.piece_detached.is_connected(_vivo_desprende):
			world.piece_detached.connect(_vivo_desprende)


## CADA TROZO QUE SE DESPRENDE. Para mirar por encima del hombro un experimento de estructura: se
## rompen las patas de una mesa y se quiere ver si el tablero CAE (sale una linea por cada trozo) o
## se queda flotando (no sale ninguna).
func _vivo_desprende(pos: Vector3, voxels: int, material: int) -> void:
	if not _vivo:
		return
	_vivo_sueltos += 1
	_vivo_vox_sueltos += voxels
	# solo se cuentan los pequeños; los trozos de verdad se cantan uno a uno
	if voxels >= 40:
		print("[vivo] SE DESPRENDE un trozo de %d voxels en %s (material %d)" % [voxels, str(pos.round()), material])


var _vivo_sueltos := 0
var _vivo_vox_sueltos := 0
var _vivo_est_t := 0.0
var _vivo_est_antes := {}

## ¿HAY ALGO FLOTANDO AQUI AL LADO?
##
## El tablero de una mesa a la que le han roto las patas NO es un bloque caido: siguen siendo voxels
## del MUNDO, pegados al mapa aunque debajo no haya nada. Por eso no sale en ningun contador de
## bloques y por eso no se podia "ver" desde el log. Esto lo mira a lo bruto: se barre una rejilla
## alrededor del jugador y, columna a columna, se busca materia con AIRE debajo hasta el suelo.
##
## Se avisa solo cuando cambia la cuenta, para no repetir lo mismo cada tres segundos.
var _flota_t := 0.0
var _flota_antes := -1

func _diag_flotando(dt: float) -> void:
	if not _vivo or player == null or not is_instance_valid(player) or world == null:
		return
	_flota_t -= dt
	if _flota_t > 0.0:
		return
	_flota_t = 3.0
	# DONDE MIRAR. Alrededor del jugador de ESTA maquina... y tambien de los de las otras: en una sala
	# LAN quien rompe la mesa suele ser el del movil, y mirando solo aqui el anfitrion no ve nada.
	var sitios: Array = [player.global_position]
	if Net.remotes != null:
		for k in Net.remotes.keys():
			var rp = Net.remotes[k]
			if is_instance_valid(rp):
				sitios.append(rp.global_position)
	var columnas := 0
	var ejemplo := Vector3.ZERO
	var alto_ej := 0.0
	var paso := 0.5
	var r := 4.0
	for p in sitios:
		var x := -r
		while x <= r:
			var z := -r
			while z <= r:
				var desde := Vector3(p.x + x, p.y + 6.0, p.z + z)
			# 1) lo primero que hay mirando hacia abajo
				var a: Dictionary = world.raycast(desde, Vector3.DOWN, 9.0)
				if not a.get("hit", false):
					z += paso
					continue
				var techo: Vector3 = a["position"]
				# 2) desde justo debajo de eso, ¿cuanto aire hay hasta lo siguiente?
				var b: Dictionary = world.raycast(techo - Vector3(0, 0.30, 0), Vector3.DOWN, 9.0)
				var hueco: float = 9.0 if not b.get("hit", false) else (techo.y - 0.30 - float((b["position"] as Vector3).y))
				# medio metro de aire debajo de algo solido: eso esta colgado
				if hueco > 0.5:
					columnas += 1
					if hueco > alto_ej:
						alto_ej = hueco
						ejemplo = techo
				z += paso
			x += paso
	if columnas != _flota_antes:
		_flota_antes = columnas
		if columnas > 0:
			print("[vivo] FLOTANDO: %d columnas de materia con aire debajo · la peor en %s con %.1f m de hueco" % [
				columnas, str(ejemplo.round()), alto_ej])
		else:
			print("[vivo] FLOTANDO: nada colgado aqui al lado")


## EL LATIDO DE LA ESTRUCTURA. Cada dos segundos, y SOLO si algo ha cambiado: cuantos trozos se han
## soltado, cuantos analisis estructurales han fallado (o sea, cuanto se ha venido abajo por su peso)
## y cuantos bloques hay. Si rompes una pata y no se mueve ni un numero, es que el juego no se ha
## enterado: eso es justo lo que se quiere cazar.
func _diag_estructura(dt: float) -> void:
	if not _vivo or world == null or not world.has_method("get_stats"):
		return
	_vivo_est_t -= dt
	if _vivo_est_t > 0.0:
		return
	_vivo_est_t = 2.0
	var st: Dictionary = world.get_stats()
	var ahora := {
		"sueltos": _vivo_sueltos,
		"fallos": int(st.get("struct_failures", 0)),
		"islas": int(st.get("struct_islands", 0)),
		"bloques": int(st.get("bodies_total", 0)),
		"quietos": int(st.get("piezas_congeladas", 0)),
		"apoyos_rotos": int(st.get("apoyos_rotos", 0)),
	}
	if ahora == _vivo_est_antes:
		return
	var cambios: Array = []
	for k in ahora.keys():
		var a: int = int(_vivo_est_antes.get(k, 0))
		if int(ahora[k]) != a:
			cambios.append("%s %d (antes %d)" % [k, int(ahora[k]), a])
	_vivo_est_antes = ahora
	if not cambios.is_empty():
		print("[vivo] estructura: %s · %d voxels sueltos en total" % [" · ".join(cambios), _vivo_vox_sueltos])


## La tecla para volcar a mano. F9 no vale en todos los teclados (el del usuario no tiene teclas F),
## asi que tambien valen la L y la coma.
func _diag_vivo_tecla(e: InputEvent) -> void:
	if not _vivo or not (e is InputEventKey) or not (e as InputEventKey).pressed or (e as InputEventKey).echo:
		return
	var k: int = (e as InputEventKey).keycode
	if k != KEY_F9 and k != KEY_L and k != KEY_COMMA:
		return
	_volcar_delante()


## Volcar a mano lo que hay delante (tecla L o coma). Lo mismo que hace el vigilante, pero cuando
## tu quieras y con mas detalle.
func _volcar_delante() -> void:
	if player == null or not is_instance_valid(player) or world == null:
		return
	var p: Vector3 = player.global_position
	var fwd: Vector3 = -player.global_transform.basis.z
	fwd.y = 0.0
	fwd = fwd.normalized() if fwd.length_squared() > 0.01 else Vector3.FORWARD
	print("[vivo] --------- volcado en %s ---------" % str(p.round()))
	for alto in [0.25, 0.6, 1.1, 1.6]:
		var desde: Vector3 = p + Vector3(0, alto, 0)
		var m: Dictionary = world.raycast_con_piezas(desde, fwd, 4.0) if world.has_method("raycast_con_piezas") 			else world.raycast(desde, fwd, 4.0)
		var choca: bool = player.test_move(Transform3D(player.global_transform.basis,
			p + Vector3(0, alto - 0.9, 0)), fwd * 1.0)
		print("[vivo]   a %.2f m de alto: el motor %s · la capsula %s" % [
			alto, ("ve algo a %.2f m (material %d)" % [desde.distance_to(m["position"]), int(m.get("material", -1))]) if m.get("hit", false) else "no ve nada",
			"choca" if choca else "NO choca"])
	# LO QUE HAY BAJO LA MIRA: para el escombro que flota o que no se rompe, se apunta y se pulsa L
	# el rayo de TU mira (player._aim_ray), no el de la camara activa del viewport: esa podia ser otra
	# (la del minimapa) y el volcado decia "nada a 30 m" con la mira encima de un bloque a 5 m
	if player.has_method("_aim_ray") and world.has_method("raycast_con_piezas"):
		var ar: Array = player._aim_ray(30.0)
		var o: Vector3 = ar[0]
		var dv: Vector3 = ar[1]
		var h: Dictionary = world.raycast_con_piezas(o, dv, 30.0)
		if not h.get("hit", false):
			print("[vivo]   la mira: nada a 30 m")
		else:
			var hp: Vector3 = h["position"]
			var b: Dictionary = world.raycast(hp + Vector3(0, -0.05, 0), Vector3.DOWN, 20.0)
			var bajo := ("%.2f m de aire debajo" % (hp.y - float((b["position"] as Vector3).y))) if b.get("hit", false) else "nada debajo en 20 m"
			print("[vivo]   la mira: a %.1f m en %s, material %d · %s · %s" % [o.distance_to(hp), str(hp.snapped(Vector3.ONE * 0.1)),
				int(h.get("material", -1)),
				("BLOQUE %d (%d voxels, solido %s, con cuerpo %s)" % [int(h["pieza_id"]), int(h.get("pieza_vox", 0)),
					str(h.get("pieza_solida", false)), str(h.get("pieza_con_cuerpo", false))]) if h.get("pieza", false) else "voxels del MUNDO",
				bajo])
			# y lo que dice JOLT de ese mismo rayo: si hay cuerpo, en que estado lo tiene el motor
			var q := PhysicsRayQueryParameters3D.create(o, o + dv * 30.0)
			q.exclude = [player.get_rid()]
			var f: Dictionary = player.get_world_3d().direct_space_state.intersect_ray(q)
			if f.is_empty():
				print("[vivo]   la mira en Jolt: NINGUN cuerpo (se veria pero no se toca)")
			else:
				var info: Dictionary = world.info_cuerpo(f["rid"]) if world.has_method("info_cuerpo") else {}
				print("[vivo]   la mira en Jolt: cuerpo a %.1f m · %s" % [o.distance_to(f["position"]),
					str(info) if info.get("existe", false) else "no es un bloque (suelo/mundo u otro)"])
		print("[vivo]   cuerpos de fisica %d · bloques %d" % [int(world.get_body_count()),
			int(world.censo_bloques().size() / 2) if world.has_method("censo_bloques") else -1])


## EL VIGILANTE. Cada poco pregunta dos cosas sobre lo que hay justo delante:
##
##   1. ¿lo ve el MOTOR? (`raycast_con_piezas`: los voxels y los bloques caidos)
##   2. ¿CHOCA el jugador con ello? (`test_move` con SU capsula y SU mascara de colision)
##
## Si el motor lo ve y la capsula no choca, eso es lo que se atraviesa andando. La primera version
## comparaba con un rayo de fisica cualquiera y no cazo nada: un rayo suelto mira TODAS las capas,
## asi que un cuerpo que el jugador no tiene por que chocar le salia como "si lo ve" y no avisaba.
## Lo unico que vale es preguntarselo al propio jugador.
var _vivo_t := 0.0
var _vivo_callar := 0.0
var _vivo_avisos := 0
var _vivo_latido := 0.0

func _diag_vivo_tick(dt: float) -> void:
	if not _vivo or player == null or not is_instance_valid(player) or world == null:
		return
	_vivo_callar -= dt
	_vivo_t -= dt
	_vivo_latido -= dt
	if _vivo_t > 0.0:
		return
	_vivo_t = 0.25
	if float(player.health) <= 0.0:
		return
	# hacia donde va (si esta quieto, hacia donde mira)
	var v := Vector3(player.velocity.x, 0.0, player.velocity.z)
	var andando: bool = v.length() > 0.8
	var dir: Vector3 = v.normalized() if andando else -player.global_transform.basis.z
	dir.y = 0.0
	if dir.length_squared() < 0.01:
		return
	dir = dir.normalized()
	# ¿choca la capsula del jugador con algo en el siguiente metro?
	var choca: bool = player.test_move(player.global_transform, dir * 1.0)
	# ¿y el motor, ve algo ahi? a ras de suelo, a la rodilla y al pecho (un tronco tumbado es bajo)
	var visto := {}
	var alto_visto := 0.0
	for alto in [0.25, 0.6, 1.1]:
		var desde: Vector3 = player.global_position + Vector3(0, alto, 0)
		var m: Dictionary = world.raycast_con_piezas(desde, dir, 1.1) if world.has_method("raycast_con_piezas") \
			else world.raycast(desde, dir, 1.1)
		if m.get("hit", false):
			visto = m
			alto_visto = alto
			break
	if not visto.is_empty() and not choca and _vivo_callar <= 0.0:
		_vivo_callar = 4.0
		_vivo_avisos += 1
		print("[vivo]    el trozo: id %s · %s voxels · solido %s · con cuerpo %s" % [
			str(visto.get("pieza_id", "?")), str(visto.get("pieza_vox", "?")),
			str(visto.get("pieza_solida", "?")), str(visto.get("pieza_con_cuerpo", "?"))])
		print("[vivo] ¡SE ATRAVIESA! el motor ve algo a %.2f m (altura %.2f, material %d, en %s) y la capsula del jugador NO choca" % [
			player.global_position.distance_to(visto["position"]), alto_visto,
			int(visto.get("material", -1)), str((visto["position"] as Vector3).round())])
		if world.has_method("get_body_count") and world.has_method("censo_bloques"):
			print("[vivo]    cuerpos de fisica %d · bloques %d · es pieza: %s" % [
				int(world.get_body_count()), int(world.censo_bloques().size() / 2),
				str(bool(visto.get("pieza", false)))])
		# ¿ESTA EL CUERPO Y NO LO VEMOS, O NO ESTA? Tres preguntas a la fisica de Godot en el mismo
		# sitio: con la mascara del jugador, con TODAS las capas, y que hay tocando el punto.
		var esp := get_world_3d().direct_space_state
		var desde2: Vector3 = player.global_position + Vector3(0, alto_visto, 0)
		var q1 := PhysicsRayQueryParameters3D.create(desde2, desde2 + dir * 1.1)
		q1.exclude = [player.get_rid()]
		q1.collision_mask = player.collision_mask
		var r1 = esp.intersect_ray(q1)
		var q2 := PhysicsRayQueryParameters3D.create(desde2, desde2 + dir * 1.1)
		q2.exclude = [player.get_rid()]
		q2.collision_mask = 0xFFFFFFFF
		var r2 = esp.intersect_ray(q2)
		var forma := PhysicsShapeQueryParameters3D.new()
		var bola := SphereShape3D.new()
		bola.radius = 0.35
		forma.shape = bola
		forma.transform = Transform3D(Basis.IDENTITY, visto["position"])
		forma.collision_mask = 0xFFFFFFFF
		forma.exclude = [player.get_rid()]
		var tocando: Array = esp.intersect_shape(forma, 8)
		print("[vivo]    la fisica de Godot: con la mascara del jugador (%d) %s · con TODAS las capas %s · cuerpos tocando el punto: %d" % [
			int(player.collision_mask), "SI lo ve" if r1 else "no lo ve",
			"SI lo ve" if r2 else "NO lo ve", tocando.size()])
		return
	# LATIDO: cada 20 s una linea, para saber que esto sigue mirando y que ve
	if _vivo_latido <= 0.0:
		_vivo_latido = 20.0
		print("[vivo] (vigilando) en %s · delante: motor %s, capsula %s · %d avisos hasta ahora" % [
			str(player.global_position.round()),
			("algo a %.2f m" % player.global_position.distance_to(visto["position"])) if not visto.is_empty() else "nada",
			"choca" if choca else "no choca", _vivo_avisos])


func _prueba_bots_armas() -> void:
	for i in 260:
		await get_tree().physics_frame
	player.invulnerable = true
	# NO SE TIRA EL AVION TODAVIA: la primera mitad de la prueba es justo comprobar que mientras el
	# jugador sigue volando los bots NO se arman. (Fingirlo poniendo `br_control = self` no vale: el
	# jugador le llama `paso_jugador` a lo que haya ahi y main.gd no lo tiene.)
	var sin := 0
	var con := 0
	for e in enemies.get_children():
		if "sin_arma" in e:
			if bool(e.sin_arma): sin += 1
			else: con += 1
	print("[botsarmas] al empezar: %d bots sin arma, %d con arma" % [sin, con])
	# 1) MIENTRAS VUELA, NADIE SE ARMA
	var volando: bool = player.br_control != null
	await get_tree().create_timer(30.0).timeout
	var armados_en_vuelo := 0
	for e9 in enemies.get_children():
		if ("sin_arma" in e9) and not bool(e9.sin_arma):
			armados_en_vuelo += 1
	print("[botsarmas] 30 s despues (el jugador %s): %d bots armados" % [
		"iba en el avion" if volando else "YA ESTABA EN EL SUELO (la prueba no vale)", armados_en_vuelo])
	# 2) ahora aterriza y empieza su reloj
	if is_instance_valid(salto_br):
		salto_br.queue_free()
	player.br_control = null
	# que no disparen mientras esten desarmados
	var disparos := 0
	for e2 in enemies.get_children():
		if "shots_fired" in e2:
			disparos += int(e2.shots_fired)
	# y que lleguen a un arma: se les deja 60 s
	var t0: float = float(Time.get_ticks_msec()) / 1000.0
	var armados := 0
	for k in 60:
		await get_tree().create_timer(1.0).timeout
		armados = 0
		for e3 in enemies.get_children():
			if ("sin_arma" in e3) and not bool(e3.sin_arma):
				armados += 1
		if armados >= maxi(1, sin / 3):
			break
	print("[botsarmas] a los %.0f s: %d de %d ya han cogido un arma" % [
		float(Time.get_ticks_msec()) / 1000.0 - t0, armados, sin])
	print("[botsarmas] %s" % ("BIEN" if sin > 0 and armados > 0 else "MAL: %s" % (
		"nacen con arma" if sin == 0 else "ninguno encuentra arma")))
	get_tree().quit()


func _prueba_heli() -> void:
	for i in 260:
		await get_tree().physics_frame
	player.invulnerable = true
	if is_instance_valid(salto_br):
		salto_br.queue_free()
	player.br_control = null
	var g = get_tree().get_first_node_in_group("vehiculos_gestor")
	if g == null:
		print("[heli] este mapa no trae vehiculos")
		get_tree().quit()
		return
	var punto := Vector3.ZERO
	for pt in g.puntos:
		if String(pt.get("tipo", "")) == "helicoptero":
			punto = pt["pos"]
			break
	var yt := _altura_en(punto.x + 6.0, punto.z)
	player.global_position = Vector3(punto.x + 6.0, (yt if not is_nan(yt) else 0.0) + 1.2, punto.z)
	for _f in 300:
		await get_tree().physics_frame
	var heli = null
	for k in g.nodos.keys():
		var v = g.nodos[k]
		if is_instance_valid(v) and v.tipo == "helicoptero":
			heli = v
			break
	if heli == null:
		print("[heli] no se ha montado el helicoptero")
		get_tree().quit()
		return
	# subirse y despegar
	heli.entrar(player, 0)
	await get_tree().create_timer(0.5).timeout
	heli._motor_on = true
	print("[heli] al volante: %s · masa %.0f kg" % [str(heli.conductor != null), heli.mass])
	# 1) SUBIR
	var y0: float = heli.global_position.y
	Input.action_press("jump")
	for k2 in 30:
		await get_tree().create_timer(0.1).timeout
	Input.action_release("jump")
	var subido: float = heli.global_position.y - y0
	print("[heli] SUBIR con el salto 3 s: +%.1f m (%.1f m/s)" % [subido, subido / 3.0])
	# 2) ADELANTE: inclinacion y velocidad
	var v0: Vector3 = heli.linear_velocity
	Input.action_press("move_forward")
	var inc_max := 0.0
	var vmax := 0.0
	var t_a_20 := -1.0
	var t := 0.0
	for k3 in 60:
		await get_tree().create_timer(0.1).timeout
		t += 0.1
		var b: Basis = heli.global_transform.basis
		var morro: Vector3 = -b.z
		inc_max = maxf(inc_max, -morro.y)          # cuanto pica el morro hacia abajo
		var vh: float = Vector2(heli.linear_velocity.x, heli.linear_velocity.z).length()
		vmax = maxf(vmax, vh)
		if t_a_20 < 0.0 and vh >= 20.0:
			t_a_20 = t
	Input.action_release("move_forward")
	print("[heli] ADELANTE con W: se inclina %.0f grados · punta %.1f m/s (%.0f km/h) · tarda %s en ponerse a 20 m/s" % [
		rad_to_deg(asin(clampf(inc_max, -1.0, 1.0))), vmax, vmax * 3.6,
		("%.1f s" % t_a_20) if t_a_20 > 0.0 else "no llega"])
	# 2b) ATRAS Y COSTADOS: lo mismo, que el usuario los pidio igual
	for par in [["move_back", "ATRAS"], ["move_left", "IZQUIERDA"], ["move_right", "DERECHA"]]:
		await get_tree().create_timer(1.2).timeout
		heli.linear_velocity = Vector3(0, heli.linear_velocity.y, 0)
		var incm := 0.0
		var vm := 0.0
		Input.action_press(String(par[0]))
		for k5 in 35:
			await get_tree().create_timer(0.1).timeout
			var bb: Basis = heli.global_transform.basis
			# cuanto se tumba: el angulo entre su "arriba" y el de verdad
			incm = maxf(incm, acos(clampf(bb.y.dot(Vector3.UP), -1.0, 1.0)))
			vm = maxf(vm, Vector2(heli.linear_velocity.x, heli.linear_velocity.z).length())
		Input.action_release(String(par[0]))
		print("[heli] %s: se tumba %.0f grados · punta %.1f m/s (%.0f km/h)" % [
			String(par[1]), rad_to_deg(incm), vm, vm * 3.6])
	await get_tree().create_timer(1.5).timeout
	# 3) BAJAR
	var y1: float = heli.global_position.y
	Input.action_press("crouch")
	for k4 in 30:
		await get_tree().create_timer(0.1).timeout
	Input.action_release("crouch")
	var bajado: float = y1 - heli.global_position.y
	print("[heli] BAJAR agachandose 3 s: %.1f m (%.1f m/s)" % [bajado, bajado / 3.0])
	# 3b) LOS MANDOS DEL MOVIL. Es lo que estaba roto: dentro del vehiculo solo se miraba el teclado.
	heli.global_position += Vector3(0, 12.0, 0)
	heli.linear_velocity = Vector3.ZERO
	await get_tree().create_timer(0.8).timeout
	var ym: float = heli.global_position.y
	player.touch_vehiculo = Vector3(0, 0, 1)          # el boton SUBIR, apretado
	for k6 in 20:
		await get_tree().create_timer(0.1).timeout
	var sube_movil: float = heli.global_position.y - ym
	# parado y con el colectivo a cero antes de medir la bajada: si no, se mide la inercia y el paso
	# que traia de la subida, no el mando
	heli.linear_velocity = Vector3.ZERO
	heli._colectivo = 0.0
	await get_tree().create_timer(0.3).timeout
	ym = heli.global_position.y
	player.touch_vehiculo = Vector3(0, 0, -1)         # el boton BAJAR
	for k7 in 20:
		await get_tree().create_timer(0.1).timeout
	var baja_movil: float = ym - heli.global_position.y
	player.touch_vehiculo = Vector3.ZERO
	print("[heli] MANDOS DEL MOVIL: SUBIR %+.1f m en 2 s · BAJAR %+.1f m en 2 s" % [sube_movil, baja_movil])
	# y que el pad se monte con sus cuatro botones
	var MC := preload("res://scripts/mobile_controls.gd")
	var mc = MC.new()
	add_child(mc)
	mc.setup(player)
	mc._mostrar_pad(heli)
	var etiquetas: Array = []
	if mc._pad != null and is_instance_valid(mc._pad):
		for c in mc._pad.get_children():
			if c is Button:
				etiquetas.append(String((c as Button).text))
	print("[heli] el pad del movil trae %d botones: %s" % [etiquetas.size(), " · ".join(etiquetas)])
	await get_tree().create_timer(1.2).timeout
	print("[heli] la camara queda a %.1f m del helicoptero (antes 3,1 m)" % [
		player.cam.global_position.distance_to(heli.global_position)])
	mc.queue_free()
	# 4) LAS HELICES, VOLANDO: contra una ladera
	var cortes0: int = int(heli.cortados)
	var pared := Vector3.ZERO
	var tam: Vector3 = world.get_world_size()
	for r in 400:
		var px: float = randf_range(20.0, tam.x - 20.0)
		var pz: float = randf_range(20.0, tam.z - 20.0)
		var h0 := _altura_en(px, pz)
		var h1 := _altura_en(px + 6.0, pz)
		if not is_nan(h0) and not is_nan(h1) and h1 - h0 > 8.0:
			pared = Vector3(px, h0, pz)
			break
	if pared == Vector3.ZERO:
		print("[heli] no he encontrado un talud para probar las helices")
	else:
		heli.freeze = true
		heli.global_position = pared + Vector3(4.2, 3.0, 0)
		heli._colectivo = 0.0                     # volando llano, que es como se va normalmente
		heli._motor_on = true
		var caja_a: Vector3 = heli.global_position + Vector3(-7, -1, -7)
		var caja_b: Vector3 = heli.global_position + Vector3(7, 5, 7)
		var vox0: int = int(world.contar_voxels(caja_a, caja_b))
		await get_tree().create_timer(2.5).timeout
		var vox1: int = int(world.contar_voxels(caja_a, caja_b))
		print("[heli] HELICES contra el talud (colectivo a cero): %d mordiscos, %d voxels menos" % [
			int(heli.cortados) - cortes0, vox0 - vox1])
		print("[heli] %s" % ("BIEN: corta volando" if vox0 - vox1 > 150 else "MAL: las helices atraviesan"))
		# 5) CHOCAR CONTRA LA PARED VOLANDO, que es el caso de verdad: se suelta a 18 m del talud y se
		#    le da gas de frente. Aqui lo que toca la pared son LAS PUNTAS de las palas.
		heli.freeze = false
		heli._roto = false
		heli.vida = heli.vida_max
		heli.global_position = pared + Vector3(18.0, 4.0, 0)
		heli.linear_velocity = Vector3.ZERO
		heli.global_rotation = Vector3(0, -PI * 0.5, 0)      # de morro hacia el talud (-x)
		player.look_at_point(heli.global_position + Vector3(-10.0, 0, 0))
		await get_tree().create_timer(0.8).timeout
		var caja2_a: Vector3 = pared + Vector3(-2, 0, -8)
		var caja2_b: Vector3 = pared + Vector3(8, 9, 8)
		var v2a: int = int(world.contar_voxels(caja2_a, caja2_b))
		var c2: int = int(heli.cortados)
		Input.action_press("move_forward")
		for k8 in 45:
			await get_tree().create_timer(0.1).timeout
		Input.action_release("move_forward")
		var v2b: int = int(world.contar_voxels(caja2_a, caja2_b))
		print("[heli] CHOCANDO VOLANDO contra el talud: %d mordiscos, %d voxels menos · vida del heli %.0f de %.0f" % [
			int(heli.cortados) - c2, v2a - v2b, heli.vida, heli.vida_max])
		print("[heli] %s" % ("BIEN: las puntas cortan al chocar" if v2a - v2b > 100 else "MAL: choca y no rompe nada"))
	get_tree().quit()


## Altura del terreno en un punto (o NAN si no hay nada debajo).
func _altura_en(x: float, z: float, desde := 260.0) -> float:
	var r: Dictionary = world.raycast(Vector3(x, desde, z), Vector3.DOWN, desde + 20.0)
	return (r.position as Vector3).y if r.hit else NAN


func _prueba_pendiente() -> void:
	for i in 260:
		await get_tree().physics_frame
	player.invulnerable = true
	if is_instance_valid(salto_br):
		salto_br.queue_free()
	player.br_control = null
	# 1) BUSCAR LADERAS DE VERDAD, por tramos de inclinacion. Interesa saber DONDE esta el corte: si
	#    sube las de 30 y no las de 45, el problema es el angulo; si no sube ninguna, es otra cosa.
	var tam: Vector3 = world.get_world_size()
	var lado: float = maxf(tam.x, 64.0)
	# LO QUE SE BUSCA ES UNA LADERA ANDABLE, no un acantilado. Medir el desnivel entre dos puntos a 8 m
	# no vale: un cortado de 10 metros tambien da "39 grados de media", y ahi el problema no es el juego.
	# Asi que se mide el PERFIL cada 40 cm y solo entran las laderas que suben de verdad y no tienen
	# ningun escalon de mas de 1,2 m.
	var bandas := {"25-35": {}, "35-45": {}, "45-60": {}}
	var paso := 16.0
	var x := paso
	while x < lado - paso:
		var z := paso
		while z < lado - paso:
			var y0 := _altura_en(x, z)
			if not is_nan(y0) and y0 > 2.0:
				for d in [Vector3(1, 0, 0), Vector3(-1, 0, 0), Vector3(0, 0, 1), Vector3(0, 0, -1)]:
					var y1 := _altura_en(x + d.x * 8.0, z + d.z * 8.0)
					if is_nan(y1) or y1 - y0 < 2.0:
						continue
					var ang: float = rad_to_deg(atan2(y1 - y0, 8.0))
					var banda := ""
					if ang >= 25.0 and ang < 35.0: banda = "25-35"
					elif ang >= 35.0 and ang < 45.0: banda = "35-45"
					elif ang >= 45.0 and ang < 60.0: banda = "45-60"
					if banda == "" or not bandas[banda].is_empty():
						continue
					# el perfil: ni un cortado en los 8 m
					var mayor := 0.0
					var roto := false
					for i in 20:
						var a := _altura_en(x + d.x * i * 0.4, z + d.z * i * 0.4)
						var b := _altura_en(x + d.x * (i + 1) * 0.4, z + d.z * (i + 1) * 0.4)
						if is_nan(a) or is_nan(b):
							roto = true
							break
						mayor = maxf(mayor, b - a)
					if roto or mayor > 1.2:
						continue
					bandas[banda] = {"pos": Vector3(x, y0, z), "dir": d, "ang": ang, "mayor": mayor}
			z += paso
		x += paso
	var fallos: Array = []
	for banda in ["25-35", "35-45", "45-60"]:
		var c: Dictionary = bandas[banda]
		if c.is_empty():
			print("[pendiente] %s grados: no hay ninguna ladera asi en el mapa" % banda)
			continue
		var p0: Vector3 = c["pos"]
		var dir: Vector3 = c["dir"]
		# 2) AL PIE, MIRANDO ARRIBA
		player.global_position = p0 + Vector3(0, 1.2, 0)
		player.velocity = Vector3.ZERO
		# MIRAR CUESTA ARRIBA. Poner `look.x` a pelo no vale: quien gira el cuerpo es `rotation.y`, y
		# eso solo se copia al mover el raton. Sin esto el jugador andaba con el rumbo viejo -de lado
		# a la ladera- y la medida decia "no sube" con el juego perfectamente bien.
		player.look_at_point(player.global_position + Vector3(0, 1.2, 0) + dir * 10.0)
		await get_tree().create_timer(0.8).timeout
		# 3) LA W APRETADA 6 SEGUNDOS, MIDIENDO
		# EL PERFIL DE LA LADERA, medido cada 40 cm: cuanto sube de un punto al siguiente. Es lo que
		# dice si la montaña es una rampa (se anda) o una escalera de cortados (no se anda).
		var saltos: Array = []
		for i in 40:
			var a := _altura_en(p0.x + dir.x * i * 0.4, p0.z + dir.z * i * 0.4)
			var b := _altura_en(p0.x + dir.x * (i + 1) * 0.4, p0.z + dir.z * (i + 1) * 0.4)
			if not is_nan(a) and not is_nan(b):
				saltos.append(b - a)
		var repechos := {"<0.2": 0, "0.2-0.75": 0, "0.75-2.45": 0, ">2.45": 0}
		var mayor := 0.0
		for sa in saltos:
			var v: float = float(sa)
			mayor = maxf(mayor, v)
			if v < 0.2: repechos["<0.2"] += 1
			elif v < 0.75: repechos["0.2-0.75"] += 1
			elif v < 2.45: repechos["0.75-2.45"] += 1
			else: repechos[">2.45"] += 1
		print("[pendiente]    la ladera cada 40 cm: llano/rampa %d · escalon %d · repecho %d · cortado %d · el mayor %.2f m" % [
			repechos["<0.2"], repechos["0.2-0.75"], repechos["0.75-2.45"], repechos[">2.45"], mayor])
		print("[pendiente]    (elegida con el escalon mayor en %.2f m)" % float(c.get("mayor", 0.0)))
		player.diag_escalon = true
		player.diag_paso = {}
		var ini_p: Vector3 = player.global_position
		var prev: Vector3 = ini_p
		var atascos := 0
		var muestras := 0
		Input.action_press("move_forward")
		for k in 24:
			await get_tree().create_timer(0.25).timeout
			muestras += 1
			var p: Vector3 = player.global_position
			if Vector2(p.x - prev.x, p.z - prev.z).length() < 0.05:
				atascos += 1
			prev = p
		Input.action_release("move_forward")
		var fin_p: Vector3 = player.global_position
		var desp := Vector2(fin_p.x - ini_p.x, fin_p.z - ini_p.z)
		var hacia := Vector2(dir.x, dir.z)
		# cuanto de lo andado fue HACIA ARRIBA y cuanto de lado (deslizandose por la ladera)
		var util: float = desp.dot(hacia)
		var de_lado: float = absf(desp.cross(hacia))
		var sube: float = fin_p.y - ini_p.y
		print("[pendiente] %s grados (real %.0f): +%.1f m de altura · %.1f m cuesta arriba, %.1f m de lado · clavado %d/%d" % [
			banda, float(c["ang"]), sube, util, de_lado, atascos, muestras])
		var motivos: Array = []
		for k2 in player.diag_paso.keys():
			motivos.append("%s x%d" % [k2, int(player.diag_paso[k2])])
		motivos.sort()
		print("[pendiente]    el escalon: %s" % " · ".join(motivos))
		player.diag_escalon = false
		if sube < 1.5:
			fallos.append("%s grados: solo sube %.1f m" % [banda, sube])
	print("[pendiente] %s" % ("BIEN: sube todas" if fallos.is_empty() else "MAL: " + " · ".join(fallos)))
	await _prueba_repechos()
	get_tree().quit()


## QUE ALTURA SE SUBE ANDANDO. La otra mitad del problema: en una montaña no te para la pendiente, te
## para un repecho suelto. Se buscan repechos de verdad en el mapa (un salto limpio con sitio llano
## arriba), se anda contra ellos y se mira si el jugador acaba encima.
## Con `--sintrepauto` se apaga la trepada automatica: eso da el ANTES y el DESPUES.
func _prueba_repechos() -> void:
	var auto := not ("--sintrepauto" in OS.get_cmdline_user_args())
	print("[repechos] trepada automatica: %s" % ("SI" if auto else "NO (como antes)"))
	var tam: Vector3 = world.get_world_size()
	var lado: float = maxf(tam.x, 64.0)
	var objetivos := [0.6, 1.0, 1.4, 1.8, 2.2, 2.6]
	var encontrados := {}
	var x := 12.0
	while x < lado - 12.0:
		var z := 12.0
		while z < lado - 12.0:
			var y0 := _altura_en(x, z)
			if not is_nan(y0) and y0 > 2.0:
				for d in [Vector3(1, 0, 0), Vector3(-1, 0, 0), Vector3(0, 0, 1), Vector3(0, 0, -1)]:
					var y1 := _altura_en(x + d.x * 1.2, z + d.z * 1.2)
					var y2 := _altura_en(x + d.x * 2.6, z + d.z * 2.6)
					var ypie := _altura_en(x - d.x * 1.2, z - d.z * 1.2)
					if is_nan(y1) or is_nan(y2) or is_nan(ypie):
						continue
					# suelo llano delante del repecho y llano encima
					if absf(ypie - y0) > 0.25 or absf(y2 - y1) > 0.35:
						continue
					var h: float = y1 - y0
					for obj in objetivos:
						if absf(h - float(obj)) < 0.16:
							var lista: Array = encontrados.get(obj, [])
							if lista.size() < 4:
								lista.append({"pos": Vector3(x, y0, z), "dir": d, "h": h})
								encontrados[obj] = lista
			z += 6.0
		x += 6.0
	var linea: Array = []
	for obj in objetivos:
		var lista: Array = encontrados.get(obj, [])
		if lista.is_empty():
			linea.append("%.1f m: no hay ninguno asi en el mapa" % obj)
			continue
		var suben := 0
		var motivos_todos: Array = []
		for c in lista:
			var p0: Vector3 = c["pos"]
			var dir: Vector3 = c["dir"]
			player.global_position = p0 - dir * 1.0 + Vector3(0, 0.6, 0)
			player.velocity = Vector3.ZERO
			await get_tree().create_timer(0.5).timeout
			player.look_at_point(player.global_position + Vector3(0, 1.2, 0) + dir * 10.0)
			var y_ini: float = player.global_position.y
			player.diag_escalon = true
			player.diag_paso = {}
			Input.action_press("move_forward")
			# LA ALTURA MAXIMA, no la final: subiendo un repecho y siguiendo con la W puedes salir por
			# el otro lado y caer, y entonces el numero final dice "no subio" cuando si subio.
			var subio: float = 0.0
			for k in 16:
				await get_tree().create_timer(0.2).timeout
				subio = maxf(subio, player.global_position.y - y_ini)
			Input.action_release("move_forward")
			player.diag_escalon = false
			if subio > float(c["h"]) - 0.35:
				suben += 1
			else:
				for k2 in player.diag_paso.keys():
					if String(k2).begins_with("trepar:"):
						motivos_todos.append(String(k2))
			await get_tree().create_timer(0.2).timeout
		linea.append("%.1f m: sube %d de %d%s" % [obj, suben, lista.size(),
			("  (" + " · ".join(motivos_todos) + ")") if not motivos_todos.is_empty() else ""])
	for l in linea:
		print("[repechos] %s" % l)
	await _prueba_tejados()


## LOS TEJADOS INCLINADOS. Un tejado a dos aguas de la isla sube unos 33 grados, o sea que ANDANDO
## tendria que subirse; lo que hay que comprobar es si de verdad se sube o te quedas resbalando.
func _prueba_tejados() -> void:
	var tam: Vector3 = world.get_world_size()
	var lado: float = maxf(tam.x, 64.0)
	var sitios: Array = []
	var x := 12.0
	while x < lado - 12.0 and sitios.size() < 4:
		var z := 12.0
		while z < lado - 12.0 and sitios.size() < 4:
			var y0 := _altura_en(x, z)
			if not is_nan(y0) and y0 > 4.0:
				# ¿esta ALTO respecto a lo que tiene alrededor? entonces es un edificio, no una loma
				var suelo_al_lado := true
				for d in [Vector3(7, 0, 0), Vector3(-7, 0, 0), Vector3(0, 0, 7), Vector3(0, 0, -7)]:
					var ys := _altura_en(x + d.x, z + d.z)
					if is_nan(ys) or y0 - ys < 3.0:
						suelo_al_lado = false
						break
				if suelo_al_lado:
					for d2 in [Vector3(1, 0, 0), Vector3(-1, 0, 0), Vector3(0, 0, 1), Vector3(0, 0, -1)]:
						var y1 := _altura_en(x + d2.x * 1.5, z + d2.z * 1.5)
						var y2 := _altura_en(x + d2.x * 3.0, z + d2.z * 3.0)
						if is_nan(y1) or is_nan(y2):
							continue
						var a1: float = rad_to_deg(atan2(y1 - y0, 1.5))
						var a2: float = rad_to_deg(atan2(y2 - y1, 1.5))
						# dos tramos seguidos subiendo parecido: eso es un faldon, no un peto
						if a1 > 18.0 and a1 < 50.0 and absf(a2 - a1) < 14.0:
							sitios.append({"pos": Vector3(x, y0, z), "dir": d2, "ang": a1})
							break
			z += 4.0
		x += 4.0
	if sitios.is_empty():
		print("[tejados] no he encontrado ningun faldon inclinado")
		return
	var suben := 0
	for c in sitios:
		var p0: Vector3 = c["pos"]
		var dir: Vector3 = c["dir"]
		player.global_position = p0 + Vector3(0, 0.4, 0)
		player.velocity = Vector3.ZERO
		await get_tree().create_timer(0.5).timeout
		player.look_at_point(player.global_position + Vector3(0, 1.2, 0) + dir * 10.0)
		var y_ini: float = player.global_position.y
		Input.action_press("move_forward")
		var subio := 0.0
		for k in 15:
			await get_tree().create_timer(0.2).timeout
			subio = maxf(subio, player.global_position.y - y_ini)
		Input.action_release("move_forward")
		print("[tejados] faldon de %.0f grados en %s: subio %.2f m" % [float(c["ang"]), str(p0.round()), subio])
		if subio > 0.8:
			suben += 1
		await get_tree().create_timer(0.2).timeout
	print("[tejados] sube %d de %d" % [suben, sitios.size()])


func _prueba_skin_partida() -> void:
	for i in 150:
		await get_tree().physics_frame
	player.invulnerable = true
	if is_instance_valid(salto_br):
		salto_br.queue_free()
	player.br_control = null
	var sid := "sk_dragon"
	for a in OS.get_cmdline_user_args():
		if String(a).begins_with("--skin="):
			sid = String(a).substr(7)
	# EN BATTLE ROYALE SE EMPIEZA SIN ARMAS (las dos ranuras estan vacias), asi que para esta prueba hay
	# que darse una: si no, se estaria pintando la ranura vacia, que no tiene modelo.
	var arma := "carabina_556"
	for a2 in OS.get_cmdline_user_args():
		if String(a2).begins_with("--arma="):
			arma = String(a2).substr(7)
	player.coger_arma(arma, 0)
	player.switch_weapon(0)
	await get_tree().create_timer(0.4).timeout
	SkinsArmas.equipar(arma, sid)
	player._equip_model()                      # rehacer el arma con la skin puesta
	await get_tree().create_timer(0.6).timeout
	var pintadas := 0
	var con_luz := 0
	for mi in _mallas_de_nodo(player.weapon_model):
		var m: MeshInstance3D = mi
		for i in (m.mesh.get_surface_count() if m.mesh else 0):
			var ov: Material = m.get_surface_override_material(i)
			if ov != null:
				pintadas += 1
				if ov is BaseMaterial3D and (ov as BaseMaterial3D).next_pass != null:
					con_luz += 1
	print("[skinpartida] %s en %s · primera persona: %d piezas pintadas, %d con efecto" % [sid, arma, pintadas, con_luz])
	# y el arma del MUÑECO (tercera persona y lo que ven los demas)
	var pintadas_av := 0
	var con_luz_av := 0
	var wm_av = player.avatar._wm if player.avatar and ("_wm" in player.avatar) else null
	if wm_av != null and is_instance_valid(wm_av):
		for mi in _mallas_de_nodo(wm_av):
			var m2: MeshInstance3D = mi
			for i in (m2.mesh.get_surface_count() if m2.mesh else 0):
				var ov2: Material = m2.get_surface_override_material(i)
				if ov2 != null:
					pintadas_av += 1
					if ov2 is BaseMaterial3D and (ov2 as BaseMaterial3D).next_pass != null:
						con_luz_av += 1
	print("[skinpartida] muñeco (lo que ven los demas): %d piezas pintadas, %d con efecto" % [pintadas_av, con_luz_av])
	# si el muñeco no lleva el efecto, saber POR QUE: que material tiene cada pieza
	if con_luz_av == 0 and wm_av != null and is_instance_valid(wm_av):
		var detalle: Array = []
		for mi in _mallas_de_nodo(wm_av):
			var m3: MeshInstance3D = mi
			for i in (m3.mesh.get_surface_count() if m3.mesh else 0):
				var base: Material = m3.mesh.surface_get_material(i)
				var ov3: Material = m3.get_surface_override_material(i)
				detalle.append("%s->%s%s" % [String(base.resource_name) if base else "?",
					"pintada" if ov3 != null else "SIN PINTAR",
					"+luz" if (ov3 is BaseMaterial3D and (ov3 as BaseMaterial3D).next_pass != null) else ""])
		print("[skinpartida] detalle del muñeco: %s" % " · ".join(detalle))
	# los fps, despues de que el mapa termine de cargar (al principio son los de la carga, no los del juego)
	for i in 240:
		await get_tree().physics_frame
	var fps: Array = []
	for k in 3:
		await get_tree().create_timer(1.0).timeout
		fps.append(Engine.get_frames_per_second())
	print("[skinpartida] fps con la skin puesta: %s" % str(fps))
	if "--fotos" in OS.get_cmdline_user_args():
		await get_tree().create_timer(0.4).timeout
		get_viewport().get_texture().get_image().save_png("user://skin_1p.png")
		player.set_third_person(true)
		await get_tree().create_timer(0.8).timeout
		get_viewport().get_texture().get_image().save_png("user://skin_3p.png")
		print("[skinpartida] fotos en %s" % ProjectSettings.globalize_path("user://"))
	get_tree().quit()


func _mallas_de_nodo(n) -> Array:
	var out: Array = []
	if n == null or not is_instance_valid(n):
		return out
	if n is MeshInstance3D:
		out.append(n)
	for h in (n as Node).get_children():
		out += _mallas_de_nodo(h)
	return out


var _cortina: CanvasLayer = null

## La pantalla tapada mientras se prepara el salto (ver `_montar_extras_mapa`).
func cortina_br(on: bool) -> void:
	if not on:
		if is_instance_valid(_cortina):
			_cortina.queue_free()
