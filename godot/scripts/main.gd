## Adaptación dinámica: si el frame medio supera el objetivo x1.3 durante 2 s baja un tier;
## si va holgado 12 s, sube (sin pasar del tier detectado). Estabilidad antes que gráficos.
## REGULADOR DE CASCOTES. Independiente de la calidad grafica: el jugador pidio ALTA fija, asi que
## cuando un derrumbe amenaza los 60 fps lo que se recorta son los trozos macizos que genera cada
## misil (cada trozo = malla + instancia + cuerpo de fisica), no la calidad de imagen. Se recupera
## solo, despacio, cuando el frame vuelve a sobrar.
const CLUMP_MIN := 0.12
var _sin_prisa := "--sinprisa" in OS.get_cmdline_user_args()
var clump_scale := 1.0
var _clump_fps := 60.0

func _throttle_clumps(delta: float) -> void:
	# EL REGULADOR YA NO TOCA LA MATERIA.
	#
	# Esto bajaba `clump_scale` cuando caian los fotogramas, y `clump_scale` decide CUANTOS TROZOS
	# saca una explosion. O sea que el rendimiento cambiaba el mapa: medido en banco con el mismo
	# derribo, a 30 fps salian 6 cuerpos y a 60 salian 36, y el mapa acababa con 205 voxels de
	# diferencia. Dos aparatos distintos jugando juntos no podian coincidir ni queriendo.
	#
	# La regla es la de siempre: el rendimiento puede cambiar lo que se DIBUJA, nunca lo que EXISTE.
	# La materia que suelta una explosion es parte de la simulacion y va fija; lo que se recorta en un
	# aparato flojo es como se representa (cuerpos baratos en vez de fisica completa) y las particulas
	# de adorno, que no dejan voxels.
	_clump_fps = lerpf(_clump_fps, 1.0 / maxf(0.001, delta), clampf(delta * 6.0, 0.0, 1.0))
	clump_scale = 1.0
	world.set_clump_scale(1.0)
	# LA PRISA DE LOS CASCOTES (2026-09-28, pedido): por debajo de 60 fps los trozos pequeños de las explosiones se
	# duermen antes (a 48 fps, del todo). Esto no cambia lo que EXISTE, solo cuando deja de moverse; en red, donde
	# acaba cada bloque lo sigue decidiendo el anfitrion (place_frozen). --sinprisa: sin ella (para medir).
	if world.has_method("set_prisa_escombros"):
		world.set_prisa_escombros(0.0 if _sin_prisa else clampf((59.0 - _clump_fps) / 11.0, 0.0, 1.0))


func _adapt(delta: float) -> void:
	_throttle_clumps(delta)
	frame_acc += delta
	frame_n += 1
	if frame_acc < 0.5:
		return
	var avg := frame_acc / frame_n
	frame_acc = 0.0
	frame_n = 0
	var target := 1.0 / 60.0   # tambien en movil con calidad BAJA (antes 30: ver apply_graphics)
	if avg > target * 1.3:
		slow_time += 0.5
		fast_time = 0.0
	elif avg < target * 0.6:
		fast_time += 0.5
		slow_time = 0.0
	else:
		slow_time = 0.0
		fast_time = 0.0
	_vigilar_fps_pve(avg)
	# Si el jugador ha elegido un tier a mano, se respeta: antes esta rama bajaba la calidad
	# igualmente y la de subir sí miraba quality_override, así que era un trinquete de un solo
	# sentido — elegías ALTA, un tirón te dejaba en LOW y no volvías a subir nunca.
	if slow_time >= 2.0 and quality > 0 and Settings.quality_override < 0:
		slow_time = 0.0
		apply_quality(quality - 1)
		hud.flash_message("Rendimiento bajo: calidad -> %s" % Settings.quality_name(quality))
	elif fast_time >= 12.0 and quality < detected_quality and Settings.quality_override < 0:
		fast_time = 0.0
		apply_quality(quality + 1)

## OLEADAS: EL CLIMA SE ALIGERA SI A ALGUIEN LE FALTAN FPS (2026-09-22, pedido). La noche y la lluvia del modo
## zombis son las dos cosas mas caras que se pueden apagar sin tocar el mapa: la lluvia son particulas por toda
## la pantalla mas una pasada de agua en el suelo, y la noche enciende los faroles (una luz con sombra cada uno).
## Quien lo detecta es CADA maquina sobre SUS fps -es la unica que los sabe- y lo unico que manda es un aviso;
## lo aplica el anfitrion para todos a la vez (Net.net_fps_bajos), que es la regla de siempre. No toca ni las
## criaturas, ni las oleadas, ni el dano: solo el ambiente.
const FPS_CLIMA_MIN := 45.0        ## por debajo de esto, y sostenido, se avisa
const FPS_CLIMA_SEG := 5.0         ## segundos seguidos por debajo antes de avisar (un tiron suelto no cuenta)
var _fps_bajos_t := 0.0
var _clima_avisado := false

func _vigilar_fps_pve(avg: float) -> void:
	if pve == null or _clima_avisado or Net.clima_aligerado or loading:
		return
	if 1.0 / maxf(avg, 0.0001) < FPS_CLIMA_MIN:
		_fps_bajos_t += 0.5
	else:
		_fps_bajos_t = 0.0
	if _fps_bajos_t >= FPS_CLIMA_SEG:
		_clima_avisado = true
		Net.net_fps_bajos()


## Lo que se aplica cuando el anfitrion lo decide (llega por Net.clima_ligero, tambien a solas).
var _faroles_apagados := false
var rescate: Node = null

## UN BOT REVIVIDO (rescate.gd, solo el anfitrion): un bot nuevo del mismo bando donde estaba el cuerpo. Los
## bots no se levantan (el nodo se borra al morir), asi que "revivir" es crear otro igual en ese sitio.
func revivir_bot(pos: Vector3, team: String, nombre: String = "") -> void:
	if enemies == null:
		return
	var e := ENEMY_SCENE.instantiate()
	enemies.add_child(e)
	e.global_position = pos + Vector3.UP * 0.3
	if not _sin_montar_una:
		e.tinte_build = _color_bando_bot(team == Net.my_team())
	e.setup(world, player, enemies.get_child_count())
	if "red_id" in e and e.red_id == 0:
		e.red_id = _nuevo_id_bot()
	if "team" in e:
		e.team = team
	_pintar_bot(e, team == Net.my_team(), enemies.get_child_count() - 1)
	# vuelve CON SU NOMBRE (en el marcador de retratos es el mismo, que pasa de gris a color)
	if nombre != "" and "nombre_marcador" in e:
		e.nombre_marcador = nombre
		if e.has_method("set_bot_name"):
			e.set_bot_name(nombre)
	if dm_mode:
		_dm_rol(e, _base_de(team))      # duelo sin reaparecer: el revivido vuelve a pelear, no a un sitio de bomba
	else:
		_dar_rol(e, team)
	if not e.died.is_connected(_on_enemy_died):
		e.died.connect(_on_enemy_died)
	if hud:
		hud.flash_message("¡COMPAÑERO REVIVIDO!")

func _aligerar_clima() -> void:
	if raining:
		set_rain(false)
	# LA NOCHE SE QUEDA; SE APAGAN LOS FAROLES (2026-09-23). Quitar la noche entera deshacia el anochecer de la
	# oleada 5 y, como la noche ya no estaba, _dia_noche_pve lo volvia a empezar: "OSCURECIENDO" una y otra vez
	# sin llegar nunca. Lo caro de la noche son los faroles (una luz con sombra cada uno), no el cielo oscuro.
	_faroles_apagados = true
	_show_lamps(false)
	if hud:
		hud.flash_message("CLIMA ALIGERADO: alguien iba con pocos FPS")


func apply_quality(q: int) -> void:
	quality = clampi(q, 0, 3)
	world.set_quality(quality)
	player.quality = quality
	# (2026-10-13, bug: el sol volvia a dar sombra aunque GRAFICOS dijera "Falsas": esto no miraba el ajuste)
	sun.shadow_enabled = quality >= 1 and int(Settings.gfx_value("shadows", quality)) > 0 and (not night or "--sombranoche" in OS.get_cmdline_user_args())
	# sombras cortas: cada chunk cercano es un caster más; en móvil/iGPU la pasada de sombras pesa tanto como la escena
	sun.directional_shadow_max_distance = [25.0, 30.0, 60.0, 90.0][quality]
	sun.directional_shadow_mode = DirectionalLight3D.SHADOW_ORTHOGONAL if quality <= 1 else DirectionalLight3D.SHADOW_PARALLEL_2_SPLITS
	RenderingServer.directional_shadow_atlas_set_size([1024, 1024, 2048, 4096][quality], true)
	var vp := get_viewport()
	vp.scaling_3d_scale = [0.75, 0.85, 1.0, 1.0][quality]
	vp.msaa_3d = Viewport.MSAA_2X if quality >= 3 else Viewport.MSAA_DISABLED
	var e: Environment = env.environment
	# LA MISMA CONVERSION DE COLOR QUE BLENDER (pedido 2026-09-21: "en Blender mis modelos se ven mejor").
	# Blender 4 revela con AgX; aqui iba Filmic, que quema antes las luces y tira los colores hacia el
	# naranja. --tonemap=filmic vuelve a lo de antes para comparar.
	e.tonemap_mode = Environment.TONE_MAPPER_FILMIC if "--tonemap=filmic" in OS.get_cmdline_user_args() else Environment.TONE_MAPPER_AGX
	e.glow_enabled = quality >= 2 and (not Settings.is_mobile() or "--glowmovil" in OS.get_cmdline_user_args())
	# niebla siempre: oculta el corte de la distancia de render y el cambio de LOD
	e.fog_enabled = true
	# ...PERO NO SOBRE EL CIELO. `fog_sky_affect` vale 1 de fabrica y el cielo esta a distancia
	# infinita, asi que la niebla se lo tragaba ENTERO: por eso el cielo salia como una plancha gris
	# lisa y no se veia ni el sol ni una sola nube, por mucho que el shader las estuviera pintando.
	# Comprobado con capturas: a 1 el cielo es un gris plano; a 0 aparecen las nubes. Se deja un poco
	# para que el horizonte siga fundiendo con la niebla del suelo y no quede un corte.
	e.fog_sky_affect = 0.10
	# (la densidad y el plano lejano los pone _ajustar_niebla, al final de apply_graphics: dependen de la
	# distancia de dibujado, que se fija alli. Antes se calculaban aqui, con la distancia VIEJA.)
	# Plano lejano ajustado a la distancia de render: Godot reparte la geometría opaca en 16 capas de
	# profundidad (z_far/16) y las dibuja de delante hacia atrás. Con far=400 m todo caía en la misma
	# capa (orden arbitrario -> overdraw); con far ~ render_distance las paredes cercanas se pintan
	# primero y el early-Z descarta lo que queda detrás. También mejora la precisión de profundidad.
	e.ssao_enabled = false
	e.ssil_enabled = false
	# El tope de FPS lo pone apply_graphics (mas abajo) con la opcion "fps_limit". Aqui habia un tope de
	# 30 en movil con calidad BAJA: era lo que dejaba el juego en 30 fps "con todo al minimo".
	if effects:
		effects.setup(quality)
	hud.set_quality_name(Settings.quality_name(quality) + (" (personalizada)" if Settings.gfx_custom else ""))
	apply_graphics()
	_refresh_lamp_fade()   # las luces ya creadas se reajustan al nuevo tier

## Configuración gráfica avanzada (menú GRÁFICOS): encima del preset aplica cada opción personalizada.
func apply_graphics() -> void:
	# Se ejecuta también con un preset: gfx_value() devuelve el valor del preset cuando no hay
	# personalización. Antes salía aquí y, con preset, la oclusión volumétrica, el FXAA y la
	# escala de distancia no se aplicaban nunca (sólo lo que repetía apply_quality a mano).
	var g := func(k: String) -> int: return Settings.gfx_value(k, quality)
	var vp := get_viewport()
	vp.scaling_3d_scale = [0.25, 0.33, 0.4, 0.5, 0.65, 0.75, 0.85, 1.0][g.call("render_scale")]
	# FSR SOLO EN BAJA: sube de resolucion interna con un filtro que afila los bordes, en vez del
	# bilineal de fabrica (que a 65% sale borroso). Mas caro que bilineal por pixel de PANTALLA, pero
	# se renderiza MUCHOS menos pixeles internos, asi que sale a cuenta igual (es lo que hace PUBG
	# Mobile y el resto de shooters de movil). Solo grafico: no toca fisica ni comportamiento.
	# OJO: FSR1 solo existe en Forward+. Este proyecto usa el renderizador MOBILE, donde Godot lo ignora
	# (avisa "FSR1 3D scaling is only available when using the Forward+ renderer") y escala en bilineal.
	var fsr_ok := RenderingServer.get_current_rendering_method() == "forward_plus"
	vp.scaling_3d_mode = Viewport.SCALING_3D_MODE_FSR if quality == 0 and fsr_ok else Viewport.SCALING_3D_MODE_BILINEAR
	vp.fsr_sharpness = 0.2
	# LA SOMBRA DE LAS ESQUINAS en la malla (voxel_world set_ao_cerca): apagada, la mitad de triangulos
	if world and world.has_method("set_ao_cerca"):
		world.set_ao_cerca(int(g.call("ao_cerca")) == 1)
	var sh: int = g.call("shadows")
	# DE NOCHE NO HAY SOMBRAS (2026-10-14, pedido: "por que hay sombra de noche si no hay sol"): la luna no proyecta, ni en
	# tiempo real ni horneada en la malla (oscurecian el suelo). --sombranoche = como antes.
	var noche_sin_sombra: bool = night and not ("--sombranoche" in OS.get_cmdline_user_args())
	if noche_sin_sombra:
		sh = 0
	sun.shadow_enabled = sh > 0
	if sh > 0:
		RenderingServer.directional_shadow_atlas_set_size([1024, 1024, 2048, 2048, 4096][sh], true)
		sun.directional_shadow_mode = DirectionalLight3D.SHADOW_ORTHOGONAL if sh <= 2 else DirectionalLight3D.SHADOW_PARALLEL_2_SPLITS
	sun.directional_shadow_max_distance = [25.0, 40.0, 60.0, 90.0][g.call("shadow_distance")]
	# SOMBRA DEL SOL HORNEADA EN LA MALLA: solo en Baja, que es donde no hay sombra del sun en tiempo real
	# (sh == 0). Cuesta casi 0 en la GPU. No toca fisica ni colision, solo el color de los vertices.
	if world and world.has_method("set_sol_horneado"):
		world.set_sol_horneado(sh == 0 and not noche_sin_sombra and not ("--sinsolhorneado" in OS.get_cmdline_user_args()), sun.global_transform.basis.z, 40.0)
	var aa: int = g.call("antialias")
	vp.screen_space_aa = Viewport.SCREEN_SPACE_AA_FXAA if aa == 1 else Viewport.SCREEN_SPACE_AA_DISABLED
	vp.msaa_3d = [Viewport.MSAA_DISABLED, Viewport.MSAA_DISABLED, Viewport.MSAA_2X, Viewport.MSAA_4X][aa]
	# CAMARA: estela al girar y profundidad de campo. Sutiles a proposito; el usuario sube la
	# densidad desde aqui si quiere mas.
	Settings.motion_blur = [0.0, 0.22, 0.45, 0.8][g.call("motion_blur")]
	Settings.focus_mode = g.call("focus")
	Settings.focus_amount = [0.05, 0.10, 0.18, 0.30][g.call("desenfoque")]
	# LA CALIDAD DEL BOKEH, que no estaba puesta y era el problema de verdad. De fabrica Godot usa
	# pocas muestras y forma CUADRADA: eso no se ve como algo desenfocado, se ve como MANCHAS, y por
	# eso bajar la fuerza no lo arreglaba -salian manchas mas pequenas-.
	# Circulo, calidad alta y con jitter: el jitter reparte las muestras al azar, y es lo que rompe
	# los escalones y deja el degradado liso.
	RenderingServer.camera_attributes_set_dof_blur_bokeh_shape(RenderingServer.DOF_BOKEH_CIRCLE)
	RenderingServer.camera_attributes_set_dof_blur_quality(
		RenderingServer.DOF_BLUR_QUALITY_HIGH if quality >= 2 else RenderingServer.DOF_BLUR_QUALITY_MEDIUM, true)
	# LOS DETALLES, uno por uno. Cada llamada apaga el efecto DE VERDAD -esconde el nodo o deja de
	# emitir-, no solo lo pone a cero: un efecto "apagado" que sigue costando una pasada de pantalla
	# es lo peor de los dos mundos, porque no se ve y sigue quitando FPS.
	# LA LENTE PRIMERO, y la bodycam despues: comparten pasada, y la bodycam manda. Poniendo la
	# lente antes, `set_bodycam` se entera de que nivel habia y puede devolverlo al apagarse.
	var bc: int = g.call("bodycam")
	if hud and hud.has_method("set_lente"):
		hud.set_lente(g.call("lente"))
	if hud and hud.has_method("set_vineta"):
		hud.set_vineta(g.call("vineta"))
	set_bodycam(bc)
	_cristal_roto = g.call("cristal_roto") > 0
	if not _cristal_roto and effects and effects.has_method("limpiar_grietas"):
		effects.limpiar_grietas()
	_polvo_on = g.call("polvo_aire") > 0
	_lluvia_suelo = g.call("lluvia_suelo") > 0
	_vista_fuerza = [0.0, 1.0, 2.0][g.call("vista_ojo")]
	# CON LA BODYCAM, EL SENSOR BUSCA LA EXPOSICION. Un ojo se adapta con gusto; un sensor barato de
	# camara de cuerpo lo hace a lo bruto y se le nota -entras a un portal y la imagen se va a blanco
	# un segundo antes de asentarse-. Es de las cosas que mas dicen "esto esta grabado", asi que con
	# la bodycam puesta la adaptacion se enciende aunque la tengas en Off y va mas fuerte.
	if bc > 0:
		_vista_fuerza = maxf(_vista_fuerza, 1.0) * (1.35 if bc >= 2 else 1.15)
	_aliento_on = g.call("aliento") > 0
	Settings.pasos_bots = g.call("pasos_bots") > 0
	_huellas_on = g.call("huellas") > 0
	if not _huellas_on:
		_borrar_huellas()
	_onda_on = g.call("onda_misil") > 0
	_disolver_on = g.call("disolver") > 0
	_gas_arma_on = g.call("gas_arma") > 0
	_cielo_on = g.call("cielo") > 0
	_aplicar_cielo()
	if is_instance_valid(agua):
		agua.set_calidad(g.call("agua") > 0)
	var ao: int = g.call("voxel_ao")
	_ao_nivel(ao)
	(env.environment as Environment).glow_enabled = g.call("glow") == 1
	if _auto_nivel > 0:
		_auto_aplicar()      # el escalon automatico sigue valiendo encima de lo que se acaba de poner
	# LAS TRES DISTANCIAS, POR SEPARADO. Dibujado = cuantos trozos de mapa entran en pantalla;
	# detalle = hasta donde se usa la malla fina en vez de la de 20 cm; luces = hasta donde alumbran
	# los faroles del mapa. En un mapa grande la combinacion que interesa es ver LEJOS con POCO
	# detalle, y eso con un solo mando no se podia pedir.
	# EL EXTREMO DE ABAJO TIENE QUE RECORTAR DE VERDAD. El minimo era 0,6, que en Monaco no quitaba
	# casi nada: se seguia viendo el mapa entero por mucho que lo bajaras. Ahora "Minima" es 0,25 en
	# dibujado y 0,15 en detalle, que en un movil es la diferencia entre jugar y mirar una diapositiva.
	# EN PARTIDA CON GENTE, EL MUNDO SE DIBUJA IGUAL PARA TODOS.
	#
	# Esta distancia no decide lo bonito que se ve: decide CUANTO MUNDO EXISTE en tu pantalla. Con el
	# ajuste en bajo, un edificio lejano no se dibuja... y ves al enemigo que ese edificio tendria que
	# taparte. Eso no es una ventaja de tener buen movil, es ver a traves de las paredes por llevar el
	# detalle bajo, y no puede depender de la maquina de cada uno.
	#
	# Se deja a partir de "Media", que es lo que ya usan los presets ALTO y ULTRA: el que juega en PC
	# no nota nada y el movil flojo sube de 0,4 a 0,85. Lo demas -sombras, particulas, humo, detalle
	# de las mallas- sigue siendo suyo y ahi puede recortar todo lo que quiera.
	# 2026-09-22 (pedido): LA DISTANCIA DE DIBUJADO ES LA MISMA EN TODAS LAS CALIDADES Y PARA TODOS
	# (DISTANCIA_DIBUJO), con la niebla tapando el borde (_ajustar_niebla). Antes dependia del preset
	# (100 m de base en BAJA, 300 en ULTRA) y de "view_distance", asi que dos jugadores no veian el mismo
	# mundo ni en red. La opcion "view_distance" sigue guardada pero ya no se usa ni sale en el menu.
	# Medido en Monaco con --simmovil (4 nucleos, 1600x720): 40 m -> 120 m son +250 k triangulos y
	# +40 dibujos, ~1 ms. El detalle cercano ("lod_distance") sigue siendo de cada uno.
	if world.has_method("set_lod_distance_scale"):
		world.set_lod_distance_scale([0.15, 0.25, 0.4, 0.6, 0.85, 1.2, 1.6, 2.0][g.call("lod_distance")])
	# LA RESOLUCION LEJANA (settings "lod_lejos"): donde empieza lo MUY lejos, en veces la distancia del detalle fino
	if world.has_method("set_lod2_factor"):
		world.set_lod2_factor([1.2, 1.5, 2.0, 3.0][g.call("lod_lejos")])
	# AHORRAR MEMORIA LEJANA: los bloques de las regiones en LOD2 sueltan su malla fina (2); si no, nunca (4)
	if world.has_method("set_soltar_bloques") and not "--soltarlod2" in OS.get_cmdline_user_args():
		world.set_soltar_bloques(2 if g.call("ahorro_lejos") > 0 else 4)
	# LA TRANSICION DE DETALLE SUAVE SE QUITO (2026-09-22): dejaba agujeros de cielo por los bordes y, apilando
	# las capas, la gruesa tapaba a la fina. Se apaga siempre; el camino sigue en el shader y en VoxelWorld por
	# si algun dia se retoma. Lo que la sustituye es poder ALEJAR el cambio de detalle (arriba, "lod_distance").
	# Y las TEXTURAS DE MATERIAL, que van en la misma variante del shader (_aplicar_texturas la monta).
	var _args_tex := OS.get_cmdline_user_args()
	_redondeo_on = g.call("redondeo") > 0 and not ("--sinredondeo" in _args_tex)
	_texturas_on = (g.call("texturas") > 0 or "--contexturas" in _args_tex) and not ("--sintexturas" in _args_tex)
	_aplicar_texturas()
	if world.has_method("set_lod_fade_band"):
		world.set_lod_fade_band(0.0, 0.0)
	_fijar_distancia()
	_refresh_lamp_fade()
	# El mismo mando que regula/apaga los faroles también limita los destellos y la
	# linterna. Así no queda una única luz móvil de 65 m gastando FPS cuando el mapa
	# ya está configurado en luces mínimas u Off.
	if effects and effects.has_method("set_light_quality"):
		effects.set_light_quality(g.call("light_distance"))
	_aplicar_calidad_linterna()
	if effects:
		effects.particle_scale = [0.4, 0.7, 1.0][g.call("particles")]
		effects.smoke_scale = [0.0, 0.6, 1.0][g.call("smoke")]
	# OCLUSION POR SOFTWARE. Medido en dust2 (spawn de la policia, Intel UHD): encendida el render
	# de CPU cuesta 6,8 ms y apagada 2,7 ms, y se pasa de 41,7 a 51,5 fps sin que suba la GPU. En
	# estos mapas no llega a tapar nada: es coste puro. Se deja elegir por si un mapa con muchos
	# interiores lo aprovecha.
	var occ_on: bool = g.call("occlusion") > 0
	get_viewport().use_occlusion_culling = occ_on
	if world.has_method("set_use_occluders"):
		world.set_use_occluders(occ_on)
	# partículas de destrucción del motor (las de un vóxel): antes no había forma de tocarlas
	if world.has_method("set_debris_scale"):
		world.set_debris_scale([0.0, 0.35, 0.7, 1.0][g.call("debris")])
	_tope_escombros = TOPES_ESCOMBROS[clampi(g.call("escombros_tope"), 0, 3)]
	# EL TOPE DE BLOQUES DESPIERTOS (VoxelWorld, stepBodies; 2026-10-10, pedido: "que no baje de 60 fps"): con mas que
	# esto moviendose en la fisica, los mas lentos se asientan ya. --sintopedespiertos = sin tope; --topedespiertos=N.
	if world.has_method("set_tope_despiertos"):
		var tope_d: int = 30 if Settings.is_mobile() else 40
		for fa in OS.get_cmdline_user_args():
			if String(fa).begins_with("--topedespiertos="):
				tope_d = int(String(fa).substr(17))
		if "--sintopedespiertos" in OS.get_cmdline_user_args():
			tope_d = 0
		world.set_tope_despiertos(tope_d)
	if effects:
		effects.fuego_on = g.call("fuego_explosion") == 1
	EnemyScript.max_corpses = [0, 1, 2, 3, 4, 6, 8, 12, 16][g.call("corpses")]
	EnemyScript.cuerpo_vida = [3.0, 10.0, 30.0, 60.0, 0.0][g.call("corpse_time")]   # 0 = no caduca
	# el detalle de vóxel se lee al cargar el mapa; aquí sólo se guarda la elección
	Settings.fine_voxels = g.call("detail") == 1
	# EL TOPE DE FPS ES EL QUE ELIGE EL JUGADOR, tambien en movil (2026-09-22). Antes el movil lo pisaba:
	# 30 con calidad BAJA y 60 como mucho en el resto, asi que bajar los graficos dejaba el juego en 30 fps
	# y una pantalla de 90/120 Hz no pasaba nunca de 60. Solo toca el ritmo de dibujo: la fisica va a
	# physics_ticks_per_second, que no cambia.
	var tope: int = [30, 60, 90, 120, 0][g.call("fps_limit")]
	if Settings.is_mobile() and tope == 0:
		# "Sin limite" en un movil = HASTA 120, sin mirar los Hz que dice la pantalla: las pantallas de
		# frecuencia variable (LTPO) bajan solas cuando el juego va lento, y en un movil con Adreno 730 leia
		# 24 Hz y el juego se quedaba topado a 24. El 30 que se veia antes NO era por pedir 120: era la CPU
		# a 32 ms por cuadro (medido con el contador, 2026-09-22). Donde la pantalla sea de 60, vsync deja 60.
		tope = 120
	Engine.max_fps = tope
	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_ENABLED if g.call("vsync") == 1 else DisplayServer.VSYNC_DISABLED)
	hud.show_fps = g.call("fps_counter") == 1 or "--contadorfps" in OS.get_cmdline_user_args()

## LA NIEBLA TAPA EL BORDE DEL MAPA DIBUJADO, Y NADA MAS (2026-09-22).
##
## Era exponencial con densidad 1,1 / distancia: en BAJA (40 m) lavaba el 42 % del color a 20 m -todo se veia
## blanquecino- y aun asi en el borde solo tapaba el 67 %, asi que los muros lejanos APARECIAN DE GOLPE al
## acercarse. Una region se enciende cuando su punto mas cercano entra en la distancia de dibujado
## (VoxelWorld::updateLod), asi que la niebla por profundidad va de 0 al 100 % ANTES de ese borde: cerca los
## colores quedan limpios y lo que aparece nace ya tapado y se va viendo de a poco. Solo imagen.
var _niebla_inicio := 60.0
const NIEBLA_INICIO := 0.45      ## fraccion de la distancia de dibujado donde empieza
const NIEBLA_TOTAL := 0.92       ## ...y donde ya tapa del todo (antes del borde, donde nacen las regiones)

## EL SHADER DEL MUNDO, CON O SIN LA TRANSICION DE DETALLE. La mezcla necesita `discard`, y un discard en
## el shader del mundo le quita a la GPU del movil el descarte temprano por profundidad en TODO el mapa:
## por eso es una VARIANTE (el mismo codigo con LOD_FADE definido) que solo se monta con el ajuste encendido.
## Se cambia el shader del MISMO material, asi que conserva todos sus parametros.
## Las TEXTURAS DE MATERIAL van igual, como variante (TEXTURAS): apagadas, el shader ni lee la textura.
var _shader_mundo_base: Shader = null
var _shader_mundo_var := {}      ## los #define de la variante -> su Shader

func _shader_mundo(fade: bool) -> void:
	if world == null or not (world.opaque_material is ShaderMaterial):
		return
	var m := world.opaque_material as ShaderMaterial
	if _shader_mundo_base == null:
		_shader_mundo_base = m.shader
	var defs := ""
	if fade:
		defs += "\n#define LOD_FADE"
	if _texturas_on:
		defs += "\n#define TEXTURAS"
	var quiere: Shader = _shader_mundo_base
	if not _ao_en_pantalla:
		defs += "\n#define AO_MATERIAL"
	if defs != "":
		if not _shader_mundo_var.has(defs):
			var sh := Shader.new()
			sh.code = _shader_mundo_base.code.replace("shader_type spatial;", "shader_type spatial;" + defs)
			_shader_mundo_var[defs] = sh
		quiere = _shader_mundo_var[defs]
	if m.shader != quiere:
		m.shader = quiere
		if _ao_on and not _ao_en_pantalla:
			set_voxel_ao(true)   # la ocupacion va atada al material por el RenderingServer: se vuelve a atar

## LAS TEXTURAS DE MATERIAL (ajuste "texturas", 2026-09-30). Cada cara de voxel lleva el dibujo de la familia de su
## material (texturas/voxel_detalle.png, una capa por familia; tools/generar_texturas_voxel.py), que aclara u oscurece
## su color. La familia la deduce la extension de la fisica y el color del material (voxel_world.cpp,
## familiaTextura) y viaja en el alfa del color de vertice. Solo imagen: ni red ni juego. A/B sin tocar los ajustes
## guardados: --sintexturas / --contexturas.
const TEXTURAS_VOXEL := "res://texturas/voxel_detalle.png"
var _texturas_on := false
var trozo_mat: ShaderMaterial = null    ## el de los escombros (ver _aplicar_texturas)
var _tex_voxel: TextureLayered = null   ## CompressedTexture2DArray (no hereda de Texture2DArray)

var _redondeo_on := true


func _aplicar_texturas() -> void:
	if world == null:
		return
	if _texturas_on and _tex_voxel == null:
		_tex_voxel = load(TEXTURAS_VOXEL) as TextureLayered
	_shader_mundo(false)
	var vs: float = world.get_voxel_size() if world.has_method("get_voxel_size") else 0.1
	if _texturas_on and world.opaque_material is ShaderMaterial:
		var m := world.opaque_material as ShaderMaterial
		m.set_shader_parameter("texturas_voxel", _tex_voxel)
		m.set_shader_parameter("textura_voxel", vs)
	# LOS CANTOS REDONDEADOS (ajuste "redondeo", voxel.gdshader): un 30 % del voxel en cada arista de fuera
	if world.opaque_material is ShaderMaterial:
		(world.opaque_material as ShaderMaterial).set_shader_parameter("redondeo", 0.3 if _redondeo_on else 0.0)
	if _texturas_on and _tex_voxel == null:
		push_warning("[texturas] no se pudo cargar %s (¿falta importarla?)" % TEXTURAS_VOXEL)
	# LOS ESCOMBROS CON EL COLOR Y LA TEXTURA DEL MATERIAL (trozo.gdshader): las particulas del motor y los trozos del mazo
	if trozo_mat == null:
		trozo_mat = ShaderMaterial.new()
		trozo_mat.shader = preload("res://shaders/trozo.gdshader")
	trozo_mat.set_shader_parameter("texturas_voxel", _tex_voxel)
	trozo_mat.set_shader_parameter("textura_fuerza", 1.0 if (_texturas_on and _tex_voxel != null) else 0.0)
	if world.opaque_material is ShaderMaterial:
		var cv = (world.opaque_material as ShaderMaterial).get_shader_parameter("color_vivo")
		if cv != null:
			trozo_mat.set_shader_parameter("color_vivo", float(cv))
	if world.has_method("set_debris_material") and not ("--escombrosgrises" in OS.get_cmdline_user_args()):
		world.set_debris_material(trozo_mat)
	if effects:
		effects.trozo_mat = trozo_mat
	if world.glass_material is ShaderMaterial:
		var gm := world.glass_material as ShaderMaterial
		gm.set_shader_parameter("textura_on", 1.0 if _texturas_on else 0.0)
		if _texturas_on:
			gm.set_shader_parameter("texturas_voxel", _tex_voxel)
			gm.set_shader_parameter("textura_voxel", vs)

## La escala que da DISTANCIA_DIBUJO depende del preset del MOTOR, y el motor se crea de nuevo al cargar el
## mapa: por eso esto se llama tambien tras _load_world (antes de cargar no hay motor y salia 86 m, no 120).
func _fijar_distancia() -> void:
	if world and world.has_method("set_render_distance_scale"):
		world.set_render_distance_scale(1.0)
		var base_rd: float = world.get_render_distance() if world.has_method("get_render_distance") else 100.0
		world.set_render_distance_scale(DISTANCIA_DIBUJO / maxf(base_rd, 1.0))
	_ajustar_niebla()

func _ajustar_niebla() -> void:
	if env == null or env.environment == null or world == null:
		return
	var e: Environment = env.environment
	var rd: float = world.get_render_distance() if world.has_method("get_render_distance") else 140.0
	rd = maxf(rd, 30.0)
	e.fog_mode = Environment.FOG_MODE_DEPTH
	_niebla_inicio = rd * NIEBLA_INICIO
	e.fog_depth_begin = _niebla_inicio
	e.fog_depth_end = rd * NIEBLA_TOTAL
	e.fog_depth_curve = 1.0
	e.fog_density = 1.0
	if player and player.cam:
		player.cam.far = maxf(rd * 1.25, 80.0)

