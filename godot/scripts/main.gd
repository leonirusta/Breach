# --- LOS VIGIAS (2026-10-15, pedido: "en la cafeteria, que algunos enemigos, por lo menos dos, detecten en 360 y con el
# alcance de antes"). Los demas bots ven a VISTA_BOTS_CAFETERIA x 45 m y a 90 grados; VIGIAS_CAFETERIA bots rivales
# llevan la meta "vigia" (BotBase._can_see_player: 45 m de dia y de noche, en todas direcciones). Si uno cae, otro rival
# vivo toma el relevo. Solo quien manda (los bots piensan alli). --sinvigias = ninguno.
const VIGIAS_CAFETERIA := 2
var _vigias_t := 0.0

func _vigias_tick(dt: float) -> void:
	if current_map != "cafeteria" or enemies == null or (Net.is_online() and not Net.hosting):
		return
	_vigias_t -= dt
	if _vigias_t > 0.0:
		return
	_vigias_t = 1.0
	if "--sinvigias" in OS.get_cmdline_user_args():
		return
	var mio := Net.my_team()
	var hay := 0
	var libres: Array = []
	for e in enemies.get_children():
		if not is_instance_valid(e) or e.is_queued_for_deletion() or not ("team" in e) or not ("health" in e) or float(e.health) <= 0.0:
			continue
		if String(e.team) == mio and not Net.todos_contra_todos():
			continue          # los de tu equipo no: los vigias son rivales
		if e.has_meta("vigia"):
			hay += 1
		else:
			libres.append(e)
	while hay < VIGIAS_CAFETERIA and not libres.is_empty():
		var b = libres.pop_at(randi() % libres.size())
		b.set_meta("vigia", true)
		hay += 1
		print("[vigias] %s (%s) es vigia: ve a 45 m y en 360 grados" % [str(b.get("nombre_marcador")), String(b.team)])



## --chattest (en las dos copias LAN): a los 20 s el invitado manda un mensaje y 10 trozos de voz (un pitido); los dos
## imprimen lo que les llega
func _chat_test() -> void:
	Net.chat_llega.connect(func(n, t, e): print("[chattest] CHAT de %s (%s): %s" % [n, e, t]))
	var voces := [0]
	Net.voz_llega.connect(func(p, n, d): voces[0] += 1)
	await get_tree().create_timer(20.0).timeout
	if Net.is_online() and not Net.hosting:
		Net.net_chat("hola desde el invitado")
		# una frase de verdad con TwoVoIP: cabecera, 50 trozos de Opus de un pitido y el final
		var enc = ClassDB.instantiate("TwovoipOpusEncoder")
		print("[chattest] TwoVoIP cargado: %s" % str(enc != null))
		if enc:
			enc.initialize(48000, 48000, 1, 0, 0, 960)
			enc.create_opus_encoder(16000, 5, true)
			Net.net_voz(JSON.stringify({"opusframesize": 960, "opussamplerate": 48000, "opuschannels": 1, "lenchunkprefix": 2,
				"opusstreamcount": 0, "opusframecount": 0, "talkingtimestart": 0.0}).to_ascii_buffer())
			for k in 50:
				var trozo := PackedVector2Array()
				trozo.resize(enc.get_required_input_chunk_size())
				for j in trozo.size():
					var v := 0.3 * sin((k * trozo.size() + j) * 0.06)
					trozo[j] = Vector2(v, v)
				enc.process_chunk(trozo)
				Net.net_voz(enc.encode_chunk(PackedByteArray([k % 256, 0]), 0))
				await get_tree().create_timer(0.02).timeout
			Net.net_voz(JSON.stringify({"opusstreamcount": 0, "opusframecount": 50, "talkingtimeduration": 1.0, "talkingtimeend": 1.0}).to_ascii_buffer())
	else:
		Net.net_chat("hola desde el anfitrion")
	await get_tree().create_timer(8.0).timeout
	var cv = hud.root.get_node_or_null("ChatVoz") if hud else null
	var cola := -1
	if cv and not cv._voces.is_empty():
		var a = cv._voces.values()[0]
		var sp = a.get_node_or_null("TwoVoipSpeaker")
		if sp and sp.audio_stream_playback_opus:
			cola = sp.audio_stream_playback_opus.get_skips(false)
		print("[chattest] altavoz: %s en %s (3D: %s)" % [a.name, a.get_parent().name, str(a is AudioStreamPlayer3D)])
		var rv = AudioServer.get_bus_effect(AudioServer.get_bus_index("VozRed"), 0)
		print("[chattest] acustica: tapado %.2f · volumen %.1f dB · corte %.0f Hz · sala %.2f · eco %.2f" % [float(a.get_meta("ocl", -1.0)),
			a.volume_db, a.attenuation_filter_cutoff_hz, rv.room_size, rv.wet])
	print("[chattest] %s: paquetes de voz recibidos %d" % ["anfitrion" if Net.hosting else "invitado", voces[0]])



