## --destrozoperf=N (2026-10-10, banco de la fisica: "que no baje de 60 fps destruyendo"): el MISMO destrozo en cada
## corrida (N explosiones contra las paredes de alrededor, una cada 0,25 s, desde el mismo sitio) y 30 s midiendo los
## fotogramas mientras cae y se asienta todo. Para ABAB sin el azar de los bots (usar con --nobots).
func _destrozo_perf(n: int) -> void:
	await get_tree().create_timer(8.0).timeout
	if team_overlay != null:
		Net.choose_team(Net.TEAM_T)
		_close_team_select()
	player.global_position = Vector3(30, 1.3, 40)
	player.velocity = Vector3.ZERO
	player.set("invulnerable", true)
	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)   # el tiempo de verdad, sin el escalon de 16,7/33
	Engine.max_fps = 0
	await get_tree().create_timer(1.0).timeout
	var hechas := 0
	for k in n * 4:
		if hechas >= n:
			break
		var ang := float(k) * 2.39996 + 0.3
		var alto := 1.5 if k % 2 == 0 else 4.0
		var o: Vector3 = Vector3(30, 1.3 + alto, 40)
		var h: Dictionary = world.raycast(o, Vector3(cos(ang), 0.0, sin(ang)), 28.0)
		if not h.get("hit", false):
			continue
		world.explode(h.position, 2.6, 255)
		hechas += 1
		await get_tree().create_timer(0.25).timeout
	var tiempos: Array = []
	var fis_max := 0.0
	var fin := Time.get_ticks_msec() + 30000
	var t_ant := Time.get_ticks_usec()
	var muestras := 0
	while Time.get_ticks_msec() < fin:
		await get_tree().process_frame
		var t := Time.get_ticks_usec()
		tiempos.append((t - t_ant) / 1000.0)
		t_ant = t
		muestras += 1
		if muestras % 60 == 0:
			fis_max = maxf(fis_max, Performance.get_monitor(Performance.TIME_PHYSICS_PROCESS) * 1000.0)
	tiempos.sort()
	var med: float = tiempos[tiempos.size() / 2]
	var p95: float = tiempos[int(tiempos.size() * 0.95)]
	var p99: float = tiempos[int(tiempos.size() * 0.99)]
	var sobre := 0
	for x in tiempos:
		if x > 17.5:
			sobre += 1
	var st: Dictionary = world.get_stats()
	print("[destrozoperf] %d explosiones · 30 s: mediana %.1f ms · p95 %.1f · p99 %.1f · >17,5 ms: %d de %d · bloques %s, despiertos %s, asentados por tope %s" % [
		hechas, med, p95, p99, sobre, tiempos.size(), str(st.get("bodies_active", "?")), str(st.get("bodies_awake", "?")), str(st.get("asentados_por_tope", "?"))])
	get_tree().quit()


