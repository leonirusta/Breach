## --acercarse[=cx,cy,cz,lejos_x,lejos_z] (2026-10-02, pedido: "cuando me acerco a un lugar muy destruido da mucho lag, si
## duermen las fisicas y los escombros?"). Sin bots: revienta a fondo una zona (40 explosiones en 12 m), espera a que se
## asiente, se lleva al jugador LEJOS (mas de los 70 m a los que se duermen los bloques), espera, y lo trae de vuelta
## ANDANDO a 6 m/s hasta el centro. Mide cada cuadro del regreso: los peores con lo que pesaba en ellos (fases del mundo,
## bloques despiertos, llamadas de dibujo). Tres idas y vueltas.
func _acercarse_test(arg: String) -> void:
	var c := Vector3(32.0, 1.2, 60.0)
	var lejos := Vector2(85.0, 6.0)
	if arg != "":
		var v := arg.split(",")
		c = Vector3(float(v[0]), float(v[1]), float(v[2]))
		lejos = Vector2(float(v[3]), float(v[4]))
	await get_tree().create_timer(6.0).timeout
	player.set("invulnerable", true)
	for e in (enemies.get_children() if enemies else []):
		if is_instance_valid(e):
			e.queue_free()
	var rng := RandomNumberGenerator.new()
	rng.seed = 777
	# LAS BOMBAS DE LA PRUEBA, 10 VECES MAS GRANDES (2026-10-02, pedido: "que la explosion sea 10 veces mas grande para mas
	# destruccion, solo las bombas de pruebas"). --acercarsebomba=<factor> lo cambia (1 = las de antes).
	var factor := 10.0
	for fb in OS.get_cmdline_user_args():
		if String(fb).begins_with("--acercarsebomba="):
			factor = float(String(fb).substr(17))
	for i in 40:
		var p := c + Vector3(rng.randf_range(-12, 12), rng.randf_range(0.0, 7.0), rng.randf_range(-12, 12))
		world.explode(p, rng.randf_range(1.5, 3.2) * factor, 255)
		for _f in 6:
			await get_tree().process_frame
	print("[acercarse] zona reventada; esperando a que se asiente")
	await get_tree().create_timer(15.0).timeout
	for vuelta in 3:
		var lejos3: Vector3 = world.find_ground(Vector3(lejos.x, 30.0, lejos.y))
		player.global_position = lejos3 + Vector3(0, 0.1, 0)
		player.velocity = Vector3.ZERO
		await get_tree().create_timer(10.0).timeout
		var st0: Dictionary = world.get_stats()
		print("[acercarse] vuelta %d: lejos (a %.0f m) · bloques despiertos %d de %d" % [vuelta,
			Vector2(lejos3.x, lejos3.z).distance_to(Vector2(c.x, c.z)), int(st0.get("bodies_awake", -1)), int(st0.get("bodies_solid", -1))])
		var desde: Vector3 = player.global_position
		var dist := Vector2(desde.x, desde.z).distance_to(Vector2(c.x, c.z))
		var dur := dist / 6.0
		var t := 0.0
		var tiempos: Array = []
		var peores: Array = []
		var t_prev := Time.get_ticks_usec()
		while t < dur + 2.0:
			await get_tree().process_frame
			var ahora := Time.get_ticks_usec()
			var ms := (ahora - t_prev) / 1000.0
			t_prev = ahora
			var dt := get_process_delta_time()
			t += dt
			var k := clampf(t / dur, 0.0, 1.0)
			var q := desde.lerp(Vector3(c.x, desde.y, c.z), k)
			var g: Vector3 = world.find_ground(Vector3(q.x, q.y + 3.0, q.z))
			player.global_position = Vector3(q.x, (g.y + 0.05) if g.y > -1.0 else q.y, q.z)
			player.velocity = Vector3.ZERO
			tiempos.append(ms)
			if ms > 25.0:
				var st: Dictionary = world.get_stats()
				var partes := PackedStringArray()
				for kk in ["t_hl_update", "t_hl_upload", "t_hl_blocks", "t_hl_regions", "t_hl_phys", "t_hl_spawn", "t_hl_bodies",
						"t_hl_b_mover", "t_hl_bs_fina", "t_hl_bs_asentar", "t_hl_bs_cerca", "t_hl_b_solidificar", "t_hl_debris"]:
					if float(st.get(kk, 0.0)) >= 1.0:
						partes.append("%s %.0f" % [String(kk).replace("t_hl_", ""), float(st[kk])])
				peores.append([ms, "%.0f ms a %.0f m del centro · mundo %.0f (%s) · colisiones nuevas %d (%d tri, el cuadro anterior %d tri) · despiertos %d · dibujos %d · objetos %d · fisica %.1f" % [
					ms, Vector2(q.x, q.z).distance_to(Vector2(c.x, c.z)), float(st.get("t_host_ms", 0.0)), ", ".join(partes),
					int(st.get("fis_formas_ultimo", 0)), int(st.get("fis_tris_ultimo", 0)), int(st.get("fis_tris_previo", 0)),
					int(st.get("bodies_awake", -1)), int(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME)),
					int(Performance.get_monitor(Performance.RENDER_TOTAL_OBJECTS_IN_FRAME)),
					Performance.get_monitor(Performance.TIME_PHYSICS_PROCESS) * 1000.0]])
		# QUIEN SIGUE DESPIERTO AQUI, y por que no se congela
		var vivos_c := {}
		for bi in world.bodies_info():
			var bd: Dictionary = bi
			if bool(bd["congelado"]) or (bd["pos"] as Vector3).distance_to(c) > 25.0:
				continue
			var tam := "chico" if int(bd["voxels"]) <= 60 else ("medio" if int(bd["voxels"]) <= 400 else "grande")
			var clave := "%s %s%s%s" % [tam, "rigido" if bool(bd["rigido"]) else "barato", " anclado" if bool(bd["anclado"]) else "",
				" se mueve" if float(bd["vel"]) > 0.35 else " quieto"]
			vivos_c[clave] = int(vivos_c.get(clave, 0)) + 1
		print("[acercarse] vuelta %d: sin congelar a menos de 25 m: %s" % [vuelta, str(vivos_c)])
		tiempos.sort()
		var n := tiempos.size()
		print("[acercarse] vuelta %d: %d cuadros · mediana %.1f ms · p95 %.1f · peor %.1f · >25 ms %d" % [vuelta, n,
			tiempos[n / 2], tiempos[int(n * 0.95)], tiempos[n - 1], peores.size()])
		peores.sort_custom(func(x, y): return x[0] > y[0])
		for pe in peores.slice(0, 8):
			print("[acercarse]    %s" % pe[1])
	get_tree().quit()


