					var a_l: float = await medir_p.call(2.5)
					con_l += a_l / 3.0
					for ndl in luces_p:
						(ndl as Light3D).visible = false
					await get_tree().process_frame
					var b_l: float = await medir_p.call(2.5)
					for ndl in luces_p:
						(ndl as Light3D).visible = true
					await get_tree().process_frame
					difs_l.append(b_l - a_l)
				print("[gpupausa] escala %.2f (real %.2f, modo %d): con luces %.2f ms · sin las %d luces %+.2f ms (vueltas %s)" % [escala, vpp.scaling_3d_scale,
					vpp.scaling_3d_mode, con_l, luces_p.size(), (float(difs_l[0]) + float(difs_l[1]) + float(difs_l[2])) / 3.0,
					", ".join(PackedStringArray(difs_l.map(func(x): return "%+.1f" % float(x))))])
			get_tree().quit()
			return
		if "--gpupausanodos" in OS.get_cmdline_user_args():
			var clases_p := {
				"luces (Omni/Spot)": func(nd: Node) -> bool: return (nd is OmniLight3D or nd is SpotLight3D),
