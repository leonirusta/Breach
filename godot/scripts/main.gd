## Comprueba la ciudad nueva: cuantos edificios, que altura alcanzan y si se puede SUBIR por las
## escaleras (se sondea la columna del hueco de escalera planta a planta).
func _city_test() -> void:
	await get_tree().create_timer(3.0).timeout
	var size: Vector3 = world.get_world_size()
	var centers: PackedVector3Array = world.get_building_centers()
	# edificio mas alto, anclado a un CENTRO REAL del generador (antes sondeaba a ciegas y caia fuera)
	var best := Vector3.ZERO
	var best_h := 0.0
	for c in centers:
		var r: Dictionary = world.raycast(Vector3(c.x, size.y - 1.0, c.z), Vector3.DOWN, size.y)
		if r.hit and r.position.y > best_h:
			best_h = r.position.y
			best = Vector3(c.x, r.position.y, c.z)
	print("[ciudad] %d edificios · el mas alto: %.1f m en %.1f,%.1f" % [centers.size(), best_h, best.x, best.z])
	# borde del tejado hacia +x y +z (ahi va la caja de escalera)
	var x1 := best.x
	while x1 < size.x - 1.0:
		var rr: Dictionary = world.raycast(Vector3(x1 + 0.25, best_h + 2.0, best.z), Vector3.DOWN, 4.0)
		if not rr.hit or absf(rr.position.y - best_h) > 0.4:
			break
		x1 += 0.25
	var z1 := best.z
	while z1 < size.z - 1.0:
		var rr2: Dictionary = world.raycast(Vector3(best.x, best_h + 2.0, z1 + 0.25), Vector3.DOWN, 4.0)
		if not rr2.hit or absf(rr2.position.y - best_h) > 0.4:
			break
		z1 += 0.25
	# misma cuenta que el generador
	var tt := 0.25
	var sx1: float = x1 - tt
	var sx0: float = sx1 - 2.7
	var sz1: float = z1 - tt
	var sz0: float = sz1 - 2.8
	print("[ciudad] caja de escalera: x %.1f..%.1f  z %.1f..%.1f  (tejado %.1f)" % [sx0, sx1, sz0, sz1, best_h])
	# recorrido: medio tramo izquierdo (+z) y medio derecho (-z), planta a planta
	var alturas: Array = []
	for k in 7:
		var px: float = sx0 + 0.6
		var pz: float = sz0 + 0.2 + k * 0.25
		var r3: Dictionary = world.raycast(Vector3(px, best_h + 1.0, pz), Vector3.DOWN, best_h + 2.0)
		alturas.append(r3.position.y if r3.hit else -1.0)
	for k in 7:
		var px2: float = sx1 - 0.6
		var pz2: float = sz1 - 0.2 - k * 0.25
		var r4: Dictionary = world.raycast(Vector3(px2, best_h + 1.0, pz2), Vector3.DOWN, best_h + 2.0)
		alturas.append(r4.position.y if r4.hit else -1.0)
	print("[ciudad] alturas del recorrido (izq -> rellano -> der): %s" % str(alturas))
	# hueco maximo entre peldanos consecutivos
	var maxsalto := 0.0
	for i in range(1, alturas.size()):
		if alturas[i] > 0 and alturas[i - 1] > 0:
			maxsalto = maxf(maxsalto, absf(alturas[i] - alturas[i - 1]))
	print("[ciudad] salto maximo entre peldanos: %.2f m  -> %s (el jugador sube hasta 0.55)" % [
		maxsalto, "SE SUBE" if maxsalto <= 0.55 else "HAY UN HUECO QUE NO SE SUBE"])
	# altura libre sobre el recorrido
	var minlibre := 99.0
	for k in 12:
		var px3: float = sx0 + 0.6
		var pz3: float = sz0 + 0.2 + k * 0.22
		var down: Dictionary = world.raycast(Vector3(px3, best_h - 0.5, pz3), Vector3.DOWN, best_h)
		if not down.hit:
			continue
		var up: Dictionary = world.raycast(down.position + Vector3(0, 0.2, 0), Vector3.UP, 10.0)
		if up.hit:
			minlibre = minf(minlibre, up.position.y - down.position.y)
	print("[ciudad] altura libre minima sobre la escalera: %.2f m -> %s" % [
		minlibre, "pasas de pie" if minlibre > 1.85 else "TE DAS CON EL TECHO"])
	get_tree().quit()


func go_to_lobby() -> void:
	Settings.save()
	# SALIR DE LA PARTIDA ES SALIR DE LA SALA.
	#
	# Aqui solo se llamaba a `game_over()`, que limpia las referencias locales pero NO cierra la
	# conexion: volvias al lobby y seguias conectado, asi que a los demas les quedaba tu muñeco
	# plantado en el mapa -y disparable- hasta que cerraras el juego entero. `leave()` es quien cierra
	# el peer, y al cerrarse los demas reciben `peer_disconnected` y te retiran.
	if Net.is_online():
		Net.leave()
	Net.game_over()
	# El sonido de ambiente (viento, lluvia) lo lleva el autoload Audio, que NO se descarga al
	# cambiar de escena: al volver al lobby se seguia oyendo el mapa por debajo.
	Audio.stop_ambience()
	Audio.stop_wind()
	Audio.stop_rain()
	Audio.world = null
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	get_tree().change_scene_to_file.call_deferred("res://scenes/lobby.tscn")

