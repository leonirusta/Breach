# ---------------------------------------------------------------------------------------------------
# LOS BOTS VAN A BUSCAR ARMA (mapas con botin).
#
# Un bot sin arma no dispara, asi que lo primero que hace es ir al arma del suelo mas cercana. Al
# llegar la coge. Los puntos de botin NO se gastan: el que coge el bot te lo puedes seguir
# encontrando tu. Es mentirijilla, pero lo otro seria toquetear el botin y la red por un detalle que
# nadie puede ver (que arma exacta recogio un bot al otro lado del mapa).
#
# Y por si acaso, un plazo: el que a los 90 s no haya llegado a ninguna (se quedo trabado, o le toco
# una esquina sin botin) se arma igual. Un bot desarmado para siempre es un mueble.
## A que distancia del arma se da por llegado. Un bot no se planta encima del punto: su A* lo deja en
## el puesto, a un par de metros. Con 3 m casi ninguno llegaba (medido: 2 de 27 en un minuto).
const BOT_ARMA_ALCANCE := 5.0
## Y el plazo maximo. Tambien es lo que dura la ventaja: durante estos segundos los bots que no hayan
## encontrado nada siguen desarmados, que es el rato en el que tu estas buscando tu primera pistola.
const BOT_ARMA_PLAZO := 75.0
var _bots_armas_t := 0.0

func _bots_a_por_armas(dt: float) -> void:
	if not hay_botin or enemies == null or not is_instance_valid(enemies):
		return
	if zona_br != null and not ("--brbotsantes" in OS.get_cmdline_user_args()):
		# BATTLE ROYALE: los piensa bots_br.gd (aterrizar repartidos, lootear, esconderse, curarse)
		if _bots_br == null:
			_bots_br = preload("res://scripts/bots_br.gd").new()
			_bots_br.name = "BotsBR"
			add_child(_bots_br)
			_bots_br.empezar(self, world)
		return
	if Net.is_online() and not Net.hosting:
		return                              # los bots los manda el anfitrion
	_bots_armas_t -= dt
	if _bots_armas_t > 0.0:
		return
	_bots_armas_t = 2.0
	var bot = get_tree().get_first_node_in_group("botin")
	if bot == null or not ("puntos" in bot):
		return
	var t: float = float(Time.get_ticks_msec()) / 1000.0
	var en_el_avion: bool = player != null and is_instance_valid(player) and player.br_control != null
	for e in enemies.get_children():
		if not is_instance_valid(e) or not ("sin_arma" in e):
			continue
		# DESARMARLOS AQUI Y NO AL NACER. El botin se carga DESPUES que los bots, asi que en el
		# momento de crearlos `hay_botin` todavia es falso y se quedaban con el fusil puesto (medido:
		# 29 de 29 nacian armados). Aqui ya existe el botin, y cada bot se desarma una sola vez.
		if not e.has_meta("br_sin_arma"):
			e.set_meta("br_sin_arma", true)
			e.set_meta("busca_desde", t)
			if e.has_method("desarmar"):
				e.desarmar()
		if not bool(e.sin_arma):
			continue
		# MIENTRAS TU SIGAS EN EL AVION, ELLOS NO BUSCAN NADA.
		#
		# El reloj arrancaba al aparecer los bots -o sea al empezar la partida- y tu todavia estabas
		# volando: para cuando tocabas el suelo llevaban medio minuto buscando y estaban todos
		# armados. Ahora el reloj empieza cuando aterrizas TU, que es cuando empieza tu partida.
		#
		# OJO AL ORDEN: esto va DESPUES de desarmarlos. Puesto antes -que es como lo escribi la
		# primera vez- la funcion se iba de vuelta antes de tocar a nadie y los bots se quedaban con
		# el fusil de fabrica: el banco lo canto en el acto (0 sin arma, 29 con arma).
		if en_el_avion:
			e.set_meta("busca_desde", t)
			continue
		if ("health" in e) and float(e.health) <= 0.0:
			continue
		var p: Vector3 = (e as Node3D).global_position
		if not e.has_meta("busca_desde"):
			e.set_meta("busca_desde", t)
		if t - float(e.get_meta("busca_desde")) > BOT_ARMA_PLAZO:
			e.armar()
			continue
		# el arma del suelo mas cercana
		var mejor := Vector3.ZERO
		var mejor_d := 1e9
		for q in bot.puntos:
			if String(q.get("tipo", "")) != "arma":
				continue
			var pos: Vector3 = q["pos"]
			var d: float = p.distance_to(pos)
			if d < mejor_d:
				mejor_d = d
				mejor = pos
		if mejor_d > 1e8:
			continue
		if mejor_d <= BOT_ARMA_ALCANCE:
			e.armar()
			continue
		# a por ella, y se le recuerda cada pocos segundos (su A* puede rendirse por el camino)
		var ultimo: float = float(e.get_meta("busca_t")) if e.has_meta("busca_t") else -999.0
		if t - ultimo > 6.0 and e.has_method("assign_site"):
			e.assign_site(mejor, [mejor])
			e.set_meta("busca_t", t)


func _spawn_enemy_at(p: Vector3, id: int) -> void:
	var e := ENEMY_SCENE.instantiate()
	var repartidos: Array = _puntos_aparicion() if hay_botin else []
	if ct_spawn != Vector3.ZERO:
		# los policías aparecen todos juntos en su spawn (ct_spawn del .sites.json) y de ahí cada uno sale hacia
		# su sitio o su ronda
		p = _ground_near(ct_spawn + Vector3(randf_range(-2.5, 2.5), 0.0, randf_range(-2.5, 2.5))) + Vector3(0, 0.4, 0)
	elif repartidos.size() >= 3:
		# MAPA CON BOTIN: los bots tambien nacen repartidos por los puntos de salida del mapa, no todos en
		# los dos sitios inventados. El indice salta de siete en siete para que dos bots seguidos no
		# caigan en puntos vecinos de la lista (el generador los suele escribir por zonas).
		p = _ground_near(repartidos[(id * 7 + 3) % repartidos.size()]) + Vector3(0, 0.4, 0)
	elif not bomb_sites.is_empty():
		var site: Dictionary = bomb_sites[id % bomb_sites.size()]
		var posts: Array = site.posts
		p = posts[randi() % posts.size()] + Vector3(0, 0.4, 0)
	# EL HUECO SE BUSCA ANTES DE METERLO EN LA ESCENA: dentro ya contaria como ocupante, y como
	# todavia no tiene sitio estaria en el origen del mapa estorbandose a si mismo.
	p = _sitio_libre(p)
	enemies.add_child(e)
	e.global_position = p
	e.setup(world, player, id)
	if e.red_id == 0:
		e.red_id = _nuevo_id_bot()   # el numero que viaja por la red
	if not bomb_sites.is_empty():
		var site2: Dictionary = bomb_sites[id % bomb_sites.size()]
		if (id / bomb_sites.size()) % 2 == 1:
			# "rondas": la mitad de los bots patrulla por todo el mapa (puestos de ambos sitios + puntos de suelo
			# repartidos, incluida la zona del spawn) en vez de quedarse en su sitio. Así hay encuentros por el
			# camino y no parece que "no hay bots".
			var route: Array = []
			for b in bomb_sites:
				route.append(b.posts[randi() % b.posts.size()])
			var sp0: Vector3 = world.get_spawn_position()
			var ref_y: float = site2.pos.y
			for k in 12:
				if route.size() >= bomb_sites.size() + 4:
					break
				var g: Vector3 = _random_ground_point()
				if g.y >= 0.0 and absf(g.y - ref_y) < 5.0:   # a nivel de calle, no azoteas ni sótanos
					route.append(g)
			route.append(_ground_near(sp0 + Vector3(randf_range(-12, 12), 0, randf_range(-12, 12))))
			e.assign_site(site2.pos, route)
			e.guard_t = randf_range(1.0, 3.0)
			e.rover = true
		else:
			e.assign_site(site2.pos, site2.posts)
		if ct_spawn != Vector3.ZERO:
			e.deploy()   # sale ya hacia su puesto en vez de vigilar el spawn
	e.died.connect(_on_enemy_died)
	hud.set_bots_alive(enemies.get_child_count())

func _on_enemy_died(_pos: Vector3, equipo: String = "", asesino: Node = null, victima: String = "") -> void:
	if asesino != null and is_instance_valid(asesino) and asesino == player:
		Estadisticas.baja()
	kills += 1
	hud.set_kills(kills)
	hud.set_bots_alive(maxi(0, enemies.get_child_count() - 1))
	# DUELO A MUERTE: el punto es del bando CONTRARIO al que ha caido, y el que llegue al objetivo
	# gana. Los bots vuelven a su base a los pocos segundos, como cualquiera.
	if ciudad3:
		_dm_anotar(victima, equipo, _nombre_nodo(asesino), _equipo_nodo(asesino))
		if not ciudad_terminada:
			# ATRACO: 15 s en el suelo para que lo revivan sus compañeros (rescate.gd, que lo repone al momento);
			# si nadie lo hace, vuelve a su base. _dm_reponer_bot no pone uno de mas si ya lo revivieron.
			var tc := get_tree().create_timer(ESPERA_ATRACO)
			tc.timeout.connect(_dm_reponer_bot.bind(equipo, victima))
		return
	# EN BOMBA TAMBIEN SE ANOTA. Antes solo llevaban cuenta el duelo a muerte y la ciudad, asi que al
	# acabar una partida de bomba no habia tabla que enseñar: ni bajas, ni muertes, ni quien la lio.
	if bomb_mode:
		_dm_anotar(victima, equipo, _nombre_nodo(asesino), _equipo_nodo(asesino))
	if dm_mode:
		# primero la tabla, luego el punto: si esta baja es la que gana, tiene que salir en la pantalla
		_dm_anotar(victima, equipo, _nombre_nodo(asesino), _equipo_nodo(asesino))
		if Net.es_dm_elim():
			return          # SIN REAPARECER: ni punto ni repuesto (lo arbitra _elim_tick; la RCP lo levanta)
		if Net.es_dm_todos():
			_dm_punto_todos(_nombre_nodo(asesino))       # todos contra todos: la baja es de quien la hizo
		else:
			_dm_punto(Net.TEAM_CT if equipo == Net.TEAM_T else Net.TEAM_T)
		if not dm_terminado:
			var tdm := get_tree().create_timer(randf_range(3.0, 6.0))
			# vuelve CON SU NOMBRE: en la tabla es el mismo jugador, que ha reaparecido
			tdm.timeout.connect(_dm_reponer_bot.bind(equipo, victima))
		return
	# EN MODO BOMBA NO REAPARECEN. Aqui se reponia un bot a los seis segundos SIEMPRE, y en un mapa
	# por rondas eso es doble error: los ves brotar del spawn en mitad de la ronda -que es lo que se
	# veia en dust2- y ademas la ronda no puede ganarse eliminando al equipo contrario, porque el
	# equipo contrario es infinito.
	#
	# Con rondas, los bots vuelven cuando vuelven los jugadores: al empezar la siguiente. Sin rondas
	# (la ciudad, que es a matar sin fin) se repone como antes, que ahi si tiene sentido.
	if bomb_mode:
		return
	# BATTLE ROYALE: el que cae, cae (zona_br.gd cuenta los vivos y cierra la partida)
	if zona_br != null and is_instance_valid(zona_br):
		return
	var t := get_tree().create_timer(6.0)
	t.timeout.connect(_respawn_enemy)

## Suelo más cercano a una coordenada dada (con su altura): rayo hacia abajo desde 2 m por encima. find_ground
## busca desde el techo del mapa y devuelve azoteas cuando el punto está bajo un edificio.
func _ground_near(p: Vector3) -> Vector3:
	var r: Dictionary = world.raycast(p + Vector3(0, 2.0, 0), Vector3.DOWN, 8.0)
	if r.hit:
		return Vector3(p.x, r.position.y, p.z)
	return world.find_ground(p)

## Objetivo del terrorista en el HUD: sitio más cercano, distancia y si ya puede plantar.
func _update_objective() -> void:
	# EN OLEADAS EL CARTEL ES DE `pve.gd`. Esto corre cada seis cuadros siempre que haya sitios de
	# bomba, y un mapa sin `.sites.json` se INVENTA dos (`_load_bomb_sites`), asi que tambien corria en
	# la cuarentena: sin bomba ni atraco, borraba el cartel. En el anfitrion apenas se notaba, porque el
	# modo oleadas lo reescribe sin parar; en el invitado solo llega dos veces por segundo, y "falta 1
	# monstruo" aparecia y desaparecia. Lo conto el usuario.
	if pve != null:
		return
	if not bomb_mode:
		# en la ciudad manda el atraco: la línea de objetivo la escribe heist.gd
		if not is_instance_valid(heist):
			hud.set_objective("", false)
		return
	var best := -1
	var bd := 1e9
	for i in bomb_sites.size():
		var dd: float = bomb_sites[i].pos.distance_to(player.global_position)   # esfera, igual que al plantar
		if dd < bd:
			bd = dd
			best = i
	if best < 0:
		return
	var letter := "A" if best == 0 else "B"
	var plant_hint := "botón ARMA hasta C4"      # (sin "tecla 4": sin letras de teclas, el juego es para el movil)
	# LA POLICIA NO PLANTA NADA. Le salia el objetivo del terrorista ("C4 en la ranura 4"), una
	# ranura que ni siquiera tiene.
	if player.team == Net.TEAM_CT:
		if is_instance_valid(Net.bomb_node):
			hud.set_objective("¡C4 PLANTADA! Ve al sitio y %s para desactivarla" % ("mantén USAR" if Settings.is_touch() else "mantén [E]"), true)
		else:
			hud.set_objective("Defiende el sitio %s (a %d m): no dejes que planten" % [letter, int(bd)], bd <= site_radius)
		return
	# terrorista: primero hay que tener la bomba
	if not player.has_c4():
		if is_instance_valid(Net.bomb_node):
			hud.set_objective("C4 plantada en el sitio %s: defiendela hasta que estalle" % letter, true)
		else:
			hud.set_objective("Coge la C4: esta en el suelo de vuestra base", false)
		return
	if bd <= site_radius:
		hud.set_objective("EN SITIO %s: planta la C4 (%s y disparar apuntando a una superficie)" % [letter, plant_hint], true)
	else:
		hud.set_objective("Sitio %s a %d m. C4 en la ranura 4 (%s)" % [letter, int(bd), plant_hint], false)

## Copia la posición del jugador al portapapeles (F9 / botón COPIAR XYZ): para marcar sitios, spawns, pruebas.
func copy_coords() -> void:
	var p: Vector3 = player.global_position
	var txt := "%.1f, %.1f, %.1f" % [p.x, p.y, p.z]
	DisplayServer.clipboard_set(txt)
	hud.flash_message("Coordenadas copiadas: " + txt)
	print("[Breach] coordenadas: ", txt)

## Interruptor de bots (F7 / botón BOTS): para probar destrucción sin que te disparen.
##
## ES UN AJUSTE QUE SE GUARDA, no algo de esta partida: al apagarlo, la SIGUIENTE partida tambien
## empieza sin bots. Por eso el aviso lo dice; si no, pasa lo de siempre -lo apagas para probar algo,
## se te olvida, y dos dias despues los mapas salen vacios sin saber por que-.
func set_bots(on: bool) -> void:
	# EN RED, LOS BOTS LOS PONE EL ANFITRION.
	#
	# Un invitado que pulsara esto borraba de su pantalla los bots que le manda el anfitrion: se
	# quedaban `_bots_copia` apuntando a nodos liberados y NO volvian a aparecer nunca, porque el
	# anfitrion ya los habia anunciado y no los anuncia dos veces. En su partida no habia bots y en la
	# de los demas si.
	if Net.is_online() and not Net.hosting:
		hud.flash_message("Los bots los pone el anfitrión de la partida")
		hud.set_bots_state(Settings.bots_enabled)
		return
	# Sin red no hay bots que encender. Antes esto guardaba el ajuste y no pasaba nada mas: parecia
	# que el boton estaba roto.
	if on and not Settings.bots_permitidos():
		hud.flash_message("Los bots son de las partidas online")
		hud.set_bots_state(false)
		return
	Settings.bots_enabled = on
	Settings.save()
	if not on:
		for e in enemies.get_children():
			e.queue_free()
	elif enemies.get_child_count() == 0 and not loading:
		spawn_enemies()
	hud.flash_message("Bots: %s%s" % ["ACTIVADOS" if on else "DESACTIVADOS",
		"" if on else " · también en tus próximas partidas"])
	hud.set_bots_state(on)

func _respawn_enemy() -> void:
	if not is_inside_tree() or loading or not Settings.bots_activos() or Settings.modo == "pve":
		return
	if not bomb_sites.is_empty():
		_spawn_enemy_at(Vector3.ZERO, randi() % 1000)
		return
	var centers: PackedVector3Array = world.get_building_centers()
	if centers.is_empty():
		_spawn_enemy_at(_random_ground_point() + Vector3(0, 0.4, 0), randi() % 1000)
		return
	var c := centers[randi() % centers.size()]
	_spawn_enemy_at(Vector3(c.x, 0.9, c.z), randi() % 1000)

func _on_piece_detached(pos: Vector3, voxels: int, material: int = 0) -> void:
	Audio.piece_break(material, pos, voxels)
	_derrumbe_cuenta(voxels)
	# El mundo cambió: la IA cercana vuelve a planificar (nuevas rutas / líneas de visión).
	# Antes esto avisaba a TODOS los bots a 25 m en CADA destrucción: con una tanda de explosiones
	# replanificaban A* sin parar y el coste de los bots se disparó a 4,8 ms/frame. Se limita a los
	# realmente cercanos y con enfriamiento por bot (dentro de invalidate_path).
	for e in enemies.get_children():
		if e.has_method("invalidate_path") and e.global_position.distance_to(pos) < 14.0:
			e.invalidate_path()
	# El movil NO vibra porque se caiga un cascote: con una demolicion el telefono se pasaba medio
	# minuto temblando. La vibracion queda solo para lo que te afecta a ti: disparar y recibir dano.

## CAMARA LENTA EN LOS DERRUMBES (2026-11-01, pedido: "cuando cae un edificio grande, un segundo de camara lenta; la
## veran todos"): lo que se suelta en medio segundo se suma; si pasa de DERRUMBE_VOXELS, quien manda (solo o el anfitrion)
## la pide para todos (Net.net_camara_lenta). Una cada DERRUMBE_ENFRIA_S como mucho. --sincamaralenta = sin ella.
const DERRUMBE_VOXELS := 2500
const DERRUMBE_ENFRIA_S := 15.0
const LENTA_BAJA_PROB := 0.08     ## cada baja tiene esta probabilidad de dar camara lenta
var _derr_suma := 0
var _derr_t0 := 0
var _derr_ultima := -100000
static var _sin_camara_lenta: bool = "--sincamaralenta" in OS.get_cmdline_user_args()

func _derrumbe_cuenta(voxels: int) -> void:
	if _sin_camara_lenta or loading or (Net.is_online() and not Net.hosting):
		return
	var ahora := Time.get_ticks_msec()
	if ahora - _derr_t0 > 500:
		_derr_t0 = ahora
		_derr_suma = 0
	_derr_suma += voxels
	if _derr_suma >= DERRUMBE_VOXELS and ahora - _derr_ultima > int(DERRUMBE_ENFRIA_S * 1000.0):
		_derr_ultima = ahora
		_derr_suma = 0
		Net.net_camara_lenta()

var _diag_frames := 0
var _struct_debug: Node3D = null    # visualización del analizador estructural (F11, sólo depuración)
var _ao_quad: MeshInstance3D = null # oclusión volumétrica: pasada a pantalla completa (voxel_ao.gdshader), F12
var _ao_on := false                 # la oclusión volumétrica encendida (en los materiales o en la pasada)
var _ao_rayos := 2                  # rayos y pasos del nivel puesto (Bajo 1/4, Medio 2/5, Alto 3/6)
var _ao_pasos := 5
## La oclusion va como pasada a pantalla completa (shaders/voxel_ao.gdshader). `--aomaterial` la hace DENTRO del
## sombreado del mundo (shaders/ao_volumen.gdshaderinc, variante AO_MATERIAL): en el PC sale igual o peor (ver ese
## archivo); se deja para medirla en un movil.
var _ao_en_pantalla: bool = not ("--aomaterial" in OS.get_cmdline_user_args())

## La oclusión volumétrica con el nivel del ajuste (0 = apagada, 1 Bajo, 2 Medio, 3 Alto). `--aoforzado=N` manda
## sobre el ajuste en toda la partida (y `--sinao` es 0), tambien en las fotos.
func _ao_nivel(nv: int) -> void:
	if _ao_flag() >= 0:
		nv = _ao_flag()
	if nv > 0:
		_ao_rayos = [1, 1, 2, 3][nv]
		_ao_pasos = [4, 4, 5, 6][nv]
	set_voxel_ao(nv > 0)

## El nivel que fuerzan `--aoforzado=N` o `--sinao` (0), o -1 si no hay ninguno.
func _ao_flag() -> int:
	for q in OS.get_cmdline_user_args():
		if String(q).begins_with("--aoforzado="):
			return clampi(int(String(q).substr(12)), 0, 3)
		elif q == "--sinao":
			return 0
	return -1

## Los materiales que hacen la oclusión dentro con --aomaterial (ao_volumen.gdshaderinc): solo el del mundo.
func _ao_materiales() -> Array:
	return [world.opaque_material] if world.opaque_material is ShaderMaterial else []

## EL OSCURECIMIENTO DE LA PASADA, imitado con la exposicion en --aomaterial (2026-10-01). La pasada de pantalla
## multiplica (blend_mul) y en el renderizador Mobile eso multiplica tambien por su "luminance multiplier": con la
## oclusion encendida TODA la imagen, cielo incluido, sale a la mitad de luz (medido en fotos: el cielo 191 -> 146). Es
## el aspecto de siempre (la oclusion va encendida en el PC desde _on_world_ready y en ALTO/ULTRA), asi que la version
## del material lo conserva con la exposicion a la mitad. Foto contra foto: cafeteria brillo 0,99-1,003 y diferencia
## media 0,004-0,01 (solo bordes de silueta); de noche (episodio 1) igual salvo los casi negros (la pasada redondea en
## el buffer de 10 bits: <= 1 nivel de 255). `--aosinoscurecer` lo quita; `--aoexpo=X` prueba otra exposicion.
const AO_EXPOSICION := 0.5

func _ao_exposicion(on: bool) -> void:
	if env == null or env.environment == null:
		return
	var x := AO_EXPOSICION
	for q in OS.get_cmdline_user_args():
		if String(q).begins_with("--aoexpo="):
			x = float(String(q).substr(9))
		elif q == "--aosinoscurecer":
			x = 1.0
	(env.environment as Environment).tonemap_exposure = x if on else 1.0

## Oclusión volumétrica (2026-10-01): la MISMA cuenta de siempre contra la ocupación de voxels, pero dentro del
## sombreado del mundo, del cristal y del agua (shaders/ao_volumen.gdshaderinc) en vez de una pasada a pantalla
## completa que leía la profundidad: aquella costaba +1,0 a +1,55 ms de GPU en la cafetería, casi todo fijo (y en un
## móvil la copia de la profundidad obliga a guardarla en memoria cada fotograma). `--aopantalla` vuelve a la pasada.
func set_voxel_ao(on: bool) -> void:
	if not world.has_method("set_occlusion_volume"):
		return
	world.set_occlusion_volume(on)
	_ao_on = on
	if not _ao_en_pantalla:
		if on:
			_shader_mundo(false)   # la variante con AO_MATERIAL
		for m in _ao_materiales():
			var sm := m as ShaderMaterial
			if on:
				world.bind_occupancy_to_material(sm)
			sm.set_shader_parameter("ao_rays", _ao_rayos if on else 0)
			sm.set_shader_parameter("ao_steps", _ao_pasos)
			if "--aodiag" in OS.get_cmdline_user_args():
				print("[aodiag] on=%s mat=%s rays=%s occ=%s dims=%s cell=%s info=%s" % [on, sm.shader.resource_path if sm.shader else "?",
					str(sm.get_shader_parameter("ao_rays")), str(RenderingServer.material_get_param(sm.get_rid(), "occ")),
					str(RenderingServer.material_get_param(sm.get_rid(), "dims")), str(RenderingServer.material_get_param(sm.get_rid(), "cell")),
					str(world.get_occupancy_info())])
		_ao_exposicion(on)
		return
	if on and _ao_quad == null:
		_ao_quad = MeshInstance3D.new()
		var q := QuadMesh.new()
		q.size = Vector2(2, 2)
		q.flip_faces = true
		_ao_quad.mesh = q
		var m := ShaderMaterial.new()
		m.shader = load("res://shaders/voxel_ao.gdshader")
		m.render_priority = 100
		_ao_quad.material_override = m
		_ao_quad.extra_cull_margin = 16384.0
		_ao_quad.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		add_child(_ao_quad)
	if _ao_quad != null:
		_ao_quad.visible = on
		if on:
			world.bind_occupancy_to_material(_ao_quad.material_override)
			(_ao_quad.material_override as ShaderMaterial).set_shader_parameter("rays", _ao_rayos)
			(_ao_quad.material_override as ShaderMaterial).set_shader_parameter("steps", 0 if "--aosinrayos" in OS.get_cmdline_user_args() else _ao_pasos)

var ct_spawn := Vector3.ZERO        # spawn de los policías (bots); ZERO = aparecen en los puestos de los sitios
var site_radius := 6.0
var _matcol: Dictionary = {}   # cache de color por material (se consultaba por evento)
var _slow_frames := 0
var _worst_ms := 0.0
var _win_frames := 0
var _win_ms := 0.0
var _win_slow := 0

## Cuanto lleva mojandose (o secandose) el mapa: 0 seco, 1 calado. No salta de golpe porque un
## suelo no se empapa ni se seca en un fotograma.
var _mojado := 0.0


## EL MAPA MOJADO. No se dibuja nada nuevo: se le dice al material del mundo cuanta agua hay, y el
## propio shader oscurece la piedra y la vuelve reflectante, mas en las caras que miran al cielo que
## en las paredes. Tarda unos cinco segundos en empapar y el doble en secarse, como en la calle.
## ¿HAY ALGO SOBRE MI CABEZA? Se tira un rayo hacia arriba desde el jugador. Si topa con el mundo
## en los primeros 30 m, esta bajo techo: la lluvia no le cae encima y se oye de fuera.
## Se mira cuatro veces por segundo, no cada fotograma: un tejado no aparece y desaparece.
var _bajo_techo := false
var _techo_frac := 0.0     ## 0 a cielo abierto, 1 tapado del todo, y los valores de en medio valen
var _techo_t := 0.0
var _cubierto := 0.0        ## 0 a la intemperie, 1 dentro; se mueve suave para que el sonido no salte


## EL VIENTO DE ARRIBA. Se mide cuanto hay bajo tus pies: no vale la coordenada Y a secas, porque
## un mapa puede estar todo elevado. Se tira un rayo hacia abajo y lo que cuenta es la caida.
## Solo en la ciudad, que es donde hay edificios a los que subirse.
var _viento_t := 0.0
var _altura := 0.0


func _update_viento(dt: float) -> void:
	if player == null or world == null or not current_map.begins_with("city"):
		# Y SE APAGA AL SALIR DE LA CIUDAD. Antes esto solo era un `return`, y ahi estaba el fallo:
		# si te habias subido a un edificio, el viento se habia encendido y al cambiar de mapa nadie
		# le decia que parase. Seguia sonando en dust2, a ras de suelo, como si fuera el ambiente del
		# mapa. Mandarle un cero lo apaga por el mismo camino de siempre.
		_altura = 0.0
		Audio.wind_height(0.0)
		return
	_viento_t -= dt
	if _viento_t <= 0.0:
		_viento_t = 0.30
		var r: Dictionary = world.raycast(player.global_position + Vector3(0, -0.2, 0), Vector3.DOWN, 90.0)
		_altura = float(r.get("distance", 90.0)) if r.get("hit", false) else 90.0
	Audio.wind_height(_altura)


# --- MAPA DE TECHOS -----------------------------------------------------------------------------
# Para cada casilla del mapa, la altura de lo mas alto que hay ahi. El shader del mundo lo usa para
# saber si un trozo de suelo esta a la intemperie o bajo una losa (ver voxel.gdshader).
#
# Se hace con rayos desde arriba, y son muchos: 256x256 = 65.000. De golpe serian medio segundo de
# tiron justo al empezar la partida, asi que van A PLAZOS, unas pocas filas por cuadro, durante el
# primer segundo. Mientras tanto el filtro esta apagado y llueve en todas partes; un segundo de
# lluvia de mas no lo nota nadie, un tiron de medio segundo si.
const TECHO_PX := 256
var _techo_img: Image = null
var _techo_tex: ImageTexture = null
var _techo_datos: PackedByteArray = PackedByteArray()
var _techo_fila := 0
var _techo_altura := 64.0


func _techo_iniciar() -> void:
	if world == null or world.opaque_material == null:
		return
	var tam: Vector3 = world.get_world_size()
	_techo_altura = maxf(tam.y, 8.0)
	_techo_datos = PackedByteArray()
	_techo_datos.resize(TECHO_PX * TECHO_PX)
	_techo_fila = 0
	_techo_img = Image.create_from_data(TECHO_PX, TECHO_PX, false, Image.FORMAT_R8, _techo_datos)
	_techo_tex = ImageTexture.create_from_image(_techo_img)
	_techo_a_material(_rain_mat)
	var m := world.opaque_material as ShaderMaterial
	m.set_shader_parameter("techo_mapa", _techo_tex)
	m.set_shader_parameter("techo_org", Vector2.ZERO)
	m.set_shader_parameter("techo_tam", Vector2(tam.x, tam.z))
	m.set_shader_parameter("techo_alto", _techo_altura)
	m.set_shader_parameter("techo_hay", 0.0)


## Una tanda de filas por cuadro. Cuando llega al final enciende el filtro y no vuelve a costar nada.
func _techo_avanzar() -> void:
	if _techo_img == null or _techo_fila >= TECHO_PX or world == null:
		return
	var tam: Vector3 = world.get_world_size()
	var desde: float = _techo_altura + 4.0
	# en C++ van 32 filas por cuadro (las mismas cuentas; en GDScript eran 4)
	if not _techo_gd and world.has_method("techo_filas"):
		var hasta: int = mini(_techo_fila + 32, TECHO_PX)
		_techo_datos = world.techo_filas(_techo_datos, TECHO_PX, 0, TECHO_PX - 1, _techo_fila, hasta,
			tam.x / float(TECHO_PX), tam.z / float(TECHO_PX), desde, _techo_altura)
		_techo_fila = hasta
	for _r in 4:
		if _techo_fila >= TECHO_PX:
			break
		var z: float = (float(_techo_fila) + 0.5) / float(TECHO_PX) * tam.z
		var base: int = _techo_fila * TECHO_PX
		for x in TECHO_PX:
			var wx: float = (float(x) + 0.5) / float(TECHO_PX) * tam.x
			var r: Dictionary = world.raycast(Vector3(wx, desde, z), Vector3.DOWN, desde + 2.0)
			var h := 0.0
			if r.get("hit", false):
				h = float((r.get("position", Vector3.ZERO) as Vector3).y)
			_techo_datos[base + x] = int(clampf(h / _techo_altura, 0.0, 1.0) * 255.0)
		_techo_fila += 1
	_techo_img.set_data(TECHO_PX, TECHO_PX, false, Image.FORMAT_R8, _techo_datos)
	_techo_tex.update(_techo_img.duplicate())   # copia (hilo de render separado)
	if _techo_fila >= TECHO_PX:
		(world.opaque_material as ShaderMaterial).set_shader_parameter("techo_hay", 1.0)
		_techo_a_material(_rain_mat)      # y las gotas dejan de caer bajo los tejados


## AL ABRIR UN BOQUETE, el mapa se queda viejo: el shader seguiria creyendo que ahi hay techo y la
## lluvia no entraria por el agujero que acabas de hacer. Se rehace solo el cuadrado afectado, que
## son unas decenas de rayos, no sesenta y cinco mil.
func refrescar_techo(centro: Vector3, radio: float) -> void:
	if _techo_img == null or _techo_fila < TECHO_PX or world == null:
		return
	var tam: Vector3 = world.get_world_size()
	var px: float = tam.x / float(TECHO_PX)
	var pz: float = tam.z / float(TECHO_PX)
	var r: float = maxf(radio, 1.0) + 1.0
	var x0: int = clampi(int((centro.x - r) / px), 0, TECHO_PX - 1)
	var x1: int = clampi(int((centro.x + r) / px), 0, TECHO_PX - 1)
	var z0: int = clampi(int((centro.z - r) / pz), 0, TECHO_PX - 1)
	var z1: int = clampi(int((centro.z + r) / pz), 0, TECHO_PX - 1)
	# A PLAZOS (2026-10-01, medido: un cohete de 3 m eran ~900 rayos en GDScript, 13-16 ms dentro del fotograma de la
	# explosion, `ex.techo`). Se apunta el cuadrado y `_techo_cola_tick` lo rehace por filas con un tope de tiempo por
	# fotograma: queda al dia en unas decimas de segundo, tapado por el fogonazo y el humo. --techodegolpe: como antes.
	if "--techodegolpe" in OS.get_cmdline_user_args():
		_techo_filas(x0, x1, z0, z1 + 1, px, pz)
		_techo_img.set_data(TECHO_PX, TECHO_PX, false, Image.FORMAT_R8, _techo_datos)
		_techo_tex.update(_techo_img.duplicate())   # copia (hilo de render separado)
		return
	_techo_cola.append([x0, x1, z0, z1, px, pz])


var _techo_cola: Array = []           ## [x0, x1, z_siguiente, z1, px, pz] por rehacer
var _techo_gd: bool = "--techogd" in OS.get_cmdline_user_args()


func _techo_filas(x0: int, x1: int, za: int, zb: int, px: float, pz: float) -> void:
	var desde: float = _techo_altura + 4.0
	# en C++ (VoxelWorld.techo_filas, 2026-10-10): los mismos rayos sin un diccionario por casilla. --techogd = antes
	if not _techo_gd and world.has_method("techo_filas"):
		_techo_datos = world.techo_filas(_techo_datos, TECHO_PX, x0, x1, za, zb, px, pz, desde, _techo_altura)
		return
	for zz in range(za, zb):
		var base: int = zz * TECHO_PX
		for xx in range(x0, x1 + 1):
			var res: Dictionary = world.raycast(
				Vector3((float(xx) + 0.5) * px, desde, (float(zz) + 0.5) * pz), Vector3.DOWN, desde + 2.0)
			var h := 0.0
			if res.get("hit", false):
				h = float((res.get("position", Vector3.ZERO) as Vector3).y)
			_techo_datos[base + xx] = int(clampf(h / _techo_altura, 0.0, 1.0) * 255.0)


var _techo_subida_ms := 0


func _techo_cola_tick() -> void:
	if _techo_cola.is_empty() or _techo_img == null or world == null:
		return
	var t0 := Time.get_ticks_usec()
	var hecho := false
	while not _techo_cola.is_empty() and (not hecho or Time.get_ticks_usec() - t0 < 1500):
		var c: Array = _techo_cola[0]
		var z: int = c[2]
		_techo_filas(int(c[0]), int(c[1]), z, z + 1, float(c[4]), float(c[5]))
		hecho = true
		c[2] = z + 1
		if int(c[2]) > int(c[3]):
			_techo_cola.pop_front()
	# LA TEXTURA SE SUBE AL ACABAR (o cada 0,2 s mientras dura), no en cada cuadro (2026-10-02, medido con los bots a
	# cohetazos: con explosiones seguidas la cola no se vaciaba nunca y subir la imagen entera cada cuadro llevaba esta
	# fase a 11 ms de pico, con solo 1,5 de trabajo). Es lo que dice donde moja la lluvia: una decima tarde no se ve.
	var ahora_t := Time.get_ticks_msec()
	if _techo_cola.is_empty() or ahora_t - _techo_subida_ms >= 200:
		_techo_subida_ms = ahora_t
		_techo_img.set_data(TECHO_PX, TECHO_PX, false, Image.FORMAT_R8, _techo_datos)
		_techo_tex.update(_techo_img.duplicate())   # copia (hilo de render separado)
	Prof.add("techo.cola", Time.get_ticks_usec() - t0)


func _update_techo(dt: float) -> void:
	# ANTES ESTO SOLO CORRIA LLOVIENDO. Ya no: saber si estas a cubierto lo usan tambien la vista
	# acostumbrandose a la luz y las salpicaduras, y esas no dependen de que este cayendo agua ahora.
	# Es un rayo cada cuarto de segundo, no cuesta nada tenerlo siempre al dia.
	if player == null or world == null:
		return
	_techo_t -= dt
	if _techo_t <= 0.0:
		_techo_t = 0.25
		# CUANTO TECHO TIENES ENCIMA, NO SI TIENES O NO. Antes era UN rayo y una respuesta de si o no,
		# y ahi estaba el ruido: cruzando un pasillo con agujeros el rayo entraba y salia por los
		# huecos, la respuesta saltaba de 0 a 1 varias veces por segundo y el sonido de la lluvia
		# aparecia y desaparecia a cada paso. Molestaba justo por eso, porque no era gradual.
		#
		# Ahora son cinco rayos abiertos en abanico y lo que se mide es la FRACCION tapada. Un pasillo
		# con agujeros da un valor intermedio y ESTABLE: se oye la lluvia a medias, que es lo que pasa
		# de verdad, y no cambia porque hayas dado un paso.
		var desde: Vector3 = player.global_position + Vector3(0, 1.6, 0)
		var dirs: Array[Vector3] = [Vector3.UP,
			Vector3(0.45, 1.0, 0.0).normalized(), Vector3(-0.45, 1.0, 0.0).normalized(),
			Vector3(0.0, 1.0, 0.45).normalized(), Vector3(0.0, 1.0, -0.45).normalized()]
		var tapados := 0
		for d in dirs:
			var rr: Dictionary = world.raycast(desde, d, 30.0)
			if rr.get("hit", false):
				tapados += 1
		_techo_frac = float(tapados) / float(dirs.size())
		_medir_afuera()
		_bajo_techo = _techo_frac > 0.5
		# LA LLUVIA SIGUE CAYENDO SIEMPRE. Apagar el emisor bajo techo era peor el remedio: al entrar
		# en un portal desaparecia la lluvia DE TODO EL MAPA, y en un pasillo con huecos parpadeaba.
		# La lluvia se ve siempre; lo que cambia bajo techo es el sonido y que no se te moje la lente.
	# Y SE MUEVE DESPACIO. A 2,5 por segundo el volumen seguia bombeando al pasar por un porche; a
	# 1,1 la transicion dura casi un segundo y se lee como entrar en un sitio, no como un corte.
	_cubierto = move_toward(_cubierto, _techo_frac, dt * 1.1)
	# DE AQUI PARA ABAJO, SOLO SI LLUEVE. El rayo de arriba interesa siempre, pero esto no: sin
	# lluvia, `rain_cover` filtraria un sonido que no suena y `lens_rain` te pondria agua en la lente
	# con el cielo despejado. Al abrir esta funcion para la vista y las salpicaduras, esto habria
	# empezado a mojar la camara sin una sola gota cayendo.
	if not raining:
		# SIN LLUVIA, EL CRISTAL SE SECA. Antes se salia aqui de vuelta y `lens_rain` dejaba de
		# llamarse: las gotas que tuvieras puestas al apagar la lluvia se quedaban en la pantalla
		# para siempre (y con ellas el shader a pantalla completa, cobrandose sus fotogramas).
		if hud and hud.has_method("lens_rain"):
			hud.lens_rain(0.0, dt)
		return
	Audio.rain_cover(_cubierto)
	# LA LENTE SE MOJA AL MIRAR ARRIBA. A cielo abierto y con la vista levantada, las gotas entran de
	# lleno; mirando al frente apenas te llega alguna, y bajo techo ninguna.
	# CON EL ESCUDO BLINDADO (2026-10-28, pedido): la lente de los ojos queda seca y se moja el cristal del escudo: las
	# mismas gotas (lluvia_lente), recortadas a donde esta su cristal en pantalla
	var q: PackedVector2Array = player.escudo_cristal_pantalla() if player.has_method("escudo_cristal_pantalla") else PackedVector2Array()
	var esc_fp: bool = player.has_method("tiene_escudo_fp") and player.tiene_escudo_fp()
	# al sacar o guardar el escudo (o romperse) el agua pasa de un cristal a otro: el nuevo empieza seco y se moja de a poco
	if esc_fp != _lluvia_en_escudo:
		_lluvia_en_escudo = esc_fp
		if hud and "_lluvia_k" in hud:
			hud._lluvia_k = 0.0
	if hud and hud.has_method("lens_rain") and esc_fp and q.size() != 4:
		hud.lens_rain(0.0, dt)          # el escudo apartado (apuntando): la lente sigue seca
	elif hud and hud.has_method("lens_rain") and (q.size() == 4 or not player.third_person):
		var mirando: float = clampf((player.look.y - 0.10) / 0.9, 0.0, 1.0)
		hud.lens_rain(((0.45 + 0.55 * mirando) if q.size() == 4 else (0.12 + 0.88 * mirando)) * (1.0 - _cubierto), dt)
		hud.lente_recorte(q)


## NEVADA. Los copos los pinta el HUD; aqui se lleva cuanta nieve CUAJADA hay en el mapa, que es lo
## que blanquea el suelo y los tejados. Cuaja despacio -un minuto largo- y se derrite mas despacio
## todavia, que es lo que hace que se note el paso del tiempo.
var nevando := false
var nieve_tope := 1.0                ## lo mas que cuaja la nieve en el mundo (la nevada del episodio 6: 0,3)
var _nieve := 0.0
var _ondas := 0.0        ## si estan cayendo gotas AHORA (ver _update_mojado)

func set_nieve(on: bool) -> void:
	nevando = on
	if on:
		if _nieve_fx == null:
			_nieve_fx = _make_nieve()
			add_child(_nieve_fx)
		_nieve_fx.emitting = true
	elif _nieve_fx:
		_nieve_fx.emitting = false
	if _cielo_mat:
		_cielo_mat.set_shader_parameter("clouds_weight", 0.45 if on else (0.75 if raining else 0.05))
		_cielo_mat.set_shader_parameter("clouds_cutoff", 0.15 if on else (0.12 if raining else 0.20))
	if hud:
		hud.flash_message("NIEVE: %s" % ("ON" if on else "OFF"))


func _update_nieve(dt: float) -> void:
	var quiere: float = nieve_tope if nevando else 0.0
	if is_equal_approx(_nieve, quiere):
		return
	_nieve = move_toward(_nieve, quiere, dt * (0.060 if nevando else 0.020))
	if world and world.opaque_material:
		(world.opaque_material as ShaderMaterial).set_shader_parameter("nieve", _nieve)
	if _huellas_vp:
		# sin nieve no hay nada que pisar: se apaga el viewport en vez de repintarlo cada cuadro
		_huellas_vp.render_target_update_mode = (SubViewport.UPDATE_ALWAYS
			if (_nieve > 0.02 and _huellas_on) else SubViewport.UPDATE_DISABLED)


# --- HUELLAS EN LA NIEVE ------------------------------------------------------------------------
# No se puede hundir la malla: el mapa esta hecho de cuadrados grandes (greedy meshing), asi que una
# calle entera puede ser CUATRO vertices y no hay donde empujar. Lo que se hace es lo mismo que en
# los juegos que tienen nieve pisable: se pinta un mapa aparte, visto desde arriba, donde cada pisada
# deja una mancha; el shader del mundo lo lee por la posicion en el mundo y ahi quita la nieve y
# oscurece. La nieve vuelve a taparlas porque cada mancha se va apagando sola.
#
# El mapa sigue al jugador (40 m a su alrededor) porque cubrir la ciudad entera con detalle
# necesitaria una textura absurda. En rojo va la fuerza de la pisada; en verde, la ALTURA a la que
# se dio, para que una pisada en la calle no aparezca calcada en la azotea de al lado.
const HUELLA_PX := 1024
const HUELLA_MAPA := 40.0          ## metros de lado que cubre el mapa
const HUELLA_MAX := 300            ## pisadas vivas a la vez
const HUELLA_VIDA := 26.0          ## segundos hasta que la nieve la tapa del todo
var _huellas_vp: SubViewport = null
var _huellas_raiz: Node2D = null
var _huella_tex: ImageTexture = null
var _huellas: Array[Sprite2D] = []
var _huella_centro := Vector2.ZERO


func _montar_huellas() -> void:
	_huellas_vp = SubViewport.new()
	_huellas_vp.name = "MapaHuellas"
	_huellas_vp.size = Vector2i(HUELLA_PX, HUELLA_PX)
	_huellas_vp.disable_3d = true
	_huellas_vp.transparent_bg = false
	_huellas_vp.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	var fondo := ColorRect.new()
	fondo.color = Color(0, 0, 0, 1)
	fondo.size = Vector2(HUELLA_PX, HUELLA_PX)
	_huellas_vp.add_child(fondo)
	_huellas_raiz = Node2D.new()
	_huellas_vp.add_child(_huellas_raiz)
	add_child(_huellas_vp)
	_huella_tex = _tex_huella()
	if world and world.opaque_material:
		var m := world.opaque_material as ShaderMaterial
		m.set_shader_parameter("huellas", _huellas_vp.get_texture())
		m.set_shader_parameter("huella_mapa", HUELLA_MAPA)
		m.set_shader_parameter("huella_centro", _huella_centro)


## La marca de una bota: un ovalo blando. Blando a proposito, porque el mapa tiene 25 pixeles por
## metro y un borde duro a ese tamano se ve como un cuadrado.
func _tex_huella() -> ImageTexture:
	var n := 32
	var img := Image.create(n, n, false, Image.FORMAT_RGBA8)
	for y in n:
		for x in n:
			var u := (float(x) - n * 0.5 + 0.5) / (n * 0.5)
			var v := (float(y) - n * 0.5 + 0.5) / (n * 0.5)
			# mas larga que ancha: una bota, no un circulo
			var d: float = sqrt(u * u * 1.9 + v * v * 0.75)
			var a: float = clampf(1.0 - d, 0.0, 1.0)
			a = a * a * (3.0 - 2.0 * a)
			img.set_pixel(x, y, Color(1, 1, 1, a))
	return ImageTexture.create_from_image(img)


## Deja una pisada. La llaman el jugador y los bots cada vez que apoyan un pie.
func pisar(pos: Vector3, fuerte := false) -> void:
	if _nieve < 0.05 or not _huellas_on:
		return
	if _huellas_vp == null:
		_montar_huellas()
	var ppm: float = float(HUELLA_PX) / HUELLA_MAPA
	var plano := Vector2(pos.x, pos.z)
	# EL MAPA SIGUE AL JUGADOR. Al recentrarlo hay que arrastrar las pisadas ya pintadas la misma
	# distancia en sentido contrario; si no, saltarian de sitio en el suelo.
	if plano.distance_to(_huella_centro) > HUELLA_MAPA * 0.25:
		var salto: Vector2 = plano - _huella_centro
		_huella_centro = plano
		for h in _huellas:
			if is_instance_valid(h):
				h.position -= salto * ppm
		if world and world.opaque_material:
			(world.opaque_material as ShaderMaterial).set_shader_parameter("huella_centro", _huella_centro)
	var s := Sprite2D.new()
	s.texture = _huella_tex
	s.position = (plano - _huella_centro) * ppm + Vector2(HUELLA_PX, HUELLA_PX) * 0.5
	s.rotation = randf() * TAU
	# 0.34 m de bota; corriendo se pisa mas fuerte y se hunde mas
	s.scale = Vector2.ONE * ((0.42 if fuerte else 0.34) * ppm / 32.0)
	# ROJO: fuerza. VERDE: la altura, para que la pisada no se calque en el tejado de abajo.
	# El verde se lee dividido por el rojo, asi que da igual lo apagada que este la marca.
	s.modulate = Color(1.0, clampf((pos.y + 32.0) / 128.0, 0.0, 1.0), 0.0, 1.0)
	s.set_meta("t", HUELLA_VIDA)
	_huellas_raiz.add_child(s)
	_huellas.append(s)
	while _huellas.size() > HUELLA_MAX:
		var v: Sprite2D = _huellas.pop_front()
		if is_instance_valid(v):
			v.queue_free()


## Apaga el mapa de pisadas y borra las que hubiera. Lo llama el menu grafico.
func _borrar_huellas() -> void:
	for h in _huellas:
		if is_instance_valid(h):
			h.queue_free()
	_huellas.clear()
	if _huellas_vp:
		_huellas_vp.render_target_update_mode = SubViewport.UPDATE_DISABLED


func _update_huellas(dt: float) -> void:
	if _huellas.is_empty():
		return
	var i := 0
	while i < _huellas.size():
		var h: Sprite2D = _huellas[i]
		if not is_instance_valid(h):
			_huellas.remove_at(i)
			continue
		var t: float = float(h.get_meta("t")) - dt
		if t <= 0.0:
			h.queue_free()
			_huellas.remove_at(i)
			continue
		h.set_meta("t", t)
		# se apaga al final, no desde el principio: una huella aguanta y luego la tapa la nevada
		var k: float = clampf(t / (HUELLA_VIDA * 0.4), 0.0, 1.0)
		var c: Color = h.modulate
		c.a = k
		h.modulate = c
		i += 1


## LA NEBLINA DE LA TORMENTA (pedido 2026-09-21: "en la tormenta hay como una neblina de agua, falta eso").
## Con lluvia el aire se llena de agua: lo lejano se apaga en gris y el cielo no se ve limpio. La niebla ya va
## siempre encendida (tapa el corte de la distancia de dibujado), asi que esto no cuesta fps: solo se le
## cambian los valores, poco a poco al empezar y al escampar.
##
## ENCIMA DE LO QUE PONGAN LOS DEMAS. La densidad y el color los ponen tambien la noche y la calidad; aqui se
## guardan como base y, si alguien los cambia mientras llueve (se hace de noche), se vuelven a tomar.
const NIEBLA_LLUVIA_X := 2.5                       ## cuantas veces mas espesa con la lluvia entera
const NIEBLA_LLUVIA_COLOR := Color(0.55, 0.60, 0.66)
const NIEBLA_LLUVIA_CIELO := 0.55                  ## cuanto tapa el cielo (0,10 sin lluvia)
const NIEBLA_BAJA_DENSIDAD := 0.18                 ## la neblina pegada al suelo, con la lluvia entera
var _nl_t := 0.0
var _nl_base_d := -1.0
var _nl_base_c := Color.WHITE
var _nl_base_s := 0.10
var _nl_puesto_d := -1.0

static var _diag_niebla_siempre: bool = "--nieblasiempre" in OS.get_cmdline_user_args()   ## A/B: como antes

static var _con_niebla_lluvia: bool = "--nieblalluvia" in OS.get_cmdline_user_args()

func _niebla_lluvia(dt: float) -> void:
	if env == null or env.environment == null:
		return
	var e: Environment = env.environment
	# si la densidad no es la que puse yo, la ha cambiado otro: esa es la base nueva
	if _nl_puesto_d < 0.0 or not is_equal_approx(e.fog_density, _nl_puesto_d):
		_nl_base_d = e.fog_density
		_nl_base_c = e.fog_light_color
		_nl_base_s = e.fog_sky_affect
	# SIN NIEBLA DE LLUVIA (2026-10-13, pedido: "elimina la niebla que hace la lluvia"). --nieblalluvia = como antes
	var quiere := 1.0 if (raining and _con_niebla_lluvia) else 0.0
	if is_equal_approx(_nl_t, quiere) and _nl_t == 0.0:
		_nl_puesto_d = e.fog_density
		return
	# YA LLOVIENDO DEL TODO (2026-10-05, banco de la lluvia): la niebla, su color, el cielo y el viento de las hojas ya
	# estan puestos; antes se volvian a escribir en CADA fotograma (el entorno y el material del mundo). Solo cambia la
	# altura de la neblina si subes o bajas.
	if _nl_t == quiere and quiere == 1.0 and is_equal_approx(e.fog_density, _nl_puesto_d) and not _diag_niebla_siempre:
		if is_instance_valid(player) and absf(e.fog_height - (player.global_position.y + 1.2)) > 0.25:
			e.fog_height = player.global_position.y + 1.2
		return
	# entra en unos 7 s y se va en unos 12
	_nl_t = move_toward(_nl_t, quiere, dt * (0.15 if raining else 0.08))
	if e.fog_mode == Environment.FOG_MODE_DEPTH:
		# niebla por profundidad: la densidad ya es el maximo (1), asi que la lluvia la ESPESA acercando el inicio
		e.fog_depth_begin = _niebla_inicio * lerpf(1.0, 1.0 / NIEBLA_LLUVIA_X, _nl_t)
	else:
		e.fog_density = _nl_base_d * lerpf(1.0, NIEBLA_LLUVIA_X, _nl_t)
	# de dia hacia el gris del agua; de noche se queda en su tono (un gris claro brillaria en la oscuridad)
	var gris: Color = NIEBLA_LLUVIA_COLOR * clampf(_nl_base_c.get_luminance() / 0.55, 0.15, 1.0)
	gris.a = 1.0
	e.fog_light_color = _nl_base_c.lerp(gris, _nl_t * 0.8)
	e.fog_sky_affect = lerpf(_nl_base_s, NIEBLA_LLUVIA_CIELO, _nl_t)
	# Y LA NEBLINA BAJA: mas espesa pegada al suelo que en alto (niebla por altura de Godot, que funciona en el
	# renderizador movil y no cuesta nada). El suelo es el de los pies del jugador.
	if is_instance_valid(player):
		e.fog_height = player.global_position.y + 1.2
	e.fog_height_density = NIEBLA_BAJA_DENSIDAD * _nl_t
	_nl_puesto_d = e.fog_density
	# (el viento en las hojas ya no existe: el follaje no se mece desde el 2026-10-05, pedido)


static var _diag_sin_mojado: bool = "--sinmojado" in OS.get_cmdline_user_args()   ## banco de la lluvia

func _update_mojado(dt: float) -> void:
	# DOS COSAS DISTINTAS. `mojado` es lo empapado que esta el suelo, y eso tarda en irse: sigue
	# mojado un buen rato despues de escampar. `ondas` es si estan CAYENDO gotas ahora mismo, y eso
	# se corta casi de golpe. Con un solo valor, o el suelo se secaba al instante o seguian saliendo
	# ondas con el cielo despejado.
	var quiere: float = _mojado_tope if raining and not _diag_sin_mojado else 0.0
	var quiere_ondas: float = quiere if _lluvia_suelo else 0.0
	var mueve := false
	if not is_equal_approx(_ondas, quiere_ondas):
		_ondas = move_toward(_ondas, quiere_ondas, dt * (0.9 if raining else 1.6))
		mueve = true
	if not is_equal_approx(_mojado, quiere):
		_mojado = move_toward(_mojado, quiere, dt * (0.20 if raining else 0.10))
		mueve = true
	if mueve and world and world.opaque_material:
		var m := world.opaque_material as ShaderMaterial
		m.set_shader_parameter("mojado", _mojado)
		m.set_shader_parameter("ondas", _ondas)


## --diagfps: VIGILANTE DE TIRONES EN VIVO.
##
## Lo pidio el usuario: "a veces se me bajan los fps cuando un enemigo se bugea, abreme el juego y miralo
## en vivo". Se juega normal; cada segundo se mira el peor cuadro, y si hubo tiron se apunta QUIEN
## estaba trabajando: los A* que pidio cada enemigo, cuantos salieron vacios (destino inalcanzable) y
## cuantos boquetes abrio. Un bicho atascado se delata solo: muchos A* vacios seguidos.
var _dg_on: bool = "--diagfps" in OS.get_cmdline_user_args()
var _explosiones_vistas := 0
var _dg_t := 0.0
var _dg_peor := 0.0
var _dg_frames := 0
var _dg_latido := 0.0

func _diag_fps_paso(delta: float) -> void:
	_dg_t += delta
	_dg_latido += delta
	_dg_frames += 1
	_dg_peor = maxf(_dg_peor, delta)
	if _dg_t < 1.0:
		return
	var fps: float = float(_dg_frames) / _dg_t
	var peor_ms: float = _dg_peor * 1000.0
	# todos los que piensan: bots y criaturas comparten nodo
	var filas: Array = []
	var tot_paths := 0
	var tot_vacios := 0
	var tot_us := 0
	var tot_romper := 0
	var vivos := 0
	if enemies != null:
		for e in enemies.get_children():
			if not is_instance_valid(e) or not ("dg_paths" in e):
				continue
			vivos += 1
			var np := int(e.dg_paths)
			var nv := int(e.dg_vacios)
			var us := int(e.dg_us)
			var nr := int(e.get("dg_romper")) if "dg_romper" in e else 0
			tot_paths += np
			tot_vacios += nv
			tot_us += us
			tot_romper += nr
			if np > 0 or nr > 0 or (int(e.get("dg_rocas")) if "dg_rocas" in e else 0) > 0:
				var tipo := String(e.get("tipo")) if "tipo" in e else ("bot " + String(e.get("bot_name")))
				var extra := ""
				if "dg_revisiones" in e:
					extra = " · objetivo a %.1f m y %+.1f m de altura, avanzo %.1f m · revisiones %d, intentos %d (derribos %d), rocas arriba %d, en enfriamiento %d · suelo=%s" % [
						float(e.dg_dist), float(e.dg_altura), float(e.dg_avance), int(e.dg_revisiones), int(e.dg_intentos),
						int(e.dg_derribos), int(e.dg_rocas), int(e.dg_bloqueado_cd), str(bool(e.get("on_floor")))]
					e.dg_derribos = 0
					e.dg_rocas = 0
					e.dg_revisiones = 0
					e.dg_intentos = 0
					e.dg_bloqueado_cd = 0
				filas.append([us, "%s #%d en %.0f,%.0f,%.0f: %d A* (%d vacios) %.1f ms · %d boquetes%s" % [
					tipo, int(e.get("red_id")), e.global_position.x, e.global_position.y, e.global_position.z,
					np, nv, us / 1000.0, nr, extra]])
			e.dg_paths = 0
			e.dg_vacios = 0
			e.dg_us = 0
			if "dg_romper" in e:
				e.dg_romper = 0
	var tiron: bool = peor_ms > 50.0 or fps < 30.0
	if tiron:
		filas.sort_custom(func(x, y): return int(x[0]) > int(y[0]))
		var st: Dictionary = world.get_stats() if world else {}
		print("[diagfps] PICO · %.0f fps · peor cuadro %.0f ms · %d enemigos · A* %d (%d vacios, %.1f ms) · boquetes %d · cuerpos %d · escombros %d" % [
			fps, peor_ms, vivos, tot_paths, tot_vacios, tot_us / 1000.0, tot_romper,
			int(st.get("bodies_active", 0)), int(st.get("debris_active", 0))])
		for i in mini(4, filas.size()):
			print("[diagfps]    %s" % String(filas[i][1]))
	elif _dg_latido >= 10.0:
		_dg_latido = 0.0
		print("[diagfps] ok · %.0f fps · peor cuadro %.0f ms · %d enemigos · A* %d/s (%d vacios)" % [
			fps, peor_ms, vivos, tot_paths, tot_vacios])
	_dg_t = 0.0
	_dg_frames = 0
	_dg_peor = 0.0


## EL TOPE DE ESCOMBROS (2026-10-05, pedido: "si hay muchisimos escombros, que se eliminen solos"): cada segundo, quien
## manda la partida (solo o anfitrion) deja como mucho `_tope_escombros` cascotes chicos (VoxelWorld.recortar_escombros:
## primero los que no ves y los mas lejanos, como mucho 40 de una vez). Al invitado le llegan por la reconciliacion de
## bloques (net.gd quita los que el anfitrion ya no tiene). -1 = sin limite. --sintopeescombros = sin limite.
const TOPES_ESCOMBROS := [150, 300, 600, -1]
var _tope_escombros := -1
var _tope_esc_t := 0.0
var _tope_esc_quitados := 0
static var _sin_tope_escombros: bool = "--sintopeescombros" in OS.get_cmdline_user_args()
## Los tramos de la limpieza: [mas de m3, hasta m3, s congelado sin verse, s aunque se vea, como mucho por segundo,
## despertar lo de encima]. Chicos (hasta 0,2 m3: 25 voxels de 20 cm, un cascote de ~60 cm), medianos (hasta 1,5 m3) a
## los 90 s, grandes (hasta 8 m3) a los 120 s y GIGANTES (un trozo de casa) a los 150 s (2026-10-05, pedido: "que
## tambien los gigantes se limpien"); mirandolos, al doble.
const LIMPIEZA_TRAMOS := [
	[0.0, 0.2, 20.0, 60.0, 30, false],
	[0.2, 1.5, 90.0, 180.0, 10, true],
	[1.5, 8.0, 120.0, 240.0, 4, true],
	[8.0, 1.0e9, 150.0, 300.0, 2, true],
]
static var _sin_limpieza: bool = "--sinlimpieza" in OS.get_cmdline_user_args()

## --tirones: cada 5 s, los bloques del mundo y el analizador de estructuras (para ver el lag de la destruccion en vivo)
var _esc_diag_n := 0
func _tope_esc_diag_tick() -> void:
	if not "--tirones" in OS.get_cmdline_user_args():
		return
	_esc_diag_n += 1
	if _esc_diag_n % 5 != 0:
		return
	var st: Dictionary = world.get_stats()
	print("[escombros] bloques %s (chicos %s, congelados %s, despiertos %s, rigidos %s) · quitados: tope %s, tiempo %s · tope %d · estructura %s (it %s, fallos %s, fragmentos %s, %.1f ms/it, cola %s) · actualizar %.1f ms · particulas %s" % [
		str(st.get("bodies_active", "?")), str(st.get("escombros_chicos", "?")), str(st.get("bodies_congelados", "?")),
		str(st.get("bodies_awake", "?")), str(st.get("bodies_rigid", "?")), str(st.get("escombros_quitados", "?")),
		str(st.get("escombros_limpiados", "?")) + " · asentados por tope " + str(st.get("asentados_por_tope", "?")), _tope_escombros,
		"ACTIVA" if int(st.get("struct_active", 0)) > 0 else "dormida", str(st.get("struct_iterations", "?")),
		str(st.get("struct_failures", "?")), str(st.get("struct_fragments", "?")), float(st.get("t_struct_ms", 0.0)),
		str(st.get("struct_queue", st.get("jobs_pending", "?"))), float(st.get("t_update_ms", 0.0)), str(st.get("debris_active", "?"))])


func _tope_escombros_tick(delta: float) -> void:
	_tope_esc_t -= delta
	if _tope_esc_t > 0.0:
		return
	_tope_esc_t = 1.0
	if world == null or not world.has_method("recortar_escombros"):
		return
	_tope_esc_diag_tick()
	if Net.is_online() and not Net.hosting:
		return
	var cam := get_viewport().get_camera_3d()
	if cam == null:
		return
	var q: PackedInt64Array = PackedInt64Array() if _tope_escombros < 0 or _sin_tope_escombros else world.recortar_escombros(_tope_escombros, cam.global_position, -cam.global_basis.z, 40)
	_tope_esc_quitados += q.size()
	# LA LIMPIEZA CON EL TIEMPO (2026-10-05, pedido): los escombros chicos (<= LIMPIEZA_M3) se quitan solos cuando llevan
	# LIMPIEZA_FUERA_S congelados y no se ven, o LIMPIEZA_VISTA_S aunque se vean. Los trozos grandes se quedan.
	if not _sin_limpieza and world.has_method("limpiar_escombros"):
		for tramo in LIMPIEZA_TRAMOS:
			var l: PackedInt64Array = world.limpiar_escombros(float(tramo[0]), float(tramo[1]), float(tramo[2]), float(tramo[3]),
				cam.global_position, -cam.global_basis.z, int(tramo[4]), bool(tramo[5]))
			_tope_esc_quitados += l.size()


## LAS SOMBRAS AL VOLVER AL PRIMER PLANO (2026-10-05, bug del movil: "al empezar a grabar la pantalla las sombras salen
## en lineas que parpadean por todo el mapa, y hasta que reinicio el juego no se arreglan"). Al empezar a grabar, Android
## pausa o reconfigura la superficie de dibujo, y en algunos drivers el mapa de sombras del sol se queda corrupto. Al
## volver (o si cambia el tamaño de la pantalla) se rehace: se apaga la sombra un cuadro y se vuelve a pedir el mapa de
## sombras con otro tamaño y el suyo. Sin probar en un movil que lo haga. `--rehacersombrastest` lo fuerza a los 8 s.
var _sombras_rehacer_t := -1.0

func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_RESUMED or what == NOTIFICATION_APPLICATION_FOCUS_IN:
		_sombras_rehacer_t = 0.3


func _rehacer_sombras() -> void:
	if sun == null or not is_instance_valid(sun) or not sun.shadow_enabled:
		return
	var sh: int = Settings.gfx_value("shadows", quality)
	if sh <= 0:
		return
	var lado: int = [1024, 1024, 2048, 2048, 4096][sh]
	sun.shadow_enabled = false
	RenderingServer.directional_shadow_atlas_set_size(lado / 2, true)
	await get_tree().process_frame
	await get_tree().process_frame
	if not is_instance_valid(sun):
		return
	RenderingServer.directional_shadow_atlas_set_size(lado, true)
	sun.shadow_enabled = true
	print("[sombras] mapa de sombras rehecho (%d)" % lado)


func _sombras_rehacer_tick(delta: float) -> void:
	if _sombras_rehacer_t < 0.0:
		return
	_sombras_rehacer_t -= delta
	if _sombras_rehacer_t < 0.0:
		_rehacer_sombras()


## EL FIN DE LA PARTIDA EN EL INVITADO (ver Net, "EL FIN DE LA PARTIDA"): el aviso del anfitrion, y el VIGIA por si no
## llega. `--sinvigiafin` lo quita; `--vigiafintest` (invitado) se salta el aviso para probar que el vigia lo saca solo.
var _fin_resuelto := false
var _fin_vigia_t := 0.0          ## segundos con el marcador en el objetivo y sin final
var _fin_vigia_pide := 0.0
static var _sin_vigia_fin: bool = "--sinvigiafin" in OS.get_cmdline_user_args()
static var _vigia_fin_test: bool = "--vigiafintest" in OS.get_cmdline_user_args()

func _fin_red(ganador: String, motivo: String) -> void:
	if _fin_resuelto or _vigia_fin_test:
		return
	print("[fin] aviso del anfitrion: gana %s (%s)" % [ganador, motivo])
	_fin_por(ganador, motivo)


func _fin_por(ganador: String, motivo: String) -> void:
	if _fin_resuelto:
		return
	if motivo == "bomba" or (bomb_mode and not dm_mode):
		_bomba_fin(ganador)
	elif dm_mode:
		_dm_fin(ganador)
	elif motivo == "atraco" and ciudad3:
		_ciudad_fin(ganador)


## Quien va ganando segun el marcador, si alguien ya llego al objetivo ("" si no)
func _ganador_por_marcador() -> String:
	if dm_mode:
		if Net.es_dm_todos():
			for nombre in dm_stats.keys():
				if int(dm_stats[nombre].get("bajas", 0)) >= dm_objetivo_todos:
					return String(dm_stats[nombre].get("equipo", ""))
			return ""
		if int(dm_bajas.get("t", 0)) >= dm_objetivo:
			return Net.TEAM_T
		if int(dm_bajas.get("ct", 0)) >= dm_objetivo:
			return Net.TEAM_CT
		return ""
	if bomb_mode:
		if Net.score_t >= RONDAS_PARA_GANAR:
			return Net.TEAM_T
		if Net.score_ct >= RONDAS_PARA_GANAR:
			return Net.TEAM_CT
	if ciudad3:
		for eq in puntos_equipo:
			if int(puntos_equipo[eq]) >= PUNTOS_GANAR:
				return String(eq)
	return ""


func _fin_vigia_tick(delta: float) -> void:
	if _fin_resuelto or _sin_vigia_fin or not Net.is_online() or Net.hosting or Net.soy_espectador:
		return
	if not (dm_mode or bomb_mode or ciudad3):
		return
	var g := _ganador_por_marcador()
	if g == "":
		_fin_vigia_t = 0.0
		return
	_fin_vigia_t += delta
	# a los 3 s sin final se pregunta al anfitrion, y cada 2 s
	if _fin_vigia_t > 3.0:
		_fin_vigia_pide -= delta
		if _fin_vigia_pide <= 0.0:
			_fin_vigia_pide = 2.0
			Net.pedir_fin_partida()
	# a los 8 s, el final por el marcador
	if _fin_vigia_t > 8.0:
		print("[fin] VIGIA: el marcador dice que gana %s y no llego el final del anfitrion: se saca aqui" % g)
		_fin_por(g, "atraco" if ciudad3 else ("bomba" if bomb_mode and not dm_mode else "dm"))


func _process(delta: float) -> void:
	# SIN NIEBLA DENTRO DE CASA (2026-10-21, pedido: "sacame la niebla dentro de la habitacion"): la niebla del dia, la de la
	# lluvia y la de la zona la vuelven a poner; aqui se apaga en cuanto aparezca
	if current_map in MAPAS_SIN_NIEBLA and env and env.environment:
		var _en: Environment = env.environment
		if _en.fog_enabled or _en.volumetric_fog_enabled:
			_en.fog_enabled = false
			_en.volumetric_fog_enabled = false
	_linterna_tick(delta)
	_lamp_oclusion_tick(delta)
	_cielo_horno_tick(delta)
	_fin_vigia_tick(delta)
	_elim_tick(delta)
	_vigias_tick(delta)
	_sombras_rehacer_tick(delta)
	_tope_escombros_tick(delta)
	_diag_tirones(delta)
	_dia_noche_pve(delta)
	_auto_fps(delta)
	_bots_a_por_armas(delta)         # con botin, los bots empiezan sin arma y van a por una
	_diag_vivo_tick(delta)           # --diagvivo: avisar de lo que se atraviesa
	_diag_estructura(delta)          # --diagvivo: lo que se desprende y lo que se viene abajo
	_diag_flotando(delta)            # --diagvivo: materia del mundo con aire debajo
	var _tpre := Time.get_ticks_usec()
	if _dg_on:
		_diag_fps_paso(delta)
	_enfoque_barato()
	_tick_lamps()
	_lamp_tarea_tick()
	_update_mojado(delta)
	_niebla_lluvia(delta)
	_update_nieve(delta)
	_update_huellas(delta)
	_update_techo(delta)
	_update_viento(delta)
	# la caja de lluvia viaja con el jugador: llueve a su alrededor sin sembrar todo el mapa
	if _nieve_fx and _nieve_fx.emitting and player:
		_nieve_fx.global_position = player.global_position + Vector3(0, 11, 0)
	if _rain_fx and _rain_fx.emitting and player:
		_rain_fx.global_position = player.global_position + Vector3(0, 14, 0)
	Prof.add("main.pre1", Time.get_ticks_usec() - _tpre); _tpre = Time.get_ticks_usec()
	if loading:
		hud.set_progress(world.get_loading_progress())
		return
	# EL POLVO VA AQUI ABAJO, pasada la guarda de carga, y no por orden: por seguridad. Estaba
	# arriba y un error suyo reventaba `_process` ANTES de `set_progress`, asi que la barra se
	# quedaba clavada en el 100% para siempre. Un adorno no puede tener el poder de impedir que
	# arranque la partida; aqui, si algun dia vuelve a fallar, como mucho no hay motas.
	_update_polvo(delta)
	_update_vista(delta)
	_techo_avanzar()
	_techo_cola_tick()
	Prof.add("main.pre2", Time.get_ticks_usec() - _tpre)
	var _t0 := Time.get_ticks_usec()
	var _tmain := _t0
	Prof.frames += 1
	# en el avion y cayendo, el mundo se dibuja alrededor del suelo que tienes DEBAJO (ver salto_br.gd)
	world.set_player_position(salto_br.punto_de_vista() if salto_br != null and is_instance_valid(salto_br) and salto_br.en_el_aire() else player.global_position)
	# LOS DERRUMBES POR CARGA LOS DECIDE EL ANFITRION y se mandan tal cual (ver Engine::setStructAuthority).
	# Se vacian siempre, tambien en solitario, para que la cola no crezca.
	if world.has_method("tomar_fallos_estructurales"):
		var fallos: Array = world.tomar_fallos_estructurales()
		if Net.is_online() and Net.hosting:
			for f in fallos:
				Net.net_fallo_estructural(f)
	# ...y lo mismo los apoyos que revientan bajo el peso de un bloque
	if world.has_method("tomar_apoyos_rotos"):
		var rotos: PackedInt32Array = world.tomar_apoyos_rotos()
		if not rotos.is_empty() and Net.is_online() and Net.hosting:
			Net.net_apoyos_rotos(rotos)
	var _tnet := Time.get_ticks_usec()
	Net.tick_censo_bloques(world, delta)
	Net.tick_posturas_bloques(world, delta)    # los bloques que caen, iguales en todas las pantallas
	_diag_posturas(delta)
	Net.tick_huellas_mapa(world, delta)
	# EL SERVIDOR: reloj comun e historial de posiciones para el rebobinado (ver net.gd).
	Net.tick_servidor(delta)
	Prof.add("main.net", Time.get_ticks_usec() - _tnet); _tnet = Time.get_ticks_usec()
	_mandar_bots(delta)
	_reloj_ronda_tick()
	_ultimo_en_pie_tick()
	_dm_casi_tick()
	_mandar_mis_bots(delta)   # si soy invitado y me han tocado bots, los muevo yo
	Prof.add("main.bots", Time.get_ticks_usec() - _tnet)
	if _diag_frames > 150:
		_win_frames += 1
		_win_ms += delta * 1000.0
		if delta > 0.020:
			_slow_frames += 1
			_win_slow += 1
			_worst_ms = maxf(_worst_ms, delta * 1000.0)
	# anclas de física: proyectiles con cuerpo físico (granadas). El jugador va aparte y los bots se mueven
	# sobre la rejilla de voxels (enemy.gd), así que no necesitan colisión del mundo en Jolt.
	var anchors := PackedVector3Array()
	for g in get_tree().get_nodes_in_group("phys_anchor"):
		if g is Node3D:
			anchors.append(g.global_position)
	world.set_physics_anchors(anchors, 10.0)
	# DONDE ESTA CADA PERSONAJE. Todo trozo que caiga cerca de uno lleva colision si o si. Antes esto
	# solo miraba al jugador local, asi que un bot subido a una estructura que se derrumbaba se colaba
	# por el escombro (para el no existia) y en LAN tu amigo atravesaba lo que tu veias solido.
	if world.has_method("set_personajes"):
		var gente := PackedVector3Array([player.global_position])
		for e in enemies.get_children():
			if e is Node3D:
				gente.append(e.global_position)
		for r in Net.remotes.values():
			if is_instance_valid(r):
				gente.append(r.global_position)
		world.set_personajes(gente)
	# el diccionario de estadísticas cuesta ~0,4 ms: sólo cada 4 frames (HUD/CSV lo consumen a 4-60 Hz)
	# (2026-10-04, auditoria) y SOLO si alguien lo lee: el panel F3 (`hud.last_stats`) o el CSV. En la isla eran 0,86 ms
	# por fotograma de media (recorre las mallas de 130.000 huecos de chunk para la memoria) para nadie.
	var _tst := Time.get_ticks_usec()
	var _stats_se_leen: bool = bench_mode or _stats_siempre or hud.csv != null or (hud.profiler_panel != null and hud.profiler_panel.visible)
	if _stats_se_leen and ((_diag_frames % 4) == 0 or bench_mode):
		hud.update_stats(world.get_stats(), quality)
	Prof.add("main.stats", Time.get_ticks_usec() - _tst)
	if bench_mode:
		_probe_report("main.get_stats", Time.get_ticks_usec() - _t0)
		_t0 = Time.get_ticks_usec()
	# efectos generados por el núcleo este frame: polvo de destrucción, caída de escombros
	# Tope de eventos por frame: con muchas explosiones el motor entrega cientos y este bucle se
	# comía 5 ms (medido con --stress). Los efectos ya tienen su propio presupuesto, así que pasado
	# el tope solo se pierde polvo repetido; las explosiones ("blast") nunca se descartan porque son
	# las que se ven. El color de material se cachea: get_material_color por evento era gratis en
	# apariencia pero se llamaba cientos de veces.
	# medir SOLO el bucle de efectos: antes esta métrica arrancaba al principio de _process y se
	# llevaba el crédito de set_player_position y get_stats, lo que despistaba al optimizar
	_t0 = Time.get_ticks_usec()
	var _tev := Time.get_ticks_usec()
	var events: Array = world.get_effect_events()
	Prof.add("main.evfetch", Time.get_ticks_usec() - _tev)
	var ev_left := 40
	var lamp_left := 4      # comprobaciones de farola por frame (recorren las 205: caras)
	var snd_left := 8       # sonidos de impacto por frame (cada uno resuelve variantes)
	for ev in events:
		if ev_left <= 0 and ev.type != "blast":
			continue
		ev_left -= 1
		var mid: int = int(ev.material)
		var c: Color = Color(0.55, 0.5, 0.45)
		if mid > 0:
			if _matcol.has(mid):
				c = _matcol[mid]
			else:
				c = world.get_material_color(mid)
				_matcol[mid] = c
		var size: float = ev.size
		# sonido (biblioteca de Teardown): impacto por material, explosión, escombro/pieza que aterriza
		var _te := Time.get_ticks_usec()
		match ev.type:
			"carve":
				if snd_left > 0:
					snd_left -= 1
					Audio.hit(ev.material, ev.position, int((ev.size - 0.4) * 100.0))
				if lamp_left > 0:
					lamp_left -= 1
					_kill_lamps_near(ev.position, ev.size)
			"blast":
				var _tba := Time.get_ticks_usec()
				Audio.explosion(ev.position, ev.size)
				Prof.add("fx.b.audio", Time.get_ticks_usec() - _tba); _tba = Time.get_ticks_usec()
				_kill_lamps_near(ev.position, ev.size)   # una explosión sí revisa siempre
				Prof.add("fx.b.farolas", Time.get_ticks_usec() - _tba)
			"land":
				var _ta := Time.get_ticks_usec()
				Audio.debris_land(ev.position, int(ev.material))
				Prof.add("fx.land.audio", Time.get_ticks_usec() - _ta)
			"dust":
				Audio.piece_land(ev.material, ev.position, int(ev.size * 400.0))
		if ev.type == "blast":
			_explosiones_vistas += 1               # lo cuenta --desatasco: un golpe con las manos no puede dar ninguna
			effects.explosion(ev.position, ev.size)   # receta de Teardown: chispas, fuego, humo, luz, nube
			Prof.add("fx.blast", Time.get_ticks_usec() - _te)
			continue
