		libres = Net.equipos.duplicate()
	_pick_team(String(libres[randi() % libres.size()]))


## UNA BASE POR EQUIPO, EN CIRCULO ALREDEDOR DE LA CAJA: a 120 grados una de otra y a parecida
## distancia, a ras de calle (nunca en un tejado ni sobre un hueco) y con sitio libre alrededor.
##
## Si en el angulo ideal no hay calle se abre el abanico (hasta 60 grados a cada lado y de 25 a 80 m), y
## si ni asi, se recorre el mapa entero y se coge la calle valida MAS CERCANA al punto ideal. Nunca se
## devuelve un punto sin suelo: la primera version tenia como ultimo recurso `find_ground`, que sin suelo
## devuelve -1 m, y la base azul quedo sobre el vacio con sus seis bots cayendo por el.
func _bases_alrededor(v: Vector3) -> Dictionary:
	var eqs: Array = Net.equipos
	# LOS PUNTOS DEL PROPIO MAPA PRIMERO. Buscar una "calle" a rayos funciona en la ciudad procedural,
	# que es plana y sin agua, pero en un mapa con relieve se equivoca: en Monaco colocaba a los tres
	# equipos flotando SOBRE EL MAR, porque para el motor el agua es materia solida y el rayo la ve
	# como suelo (y el .vxmap no guarda el nombre del material, asi que tampoco se puede preguntar de
	# que esta hecha). El generador del mapa ya escribe puntos de aparicion COMPROBADOS con el A* del
	# motor: si el mapa trae suficientes, se reparten esos alrededor de la caja y no se adivina nada.
	var puntos: PackedVector3Array = world.get_spawn_points() if world.has_method("get_spawn_points") else PackedVector3Array()
	if puntos.size() >= eqs.size() + 1:
		var libres: Array = []
		for i in range(1, puntos.size()):      # el 0 es el del jugador
			if not _bajo_agua(puntos[i]):      # con agua.json, ninguno en el fondo del mar
				libres.append(puntos[i])
		var out2 := {}
		for i in eqs.size():
			# el que mejor caiga en su sector alrededor de la caja, y lejos de las bases ya puestas
			var a0: float = TAU * float(i) / float(eqs.size())
			var mejor: Vector3 = Vector3.ZERO
			var mejor_p := -INF
			for p in libres:
				var d: Vector2 = Vector2(p.x - v.x, p.z - v.z)
				if d.length() < 18.0:
					continue                   # pegado a la caja: no es una base, es el objetivo
				var ang: float = absf(wrapf(d.angle() - a0, -PI, PI))
				var sep: float = INF
				for q in out2.values():
					sep = minf(sep, Vector2(p.x - q.x, p.z - q.z).length())
				var punt: float = -ang * 40.0 + minf(sep, 60.0) + minf(d.length(), 70.0) * 0.4
				if punt > mejor_p:
					mejor_p = punt
					mejor = p
			if mejor != Vector3.ZERO:
				out2[String(eqs[i])] = _ground_near(mejor)
		if out2.size() == eqs.size():
			return out2
	var out := {}
	for i in eqs.size():
		var a0: float = TAU * float(i) / float(eqs.size())
		var elegido := Vector3.ZERO
		for radio in [45.0, 38.0, 55.0, 30.0, 65.0, 25.0, 80.0]:
			for giro in [0.0, 0.2, -0.2, 0.4, -0.4, 0.6, -0.6, 0.8, -0.8, 1.05, -1.05]:
				var a: float = a0 + giro
				var c := _calle_libre(Vector3(v.x + cos(a) * radio, 0.0, v.z + sin(a) * radio))
				if c != Vector3.ZERO:
					elegido = c
					break
			if elegido != Vector3.ZERO:
				break
		if elegido == Vector3.ZERO:
			elegido = _calle_mas_cercana(Vector3(v.x + cos(a0) * 45.0, 0.0, v.z + sin(a0) * 45.0))
		out[String(eqs[i])] = elegido
	return out


## Punto de calle con suelo de verdad en (x, z), o ZERO si no vale: fuera del mapa, tejado, hueco o sin
## sitio alrededor.
func _calle_libre(q: Vector3) -> Vector3:
	var size: Vector3 = world.get_world_size()
	if q.x < 4.0 or q.z < 4.0 or q.x > size.x - 4.0 or q.z > size.z - 4.0:
		return Vector3.ZERO
	var r: Dictionary = world.raycast(Vector3(q.x, size.y - 1.0, q.z), Vector3.DOWN, size.y)
	if not r.hit:
		return Vector3.ZERO
	# y por debajo de 0 tampoco: para el motor de voxels bajo el mundo hay suelo, y un hueco del mapa
	# devuelve un "impacto" a -1 m
	if r.position.y < 0.0:
		return Vector3.ZERO
	# NI EL FONDO DEL MAR: con agua.json el mapa sabe donde hay agua, y el rayo, que no la ve, se para en
	# la arena del fondo. Es exactamente lo que dejaba a los equipos de Monaco "sobre el mar".
	if _bajo_agua(r.position):
		return Vector3.ZERO
	# "ES CALLE" = NO ES UN TEJADO. Aqui habia un tope absoluto de 1,2 m, que vale en la ciudad
	# procedural -donde el asfalto esta a ras de cero- y es falso en cualquier mapa con relieve: en
	# Monaco el pueblo se levanta sobre la Roca entre 2,4 y 6,4 m, asi que ese tope rechazaba el mapa
	# ENTERO y los tres equipos acababan apareciendo los tres en el mismo punto.
	# El criterio bueno no es la altura sino si hay plantas DEBAJO: una sola superficie es suelo; dos o
	# mas es un tejado con edificio bajo los pies. Funciona en cualquier mapa y sin numeros a ojo.
	if _floors_at(q.x, q.z, float(r.position.y)).size() > 1:
		return Vector3.ZERO
	if not _room_free(r.position):
		return Vector3.ZERO
	return r.position + Vector3(0, 0.05, 0)


## La calle valida mas cercana a `ideal`, recorriendo el mapa en rejilla. Ultimo recurso.
func _calle_mas_cercana(ideal: Vector3) -> Vector3:
	var size: Vector3 = world.get_world_size()
	var mejor: Vector3 = world.get_spawn_position()
	var mejor_d := INF
	var paso := 6.0
	var x := paso
	while x < size.x - paso:
		var z := paso
		while z < size.z - paso:
			var d: float = Vector2(x - ideal.x, z - ideal.z).length()
			if d < mejor_d:
				var c := _calle_libre(Vector3(x, 0.0, z))
				if c != Vector3.ZERO:
					mejor = c
					mejor_d = d
			z += paso
		x += paso
	return mejor


func _base_de(equipo: String) -> Vector3:
	if bases_equipo.has(equipo):
		return bases_equipo[equipo]
	if dm_mode and Net.es_dm_todos():
		return _salida_todos(equipo)      # todos contra todos: no hay bases, el sitio mas alejado de todos
	var b: Vector3 = ct_spawn if equipo == Net.TEAM_CT else t_spawn
	return b if b != Vector3.ZERO else world.get_spawn_position()


