## Reparte los bots: la primera mitad a tu bando, la otra al contrario. A los tuyos se les da un
## tinte azulado y a los rivales el rojizo de siempre, para distinguirlos de un vistazo.
## EL REPARTO DE TAREAS. Un equipo no es diez tíos haciendo lo mismo: es gente con un puesto.
##
## POLICIA (defiende): el primero se queda en el sitio A, el segundo en el B -esos NO se mueven de
## ahí salvo que les llamen a su propio sitio, porque si abandonan el punto los terroristas plantan
## tranquilos-. Los tres siguientes campean caminos. El resto es GRUPO DE REACCION: su trabajo es
## precisamente acudir, y son los que salen cuando empiezan a caer compañeros.
##
## TERRORISTAS (atacan): de dos en dos. El primero de cada pareja manda y el segundo le cubre la
## espalda. Ir en pareja es lo que convierte un asalto en un asalto y no en diez suicidios seguidos.
var _rol_ct := 0
var _rol_t := 0
var _ultimo_lider = null

func _dar_rol(e, t: String) -> void:
	if not ("rol" in e):
		return
	if t == Net.TEAM_CT:
		match _rol_ct:
			0: e.rol = "sitio_a"
			1: e.rol = "sitio_b"
			2, 3, 4: e.rol = "camino"
			_: e.rol = "reaccion"
		_rol_ct += 1
	else:
		# pares: 0 líder, 1 compañero, 2 líder, 3 compañero...
		if _rol_t % 2 == 0:
			e.rol = "lider"
			_ultimo_lider = e
		else:
			e.rol = "compa"
			if "compa" in e:
				e.compa = _ultimo_lider
		_rol_t += 1


## SITIO LIBRE PARA UN BOT QUE ACABA DE APARECER.
## El reparto viejo los ponia en espiral -`2.5 + 1.2 * i` metros- en circulo completo alrededor de la
## base: el decimo salia a trece metros, en cualquier direccion, sin mirar el suelo ni si habia pared.
## De ahi la gente dentro de los edificios.
##
## Ahora el equipo sale AGRUPADO y MIRANDO A DONDE VA: un abanico estrecho (+-50 grados) hacia el
## enemigo, en dos filas, pegado a la base. Cada candidato se baja al suelo y se comprueba que quepa
## un cuerpo; si no cabe, se prueba el siguiente angulo, y si ninguno vale se deja en la base.
func _sitio_bot(base: Vector3, hacia: Vector3, i: int, total: int) -> Vector3:
	var dir: Vector3 = hacia - base
	dir.y = 0.0
	if dir.length() < 0.1:
		dir = Vector3.FORWARD
	dir = dir.normalized()
	var fila: int = i / 5                       # de cinco en cinco: primera fila, segunda fila...
	var col: int = i % 5
	var r: float = 1.8 + 1.7 * float(fila)
	var base_a: float = atan2(dir.z, dir.x)
	for intento in 6:
		# el abanico se abre un poco en cada intento por si el hueco de al lado esta ocupado
		var a: float = base_a + deg_to_rad(-50.0 + 25.0 * float(col)) * (1.0 + 0.15 * float(intento))
		var rr: float = r + 0.6 * float(intento)
		var q: Vector3 = _ground_near(base + Vector3(cos(a), 0.0, sin(a)) * rr)
		# cabe un cuerpo de pie de 1,7 m, y no esta en una azotea ni en un sotano
		if absf(q.y - base.y) < 4.0 and not world.box_solid(
				q + Vector3(-0.45, 0.3, -0.45), q + Vector3(0.45, 1.7, 0.45)):
			return q + Vector3(0, 0.4, 0)
	# Si el abanico entero estaba pegado a una pared, se busca a la desesperada en circulo completo
	# antes de rendirse. Sin esto, uno de cada tanda se quedaba plantado dentro de la geometria.
	for anillo in 5:
		for k in 16:
			var a2: float = TAU * float(k) / 16.0
			var q2: Vector3 = _ground_near(base + Vector3(cos(a2), 0.0, sin(a2)) * (2.0 + 1.5 * float(anillo)))
			if absf(q2.y - base.y) < 4.0 and not world.box_solid(
					q2 + Vector3(-0.45, 0.3, -0.45), q2 + Vector3(0.45, 1.7, 0.45)):
				return q2 + Vector3(0, 0.4, 0)
	return base + Vector3(0, 0.6, 0)


## Ruta de caza para los terroristas: de su base al spawn de la policia, pasando por los dos sitios.
## Son los atacantes, asi que no se quedan vigilando nada: avanzan a buscarlos.
var _t_sitio_ronda := 0

## Un punto de suelo A UN LADO de la recta entre dos sitios (a izquierda o derecha, al azar): pasar por el
## obliga a entrar por otro camino. Si no hay suelo alcanzable ahi, se prueba el otro lado y luego nada.
func _desvio(desde: Vector3, hasta: Vector3) -> Vector3:
	var d: Vector3 = hasta - desde
	d.y = 0.0
	if d.length() < 8.0:
		return Vector3.ZERO
	var lado := Vector3(-d.z, 0.0, d.x).normalized()
	var sg := 1.0 if randf() < 0.5 else -1.0
	for _intento in 2:
		var q: Vector3 = _ground_near(desde.lerp(hasta, randf_range(0.4, 0.6)) + lado * sg * clampf(d.length() * 0.5, 10.0, 22.0))
		if q.y > -1.0 and world.find_path(desde, q).size() >= 2 and world.find_path(q, hasta).size() >= 2:
			return q
		sg = -sg
	return Vector3.ZERO

func _ruta_caza(desde: Vector3) -> Array:
	var ruta: Array = []
	for b in bomb_sites:
		var ps: Array = b.posts
		if not ps.is_empty():
			ruta.append(ps[randi() % ps.size()])
	if ct_spawn != Vector3.ZERO:
		for k in 3:
			ruta.append(_ground_near(ct_spawn + Vector3(randf_range(-6, 6), 0.0, randf_range(-6, 6))))
	if ruta.is_empty():
		ruta.append(_ground_near(desde))
	ruta.shuffle()
	return ruta


## EL ASPECTO DE UN BOT segun su bando: nombre, si te estorba el paso, y el tinte. Estaba escrito
## dentro del reparto de bandos, pero el duelo a muerte repone bots de uno en uno durante toda la
## partida y necesita exactamente lo mismo: mejor una funcion que dos copias que se separen.
static var _sin_montar_una: bool = "--sinmontaruna" in OS.get_cmdline_user_args()   ## A/B

func _color_bando_bot(ally: bool, tinte: Color = Color(0, 0, 0, 0)) -> Color:
	return tinte if tinte.a > 0.0 else (Color(0.62, 0.80, 1.0) if ally else Color(1.0, 0.72, 0.66))


## LOS NOMBRES DE LOS BOTS (2026-10-03, pedido: "ponles nombres, una lista de 15, de los que suele usar la gente"): en
## vez de "BOT 3" y "RIVAL 2". Cada partida empieza la lista en un sitio al azar y cada hueco de bot se queda con el suyo
## (el que reaparece en el duelo vuelve con el mismo). Con mas de 15 bots se repiten con un numero detras.
# (la lista, NOMBRES_BOTS, vive en net.gd: alli se decide tambien que nombres se enseñan)
var _nombres_bots_off := -1

func nombre_bot(i: int) -> String:
	if _nombres_bots_off < 0:
		_nombres_bots_off = randi() % Net.NOMBRES_BOTS.size()
	var k := maxi(i, 0)
	var nombre: String = Net.NOMBRES_BOTS[(k + _nombres_bots_off) % Net.NOMBRES_BOTS.size()]
	var vuelta := k / Net.NOMBRES_BOTS.size()
	return nombre if vuelta == 0 else "%s%d" % [nombre, vuelta + 1]


func _pintar_bot(e, ally: bool, i: int, tinte: Color = Color(0, 0, 0, 0)) -> void:
	# nombre para la tabla de fin de partida: los rivales no llevan etiqueta flotante, pero en la
	# tabla y para ser MVP necesitan uno. Un nombre de jugador por hueco (nombre_bot).
	var nombre := nombre_bot(i)
	if "nombre_marcador" in e:
		e.nombre_marcador = nombre
	if e.has_method("set_bot_name"):
		e.set_bot_name(nombre if ally else "")
	# LOS COMPANEROS NO TE ESTORBAN EL PASO, PERO SI LES ENTRAN LAS BALAS.
	#
	# Antes esto era `collision_layer = 0` y ademas apagaba sus formas de colision, con lo que
	# desaparecian de la fisica ENTERA: no estorbaban, no, pero tampoco les acertaba NADIE. En duelo
	# a muerte eso se ve a la primera -el marcador iba 13 a 0 porque el equipo rival no podia matar
	# a un solo aliado-.
	#
	# La capa 4 (valor 8) no esta en la mascara del jugador (5 = mundo + rivales), asi que sigue sin
	# estorbarte el paso, pero los rayos de disparo la ven. Y a ti no se te escapa un tiro a un
	# companero: player.gd ya comprueba el bando antes de aplicar dano.
	if ally:
		e.collision_layer = 8
		for c in e.get_children():
			if c is CollisionShape3D:
				c.disabled = false
	if e.avatar and e.avatar.has_method("build"):
		# el avatar se reconstruye con el tinte del bando: Node3D no tiene `modulate`, el color va en
		# el propio material del avatar (tercer argumento de build)
		# con `tinte` (la ciudad) cada equipo lleva SU color; sin el, azulado el tuyo y rojizo el rival
		var color_bando: Color = _color_bando_bot(ally, tinte)
		# YA MONTADO CON ESE COLOR (los que reaparecen: `tinte_build` antes de `setup`): no se rehace. Eran 25-40 ms por
		# bot que reaparecia (muñeco y arma dos veces), y en el duelo con bots se muere a cada rato. --sinmontaruna = antes.
		var ba: Array = e.avatar.build_args if "build_args" in e.avatar else []
		if not _sin_montar_una and ba.size() >= 4 and is_equal_approx(float(ba[0]), AvatarScript.ALTURA) \
				and ba[1] == color_bando and String(ba[2]) == "" and (ba[3] as Dictionary).is_empty() \
				and String(e.avatar.weapon_kind) != "":
			return
		e.avatar.build(AvatarScript.ALTURA, false, color_bando, false)
		# ...y reconstruirlo TIRA EL ARMA: el esqueleto es nuevo y el fusil colgaba del viejo. Por eso
		# los bots disparaban con las manos vacias. Se les vuelve a dar el fusil.
		# (con SU arma y SU skin: equip_rifle le ponia la carabina con la skin del jugador)
		if e.has_method("_montar_arma"):
			e._montar_arma("rifle")
		elif e.avatar.has_method("equip_rifle"):
			e.avatar.equip_rifle()
		e.avatar.play("idle_1")


func _assign_bot_teams() -> void:
	_rol_ct = 0
	_rol_t = 0
	_ultimo_lider = null
	var mine := Net.my_team()
	if mine == "":
		mine = Net.TEAM_T
	var other := Net.TEAM_CT if mine == Net.TEAM_T else Net.TEAM_T
	var bots: Array = enemies.get_children()
	# Se cuentan aparte los de cada bando: el indice de nacimiento `i` mezcla los dos y era justo lo
	# que descuadraba el reparto de sitios.
	_ct_i = 0
	_t_i = 0
	for i in bots.size():
		var e = bots[i]
		if not ("team" in e):
			continue
		var ally: bool = i < _bots_mios
		e.team = mine if ally else other
		_pintar_bot(e, ally, i)
		# CADA BANDO EN SU BASE, AGRUPADO Y MIRANDO HACIA EL CONTRARIO.
		var t_base: Vector3 = t_spawn if t_spawn != Vector3.ZERO else world.get_spawn_position()
		var c_base: Vector3 = ct_spawn if ct_spawn != Vector3.ZERO else t_base
		var es_ct: bool = String(e.team) == Net.TEAM_CT
		var base: Vector3 = c_base if es_ct else t_base
		var enfrente: Vector3 = t_base if es_ct else c_base
		if dm_mode and dm_centro != Vector3.ZERO:
			enfrente = dm_centro      # en duelo a muerte todos miran al centro, que es a donde van
		var n: int = _ct_i if es_ct else _t_i
		e.global_position = _sitio_bot(base, enfrente, n, _bots_por_equipo())
		e.look_at(Vector3(enfrente.x, e.global_position.y, enfrente.z), Vector3.UP)
		if "yaw_base" in e:
			e.yaw_base = e.rotation.y

		# Y SU COMETIDO, POR BANDO.
		if dm_mode:
			# En duelo a muerte no hay sitios que defender ni parejas: todos al centro.
			_dm_rol(e, base)
			if es_ct:
				_ct_i += 1
			else:
				_t_i += 1
		elif es_ct:
			# LA POLICIA DEFIENDE, MITAD Y MITAD. Antes el sitio salia del indice con el que nacia el
			# bot (`id % sitios`), un numero que mezclaba los dos bandos: acababan casi todos en el
			# mismo sitio. Ahora se cuenta SOLO a los policias, asi que 5 van a A y 5 a B.
			if not bomb_sites.is_empty():
				var sitio: Dictionary = bomb_sites[_ct_i % bomb_sites.size()]
				e.rol = "sitio_a" if (_ct_i % bomb_sites.size()) == 0 else "sitio_b"
				if _ct_i % 5 == 4:
					e.rol = "reaccion"          # uno de cada cinco acude a donde se lie
				e.rover = false
				e.assign_site(sitio.pos, sitio.posts)
				if "via" in e and (_ct_i / bomb_sites.size()) % 2 == 1:
					e.via = _desvio(ct_spawn, sitio.pos)
				e.deploy()
			_ct_i += 1
		else:
			# LOS TERRORISTAS ATACAN: ruta hacia el spawn de la policia, en parejas.
			e.rol = "lider" if (_t_i % 2 == 0) else "compa"
			if e.rol == "lider":
				_ultimo_lider = e
			elif "compa" in e:
				e.compa = _ultimo_lider
			e.rover = true
			e.guard_t = randf_range(0.5, 1.5)   # apenas se paran: van a por ellos
			# VAN A UN SITIO, TODOS AL MISMO (2026-09-23, pedido): antes la ruta eran puestos al azar de los dos
			# sitios y del spawn policia, barajados, y daban vueltas por el mapa sin ir nunca a A ni a B. Ahora
			# el equipo elige UN sitio por ronda (como un "rush B") y recorre sus puestos.
			if not bomb_sites.is_empty():
				if _t_i == 0:
					_t_sitio_ronda = randi() % bomb_sites.size()
				var obj: Dictionary = bomb_sites[_t_sitio_ronda]
				var ruta_t: Array = (obj.posts as Array).duplicate()
				ruta_t.shuffle()
				e.rol = ("lider" if e.rol == "lider" else "compa")
				e.assign_site(obj.pos, ruta_t)
				if "via" in e and _t_i % 2 == 1:
					e.via = _desvio(t_base, obj.pos)
				e.deploy()
			else:
				e.assign_site(c_base, _ruta_caza(t_base))
			_t_i += 1
	print("[Breach] bots por bandos: %d de %s (aliados) y %d de %s" % [
		_bots_mios, mine, maxi(0, bots.size() - _bots_mios), other])


## Prueba: con TODOS los bots de mi bando, no me deben disparar ni bajarme la vida, y ninguno debe
## tenerme como objetivo.
func _ally_test() -> void:
	await get_tree().create_timer(4.0).timeout
	for e in enemies.get_children():
		if "team" in e:
			e.team = player.team
			e.target = null
	player.health = 100.0
	print("[allytest] %d bots, todos de mi bando (%s)" % [enemies.get_child_count(), player.team])
	for e in enemies.get_children():
		var lbl := ""
		for c in e.get_children():
			if c is Label3D:
				lbl = String(c.text)
		print("[allytest]   bot equipo=%s etiqueta='%s' colision=%d" % [String(e.team), lbl, e.collision_layer])
	for i in 12:
		await get_tree().create_timer(1.0).timeout
		var me_apuntan := 0
		for e in enemies.get_children():
			if "target" in e and e.target == player:
				me_apuntan += 1
		print("[allytest] t=%ds  vida %.0f  ·  bots que me tienen de objetivo: %d" % [i + 1, player.health, me_apuntan])
	print("[allytest] FIN vida %.0f" % player.health)
	get_tree().quit()


## Prueba SIN RED: plantar la C4 y comprobar que aparece en el suelo y que el HUD la muestra.
func _off_bomb_test() -> void:
	await get_tree().create_timer(4.0).timeout
	if bomb_sites.is_empty():
		print("[offbomb] no hay sitios de bomba")
		get_tree().quit()
		return
	player.global_position = bomb_sites[0].pos + Vector3(0, 1.0, 0)
	player.velocity = Vector3.ZERO
	await get_tree().create_timer(1.5).timeout
	player.look.y = -1.2
	for i in Weapons.LIST.size():
		if String(Weapons.LIST[i].get("kind", "")) == "c4":
			player.current = i
	print("[offbomb] cargas de C4 en la ranura: %d" % player.ammo[player.current])
	await get_tree().create_timer(0.3).timeout
	player.plant_c4()
	await get_tree().create_timer(1.0).timeout
	var b = Net.bomb_node
	if is_instance_valid(b):
		var g = world.raycast(b.global_position + Vector3(0, 0.5, 0), Vector3.DOWN, 3.0)
		print("[offbomb] bomba en %.2f,%.2f,%.2f · suelo debajo a %.2f · quedan %.1f s" % [
			b.global_position.x, b.global_position.y, b.global_position.z,
			(g.position.y if g.hit else -999.0), b.time_left])
	else:
		print("[offbomb] NO se creo la bomba")
	print("[offbomb] cargas restantes: %d" % player.ammo[player.current])
	await get_tree().create_timer(3.0).timeout
	get_tree().quit()


## Diagnostico del tiron en el spawn de la policia: se dispara un cohete al techo de esa zona y se
## mide donde se va el frame (host C++, fisica, piezas, analizador estructural).
func _ct_roof_test() -> void:
	await get_tree().create_timer(3.0).timeout
	for e in enemies.get_children():
		e.queue_free()
	var base: Vector3 = ct_spawn if ct_spawn != Vector3.ZERO else world.get_spawn_position()
	player.global_position = base + Vector3(0, 1.0, 0)
	player.velocity = Vector3.ZERO
	world.set_player_position(player.global_position)
	await get_tree().create_timer(2.0).timeout
	# techo justo encima
	var up: Dictionary = world.raycast(player.global_position + Vector3(0, 1.4, 0), Vector3.UP, 30.0)
	print("[ctroof] spawn policia %.1f,%.1f,%.1f · techo encima: %s a %.2f m" % [
		base.x, base.y, base.z, str(up.hit), (up.position.y - player.global_position.y) if up.hit else -1.0])
	for i in 18:
		if i == 2 or i == 5 or i == 8:
			var target: Vector3 = up.position - Vector3(0, 0.3, 0) if up.hit else player.global_position + Vector3(0, 6, 0)
			var w: Dictionary = Weapons.get_def("bazooka_rpg")
			print("[ctroof] --- cohete %d al techo ---" % (i / 3 + 1))
			Net.net_explode(world, target, float(w.get("radius", 4.0)), int(w.get("power", 255)))
			Combat.damage_around(get_tree(), target, 8.0, 130.0)
		await get_tree().create_timer(1.0).timeout
		var st: Dictionary = world.get_stats()
		print("[ctroof] t=%2ds fps %2d | host %5.1f ms (max %5.1f) | upd %4.2f carve %4.2f malla %5.2f conn %4.2f solve %5.2f extract %4.2f | cuerpos %d (rigid %d) piezas %d escombros %d | estructura %s it %d celdas %d %5.1f ms/it | fisica %d obj %d pares" % [
			i + 1, Engine.get_frames_per_second(),
			st.get("t_host_ms", 0.0), st.get("t_host_max_ms", 0.0),
			st.get("t_update_ms", 0.0), st.get("t_carve_ms", 0.0), st.get("t_mesh_job_ms", 0.0),
			st.get("t_conn_ms", 0.0), st.get("t_solve_ms", 0.0), st.get("t_extract_ms", 0.0),
			st.get("bodies_active", 0), st.get("bodies_rigid", 0), st.get("pieces_total", 0), st.get("debris_active", 0),
			"ACTIVA" if st.get("struct_active", 0) > 0 else "dormida", st.get("struct_iterations", 0),
			st.get("struct_cells", 0), st.get("t_struct_ms", 0.0),
			Performance.get_monitor(Performance.PHYSICS_3D_ACTIVE_OBJECTS),
			Performance.get_monitor(Performance.PHYSICS_3D_COLLISION_PAIRS)])
	print("[ctroof] FIN")
	get_tree().quit()


## Prueba: al morir la camara NO debe caer al vacio, debe quedarse espectando.
func _death_test() -> void:
	await get_tree().create_timer(5.0).timeout
	var y0: float = player.global_position.y
	print("[death] antes de morir: y=%.2f · bots %d" % [y0, enemies.get_child_count()])
	player.take_damage(999.0)
	await get_tree().create_timer(0.5).timeout
	# volcado: que sigue VISIBLE colgando del jugador tras morir
	var vis: Array = []
	var stack: Array = [player]
	while not stack.is_empty():
		var n = stack.pop_back()
		for c in n.get_children():
			stack.append(c)
			if c is VisualInstance3D and c.visible and c.is_visible_in_tree():
				vis.append("%s" % [player.get_path_to(c)])
	print("[death] visibles bajo el jugador: %s" % str(vis))
	print("[death] espectando=%s objetivo=%s" % [str(player.spectating),
		("si: " + str(player.spectate_target.name)) if is_instance_valid(player.spectate_target) else "ninguno"])
	for i in 10:
		await get_tree().create_timer(1.0).timeout
		var t2 = player.spectate_target
		print("[death] t=%2ds  camara y=%7.2f  (caida %6.2f m)  avatar_visible=%s manos_visibles=%s  objetivo=%s" % [
			i + 1, player.global_position.y, y0 - player.global_position.y,
			str(player.avatar.visible if player.avatar else false),
			str(player.weapon_pivot.visible if player.weapon_pivot else false),
			(String(t2.name)) if is_instance_valid(t2) else "ninguno"])
		if false: print("" % [
			i + 1, player.global_position.y, y0 - player.global_position.y,
			(String(t2.name)) if is_instance_valid(t2) else "ninguno"])
	var caida: float = y0 - player.global_position.y
	print("[death] FIN: la camara bajo %.2f m -> %s" % [caida, "OK" if caida < 8.0 else "SIGUE CAYENDO AL VACIO"])
	get_tree().quit()


## Compara el coste del MISMO sitio (spawn de la policia, sin tocar nada) en cada calidad.
func _quality_compare() -> void:
	await get_tree().create_timer(3.0).timeout
	var base: Vector3 = ct_spawn if ct_spawn != Vector3.ZERO else world.get_spawn_position()
	player.global_position = base + Vector3(0, 1.0, 0)
	world.set_player_position(player.global_position)
	set_quality_manual(2)
	await get_tree().create_timer(5.0).timeout
	var vp := get_viewport()
	# cada palanca por separado, midiendo el MISMO sitio
	var pruebas: Array = [
		["HIGH con los 8 bots", func(): pass],
	]
	for pr in pruebas:
		(pr[1] as Callable).call()
		await get_tree().create_timer(3.0).timeout
		var f := 0.0
		var gpu := 0.0
		var cpu := 0.0
		for i in 150:
			await get_tree().process_frame
			f += Engine.get_frames_per_second()
			gpu += RenderingServer.viewport_get_measured_render_time_gpu(vp.get_viewport_rid())
			cpu += RenderingServer.viewport_get_measured_render_time_cpu(vp.get_viewport_rid())
		var st: Dictionary = world.get_stats()
		print("[palanca] %-28s fps %5.1f · frame %5.1f · GPU %5.1f · rCPU %5.1f · proceso %5.1f · fisica %5.1f · host %5.1f · objetos fisicos %d · chunks %d" % [
			String(pr[0]), f / 150.0, 1000.0 / maxf(1.0, f / 150.0), gpu / 150.0, cpu / 150.0,
			Performance.get_monitor(Performance.TIME_PROCESS) * 1000.0,
			Performance.get_monitor(Performance.TIME_PHYSICS_PROCESS) * 1000.0,
			st.get("t_host_ms", 0.0),
			Performance.get_monitor(Performance.PHYSICS_3D_ACTIVE_OBJECTS),
			int(st.get("chunks_visible", 0))])
	get_tree().quit()


