## --objetos3d: a los 40 s, lo que se manda a dibujar (VisualInstance3D visibles), por tipo y por quien lo creo
func _objetos_3d_censo() -> void:
	await get_tree().create_timer(40.0).timeout
	var cuenta := {}
	var total := 0
	for n in get_tree().root.find_children("*", "VisualInstance3D", true, false):
		if not (n as Node3D).is_visible_in_tree():
			continue
		var padre: Node = n.get_parent()
		var quien := ""
		while padre != null and quien == "":
			var sc = padre.get_script()
			if sc != null:
				quien = String(sc.resource_path).get_file()
			padre = padre.get_parent()
		var k := "%s <- %s" % [n.get_class(), quien]
		cuenta[k] = int(cuenta.get(k, 0)) + 1
		total += 1
	var l := cuenta.keys()
	l.sort_custom(func(a, b): return int(cuenta[a]) > int(cuenta[b]))
	print("[objetos3d] %d visibles (nodos; las instancias del mundo de voxels van aparte, por el RenderingServer)" % total)
	for k in l.slice(0, 25):
		print("[objetos3d]   %4d  %s" % [cuenta[k], k])
	var info := RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_OBJECTS_IN_FRAME)
