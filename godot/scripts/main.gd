			txt = "bomba en %.1f,%.1f,%.1f  quedan %.1f s  desactivando %.0f%%" % [
				b.global_position.x, b.global_position.y, b.global_position.z, b.time_left, b.defuse_ratio() * 100.0]
		print("[bombtest] %s t=%ds  %s" % [role, i + 1, txt])
		# la policia se planta encima y aguanta: hay que sujetarla CADA frame, si no cae por gravedad
		if player.team == Net.TEAM_CT and is_instance_valid(b) and i >= 2:
			Input.action_press("interact")
			for k in 60:
				await get_tree().physics_frame
