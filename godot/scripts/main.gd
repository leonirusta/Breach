				var sitio: Vector3 = g.global_position + Vector3(4.0, 0.0, 0.0)
				var hs: Dictionary = world.raycast(sitio + Vector3.UP * 8.0, Vector3.DOWN, 20.0)
				var suelo_y: float = (hs["position"] as Vector3).y if bool(hs.get("hit", false)) else sitio.y
				var antes := 0
				for i in range(-6, 7):
