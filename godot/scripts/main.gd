## Cuantas tarjetas de la barra de armas son la ranura de la C4 (0 o 1).
func _tarjetas_c4() -> int:
	var n := 0
	for card in hud.weapon_cards:
		if not is_instance_valid(card):
			continue
		var i: int = int(card.get_meta("slot", -1))
		if i >= 0 and i < Weapons.LIST.size() and String(Weapons.LIST[i].get("kind", "")) == "c4":
			n += 1
	return n


