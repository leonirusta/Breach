## --matarcompa: para probar el rescate a mano. En cuanto tienes bando, cae el bot aliado mas cercano.
func _matar_compa() -> void:
	while String(player.team) == "":
		await get_tree().create_timer(0.5).timeout
	await get_tree().create_timer(2.0).timeout
	var mejor = null
	var dmin := 1e9
	for b in get_tree().get_nodes_in_group("bots"):
		if is_instance_valid(b) and String(b.team) == String(player.team):
			var d: float = b.global_position.distance_to(player.global_position)
			if d < dmin:
				dmin = d
				mejor = b
	if mejor:
		mejor.global_position = player.global_position - player.global_transform.basis.z * 3.0
		mejor.take_damage(9999.0)
		hud.flash_message("PRUEBA: ha caido un compañero delante de ti")


## --rescatelan (anfitrion con --lanhost=sala --lanmap=city, invitado con --lanjoin): EL RESCATE POR LA RED.
## Los dos en el mismo equipo y sin bots. Muere el invitado (espera 15 s del atraco y espectador), el anfitrion
## lo recoge, anda con el a hombros, lo suelta y lo revive. Cada maquina cuenta lo que ve.
func _rescate_lan_test() -> void:
	var soy_host: bool = Net.hosting
	var tag := "[rescatelan %s]" % ("HOST" if soy_host else "INV")
	for _i in 240:
		await get_tree().create_timer(0.5).timeout
		if rescate != null and Net.remotes.size() > 0 and heist != null:
			break
	var limpiar := func():
		for e in enemies.get_children():
			e.queue_free()
	limpiar.call()
	# los dos en el MISMO equipo: el reparto equilibrado los separaria (con dos jugadores, uno en cada uno)
	if soy_host:
		for pid in Net.players.keys():
			Net.players[pid]["team"] = Net.TEAM_T
		Net._sync_teams.rpc(Net.players)
	await get_tree().create_timer(3.0).timeout
	player.apply_team(Net.my_team())
	limpiar.call()
	var otro: Node3D = Net.remotes.values()[0] if Net.remotes.size() > 0 else null
	print("%s equipo %s · el otro en %s" % [tag, Net.my_team(), Net.team_of(int(otro.peer_id)) if otro else "?"])
	var t0 := Time.get_ticks_msec()
	var marca := func(txt: String): print("%s t=%.1f %s" % [tag, (Time.get_ticks_msec() - t0) * 0.001, txt])
	if not soy_host:
		player.invulnerable = false
		player.take_damage(9999.0)
		await get_tree().create_timer(1.5).timeout
		marca.call("muerto: espectando %s · miro a %s · arma en la vista '%s'" % [player.spectating,
			_nombre_nodo(player.spectate_target) if is_instance_valid(player.spectate_target) else "nadie", player._vista_esp_id])
		for _k in 25:
			await get_tree().create_timer(1.0).timeout
			var av = otro.get("avatar") if is_instance_valid(otro) else null
			marca.call("espectando %s · pos %s · el otro: brazos '%s' clip '%s' cargando %s" % [player.spectating,
				str(player.global_position.round()), av._brazos_clip if av else "", av.clip_rescate if av else "",
				str(av.cargando) if av else ""])
			if not player.spectating:
				break
		marca.call("FIN: espectando %s · vida %.0f · pos %s · el otro en %s" % [player.spectating, player.health,
			str(player.global_position.round()), str(otro.global_position.round()) if is_instance_valid(otro) else "?"])
	else:
		player.invulnerable = true
		await get_tree().create_timer(2.5).timeout
		limpiar.call()
		# junto a su CUERPO (el nodo del otro va con su camara de espectador; el cuerpo se queda donde cayo)
		var avc = rescate._avatar("p%d" % int(otro.peer_id))
		var cuerpo: Vector3 = rescate._centro_cuerpo(avc) if avc else otro.global_position
		# lejos no hay suelo de Jolt hasta que se construye: se le sujeta ahi mientras llega
		for _f in 30:
			player.global_position = cuerpo + Vector3(0.8, 0.4, 0)
			player.velocity = Vector3.ZERO
			await get_tree().create_timer(0.1).timeout
		var clave := "p%d" % int(otro.peer_id)
		var avd = rescate._avatar(clave)
		marca.call("caidos %s · dead %s · activo %s · vida %.0f · centro a %.2f m" % [str(rescate.caidos.keys()), str(otro.get("dead")),
			rescate.activo(), player.health, rescate._centro_cuerpo(avd).distance_to(player.global_position) if avd else -1.0])
		marca.call("junto al cuerpo: opciones %s" % str(rescate.opciones()))
		marca.call("recoger: %s" % rescate.usar_recoger())
		await get_tree().create_timer(2.2).timeout
		marca.call("cargando: brazos '%s' clip '%s' · opciones %s" % [player.avatar._brazos_clip, player.avatar.clip_rescate, str(rescate.opciones())])
		player.global_position += Vector3(3, 0, 0)
		await get_tree().create_timer(1.0).timeout
		marca.call("soltar: %s" % rescate.usar_recoger())
		await get_tree().create_timer(2.0).timeout
		marca.call("tras soltar: opciones %s" % str(rescate.opciones()))
		marca.call("revivir: %s" % rescate.usar_revivir())
		await get_tree().create_timer(9.0).timeout
		marca.call("el otro ya: muerto %s · en %s" % [Net.is_dead(int(otro.peer_id)), str(otro.global_position.round())])
	await get_tree().create_timer(3.0).timeout
	get_tree().quit()



