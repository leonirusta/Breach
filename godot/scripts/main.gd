				"mallas sueltas (MeshInstance3D)": func(nd: Node) -> bool: return nd is MeshInstance3D,
				"Label3D": func(nd: Node) -> bool: return nd is Label3D,
				"multimallas": func(nd: Node) -> bool: return nd is MultiMeshInstance3D,
				"niebla (FogVolume)": func(nd: Node) -> bool: return nd is FogVolume,
				"sol (DirectionalLight3D)": func(nd: Node) -> bool: return nd is DirectionalLight3D,
				"muñecos de los bots": func(nd: Node) -> bool: return nd.get_parent() != null and nd.get_parent().is_in_group("bots") and nd.get_script() != null and String(nd.get_script().resource_path).ends_with("avatar_animator.gd"),
			}
			for nombre_p in clases_p:
				var nodos_p: Array = []
				var pila_p: Array = [get_tree().root]
				while not pila_p.is_empty():
					var ndp: Node = pila_p.pop_back()
					for h in ndp.get_children():
						pila_p.append(h)
					if ndp is VisualInstance3D and (clases_p[nombre_p] as Callable).call(ndp) and (ndp as VisualInstance3D).visible:
						nodos_p.append(ndp)
				var difs_p: Array = []
				for vuelta in 3:
					var a_n: float = await medir_p.call(2.5)
					for ndp in nodos_p:
						if is_instance_valid(ndp):
							(ndp as VisualInstance3D).visible = false
					await get_tree().process_frame
					var b_n: float = await medir_p.call(2.5)
					for ndp in nodos_p:
						if is_instance_valid(ndp):
							(ndp as VisualInstance3D).visible = true
					await get_tree().process_frame
					difs_p.append(b_n - a_n)
				print("[gpupausa] sin %s (%d nodos): %+.2f ms (vueltas %s)" % [nombre_p, nodos_p.size(),
					(float(difs_p[0]) + float(difs_p[1]) + float(difs_p[2])) / 3.0, ", ".join(PackedStringArray(difs_p.map(func(x): return "%+.1f" % float(x))))])
			# toda la escena 3D fuera de la camara (queda el cielo y la interfaz)
			var cam_n := get_viewport().get_camera_3d()
			var mascara: int = cam_n.cull_mask
			# solo la CAPA DEL MUNDO (11: regiones, sombras, bloques sueltos y grupos de escombros; voxel_world CAPA_MUNDO)
			var difs_m: Array = []
			for vuelta in 3:
				var a_m: float = await medir_p.call(2.5)
				cam_n.cull_mask = mascara & ~(1 << 10)
				await get_tree().process_frame
				var b_m: float = await medir_p.call(2.5)
				cam_n.cull_mask = mascara
				await get_tree().process_frame
				difs_m.append(b_m - a_m)
			print("[gpupausa] sin la capa del MUNDO (voxels y escombros): %+.2f ms (vueltas %s)" % [(float(difs_m[0]) + float(difs_m[1]) + float(difs_m[2])) / 3.0,
				", ".join(PackedStringArray(difs_m.map(func(x): return "%+.1f" % float(x))))])
			var difs_c: Array = []
			for vuelta in 3:
				var a_c: float = await medir_p.call(2.5)
				cam_n.cull_mask = 0
				await get_tree().process_frame
				var b_c: float = await medir_p.call(2.5)
				cam_n.cull_mask = mascara
				await get_tree().process_frame
				difs_c.append(b_c - a_c)
			print("[gpupausa] sin NADA 3D en la camara: %+.2f ms (vueltas %s)" % [(float(difs_c[0]) + float(difs_c[1]) + float(difs_c[2])) / 3.0,
				", ".join(PackedStringArray(difs_c.map(func(x): return "%+.1f" % float(x))))])
			get_tree().quit()
			return
		# --gpupausaobjetos (2026-10-10): que son los objetos que procesa el render; se esconden por clases y se cuenta
		if "--gpupausaobjetos" in OS.get_cmdline_user_args():
			var cuenta_cls := {}
			var pila_o: Array = [get_tree().root]
			var parados: Array = []
			while not pila_o.is_empty():
				var no: Node = pila_o.pop_back()
				pila_o.append_array(no.get_children())
				if no is VisualInstance3D and (no as VisualInstance3D).is_visible_in_tree():
					var cl := no.get_class()
					cuenta_cls[cl] = int(cuenta_cls.get(cl, 0)) + 1
					if no is MeshInstance3D:
						var clave_m := "  MI %s/%s" % [String(no.get_parent().name).left(18), String(no.name).left(14)]
						cuenta_cls[clave_m] = int(cuenta_cls.get(clave_m, 0)) + 1
					if no is GPUParticles3D and not (no as GPUParticles3D).emitting:
						parados.append(no)
						var dueno: Node = no.get_parent()
						var clave_o := "%s/%s%s%s" % [String(dueno.name).left(18), String(no.name).left(24), " (os)" if (no as GPUParticles3D).one_shot else "", " GANCHO" if no.has_meta("_fx_dormir") else ""]
						cuenta_cls["  " + clave_o] = int(cuenta_cls.get("  " + clave_o, 0)) + 1
			print("[gpupausa] visibles por clase: %s" % str(cuenta_cls))
			var a_o: float = await medir_p.call(2.5)
			var obj_a := Performance.get_monitor(Performance.RENDER_TOTAL_OBJECTS_IN_FRAME)
			var dc_a := Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME)
			for pq in parados:
				(pq as Node3D).visible = false
			await get_tree().process_frame
			var b_o: float = await medir_p.call(2.5)
			print("[gpupausa] particulas paradas (%d) escondidas: objetos %d -> %d · llamadas %d -> %d · %.2f -> %.2f ms" % [parados.size(),
				int(obj_a), int(Performance.get_monitor(Performance.RENDER_TOTAL_OBJECTS_IN_FRAME)), int(dc_a),
				int(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME)), a_o, b_o])
			get_tree().quit()
			return
		# --gpupausamblur (2026-10-10): lo que cuesta el desenfoque de movimiento encendido (ABAB, 3 vueltas). Con
		# --pantallamips, como antes (la copia de pantalla con mipmaps)
		if "--gpupausamblur" in OS.get_cmdline_user_args():
			var difs_m: Array = []
			for vuelta in 3:
				hud.set_motion_blur(Vector2.ZERO)
				await get_tree().process_frame
				var a_m: float = await medir_p.call(2.5)
				hud.set_motion_blur(Vector2(0.02, 0.0))
				await get_tree().process_frame
				var b_m: float = await medir_p.call(2.5)
				difs_m.append(b_m - a_m)
			print("[gpupausa] desenfoque de movimiento%s: %+.2f ms (vueltas %s)" % [" (con mipmaps)" if "--pantallamips" in OS.get_cmdline_user_args() else "",
				(float(difs_m[0]) + float(difs_m[1]) + float(difs_m[2])) / 3.0, ", ".join(PackedStringArray(difs_m.map(func(x): return "%+.1f" % float(x))))])
			get_tree().quit()
			return
		if "--gpupausasolo" in OS.get_cmdline_user_args():
			var vp_p := get_viewport().get_viewport_rid()
			RenderingServer.viewport_set_measure_render_time(vp_p, true)
			await medir_p.call(1.0)
			var g_acc := 0.0
			var c_acc := 0.0
			var n_acc := 0
			var fin_g := Time.get_ticks_msec() + 3000
			while Time.get_ticks_msec() < fin_g:
				await get_tree().process_frame
				g_acc += RenderingServer.viewport_get_measured_render_time_gpu(vp_p)
				c_acc += RenderingServer.viewport_get_measured_render_time_cpu(vp_p)
				n_acc += 1
			print("[gpupausa] GPU medida %.2f ms · CPU de render %.2f ms · triangulos %.0f k · llamadas %d" % [g_acc / n_acc, c_acc / n_acc,
				RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_PRIMITIVES_IN_FRAME) / 1000.0,
				RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_DRAW_CALLS_IN_FRAME)])
			await get_tree().create_timer(6.0).timeout
			get_tree().quit()
			return
		var pruebas := [["shadows", 0], ["antialias", 0], ["voxel_ao", 0], ["glow", 0], ["texturas", 0], ["lente", 0],
			["vineta", 0], ["polvo_aire", 0], ["cielo", 0], ["detail", 0], ["light_distance", 0], ["lod_distance", 0],
			["view_distance", 0], ["render_scale", 1]]
		for pr in pruebas:
			var clave := String(pr[0])
			var difs: Array = []
			for vuelta in 3:
				Settings.gfx_forzado.erase(clave)
				apply_graphics()
				await get_tree().process_frame
				await get_tree().process_frame
				var a_p: float = await medir_p.call(2.5)
				Settings.gfx_forzado[clave] = int(pr[1])
				apply_graphics()
				await get_tree().process_frame
				await get_tree().process_frame
				var b_p: float = await medir_p.call(2.5)
				difs.append(b_p - a_p)
			Settings.gfx_forzado.erase(clave)
			apply_graphics()
			var md := 0.0
			for d in difs:
				md += float(d) / 3.0
			print("[gpupausa] %-15s %d -> %d: %+.2f ms (vueltas %s)" % [clave, Settings.gfx_value(clave, quality), int(pr[1]), md,
				", ".join(PackedStringArray(difs.map(func(x): return "%+.1f" % float(x))))])
		# y la interfaz entera
		var difs_ui: Array = []
		for vuelta in 3:
			var a_u: float = await medir_p.call(2.5)
			hud.visible = false
			await get_tree().process_frame
			var b_u: float = await medir_p.call(2.5)
			hud.visible = true
			await get_tree().process_frame
			difs_ui.append(b_u - a_u)
		print("[gpupausa] sin interfaz: %+.2f ms (vueltas %s)" % [(float(difs_ui[0]) + float(difs_ui[1]) + float(difs_ui[2])) / 3.0,
			", ".join(PackedStringArray(difs_ui.map(func(x): return "%+.1f" % float(x))))])
		get_tree().quit()
		return
	# --gpunodos: con la camara en la ciudad, se esconden por clases los nodos 3D (luces menos el sol, calcomanias,
	# particulas, mallas sueltas, Label3D) ABAB, y cuanto baja la GPU
	if "--gpunodos" in OS.get_cmdline_user_args():
		var clases := {
			"luces (Omni/Spot)": func(nd: Node) -> bool: return (nd is OmniLight3D or nd is SpotLight3D),
			"calcomanias (Decal)": func(nd: Node) -> bool: return nd is Decal,
			"particulas GPU": func(nd: Node) -> bool: return nd is GPUParticles3D,
			"particulas CPU": func(nd: Node) -> bool: return nd is CPUParticles3D,
			"mallas sueltas (MeshInstance3D)": func(nd: Node) -> bool: return nd is MeshInstance3D,
			"Label3D": func(nd: Node) -> bool: return nd is Label3D,
			"multimallas": func(nd: Node) -> bool: return nd is MultiMeshInstance3D,
		}
		for nombre in clases:
			var nodos: Array = []
			var pila: Array = [get_tree().root]
			while not pila.is_empty():
				var nd: Node = pila.pop_back()
				for h in nd.get_children():
					pila.append(h)
				if nd is VisualInstance3D and (clases[nombre] as Callable).call(nd) and (nd as VisualInstance3D).visible:
					nodos.append(nd)
			var difs: Array = []
			for vuelta in 3:
				var a1: Dictionary = await _medir_tramo(2.0)
				for nd in nodos:
					if is_instance_valid(nd):
						(nd as VisualInstance3D).visible = false
				await get_tree().create_timer(0.4).timeout
				var b1: Dictionary = await _medir_tramo(2.0)
				for nd in nodos:
					if is_instance_valid(nd):
						(nd as VisualInstance3D).visible = true
				await get_tree().create_timer(0.4).timeout
				difs.append(float(b1["gpu"]) - float(a1["gpu"]))
			var mg := 0.0
			for d in difs:
				mg += float(d) / 3.0
			print("[gpunodos] sin %s (%d nodos): GPU %+.2f ms (vueltas %s)" % [nombre, nodos.size(), mg, ", ".join(PackedStringArray(difs.map(func(x): return "%+.1f" % float(x))))])
		get_tree().quit()
		return
	# --gputris: GPU frente a triangulos, moviendo la distancia de detalle (0..7) en la misma vista, ida y vuelta
	if "--gputris" in OS.get_cmdline_user_args():
		for ld in [0, 2, 4, 6, 7, 5, 3, 1]:
			Settings.gfx_forzado["lod_distance"] = ld
			apply_graphics()
			await get_tree().create_timer(2.5).timeout
			var rt: Dictionary = await _medir_tramo(3.0)
			print("[gputris] detalle %d: GPU %.2f ms · triangulos %.0f k · llamadas %.0f" % [ld, float(rt["gpu"]), float(rt["tri"]) / 1000.0, float(rt["llamadas"])])
		get_tree().quit()
		return
	# --lienzos: lo que pinta la interfaz cada fotograma: CanvasItems visibles con sombreado propio o que tapan mucha pantalla
	if "--lienzos" in OS.get_cmdline_user_args():
		var tam_p := get_viewport().get_visible_rect().size
		var lista: Array = []
		var pila: Array = [get_tree().root]
		var n_vis := 0
		while not pila.is_empty():
			var nd: Node = pila.pop_back()
			for h in nd.get_children():
				pila.append(h)
			if nd is CanvasItem and (nd as CanvasItem).is_visible_in_tree():
				n_vis += 1
				var ci := nd as CanvasItem
				var area := 0.0
				if ci is Control:
					var rr := (ci as Control).get_global_rect()
					area = rr.size.x * rr.size.y / maxf(1.0, tam_p.x * tam_p.y)
				var alfa := ci.modulate.a * ci.self_modulate.a
				var con_sh: bool = ci.material is ShaderMaterial
				if con_sh or area > 0.3:
					var extra := ""
					if ci is ColorRect:
						extra += " color %s" % str((ci as ColorRect).color)
					if ci is TextureRect and (ci as TextureRect).texture:
						extra += " textura %s" % (ci as TextureRect).texture.resource_path
					if con_sh and (ci.material as ShaderMaterial).shader:
						extra += " sombreado %s (lee pantalla: %s)" % [(ci.material as ShaderMaterial).shader.resource_path, str((ci.material as ShaderMaterial).shader.code.contains("screen_texture") or (ci.material as ShaderMaterial).shader.code.contains("SCREEN_TEXTURE"))]
					lista.append("%s(%s) area %.0f%% alfa %.2f%s · %s%s" % [ci.name, ci.get_class(), area * 100.0, alfa, " SOMBREADO" if con_sh else "", str(ci.get_path()), extra])
		print("[lienzos] %d CanvasItems visibles. Con sombreado o que tapan >30%%:" % n_vis)
		for l in lista:
			print("[lienzos]   %s" % l)
		get_tree().quit()
		return
	# --gpusombreado: el material del mundo cambiado por uno minimo (misma geometria), ABAB: ¿cuesta el sombreado?
	if "--gpusombreado" in OS.get_cmdline_user_args():
		var mat_w: Material = world.opaque_material
		var sh_min := Shader.new()
		sh_min.code = "shader_type spatial;
render_mode cull_back, unshaded;
void fragment() { ALBEDO = COLOR.rgb; }
"
		var m_min := ShaderMaterial.new()
		m_min.shader = sh_min
		var sh_orig: Shader = (mat_w as ShaderMaterial).shader
		for rs in [3, 0]:
			Settings.gfx_forzado["render_scale"] = rs
			apply_graphics()
			var difs: Array = []
			for vuelta in 3:
				var a1: Dictionary = await _medir_tramo(2.0)
				(mat_w as ShaderMaterial).shader = sh_min
				await get_tree().create_timer(0.5).timeout
				var b1: Dictionary = await _medir_tramo(2.0)
				(mat_w as ShaderMaterial).shader = sh_orig
				await get_tree().create_timer(0.5).timeout
				difs.append(float(b1["gpu"]) - float(a1["gpu"]))
				print("[gpusombreado] resolucion %s vuelta %d: GPU con el de verdad %.2f ms, con el minimo %.2f ms" % [["25 %", "", "", "50 %"][rs], vuelta, float(a1["gpu"]), float(b1["gpu"])])
		get_tree().quit()
		return
	# --gpulejos: la camara a 2 km y el jugador congelado alli 12 s (para --gpu-profile: que queda en "Render Opaque")
	if "--gpulejos" in OS.get_cmdline_user_args():
		player.global_position += Vector3(2000.0, 300.0, 2000.0)
		player.velocity = Vector3.ZERO
		player.process_mode = Node.PROCESS_MODE_DISABLED
		print("[gpulejos] camara a 2 km")
		await get_tree().create_timer(12.0).timeout
		print("[gpulejos] fin")
		get_tree().quit()
		return
	# --gpufijo: LO QUE CUESTA LA GPU SIN NADA QUE DIBUJAR (camara a 2 km), apagando cosas una tras otra (acumulado)
	if "--gpufijo" in OS.get_cmdline_user_args():
		var pos0: Vector3 = player.global_position
		player.global_position = pos0 + Vector3(2000.0, 300.0, 2000.0)
		player.velocity = Vector3.ZERO
		await get_tree().create_timer(1.5).timeout
		var pasos := [["(nada apagado)", ""], ["brillo", "glow"], ["antialias", "antialias"], ["sombras", "shadows"],
			["cielo (Liso)", "cielo"], ["lente+vineta+desenfoque", "lente"], ["interfaz", "#hud"], ["jugador", "#player"],
			["niebla", "#niebla"], ["resolucion 25 %", "render_scale"]]
		for ps in pasos:
			var k := String(ps[1])
			if k == "#hud":
				hud.visible = false
			elif k == "#player":
				player.visible = false
			elif k == "#niebla":
				var we2 := get_node_or_null("WorldEnvironment") as WorldEnvironment
				if we2 and we2.environment:
					we2.environment.fog_enabled = false
					we2.environment.volumetric_fog_enabled = false
			elif k == "lente":
				for kk in ["lente", "vineta", "motion_blur", "bodycam", "focus"]:
					Settings.gfx_forzado[kk] = 0
				apply_graphics()
			elif k != "":
				Settings.gfx_forzado[k] = 0
				apply_graphics()
			await get_tree().create_timer(1.0).timeout
			var rf: Dictionary = await _medir_tramo(3.0)
			print("[gpufijo] sin %-24s GPU %.2f ms · fotograma %.2f ms · tri %.0f k · llamadas %.0f" % [String(ps[0]), float(rf["gpu"]), float(rf["ms"]), float(rf["tri"]) / 1000.0, float(rf["llamadas"])])
		get_tree().quit()
		return
	# --gpupartes: la GPU sin el mundo de voxels, sin la interfaz, sin los muñecos/armas (el jugador), ABAB
	if "--gpupartes" in OS.get_cmdline_user_args():
		var partes := {
			"mundo de voxels": [world],
			"interfaz (hud)": [hud],
			"jugador (muñeco y armas)": [player],
			"distancia de dibujo a 40 m": [],
			"todo el mapa (camara a 2 km)": [],
		}
		for nombre in partes:
			var difs: Array = []
			for vuelta in 3:
				var a1: Dictionary = await _medir_tramo(2.0)
				if nombre.begins_with("distancia"):
					world.set_render_distance_scale(0.33)
				var pos0: Vector3 = player.global_position
				if nombre.begins_with("todo el mapa"):
					player.global_position = pos0 + Vector3(2000.0, 300.0, 2000.0)
					player.velocity = Vector3.ZERO
				for nd in partes[nombre]:
					if nd is Node3D:
						(nd as Node3D).visible = false
					elif nd is CanvasLayer:
						(nd as CanvasLayer).visible = false
				await get_tree().create_timer(0.5).timeout
				var b1: Dictionary = await _medir_tramo(2.0)
				if nombre.begins_with("distancia"):
					world.set_render_distance_scale(1.0)
				if nombre.begins_with("todo el mapa"):
					player.global_position = pos0
					player.velocity = Vector3.ZERO
				for nd in partes[nombre]:
					if nd is Node3D:
						(nd as Node3D).visible = true
					elif nd is CanvasLayer:
						(nd as CanvasLayer).visible = true
				await get_tree().create_timer(0.5).timeout
				difs.append([float(b1["gpu"]) - float(a1["gpu"]), float(b1["tri"]) - float(a1["tri"])])
			var mg := 0.0
			var mt := 0.0
			for d in difs:
				mg += float(d[0]) / 3.0
				mt += float(d[1]) / 3.0
			print("[gpupartes] sin %s: GPU %+.2f ms · triangulos %+.0f k" % [nombre, mg, mt / 1000.0])
		get_tree().quit()
		return
	# --gpuvista: la GPU con la ciudad delante y con el cielo, al 50 % y al 25 % de resolucion (¿pixeles o geometria?)
	if "--gpuvista" in OS.get_cmdline_user_args():
		for pitch in [-6.0, 80.0]:
			for rs in [3, 0]:
				Settings.gfx_forzado["render_scale"] = rs
				apply_graphics()
				player.look.y = deg_to_rad(pitch)
				await get_tree().create_timer(1.0).timeout
				var rv: Dictionary = await _medir_tramo(3.0)
				print("[gpuvista] mirando %s, resolucion %s: GPU %.2f ms · tri %.0f k · llamadas %.0f" % ["al cielo" if pitch > 0 else "a la ciudad",
					["25 %", "", "", "50 %"][rs], float(rv["gpu"]), float(rv["tri"]) / 1000.0, float(rv["llamadas"])])
		get_tree().quit()
		return
	var pruebas := [["motion_blur", 0], ["lente", 0], ["vineta", 0], ["glow", 0], ["antialias", 0], ["antialias", 1],
		["voxel_ao", 0], ["shadows", 0], ["texturas", 0], ["cielo", 0], ["agua", 0], ["light_distance", 0],
		["polvo_aire", 0], ["lluvia_suelo", 0], ["render_scale", 2], ["lod_distance", 0], ["lod_lejos", 0], ["detail", 0]]
	var base: Dictionary = await _medir_tramo(4.0)
	print("[gpuab] base: %s" % _texto_tramo(base))
	for pr in pruebas:
		var clave := String(pr[0])
		var difs_g: Array = []
		var difs_f: Array = []
		for vuelta in 3:
			Settings.gfx_forzado.erase(clave)
			apply_graphics()
			await get_tree().create_timer(0.6).timeout
			var a1: Dictionary = await _medir_tramo(2.0)
			Settings.gfx_forzado[clave] = int(pr[1])
			apply_graphics()
			await get_tree().create_timer(0.6).timeout
			var b1: Dictionary = await _medir_tramo(2.0)
			difs_g.append(float(b1["gpu"]) - float(a1["gpu"]))
			difs_f.append(float(b1["ms"]) - float(a1["ms"]))
		Settings.gfx_forzado.erase(clave)
		apply_graphics()
		var mg := 0.0
		var mf := 0.0
		for i in 3:
			mg += float(difs_g[i]) / 3.0
			mf += float(difs_f[i]) / 3.0
		print("[gpuab] %-15s %d -> %d: GPU %+.2f ms · fotograma %+.2f ms (GPU por vuelta %s)" % [clave, Settings.gfx_value(clave, quality), int(pr[1]),
			mg, mf, ", ".join(PackedStringArray(difs_g.map(func(x): return "%+.1f" % float(x))))])
	get_tree().quit()


## --invisiblebotstest (con --personaje=9 y bots, p. ej. --map=cafeteria --submodo=todos): ¿TE VEN LOS BOTS INVISIBLE?
## El jugador quieto a 7 m de un bot, 10 s visible y 10 s invisible (energia llena todo el rato; la vida se rellena): cuenta
## en cada fase cuantos bots te tienen de objetivo, cuantos estan en combate contigo y el daño que te llega.
func _invisible_bots_test() -> void:
	await get_tree().create_timer(12.0).timeout
	var h = player.get("_hab")
	player.invulnerable = false
	var fases := [["VISIBLE", false], ["INVISIBLE", true]]
	for f in fases:
		var bots: Array = enemies.get_children().filter(func(b): return is_instance_valid(b) and float(b.get("health")) > 0.0)
		if bots.is_empty():
			print("[invisbots] no hay bots")
			get_tree().quit(1)
			return
		var b0: Node3D = bots[0]
		var fwd: Vector3 = -b0.global_transform.basis.z
		fwd.y = 0.0
		player.global_position = b0.global_position + fwd.normalized() * 7.0 + Vector3.UP * 0.2
		player.velocity = Vector3.ZERO
		if f[1]:
			h.energia = h.energia_max
			h.recarga = 0.0
			h.activar()
		var dano := 0.0
		var muestras := 0
		var objetivo := 0
		var combate := 0
		var t := 0.0
		while t < 10.0:
			await get_tree().physics_frame
			t += get_physics_process_delta_time()
			if f[1]:
				h.energia = h.energia_max
			var v := float(player.health)
			var vmax: float = player.vida_max() if player.has_method("vida_max") else 100.0
			if v < vmax:
				dano += vmax - v
				player.health = vmax
			if Engine.get_physics_frames() % 15 == 0:
				muestras += 1
				for b in enemies.get_children():
					if not is_instance_valid(b):
						continue
					if b.get("target") == player:
						objetivo += 1
						if f[1] and objetivo <= 12:
							print("[invisbots]   t %.1f bot %s a %.1f m, estado %d, invisible del jugador %s" % [t, b.name,
								b.global_position.distance_to(player.global_position), int(b.get("state")), str(player.invisible)])
						if int(b.get("state")) == 3:
							combate += 1
		print("[invisbots] %-9s invisible=%s · bots que te tienen de objetivo (media) %.2f · en combate contigo %.2f · daño %.0f en 10 s" % [
			f[0], str(player.invisible), float(objetivo) / maxf(1, muestras), float(combate) / maxf(1, muestras), dano])
		if f[1] and h.has_method("_fin_invisible"):
			h._fin_invisible()
	get_tree().quit()


