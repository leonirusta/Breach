			print("[punetazofoto] %s t=%.2f  clip=%s  reloj del clip=%.2f  punio_t=%.2f  fps=%d" % ["tp" if tp else "fp", float(m),
				player.avatar.current_clip, float(player.avatar._time), float(player.avatar._punio_t), Engine.get_frames_per_second()])
		await get_tree().create_timer(2.0).timeout
		if cam_tp:
			cam_tp.queue_free()
			player.set_third_person(false)
	print("[punetazofoto] listo")
	get_tree().quit()


## --latenciatest: ¿CUANTO TARDA EN VERSE LO QUE SE ROMPE? Un muro de hormigon a 4 m; diez balazos y tres golpes de
## mazo (explode de 0,6 m), cada uno en un sitio nuevo. Por cada uno, los fotogramas y los ms hasta que no queda nada
## en el camino de la malla: mallado (jobs_pending), subida (mesh_results_pending), bloque sucio (blocks_dirty) y
## bloque en el hilo o esperando su cambio (bloques_en_vuelo). VX_BLOQUES_SYNC=1 para comparar sin el hilo.
func _latencia_test() -> void:
	await get_tree().create_timer(7.0).timeout
	player.invulnerable = true
	for e in enemies.get_children():
		e.queue_free()
	var vs: float = world.get_voxel_size()
	var p0: Vector3 = player.global_position
	var o := Vector3i(int(floor((p0.x - 3.0) / vs)), int(floor((p0.y + 0.02) / vs)), int(floor((p0.z - 5.0) / vs)))
	var tam := Vector3i(int(round(6.0 / vs)), int(round(3.0 / vs)), int(round(0.6 / vs)))
	var mats := PackedByteArray()
	mats.resize(tam.x * tam.y * tam.z)
	mats.fill(4)
	world.place_settled(o, tam, mats)
	await get_tree().create_timer(2.0).timeout
	var pendiente := func() -> Array:
		var st: Dictionary = world.get_stats()
		return [int(st.get("jobs_pending", 0)), int(st.get("mesh_results_pending", 0)), int(st.get("blocks_dirty", 0)),
			int(st.get("bloques_en_vuelo", 0))]
	for tipo in ["bala", "mazo"]:
		var ms_tot := 0.0
		var fr_tot := 0
		var peor := 0.0
		var n := 10 if tipo == "bala" else 3
		for i in n:
			var x: float = o.x * vs + 0.5 + i * 0.5
			var y: float = o.y * vs + 0.6 + (i % 3) * 0.6
			var t0 := Time.get_ticks_usec()
			if tipo == "bala":
				world.shoot(Vector3(x, y, p0.z), Vector3.FORWARD, 8.0, 70)
			else:
				world.explode(Vector3(x, y, o.z * vs), 0.6, 255)
			var frames := 0
			var fases := [-1, -1, -1, -1]
			while frames < 240:
				await get_tree().process_frame
				frames += 1
				var q: Array = pendiente.call()
				for k in 4:
					if fases[k] < 0 and int(q[k]) == 0 and (k == 0 or fases[k - 1] >= 0):
						fases[k] = frames
				if fases[3] >= 0:
					break
			var ms := (Time.get_ticks_usec() - t0) / 1000.0
			ms_tot += ms
			fr_tot += frames
			peor = maxf(peor, ms)
			if i < 3:
				print("[latencia] %s %d: se ve a los %d fotogramas (%.0f ms) · mallado %d, subida %d, bloque %d, en vuelo %d" % [
					tipo, i + 1, frames, ms, fases[0], fases[1], fases[2], fases[3]])
			await get_tree().create_timer(0.3).timeout
		print("[latencia] %s %s: media %.1f fotogramas, %.0f ms (peor %.0f ms) · %d fps" % [
			"SIN HILO" if OS.get_environment("VX_BLOQUES_SYNC") != "" else "con hilo", tipo, float(fr_tot) / n, ms_tot / n, peor,
			Engine.get_frames_per_second()])
	get_tree().quit()


## --habilidadtest: LAS CUATRO HABILIDADES EN LA PARTIDA, medidas y con fotos (user://habtest_*.png).
##   punetazo  contra un muro de hormigon de 6 x 5 x 1 m a 9 m: cuanta superficie del muro queda abierta (rayos)
##   salto     apuntando al suelo a 14 m: a cuanto cae del punto apuntado
##   gancho    apuntando a lo alto del muro: a cuanto llega del garfio y cuanto tarda
##   invisible ¿te busca un bot que tienes delante? (enemy._pick_target)
func _habilidad_test() -> void:
	await get_tree().create_timer(7.0).timeout
	player.invulnerable = true
	# LA HABILIDAD LA TRAE EL PERSONAJE (nivel_personaje.gd): la prueba usa las cuatro
	HabilidadScript.prueba_todas = true
	# las habilidades salen del PASE (pase_batalla.gd): la prueba se las da todas (sin guardarlo)
	for hid in PaseBatalla.HABILIDAD_EN:
		if not Settings.tengo("hab_" + String(hid)):
			Settings.armas_compradas.append("hab_" + String(hid))
	for e in enemies.get_children():
		e.queue_free()
	var h = player.get("_hab")
	var vs: float = world.get_voxel_size()
	var p0: Vector3 = player.global_position
	var foto := func(nombre: String) -> void:
		await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("user://habtest_%s.png" % nombre)
	# el muro: 6 m de ancho, 5 de alto y 1 de grueso, a 9 m hacia donde se mira (-Z)
	var o := Vector3i(int(floor((p0.x - 3.0) / vs)), int(floor((p0.y + 0.02) / vs)), int(floor((p0.z - 10.0) / vs)))
	var tam := Vector3i(int(round(6.0 / vs)), int(round(5.0 / vs)), int(round(1.0 / vs)))
	var mats := PackedByteArray()
	mats.resize(tam.x * tam.y * tam.z)
	mats.fill(4)
	world.place_settled(o, tam, mats)
	await get_tree().create_timer(1.0).timeout
	var abierto := func() -> float:
		var pasan := 0
		var total := 0
		for iy in 10:
			for ix in 12:
				var q := Vector3(o.x * vs + 0.25 + ix * 0.5, o.y * vs + 0.25 + iy * 0.5, p0.z - 5.0)
				var r: Dictionary = world.raycast(q, Vector3.FORWARD, 7.0)
				total += 1
				if not bool(r.get("hit", false)):
					pasan += 1
		return float(pasan) / float(total)
	print("[habtest] muro: %.0f %% abierto antes" % (abierto.call() * 100.0))
	# ---- SALTO: al suelo a 14 m, en diagonal (fuera del tunel)
	player.global_position = p0
	await get_tree().physics_frame
	var ojo: float = player.cam.global_position.y - p0.y
	player.look = Vector2(0.9, -atan(ojo / 14.0))
	await get_tree().physics_frame
	var ar: Array = player._aim_ray(60.0)
	var rr: Dictionary = world.raycast(ar[0], ar[1], 60.0)
	var apuntado: Vector3 = rr["position"] if bool(rr.get("hit", false)) else Vector3.ZERO
	h.tipo = "salto"
	h.recarga = 0.0
	h.activar()
	var t := 0.0
	var foto_aire := false
	while t < 5.0:
		await get_tree().physics_frame
		t += get_physics_process_delta_time()
		if not foto_aire and t > h._salto_dur * 0.5:
			foto_aire = true
			await foto.call("salto_aire")
		if h.fase == "":
			break
	await get_tree().create_timer(0.12).timeout
	await foto.call("salto_golpe")
	var cae: Vector3 = player.global_position
	print("[habtest] SALTO: vuelo %.2f s (calculado %.2f); cae a %.2f m del punto apuntado (a %.1f m)" % [
		t, h._salto_dur, Vector2(cae.x - apuntado.x, cae.z - apuntado.z).length(), Vector2(apuntado.x - p0.x, apuntado.z - p0.z).length()])
	# ---- GANCHO: a lo alto del muro (lo que quede)
	player.global_position = p0 + Vector3(-2.5, 0.0, 0.0)
	player.velocity = Vector3.ZERO
	await get_tree().create_timer(0.5).timeout
	player.look = Vector2(0.0, 0.0)
	await get_tree().physics_frame
	var ojo2: Vector3 = player.cam.global_position
	var arriba := Vector3(o.x * vs + 0.4, (o.y + tam.y) * vs - 0.3, o.z * vs)
	var dir := (arriba - ojo2).normalized()
	player.look = Vector2(atan2(-dir.x, -dir.z), asin(dir.y))
	await get_tree().physics_frame
	h.tipo = "gancho"
	h.recarga = 0.0
	h.activar()
	var punto: Vector3 = h._punto
	t = 0.0
	var foto_tira := false
	var mas_cerca := 999.0
	while t < 5.0:
		await get_tree().physics_frame
		t += get_physics_process_delta_time()
		mas_cerca = minf(mas_cerca, (player.global_position + Vector3.UP * 0.9).distance_to(punto))
		if not foto_tira and h.fase == "gancho_tira" and t > 0.35:
			foto_tira = true
			await foto.call("gancho_tira")
		if h.fase == "":
			break
	print("[habtest] GANCHO: garfio a %.1f m; tarda %.2f s; llega a %.2f m del garfio" % [ojo2.distance_to(punto), t, mas_cerca])
	# y DE LADO: el mismo gancho con "derecha" pulsado; cuanto se aparta de la linea recta
	player.global_position = p0 + Vector3(-2.5, 0.0, 0.0)
	player.velocity = Vector3.ZERO
	await get_tree().create_timer(0.6).timeout
	player.look = Vector2(atan2(-dir.x, -dir.z), asin(dir.y))
	await get_tree().physics_frame
	h.recarga = 0.0
	var sale: Vector3 = player.global_position
	h.activar()
	Input.action_press("move_right")
	var aparta := 0.0
	t = 0.0
	while t < 4.0 and h.fase != "":
		await get_tree().physics_frame
		t += get_physics_process_delta_time()
		var linea: Vector3 = (h._punto - sale).normalized()
		var rel: Vector3 = player.global_position - sale
		aparta = maxf(aparta, (rel - linea * rel.dot(linea)).length())
	Input.action_release("move_right")
	print("[habtest] GANCHO DE LADO (derecha pulsada): se aparta %.2f m de la linea recta" % aparta)
	# ---- PUÑETAZO
	player.global_position = p0
	player.velocity = Vector3.ZERO
	await get_tree().create_timer(0.8).timeout
	player.look = Vector2(0.0, -0.12)
	h.tipo = "punetazo"
	h.recarga = 0.0
	print("[habtest] punetazo activado: %s (en el suelo %s, trepando %s)" % [str(h.activar()), str(player.is_on_floor()), str(player._trepa_t)])
	await get_tree().create_timer(0.55).timeout
	await foto.call("punetazo_carga")
	await get_tree().create_timer(0.36).timeout
	await foto.call("punetazo_golpe")
	await get_tree().create_timer(0.45).timeout
	await foto.call("punetazo_onda")
	await get_tree().create_timer(2.0).timeout
	await foto.call("punetazo_tunel")
	print("[habtest] PUÑETAZO: el muro queda %.0f %% abierto (una onda de 22 m, tunel de 1,3 a 2,6 m de radio)" % (abierto.call() * 100.0))
	# ---- INVISIBLE, con un bot delante y en tercera persona
	await get_tree().create_timer(1.0).timeout
	player.global_position = p0 + Vector3(4.0, 0.0, 2.0)
	player.velocity = Vector3.ZERO
	await get_tree().create_timer(0.8).timeout
	h.tipo = "invisible"
	h.recarga = 0.0
	h.activar()
	var bot = null
	if has_method("_spawn_bot_en"):
		bot = call("_spawn_bot_en", player.global_position + Vector3(0, 0, -8.0))
	await get_tree().create_timer(0.9).timeout
	player.set_third_person(true)
	await get_tree().create_timer(0.6).timeout
	await foto.call("invisible_tp")
	player.set_third_person(false)
	await get_tree().create_timer(0.3).timeout
	await foto.call("invisible_fp")
	print("[habtest] INVISIBLE: jugador.invisible=%s, fase=%s, quedan %.1f s" % [str(player.invisible), h.fase, h.invisible_t])
	player.fire()
	await get_tree().physics_frame
	print("[habtest] INVISIBLE: tras disparar, invisible=%s (disparar te delata); recarga %.0f s" % [str(player.invisible), h.recarga])
	get_tree().quit()


## --rampatest: ¿SE HUNDE EL MUÑECO AL ANDAR POR ALGO INCLINADO? (lo unico inclinado del juego son los bloques caidos).
## Una losa de Jolt a 20 y a 35 grados; el jugador la sube y la baja andando y se mide cuanto va el muñeco por debajo
## (o por encima) de la capsula: `avatar.position.y`, que es `_escalon_suave`. --sinrampa para el antes.
func _rampa_test() -> void:
	await get_tree().create_timer(7.0).timeout
	player.invulnerable = true
	for e in enemies.get_children():
		e.queue_free()
	var p0: Vector3 = player.global_position
	for grados in [20.0, 35.0]:
		var largo := 5.0
		var ang := deg_to_rad(float(grados))
		var losa := StaticBody3D.new()
		var cs := CollisionShape3D.new()
		var bs := BoxShape3D.new()
		bs.size = Vector3(largo, 0.2, 2.5)
		cs.shape = bs
		losa.add_child(cs)
		add_child(losa)
		# empieza en el suelo 1,5 m delante del jugador (+X) y sube hacia +X
		losa.global_transform = Transform3D(Basis(Vector3.BACK, ang), p0 + Vector3(1.5 + cos(ang) * largo * 0.5, sin(ang) * largo * 0.5 - 0.1, 0.0))
		for sentido in [1, -1]:
			player.velocity = Vector3.ZERO
			if sentido == 1:
				player.global_position = p0 + Vector3(0.5, 0.05, 0.0)
				player.rotation.y = -PI * 0.5
				player.look.x = -PI * 0.5
			else:
				player.global_position = p0 + Vector3(1.5 + cos(ang) * largo - 0.4, sin(ang) * largo + 0.3, 0.0)
				player.rotation.y = PI * 0.5
				player.look.x = PI * 0.5
			player.look.y = 0.0
			for _f in 20:
				await get_tree().physics_frame
			var peor := 0.0
			var suma := 0.0
			var n := 0
			var t := 0.0
			while t < 2.2:
				player.touch_move = Vector2(0, -1.0)
				await get_tree().physics_frame
				t += get_physics_process_delta_time()
				var x: float = player.global_position.x - p0.x
				if x > 2.0 and x < 1.5 + cos(ang) * largo - 0.6:
					var hundido: float = float(player.avatar.position.y)
					suma += hundido
					n += 1
					if absf(hundido) > absf(peor):
						peor = hundido
			player.touch_move = Vector2.ZERO
			print("[rampa] %s  %.0f grados %s: muñeco respecto a la capsula en la rampa: media %+.1f cm, peor %+.1f cm (%d cuadros)" % [
				"ANTES" if "--sinrampa" in OS.get_cmdline_user_args() else "AHORA", grados,
				"SUBIENDO" if sentido == 1 else "BAJANDO ", suma / maxf(1.0, n) * 100.0, peor * 100.0, n])
		losa.queue_free()
		await get_tree().physics_frame
	get_tree().quit()


## --mesapisatest: UNA MESA DE HORMIGON A BALAZOS. Se levanta delante del jugador (tablero de 2 x 1,2 m, cuatro patas de
## 20 cm y 1 m), se le cortan a tiros de fusil las dos patas de un lado y se mira: (1) si se cae por el peso (las balas
## tienen que abrir el analisis de carga) y (2) cuanta parte del bloque caido tiene colision (suma de las cajas de Jolt
## entre sus voxels), con el tiempo, hasta que se congela. Al final se sube el jugador encima y se mide cuanto se hunde.
func _mesa_pisa_test() -> void:
	await get_tree().create_timer(7.0).timeout
	var vs: float = world.get_voxel_size()
	var p: Vector3 = player.global_position
	var n_leg := maxi(1, int(round(0.2 / vs)))
	var alto := int(round(1.0 / vs))
	var grueso := maxi(1, int(round(0.2 / vs)))
	var tam := Vector3i(int(round(2.0 / vs)), alto + grueso, int(round(1.2 / vs)))
	var o := Vector3i(int(floor((p.x + 3.0) / vs)), int(floor((p.y + 0.02) / vs)), int(floor((p.z - 0.6) / vs)))
	var mats := PackedByteArray()
	mats.resize(tam.x * tam.y * tam.z)
	for z in tam.z:
		for y in tam.y:
			for x in tam.x:
				var pata := (x < n_leg or x >= tam.x - n_leg) and (z < n_leg or z >= tam.z - n_leg)
				if y >= alto or pata:
					mats[x + y * tam.x + z * tam.x * tam.y] = 4    # hormigon (vx::MAT_CONCRETE)
	world.place_settled(o, tam, mats)
	await get_tree().create_timer(1.5).timeout
	# las dos patas del lado lejano (x alto), a 40 cm del suelo, de lado y con algo de dispersion
	var tiros := 0
	for zi in 2:
		var zc: float = (o.z + (n_leg * 0.5 if zi == 0 else tam.z - n_leg * 0.5)) * vs
		var xc: float = (o.x + tam.x - n_leg * 0.5) * vs
		for k in 60:
			for h in [0.3, 0.4, 0.5]:
				var y: float = o.y * vs + float(h) + ((k % 3) - 1) * 0.03
				var d: Dictionary = world.shoot(Vector3(xc, y, zc - 3.0), Vector3(((k % 5) - 2) * 0.006, 0, 1).normalized(), 6.0, 70)
				tiros += 1
			await get_tree().physics_frame
	print("[mesapisa] %d tiros de fusil a las dos patas (voxel %.0f cm)" % [tiros, vs * 100.0])
	var top_c := Vector3((o.x + tam.x * 0.5) * vs, (o.y + alto + grueso * 0.5) * vs, (o.z + tam.z * 0.5) * vs)
	var cayo := false
	for i in 12:
		await get_tree().create_timer(0.5).timeout
		var r: Dictionary = world.raycast(top_c + Vector3.UP * 2.0, Vector3.DOWN, 2.5)
		var en_rejilla: bool = bool(r.get("hit", false)) and float(r.get("distance", 9.0)) < 2.0 + grueso * vs
		var mejor := {}
		for b in world.get_bodies_debug():
			if int(b["voxels"]) > int(mejor.get("voxels", 0)) and (b["pos"] as Vector3).distance_to(top_c) < 4.0:
				mejor = b
		var cober := -1.0
		var ncajas := 0
		var estado := ""
		if not mejor.is_empty() and (mejor["rid"] as RID).is_valid():
			var rid: RID = mejor["rid"]
			ncajas = PhysicsServer3D.body_get_shape_count(rid)
			var vol := 0.0
			for si in ncajas:
				var sh: RID = PhysicsServer3D.body_get_shape(rid, si)
				var he = PhysicsServer3D.shape_get_data(sh)
				if he is Vector3:
					vol += 8.0 * (he as Vector3).x * (he as Vector3).y * (he as Vector3).z
			cober = vol / (float(mejor["voxels"]) * vs * vs * vs)
			for bi in world.bodies_info():
				if int(bi["voxels"]) == int(mejor["voxels"]) and (bi["pos"] as Vector3).distance_to(mejor["pos"]) < 0.01:
					estado = ("congelado" if bi["congelado"] else ("rigido" if bi["rigido"] else "cinematico")) + " v=%.2f" % float(bi["vel"])
		if not en_rejilla:
			cayo = true
		print("[mesapisa] t=%.1f s  tablero en la rejilla: %s  bloque: %s voxels, %d cajas, colision en el %.0f %% de sus voxels, %s" % [
			(i + 1) * 0.5, "SI" if en_rejilla else "no", str(mejor.get("voxels", 0)), ncajas, cober * 100.0, estado])
	print("[mesapisa] %s" % ("LA MESA SE CAYO por el peso" if cayo else "LA MESA SIGUE EN PIE (flotando sobre dos patas)"))
	# LO QUE SE VE CONTRA LO QUE SE PISA: sobre el bloque caido, rayos desde arriba contra sus voxels (raycast_con_piezas)
	# y contra la fisica (intersect_ray). Si no coinciden, el dibujo y la colision estan desplazados.
	var mejor := {}
	for b in world.get_bodies_debug():
		if int(b["voxels"]) > int(mejor.get("voxels", 0)) and (b["pos"] as Vector3).distance_to(top_c) < 4.0:
			mejor = b
	if mejor.is_empty():
		print("[mesapisa] no hay bloque")
		get_tree().quit()
		return
	var c: Vector3 = mejor["pos"]
	var esp := get_viewport().get_world_3d().direct_space_state
	var difs: Array = []
	var linea := ""
	for iz in 5:
		linea = ""
		for ix in 5:
			var q := Vector3(c.x - 0.8 + ix * 0.4, c.y + 3.0, c.z - 0.5 + iz * 0.25)
			var rv: Dictionary = world.raycast_con_piezas(q, Vector3.DOWN, 6.0)
			var pr := PhysicsRayQueryParameters3D.create(q, q + Vector3.DOWN * 6.0)
			pr.exclude = [player.get_rid()]
			var rf: Dictionary = esp.intersect_ray(pr)
			if bool(rv.get("pieza", false)) and not rf.is_empty():
				var dv: float = (rv["position"] as Vector3).y
				var df: float = (rf["position"] as Vector3).y
				difs.append(df - dv)
				linea += "%+5.0f" % ((df - dv) * 100.0)
			else:
				linea += "    ."
		print("[mesapisa] colision - dibujo (cm):" + linea)
	var suma := 0.0
	for d in difs:
		suma += absf(float(d))
	print("[mesapisa] %d puntos sobre el bloque, diferencia media %.1f cm" % [difs.size(), suma / maxf(1.0, difs.size()) * 100.0])
	# y el jugador encima: donde quedan sus pies frente a lo que se ve y a lo que se pisa
	player.global_position = c + Vector3.UP * 1.2
	player.velocity = Vector3.ZERO
	await get_tree().create_timer(2.5).timeout
	var pp: Vector3 = player.global_position
	var rv2: Dictionary = world.raycast_con_piezas(pp + Vector3.UP * 1.0, Vector3.DOWN, 3.0)
	var pr2 := PhysicsRayQueryParameters3D.create(pp + Vector3.UP * 1.0, pp + Vector3.DOWN * 2.0)
	pr2.exclude = [player.get_rid()]
	var rf2: Dictionary = esp.intersect_ray(pr2)
	var n: Vector3 = rf2.get("normal", Vector3.UP)
	print("[mesapisa] jugador encima: en el suelo %s, pendiente %.0f grados; pies - dibujo bajo el centro %+.1f cm, pies - colision %+.1f cm" % [
		str(player.is_on_floor()), rad_to_deg(n.angle_to(Vector3.UP)),
		(pp.y - (rv2["position"] as Vector3).y) * 100.0 if bool(rv2.get("hit", false)) else 999.0,
		(pp.y - (rf2["position"] as Vector3).y) * 100.0 if not rf2.is_empty() else 999.0])
	get_tree().quit()


## --manosfoto: las manos con el arma 1 y la 2 en primera persona, y de cerca en tercera -> user://manos_*.png
## --agarrefoto: COMO SE AGARRA CADA ARMA (metralleta, escopeta, pistola), sin apuntar y apuntando, en primera persona
## y en tercera (desde un lado y desde delante). -> user://agarre_<arma>_<vista>.png
func _agarre_foto() -> void:
	await get_tree().create_timer(7.0).timeout
	player.invulnerable = true
	for e in enemies.get_children():
		e.queue_free()
	var armas := ["smg_compacta", "escopeta_auto", "pistola_9"]
	for id in armas:
		Weapons.LIST[1] = Weapons.get_def(id).duplicate()
		player.refresh_ammo_slots()
		player.set_third_person(false)
		player.switch_weapon(0)
		await get_tree().create_timer(0.6).timeout
		player.switch_weapon(1)
		await get_tree().create_timer(1.0).timeout
		for apunta in [false, true]:
			if apunta:
				Input.action_press("aim")
			else:
				Input.action_release("aim")
			await get_tree().create_timer(0.8).timeout
			await RenderingServer.frame_post_draw
			get_viewport().get_texture().get_image().save_png("user://agarre_%s_fp%s.png" % [id, "_apunta" if apunta else ""])
		Input.action_release("aim")
		player.set_third_person(true)
		var cam := Camera3D.new()
		add_child(cam)
		cam.fov = 40.0
		cam.current = true
		var b: Basis = player.global_transform.basis
		var fr: Vector3 = -b.z
		fr.y = 0.0
		fr = fr.normalized()
		var der := fr.cross(Vector3.UP)
		for apunta in [false, true]:
			if apunta:
				Input.action_press("aim")
			else:
				Input.action_release("aim")
			await get_tree().create_timer(0.8).timeout
			var av = player.avatar
			var sk: Skeleton3D = av.skeleton
			var cuello: Vector3 = sk.get_bone_global_pose(av.bone_idx["neck"]).origin
			var hr: Vector3 = sk.get_bone_global_pose(av.bone_idx["hand_r"]).origin
			var hl: Vector3 = sk.get_bone_global_pose(av.bone_idx["hand_l"]).origin
			var gm: Vector3 = av.weapon_root.transform * av.grip_marker.position if av.grip_marker else Vector3.ZERO
			var fm: Vector3 = av.weapon_root.transform * av.fore_marker.position if av.fore_marker else Vector3.ZERO
			print("[agarrefoto] %s apunta %s · kind %s una_mano %s aim_ef %.2f look_pitch %.2f · escala %.3f · arma-cuello %s · mano_d->empuñadura %.1f · mano_i->guardamanos %.1f (voxels)" % [
				id, str(apunta), String(av.weapon_kind), str(av._one_hand), float(av._dbg_aim_ef), float(av.look_pitch), av.scale.x,
				str((av.weapon_root.transform.origin - cuello).snapped(Vector3.ONE * 0.1)), hr.distance_to(gm), hl.distance_to(fm)])
			for vista in ["lado", "frente"]:
				if vista == "lado":
					cam.global_position = player.global_position + der * 1.6 + fr * 0.3 + Vector3.UP * 1.45
				else:
					cam.global_position = player.global_position + fr * 1.7 + der * 0.45 + Vector3.UP * 1.5
				cam.look_at(player.global_position + Vector3.UP * 1.3 + fr * 0.25)
				await get_tree().process_frame
				await RenderingServer.frame_post_draw
				get_viewport().get_texture().get_image().save_png("user://agarre_%s_tp_%s%s.png" % [id, vista, "_apunta" if apunta else ""])
		Input.action_release("aim")
		cam.queue_free()
		print("[agarrefoto] ", id)
	get_tree().quit()


## --pechofoto=<carpeta>: EL ARMA METIDA EN EL PECHO al encarar (2026-09-30, pedido: "cuando disparo el personaje lleva el
## arma al pecho y se le mete dentro"). En tercera persona, por skin (Original, Puño de Oro, Golpe de Cristal) y arma
## (carabina, escopeta, subfusil, pistola): apuntando (al frente, 35 grados arriba y abajo) y disparando desde la cadera.
## Mide cuanto se mete el arma en el torso (_medir_pecho) y a cuanto quedan las manos de sus agarres, y saca fotos de lado
## y de 3/4 disparando a <carpeta>. Lleva "foto" en el nombre: no guarda los ajustes (la skin es solo de esta partida).
func _pecho_foto(carpeta: String) -> void:
	DirAccess.make_dir_recursive_absolute(carpeta)
	await get_tree().create_timer(7.0).timeout
	player.invulnerable = true
	player.set("municion_infinita", true)
	for e in enemies.get_children():
		e.queue_free()
	var skins := ["Original", "Puño de Oro", "Golpe de Cristal"]
	var armas := ["carabina_556", "escopeta_bomba", "smg_9mm", "pistola_9"]
	# --pechoskins=0,2 / --pechoarmas=carabina_556,pistola_9: solo esas (para iterar rapido)
	for a in OS.get_cmdline_user_args():
		if String(a).begins_with("--pechoskins="):
			var sel: Array = []
			for i in String(a).substr(13).split(","):
				sel.append(skins[int(i)])
			skins = sel
		elif String(a).begins_with("--pechoarmas="):
			armas = Array(String(a).substr(13).split(","))
	var cam := Camera3D.new()
	add_child(cam)
	cam.fov = 30.0
	var resumen: Array = []
	for sk_n in skins:
		_hab_poner_skin(sk_n)
		await get_tree().create_timer(0.4).timeout
		var torso: Array = _torso_reposo(player.avatar)
		AvatarScript._perfiles.erase(player.avatar.mesh_inst.mesh.get_instance_id())   # (para medir lo que cuesta)
		var t_perfil := Time.get_ticks_usec()
		var perfil: Array = AvatarScript._perfil_cuerpo(player.avatar.mesh_inst.mesh)
		print("[pechofoto] %s: perfil del cuerpo en %.1f ms (%d grupos, %d triangulos del torso)" % [
			sk_n, (Time.get_ticks_usec() - t_perfil) / 1000.0, perfil.size(), torso.size()])
		for id in armas:
			Weapons.LIST[1] = Weapons.get_def(id).duplicate()
			player.refresh_ammo_slots()
			player.switch_weapon(0)
			await get_tree().create_timer(0.5).timeout
			player.switch_weapon(1)
			await get_tree().create_timer(1.2).timeout
			# DESPUES del cambio de arma: el muñeco del jugador se hace con `shadows_only` y equip_weapon deja el arma nueva
			# como sombra; la tercera persona la vuelve visible (set_body_visible)
			player.set_third_person(true)
			await get_tree().create_timer(0.2).timeout
			AvatarScript._puntos_cache.clear()   # (para medir lo que cuesta)
			var t_pts := Time.get_ticks_usec()
			var n_pts: int = player.avatar._puntos_arma().size()
			print("[pechofoto] %s: %d puntos del arma en %.1f ms" % [id, n_pts, (Time.get_ticks_usec() - t_pts) / 1000.0])
			for estado in ["apunta", "apunta_arriba", "apunta_abajo", "dispara"]:
				var pitch := 35.0 if estado == "apunta_arriba" else (-35.0 if estado == "apunta_abajo" else 0.0)
				var peor := {}
				if estado == "dispara":
					Input.action_release("aim")
				else:
					Input.action_press("aim")
				# 1,2 s en el estado; en "dispara" se aprieta y se suelta cada 0,1 s (las semiautomaticas tiran una vez por
				# pulsacion) y se mide mientras dura la rafaga: lo peor de cinco muestras
				for i in 12:
					player.look.y = deg_to_rad(pitch)
					if estado == "dispara":
						if i % 2 == 0:
							Input.action_press("fire")
						else:
							Input.action_release("fire")
					await get_tree().create_timer(0.1).timeout
					if i >= 7:
						await get_tree().process_frame
						var m: Dictionary = _medir_pecho(player.avatar, torso)
						# disparando solo cuenta con el arma encarada (la escopeta de bombeo, entre tiro y tiro, vuelve a la
						# pose de llevarla, que es otra cosa)
						if float(m["aim_ef"]) < 0.9 and not peor.is_empty():
							continue
						if peor.is_empty() or float(m["holgura"]) < float(peor["holgura"]) or float(peor["aim_ef"]) < 0.9:
							peor = m
				if estado == "dispara" or estado == "apunta":
					if estado == "dispara":
						Input.action_press("fire")
					player.look.y = 0.0
					await get_tree().create_timer(0.15).timeout
					var b: Basis = player.global_transform.basis
					var fr: Vector3 = -b.z
					fr.y = 0.0
					fr = fr.normalized()
					var der := fr.cross(Vector3.UP)
					var centro: Vector3 = player.global_position + Vector3.UP * 1.2 + fr * 0.2
					hud.visible = false
					# "lado_arma": la misma de lado sin el cuerpo, para ver donde queda el arma (los antebrazos la tapan)
					for vista in (["lado", "lado_arma", "tres_cuartos", "arriba"] if estado == "apunta" else ["lado"]):
						player.look.y = 0.0
						if vista.begins_with("lado"):
							cam.global_position = centro + der * 2.0
						elif vista == "tres_cuartos":
							cam.global_position = centro + der * 1.45 + fr * 1.45 + Vector3.UP * 0.3
						else:
							cam.global_position = centro + Vector3.UP * 1.3 + fr * 0.9 + der * 0.25
						cam.look_at(centro)
						cam.current = true
						player.avatar.mesh_inst.visible = vista != "lado_arma"
						await get_tree().process_frame
						await RenderingServer.frame_post_draw
						get_viewport().get_texture().get_image().save_png(carpeta.path_join("pecho_%d_%s_%s_%s.png" % [
							["Original", "Puño de Oro", "Golpe de Cristal"].find(sk_n), id, estado, vista]))
					player.avatar.mesh_inst.visible = true
					hud.visible = true
					Input.action_release("fire")
				Input.action_release("aim")
				var linea := "[pechofoto] %-16s %-15s %-13s holgura %+6.1f cm (%s) · dentro %d/%d vertices · mano_gatillo->empuñadura %.1f cm · mano_apoyo->arma %.1f cm (a %.0f%% del guardamanos) · despeje %.1f cm · aim_ef %.2f" % [
					sk_n, id, estado, float(peor["holgura"]), String(peor["hueso"]), int(peor["dentro"]), int(peor["puntos"]),
					float(peor["mano_d"]), float(peor["mano_i"]), float(peor["tramo"]) * 100.0, float(peor["despeje"]), float(peor["aim_ef"])]
				print(linea)
				resumen.append(linea)
			cam.current = false
	print("[pechofoto] RESUMEN")
	for l in resumen:
		print(l)
	get_tree().quit()


## Los triangulos del TORSO de un muñeco EN REPOSO (todo menos brazos, manos y piernas): [hueso, a, b, c, normal], en el
## espacio del esqueleto (voxels). La malla es skinnada con un hueso por vertice.
func _torso_reposo(av) -> Array:
	var out: Array = []
	var sk: Skeleton3D = av.skeleton
	var mi: MeshInstance3D = av.mesh_inst
	if mi == null or mi.mesh == null:
		return out
	var xf: Transform3D = mi.transform
	for srf in mi.mesh.get_surface_count():
		var arr: Array = mi.mesh.surface_get_arrays(srf)
		var v: PackedVector3Array = arr[Mesh.ARRAY_VERTEX]
		var nn: PackedVector3Array = arr[Mesh.ARRAY_NORMAL]
		var bo: PackedInt32Array = arr[Mesh.ARRAY_BONES]
		var idx: PackedInt32Array = arr[Mesh.ARRAY_INDEX] if arr[Mesh.ARRAY_INDEX] != null else PackedInt32Array()
		var con_idx := idx.size() > 0
		var ntri: int = (idx.size() if con_idx else v.size()) / 3
		for t in ntri:
			var i0: int = idx[t * 3] if con_idx else t * 3
			var i1: int = idx[t * 3 + 1] if con_idx else t * 3 + 1
			var i2: int = idx[t * 3 + 2] if con_idx else t * 3 + 2
			var b: int = bo[i0 * 4]
			var nombre := String(sk.get_bone_name(b))
			if nombre.begins_with("arm_") or nombre.begins_with("hand_") or nombre.begins_with("leg_") \
					or nombre.begins_with("foot_") or nombre.begins_with("toes_"):
				continue
			out.append([b, xf * v[i0], xf * v[i1], xf * v[i2], (xf.basis * nn[i0]).normalized()])
	return out


## CUANTO SE METE EL ARMA EN EL TORSO. Desde cada vertice del arma sale un rayo hacia delante (-Z del esqueleto) contra el
## torso ya posado: si sale por mas caras de las que entra, el punto esta DENTRO y lo que se mete es la distancia hasta la
## ultima salida (lo que habria que adelantar el arma). Si ningun punto esta dentro, la holgura es lo que queda del punto
## mas cercano del arma a la cara de delante del torso (rayo hacia atras). Devuelve (cm) {holgura: + delante / - dentro,
## hueso, dentro, puntos, mano_d, mano_i}.
func _medir_pecho(av, torso: Array) -> Dictionary:
	var sk: Skeleton3D = av.skeleton
	var s: float = av.scale.x
	var mats := {}
	var celdas := {}
	var tris: Array = []
	for t in torso:
		var b: int = t[0]
		if not mats.has(b):
			mats[b] = sk.get_bone_global_pose(b) * sk.get_bone_global_rest(b).affine_inverse()
		var m: Transform3D = mats[b]
		var a: Vector3 = m * (t[1] as Vector3)
		var bb: Vector3 = m * (t[2] as Vector3)
		var c: Vector3 = m * (t[3] as Vector3)
		var k := tris.size()
		tris.append([a, bb, c, (m.basis * (t[4] as Vector3)).normalized(), b])
		for x in range(int(floor(minf(a.x, minf(bb.x, c.x)))), int(floor(maxf(a.x, maxf(bb.x, c.x)))) + 1):
			for y in range(int(floor(minf(a.y, minf(bb.y, c.y)))), int(floor(maxf(a.y, maxf(bb.y, c.y)))) + 1):
				var key := Vector2i(x, y)
				if celdas.has(key):
					(celdas[key] as Array).append(k)
				else:
					celdas[key] = [k]
	var inv: Transform3D = sk.global_transform.affine_inverse()
	var dir := Vector3(0, 0, -1)
	var pen := 0.0
	var hueco := INF
	var hueso := ""
	var dentro := 0
	var puntos := 0
	if av._wm:
		for nodo in (av._wm as Node).find_children("*", "MeshInstance3D", true, false):
			var mm := nodo as MeshInstance3D
			if mm.mesh == null or not mm.is_visible_in_tree():
				continue
			var xf: Transform3D = inv * mm.global_transform
			for srf in mm.mesh.get_surface_count():
				var vv: PackedVector3Array = mm.mesh.surface_get_arrays(srf)[Mesh.ARRAY_VERTEX]
				for p0 in vv:
					var p: Vector3 = xf * p0
					puntos += 1
					var key := Vector2i(int(floor(p.x)), int(floor(p.y)))
					if not celdas.has(key):
						continue
					var giro := 0
					var lejos := 0.0
					var lejos_b := -1
					var atras := INF
					var atras_b := -1
					for k in celdas[key]:
						var tr: Array = tris[k]
						var h = Geometry3D.ray_intersects_triangle(p, dir, tr[0], tr[1], tr[2])
						if h != null:
							var d: float = p.z - (h as Vector3).z
							giro += 1 if (tr[3] as Vector3).dot(dir) > 0.0 else -1
							if d > lejos:
								lejos = d
								lejos_b = tr[4]
						var h2 = Geometry3D.ray_intersects_triangle(p, -dir, tr[0], tr[1], tr[2])
						if h2 != null:
							var d2: float = (h2 as Vector3).z - p.z
							if d2 < atras:
								atras = d2
								atras_b = tr[4]
					if giro > 0:
						dentro += 1
						if lejos > pen:
							pen = lejos
							hueso = String(sk.get_bone_name(lejos_b))
					elif atras < hueco:
						hueco = atras
						if pen <= 0.0:
							hueso = String(sk.get_bone_name(atras_b))
	var holgura: float = -pen * s * 100.0 if pen > 0.0 else (hueco * s * 100.0 if hueco < INF else 99.0)
	var wt: Transform3D = av.weapon_root.transform
	var g: Vector3 = wt * av.grip_marker.position
	var f: Vector3 = wt * (av.grip_marker.position + AvatarScript.PISTOLA_APOYO / s) if av._one_hand else wt * av.fore_marker.position
	var mg: String = "hand_l" if av._swap_hands else "hand_r"
	var ma: String = "hand_r" if av._swap_hands else "hand_l"
	# la mano de apoyo: a cuanto queda de la LINEA empuñadura -> guardamanos (se desliza por ella si no llega) y en que
	# punto de ella (100 % = en el guardamanos)
	var hi: Vector3 = sk.get_bone_global_pose(av.bone_idx[ma]).origin
	var tramo := 1.0
	var sobre: Vector3 = f
	if not av._one_hand and g.distance_to(f) > 0.001:
		tramo = clampf((hi - g).dot(f - g) / (f - g).length_squared(), 0.0, 1.0)
		sobre = g + (f - g) * tramo
	return {"holgura": holgura, "hueso": hueso, "dentro": dentro, "puntos": puntos,
		"mano_d": sk.get_bone_global_pose(av.bone_idx[mg]).origin.distance_to(g) * s * 100.0,
		"mano_i": hi.distance_to(sobre) * s * 100.0, "tramo": tramo, "aim_ef": float(av._dbg_aim_ef),
		"despeje": float(av.get("_despeje") if av.get("_despeje") != null else 0.0) * float(av.get("_dbg_aim_ef")) * s * 100.0}


func _manos_foto() -> void:
	await get_tree().create_timer(7.0).timeout
	for i in 2:
		player.switch_weapon(i)
		await get_tree().create_timer(1.2).timeout
		await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("user://manos_fp_%d.png" % (i + 1))
	player.set_third_person(true)
	var c := Camera3D.new()
	add_child(c)
	var b: Basis = player.global_transform.basis
	var fr: Vector3 = -b.z
	fr.y = 0.0
	fr = fr.normalized()
	c.global_position = player.global_position + fr * 1.1 + fr.cross(Vector3.UP) * 0.5 + Vector3.UP * 1.3
	c.look_at(player.global_position + Vector3.UP * 1.05)
	c.fov = 45.0
	c.current = true
	for i in 2:
		player.switch_weapon(i)
		await get_tree().create_timer(1.2).timeout
		await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("user://manos_tp_%d.png" % (i + 1))
	get_tree().quit()


## --granadafoto: EL GESTO DE LANZAR, fotograma a fotograma. A camara lenta (x0,08) se tira una granada y se sacan
## fotos en primera persona y luego, con otra camara delante del jugador, en tercera (lo que ven los demas).
## -> user://granada_fp_<t>.png y user://granada_tp_<t>.png
func _granada_foto() -> void:
	await get_tree().create_timer(7.0).timeout
	for pasada in 2:
		var tp := pasada == 1
		var cam_tp: Camera3D = null
		if tp:
			player.set_third_person(true)
			cam_tp = Camera3D.new()
			add_child(cam_tp)
			var yaw: Basis = player.global_transform.basis
			var fr: Vector3 = -yaw.z
			fr.y = 0.0
			fr = fr.normalized()
			var der := fr.cross(Vector3.UP)
			cam_tp.global_position = player.global_position + fr * 1.7 + der * 0.8 + Vector3.UP * 1.45
			cam_tp.look_at(player.global_position + Vector3.UP * 1.15)
			cam_tp.fov = 50.0
			cam_tp.current = true
		player.grenades = 9
		player.grenade_cd = 0.0
		await get_tree().create_timer(0.5).timeout
		Engine.time_scale = 0.08
		player.throw_grenade()
		for t in [0.12, 0.22, 0.28, 0.34, 0.42, 0.48, 0.54, 0.64]:
			while float(player.get("_lanz_t")) < float(t) and float(player.get("_lanz_t")) >= 0.0:
				await get_tree().process_frame
			await RenderingServer.frame_post_draw
			var ruta := "user://granada_%s_%02d.png" % ["tp" if tp else "fp", int(t * 100.0)]
			get_viewport().get_texture().get_image().save_png(ruta)
			print("[granadafoto] t=%.2f (reloj %.2f) -> %s" % [t, float(player.get("_lanz_t")), ProjectSettings.globalize_path(ruta)])
			# que no reviente al lado y tumbe al de la foto siguiente
			for g in get_children():
				if g is RigidBody3D and g.get("fuse") != null:
					g.fuse = 100.0
		Engine.time_scale = 1.0
		await get_tree().create_timer(1.5).timeout
		if cam_tp:
			cam_tp.queue_free()
			player.set_third_person(false)
	get_tree().quit()


## --granadatest: ¿ATRAVIESA LA GRANADA UNA PARED FINA? Se levanta una tabla de madera de un voxel delante del jugador
## y se le tiran 24 granadas (sin mecha: no revientan) de 12 a 30 m/s. A los 1,5 s se mira de que lado quedaron.
## --sinbarrido quita el arreglo (grenade.gd) para comparar.
func _granada_test() -> void:
	await get_tree().create_timer(7.0).timeout
	var vs: float = world.get_voxel_size()
	var p: Vector3 = player.global_position
	var x_pared := p.x + 4.0
	var suelo := p.y - 0.2
	var o := Vector3i(int(floor(x_pared / vs)), int(floor(suelo / vs)), int(floor((p.z - 3.0) / vs)))
	var tam := Vector3i(1, int(3.5 / vs), int(6.0 / vs))
	var mats := PackedByteArray()
	mats.resize(tam.x * tam.y * tam.z)
	mats.fill(6)                                    # madera (vx::MAT_WOOD)
	world.place_settled(o, tam, mats)
	await get_tree().create_timer(1.0).timeout
	var sin := "--sinbarrido" in OS.get_cmdline_user_args()
	var cara := float(o.x) * vs
	var cuenta := [0, 0]      # [cruzan, total] (en un Array: una lambda copia los enteros, no los comparte)
	var escena := preload("res://scenes/grenade.tscn")
	for i in 24:
		var g := escena.instantiate()
		add_child(g)
		g.global_position = Vector3(p.x + 1.0, p.y + 1.2 + (i % 3) * 0.4, p.z - 1.5 + (i % 4) * 1.0)
		var vel := Vector3(12.0 + (i % 7) * 3.0, -1.0 + (i % 5) * 0.8, 0.0)
		g.setup(world, vel)
		g.fuse = 100.0
		if sin:
			g.continuous_cd = false
			g.set_physics_process(false)
		await get_tree().create_timer(0.1).timeout
		get_tree().create_timer(1.5).timeout.connect(func():
			cuenta[1] += 1
			if is_instance_valid(g):
				if g.global_position.x > cara + vs:
					cuenta[0] += 1
				g.queue_free())
	await get_tree().create_timer(2.5).timeout
	print("[granadatest] %s: %d de %d granadas atravesaron la tabla de %.0f cm" % ["SIN arreglo" if sin else "con arreglo", cuenta[0], cuenta[1], vs * 100.0])
	get_tree().quit()


## --FISICA30: la fisica a 30 pasos por segundo (la mitad de trabajo para Jolt) con interpolacion, para que todo se
## vea suave: los nodos (jugador, bots, criaturas) con la de Godot y los bloques con la de la extension, que ademas
## les pone deteccion continua de choques y un tope de velocidad para que no atraviesen nada. En red da igual lo
## que lleve cada uno: la destruccion viaja por golpes y las posturas finales las manda el anfitrion.
func _fisica30() -> void:
	if not ("--fisica30" in OS.get_cmdline_user_args()):
		return
	Engine.physics_ticks_per_second = 30
	get_tree().physics_interpolation = true
	if world and world.has_method("set_interpolar"):
		world.set_interpolar(true)
	print("[fisica30] fisica a 30 Hz con interpolacion, deteccion continua y tope de velocidad")


## --resumenfoto=ruta.png: EL RESUMEN DE MUERTE (muerte_resumen.gd). Un bot enemigo delante te "mata", se
## saca la captura a mitad del panel y se comprueba que a los 5 s se vuelve a jugar.
## LA PARTIDA TAL COMO VA EN UN REPORTE (opciones_jugador.gd -> POST /reporte): mapa, modo, la sala y una CLAVE que
## es la misma en todas las maquinas de la partida (el nombre de la sala y la semilla que reparte el anfitrion): con
## ella el servidor deja un solo reporte por jugador y partida. Sin red, la hora de empezar.
var _t_inicio_unix := int(Time.get_unix_time_from_system())

func info_partida_reporte() -> Dictionary:
	var modo := "libre"
	if bomb_mode:
		modo = "bomba"
	elif dm_mode:
		modo = "dm"
	elif heist != null:
		modo = "atraco"
	elif pve != null:
		modo = "zombis"
	elif current_map == "isla":
		modo = "br"
	var clave := ("%s#%d" % [Net.room_name, Net.semilla_partida]) if Net.is_online() else ("local#%s#%d" % [current_map, _t_inicio_unix])
	return {"clave": clave, "mapa": current_map, "modo": modo, "sala": Salas.id_sala() if Net.hosting else "",
		"sala_nombre": Net.room_name}


## LOS CINCO MEJORES DE LA PARTIDA para mejores_jugadores.gd: puntos por bajas y muertes, con el aspecto y el
## arma de cada uno (el tuyo, el de la copia de cada persona o el del bot).
func _mejores_jugadores(filas: Array) -> Array:
	var lista: Array = []
	for f in filas:
		var nombre := String(f["nombre"])
		var P := preload("res://scripts/puntuacion.gd")
		# LOS PUNTOS DE VERDAD: los que se han ido sumando en la partida (puntuacion.gd). Las bajas y muertes, de la
		# tabla del duelo (la del anfitrion)
		var pts: int = int(f["puntos"]) if f.has("puntos") else (P.puntos(nombre) if P.tabla.has(nombre) else int(f["bajas"]) * P.BAJA)
		var j := {"nombre": nombre, "es_yo": bool(f["es_yo"]), "equipo": String(f["equipo"]),
			"puntos": pts, "bajas": int(f["bajas"]), "muertes": int(f["muertes"]), "tipo": "JUGADOR"}
		# CON QUE CUENTA JUEGA (Net.cuenta_de): para ENVIAR SOLICITUD y REPORTAR desde las dos rayitas; y su rango
		j["cuenta"] = Net.cuenta_de(nombre)
		if int((j["cuenta"] as Dictionary).get("nivel", 0)) > 0:
			j["nivel"] = int(j["cuenta"]["nivel"])
			j["tipo"] = preload("res://scripts/mejores_jugadores.gd").rango(int(j["nivel"]))
		var nodo: Node = null
		if bool(f["es_yo"]):
			nodo = player
			j["nivel"] = Cuenta.nivel()
			j["tipo"] = preload("res://scripts/mejores_jugadores.gd").rango(Settings.nivel())
		else:
			for r in Net.remotes.values():
				if is_instance_valid(r) and String(r.get("player_name")) == nombre:
					nodo = r
			if nodo == null and enemies != null:
				for e in enemies.get_children():
					if is_instance_valid(e) and String(e.get("nombre_marcador")) == nombre:
						nodo = e
						j["tipo"] = "BOT"
		if nodo != null and is_instance_valid(nodo) and nodo.get("avatar") != null and is_instance_valid(nodo.get("avatar")):
			var av = nodo.get("avatar")
			j["aspecto"] = av.build_args
			j["arma"] = [String(av.weapon_kind), String(av._arma_id)]
		lista.append(j)
	lista.sort_custom(func(a, b): return int(a["puntos"]) > int(b["puntos"]) \
		or (int(a["puntos"]) == int(b["puntos"]) and int(a["muertes"]) < int(b["muertes"])))
	lista = lista.slice(0, 5)
	_titulos_de_verdad(lista)
	return lista


## LOS TITULOS SE GANAN, Y SALEN DE LO QUE HA PASADO EN LA PARTIDA (puntuacion.gd: rachas, bajas seguidas, tiros a
## la cabeza, venganzas, primera sangre...). El primero en puntos es el MVP; los demas se reparten de los mas raros
## a los mas comunes, cada uno al que mejor lo cumple, y nadie lleva dos. Si alguien no cumple ninguno, SOLDADO FIEL.
## La frase lleva el dato de verdad. Asi en cada partida salen titulos distintos.
func _titulos_de_verdad(lista: Array) -> void:
	var P := preload("res://scripts/puntuacion.gd")
	var libres: Array = lista.duplicate()
	for j in lista:
		j["st"] = P.de(String(j["nombre"]))
	var poner := func(j: Dictionary, t: String, frase: String, col: Color) -> void:
		j["titulo"] = t
		j["frase"] = frase
		j["color_titulo"] = col
		libres.erase(j)
	if not lista.is_empty() and int(lista[0]["puntos"]) > 0:
		lista[0]["mvp"] = true
		poner.call(lista[0], "MVP", "Jugador más valioso", Color(1.0, 0.86, 0.35))
	var ganador := ""
	if int(dm_bajas.get("t", 0)) != int(dm_bajas.get("ct", 0)):
		ganador = Net.TEAM_T if int(dm_bajas["t"]) > int(dm_bajas["ct"]) else Net.TEAM_CT
	var plural := func(n: int, s1: String, s2: String) -> String:
		return "%d %s" % [n, s1 if n == 1 else s2]
	var ratio := func(j) -> float:
		return float(j["bajas"]) / maxf(1.0, float(j["muertes"]))
	# [titulo, color, valor(j) (0 = no lo cumple; mas = lo cumple mejor), frase(j)]
	var reglas: Array = [
		["ULTRAELIMINADOR", Color(0.4, 0.8, 1.0), func(j): return int(j["st"]["seguidas_max"]) if int(j["st"]["seguidas_max"]) >= 5 else 0,
			func(j): return "Cinco o más bajas seguidas (%d)" % int(j["st"]["seguidas_max"])],
		["ELIMINACIÓN BESTIAL", Color(1.0, 0.45, 0.3), func(j): return int(j["st"]["racha_max"]) if int(j["st"]["racha_max"]) >= 8 else 0,
			func(j): return "Racha de %d bajas sin morir" % int(j["st"]["racha_max"])],
		["IMPARABLE", Color(1.0, 0.7, 0.2), func(j): return int(j["st"]["racha_max"]) if int(j["st"]["racha_max"]) >= 5 else 0,
			func(j): return "%d bajas sin caer ni una vez" % int(j["st"]["racha_max"])],
		["CAZADOR DE CABEZAS", Color(1.0, 0.55, 0.55), func(j): return int(j["st"]["cabezas"]) if int(j["st"]["cabezas"]) >= 2 else 0,
			func(j): return "%s a la cabeza" % plural.call(int(j["st"]["cabezas"]), "tiro", "tiros")],
		["TRIPLE AMENAZA", Color(0.5, 0.95, 0.7), func(j): return int(j["st"]["seguidas_max"]) if int(j["st"]["seguidas_max"]) >= 3 else 0,
			func(j): return "Encadenó %d bajas de golpe" % int(j["st"]["seguidas_max"])],
		["INTOCABLE", Color(0.7, 0.9, 1.0), func(j): return int(j["bajas"]) + 1 if int(j["muertes"]) == 0 and int(j["bajas"]) > 0 else 0,
			func(j): return "No murió ni una vez"],
		["VENGADOR", Color(0.95, 0.4, 0.5), func(j): return int(j["st"]["venganzas"]),
			func(j): return "Se vengó %s" % plural.call(int(j["st"]["venganzas"]), "vez", "veces")],
		["PRIMERA SANGRE", Color(1.0, 0.35, 0.35), func(j): return 1 if bool(j["st"]["primera"]) else 0,
			func(j): return "Abrió la partida con la primera baja"],
		["MÁQUINA DE BAJAS", Color(1.0, 0.5, 0.35), func(j): return int(j["bajas"]) if int(j["bajas"]) >= 5 else 0,
			func(j): return "%d bajas en la partida" % int(j["bajas"])],
		["REY DEL DOBLETE", Color(0.75, 0.6, 1.0), func(j): return int(j["st"]["dobles"]) if int(j["st"]["dobles"]) >= 2 else 0,
			func(j): return "%d dobles eliminaciones" % int(j["st"]["dobles"])],
		["BASTIÓN DE ACERO", Color(0.55, 0.85, 1.0), func(j): return 10 - int(j["muertes"]) if int(j["muertes"]) <= 3 else 0,
			func(j): return "Solo %s en toda la partida" % plural.call(int(j["muertes"]), "muerte", "muertes")],
		["AS DE LO OCULTO", Color(1.0, 0.62, 0.3), func(j): return ratio.call(j) if ratio.call(j) >= 1.5 else 0,
			func(j): return "Desde las sombras: %.1f bajas por muerte" % ratio.call(j)],
		["SIN MIEDO", Color(1.0, 0.72, 0.4), func(j): return int(j["muertes"]) if int(j["muertes"]) >= 6 else 0,
			func(j): return "Siempre al frente: %s" % plural.call(int(j["muertes"]), "caída", "caídas")],
		["ASISTENTE DE ORO", Color(1.0, 0.62, 0.3), func(j): return 1 if lista.size() > 1 and j == lista[1] else 0,
			func(j): return "Irremplazable segundo al mando del éxito"],
		["TALISMÁN DE SUERTE", Color(1.0, 0.6, 0.4), func(j): return 1 if ganador != "" and String(j["equipo"]) == ganador else 0,
			func(j): return "Trajo suerte a todo el equipo"],
	]
	for r in reglas:
		var mejor = null
		var mv := 0.0
		for j in libres:
			var v := float((r[2] as Callable).call(j))
			if v > mv:
				mv = v
				mejor = j
		if mejor != null:
			poner.call(mejor, String(r[0]), String((r[3] as Callable).call(mejor)), r[1])
	for j in libres.duplicate():
		poner.call(j, "SOLDADO FIEL", "Siempre en primera línea", Color(0.8, 0.78, 1.0))


## --finfoto=ruta.png: la entrada del final (fin_intro.gd), a 1,2 s de empezar (y la de derrota con -derrota)
## Con -zombi, las cuatro con el tema zombi (oleadas y campaña); con -atraco, la tabla de tres equipos.
func _fin_foto(ruta: String) -> void:
	await get_tree().create_timer(10.0).timeout
	var gane: bool = not ("-derrota" in ruta)
	var tema := "zombi" if "-zombi" in ruta else ""
	hud.visible = false
	if "-victoria" in ruta:
		hud.visible = true
		var nombres: Array = [_mi_nombre()]
		for e in enemies.get_children():
			if String(e.get("nombre_marcador")) != "":
				nombres.append(String(e.nombre_marcador))
		for i in 40:
			var a: String = nombres[randi() % nombres.size()]
			var v: String = nombres[randi() % nombres.size()]
			if a != v:
				Net.net_baja(a, "", "rifle", "", v, "")
		var P := preload("res://scripts/puntuacion.gd")
		var fv: Array = []
		for n in nombres:
			var eq: String = Net.my_team() if n == _mi_nombre() else ""
			for e in enemies.get_children():
				if String(e.get("nombre_marcador")) == n:
					eq = String(e.team)
			fv.append({"nombre": n, "equipo": eq, "bajas": P.bajas(n), "muertes": P.muertes(n), "es_yo": n == _mi_nombre()})
		preload("res://scripts/mejores_jugadores.gd").likes_partida = {}
		if tema == "zombi":
			for f in fv:
				f["equipo"] = Net.my_team()
			hud.mostrar_victoria_final(gane, [214, 0], fv, {"exp": 1230, "oro": 95}, "zombi", "",
				[{"equipo": Net.my_team(), "nombre": "SUPERVIVIENTES", "tanteo": 214, "claro": Color(0.34, 0.44, 0.32), "oscuro": Color(0.2, 0.28, 0.19)}])
		elif "-atraco" in ruta:
			var eqs := [Net.TEAM_T, Net.TEAM_CT, "v"]
			for i in fv.size():
				fv[i]["equipo"] = Net.my_team() if bool(fv[i]["es_yo"]) else eqs[i % 3]
			hud.mostrar_victoria_final(gane, [2400, 3000], fv, {"exp": 1230, "oro": 95}, "", "", [
				{"equipo": Net.my_team(), "nombre": "TU EQUIPO", "tanteo": 2400, "claro": Color(0.22, 0.52, 0.92), "oscuro": Color(0.15, 0.36, 0.64)},
				{"equipo": Net.TEAM_T if Net.my_team() != Net.TEAM_T else Net.TEAM_CT, "nombre": "EQUIPO AMARILLO", "tanteo": 3000, "claro": Color(0.66, 0.56, 0.1), "oscuro": Color(0.46, 0.39, 0.07)},
				{"equipo": "v", "nombre": "EQUIPO VIOLETA", "tanteo": 1100, "claro": Color(0.55, 0.3, 0.85), "oscuro": Color(0.38, 0.2, 0.6)}])
		else:
			hud.mostrar_victoria(Net.my_team(), 20, 18, fv, "", "", {"exp": 1230, "oro": 95})
		await get_tree().create_timer(3.5).timeout
		get_viewport().get_texture().get_image().save_png(ruta)
		print("[finfoto] %s" % ruta)
		get_tree().quit()
		return
	if "-mejores" in ruta:
		var filas_p: Array = []
		var nombres: Array = [_mi_nombre()]
		for e in enemies.get_children():
			if String(e.get("nombre_marcador")) != "":
				nombres.append(String(e.nombre_marcador))
		# una partida de mentira por el registro de bajas: los puntos salen de la cuenta de verdad
		for i in 40:
			var a: String = nombres[randi() % nombres.size()]
			var v: String = nombres[randi() % nombres.size()]
			if a != v:
				Net.net_baja(a, "", "rifle", "", v, "")
		var P := preload("res://scripts/puntuacion.gd")
		for n in nombres:
			var eq_p: String = Net.my_team() if n == _mi_nombre() else ""
			for e in enemies.get_children():
				if String(e.get("nombre_marcador")) == n:
					eq_p = String(e.team)
			filas_p.append({"nombre": n, "equipo": eq_p, "bajas": P.bajas(n),
				"muertes": P.muertes(n), "es_yo": n == _mi_nombre()})
		preload("res://scripts/mejores_jugadores.gd").mostrar(self, _mejores_jugadores(filas_p), tema)
		await get_tree().create_timer(4.0).timeout
		get_viewport().get_texture().get_image().save_png(ruta)
		print("[finfoto] %s" % ruta)
		get_tree().quit()
		return
	if "-nivel" in ruta:
		var LogrosS := preload("res://scripts/logros.gd")
		LogrosS.cuenta = {"eliminacion": 9, "doble": 2, "triple": 1, "nemesis": 1, "asistencia": 3, "primera": 1}
		var lg: Array = LogrosS.lista(true, true)
		if tema == "zombi":
			lg = [{"tipo": "oleadas", "texto": "OLEADAS SUPERADAS", "veces": 10, "exp": 600, "color": Color(0.62, 0.5, 0.36), "emblema": "estrella"},
				{"tipo": "criaturas", "texto": "ZOMBIS ABATIDOS", "veces": 87, "exp": 348, "color": Color(0.62, 0.05, 0.08), "emblema": "calavera"},
				{"tipo": "victoria", "texto": "SUPERVIVIENTE", "veces": 1, "exp": 600, "color": Color(0.72, 0.56, 0.3), "emblema": "corona"},
				{"tipo": "partida", "texto": "PARTIDA COMPLETADA", "veces": 1, "exp": 200, "color": Color(0.3, 0.36, 0.3), "emblema": "estrella"}]
		preload("res://scripts/fin_nivel.gd").mostrar(self, lg, 880, LogrosS.total(lg), _mi_nombre(),
			player.avatar.build_args if player.avatar else [], ["rifle", "carabina_556"], false, tema)
		await get_tree().create_timer(4.5).timeout
		get_viewport().get_texture().get_image().save_png(ruta)
		print("[finfoto] %s" % ruta)
		get_tree().quit()
		return
	if tema == "zombi":
		preload("res://scripts/fin_intro.gd").mostrar(self, gane, 10 if gane else 6, 214, {"tema": "zombi",
			"etiqueta_mia": "OLEADA", "etiqueta_rival": "ZOMBIS ABATIDOS"})
		await get_tree().create_timer(2.6).timeout      # que se vean las gotas
	else:
		preload("res://scripts/fin_intro.gd").mostrar(self, gane, 21 if gane else 17, 20 if gane else 21)
		await get_tree().create_timer(1.2).timeout
	get_viewport().get_texture().get_image().save_png(ruta)
	print("[finfoto] %s" % ruta)
	get_tree().quit()


## --reportefoto=<carpeta>: EL ME GUSTA, LAS DOS RAYITAS Y EL REPORTE de "MEJORES JUGADORES" (opciones_jugador.gd), de
## verdad contra un servidor: hace falta sesion (`--servidor=<url> --tokenprueba=<token>`, que no toca cuenta.cfg) y
## que los cuatro de `--reportenombres=a,b,c,d` (por defecto LuckyGunner,BraveAdv,Miratort0,MAGNO) tengan cuenta alli.
## Cinco tarjetas de mentira con el aspecto de los bots; da y quita me gustas, abre el menu, ENVIA LA SOLICITUD, rellena
## y MANDA EL REPORTE, lo manda otra vez (el servidor dice que ya estaba), la ventana de SIN CUENTA, y al cerrar manda
## los me gusta. Una foto por paso en la carpeta y "[reportefoto] OK/FALLO ..." en la consola.
func _reporte_foto(carpeta: String) -> void:
	await get_tree().create_timer(10.0).timeout
	DirAccess.make_dir_recursive_absolute(carpeta)
	var Op := preload("res://scripts/opciones_jugador.gd")
	for _i in 30:
		if Cuenta.conectado():
			break
		await get_tree().create_timer(0.25).timeout
	print("[reportefoto] sesion: %s (%s)" % [Cuenta.conectado(), Cuenta.nombre()])
	hud.visible = false
	var nombres := ["LuckyGunner", "BraveAdv", "Miratort0", "MAGNO"]
	for a in OS.get_cmdline_user_args():
		if String(a).begins_with("--reportenombres="):
			nombres = String(a).substr(17).split(",")
	var aspectos: Array = []
	for e in enemies.get_children():
		if is_instance_valid(e) and e.get("avatar") != null and is_instance_valid(e.avatar):
			aspectos.append(e.avatar.build_args)
	var yo := _mi_nombre()
	var MJ := preload("res://scripts/mejores_jugadores.gd")
	var filas := [[yo, 530, 14, 3, "MVP", "Jugador más valioso", Color(1.0, 0.86, 0.35), 8],
		[nombres[1], 395, 11, 5, "ASISTENTE DE ORO", "Irremplazable segundo al mando del éxito", Color(1.0, 0.62, 0.3), 12],
		[nombres[2], 245, 7, 6, "BASTIÓN DE ACERO", "Un pilar del equipo en la batalla", Color(0.55, 0.85, 1.0), 6],
		[nombres[0], 190, 6, 9, "AS DE LO OCULTO", "Desde las sombras, dio vuelta el juego", Color(1.0, 0.6, 0.35), 3],
		[nombres[3], 170, 5, 8, "TALISMÁN DE SUERTE", "Trajo suerte a todo el equipo", Color(1.0, 0.6, 0.4), 22]]
	var lista: Array = []
	for i in filas.size():
		var f: Array = filas[i]
		var j := {"nombre": f[0], "es_yo": i == 0, "equipo": "", "puntos": f[1], "bajas": f[2], "muertes": f[3],
			"titulo": f[4], "frase": f[5], "color_titulo": f[6], "nivel": f[7], "tipo": MJ.rango(f[7]), "mvp": i == 0,
			"cuenta": Net.ficha_cuenta_propia() if i == 0 else {"id": "", "nombre": f[0], "nivel": f[7]}}
		if i == 0 and player.avatar:
			j["aspecto"] = player.avatar.build_args
		elif not aspectos.is_empty():
			j["aspecto"] = aspectos[(i - 1) % aspectos.size()]
		lista.append(j)
	var fallos := 0
	var comprobar := func(ok: bool, que: String) -> int:
		print("[reportefoto] %s %s" % ["OK   " if ok else "FALLO", que])
		return 0 if ok else 1
	var mj = MJ.mostrar(self, lista, "")
	mj.info_partida = {"clave": "prueba-%d" % int(Time.get_unix_time_from_system()), "mapa": current_map, "modo": "dm",
		"sala": "", "sala_nombre": "Sala de prueba"}
	await get_tree().create_timer(4.0).timeout
	await _foto_en(carpeta, "1_mejores")
	# ME GUSTA: dar a tres, quitar uno; y dos que llegan de otros (uno a ti)
	mj._dar_like(nombres[1])
	mj._dar_like(nombres[3])
	mj._dar_like(nombres[2])
	mj._dar_like(nombres[2])
	Net._like_red(nombres[3], yo, true)
	Net._like_red(nombres[0], nombres[3], true)
	await get_tree().create_timer(0.9).timeout
	var cuenta_de := func(n: String) -> int: return int(mj._likes[n][0])
	fallos += comprobar.call(cuenta_de.call(nombres[1]) == 1 and cuenta_de.call(nombres[3]) == 2 and cuenta_de.call(nombres[2]) == 0
		and cuenta_de.call(yo) == 1, "me gusta: dar, quitar y los que llegan (%d %d %d %d)" % [cuenta_de.call(nombres[1]),
		cuenta_de.call(nombres[3]), cuenta_de.call(nombres[2]), cuenta_de.call(yo)])
	await _foto_en(carpeta, "2_likes")
	# LAS DOS RAYITAS del de puesto 4 (el reportado)
	fallos += comprobar.call(not mj._rayas.has(yo) and mj._rayas.has(nombres[0]), "rayitas en los demas y no en la tuya")
	var menu = mj.abrir_opciones(3)
	await get_tree().create_timer(0.12).timeout
	await _foto_en(carpeta, "3a_menu_saliendo")
	await get_tree().create_timer(0.8).timeout
	await _foto_en(carpeta, "3_menu")
	# ENVIAR SOLICITUD, de verdad
	menu.boton_solicitud.pressed.emit()
	var est: Dictionary = mj._estados[nombres[0]]
	for _i in 40:
		if String(est.get("amistad", "")) != "":
			break
		await get_tree().create_timer(0.15).timeout
	await get_tree().create_timer(0.5).timeout
	fallos += comprobar.call(String(est.get("amistad", "")) != "" and mj._rayas[nombres[0]].invitado,
		"solicitud de amistad: %s" % String(est.get("amistad", "(sin respuesta)")))
	await _foto_en(carpeta, "4_invitacion_enviada")
	# REPORTAR: vacio, lleno y enviado
	menu.boton_reportar.pressed.emit()
	await get_tree().create_timer(0.7).timeout
	var inf = Op.ultima
	await _foto_en(carpeta, "5_reporte_vacio")
	fallos += comprobar.call(inf.boton_enviar.apagado, "sin motivos no se puede enviar")
	inf.casillas["aimbot"].button_pressed = true
	inf.casillas["wallhack"].button_pressed = true
	inf.casillas["antijuego"].button_pressed = true
	inf.mensaje.text = "Desde el principio seguía a la gente a través de las paredes del hangar y acertaba todo a la cabeza, incluso sin mirar. En la última ronda se quedó quieto disparando a los de su propio equipo."
	inf._al_escribir()
	await get_tree().create_timer(0.4).timeout
	await _foto_en(carpeta, "6_reporte_lleno")
	inf.boton_enviar.pressed.emit()
	for _i in 40:
		if bool(est.get("reportado", false)) or String(inf._pista.text).begins_with("No") or String(inf._pista.text).begins_with("Ya"):
			break
		await get_tree().create_timer(0.15).timeout
	await get_tree().create_timer(1.1).timeout
	fallos += comprobar.call(bool(est.get("reportado", false)), "reporte enviado (%s)" % inf._pista.text)
	await _foto_en(carpeta, "7_gracias")
	inf.cerrar()
	await get_tree().create_timer(0.4).timeout
	menu = mj.abrir_opciones(3)
	await get_tree().create_timer(0.8).timeout
	fallos += comprobar.call(menu.boton_reportar.apagado, "el menu dice YA REPORTADO")
	await _foto_en(carpeta, "8_ya_reportado")
	menu.cerrar()
	# EL MISMO OTRA VEZ, saltandose el menu: el servidor lo tiene que rechazar (uno por jugador y partida)
	var otro = Op.abrir_informe(mj._raiz, mj._w, lista[3], mj.info_partida, {})
	await get_tree().create_timer(0.4).timeout
	otro.casillas["aimbot"].button_pressed = true
	otro.boton_enviar.pressed.emit()
	var repetido := false
	for _i in 40:
		if otro._form != null and not otro._form.visible:
			repetido = true
			break
		await get_tree().create_timer(0.15).timeout
	await get_tree().create_timer(1.0).timeout
	fallos += comprobar.call(repetido, "el mismo reporte otra vez: el servidor dice que ya estaba")
	await _foto_en(carpeta, "9_repetido")
	otro.cerrar()
	await get_tree().create_timer(0.3).timeout
	# SIN CUENTA
	Op.forzar_sin_cuenta = true
	menu = mj.abrir_opciones(4)
	await get_tree().create_timer(0.5).timeout
	menu.boton_reportar.pressed.emit()
	await get_tree().create_timer(0.6).timeout
	fallos += comprobar.call(Op.ultima != null and Op.ultima.modo == "sin_cuenta", "sin sesion: aviso de iniciar sesion")
	await _foto_en(carpeta, "10_sin_cuenta")
	Op.ultima.cerrar()
	Op.forzar_sin_cuenta = false
	await get_tree().create_timer(0.3).timeout
	# AL CERRAR, los me gusta que quedaron van a la cuenta de cada uno
	mj.cerrar()
	await get_tree().create_timer(2.5).timeout
	print("[reportefoto] ", "TODO BIEN" if fallos == 0 else "%d FALLOS" % fallos)
	get_tree().quit(fallos)


func _foto_en(carpeta: String, nombre: String) -> void:
	await RenderingServer.frame_post_draw
	var ruta := carpeta.path_join(nombre + ".png")
	get_viewport().get_texture().get_image().save_png(ruta)
	print("[reportefoto] foto ", ruta)


## --fotojuego=ruta.png: una captura de la partida a los 14 s, con la interfaz (marcador, etiquetas del equipo)
func _foto_juego(ruta: String) -> void:
	# en bomba, sin nadie que elija bando la pantalla de eleccion lo tapaba todo: se elige policia a los 8 s
	if bomb_mode:
		await get_tree().create_timer(8.0).timeout
		if Net.my_team() == "":
			_pick_team(Net.TEAM_CT)
	await get_tree().create_timer(14.0).timeout
	# con bajas en el registro, si las hay (hasta 40 s mas)
	var espera := 0.0
	while espera < 40.0 and hud.killfeed and is_instance_valid(hud.killfeed) and hud.killfeed.get("_filas").size() < 3:
		await get_tree().create_timer(0.5).timeout
		espera += 0.5
	get_viewport().get_texture().get_image().save_png(ruta)
	print("[fotojuego] %s" % ruta)
	get_tree().quit()


func _resumen_foto(ruta: String) -> void:
	await get_tree().create_timer(8.0).timeout
	_spawn_enemy_at(player.global_position + Vector3(0.0, 0.0, -7.0), 0)
	await get_tree().create_timer(1.0).timeout
	var bots := get_tree().get_nodes_in_group("bots")
	if bots.is_empty():
		print("[resumen] FALLO: sin bot")
		get_tree().quit(1)
		return
	var b = bots[0]
	if "team" in b:
		b.team = Net.TEAM_CT if String(player.team) == Net.TEAM_T else Net.TEAM_T
	player.ultimo_atacante = b
	b.ultimo_atacante = player
	b.take_damage(38.0, Vector3.ZERO)        # algo de daño tuyo, para las cuentas
	player.take_damage(9999.0, Vector3(0, 0, 1.5))
	await get_tree().create_timer(1.6).timeout
	get_viewport().get_texture().get_image().save_png(ruta)
	print("[resumen] captura en %s · espectando %s" % [ruta, str(player.spectating)])
	await get_tree().create_timer(4.2).timeout
	print("[resumen] a los 5,8 s: espectando %s · vida %.0f · %s" % [str(player.spectating), player.health,
		"VUELVE A JUGAR" if not player.spectating and player.health > 0.0 else "NO VUELVE"])
	get_tree().quit()


func _killcam_test() -> void:
	await get_tree().create_timer(8.0).timeout
	# bots a mano: la partida de prueba no arranca ronda, asi que no nace ninguno
	if get_tree().get_nodes_in_group("bots").is_empty():
		for i in 6:
			_spawn_enemy_at(player.global_position + Vector3(6.0 + 2.0 * i, 0.0, 4.0), i)
		_assign_bot_teams()
		await get_tree().create_timer(3.0).timeout
		# y la mitad a MI bando: el reparto normal los pone a todos de enemigos cuando no hay ronda
		var lista := get_tree().get_nodes_in_group("bots")
		for i in lista.size():
			if "team" in lista[i]:
				lista[i].team = String(player.team) if i % 2 == 0 else (Net.TEAM_CT if String(player.team) == Net.TEAM_T else Net.TEAM_T)
	var bots := get_tree().get_nodes_in_group("bots")
	var enemigo = null
	var amigos: Array = []
	for b in bots:
		if not is_instance_valid(b) or not ("team" in b):
			continue
		if String(b.team) == String(player.team):
			amigos.append(b)
		elif enemigo == null:
			enemigo = b
	print("[killcam] bots %d · de mi bando %d · enemigo %s" % [bots.size(), amigos.size(), str(enemigo != null)])
	if enemigo == null or amigos.size() < 2:
		print("[killcam] FALLO: hace falta un enemigo y dos compañeros vivos")
		get_tree().quit(1)
		return
	player.ultimo_atacante = enemigo
	player.last_attacker = 0
	# se entra al espectador a mano: `die()` en este banco reaparece (no hay ronda viva) y lo que se
	# prueba aqui es la camara de muerte, no por que camino se llega a ella
	player.death_pos = player.global_position
	player._enter_spectate()
	await get_tree().create_timer(1.2).timeout
	# LA CAMARA DEL CAIDO (2026-10-02): encima de tu cuerpo, mirando al que te mato, y el con el contorno puesto
	var c_pos: Vector3 = player.cam.global_position
	var sobre_cuerpo: float = Vector2(c_pos.x, c_pos.z).distance_to(Vector2(player.death_pos.x, player.death_pos.z))
	var altura: float = c_pos.y - player.death_pos.y
	var mirando: Vector3 = -player.cam.global_transform.basis.z
	var hacia_matador: Vector3 = (enemigo.global_position + Vector3(0, 1.1, 0) - c_pos).normalized()
	var apunta: float = mirando.dot(hacia_matador)
	var con_xray: bool = player.get("_xray_nodo") == enemigo and not (player.get("_xray_prev") as Dictionary).is_empty()
	var cuerpo_visto: bool = player.avatar != null and player.avatar.visible
	print("[killcam] durante la camara de muerte: espectando %s · killcam %.1f s · camara a %.1f m del cuerpo (en planta) y %.1f m por encima · mira al matador %.2f (1 = de lleno) · contorno %s · tu cuerpo se ve %s" % [
		str(player.spectating), player.killcam_t, sobre_cuerpo, altura, apunta, str(con_xray), str(cuerpo_visto)])
	for fa in OS.get_cmdline_user_args():
		if String(fa).begins_with("--killcamfoto="):
			get_viewport().get_texture().get_image().save_png(String(fa).substr(14))
	# TU CUERPO CAE ENTERO (ragdoll), no solo la cabeza: cabeza y cadera cerca del suelo
	var en_suelo := false
	var sk: Skeleton3D = player.avatar.skeleton if player.avatar else null
	if sk != null and "bone_idx" in player.avatar:
		var bi: Dictionary = player.avatar.bone_idx
		var alto_h := -1.0
		var alto_c := -1.0
		for nb in ["head", "Head"]:
			if bi.has(nb):
				alto_h = (sk.global_transform * sk.get_bone_global_pose(bi[nb])).origin.y - player.death_pos.y
		for nb in ["hips", "pelvis", "Hips", "spine"]:
			if bi.has(nb) and alto_c < 0.0:
				alto_c = (sk.global_transform * sk.get_bone_global_pose(bi[nb])).origin.y - player.death_pos.y
		en_suelo = alto_h >= -1.0 and alto_h < 0.6 and alto_c < 0.6
		print("[killcam] tu cuerpo: ragdoll %s · cabeza a %.2f m · cadera a %.2f m del suelo" % [
			str(is_instance_valid(player.get("_ragdoll_propio"))), alto_h, alto_c])
	var ok_killcam: bool = player.spectating and player.killcam_t > 0.0 and sobre_cuerpo < 2.5 and altura > 1.0 		and apunta > 0.8 and con_xray and cuerpo_visto and en_suelo
	# y al acabar, espectador de un compañero
	await get_tree().create_timer(4.0).timeout
	var obj1 = player.spectate_target
	print("[killcam] despues: killcam %.1f · viendo a %s" % [player.killcam_t, str(obj1)])
	var ok_esp: bool = player.killcam_t <= 0.0 and is_instance_valid(obj1)
	# cambiar de compañero
	player.espectar_siguiente(1)
	await get_tree().create_timer(0.4).timeout
	var obj2 = player.spectate_target
	var ok_cambio: bool = is_instance_valid(obj2) and obj2 != obj1
	print("[killcam] al cambiar: %s -> %s · %s" % [str(obj1), str(obj2), "CAMBIA" if ok_cambio else "NO CAMBIA"])
	# y que no se le vuelva a ir solo al de antes
	await get_tree().create_timer(1.0).timeout
	var ok_queda: bool = player.spectate_target == obj2
	print("[killcam] un segundo despues sigue en %s: %s" % [str(player.spectate_target), "SI" if ok_queda else "NO, se ha vuelto solo"])
	var todo: bool = ok_killcam and ok_esp and ok_cambio and ok_queda
	print("[killcam] %s" % ("TODO CORRECTO" if todo else "FALLOS: killcam %s · espectador %s · cambio %s · se queda %s" % [
		str(ok_killcam), str(ok_esp), str(ok_cambio), str(ok_queda)]))
	get_tree().quit(0 if todo else 1)


## --flechatest: LA FLECHA DE "ME DISPARAN DESDE AHI". El usuario: "aparece pero no indica de donde
## vino el disparo; muevo la camara y se vuelve loca". Se dispara desde los cuatro lados y se mira DONDE
## acaba la flecha en pantalla: delante tiene que salir arriba, a la derecha a la derecha, etc. Y lo que
## rompia de verdad: se repite mirando al cielo y al suelo, porque el angulo se sacaba del vector de la
## camara con su cabeceo y ahi se volvia loco.
func _flecha_dano_test() -> void:
	await get_tree().create_timer(6.0).timeout
	player.set("invulnerable", true)
	player.global_position = Vector3(147.8, 2.0, 59.2)
	player.look.x = 0.0                     # mirando a -Z
	var cam: Camera3D = player.get_node_or_null("Head/Camera3D")
	var centro: Vector2 = hud.root.size * 0.5
	var casos := [["de frente", Vector3(0, 0, -8), "arriba"], ["por la derecha", Vector3(8, 0, 0), "derecha"],
		["por detras", Vector3(0, 0, 8), "abajo"], ["por la izquierda", Vector3(-8, 0, 0), "izquierda"]]
	var fallos := 0
	for cabeceo in [0.0, -80.0, 80.0]:
		player.look.y = deg_to_rad(cabeceo)
		for _i in 6:
			await get_tree().process_frame
		for caso in casos:
			hud.dmg_dirs.clear()
			hud.damage_from(player.global_position + (caso[1] as Vector3))
			for _i in 4:
				await get_tree().process_frame
			var arc: Label = hud.dmg_arcs[0]
			var d: Vector2 = (arc.position + arc.size * 0.5) - centro
			var donde := ""
			if absf(d.y) > absf(d.x):
				donde = "arriba" if d.y < 0.0 else "abajo"
			else:
				donde = "derecha" if d.x > 0.0 else "izquierda"
			var bien: bool = donde == String(caso[2]) and arc.visible
			if not bien:
				fallos += 1
			print("[flechatest] camara %+3.0f grados · disparo %-14s -> flecha %-10s (%s) %s" % [
				cabeceo, caso[0], donde, str(d.round()), "OK" if bien else "MAL, se esperaba " + String(caso[2])])
	print("[flechatest] %s" % ("TODO CORRECTO" if fallos == 0 else "%d FALLOS" % fallos))
	get_tree().quit(0 if fallos == 0 else 1)


## --fotomenu: EL BOTON "SACAR FOTO" DEL MENU. Comprueba las tres cosas que pidio el usuario: que la
## foto sale sin arma, sin desenfoque de enfoque y a maxima calidad, y que al acabar vuelve TU
## configuracion (no se queda en ultra, que en esta maquina se notaria enseguida).
func _foto_menu_test() -> void:
	await get_tree().create_timer(6.0).timeout
	player.set("invulnerable", true)
	var antes := {"escala": get_viewport().scaling_3d_scale, "sombra": sun.directional_shadow_max_distance,
		"calidad": quality, "focus": Settings.focus_mode, "custom": Settings.gfx_custom,
		"arma": player.weapon_pivot.visible}
	print("[fotomenu] antes: calidad %d · escala3d %.2f · sombras %.0f m · enfoque %d · arma %s" % [
		antes["calidad"], antes["escala"], antes["sombra"], antes["focus"], str(antes["arma"])])
	hud.sacar_foto()
	# se vigila CADA FOTOGRAMA mientras dura: el modo maximo puede durar menos de un segundo
	var pico := {"escala": 0.0, "sombra": 0.0, "calidad": 0, "arma_oculta": false, "enfoque_off": false}
	for _i in 600:
		pico["escala"] = maxf(pico["escala"], get_viewport().scaling_3d_scale)
		pico["sombra"] = maxf(pico["sombra"], sun.directional_shadow_max_distance)
		pico["calidad"] = maxi(pico["calidad"], quality)
		if not player.weapon_pivot.visible:
			pico["arma_oculta"] = true
		if Settings.focus_mode == 0:
			pico["enfoque_off"] = true
		await get_tree().process_frame
		if not hud._fotografiando:
			break
	print("[fotomenu] durante: calidad %d · escala3d %.2f · sombras %.0f m · arma escondida %s · enfoque apagado %s" % [
		pico["calidad"], pico["escala"], pico["sombra"], str(pico["arma_oculta"]), str(pico["enfoque_off"])])
	await get_tree().create_timer(0.5).timeout
	print("[fotomenu] despues: calidad %d · escala3d %.2f · sombras %.0f m · enfoque %d · arma %s" % [
		quality, get_viewport().scaling_3d_scale, sun.directional_shadow_max_distance,
		Settings.focus_mode, str(player.weapon_pivot.visible)])
	var ok: bool = is_equal_approx(get_viewport().scaling_3d_scale, float(antes["escala"])) 		and is_equal_approx(sun.directional_shadow_max_distance, float(antes["sombra"])) 		and quality == int(antes["calidad"]) and Settings.focus_mode == int(antes["focus"]) 		and player.weapon_pivot.visible == bool(antes["arma"])
	print("[fotomenu] %s · foto guardada en: %s" % ["TODO VUELVE A SU SITIO" if ok else "FALLO: algo no se restauro", hud.ultima_foto])
	get_tree().quit(0 if ok else 1)


## --esprintfoto: COMO SE CORRE CON EL ARMA, de frente (primera persona) y desde fuera (tercera). El
## usuario quiere la carrera "bien tactica": el arma baja, cruzada y pegada al cuerpo, no zarandeandose.
## Saca cuatro fotos por arma: quieto y corriendo, en primera y en tercera.
## --mazogrid: la pose de correr del MAZO en varias posturas, una foto por postura, en una sola ejecucion.
## Cada arranque del juego son dos minutos: probar seis poses a run suelta no es forma de calibrar nada.
## --climatest: el aviso de fps bajos del modo oleadas, de verdad. Comprueba que al recibirlo se apaga la
## lluvia y se hace de dia (a solas; en red lo mismo pero decidido por el anfitrion).
func _clima_test() -> void:
	await get_tree().create_timer(6.0).timeout
	print("[clima] antes: lluvia %s · noche %s · pve %s" % [str(raining), str(night), str(pve != null)])
