extends Node3D
const Estadisticas := preload("res://scripts/estadisticas.gd")
## Escena principal: carga el mundo voxel, aplica el nivel de calidad, adapta el rendimiento
## en tiempo real y gestiona a los enemigos. Modo benchmark: ejecutar con `--bench`.

const ENEMY_SCENE := preload("res://scenes/enemy.tscn")
const EnemyScript := preload("res://scripts/enemy.gd")
const WeaponModelScript := preload("res://scripts/weapon_model.gd")
const CriaturaScript := preload("res://scripts/criatura.gd")
const AvatarScript := preload("res://scripts/avatar_animator.gd")
const HabFxScript := preload("res://scripts/hab_fx.gd")
const HabilidadScript := preload("res://scripts/habilidad.gd")
const EffectsScript := preload("res://scripts/effects.gd")

var effects: Node3D

@onready var world = $VoxelWorld
@onready var player = $Player
@onready var hud = $HUD
@onready var sun: DirectionalLight3D = $Sun
@onready var enemies: Node3D = $Enemies
@onready var env: WorldEnvironment = $WorldEnvironment

var quality := 1
var detected_quality := 1
var loading := true
var frame_acc := 0.0
var frame_n := 0
var slow_time := 0.0
var fast_time := 0.0
var kills := 0
var bench_mode := false
## A/B de la auditoria del 2026-10-04: --statssiempre pide get_stats cada 4 cuadros aunque nadie lo lea (como antes)
static var _stats_siempre: bool = "--statssiempre" in OS.get_cmdline_user_args()

# --- noche y lluvia (interruptores del menú) ---
var night := false
var raining := false
var _day := {}
var _rain_fx: GPUParticles3D

## GRADACION DE COLOR por mapa: dust2 tira a cálido y desaturado (polvo, sol alto) y la ciudad a
## frío y contrastado. Va en los ajustes del Environment, que no añade una pasada aparte.
# --- LA VISTA SE ACOSTUMBRA ---------------------------------------------------------------------
# Sales de un portal oscuro a la calle y te deslumbras un instante; entras y por un momento no ves
# nada. No es exposicion automatica del motor -en el renderizador movil no la hay- sino algo mas
# simple y que ademas se controla mejor: dentro, la vista se abre; fuera, se cierra. Como tarda casi
# un segundo en moverse, al cruzar la puerta te quedas un momento con la vista del otro lado, que es
# justo el efecto que se busca.
#
# CUANTO. El primer intento fue un 8% y no se notaba: la pantalla ya viene con su ajuste de brillo
# encima, y un 8% sobre eso se pierde. Ahora es un 26% y ademas mueve el CONTRASTE, que es lo que de
# verdad vende el deslumbre: al salir a la calle la imagen no solo esta clara, esta lavada un
# instante, como cuando el ojo todavia no ha cerrado. Volviendo a entrar pasa lo contrario y el
# interior se ve plano y turbio hasta que la vista se abre.
# El tope esta puesto donde deja de ser un detalle: mas arriba no ves a quien te dispara desde la
# puerta, y eso ya no es un adorno, es un problema de juego.
# CUANTO. Va por el tercer intento: 1,08 no se veia, 1,26 se veia poco. Ahora 1,75, y con el
# contraste y el color moviendose el doble. La pantalla ya lleva su propio ajuste de brillo encima y
# se come buena parte del efecto, asi que hay que pasarse de la raya para que llegue.
const VISTA_DENTRO := 1.75
## MAS FUERTE, a peticion del usuario: "oscurece x5 veces y aclara x3 la potencia". Lo que se ACLARA al
## entrar (lo que pasa de 1) va por 3: de +75 % a +225 %. Lo que se OSCURECE bajo techo va por 5: el
## interior se divide por 1 + 0,75 x 5 = 4,75 (antes por 1,75). Con la vista ya adaptada dentro queda
## algo mas oscuro que la calle (x0,68), que es lo que se busca: un interior se nota interior.
const VISTA_ACLARA_X := 3.0
const VISTA_OSCURECE_X := 5.0
var _vista := 1.0
var _vista_base := 1.02
# Estas dos las pisa `_apply_grade` con los valores del mapa; aqui solo estan para tener un punto de
# partida. Se perdieron una vez al borrar un bloque de codigo de al lado y `main.gd` dejo de
# compilar entero: el mapa no cargaba y el sintoma no se parecia nada a la causa.
var _contraste_base := 1.10
var _satura_base := 0.94
# CUANTO TECHO TIENES ENCIMA, y nada mas. Hubo una version que media LO QUE MIRABAS -dos rayos hacia
# donde apuntabas- para que un portal se viera oscuro desde fuera. Sobre el papel es lo que hace el
# ojo, pero jugando no funciona: con un raton giras la cabeza varias veces por segundo y la
# exposicion no paraba de moverse. Se probo y se descarto.
#
# Ahora depende solo de donde ESTAS, que es un dato que cambia despacio porque andando se tarda en
# entrar y en salir. Y sale gratis: `_techo_frac` ya se calcula para el sonido de la lluvia, con los
# cinco rayos en abanico, asi que la adaptacion no cuesta ni un rayo mas.
func _update_vista(dt: float) -> void:
	if env == null or env.environment == null:
		return
	# LA PANTALLA YA NO SE ACLARA. El brillo global se queda siempre en el del mapa.
	var e2: Environment = env.environment
	if not is_equal_approx(e2.adjustment_brightness, _vista_base):
		e2.adjustment_brightness = _vista_base
	e2.adjustment_contrast = _contraste_base
	e2.adjustment_saturation = _satura_base
	if _vista_fuerza <= 0.001:
		_poner_vista_shader(0.0, 0.0, 0.0)      # sin adaptacion: ni penumbra dentro ni deslumbre fuera
		return
	# LA ADAPTACION VA EN EL SHADER DEL MUNDO (idea del usuario): "si entro debajo de un techo no se va a
	# aclarar el interior: la oscuridad que le ponia el shader se ira y se vera como se tiene que ver;
	# solo aclarara afuera".
	#   - fuera y a la calle: lo de dentro se ve en penumbra (`interior_oscuro`), la calle normal.
	#   - al entrar, la vista se acostumbra (`_vista_adapt` sube de 0 a 1): la penumbra de dentro se va y el
	#     interior queda normal, y lo que ves de FUERA (calle, ventanas, puertas) se aclara: deslumbra.
	#   - al salir, al reves: la calle vuelve a su brillo y los interiores a la penumbra.
	# Con la FRACCION de techo, no con un si o un no: un porche adapta a medias.
	# Y CON LA DISTANCIA A LA SALIDA. "Si entro debajo de un techo pero estoy cerca de afuera no se aclara
	# del todo, solo muy poquito; si me alejo de afuera, si del todo." Junto a la puerta la luz de la
	# calle todavia entra de lleno; al fondo de la habitacion, no.
	var hondo: float = smoothstep(VISTA_SALIDA_CERCA, VISTA_SALIDA_LEJOS, _dist_afuera)
	var quiere: float = clampf(_techo_frac, 0.0, 1.0) * lerpf(0.12, 1.0, hondo)
	# acostumbrarse a la oscuridad es lento; deslumbrarse al salir, rapido
	_vista_adapt = move_toward(_vista_adapt, quiere, dt * (0.35 if quiere > _vista_adapt else 0.70))
	var oscuro: float = 1.0 - 1.0 / (1.0 + (VISTA_DENTRO - 1.0) * VISTA_OSCURECE_X * _vista_fuerza)
	# SIN PENUMBRA BAJO TECHO (pedido 2026-09-21: "veo dos sombras"). El mapa de techos oscurecia en VERTICAL
	# todo lo que tuviera algo encima -una mesa, un balcon, un voladizo, no solo una casa-, y al lado de la
	# sombra del sol, que va inclinada, salia una segunda sombra recta debajo de cada cosa. Los interiores
	# ya quedan oscuros sin ella: el sol no entra y la luz ambiente se bajo a 0,24 para eso. Se queda el
	# deslumbre de la calle al estar dentro, que no pinta sombras. --penumbra la vuelve a poner.
	if not "--penumbra" in OS.get_cmdline_user_args():
		oscuro = 0.0
	var claro: float = (VISTA_DENTRO - 1.0) * VISTA_ACLARA_X * _vista_fuerza
	# Y SIN DESLUMBRE TAMPOCO (pedido 2026-09-21: "cuando entro bajo un techo genera una sombra mas oscura de
	# mentira"). Aclarar lo de fuera usa el mismo mapa de techos en vertical: el suelo bajo el techo quedaba
	# mas oscuro que el de al lado con la forma exacta del techo, o sea otra sombra recta falsa.
	if not "--penumbra" in OS.get_cmdline_user_args():
		claro = 0.0
	_poner_vista_shader(oscuro, claro, _vista_adapt)
	_vista = 1.0 + claro * _vista_adapt      # solo informativo (pruebas): cuanto se aclara lo de fuera


var _vista_adapt := 0.0
## A cuantos metros esta lo mas cercano que da al cielo y se ve desde donde estas (ver _medir_afuera).
var _dist_afuera := 99.0
const VISTA_SALIDA_CERCA := 1.0     ## m: pegado a la salida, apenas se adapta
const VISTA_SALIDA_LEJOS := 7.0     ## m: a partir de aqui, del todo

## ¿A CUANTO ESTA LA SALIDA? Se mira el mapa de techos (ya calculado, no cuesta rayos) en ocho
## direcciones y a distancias crecientes; el primer punto sin techo encima es "afuera". Solo cuenta si
## se ve desde el pecho: un patio al otro lado de una pared no es una salida. Un rayo por direccion,
## y solo en las que tienen candidato.
func _medir_afuera() -> void:
	if player == null or world == null or _techo_img == null or _techo_fila < TECHO_PX:
		_dist_afuera = 99.0
		return
	var tam: Vector3 = world.get_world_size()
	var ojo: Vector3 = player.global_position + Vector3(0, 1.4, 0)
	var mejor := 99.0
	for i in 8:
		var dir := Vector3(cos(i * TAU / 8.0), 0.0, sin(i * TAU / 8.0))
		var paso := 0.75
		var d := paso
		while d <= VISTA_SALIDA_LEJOS + 0.5 and d < mejor:
			var q: Vector3 = ojo + dir * d
			var tx := clampi(int(q.x / tam.x * TECHO_PX), 0, TECHO_PX - 1)
			var tz := clampi(int(q.z / tam.z * TECHO_PX), 0, TECHO_PX - 1)
			var cima: float = float(_techo_datos[tz * TECHO_PX + tx]) / 255.0 * _techo_altura
			if cima < player.global_position.y + 1.2:
				# da al cielo: ¿se ve desde aqui?
				var r: Dictionary = world.raycast(ojo, dir, d)
				if not r.get("hit", false):
					mejor = d
				break
			d += paso
	_dist_afuera = mejor
var _vista_shader_puesto := Vector3(-1, -1, -1)

func _poner_vista_shader(oscuro: float, claro: float, adapt: float) -> void:
	_interior_oscuro_puesto = oscuro
	if world == null or world.opaque_material == null:
		return
	var v := Vector3(oscuro, claro, adapt)
	if v.distance_to(_vista_shader_puesto) < 0.004:
		return
	_vista_shader_puesto = v
	var m := world.opaque_material as ShaderMaterial
	m.set_shader_parameter("interior_oscuro", clampf(oscuro, 0.0, 0.95))
	m.set_shader_parameter("exterior_claro", maxf(claro, 0.0))
	m.set_shader_parameter("vista_adapt", clampf(adapt, 0.0, 1.0))


var _interior_oscuro_puesto := -1.0

## COLOR VIVO (pedido 2026-09-28: "mas colorido, los mismos colores pero mas fuertes, mas brilloso, mas infantil").
## Los mismos tonos, mas saturados y algo mas claros, en todo el mundo 3D y el cielo (la interfaz no pasa por
## aqui). El revelado AgX ya apaga bastante los colores vivos, por eso el empujon es grande. --colornatural
## vuelve a lo de antes para comparar.
## El grueso va a los MATERIALES del mundo (voxel.gdshader, `color_vivo`, antes de la luz: el tinte del amanecer
## o de la noche no se exagera); a la imagen final solo un toque, que es lo que aviva personajes y armas.
const COLOR_VIVO_MATERIAL := 1.45
const COLOR_VIVO_SAT := 1.12
const COLOR_VIVO_BRILLO := 0.04
const COLOR_VIVO_CONTRASTE := 0.03

func _apply_grade() -> void:
	var e: Environment = env.environment
	e.adjustment_enabled = true
	if current_map == "city":
		_vista_base = 1.02
		_contraste_base = 1.10
		_satura_base = 0.94
	else:
		_vista_base = 1.03
		_contraste_base = 1.06
		_satura_base = 1.04
	var vivo := not ("--colornatural" in OS.get_cmdline_user_args())
	if vivo:
		_satura_base *= COLOR_VIVO_SAT
		_vista_base += COLOR_VIVO_BRILLO
		_contraste_base += COLOR_VIVO_CONTRASTE
	if world != null and world.opaque_material is ShaderMaterial:
		(world.opaque_material as ShaderMaterial).set_shader_parameter("color_vivo", COLOR_VIVO_MATERIAL if vivo else 1.0)
		if trozo_mat != null:
			trozo_mat.set_shader_parameter("color_vivo", COLOR_VIVO_MATERIAL if vivo else 1.0)
	e.adjustment_brightness = _vista_base
	e.adjustment_contrast = _contraste_base
	e.adjustment_saturation = _satura_base
	_vista = 1.0


## Guarda la iluminación diurna tal cual viene de la escena, para poder volver a ella.
func _save_day() -> void:
	var e: Environment = env.environment
	_day = {
		"sun_e": sun.light_energy, "sun_c": sun.light_color, "sun_rot": sun.rotation_degrees,
		"bg": e.background_color, "amb_c": e.ambient_light_color, "amb_e": e.ambient_light_energy,
		"fog_c": e.fog_light_color, "fog_d": e.fog_density,
	}

## Noche: la luz direccional pasa a ser luna (tenue y azulada) y el ambiente y la niebla bajan
## mucho, que es lo que deja ver las luces puntuales del mapa.
func set_night(on: bool, aviso: bool = true) -> void:
	if _day.is_empty():
		_save_day()
	night = on
	var e: Environment = env.environment
	if on:
		sun.light_energy = 0.10
		sun.light_color = Color(0.55, 0.63, 0.95)
		sun.rotation_degrees = Vector3(-28.0, float(_day["sun_rot"].y) + 180.0, 0.0)
		_avisar_sol_sombras()
		e.background_color = Color(0.02, 0.025, 0.05)
		e.ambient_light_color = Color(0.10, 0.13, 0.24)
		e.ambient_light_energy = 0.10
		e.fog_light_color = Color(0.05, 0.06, 0.12)
		# la densidad ya no se toca: la niebla es por profundidad (ver _ajustar_niebla) y va al maximo
	else:
		sun.light_energy = _day["sun_e"]
		sun.light_color = _day["sun_c"]
		sun.rotation_degrees = _day["sun_rot"]
		_avisar_sol_sombras()
		e.background_color = _day["bg"]
		e.ambient_light_color = _day["amb_c"]
		e.ambient_light_energy = _day["amb_e"]
		e.fog_light_color = _day["fog_c"]
	_show_lamps(on and not _faroles_apagados)
	if hud and aviso:
		hud.flash_message("NOCHE: %s" % ("ON" if on else "OFF"))

## Lluvia: sonido de Teardown en bucle + partículas en una caja que sigue a la cámara, así que
## llueve siempre alrededor del jugador sin llenar el mapa de partículas.
var tormenta: Node3D = null        ## tormenta.gd: relampagos y truenos mientras llueve

func set_rain(on: bool) -> void:
	raining = on
	if on and tormenta == null:
		tormenta = preload("res://scripts/tormenta.gd").new()
		tormenta.name = "Tormenta"
		tormenta.main = self
		add_child(tormenta)
		if "--sindetalle" in OS.get_cmdline_user_args() and world.opaque_material is ShaderMaterial:
			(world.opaque_material as ShaderMaterial).set_shader_parameter("lluvia_detalle", 0.0)
	if on:
		if _rain_fx == null:
			_rain_fx = _make_rain()
			add_child(_rain_fx)
		_rain_fx.emitting = not ("--singotaslluvia" in OS.get_cmdline_user_args())   # (banco de la lluvia)
		_techo_t = 0.0          # que compruebe el techo en el primer fotograma
		Audio.start_rain(true)
		Audio.rain_cover(_cubierto)
	else:
		if _rain_fx:
			_rain_fx.emitting = false
		Audio.stop_rain()
	# EL CIELO SE ENCAPOTA. `clouds_weight` es lo oscuras que van las nubes: con lluvia, plomizas.
	if _cielo_mat:
		_cielo_mat.set_shader_parameter("clouds_weight", 0.75 if on else 0.05)
		_cielo_mat.set_shader_parameter("clouds_cutoff", 0.12 if on else 0.20)
		_cielo_mat.set_shader_parameter("clouds_speed", 6.0 if on else 2.0)
	if hud:
		hud.flash_message("LLUVIA: %s" % ("ON" if on else "OFF"))

## LOS COPOS. Es la caja de la lluvia pero con otra fisica: caen despacio, pesan poco y el aire los
## lleva de un lado a otro (turbulencia), asi que bajan haciendo eses en vez de en linea recta. Y son
## cuadraditos, no rayas: una gota se estira al caer y un copo no.
var _nieve_fx: GPUParticles3D = null

func _make_nieve() -> GPUParticles3D:
	var p := GPUParticles3D.new()
	p.name = "Nieve"
	p.amount = 900
	p.lifetime = 7.0            # tardan mucho en llegar al suelo: hay que tenerlos vivos mas rato
	p.visibility_aabb = AABB(Vector3(-24, -24, -24), Vector3(48, 48, 48))
	p.local_coords = false
	var m := ParticleProcessMaterial.new()
	m.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_BOX
	m.emission_box_extents = Vector3(20, 0.5, 20)
	m.direction = Vector3(0, -1, 0)
	m.spread = 14.0
	m.initial_velocity_min = 0.6
	m.initial_velocity_max = 1.4
	m.gravity = Vector3(0, -0.9, 0)      # casi nada: un copo no cae, flota hacia abajo
	m.scale_min = 0.5
	m.scale_max = 1.4
	# EL AIRE. Sin esto los copos bajan como plomadas y parecen ceniza. La turbulencia es lo que les
	# da ese vaiven de un lado a otro que hace que se lean como nieve.
	m.turbulence_enabled = true
	m.turbulence_noise_strength = 0.35
	m.turbulence_noise_scale = 2.2
	m.turbulence_influence_min = 0.10
	m.turbulence_influence_max = 0.30
	p.process_material = m
	var q := QuadMesh.new()
	q.size = Vector2(0.055, 0.055)
	var mat := StandardMaterial3D.new()
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.albedo_color = Color(0.96, 0.98, 1.0, 0.85)
	mat.billboard_mode = BaseMaterial3D.BILLBOARD_ENABLED
	mat.disable_receive_shadows = true
	q.material = mat
	p.draw_pass_1 = q
	return p


# --- POLVO EN EL AIRE ---------------------------------------------------------------------------
# Motas flotando, de las que solo se ven a contraluz. Es el efecto mas caro de los cinco, asi que va
# con tres frenos:
#
#   1. Solo con calidad media o mejor. En una integrada a tope de trabajo, esto sobra.
#   2. Solo cuando hay sol: lloviendo o nevando el cielo esta tapado y no habria contraluz ninguno,
#      asi que se apaga entero (deja de emitir, no solo de verse).
#   3. LO QUE BRILLAN SE DECIDE UNA VEZ POR CUADRO EN CODIGO, no por pixel en un shader. Depende solo
#      de cuanto mires hacia el sol, que es el mismo dato para las 220 motas: calcularlo en el shader
#      seria repetir la misma cuenta cientos de miles de veces para el mismo resultado.
const POLVO_N := 220
var _polvo: GPUParticles3D = null
var _polvo_mat: StandardMaterial3D = null


func _make_polvo() -> GPUParticles3D:
	var p := GPUParticles3D.new()
	p.name = "PolvoAire"
	p.amount = POLVO_N
	p.lifetime = 9.0
	p.preprocess = 9.0            # que ya este el aire lleno al aparecer, no llenandose
	p.local_coords = false
	p.visibility_aabb = AABB(Vector3(-10, -10, -10), Vector3(20, 20, 20))
	var m := ParticleProcessMaterial.new()
	m.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_BOX
	m.emission_box_extents = Vector3(8, 5, 8)
	m.direction = Vector3(0, 1, 0)
	m.spread = 180.0
	m.initial_velocity_min = 0.02
	m.initial_velocity_max = 0.10      # casi quietas: el polvo flota, no vuela
	m.gravity = Vector3(0, -0.012, 0)
	m.turbulence_enabled = true
	m.turbulence_noise_strength = 0.12
	m.turbulence_noise_scale = 1.4
	m.turbulence_influence_min = 0.05
	m.turbulence_influence_max = 0.20
	m.scale_min = 0.5
	m.scale_max = 1.5
	p.process_material = m
	var q := QuadMesh.new()
	q.size = Vector2(0.011, 0.011)     # motas, no copos
	_polvo_mat = StandardMaterial3D.new()
	_polvo_mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	_polvo_mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	_polvo_mat.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
	_polvo_mat.billboard_mode = BaseMaterial3D.BILLBOARD_ENABLED
	_polvo_mat.disable_receive_shadows = true
	_polvo_mat.albedo_color = Color(1.0, 0.96, 0.86, 0.0)
	q.material = _polvo_mat
	p.draw_pass_1 = q
	return p


func _update_polvo(_dt: float) -> void:
	# (las motas en el haz de la linterna se quitaron el 2026-10-13, pedido: "puede ser lo del lag")
	var quiere: bool = _polvo_on and quality >= 2 and not raining and not nevando and player != null
	if not quiere:
		if _polvo and _polvo.emitting:
			_polvo.emitting = false
		return
	if _polvo == null:
		_polvo = _make_polvo()
		add_child(_polvo)
	_polvo.emitting = true
	_polvo.global_position = player.global_position + Vector3(0, 1.5, 0)
	# A CONTRALUZ Y NO DE OTRA FORMA. Mirando hacia el sol las motas se encienden; de espaldas
	# desaparecen del todo. La potencia alta (^5) es lo que hace que sea un haz y no una neblina
	# general: solo cuando de verdad tienes el sol delante.
	# `player.cam` NO se puede tocar a pelo: mientras carga el mapa, el nodo todavia no tiene ese
	# campo y el acceso directo no devuelve null, LANZA. Eso fue lo que dejo la carga clavada.
	var camj: Camera3D = player.cam if ("cam" in player) else null
	if camj == null or _polvo_mat == null or sun == null:
		return
	var mirada: Vector3 = -camj.global_transform.basis.z
	# una luz direccional ALUMBRA hacia su -Z, asi que hacia el sol se va por su +Z
	var hacia_el_sol: Vector3 = sun.global_transform.basis.z.normalized()
	var k: float = clampf(mirada.dot(hacia_el_sol), 0.0, 1.0)
	_polvo_mat.albedo_color.a = pow(k, 5.0) * 0.55


func _make_rain() -> GPUParticles3D:
	var p := GPUParticles3D.new()
	p.name = "Rain"
	p.amount = 1200
	p.lifetime = 1.1
	p.visibility_aabb = AABB(Vector3(-22, -22, -22), Vector3(44, 44, 44))
	p.local_coords = false
	var m := ParticleProcessMaterial.new()
	m.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_BOX
	m.emission_box_extents = Vector3(18, 0.5, 18)
	m.direction = Vector3(0, -1, 0)
	m.spread = 2.0
	m.initial_velocity_min = 14.0
	m.initial_velocity_max = 18.0
	m.gravity = Vector3(0, -25, 0)
	m.scale_min = 0.7
	m.scale_max = 1.3
	# SIN COLISION. Se probo a que las gotas chocaran contra un mapa de alturas de la escena: el
	# resultado fue que desaparecian TODAS -el campo daba por "dentro" cualquier punto- y no se veia
	# llover. Mejor que atraviesen un tejado a que no haya lluvia.
	p.process_material = m
	var q := QuadMesh.new()
	q.size = Vector2(0.02, 0.34)
	# CON TECHO: la gota que tenga algo encima no se dibuja, asi no llueve dentro de las casas (el
	# mapa de techos es el mismo que usa el suelo para no encharcarse bajo cubierto).
	var mat := ShaderMaterial.new()
	mat.shader = load("res://shaders/lluvia_gota.gdshader")
	mat.set_shader_parameter("color", Color(0.68, 0.76, 0.9, 0.35))
	q.material = mat
	_rain_mat = mat
	_techo_a_material(mat)
	p.draw_pass_1 = q
	return p


## Pasa el mapa de techos a un material (el del mundo o el de las gotas). Se llama al crearlo y cada
## vez que el mapa avanza o se rehace un trozo.
var _rain_mat: ShaderMaterial = null

func _techo_a_material(m: ShaderMaterial) -> void:
	if m == null or _techo_tex == null:
		return
	var tam: Vector3 = world.get_world_size()
	m.set_shader_parameter("techo_mapa", _techo_tex)
	m.set_shader_parameter("techo_org", Vector2.ZERO)
	m.set_shader_parameter("techo_tam", Vector2(tam.x, tam.z))
	m.set_shader_parameter("techo_alto", _techo_altura)
	m.set_shader_parameter("techo_hay", 1.0 if _techo_fila >= TECHO_PX else 0.0)

