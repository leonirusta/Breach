# --- DUELO SIN REAPARECER (2026-10-14, pedido: "el que muere no spawnea como en bomba; si muere un compañero, hasta
# que su equipo lo reviva con RCP; el que elimine a todos gana; dos veces se tiene que ganar" y "otro: el ultimo que
# quede gana, todos contra todos"). Submodos "eliminacion" y "ultimo" de la cafeteria (Net.es_dm_elim). El duelo sigue
# siendo duelo (bases, salidas, bots al centro, la tabla del final); cambia: nadie reaparece (player.die, el repuesto de
# bots), las bajas no ganan y el anfitrion (o el juego sin red) mira 4 veces por segundo quien queda en pie.
#   eliminacion: un equipo sin nadie en pie -> ronda para el otro (Net.end_round, score_t / score_ct); a las 2, final.
#   ultimo:      queda un bando (una persona o un bot) -> final con el.
const ELIM_RONDAS := 2
var _elim_t := 0.0
var _elim_bandos := {}        ## los bandos que han tenido a alguien en pie esta ronda
var _elim_cerrando := false


func _elim_vivos() -> Dictionary:
	var vivos := {}
	if enemies != null:
		for e in enemies.get_children():
			if is_instance_valid(e) and not e.is_queued_for_deletion() and "team" in e and "health" in e 					and float(e.health) > 0.0 and String(e.team) != "":
				vivos[String(e.team)] = int(vivos.get(String(e.team), 0)) + 1
	if Net.is_online():
		for id in Net.players.keys():
			var t := Net.team_of(int(id))
			if t != "" and not Net.is_dead(int(id)):
				vivos[t] = int(vivos.get(t, 0)) + 1
	elif is_instance_valid(player) and float(player.health) > 0.0 and not bool(player.get("spectating")):
		var t := Net.my_team()
		if t != "":
			vivos[t] = int(vivos.get(t, 0)) + 1
	return vivos


func _elim_tick(dt: float) -> void:
	if not dm_mode or dm_terminado or _fin_resuelto or loading or _elim_cerrando or not Net.es_dm_elim():
		return
	if Net.is_online() and not Net.hosting:
		return
	if not Net.round_live or Net.my_team() == "":
		return
	_elim_t += dt
	if _elim_t < 0.25:
		return
	_elim_t = 0.0
	var vivos := _elim_vivos()
	for t in vivos:
		_elim_bandos[t] = true
	if _elim_bandos.size() < 2:
		return          # aun no ha salido nadie contra quien pelear
	if Net.todos_contra_todos():
		if "--elimdiag" in OS.get_cmdline_user_args() and Engine.get_process_frames() % 600 < 15:
			print("[elim] en pie: %s" % str(vivos))
		if vivos.size() <= 1:
			var g: String = String(vivos.keys()[0]) if vivos.size() == 1 else ""
			_elim_cerrando = true
			print("[elim] último en pie: %s a los %.0f s" % [g, Time.get_ticks_msec() * 0.001])
			Net.end_round(g, "Último en pie")
		return
	for t in [Net.TEAM_T, Net.TEAM_CT]:
		if _elim_bandos.has(t) and int(vivos.get(t, 0)) == 0:
			_elim_cerrando = true
			print("[elim] %s eliminado (en pie: %s) a los %.0f s" % [t, str(vivos), Time.get_ticks_msec() * 0.001])
			Net.end_round(Net.TEAM_CT if t == Net.TEAM_T else Net.TEAM_T, "Equipo eliminado")
			return


## Fin de ronda (en todas las maquinas: Net._round_end ya sumo el punto)
func _elim_fin_ronda(ganador: String) -> void:
	if Net.todos_contra_todos():
		_dm_fin(ganador)
		return
	if Net.score_t >= ELIM_RONDAS or Net.score_ct >= ELIM_RONDAS:
		_dm_fin(Net.TEAM_T if Net.score_t >= ELIM_RONDAS else Net.TEAM_CT)
		return
	if hud and ganador != "":
		var mio := Net.my_team()
		var mios: int = Net.score_t if mio == Net.TEAM_T else Net.score_ct
		var suyos: int = Net.score_ct if mio == Net.TEAM_T else Net.score_t
		hud.flash_message("%s · %s %d - %d" % ["¡RONDA GANADA!" if ganador == mio else "RONDA PERDIDA", Net.nombre_equipo(mio), mios, suyos])
	if Net.soy_espectador:
		return
	await get_tree().create_timer(6.0).timeout
	if not is_inside_tree() or dm_terminado:
		return
	_elim_bandos.clear()
	_elim_t = -1.0           # un segundo de gracia mientras salen todos
	Net.new_round()
	_elim_cerrando = false
	if is_instance_valid(player) and player.has_method("revive"):
		player.revive()
	spawn_at_team_base(Net.my_team())
	# los bots, de cero (como en bomba): la ronda empieza con los equipos enteros
	if enemies != null and Settings.bots_enabled and _me_toca_crear_bots():
		for e in enemies.get_children():
			e.queue_free()
		await get_tree().process_frame
		spawn_enemies()



