		if img != null:
			img.resize(320, 180)
			img.save_png("%s/c_%05d.png" % [carpeta, Time.get_ticks_msec() - t0])
		# los primeros 15 s, TODOS los fotogramas (lo que se cuela un instante antes de quitar la carga); luego cada 0,2 s
		if Time.get_ticks_msec() - t0 > 15000:
			await get_tree().create_timer(0.2).timeout


