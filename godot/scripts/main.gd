## QUIEN ENTRA Y QUIEN SE VA (2026-11-01): con la partida en marcha, el cartel con su nombre
var _gente: Dictionary = {}
var _gente_lista := false

func _quien_entra() -> void:
	if not Net.is_online():
		return
	var ahora: Dictionary = {}
	for id in Net.players.keys():
		ahora[int(id)] = String(Net.players[id].get("name", ""))
