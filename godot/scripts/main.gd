## --espectarinforme (banco del espectador, en el anfitrion y en los jugadores): cada 2 s que listas tiene esta
## maquina. El espectador solo puede salir en `Net.espectadores` del anfitrion: ni en `players` (marcador,
## bandos, tabla) ni en `remotes` (muñecos) de nadie.
func _espectar_informe() -> void:
	var rol := "ANFITRION" if Net.hosting else ("ESPECTADOR" if Net.soy_espectador else "JUGADOR")
	var secs := 60
	var sale := -1          # --espectarhostsale=<s>: el anfitrion se va a los s segundos (el espectador tiene que volver al vestibulo)
	for f in OS.get_cmdline_user_args():
		if String(f).begins_with("--espectarsecs="):
			secs = int(String(f).substr(15))
		if String(f).begins_with("--espectarhostsale="):
			sale = int(String(f).substr(19))
	for i in int(secs / 2.0):
		await get_tree().create_timer(2.0).timeout
		if not is_inside_tree():
			return
		if sale > 0 and Net.hosting and (i + 1) * 2 >= sale:
			print("[espinforme] ANFITRION: me voy de la sala (--espectarhostsale)")
			Engine.set_meta("espectartest_salio", true)       # el vestibulo no vuelve a abrir sala y cierra el juego
			go_to_lobby()
			return
		var muñecos: Array = []
		for id in Net.remotes.keys():
			var r = Net.remotes[id]
			muñecos.append("%d:%s" % [int(id), String(r.player_name) if is_instance_valid(r) else "?"])
		var nombres: Array = []
		for id in Net.players.keys():
			nombres.append("%d:%s" % [int(id), String((Net.players[id] as Dictionary).get("name", ""))])
		var st: Dictionary = world.get_stats() if world else {}
		print("[espinforme] %s t=%ds · players %s · muñecos %s · espectadores %s · puntuacion %s · voxels %d · bloques %d · historial %d" % [
			rol, (i + 1) * 2, str(nombres), str(muñecos), str(Net.espectadores.keys()),
			str(preload("res://scripts/puntuacion.gd").tabla.keys()), int(st.get("voxels_solid", 0)),
			(world.censo_bloques().size() / 2) if world and world.has_method("censo_bloques") else -1, Net.historial.size()])


func _unhandled_input(event: InputEvent) -> void:
	_diag_vivo_tecla(event)          # F9: volcar lo que hay delante (--diagvivo)
	# F12: foto sin interfaz (lo mismo que el boton SACAR FOTO del menu)
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_F12:
		hud.sacar_foto()
		get_viewport().set_input_as_handled()
		return
	if event.is_action_pressed("go_lobby"):
		go_to_lobby()
		return
	# LA CALIDAD SIEMPRE, que no es una trampa: es la tecla con la que se baja el detalle cuando el
	# movil va a tirones, y quitarla en online seria quitarla justo donde mas falta hace.
	if event.is_action_pressed("quality_cycle"):
		set_quality_manual((quality + 1) % 4)
		return
	# EL RESTO PASA POR EL MISMO FILTRO QUE EL MENU. Si no, esconder los botones no serviria de nada:
	# F6 demuele un edificio entero y F8 cambia de mapa a media partida.
	if not Settings.herramientas():
		return
	if event.is_action_pressed("demolish"):
		demolish_nearest()
	elif event.is_action_pressed("toggle_bots"):
		set_bots(not Settings.bots_enabled)
	elif event.is_action_pressed("toggle_voxel_ao"):
		toggle_voxel_ao()
	elif event.is_action_pressed("toggle_struct_debug"):
		toggle_struct_debug()
	elif event.is_action_pressed("copy_coords"):
		copy_coords()
	elif event.is_action_pressed("toggle_map"):
		cycle_map()

func cycle_map() -> void:
	var maps := Settings.available_maps()
	var i := maps.find(Settings.map)
	Settings.map = maps[(i + 1) % maps.size()]
	Settings.save()
	get_tree().reload_current_scene()

func toggle_voxel_ao() -> void:
