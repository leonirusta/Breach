## --granadalan (en las dos copias): a los 25 s el ANFITRION lanza una granada; el INVITADO mira su muñeco (el gesto,
## _lanz_t) y si le aparece la granada (grupo "grenade" o nodos Grenade)
func _granada_lan() -> void:
	if Net.hosting:
		await get_tree().create_timer(40.0).timeout
		player.grenades = 4
		player.grenade_cd = 0.0
		print("[granadalan] anfitrion lanza")
		player.throw_grenade()
		return
	await get_tree().create_timer(14.0).timeout
	var visto_gesto := false
	var vista_granada := false
	var fotos := 0
	var t0 := Time.get_ticks_msec()
	while Time.get_ticks_msec() - t0 < 40000:
		await get_tree().process_frame
		for r in Net.remotes.values():
			if not is_instance_valid(r) or r.get("avatar") == null:
				continue
			var f: Vector3 = -r.global_transform.basis.z
			f.y = 0.0
			if f.length() > 0.01:
				player.global_position = r.global_position + f.normalized() * 3.5 + r.global_transform.basis.x * 1.2
				player.velocity = Vector3.ZERO
				player.look_at_point(r.global_position + Vector3(0, 1.1, 0))
			if float(r.avatar.get("_lanz_t")) >= 0.0:
				visto_gesto = true
				if fotos < 8 and Engine.get_process_frames() % 5 == 0:
					get_viewport().get_texture().get_image().save_png("user://granadalan_%d.png" % fotos)
					fotos += 1
		for n in get_tree().root.find_children("*", "RigidBody3D", true, false):
			if n.get_script() and String(n.get_script().resource_path).ends_with("grenade.gd"):
				vista_granada = true
		if fotos >= 8:
			break
	print("[granadalan] invitado: gesto del muñeco %s · granada en vuelo %s · fotos %d" % [str(visto_gesto), str(vista_granada), fotos])



