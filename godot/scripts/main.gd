## --rescatetest: matar un bot aliado, recogerlo, andar con el a hombros (foto), soltarlo y revivirlo
## --cartasefectotest (2026-10-03): las cartas VAMPIRO, RESCATISTA, RECARGA DE DEFINITIVA, BLINDAJE y PIEL DURA, equipadas
## a nivel 10 SOLO EN MEMORIA (no se guarda nada), y lo que hace cada una medido sobre el jugador.
## --energiatest (con --personaje=9, el Specter): LA ENERGIA DE LA INVISIBILIDAD. Quieto, andando y corriendo invisible
## (cuanto gasta por segundo), que se acaba sola a 0, que vuelve visible, y una foto de la barra (user://energia_*.png).
func _energia_test() -> void:
	await get_tree().create_timer(8.0).timeout
	var h = player.get("_hab")
	if h == null or not h.usa_energia():
		print("[energia] MAL: el personaje no usa energia (tipo %s)" % (h.tipo if h else "-"))
		get_tree().quit(1)
		return
	var foto := func(n: String) -> void:
		await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("user://energia_%s.png" % n)
	print("[energia] tipo %s · nivel %d · gasto quieto %.1f/s + moviendose %.1f/s" % [h.tipo, h.nivel(h.tipo), h.gasto_energia().x, h.gasto_energia().y])
	await foto.call("llena")
	print("[energia] activar: %s · energia %.0f" % [str(h.activar()), h.energia])
	var e0: float = h.energia
	await get_tree().create_timer(2.0).timeout
	print("[energia] QUIETO 2 s: %.1f/s · invisible %s" % [(e0 - h.energia) / 2.0, str(player.invisible)])
	await foto.call("invisible")
	e0 = h.energia
	Input.action_press("move_forward")
	await get_tree().create_timer(1.5).timeout
	print("[energia] ANDANDO 1,5 s: %.1f/s (vel %.1f m/s)" % [(e0 - h.energia) / 1.5, Vector2(player.velocity.x, player.velocity.z).length()])
	e0 = h.energia
	Input.action_press("sprint")
	await get_tree().create_timer(1.0).timeout
	print("[energia] CORRIENDO 1 s: %.1f/s (vel %.1f m/s)" % [(e0 - h.energia) / 1.0, Vector2(player.velocity.x, player.velocity.z).length()])
	var t := 0.0
	while h.fase == "invisible" and t < 20.0:
		await get_tree().process_frame
		t += get_process_delta_time()
	Input.action_release("sprint")
	Input.action_release("move_forward")
	print("[energia] se acaba a los %.1f s mas: fase '%s' · invisible %s · energia %.1f" % [t, h.fase, str(player.invisible), h.energia])
	await foto.call("vacia")
	print("[energia] lista con poca energia: %s" % str(h.lista()))
	await get_tree().create_timer(4.0).timeout
	print("[energia] 4 s despues: energia %.1f · lista %s" % [h.energia, str(h.lista())])
	await foto.call("vuelve")
	get_tree().quit(0)


## --blindajetest (con --personaje=9, el Specter): EL BLINDAJE. Un golpe de 50 sin y con el (lo que quita y la energia
## que gasta), que se apaga solo sin energia y que no va a la vez que la invisibilidad. Foto: user://blindaje_*.png
## --specterniveltest (con --personaje=9): EL SPECTER POR NIVELES, solo en memoria (no guarda). Nivel 1 y nivel 7: la
## energia maxima, el blindaje (+5 % a NV.7) y el SUPER SALTO (NV.4: mantener el salto 1 s; la altura frente a uno normal).
## --nanotrajefoto=<carpeta> (con --personaje=9): LOS EFECTOS DEL NANOTRAJE, en tiras de fotogramas: el BLINDAJE (la ola
## de hexagonos, puesto y un golpe por la izquierda), la INVISIBILIDAD (la onda) y el SUPER SALTO (carga, despegue, aire),
## en primera persona; y el brillo del traje en tercera. Solo en memoria (NV.7 para el super salto).
func _nanotraje_foto(dir: String) -> void:
	DirAccess.make_dir_recursive_absolute(dir)
	await get_tree().create_timer(8.0).timeout
	Settings._es_foto = 1
	Cuenta.perfil = {}
	Cuenta.token = ""
	Settings.niveles_personaje["specter"] = 7
	Cartas.refrescar()
	var h = player.get("_hab")
	h.energia_max = 160.0
	h.energia = 160.0
	player.invulnerable = false
	if hud:
		hud.visible = true
	var foto := func(n: String) -> void:
		await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("%s/%s.png" % [dir, n])
	var espera := func(s: float) -> void:
		await get_tree().create_timer(s).timeout
	await foto.call("0_normal")
	# EL BLINDAJE: la ola y puesto
	h.alternar_blindaje()
	for k in 5:
		await espera.call(0.12)
		await foto.call("1_blindaje_%d" % k)
	await espera.call(0.6)
	await foto.call("1_blindaje_puesto")
	# un golpe por la izquierda
	player.health = 100.0
	h.nano.golpe(player.global_position - player.global_transform.basis.x * 5.0, 0.6)
	player.take_damage(30.0, Vector3.ZERO)
	await espera.call(0.05)
	await foto.call("1_blindaje_golpe")
	await espera.call(0.8)
	h.alternar_blindaje()
	await espera.call(1.0)
	# LA INVISIBILIDAD: la onda y puesta
	h.recarga = 0.0
	h.energia = 160.0
	h.activar()
	for k in 5:
		await espera.call(0.12)
		await foto.call("2_invisible_%d" % k)
	await espera.call(0.8)
	await foto.call("2_invisible_puesta")
	h.al_disparar()          # se apaga
	await espera.call(1.2)
	# EL SUPER SALTO: carga, despegue y aire
	h.energia = 160.0
	h._energia_espera = 0.0
	player.set_touch_jump_hold(true)
	await espera.call(0.5)
	await foto.call("3_salto_carga_50")
	await espera.call(0.42)
	await foto.call("3_salto_carga_95")
	await espera.call(0.12)
	await foto.call("3_salto_despegue")
	await espera.call(0.25)
	await foto.call("3_salto_aire")
	player.set_touch_jump_hold(false)
	await espera.call(1.6)
	await foto.call("3_salto_aterriza")
	# EN TERCERA PERSONA: el brillo del traje (blindaje y su barrido)
	player.set_third_person(true)
	await espera.call(0.8)
	h.energia = 160.0
	h.alternar_blindaje()
	for k in 4:
		await espera.call(0.15)
		await foto.call("4_tercera_blindaje_%d" % k)
	await espera.call(0.6)
	await foto.call("4_tercera_blindaje_puesto")
	# EL COSTE: 2 s de cada cosa, ya encendidas una vez (lo de la primera vez es compilar)
	var medir := func(nombre: String) -> void:
		var n := 0
		var peor := 0.0
		var t0 := Time.get_ticks_usec()
		var ult := t0
		while Time.get_ticks_usec() - t0 < 2000000:
			await get_tree().process_frame
			var ahora := Time.get_ticks_usec()
			peor = maxf(peor, (ahora - ult) / 1000.0)
			ult = ahora
			n += 1
		print("[nanotrajefoto] %s: %.1f ms de media, peor %.1f" % [nombre, (Time.get_ticks_usec() - t0) / 1000.0 / maxf(1, n), peor])
	if h.blindaje:
		h.alternar_blindaje()
	player.set_third_person(false)
	await espera.call(1.0)
	await medir.call("nada")
	h.energia = 160.0
	h.alternar_blindaje()
	await espera.call(0.8)
	await medir.call("blindaje")
	h.alternar_blindaje()
	h.recarga = 0.0
	h.energia = 160.0
	h.activar()
	await espera.call(0.8)
	await medir.call("invisible")
	h.al_disparar()
	await espera.call(1.0)
	await medir.call("nada otra vez")
	print("[nanotrajefoto] hecho")
	get_tree().quit()


func _specter_nivel_test() -> void:
	await get_tree().create_timer(8.0).timeout
	Settings._es_foto = 1
	Cuenta.perfil = {}
	Cuenta.token = ""
	var h = player.get("_hab")
	var ok := true
	var poner_nivel := func(n: int) -> void:
		Settings.niveles_personaje["specter"] = n
		Cartas.refrescar()
		h.energia_max = h.ENERGIA_BASE + h.ENERGIA_POR_NIVEL * float(n - 1)
		h.energia = h.energia_max
	var salto := func(mantener: float) -> float:
		# en el suelo y quieto; aprieta, espera, suelta y mide lo mas alto
		for _i in 30:
			await get_tree().physics_frame
		var y0: float = player.global_position.y
		# como el boton del movil: apretado (button_down), mantenido y suelto (button_up + pressed)
		player.set_touch_jump_hold(true)
		var t := 0.0
		while t < mantener:
			await get_tree().physics_frame
			t += get_physics_process_delta_time()
		player.set_touch_jump_hold(false)
		player.do_touch_jump()
		var alto := 0.0
		for _i in 150:
			await get_tree().physics_frame
			alto = maxf(alto, player.global_position.y - y0)
		return alto
	for n in [1, 7]:
		poner_nivel.call(n)
		print("[specter] NV.%d: energia maxima %.0f · blindaje rebaja %.1f %% · super salto %s" % [n, h.energia_max,
			h.blindaje_reduccion() * 100.0, "SI" if h.super_salto_listo() else "no"])
	ok = ok and absf(h.energia_max - 160.0) < 0.1
	var e0: float = h.energia
	var normal: float = await salto.call(0.05)
	print("[specter] salto normal (toque): %.2f m · energia %.0f -> %.0f" % [normal, e0, h.energia])
	h.energia = h.energia_max
	e0 = h.energia
	var sup: float = await salto.call(1.2)
	print("[specter] SUPER SALTO (1,2 s apretado): %.2f m (x%.1f) · energia %.0f -> %.0f" % [sup, sup / maxf(normal, 0.01), e0, h.energia])
	ok = ok and sup > normal * 2.5 and (e0 - h.energia) >= h.energia_max * 0.5 - 30.0     # (vuelve algo al caer)
	# CON LA BARRA LLENA, DOS SEGUIDOS (cada uno gasta la mitad de la energia MAXIMA, no de la que queda)
	h.energia = h.energia_max
	h._energia_espera = 99.0          # sin que vuelva nada entre medias
	var s1: float = await salto.call(1.2)
	var tras1: float = h.energia
	h._energia_espera = 99.0
	var s2: float = await salto.call(1.2)
	print("[specter] dos seguidos con la barra llena (%.0f): %.2f m y %.2f m · energia %.0f -> %.0f -> %.0f" % [
		h.energia_max, s1, s2, h.energia_max, tras1, h.energia])
	ok = ok and s1 > normal * 2.5 and s2 > normal * 2.5
	h._energia_espera = 0.0
	h.energia = h.energia_max * 0.4
	var sin: float = await salto.call(1.2)
	print("[specter] sin media energia (1,2 s apretado): %.2f m (salto normal al soltar)" % sin)
	ok = ok and sin > normal * 0.7 and sin < normal * 1.5
	poner_nivel.call(3)
	var nv3: float = await salto.call(1.2)
	print("[specter] NV.3 (sin la ventaja), 1,2 s apretado: %.2f m" % nv3)
	ok = ok and nv3 > normal * 0.7 and nv3 < normal * 1.5
	print("[specter] %s" % ("TODO BIEN" if ok else "HAY FALLOS"))
	get_tree().quit(0 if ok else 1)


