## FALDAS DE LAS LOD, AUTOMATICAS (2026-09-23, pedido). Tapan las rendijas celestes del suelo lejano pero son
## ~9 % mas de triangulos (medido en Monaco). En PC van siempre. En el movil empiezan puestas y se vigilan los
## FPS: si pasan 10 s por debajo del 75 % de lo que se pide (el tope de FPS, o 60), se quitan; si con ellas
## quitadas pasan 30 s por encima del 95 %, se vuelven a poner. Como mucho 4 cambios por sesion: cada cambio
## remalla el mapa entero (a prioridad baja) y no puede ir y venir. `--sinfaldas` / `--confaldas` las fuerzan.
var faldas_on := true

func _faldas_auto() -> void:
	var args := OS.get_cmdline_user_args()
	var forzado := "--sinfaldas" in args or "--confaldas" in args
	faldas_on = not ("--sinfaldas" in args)
	var cambios := 0
	var malo := 0.0
	var bueno := 0.0
	var aplicado := true      # lo que tiene el motor (el Engine nuevo de cada mapa nace con ellas puestas)
	var mundo_visto: Object = null
	await get_tree().create_timer(15.0).timeout   # la carga y el calentamiento no cuentan
	while is_inside_tree():
		await get_tree().create_timer(1.0).timeout
		if world == null or not world.has_method("set_faldas_lod"):
			continue
		if world != mundo_visto:
			mundo_visto = world
			aplicado = true
		if not forzado and Settings.is_touch() and cambios < 4:
			var objetivo: float = float(Engine.max_fps) if Engine.max_fps > 0 else 60.0
			var fps: float = Engine.get_frames_per_second()
			malo = malo + 1.0 if fps < objetivo * 0.75 else 0.0
			bueno = bueno + 1.0 if fps > objetivo * 0.95 else 0.0
			if faldas_on and malo >= 10.0:
				faldas_on = false
				cambios += 1
				malo = 0.0
				print("[faldas] fuera: %.0f fps de %.0f" % [fps, objetivo])
			elif not faldas_on and bueno >= 30.0:
				faldas_on = true
				cambios += 1
				bueno = 0.0
				print("[faldas] puestas otra vez: %.0f fps" % fps)
		if aplicado != faldas_on:
			world.set_faldas_lod(faldas_on)
			aplicado = faldas_on


# ---------------------------------------------------------------------------
# OLEADAS: DE DIA HASTA LA 5, Y AHI ANOCHECE (2026-09-23, pedido). Cada maquina lo decide sola con el numero
# de oleada (al invitado le llega por red), asi que no hace falta mensaje nuevo. La transicion dura 20 s: se
# interpolan la energia y el color del sol, el cielo, el ambiente y la niebla. El sol NO se gira durante la
# transicion (girarlo rehace las sombras y la sombra horneada del mapa entero): se gira una vez al final,
# cuando ya es luna y no se nota. Luego set_night(true) deja todo exactamente como la noche de siempre.
# ---------------------------------------------------------------------------
const OLEADA_NOCHE := 5
const ANOCHECER_S := 20.0
var _anochecer_t := -1.0

func _dia_noche_pve(delta: float) -> void:
	if not loading:
		Estadisticas.tick(delta)
	if pve != null:
		Estadisticas.maximo("oleada_max", int(pve.oleada))
	if pve == null or night:
		return
	if _anochecer_t < 0.0:
		if int(pve.oleada) >= OLEADA_NOCHE:
			if _day.is_empty():
				_save_day()
			_anochecer_t = 0.0
			if hud:
				hud.flash_message("ANOCHECE...")
			print("[pve] anochece (oleada %d)" % int(pve.oleada))
		return
	_anochecer_t += delta
	var k: float = smoothstep(0.0, 1.0, clampf(_anochecer_t / ANOCHECER_S, 0.0, 1.0))
	var e: Environment = env.environment
	sun.light_energy = lerpf(float(_day["sun_e"]), 0.10, k)
	sun.light_color = (_day["sun_c"] as Color).lerp(Color(0.55, 0.63, 0.95), k)
	e.background_color = (_day["bg"] as Color).lerp(Color(0.02, 0.025, 0.05), k)
	e.ambient_light_color = (_day["amb_c"] as Color).lerp(Color(0.10, 0.13, 0.24), k)
	e.ambient_light_energy = lerpf(float(_day["amb_e"]), 0.10, k)
	e.fog_light_color = (_day["fog_c"] as Color).lerp(Color(0.05, 0.06, 0.12), k)
	if k >= 1.0:
		_anochecer_t = -1.0
		print("[pve] ya es de noche")
		set_night(true)      # el giro del sol, los faroles y la luna: la noche de siempre


# ---------------------------------------------------------------------------
# LINTERNA (2026-09-23, pedido). Un foco en la camara del jugador: tecla L en el PC, boton LINTERNA en el
# movil (mobile_controls.gd, solo en oleadas). Sin sombra: una luz con sombra que se mueve con la camara
# cuesta demasiado en el movil. Solo es de quien la lleva (los demas no la ven).
# ---------------------------------------------------------------------------
var _linterna: SpotLight3D = null
var _linterna_encendida := false
var _linterna_tope := 36.0
var _linterna_t := 0.0
const LinternaCorte := preload("res://scripts/linterna_corte.gd")


## La luz se corta en la primera pared (linterna_corte.gd)
func _linterna_tick(delta: float) -> void:
	if _linterna == null or not _linterna_encendida or not is_instance_valid(_linterna):
		return
	_linterna_t -= delta
	if _linterna_t <= 0.0:
		_linterna_t = LinternaCorte.CADA_S
		LinternaCorte.ajustar(_linterna, world, _linterna_tope)

## Un foco que se mueve con la cámara y alcanza 65 m obliga a recalcular iluminación
## sobre una parte enorme de la pantalla. La linterna sirve para recorrer el entorno
## cercano: 28-40 m siguen siendo útiles y recortan de forma marcada ese coste.
func _aplicar_calidad_linterna() -> void:
	if _linterna == null or not is_instance_valid(_linterna):
		return
	var nivel: int = clampi(Settings.gfx_value("light_distance", quality), 0, 5)
	var alcance: float = [0.0, 28.0, 32.0, 36.0, 40.0, 44.0][nivel]
	_linterna_tope = alcance
	_linterna.spot_range = alcance
	_linterna.light_energy = 7.0 if nivel <= 2 else 8.0
	_linterna.visible = _linterna_encendida and nivel > 0

func alternar_linterna() -> void:
	if player == null or not ("cam" in player) or player.cam == null:
		return
	if _linterna == null or not is_instance_valid(_linterna):
		_linterna = SpotLight3D.new()
		_linterna.name = "Linterna"
		_linterna.light_color = Color(1.0, 0.95, 0.85)
		_linterna.light_energy = 8.0
		_linterna.spot_range = 36.0
		_linterna.spot_angle = 24.0
		_linterna.spot_attenuation = 0.35
		_linterna.shadow_enabled = false
		_linterna.visible = false
		# DE LA CABEZA, NO DE LA CAMARA (2026-09-23): en tercera persona la camara va detras del hombro y el foco
		# te iluminaba la espalda. La cabeza gira con la mirada en las dos vistas; se pone 0,35 m por delante de
		# los ojos para que el haz no nazca dentro del propio cuerpo.
		var anclaje: Node3D = player.head if ("head" in player and player.head != null) else player.cam
		anclaje.add_child(_linterna)
		_linterna.position = Vector3(0.12, -0.08, -0.35)
	_linterna_encendida = not _linterna_encendida
	_aplicar_calidad_linterna()
	Net.net_linterna(_linterna_encendida)

func _unhandled_key_input(ev: InputEvent) -> void:
	if ev is InputEventKey and ev.pressed and not ev.echo and (ev as InputEventKey).keycode == KEY_L and not _vivo:
		alternar_linterna()


