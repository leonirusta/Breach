## MODO ATRACO (la ciudad). Caja fuerte en una planta alta de un edificio, terminal de ingreso
## lejos y a ras de calle. Ver scripts/heist.gd.
## ---------------------------------------------------------------------------
var heist: Node = null
var _atraco_n := 0                   ## cuantos atracos van (lo lleva el anfitrion)
var _atraco_ultimo_cobrado := 0      ## el id del ultimo ingreso cobrado: sus estados viejos ya no valen

func _start_heist() -> void:
	if is_instance_valid(heist):
		heist.queue_free()
	var v: Vector3 = _caja_siguiente if _caja_siguiente != Vector3.ZERO else _pick_vault_spot(_cajas_usadas)
	_caja_siguiente = Vector3.ZERO
	if v == Vector3.ZERO:
		v = _pick_vault_spot()          # ya salieron cajas en todos los edificios que valen: se repite
	if v == Vector3.ZERO:
		return
	var c: Vector3 = _pick_cashout_spot(v)
	heist = preload("res://scripts/heist.gd").new()
	heist.name = "Heist"
	# QUE ATRACO ES. El anfitrion (o el que juega solo) los cuenta; el invitado monta el suyo con -1 y
	# lo coloca donde diga el primer estado que llegue del anfitrion (heist._aplicar_estado).
	if Net.is_online() and not Net.hosting:
		heist.heist_id = -1
	else:
		_atraco_n += 1
		heist.heist_id = _atraco_n
	add_child(heist)
	heist.add_to_group("heist")
	heist.setup(player, world, hud)
	heist.place(v, c)
	if ciudad3:
		_cajas_usadas.append(v)
		heist.cash_deposited.connect(_ciudad_ingreso)
		# los bots van a la caja NUEVA: el centro de la pelea se mueve con ella
		dm_centro = _ground_near(Vector3(v.x, 0.6, v.z))
		for e in enemies.get_children():
			if "team" in e and String(e.team) != "":
				_dm_rol(e, _base_de(String(e.team)))
		hud.set_puntos_equipos(puntos_equipo, PUNTOS_GANAR)
	else:
		heist.cash_deposited.connect(func(pts: int, _eq: String):
			hud.flash_message("ATRACO COMPLETADO · +%d" % pts))
	print("[atraco] caja en %.0f,%.0f,%.0f · terminal en %.0f,%.0f,%.0f (%.0f m)"
		% [v.x, v.y, v.z, c.x, c.y, c.z, Vector2(v.x - c.x, v.z - c.z).length()])


## Hueco libre en una planta: sin techo pegado encima y con sitio alrededor para el armario.
func _room_free(pos: Vector3) -> bool:
	var up: Dictionary = world.raycast(pos + Vector3(0, 0.15, 0), Vector3.UP, 2.6)
	if up.hit:
		return false
	for d in [Vector3.RIGHT, Vector3.LEFT, Vector3.FORWARD, Vector3.BACK]:
		var r: Dictionary = world.raycast(pos + Vector3(0, 0.9, 0), d, 1.3)
		if r.hit:
			return false
	return true


## Suelos de un edificio, de arriba abajo: se echa un rayo desde el tejado y se va reanudando por
## debajo de cada forjado que encuentra.
func _floors_at(x: float, z: float, top: float) -> Array:
	var out: Array = []
	var y := top - 0.6
	while y > 1.0 and out.size() < 24:
		var r: Dictionary = world.raycast(Vector3(x, y, z), Vector3.DOWN, y)
		if not r.hit:
			break
		out.append(r.position.y)
		y = r.position.y - 0.8
	return out


## LA CAJA FUERTE, EN CUALQUIER EDIFICIO Y AL AZAR: un rascacielos o una casa, en cualquier planta
## menos la azotea (la planta baja de una casa tambien vale). Antes solo salia en edificios de mas de
## 8 m y siempre en los mismos: tras ingresar un cubo, la siguiente acababa en el mismo sitio.
##
## `excluir`: donde ya salieron cajas; la nueva sale a mas de 30 m de todas.
func _pick_vault_spot(excluir: Array = []) -> Vector3:
	return _planta_al_azar(excluir, 30.0)


## DONDE HAY EDIFICIOS. `world.get_building_centers()` solo lo rellena el generador de la ciudad
## procedural: en un mapa importado (Monaco, dust2, hangar) viene vacio, y sin el la caja fuerte no
## tenia donde salir y el atraco no arrancaba.
##
## Para esos mapas se buscan a mano: se barre una rejilla, se tira un rayo desde arriba y se queda con
## los puntos cuyo techo esta bien por encima de la calle. Un tejado a 6 m o mas es un edificio; lo que
## esta a ras de suelo es plaza, calle o escombro. Se calcula UNA vez por mapa y se guarda.
var _centros_cache: PackedVector3Array = PackedVector3Array()
var _centros_cache_mapa := ""

func _centros_edificios() -> PackedVector3Array:
	var propios: PackedVector3Array = world.get_building_centers()
	if not propios.is_empty():
		return propios
	if _centros_cache_mapa == current_map and not _centros_cache.is_empty():
		return _centros_cache
	var t0 := Time.get_ticks_msec()
	var size: Vector3 = world.get_world_size()
	var suelo: float = world.get_spawn_position().y
	var out := PackedVector3Array()
	# UN RAYO POR PUNTO Y SE ACABO. Aqui se llamaba ademas a `_floors_at`, que tira hasta 24 rayos:
	# 546 puntos x 25 rayos son 13.650 RAYOS EN UN SOLO FOTOGRAMA. En el PC ni se nota y en un movil
	# es un cuelgue de varios segundos al entrar al mapa -que es justo lo que pasaba-.
	# No hace falta: el rayo de altura ya separa "edificio" de "calle", y si un candidato resulta no
	# tener plantas dentro, `_planta_al_azar` lo descarta cuando le toque. Es mejor comprobar CARO
	# unos pocos candidatos que comprobar todos los puntos del mapa por si acaso.
	# REJILLA FINA Y MOVIDA CADA PARTIDA. Con un paso de 9 m y sin desplazar, en Monaco salian 43
	# sitios SIEMPRE LOS MISMOS: la caja acababa rebotando entre el mismo puñado de edificios, y las
	# casas pequeñas no aparecian nunca porque el rayo caia en la calle de al lado. Ahora el paso es
	# la mitad y cada muestra se mueve al azar dentro de su celda, asi que el conjunto de candidatos
	# cambia en cada partida y entran edificios que antes la rejilla se saltaba.
	# Cuesta un rayo por punto (~1.000 rayos, 10-12 ms UNA vez por mapa), no los 13.650 de antes.
	var paso: float = maxf(5.0, size.x / 32.0)
	var x: float = paso
	while x < size.x - paso:
		var z: float = paso
		while z < size.z - paso:
			var px: float = clampf(x + _azar_mapa().randf_range(-paso * 0.4, paso * 0.4), paso, size.x - paso)
			var pz: float = clampf(z + _azar_mapa().randf_range(-paso * 0.4, paso * 0.4), paso, size.z - paso)
			var r: Dictionary = world.raycast(Vector3(px, size.y - 1.0, pz), Vector3.DOWN, size.y)
			# ALTO DE VERDAD, no un pretil ni un toldo: 6 m son dos plantas.
			if r.get("hit", false) and float(r.position.y) > suelo + 6.0:
				out.append(Vector3(px, float(r.position.y), pz))
			z += paso
		x += paso
	_centros_cache = out
	_centros_cache_mapa = current_map
	print("[atraco] %s: %d sitios con edificio en %d ms (el mapa no trae centros)" % [
		current_map, out.size(), Time.get_ticks_msec() - t0])
	return out


## EL AZAR DEL MAPA, COMPARTIDO. En red sale de `Net.semilla_partida` (la manda el anfitrion al empezar),
## asi que todas las maquinas eligen el MISMO edificio, planta y calle en el mismo orden. Solo, cada
## partida es distinta. Tiene su propio generador y no el global: el global lo gastan tambien las
## particulas, los bots y mil cosas mas, en distinto orden en cada maquina, y se desincronizaria.
var _rng_mapa: RandomNumberGenerator = null

func _azar_mapa() -> RandomNumberGenerator:
	if _rng_mapa == null:
		_rng_mapa = RandomNumberGenerator.new()
		if Net.is_online() and Net.semilla_partida != 0:
			_rng_mapa.seed = Net.semilla_partida
			print("[red] sorteos del mapa con la semilla de la partida %d" % Net.semilla_partida)
		else:
			_rng_mapa.randomize()
	return _rng_mapa


## Barajar con el azar del mapa (Array.shuffle usa el global).
func _barajar(a: Array) -> void:
	var rng := _azar_mapa()
	for i in range(a.size() - 1, 0, -1):
		var j := rng.randi_range(0, i)
		var t = a[i]
		a[i] = a[j]
		a[j] = t


## Una planta libre de un edificio cualquiera, todo al azar: edificio, rincon de la planta y planta.
## ZERO si no se encuentra ninguna.
func _planta_al_azar(excluir: Array, lejos: float) -> Vector3:
	var size: Vector3 = world.get_world_size()
	var centers: PackedVector3Array = _centros_edificios()
	var orden: Array = range(centers.size())
	_barajar(orden)
	# TOPE DE CANDIDATOS. Cada uno cuesta hasta 7 rincones x (24 rayos de `_floors_at` + 5 de
	# `_room_free`): con 170 candidatos y ninguno valido son 34.000 rayos en un fotograma. Se prueban
	# 24 como mucho; si en 24 edificios al azar no hay una planta libre, el mapa no tiene donde poner
	# la caja y da igual seguir buscando.
	var probados := 0
	for i in orden:
		probados += 1
		if probados > 40:
			break
		var c: Vector3 = centers[i]
		var repetida := false
		for u in excluir:
			if Vector2(c.x - u.x, c.z - u.z).length() < lejos:
				repetida = true
				break
		if repetida:
			continue
		var r: Dictionary = world.raycast(Vector3(c.x, size.y - 1.0, c.z), Vector3.DOWN, size.y)
		if not r.hit or r.position.y < 2.0:          # sin tejado encima: no es un edificio
			continue
		# varios puntos de la planta, porque el centro exacto puede caer en un tabique, un mueble o la
		# escalera
		var rincones: Array = [Vector3.ZERO, Vector3(1.6, 0, 0), Vector3(-1.6, 0, 0), Vector3(0, 0, 1.6),
			Vector3(0, 0, -1.6), Vector3(2.6, 0, 2.6), Vector3(-2.6, 0, -2.6)]
		_barajar(rincones)
		for off in rincones:
			var fl: Array = _floors_at(c.x + off.x, c.z + off.z, r.position.y)
			if fl.size() < 2:
				continue
			# todas las plantas menos la azotea (la primera de la lista, que va de arriba abajo)
			var plantas: Array = range(1, fl.size())
			_barajar(plantas)
			for k in plantas:
				var pos := Vector3(c.x + off.x, float(fl[k]) + 0.02, c.z + off.z)
				if _room_free(pos):
					return pos
	return Vector3.ZERO


## EL TERMINAL, TAMBIEN AL AZAR: la mitad de las veces en una calle cualquiera y la otra mitad dentro de
## un edificio cualquiera, siempre a mas de 40 m de la caja (el cubo hay que llevarlo a algun sitio).
## Antes era siempre la calle mas lejana a la caja: un sitio fijo por cada caja.
func _pick_cashout_spot(vault_pos: Vector3) -> Vector3:
	if _azar_mapa().randf() < 0.5:
		var dentro := _planta_al_azar([vault_pos], 40.0)
		if dentro != Vector3.ZERO:
			return dentro
	var size: Vector3 = world.get_world_size()
	var calles: Array = []
	var step: float = maxf(8.0, size.x / 14.0)
	var x := step
	while x < size.x - step:
		var z := step
		while z < size.z - step:
			var r: Dictionary = world.raycast(Vector3(x, size.y - 1.0, z), Vector3.DOWN, size.y)
			z += step
			if not r.hit or r.position.y > 1.2 or r.position.y < 0.0:   # tejado, bordillo alto o hueco
				continue
			if Vector2(r.position.x - vault_pos.x, r.position.z - vault_pos.z).length() < 40.0:
				continue
			if _room_free(r.position):
				calles.append(r.position + Vector3(0, 0.02, 0))
		x += step
	if calles.is_empty():
		return world.find_ground(vault_pos + Vector3(30, 0, 30))
	return calles[_azar_mapa().randi() % calles.size()]


## Diagnostico del atraco: donde han caido la caja y el terminal, si se puede llegar a la caja
## (planta con altura libre) y si el cubo se queda quieto sobre el forjado al abrirla.
func _heist_test() -> void:
	await get_tree().create_timer(3.0).timeout
	if not is_instance_valid(heist):
		print("[atraco] NO se coloco el modo")
		get_tree().quit()
		return
	var v: Vector3 = heist.vault.global_position
	var c: Vector3 = heist.cashout.global_position
	var head: Dictionary = world.raycast(v + Vector3(0, 0.2, 0), Vector3.UP, 6.0)
	print("[atraco] caja %.1f,%.1f,%.1f · altura libre %.2f m" % [v.x, v.y, v.z, (head.position.y - v.y) if head.hit else 6.0])
	print("[atraco] terminal %.1f,%.1f,%.1f · distancia %.0f m" % [c.x, c.y, c.z, Vector2(v.x - c.x, v.z - c.z).length()])
	player.global_position = v + Vector3(0, 1.0, -1.4)
	heist._open_vault()
	await get_tree().create_timer(2.0).timeout
	var cu = heist.cube
	print("[atraco] cubo en %.1f,%.1f,%.1f (cayo %.2f m, %s)" % [cu.global_position.x, cu.global_position.y, cu.global_position.z,
		(v.y + 0.9) - cu.global_position.y, "reposa" if cu.linear_velocity.length() < 0.5 else "en movimiento"])
	heist.grab()
	await get_tree().create_timer(1.5).timeout
	var d: float = cu.global_position.distance_to(player.global_position + Vector3(0, 1.1, 0))
	print("[atraco] telequinesis: cubo a %.2f m del jugador · carrying=%s" % [d, str(player.carrying_cube)])
	var before: Vector3 = cu.global_position
	player.fire()
	await get_tree().create_timer(1.0).timeout
	print("[atraco] tras disparar: carrying=%s · el cubo se movio %.2f m" % [str(player.carrying_cube), before.distance_to(cu.global_position)])
	get_tree().quit()


## LA C4 EMPIEZA EN EL SUELO. Antes aparecia ya en las manos del terrorista, sin mas. Ahora se
## deja en la base terrorista y hay que ir a por ella: se recoge al pasar cerca.
var loose_c4: Node = null

func spawn_loose_c4() -> void:
	if not bomb_mode:
		return
	if is_instance_valid(loose_c4):
		loose_c4.queue_free()
	# quitarsela a todo el mundo: la que cuenta es la del suelo
	if is_instance_valid(player):
		for i in Weapons.LIST.size():
			if String(Weapons.LIST[i].get("kind", "")) == "c4":
				player.set_ammo(i, 0)
		player.dropped_bomb = null
	var base: Vector3 = world.get_spawn_position()   # el spawn del mapa es la base terrorista
	# el radio de recogida es de 1,8 m: si la dejas a 1,2 m se pega sola al terrorista antes de que
	# de un paso. Se aparta lo justo para que haya que ir a buscarla, sin cruzar medio mapa.
	spawn_loose_c4_at(base + Vector3(4.6, 1.0, 2.2))
	# el aviso es cosa de los terroristas: la policia no va a por ninguna bomba
	if hud and is_instance_valid(player) and player.team != Net.TEAM_CT:
		hud.flash_message("La C4 esta en la base terrorista: id a por ella")


## Deja una C4 recogible en el suelo, en el punto solido mas cercano a `pos`. La usan tanto el
## inicio de ronda como el terrorista que muere llevandola (para que la coja un companero).
func spawn_loose_c4_at(pos: Vector3) -> void:
	if world == null:
		return
	if is_instance_valid(loose_c4):
		loose_c4.queue_free()
	var g: Vector3 = world.find_ground(pos)
	var BombScript := preload("res://scripts/bomb.gd")
	loose_c4 = BombScript.new()
	loose_c4.name = "C4Suelo"
	add_child(loose_c4)
	loose_c4.setup(world, loose_c4.State.DROPPED)
	loose_c4.global_position = (g if g.y > -100.0 else pos) + Vector3(0, 0.12, 0)


func spawn_bomb(xf: Transform3D) -> Node:
	var BombScript := preload("res://scripts/bomb.gd")
	if is_instance_valid(Net.bomb_node):
		Net.bomb_node.queue_free()
	var node = BombScript.new()
	node.name = "C4"
	add_child(node)
	node.global_transform = xf
	node.setup(world, node.State.PLANTED)
	node.exploded.connect(func(pos: Vector3):
		if effects and effects.has_method("explosion"):
			effects.explosion(pos, node.BLAST_RADIUS)
		hud.flash_message("¡LA BOMBA HA EXPLOTADO!"))
	node.defused.connect(func(): hud.flash_message("¡BOMBA DESACTIVADA!"))
	Audio.play_file("res://sounds/c4plant.ogg", xf.origin, 0.0, Audio.PRI_HIGH)
	hud.flash_message("C4 PLANTADA. %0.0f s para la detonacion." % node.FUSE)
	return node


# ---------------------------------------------------------------------------
# ELECCION DE BANDO. Aparece nada mas entrar: panel semitransparente, TERRORISTAS a un lado y
# POLICIA al otro. En partida LAN el anfitrion arbitra el equilibrio, asi que con dos jugadores
# sale 1 y 1: en cuanto uno coge un bando, al otro solo le queda el contrario.
# ---------------------------------------------------------------------------
var team_overlay: CanvasLayer = null

func show_team_select() -> void:
	if team_overlay:
		return
	# MODO PvE: no hay bandos. Se entra directo y empiezan las oleadas.
	if Settings.modo == "pve":
		_empezar_pve()
		return
	# DUELO A MUERTE Y ATRACO: NO SE ELIGE COLOR. Entras y ya estas jugando.
	#
	# Ahi el equipo no cambia a lo que juegas -no hay atacante ni defensor, todos hacen lo mismo-, asi
	# que la pantalla solo servia para parar la partida y pedirte que eligieras un color. En bomba si
	# se queda: terrorista y policia no juegan a lo mismo y eso si es una decision.
	if dm_mode or ciudad3:
		_equipo_automatico()
		return
	# CON TU EQUIPO DEL LOBBY (grupo.gd) no se elige bando: el lider elige y los demas van con el (Net._set_team)
	if Net.sigo_a_mi_lider():
		_equipo_automatico()
		return
	get_tree().paused = false
	if is_instance_valid(player):
		player.invulnerable = true      # eligiendo bando no te pueden tocar
	team_overlay = CanvasLayer.new()
	team_overlay.layer = 90
	add_child(team_overlay)
	var back := ColorRect.new()
	back.set_anchors_preset(Control.PRESET_FULL_RECT)
	back.color = Color(0.02, 0.025, 0.035, 0.72)     # semitransparente: se ve el mapa detras
	team_overlay.add_child(back)
	var v := VBoxContainer.new()
	v.set_anchors_preset(Control.PRESET_FULL_RECT)
	v.alignment = BoxContainer.ALIGNMENT_CENTER
	v.add_theme_constant_override("separation", 18)
	team_overlay.add_child(v)
	var t := Label.new()
	t.text = "ELIGE TU EQUIPO" if (dm_mode or ciudad3) else "ELIGE TU BANDO"
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	t.add_theme_font_size_override("font_size", 40)
	t.add_theme_color_override("font_color", Color(1.0, 0.78, 0.05))
	v.add_child(t)
	var sub := Label.new()
	sub.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	sub.add_theme_font_size_override("font_size", 16)
	sub.add_theme_color_override("font_color", Color(0.72, 0.74, 0.78))
	v.add_child(sub)
	var row := HBoxContainer.new()
	row.alignment = BoxContainer.ALIGNMENT_CENTER
	row.add_theme_constant_override("separation", 28)
	v.add_child(row)
	var cards := {}
	# EN DUELO A MUERTE NO HAY BOMBA NI TERRORISTAS: son el EQUIPO NARANJA y el EQUIPO AZUL (los nombres
	# salen de Net.nombre_equipo, igual que en el marcador y en la pantalla de victoria)
	# Y EN LA CIUDAD, TRES: una tarjeta por equipo de la partida (Net.equipos), con su nombre y su color
	var specs: Array = []
	for eq in Net.equipos:
		var desc := ""
		if ciudad3:
			desc = "Abre la caja fuerte y lleva el cubo al terminal antes que los otros dos equipos."
		elif dm_mode:
			desc = "Primer equipo en llegar a %d bajas gana." % dm_objetivo
		elif eq == Net.TEAM_T:
			desc = "Llevan la C4. Hay que plantarla en el sitio A o B."
		else:
			desc = "Hay que impedirlo, o desactivar la bomba a tiempo."
		specs.append([eq, Net.nombre_equipo(eq), desc, Net.color_equipo(eq)])
	for spec in specs:
		var id := String(spec[0])
		var b := Button.new()
		b.focus_mode = Control.FOCUS_NONE
		b.custom_minimum_size = Vector2(320, 190)
		b.pressed.connect(func(): _pick_team(id))
		var bv := VBoxContainer.new()
		bv.mouse_filter = Control.MOUSE_FILTER_IGNORE
		bv.set_anchors_preset(Control.PRESET_FULL_RECT)
		bv.alignment = BoxContainer.ALIGNMENT_CENTER
		bv.add_theme_constant_override("separation", 8)
		var nm := Label.new()
		nm.text = String(spec[1])
		nm.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		nm.add_theme_font_size_override("font_size", 28)
		nm.mouse_filter = Control.MOUSE_FILTER_IGNORE
		bv.add_child(nm)
		var ds := Label.new()
		ds.text = String(spec[2])
		ds.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		ds.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		ds.custom_minimum_size = Vector2(280, 0)
		ds.add_theme_font_size_override("font_size", 14)
		ds.add_theme_color_override("font_color", Color(0.78, 0.80, 0.84))
		ds.mouse_filter = Control.MOUSE_FILTER_IGNORE
		bv.add_child(ds)
		var cnt := Label.new()
		cnt.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		cnt.add_theme_font_size_override("font_size", 16)
		cnt.add_theme_color_override("font_color", Color(1.0, 0.78, 0.05))
		cnt.mouse_filter = Control.MOUSE_FILTER_IGNORE
		bv.add_child(cnt)
		b.add_child(bv)
		row.add_child(b)
		cards[id] = {"button": b, "count": cnt, "color": spec[3]}
	_team_cards = cards
	_team_sub = sub
	if not Net.teams_changed.is_connected(_refresh_team_cards):
		Net.teams_changed.connect(_refresh_team_cards)
	_refresh_team_cards()
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	player.set_process_input(false)
	for f in OS.get_cmdline_user_args():
		if f.begins_with("--pickteam="):   # pruebas automaticas
			await get_tree().create_timer(1.5).timeout
			var want := f.substr(11)
			_pick_team(want)
			await get_tree().create_timer(1.5).timeout
			print("[teamtest] pedi '%s' -> me toco '%s'  (T=%d, CT=%d)" % [want, Net.my_team(), Net.team_count(Net.TEAM_T), Net.team_count(Net.TEAM_CT)])


var _team_cards: Dictionary = {}
var _team_sub: Label = null

func _refresh_team_cards() -> void:
	if _team_cards.is_empty():
		return
	for id in _team_cards.keys():
		var c: Dictionary = _team_cards[id]
		var free: bool = Net.team_available(String(id))
		var col: Color = c["color"]
		var sb := StyleBoxFlat.new()
		sb.bg_color = Color(col.r, col.g, col.b, 0.22) if free else Color(0.10, 0.10, 0.12, 0.8)
		sb.set_corner_radius_all(8)
		sb.set_border_width_all(2)
		sb.border_color = col if free else Color(0.3, 0.3, 0.33)
		c["button"].add_theme_stylebox_override("normal", sb)
		var hb := sb.duplicate()
		hb.bg_color = Color(col.r, col.g, col.b, 0.38)
		c["button"].add_theme_stylebox_override("hover", hb)
		c["button"].disabled = not free
		c["count"].text = "%d en este %s%s" % [Net.team_count(String(id)), "equipo" if (dm_mode or ciudad3) else "bando", "" if free else "   ·   COMPLETO"]
	if _team_sub:
		_team_sub.text = "Los equipos se reparten a partes iguales: con dos jugadores, uno de cada." if Net.is_online() else ("Partida sin red: elige con qué equipo juegas." if (dm_mode or ciudad3) else "Partida sin red: elige con qué bando juegas.")


## EL EQUIPO MAS VACIO, y a jugar. Se reparte por tamano para que no acaben seis contra uno; entre
## los que empatan manda el orden de `Net.equipos`, que es igual en todas las maquinas.
func _equipo_automatico() -> void:
	get_tree().paused = false
	var elegido := ""
	var menos := 1 << 30
	for e in Net.equipos:
		var id := String(e)
		if not Net.team_available(id):
			continue
		var n := Net.team_count(id)
		if n < menos:
			menos = n
			elegido = id
	if elegido == "":
		elegido = String(Net.equipos[0])
	# CON TU EQUIPO DEL LOBBY (grupo.gd): al bando de tu lider. Si aun esta eligiendo, se le espera un poco (el
	# anfitrion igualmente te pone con el o con un compañero: Net._set_team)
	if Net.sigo_a_mi_lider():
		for i in 32:
			if Net.bando_de_mi_grupo() != "":
				break
			await get_tree().create_timer(0.25).timeout
		if Net.bando_de_mi_grupo() != "":
			elegido = Net.bando_de_mi_grupo()
	Net.choose_team(elegido)
	# En red manda el anfitrion: si el que pedimos estaba lleno, te pone en otro. Se espera su
	# respuesta igual que en la eleccion a mano, o apareceriamos sin equipo.
	if Net.is_online():
		for i in 40:
			await get_tree().create_timer(0.05).timeout
			if Net.my_team() != "":
				break
	_close_team_select()


func _pick_team(id: String) -> void:
	if not Net.team_available(id):
		return
	Net.choose_team(id)
	# En LAN manda el anfitrion: se espera su respuesta. Si el bando pedido estaba lleno te pone en
	# el contrario, para que los equipos queden 1 y 1 y nadie se quede sin bando.
	if Net.is_online():
		for i in 40:
			await get_tree().create_timer(0.05).timeout
			if Net.my_team() != "":
				break
		if Net.my_team() == "":
			hud.flash_message("El anfitrion no responde: intentalo otra vez")
			_refresh_team_cards()
			return
		if Net.my_team() != id:
			hud.flash_message("Ese bando estaba completo: te toca el otro")
	_close_team_select()


## MODO PvE (scripts/pve.gd): sin bandos ni bots de equipo; las criaturas salen por oleadas.
var pve: Node = null

func _empezar_pve() -> void:
	get_tree().paused = false
	if not is_instance_valid(player):
		return
	player.invulnerable = false
	player.set_process_input(true)
	if not Settings.is_touch():
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	for e in enemies.get_children():
		e.queue_free()
	# EMPIEZAS EN LA BASE DE LA POLICIA, no en el punto de salida generico del mapa: en hangar ese punto
	# esta en un cuarto cerrado y las criaturas no llegaban nunca (se quedaban saltando contra la pared)
	if not bomb_sites.is_empty() or ct_spawn != Vector3.ZERO:
		spawn_at_team_base(Net.TEAM_CT)
	# DE NOCHE SIEMPRE. El modo va de pasar miedo y el mapa esta hecho para eso: con el sol alto no se
	# ven ni los faroles ni las luces rojas de emergencia, que es la mitad de la ambientacion. La noche
	# es un interruptor del menu, asi que se enciende al entrar (y el jugador puede volver a apagarla).
	# EMPIEZA DE DIA (2026-09-23, pedido): la noche llega en la oleada 5, con transicion suave (_dia_noche_pve).
	# LA CAMPAÑA COOPERATIVA (campana.gd): si el mapa trae su historia (<mapa>.campana.json) el PvE es la
	# campaña, no las oleadas. De noche cerrada desde el principio y sin lluvia, como la ciudad de Left 4 Dead.
	var es_campana := FileAccess.file_exists("res://maps/%s.campana.json" % current_map)
	var cfg_hora := {}
	if es_campana:
		var jc = JSON.parse_string(FileAccess.get_file_as_string("res://maps/%s.campana.json" % current_map))
		if jc is Dictionary:
			cfg_hora = jc
	if es_campana and String(cfg_hora.get("hora", "")) == "tormenta":
		# EL EPISODIO 5 ES DE NOCHE Y CON TORMENTA (2026-09-28): lluvia, relampagos y truenos
		if not night:
			set_night(true)
		if not raining:
			set_rain(true)
		cielo_noche_cerrada()           # despues de la lluvia: sus nubes, negras (la lluvia las deja plomizas)
	elif es_campana and String(cfg_hora.get("hora", "")) == "volcan":
		# EL EPISODIO 8 ES DE NOCHE EN UN VOLCAN (2026-10-02): noche cerrada con el resplandor rojo de la lava
		if not night:
			set_night(true)
		if raining:
			set_rain(false)
		cielo_noche_cerrada()
		cielo_volcan()
	elif es_campana and String(cfg_hora.get("hora", "")) == "anochecer":
		# EL EPISODIO 7 ES AL ANOCHECER (2026-10-01): la hora azul, con los neones del parque encendidos
		cielo_anochecer(float(cfg_hora.get("sol_azimut", 250.0)))
	elif es_campana and String(cfg_hora.get("hora", "")) == "nevada":
		# EL EPISODIO 6 ES DE DIA Y NEVANDO (2026-09-30): el lago helado y la montaña
		cielo_nevado(float(cfg_hora.get("sol_azimut", 200.0)))
	elif es_campana and String(cfg_hora.get("hora", "")) == "atardecer":
		# EL EPISODIO 4 ES DE TARDE (2026-09-28): el sol se pone detras de la presa
		if raining:
			set_rain(false)
		cielo_atardecer(float(cfg_hora.get("sol_azimut", 300.0)))
	elif es_campana and String(cfg_hora.get("hora", "")) == "amanecer":
		# EL EPISODIO 3 ES DE DIA (2026-09-27, pedido: "que no siempre sea de noche, que sea de amanecer")
		if raining:
			set_rain(false)
		cielo_amanecer(float(cfg_hora.get("sol_azimut", 170.0)))
	elif es_campana:
		if not night:
			set_night(true)
		if raining:
			set_rain(false)
		cielo_noche_cerrada()
	else:
		if night:
			set_night(false)
		# Y LLOVIENDO. Mismo motivo que la noche: el mapa esta hecho para dar miedo y el agua hace la
		# mitad del trabajo (el suelo brillando, el ruido tapando lo que se acerca).
		if not raining:
			set_rain(true)
	var guion: Script = preload("res://scripts/campana.gd") if es_campana else preload("res://scripts/pve.gd")
	if es_campana:
		# cada episodio puede traer su propio guion (campana2.gd hereda de campana.gd)
		var cj = JSON.parse_string(FileAccess.get_file_as_string("res://maps/%s.campana.json" % current_map))
		if typeof(cj) == TYPE_DICTIONARY and String(cj.get("script", "")) != "" and ResourceLoader.exists(String(cj["script"])):
			guion = load(String(cj["script"]))
	pve = guion.new()
	pve.name = "PvE"
	add_child(pve)
	# el clima se aligera para todos si a alguien le faltan fps (ver _vigilar_fps_pve)
	if not Net.clima_ligero.is_connected(_aligerar_clima):
		Net.clima_ligero.connect(_aligerar_clima)
	if Net.clima_aligerado:
		_aligerar_clima()        # el que entra tarde a una partida ya aligerada
	pve.setup(player, world, hud, enemies)


