	var m := _cielo_mat
	m.set_shader_parameter("day_top_color", Color(0.52, 0.56, 0.62))
	m.set_shader_parameter("day_bottom_color", Color(0.80, 0.83, 0.87))
	m.set_shader_parameter("sunset_top_color", Color(0.52, 0.56, 0.62))
	m.set_shader_parameter("sunset_bottom_color", Color(0.80, 0.83, 0.87))
	m.set_shader_parameter("horizon_color", Color(0.86, 0.88, 0.91))
	m.set_shader_parameter("sun_color", Vector3(2.0, 2.0, 2.2))
	m.set_shader_parameter("sun_sunset_color", Vector3(2.0, 2.0, 2.2))
	m.set_shader_parameter("clouds_edge_color", Color(0.88, 0.9, 0.93))
	m.set_shader_parameter("clouds_top_color", Color(0.84, 0.86, 0.9))
	m.set_shader_parameter("clouds_middle_color", Color(0.72, 0.75, 0.8))
	m.set_shader_parameter("clouds_bottom_color", Color(0.58, 0.61, 0.66))
	m.set_shader_parameter("clouds_weight", 0.7)
	m.set_shader_parameter("clouds_cutoff", 0.1)


## EL VOLCAN (episodio 8, 2026-10-02): encima de la noche cerrada, el cielo tenido de rojo desde abajo (la lava) y
## la luz de ambiente naranja oscura; la "luna" es el resplandor del crater, rojiza.
func cielo_volcan() -> void:
	if env and env.environment:
		env.environment.ambient_light_color = Color(0.5, 0.26, 0.18)
		env.environment.ambient_light_energy = 1.05
		env.environment.fog_light_color = Color(0.32, 0.14, 0.08)
