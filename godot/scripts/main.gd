## EDITOR DE CONTROLES TACTILES. Se llega desde Ajustes: el juego carga el mapa de practica y aqui
## se abre el editor encima. Los botones dejan de disparar mientras dura.
var touch_editor: Control = null

func open_touch_editor() -> void:
	if touch_editor:
		return
	# En PC no hay controles tactiles montados: se fuerzan para poder disenarlos igual. OJO: esto
	# NO se guarda en los ajustes. Antes si, y quien abria el editor una vez en el ordenador se
	# quedaba con los botones tactiles en pantalla para siempre.
	var forced := false
	if hud.mobile == null:
		forced = not Settings.force_touch
		Settings.force_touch = true
		hud.build_mobile_controls()
	if hud.mobile == null:
		hud.flash_message("No se pudieron montar los controles tactiles")
		return
	# El editor colgaba del HUD (capa 1). Cualquier pantalla que se ponga por encima -por ejemplo
	# la de elegir bando, que va en la capa 90- le tapaba los toques y sus botones no respondian.
	# Ahora va en su propia capa, la mas alta.
	var edit_layer := CanvasLayer.new()
	edit_layer.layer = 100
	add_child(edit_layer)
	touch_editor = load("res://scripts/touch_editor.gd").new()
	edit_layer.add_child(touch_editor)
	touch_editor.tree_exited.connect(func():
		if is_instance_valid(edit_layer):
			edit_layer.queue_free())
	touch_editor.setup(hud.mobile)
	touch_editor.closed.connect(func(): touch_editor = null)
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	player.set_process_input(false)
	touch_editor.tree_exited.connect(func():
		if is_instance_valid(player):
			player.set_process_input(true)
		if forced:
			# se devuelve el ordenador a como estaba: sin botones tactiles en pantalla
			Settings.force_touch = false
			hud.drop_mobile_controls()
		if not Settings.is_touch():
			Input.mouse_mode = Input.MOUSE_MODE_CAPTURED)


