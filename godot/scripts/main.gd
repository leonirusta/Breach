## --nanofps (con --personaje=9): LO QUE CUESTA LA LENTE DEL NANOTRAJE. Sin tope de fps ni vsync, ABAB de 4 s con el
## BLINDAJE puesto y quitado (y luego la INVISIBILIDAD): media del fotograma y de la GPU (sin el primer segundo de cada tramo).
func _nano_fps() -> void:
	await get_tree().create_timer(8.0).timeout
	Engine.max_fps = 0
	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
	var vp := get_viewport().get_viewport_rid()
	RenderingServer.viewport_set_measure_render_time(vp, true)
	var h = player.get("_hab")
	player.invulnerable = true
	var medir := func(que: String, on: bool) -> Array:
		h.energia = h.energia_max
		if que == "blindaje":
			if bool(h.blindaje) != on:
				h.alternar_blindaje()
		else:
			if (h.fase == "invisible") != on:
				if on:
					h.recarga = 0.0
					h.activar()
				else:
					h._fin_invisible()
		var t := 0.0
		var n := 0
		var suma := 0.0
		var gpu := 0.0
		while t < 4.0:
			await get_tree().process_frame
			var dt := get_process_delta_time()
			t += dt
			h.energia = h.energia_max
			if t > 1.0:
				n += 1
				suma += dt * 1000.0
				gpu += RenderingServer.viewport_get_measured_render_time_gpu(vp)
		return [suma / maxf(1, n), gpu / maxf(1, n)]
	for que in ["blindaje", "invisible"]:
		for r in 2:
			for on in [false, true]:
				var m: Array = await medir.call(que, on)
				print("[nanofps] %-9s %-3s fotograma %.2f ms · GPU %.2f ms" % [que, "SI" if on else "no", m[0], m[1]])
		await medir.call(que, false)
	get_tree().quit()


