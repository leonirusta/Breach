## --espectagestos[=carpeta] (2026-10-02, pedido): mirando a un compañero DESDE SUS OJOS, el lanza una granada y luego
## trepa: en mi pantalla tienen que salir las manos haciendo el gesto y el arma apartada. Y un disparo ajeno que llega por
## la red deja su impacto. Con carpeta, fotos.
func _espectar_gestos_test(dir_f: String) -> void:
	await get_tree().create_timer(7.0).timeout
	player.set("invulnerable", true)
	_spawn_enemy_at(player.global_position + Vector3(0.0, 0.0, -3.0), 0)
	await get_tree().create_timer(2.0).timeout
	var bot: Node3D = null
	for b in get_tree().get_nodes_in_group("bots"):
		if is_instance_valid(b):
			bot = b
	if bot == null:
		print("[gestos] FALLO: sin bot")
		get_tree().quit(1)
		return
	bot.team = String(player.team)
	bot.set_physics_process(false)          # quieto: lo que se prueba es lo que veo yo
	player.espectar_primera = true
	player.death_pos = player.global_position
	player._enter_spectate()
	player.killcam_t = 0.0
	player.spectate_target = bot
	await get_tree().create_timer(1.0).timeout
	var fallos: Array = []
	var foto := func(n: String) -> void:
		if dir_f != "":
			get_viewport().get_texture().get_image().save_png("%s/gesto_%s.png" % [dir_f, n])
	foto.call("antes")
	bot.avatar.lanzar_granada()
	await get_tree().create_timer(0.35).timeout
	var arms = player.fp_arms
	var en_gesto: bool = arms != null and bool(arms.get("ver_brazos_fp")) and float(arms.get("lanz_prop_t")) >= 0.0
	print("[gestos] granada a 0,35 s: brazos haciendo el gesto %s · granada en la mano %.2f" % [str(en_gesto), float(arms.get("lanz_prop_t"))])
	foto.call("granada")
	if not en_gesto: fallos.append("granada")
	await get_tree().create_timer(1.0).timeout
	var acabo: bool = not bool(arms.get("ver_brazos_fp"))
	print("[gestos] al acabar el gesto: brazos normales %s" % str(acabo))
	if not acabo: fallos.append("la granada no acaba")
	bot.avatar.trepar(1.2)
	await get_tree().create_timer(0.4).timeout
	var arma_baja: bool = not player.weapon_model.visible or float(player.get("_esp_trepa_w")) > 0.5
	print("[gestos] trepando: manos %s · arma apartada %s" % [str(bool(arms.get("ver_brazos_fp"))), str(arma_baja)])
	foto.call("trepar")
	if not bool(arms.get("ver_brazos_fp")) or not arma_baja: fallos.append("trepar")
	await get_tree().create_timer(1.5).timeout
	foto.call("despues")
	# la HABILIDAD: el puñetazo (la pieza de la mano, el guante de oro, en mis brazos)
	# como llega por la red: la habilidad de su copia (remota) recibe "punetazo"
	var hab_r = preload("res://scripts/habilidad.gd").new()
	hab_r.name = "Habilidad"
	hab_r.remoto = true
	hab_r.player = bot
	bot.add_child(hab_r)
	hab_r.recibir("punetazo", [])
	await get_tree().create_timer(0.6).timeout
	var con_puno: bool = String(arms.get("gesto_pieza")) == "punetazo" and bool(arms.get("ver_brazos_fp"))
	print("[gestos] puñetazo: brazos y guante %s · la copia sabe que la miro desde dentro %s · la carga en mi puño a %.2f m de mi camara" % [
		str(con_puno), str(hab_r._espectado_desde_dentro()), hab_r._fx_mano().distance_to(player.cam.global_position)])
	if not hab_r._espectado_desde_dentro(): fallos.append("la copia no sabe que la miro")
	foto.call("punetazo")
	if not con_puno: fallos.append("habilidad")
	await get_tree().create_timer(2.5).timeout
	# un disparo AJENO (como llega por la red) contra el suelo delante: deja su impacto
	var antes_fx: int = int(Net.impactos_ajenos)
	var o: Vector3 = bot.global_position + Vector3(0, 1.5, 0)
	Net._shoot_remote(o, (Vector3(0, -1, -0.4)).normalized(), 10.0, 40)
	await get_tree().process_frame
	print("[gestos] disparo ajeno: impactos %d -> %d" % [antes_fx, int(Net.impactos_ajenos)])
	if int(Net.impactos_ajenos) <= antes_fx: fallos.append("impacto ajeno")
	print("[gestos] %s" % ("TODO BIEN" if fallos.is_empty() else "FALLOS: " + ", ".join(fallos)))
	get_tree().quit(0 if fallos.is_empty() else 1)


## --botstraza=<archivo> (2026-10-02): LA TRAZA DE LOS BOTS, para comparar dos corridas (el cerebro en C++ contra el de
## GDScript). Cada 15 pasos de fisica, por bot (en orden de red_id): posicion, giro, velocidad, estado, agachado, a quien
## mira y su punto de destino. Usar con --fixed-fps 60 y --botsnoshoot (sin disparos el mapa no cambia). 60 s y sale.
func _bots_traza(ruta: String) -> void:
	var f := FileAccess.open(ruta, FileAccess.WRITE)
	var n := 0
	while is_inside_tree() and n < 240:
		for _k in 15:
			await get_tree().physics_frame
		n += 1
		var lista: Array = []
		for b in get_tree().get_nodes_in_group("bots"):
			if is_instance_valid(b) and not bool(b.get("remoto")):
				lista.append(b)
		lista.sort_custom(func(x, y): return int(x.red_id) < int(y.red_id) if int(x.red_id) != int(y.red_id) else int(x.id) < int(y.id))
		for b in lista:
			var p: Vector3 = b.global_position
			var v: Vector3 = b.velocity
			var t = b.get("target")
			f.store_line("%d %d %s %.4f %.4f %.4f %.4f %.4f %.4f %.4f %d %d %s %.3f %.3f %.3f" % [n, int(b.red_id), String(b.team),
				p.x, p.y, p.z, b.rotation.y, v.x, v.y, v.z, int(b.state), int(b.crouching),
				(String(t.name) if t != null and is_instance_valid(t) else "-"), b.move_target.x, b.move_target.y, b.move_target.z])
	f.close()
	print("[botstraza] %d muestras en %s" % [n, ruta])
	get_tree().quit()


## --botmotorprueba (2026-10-02): BotMotor (C++) contra el GDScript de enemy.gd, caso a caso y al bit: la caja del
## cuerpo, el paso (X/Z, caida, suelo con escombros) y el abanico de rodear, en miles de sitios al azar alrededor.
func _botmotor_prueba() -> void:
	await get_tree().create_timer(8.0).timeout
	var motor = ClassDB.instantiate("BotMotor") if ClassDB.class_exists("BotMotor") else null
	if motor == null:
		print("[botmotor] FALLO: no hay clase BotMotor (extension vieja)")
		get_tree().quit(1)
		return
	_spawn_enemy_at(player.global_position + Vector3(3, 0, 0), 0)
	await get_tree().create_timer(1.0).timeout
	var bot = null
	for b in get_tree().get_nodes_in_group("bots"):
		bot = b
	bot.set_physics_process(false)
	var rng := RandomNumberGenerator.new()
	rng.seed = 12345
	var tam: Vector3 = world.get_world_size()
	var n := 0
	var mal_caja := 0
	var mal_paso := 0
	var mal_abanico := 0
	var suelos := 0
	var choques := 0
	var ejemplos: Array = []
	for i in 5000:
		var p := Vector3(rng.randf_range(2.0, tam.x - 2.0), rng.randf_range(0.0, minf(tam.y, 14.0)), rng.randf_range(2.0, tam.z - 2.0))
		if i % 2 == 0:
			var g: Vector3 = world.find_ground(Vector3(p.x, tam.y - 1.0, p.z))
			if g.y > -1.0:
				p.y = g.y + rng.randf_range(-0.4, 0.5)
		var vel := Vector3(rng.randf_range(-6, 6), rng.randf_range(-12, 3), rng.randf_range(-6, 6))
		var dt: float = [1.0 / 60.0, 1.0 / 30.0, 0.0371][i % 3]
		var k: float = 0.55 if i % 7 == 0 else 1.0
		bot.crouching = i % 5 == 0
		n += 1
		if bool(motor.bloqueado(world, p, bot.crouching)) != bot._blocked_at_gd(p):
			mal_caja += 1
		var a: Array = bot._mover_gd(p, vel, dt, k)
		var c: Array = motor.mover(world, p, vel, dt, k, bot.crouching)
		if bool(a[2]):
			suelos += 1
		if (a[1] as Vector3).x == 0.0 or (a[1] as Vector3).z == 0.0:
			choques += 1
		if a[0] != c[0] or a[1] != c[1] or bool(a[2]) != bool(c[2]):
			mal_paso += 1
			if ejemplos.size() < 4:
				ejemplos.append("p %s vel %s dt %.4f -> gd %s · c++ %s" % [str(p), str(vel), dt, str(a), str(c)])
		var dir := Vector3(rng.randf_range(-1, 1), 0.0, rng.randf_range(-1, 1)).normalized()
		var lado := 1.0 if i % 2 == 0 else -1.0
		if bot._abanico_gd(p, dir, 0.85, lado) != motor.abanico(world, p, dir, 0.85, lado, bot.crouching):
			mal_abanico += 1
	print("[botmotor] %d casos (%d con suelo, %d con choque) · distintos: caja %d · paso %d · abanico %d" % [n, suelos, choques, mal_caja, mal_paso, mal_abanico])
	for e in ejemplos:
		print("[botmotor]   %s" % e)
	# y lo que cuesta cada camino (el mismo paso, 20.000 veces)
	var p0: Vector3 = bot.global_position
	var t0 := Time.get_ticks_usec()
	for i in 20000:
		bot._mover_gd(p0, Vector3(2, -1, 1), 1.0 / 60.0, 1.0)
	var t_gd := Time.get_ticks_usec() - t0
	t0 = Time.get_ticks_usec()
	for i in 20000:
		motor.mover(world, p0, Vector3(2, -1, 1), 1.0 / 60.0, 1.0, false)
	var t_c := Time.get_ticks_usec() - t0
	print("[botmotor] un paso: GDScript %.2f us · C++ %.2f us" % [t_gd / 20000.0, t_c / 20000.0])
	var todo_bien: bool = mal_caja == 0 and mal_paso == 0 and mal_abanico == 0
	print("[botmotor] %s" % ("TODO IGUAL" if todo_bien else "HAY DIFERENCIAS"))
	get_tree().quit(0 if todo_bien else 1)


## --bancomunecos (2026-10-02): LO QUE CUESTAN LOS MUÑECOS, sin el ruido de una partida. En el mapa de pruebas, 12 bots en
## una rejilla delante de la camara a 6-14 m, SIN IA (quietos) pero animandose siempre (el clip de andar), 20 s: mediana
## del fotograma, p95, GPU y lo medido del muñeco. Dos tandas. Para ABAB entre procesos con los flags del muñeco.
func _banco_munecos() -> void:
	await get_tree().create_timer(6.0).timeout
	player.set("invulnerable", true)
	player.set_physics_process(false)
	var base: Vector3 = player.global_position
	var fwd: Vector3 = -player.global_transform.basis.z
	fwd.y = 0.0
	fwd = fwd.normalized()
	var lado := fwd.cross(Vector3.UP)
	for i in 12:
		var p: Vector3 = base + fwd * (6.0 + 2.0 * float(i / 4)) + lado * (float(i % 4) - 1.5) * 1.6
		_spawn_enemy_at(p, i)
	await get_tree().create_timer(3.0).timeout
	for b in get_tree().get_nodes_in_group("bots"):
		if is_instance_valid(b):
			b.set_physics_process(false)
			if b.avatar:
				b.avatar.play("walk")
	await get_tree().create_timer(2.0).timeout
	Engine.max_fps = 0                      # sin tope ni vsync: se mide lo que cuesta, no la espera
	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
	RenderingServer.viewport_set_measure_render_time(get_viewport().get_viewport_rid(), true)
	for tanda in 2:
		var tiempos: Array = []
		var t_prev := Time.get_ticks_usec()
		var t0 := t_prev
		var av_us0: int = int(Prof.acc.get("avatar", 0))
		while Time.get_ticks_usec() - t0 < 20000000:
			await get_tree().process_frame
			var ahora := Time.get_ticks_usec()
			tiempos.append((ahora - t_prev) / 1000.0)
			t_prev = ahora
		tiempos.sort()
		var n := tiempos.size()
		var vp := get_viewport().get_viewport_rid()
		print("[bancomunecos] tanda %d: %d cuadros · mediana %.2f ms · p95 %.2f · GPU %.2f ms · avatar %.2f ms por cuadro" % [tanda, n,
			tiempos[n / 2], tiempos[int(n * 0.95)], RenderingServer.viewport_get_measured_render_time_gpu(vp),
			(int(Prof.acc.get("avatar", 0)) - av_us0) / 1000.0 / maxf(1.0, n)])
	get_tree().quit()


## --censomuneco (2026-10-02): que lleva colgado el muñeco de un bot (lo que se mueve cada vez que se animan sus huesos)
func _censo_muneco() -> void:
	await get_tree().create_timer(12.0).timeout
	for b in get_tree().get_nodes_in_group("bots"):
		if not is_instance_valid(b) or b.get("avatar") == null:
			continue
		var av: Node3D = b.avatar
		var por_clase := {}
		var mallas := 0
		var verts := 0
		var pila: Array = [av]
		while not pila.is_empty():
			var n: Node = pila.pop_back()
			for h in n.get_children():
				pila.append(h)
			por_clase[n.get_class()] = int(por_clase.get(n.get_class(), 0)) + 1
			if n is MeshInstance3D and (n as MeshInstance3D).mesh != null:
				mallas += 1
				var m: Mesh = (n as MeshInstance3D).mesh
				for si in m.get_surface_count():
					var arr = m.surface_get_arrays(si)
					if arr.size() > 0 and arr[0] != null:
						verts += (arr[0] as PackedVector3Array).size()
		var sk: Skeleton3D = av.get("skeleton")
		print("[censo] muñeco de %s: %s · mallas %d (%d vertices) · huesos %d · modificadores %d" % [b.name, str(por_clase), mallas, verts,
			sk.get_bone_count() if sk else -1, sk.get_children().filter(func(c): return c is SkeletonModifier3D).size() if sk else -1])
		break
	get_tree().quit()


## --apuntadotest (2026-10-02, pedido): con el boton derecho APRETADO, recargar / cambiar de arma / granada quitan el
## apuntado y no vuelve hasta soltar y apretar; disparar no lo quita. Y la mira: fuera con el marcador de acierto y muerto.
func _apuntado_test() -> void:
	await get_tree().create_timer(7.0).timeout
	player.set("invulnerable", true)
	var fallos: Array = []
	var cuadros := func(n: int) -> void:
		for _f in n:
			await get_tree().physics_frame
	# un arma de fuego con el cargador a medias
	for i in Weapons.LIST.size():
		if not bool(Weapons.LIST[i].get("melee", false)) and String(Weapons.LIST[i].get("kind", "")) in ["rifle", "smg", "pistol"]:
			player.switch_weapon(i)
			break
	await get_tree().create_timer(1.0).timeout
	Input.action_press("aim")
	await cuadros.call(5)
	if not player.aiming: fallos.append("no apunta con el boton apretado")
	player.set_ammo(player.current, 1)
	player.reload()
	await cuadros.call(5)
	print("[apuntado] recargando con el boton apretado: apunta %s (tiene que ser false)" % str(player.aiming))
	if player.aiming: fallos.append("recargar no quita el apuntado")
	await get_tree().create_timer(3.0).timeout
	await cuadros.call(5)
	print("[apuntado] acabada la recarga, boton aun apretado: apunta %s (false)" % str(player.aiming))
	if player.aiming: fallos.append("vuelve a apuntar solo tras recargar")
	Input.action_release("aim")
	await cuadros.call(3)
	Input.action_press("aim")
	await cuadros.call(5)
	print("[apuntado] soltar y apretar: apunta %s (true)" % str(player.aiming))
	if not player.aiming: fallos.append("no vuelve a apuntar al apretar otra vez")
	Input.action_press("fire")
	await cuadros.call(10)
	print("[apuntado] disparando: apunta %s (true)" % str(player.aiming))
	if not player.aiming: fallos.append("disparar quita el apuntado")
	Input.action_release("fire")
	player.grenades = maxi(player.grenades, 1)
	player.throw_grenade()
	await cuadros.call(5)
	print("[apuntado] granada: apunta %s (false)" % str(player.aiming))
	if player.aiming: fallos.append("la granada no quita el apuntado")
	Input.action_release("aim")
	await get_tree().create_timer(1.5).timeout
	# LA MIRA
	await cuadros.call(3)
	var antes: bool = hud.crosshair.visible
	player.hit_kind = "head"
	player.hit_marker.emit()
	await get_tree().process_frame
	await get_tree().process_frame
	var durante: bool = hud.crosshair.visible
	await get_tree().create_timer(0.5).timeout
	var despues: bool = hud.crosshair.visible
	print("[apuntado] mira: antes %s · con el marcador %s · despues %s (true, false, true)" % [str(antes), str(durante), str(despues)])
	if not antes or durante or not despues: fallos.append("la mira no se aparta con el marcador")
	player.death_pos = player.global_position
	player._enter_spectate()
	await get_tree().create_timer(0.5).timeout
	print("[apuntado] muerto: mira %s (false)" % str(hud.crosshair.visible))
	if hud.crosshair.visible: fallos.append("la mira sale estando muerto")
	print("[apuntado] %s" % ("TODO BIEN" if fallos.is_empty() else "FALLOS: " + ", ".join(fallos)))
	get_tree().quit(0 if fallos.is_empty() else 1)


## --montonfps (2026-10-02, pedido: "muchos bots juntos peleando dan lag"): EL MONTON DE CADAVERES. Con --botsjuntos salian
## rachas de 20 cuadros seguidos de 45-80 ms con 72 piezas de cadaver despiertas y el paso de Jolt a 21-57 ms: varios bots
## que mueren a la vez en el mismo sitio (un cohete en el grupo) y caen unos encima de otros. Esto lo repite: junta 6 bots
## en 2 m delante del jugador, les revienta una explosion (dano de cohete x10) y durante 6 s apunta el paso de Jolt de cada
## tick (lo que va del ultimo guion de fisica a la siguiente senal) y las piezas de cadaver despiertas. Cinco tandas.
func _monton_fps() -> void:
	await get_tree().create_timer(8.0).timeout
	player.set("invulnerable", true)
	var sc_fin := GDScript.new()
	sc_fin.source_code = "extends Node\nvar t := -1\nfunc _physics_process(_d):\n\tt = Time.get_ticks_usec()\n"
	sc_fin.reload()
	var fin_guiones: Node = Node.new()
	fin_guiones.set_script(sc_fin)
	fin_guiones.process_physics_priority = 1000000
	add_child(fin_guiones)
	var totales: Array = []
	for tanda in 5:
		var vivos: Array = enemies.get_children().filter(func(e): return is_instance_valid(e) and "health" in e and float(e.health) > 0.0 and not bool(e.get("remoto")))
		var esperas := 0
		while vivos.size() < 6 and esperas < 10:
			await get_tree().create_timer(2.0).timeout
			esperas += 1
			vivos = enemies.get_children().filter(func(e): return is_instance_valid(e) and "health" in e and float(e.health) > 0.0 and not bool(e.get("remoto")))
		if vivos.size() < 6:
			print("[montonfps] tanda %d: no hay 6 bots vivos" % tanda)
			continue
		var centro: Vector3 = player.global_position - player.global_transform.basis.z * 7.0
		var g0: Vector3 = world.find_ground(centro + Vector3(0, 3, 0))
		if g0.y > -1.0:
			centro = g0
		for i in 6:
			var bot: Node3D = vivos[i]
			var q: Vector3 = centro + Vector3((i % 3) * 0.8 - 0.8, 0.0, (i / 3) * 0.8 - 0.4)
			var g: Vector3 = world.find_ground(q + Vector3(0, 2, 0))
			bot.global_position = (g + Vector3(0, 0.05, 0)) if g.y > -1.0 else q
		for _f in 3:
			await get_tree().physics_frame
		if not "--montonsinexplosion" in OS.get_cmdline_user_args():
			Net.net_explode(world, centro + Vector3(0, 0.6, 0), 4.0, 255)   # un cohete de verdad: rompe el mapa y deja escombros
		Combat.damage_around(get_tree(), centro + Vector3(0, 0.6, 0), 8.0, 1300.0, null, true, true, false, Vector3.ZERO, 1.0)
		var t0 := Time.get_ticks_usec()
		var pasos: Array = []
		var jolt_max := 0.0
		var jolt_sum := 0.0
		var piezas_max := 0
		var lentos := 0
		var t_quietas := -1.0
		var t_prev := t0
		var picos: Array = []
		# el paso de Jolt: del ultimo guion de fisica a lo siguiente (otro tick del mismo cuadro o el process_frame)
		var jolt_cuadro := {"t_proc": Time.get_ticks_usec(), "acc": 0.0}
		var al_proc := func() -> void:
			var tf2: int = int(fin_guiones.get("t"))
			if tf2 > int(jolt_cuadro["t_proc"]):
				jolt_cuadro["acc"] = float(jolt_cuadro["acc"]) + (Time.get_ticks_usec() - tf2) / 1000.0
			jolt_cuadro["t_proc"] = Time.get_ticks_usec()
		get_tree().process_frame.connect(al_proc)
		while Time.get_ticks_usec() - t0 < 6000000:
			await get_tree().physics_frame
			var ahora := Time.get_ticks_usec()
			var tf: int = int(fin_guiones.get("t"))
			if tf > int(jolt_cuadro["t_proc"]):    # el tick anterior fue de este mismo cuadro
				jolt_cuadro["acc"] = float(jolt_cuadro["acc"]) + (ahora - tf) / 1000.0
			var jolt: float = float(jolt_cuadro["acc"])
			jolt_cuadro["acc"] = 0.0
			jolt_max = maxf(jolt_max, jolt)
			jolt_sum += jolt
			if jolt > 20.0:
				picos.append("%.0f ms a %.2f s" % [jolt, (ahora - t0) / 1.0e6])
			var paso := (ahora - t_prev) / 1000.0
			t_prev = ahora
			pasos.append(paso)
			if paso > 33.0:
				lentos += 1
			var desp := 0
			for rd in get_tree().get_nodes_in_group("ragdolls"):
				for h in rd.get_children():
					if h is RigidBody3D and not (h as RigidBody3D).sleeping and not (h as RigidBody3D).freeze:
						desp += 1
			piezas_max = maxi(piezas_max, desp)
			if jolt > 20.0:
				var st_m: Dictionary = world.get_stats()
				picos[picos.size() - 1] += " (%d piezas, bloques despiertos %d)" % [desp, int(st_m.get("bodies_awake", -1))]
			if desp == 0 and t_quietas < 0.0 and (ahora - t0) > 200000:
				t_quietas = (ahora - t0) / 1.0e6
		get_tree().process_frame.disconnect(al_proc)
		var n := pasos.size()
		print("[montonfps] tanda %d: %d ticks · Jolt medio %.1f ms, peor %.1f · ticks >33 ms %d · piezas despiertas max %d · todas quietas a los %s s · picos de Jolt: %s" % [
			tanda, n, jolt_sum / maxf(n, 1), jolt_max, lentos, piezas_max, ("%.1f" % t_quietas) if t_quietas >= 0.0 else "nunca", ", ".join(picos.slice(0, 8))])
		totales.append([jolt_sum / maxf(n, 1), jolt_max, lentos])
		await get_tree().create_timer(3.0).timeout
	if not totales.is_empty():
		var a := 0.0
		var b := 0.0
		var c := 0
		for t in totales:
			a += t[0]; b = maxf(b, t[1]); c += int(t[2])
		print("[montonfps] RESUMEN: Jolt medio %.2f ms · peor %.1f · ticks >33 ms %d (en %d tandas)" % [a / totales.size(), b, c, totales.size()])
	get_tree().quit()


## --cadaveresfps (2026-10-02): LO QUE CUESTAN LOS CADAVERES. Pone 6 bots juntos delante del jugador, los mata a la vez
## y durante 12 s apunta cada paso de fisica (reloj de pared entre uno y otro) y cuantas piezas de cadaver siguen
## despiertas (ni dormidas ni congeladas). Tres tandas. A/B con --ragdollsincongelar (ragdoll.gd, `_congelar`).
func _cadaveres_fps() -> void:
	await get_tree().create_timer(8.0).timeout
	player.set("invulnerable", true)
	for tanda in 3:
		var vivos: Array = enemies.get_children().filter(func(e): return is_instance_valid(e) and "health" in e and float(e.health) > 0.0 and not bool(e.get("remoto")))
		if vivos.size() < 6:
			await get_tree().create_timer(4.0).timeout
			continue
		var delante: Vector3 = player.global_position - player.global_transform.basis.z * 5.0
		for i in 6:
			var bot: Node3D = vivos[i]
			bot.set_physics_process(false)
			var q: Vector3 = delante + Vector3((i % 3) * 0.7 - 0.7, 0.0, (i / 3) * 0.7)
			var g: Vector3 = world.find_ground(q)
			bot.global_position = (g + Vector3(0, 0.05, 0)) if g.y > -1.0 else q
		for _f in 3:
			await get_tree().physics_frame
		for i in 6:
			(vivos[i] as Node).call("take_damage", 100000.0, Vector3(randf_range(-4, 4), 2.0, randf_range(-4, 4)))
		var t_prev := Time.get_ticks_usec()
		var t0 := t_prev
		var pasos: Array = []
		var despiertas_max := 0
		var despiertas_fin := 0
		var t_dormidas := -1.0
		while Time.get_ticks_usec() - t0 < 12000000:
			await get_tree().physics_frame
			var ahora := Time.get_ticks_usec()
			pasos.append((ahora - t_prev) / 1000.0)
			t_prev = ahora
			var desp := 0
			for rd in get_tree().root.find_children("Ragdoll", "", true, false):
				for h in rd.get_children():
					if h is RigidBody3D and not (h as RigidBody3D).sleeping and not (h as RigidBody3D).freeze:
						desp += 1
			despiertas_max = maxi(despiertas_max, desp)
			despiertas_fin = desp
			if desp == 0 and t_dormidas < 0.0 and (ahora - t0) > 300000:
				t_dormidas = (ahora - t0) / 1.0e6
		pasos.sort()
		var n := pasos.size()
		var sobre := pasos.filter(func(x): return x > 33.0).size()
		print("[cadaveresfps] tanda %d%s: %d pasos · mediana %.1f ms · p95 %.1f · peor %.1f · >33 ms %d · piezas despiertas max %d, al final %d · todas quietas a los %s s" % [
			tanda, " (SIN congelar)" if "--ragdollsincongelar" in OS.get_cmdline_user_args() else "", n, pasos[n / 2],
			pasos[int(n * 0.95)], pasos[n - 1], sobre, despiertas_max, despiertas_fin,
			("%.1f" % t_dormidas) if t_dormidas >= 0.0 else "nunca"])
		await get_tree().create_timer(3.0).timeout
	get_tree().quit()


## --sondasitio=x,y,z[,radio]: PLANO DE UN RINCON visto desde arriba, para entender donde se traba un bot. Cada letra son
## 10 cm: '#' macizo de 0,5 a 1,6 m sobre el suelo `y` (lo que choca con el cuerpo), '+' solo por debajo de 0,5 (escalon),
## '.' libre, 'o' donde cabe el CUERPO entero del bot (caja de 0,3 m de radio, enemy._blocked_at), y '*' las celdas de
## camino que da el A* de una punta a otra del rincon. Imprime y sale.
func _sonda_sitio(arg: String) -> void:
	await get_tree().create_timer(4.0).timeout
	var v := arg.split(",")
	var c := Vector3(float(v[0]), float(v[1]), float(v[2]))
	var r: float = float(v[3]) if v.size() > 3 else 3.0
	var cam: PackedVector3Array = world.find_path(c + Vector3(-r + 0.5, 0, 0), c + Vector3(r - 0.5, 0, 0)) if world.has_method("find_path") else PackedVector3Array()
	print("[sonda] rincon %s (radio %.1f m) · A* de oeste a este: %d puntos %s" % [str(c), r, cam.size(), str(cam)])
	var paso := 0.1
	var filas := int(r * 2.0 / paso)
	for j in filas:
		var z: float = c.z - r + (float(j) + 0.5) * paso
		var linea := ""
		for i in filas:
			var x: float = c.x - r + (float(i) + 0.5) * paso
			var q := Vector3(x, c.y, z)
			var ch := "."
			if world.box_solid(q + Vector3(-0.04, 0.5, -0.04), q + Vector3(0.04, 1.6, 0.04)):
				ch = "#"
			elif world.box_solid(q + Vector3(-0.04, 0.05, -0.04), q + Vector3(0.04, 0.45, 0.04)):
				ch = "+"
			elif not world.box_solid(q + Vector3(-0.3, 0.5, -0.3), q + Vector3(0.3, 1.6, 0.3)):
				ch = "o"
			for wp in cam:
				if absf(wp.x - x) < paso * 0.5 and absf(wp.z - z) < paso * 0.5:
					ch = "*"
			linea += ch
		print("[sonda] z=%6.2f %s" % [z, linea])
	get_tree().quit()


## --perfmapa[=segundos] (2026-09-30, la noche de optimizacion): UNA PARTIDA NORMAL MEDIDA. Los bots juegan (pelean
## entre ellos y contigo; tu no mueres), y se mide cada fotograma con el reloj de pared (medidor_fps.gd: mediana, p95,
## los bajones y que clave de Prof subio en cada uno), la GPU, lo que se dibuja (llamadas, objetos, triangulos), los
## nodos, los cuerpos de fisica despiertos y los bloques sueltos. Sin vsync ni tope de fps: lo que se mide es el
## margen. `--perfcap`: con el tope de 60, como se juega. Con --simmovil --calidad=3: el camino del movil en ULTRA.
func _perf_mapa(segundos: float) -> void:
	await get_tree().create_timer(8.0).timeout
	if not "--perfcap" in OS.get_cmdline_user_args():
		DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
		Engine.max_fps = 0
	player.set("invulnerable", true)
	# --perfsincolchunks: sin rehacer la colision de los chunks rotos (medir si los tirones de la fisica son eso)
	if "--perfsincolchunks" in OS.get_cmdline_user_args():
		world.set_phys_updates(false)
	# --medirmuerte: cuanto tarda cada tick de fisica justo despues de que muera un bot (el ragdoll nace ahi)
	if "--medirmuerte" in OS.get_cmdline_user_args():
		var cam_m := get_viewport().get_camera_3d()
		for vez in 4:
			var vivos: Array = enemies.get_children().filter(func(e): return is_instance_valid(e) and "health" in e and float(e.health) > 0.0)
			if vivos.is_empty():
				break
			var bot: Node3D = vivos[0]
			bot.set_physics_process(false)
			var delante: Vector3 = player.global_position - player.global_transform.basis.z * 4.0
			bot.global_position = world.find_ground(delante) + Vector3(0, 0.05, 0) if world.find_ground(delante).y > -1.0 else delante
			for _f in 3:
				await get_tree().physics_frame
			var ticks := PackedStringArray()
			var t_prev := Time.get_ticks_usec()
			var empuje_m := Vector3.ZERO
			for a_m in OS.get_cmdline_user_args():
				if String(a_m).begins_with("--muerteempuje="):
					var v_m := String(a_m).substr(15).split(",")
					if v_m.size() >= 3:
						empuje_m = Vector3(float(v_m[0]), float(v_m[1]), float(v_m[2]))
			bot.take_damage(100000.0, empuje_m)
			Prof.add("muerte.mata", Time.get_ticks_usec() - t_prev)
			t_prev = Time.get_ticks_usec()
			for _f in 20:
				await get_tree().physics_frame
				var ahora := Time.get_ticks_usec()
				ticks.append("%.0f" % ((ahora - t_prev) / 1000.0))
				t_prev = ahora
			print("[medirmuerte] muerte %d: matar %.1f ms · ticks de fisica (ms entre uno y otro): %s" % [vez, int(Prof.peor.get("muerte.mata", 0)) / 1000.0, " ".join(ticks)])
			Prof.peor.erase("muerte.mata")
			await get_tree().create_timer(2.0).timeout
		get_tree().quit()
		return
	# --saltobloques=x,y,z: el jugador salta ahi de golpe (como al reaparecer lejos) y se cuenta cuanto tardan en tener malla
	# los bloques de las regiones cercanas (mientras, se ve la LOD1) y el peor fotograma de ese rato
	for a_sb in OS.get_cmdline_user_args():
		if String(a_sb).begins_with("--saltobloques="):
			var v_sb := String(a_sb).substr(15).split(",")
			var destino := Vector3(float(v_sb[0]), float(v_sb[1]), float(v_sb[2]))
			for vez in 3:
				var origen_sb: Vector3 = player.global_position
				var t0_sb := Time.get_ticks_usec()
				player.global_position = destino if vez % 2 == 0 else origen_sb + Vector3(0.0, 0.0, 0.0)
				var ir_a: Vector3 = destino if vez % 2 == 0 else Vector3(104.0, 16.0, 17.0)
				player.global_position = ir_a
				player.velocity = Vector3.ZERO
				world.set_player_position(ir_a)
				var fot := 0
				var peor_sb := 0.0
				var t_prev_sb := Time.get_ticks_usec()
				var listo_ms := -1.0
				while fot < 600:
					await get_tree().process_frame
					fot += 1
					var ahora_sb := Time.get_ticks_usec()
					peor_sb = maxf(peor_sb, (ahora_sb - t_prev_sb) / 1000.0)
					t_prev_sb = ahora_sb
					player.global_position = ir_a
					player.velocity = Vector3.ZERO
					if fot > 2 and int((world.get_stats() as Dictionary).get("bloques_regiones_urgentes", 0)) == 0:
						listo_ms = (ahora_sb - t0_sb) / 1000.0
						break
				print("[saltobloques] salto %d a %s: bloques listos en %.0f ms (%d fotogramas), peor fotograma %.1f ms" % [vez, str(ir_a), listo_ms, fot, peor_sb])
				await get_tree().create_timer(3.0).timeout
			get_tree().quit()
			return
	# --medircolision: lo que cuesta en Jolt rehacer una forma concava segun sus triangulos, suelta y en un cuerpo
	if "--medircolision" in OS.get_cmdline_user_args():
		var ps := PhysicsServer3D
		for ntri in [100, 500, 1000, 3000, 6000]:
			var caras := PackedVector3Array()
			var lado := int(ceil(sqrt(ntri / 2.0)))
			var k := 0
			for zz in lado:
				for xx in lado:
					if k >= ntri:
						break
					var o := Vector3(xx * 0.2, 0.0, zz * 0.2)
					caras.append_array([o, o + Vector3(0.2, 0, 0), o + Vector3(0, 0, 0.2)])
					caras.append_array([o + Vector3(0.2, 0, 0), o + Vector3(0.2, 0, 0.2), o + Vector3(0, 0, 0.2)])
					k += 2
			var forma := ps.concave_polygon_shape_create()
			var t0c := Time.get_ticks_usec()
			ps.shape_set_data(forma, {"faces": caras, "backface_collision": false})
			var suelta := (Time.get_ticks_usec() - t0c) / 1000.0
			var cuerpo := ps.body_create()
			ps.body_set_mode(cuerpo, PhysicsServer3D.BODY_MODE_STATIC)
			ps.body_add_shape(cuerpo, forma)
			ps.body_set_space(cuerpo, get_world_3d().space)
			ps.body_set_state(cuerpo, PhysicsServer3D.BODY_STATE_TRANSFORM, Transform3D(Basis(), Vector3(0, -50, 0)))
			var veces := PackedFloat32Array()
			for _r in 4:
				var t1c := Time.get_ticks_usec()
				ps.shape_set_data(forma, {"faces": caras, "backface_collision": false})
				veces.append((Time.get_ticks_usec() - t1c) / 1000.0)
				await get_tree().physics_frame
			print("[medircolision] %d triangulos: suelta %.2f ms · en un cuerpo %s ms" % [caras.size() / 3, suelta, str(veces)])
			ps.free_rid(cuerpo)
			ps.free_rid(forma)
		get_tree().quit()
		return
	# --medirbuild: lo que cuesta montar un bot nuevo (lo que pasa al reaparecer), tres veces
	if "--medirbuild" in OS.get_cmdline_user_args():
		var t_hor := Time.get_ticks_usec()
		var n_hor := 0
		var peor_hor := 0
		var peor_n := ""
		for cn in AvatarScript._shared_clips.keys():
			if AvatarScript._shared_baked.has(cn):
				continue
			var t1h := Time.get_ticks_usec()
			AvatarScript._baked(String(cn))
			var dh := Time.get_ticks_usec() - t1h
			if dh > peor_hor:
				peor_hor = dh
				peor_n = String(cn)
			n_hor += 1
		var comunes := 0
		for cn2 in AvatarScript._shared_baked.keys():
			if not (AvatarScript._shared_baked[cn2].get("t_comun", PackedFloat32Array()) as PackedFloat32Array).is_empty():
				comunes += 1
		print("[medirbuild] clips con instantes comunes: %d de %d" % [comunes, AvatarScript._shared_baked.size()])
		print("[medirbuild] hornear %d clips que faltaban: %.0f ms (peor %s %.1f ms); ya horneados antes: %d de %d" % [
			n_hor, (Time.get_ticks_usec() - t_hor) / 1000.0, peor_n, peor_hor / 1000.0,
			AvatarScript._shared_clips.size() - n_hor, AvatarScript._shared_clips.size()])
		for _j in 4:
			var t0s := Time.get_ticks_usec()
			var _st: Dictionary = world.get_stats()
			print("[medirbuild] get_stats: %.1f ms" % ((Time.get_ticks_usec() - t0s) / 1000.0))
		# ABRIR ARCHIVOS POR PRIMERA VEZ: ¿cuesta ~120 ms el primer acceso al disco?
		var t_arch := PackedStringArray()
		var n_arch := 0
		for dir_a in ["res://sounds/l4d2/armas", "res://sounds/bf/destru", "res://ui/skins", "res://texturas"]:
			var da := DirAccess.open(dir_a)
			if da == null:
				continue
			for fa in da.get_files():
				if n_arch >= 12:
					break
				if String(fa).ends_with(".import"):
					continue
				var t0a := Time.get_ticks_usec()
				var fh := FileAccess.open(dir_a + "/" + String(fa), FileAccess.READ)
				var t1a := Time.get_ticks_usec()
				if fh:
					fh.close()
				t_arch.append("%.1f" % ((t1a - t0a) / 1000.0))
				n_arch += 1
		var t0d := Time.get_ticks_usec()
		var _existe := DirAccess.dir_exists_absolute("res://sounds/armas/rifle_precision")
		t_arch.append("dir %.1f" % ((Time.get_ticks_usec() - t0d) / 1000.0))
		var fpa := FileAccess.open("user://archivos_tiempos.txt", FileAccess.WRITE)
		if fpa:
			fpa.store_line("abrir ms: " + ", ".join(t_arch))
			fpa.close()
		var largo := "x".repeat(300)
		var tiempos := PackedStringArray()
		for _j in 6:
			var t0p := Time.get_ticks_usec()
			print("[medirbuild] linea larga %s" % largo)
			var t1p := Time.get_ticks_usec()
			tiempos.append("%.1f" % ((t1p - t0p) / 1000.0))
			await get_tree().create_timer(0.7).timeout
		var fpt := FileAccess.open("user://print_tiempos.txt", FileAccess.WRITE)
		if fpt:
			fpt.store_line("print ms: " + ", ".join(tiempos))
			fpt.close()
		print("[medirbuild] print: %s ms" % ", ".join(tiempos))
		Prof.reset()
		for _i in 3:
			var t0b := Time.get_ticks_usec()
			var eq_b: String = String(enemies.get_child(0).team) if enemies.get_child_count() > 0 else Net.TEAM_T
			_dm_soltar_bot(eq_b, 0, "PRUEBA")
			print("[medirbuild] bot %d: %.1f ms" % [_i, (Time.get_ticks_usec() - t0b) / 1000.0])
			await get_tree().create_timer(0.5).timeout
		var kb := Prof.peor.keys()
		kb.sort()
		for kk in kb:
			if String(kk).begins_with("av.") or String(kk).begins_with("bot.") or String(kk).begins_with("main.reponer") or String(kk).begins_with("arma."):
				print("[medirbuild]   %s: total %.1f ms, peor %.1f ms" % [kk, int(Prof.acc[kk]) / 1000.0, int(Prof.peor[kk]) / 1000.0])
		get_tree().quit()
		return
	# --perfsinbots: sin ningun bot (ni reaparecen), para ver que tirones son suyos
	if "--perfsinbots" in OS.get_cmdline_user_args():
		Settings.bots_enabled = false
		for e in enemies.get_children():
			e.queue_free()
		await get_tree().create_timer(1.0).timeout
	var vp := get_viewport().get_viewport_rid()
	RenderingServer.viewport_set_measure_render_time(vp, true)
	Prof.reset()
	# --sondajugador: como se mueve el jugador (con --sincrojuego anda solo): distancia, tiempo en el suelo, altura minima
	if "--sondajugador" in OS.get_cmdline_user_args():
		var sonda := {"d": 0.0, "suelo": 0, "aire": 0, "ymin": 1.0e9, "prev": player.global_position}
		var al_sonda := func() -> void:
			var pp: Vector3 = player.global_position
			sonda["d"] = float(sonda["d"]) + Vector2(pp.x - (sonda["prev"] as Vector3).x, pp.z - (sonda["prev"] as Vector3).z).length()
			sonda["prev"] = pp
			sonda["ymin"] = minf(float(sonda["ymin"]), pp.y)
			if player.is_on_floor():
				sonda["suelo"] = int(sonda["suelo"]) + 1
			else:
				sonda["aire"] = int(sonda["aire"]) + 1
		get_tree().physics_frame.connect(al_sonda)
		get_tree().create_timer(segundos).timeout.connect(func() -> void:
			print("[sonda] jugador: %.1f m recorridos · en el suelo %d ticks, en el aire %d · altura minima %.2f · acaba en %s" % [
				float(sonda["d"]), int(sonda["suelo"]), int(sonda["aire"]), float(sonda["ymin"]), str(player.global_position.snapped(Vector3(0.01, 0.01, 0.01)))]))
	var mf: Node = load("res://scripts/medidor_fps.gd").new()
	mf.name = "MedidorFps"
	mf.cada = 1.0e9
	add_child(mf)
	var gpu := 0.0
	var cpu := 0.0
	var llamadas := 0.0
	var objetos := 0.0
	var tri := 0.0
	var n := 0
	var dts: Array = []
	var t_prev := Time.get_ticks_usec()
	var fin := Time.get_ticks_msec() + int(segundos * 1000.0)
	var maxnodos := 0
	var maxfis := 0
	# LAS FASES DE CADA FOTOGRAMA con el reloj de pared: fisica (de la primera senal de fisica a process_frame), proceso
	# (scripts y el _process del mundo de voxels: de process_frame a frame_pre_draw), dibujado (pre_draw -> post_draw:
	# el trabajo de CPU del render y la espera a la GPU) y el resto (post_draw -> siguiente fotograma: presentar, audio...)
	var fases := {"fisica": 0.0, "proceso": 0.0, "dibujo": 0.0, "resto": 0.0, "host": 0.0}
	var marcas := {"fis": -1, "proc": -1, "pre": -1, "post": -1}
	# el fotograma en curso, para ver de QUE FASE es cada tiron (y si ese fotograma compilo sombreados)
	var cur := {"fisica": 0.0, "proceso": 0.0, "dibujo": 0.0, "resto": 0.0}
	var tirones: Array = []
	var compilados := func() -> int:
		return int(RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_PIPELINE_COMPILATIONS_CANVAS)) 			+ int(RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_PIPELINE_COMPILATIONS_MESH)) 			+ int(RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_PIPELINE_COMPILATIONS_SURFACE)) 			+ int(RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_PIPELINE_COMPILATIONS_DRAW)) 			+ int(RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_PIPELINE_COMPILATIONS_SPECIALIZATION))
	var comp := {"antes": compilados.call(), "total": 0}
	var t_inicio := Time.get_ticks_usec()
	# EL PASO DE JOLT, aparte: un nodo que corre el ULTIMO en cada tick de fisica apunta la hora; de ahi a la
	# siguiente senal (otro tick o process_frame) es el paso del motor de fisica (y la cola de mensajes)
	var sc_fin := GDScript.new()
	sc_fin.source_code = "extends Node
var t := -1
func _physics_process(_d):
	t = Time.get_ticks_usec()
"
	sc_fin.reload()
	var fin_guiones: Node = Node.new()
	fin_guiones.set_script(sc_fin)
	fin_guiones.process_physics_priority = 1000000
	add_child(fin_guiones)
	var paso := {"total": 0.0, "cur": 0.0}
	var al_fis_paso := func() -> void:
		var tf: int = int(fin_guiones.get("t"))
		if tf > 0 and int(marcas["fis"]) >= 0:
			var d := (Time.get_ticks_usec() - tf) / 1000.0
			paso["total"] += d
			paso["cur"] += d
	get_tree().physics_frame.connect(al_fis_paso)
	var al_fis := func() -> void:
		if int(marcas["fis"]) < 0:
			marcas["fis"] = Time.get_ticks_usec()
			if int(marcas["post"]) >= 0:
				var r := (Time.get_ticks_usec() - int(marcas["post"])) / 1000.0
				fases["resto"] += r
				cur["resto"] += r
	var al_proc := func() -> void:
		var ahora := Time.get_ticks_usec()
		if int(marcas["fis"]) >= 0:
			var tf: int = int(fin_guiones.get("t"))
			if tf > 0:
				paso["total"] += (ahora - tf) / 1000.0
				paso["cur"] += (ahora - tf) / 1000.0
			var f := (ahora - int(marcas["fis"])) / 1000.0
			fases["fisica"] += f
			cur["fisica"] += f
		elif int(marcas["post"]) >= 0:
			var r := (ahora - int(marcas["post"])) / 1000.0
			fases["resto"] += r
			cur["resto"] += r
		marcas["proc"] = ahora
	var al_pre := func() -> void:
		marcas["pre"] = Time.get_ticks_usec()
		if int(marcas["proc"]) >= 0:
			var p := (int(marcas["pre"]) - int(marcas["proc"])) / 1000.0
			fases["proceso"] += p
			cur["proceso"] += p
	var al_post := func() -> void:
		marcas["post"] = Time.get_ticks_usec()
		if int(marcas["pre"]) >= 0:
			var d := (int(marcas["post"]) - int(marcas["pre"])) / 1000.0
			fases["dibujo"] += d
			cur["dibujo"] += d
		marcas["fis"] = -1
		var c: int = compilados.call()
		var dc: int = c - int(comp["antes"])
		comp["antes"] = c
		comp["total"] = int(comp["total"]) + dc
		var tot: float = float(cur["fisica"]) + float(cur["proceso"]) + float(cur["dibujo"]) + float(cur["resto"])
		if tot > 45.0:
			var hms := -1.0
			var ftri := -1
			var fform := -1
			var cuerpos_txt := ""
			if world and world.has_method("get_stats"):
				var stt: Dictionary = world.get_stats()
				hms = float(stt.get("t_host_ms", -1.0))
				ftri = int(stt.get("fis_tris_previo", -1))
				fform = int(stt.get("fis_formas_previo", -1))
				cuerpos_txt = "bloques despiertos %d de %d" % [int(stt.get("bodies_awake", -1)), int(stt.get("bodies_solid", -1))]
				# QUE PARTE DEL MUNDO (2026-10-02): los tiempos del ultimo cuadro de cada fase del mundo, los de 1 ms o mas
				var partes_m := PackedStringArray()
				for km in ["t_hl_update", "t_hl_upload", "t_hl_blocks", "t_hl_regions", "t_hl_phys", "t_hl_spawn", "t_hl_bodies", "t_hl_b_mover", "t_hl_bs_fina", "t_hl_bs_impacto", "t_hl_bs_suelo", "t_hl_bs_asentar", "t_hl_bs_cerca", "t_hl_cf_partir", "t_hl_cf_formas", "t_hl_cf_anadir", "t_hl_b_reconstruir", "t_hl_b_solidificar", "t_hl_debris"]:
					var vm := float(stt.get(km, 0.0))
					if vm >= 1.0:
						partes_m.append("%s %.0f" % [String(km).replace("t_hl_", ""), vm])
				if int(stt.get("cf_cajas", 0)) > 0:
					partes_m.append("cajas %d" % int(stt.get("cf_cajas", 0)))
				if not partes_m.is_empty():
					cuerpos_txt += " · mundo por dentro: " + ", ".join(partes_m)
			if float(paso["cur"]) > 15.0:
				# QUE HAY EN JOLT cuando su paso se dispara: piezas de ragdoll despiertas y el resto de rigidos
				var rag := 0
				var rig := 0
				var v_max := 0.0
				var y_min := 1.0e9
				var pila_r: Array = [get_tree().root]
				while not pila_r.is_empty():
					var nr: Node = pila_r.pop_back()
					for h in nr.get_children():
						pila_r.append(h)
					if nr is RigidBody3D and not (nr as RigidBody3D).sleeping and not (nr as RigidBody3D).freeze:
						if nr.get_parent() != null and nr.get_parent().get_script() != null and String(nr.get_parent().get_script().resource_path).ends_with("ragdoll.gd"):
							rag += 1
							v_max = maxf(v_max, (nr as RigidBody3D).linear_velocity.length())
							y_min = minf(y_min, (nr as RigidBody3D).global_position.y)
						else:
							rig += 1
				cuerpos_txt += " · ragdoll despiertas %d (v max %.1f m/s, y min %.1f) · otros rigidos despiertos %d · jolt: activos %d, pares %d, islas %d" % [
					rag, v_max, y_min if rag > 0 else 0.0, rig,
					PhysicsServer3D.get_process_info(PhysicsServer3D.INFO_ACTIVE_OBJECTS),
					PhysicsServer3D.get_process_info(PhysicsServer3D.INFO_COLLISION_PAIRS),
					PhysicsServer3D.get_process_info(PhysicsServer3D.INFO_ISLAND_COUNT)]
			tirones.append("%.0f ms a %.1f s (fisica %.0f [paso de jolt %.0f; colisiones nuevas %d, %d k tri], proceso %.0f [mundo %.0f], dibujo %.0f, resto %.0f, sombreados compilados %d) %s" % [
				tot, (Time.get_ticks_usec() - t_inicio) / 1.0e6, cur["fisica"], paso["cur"], fform, ftri / 1000, cur["proceso"], hms, cur["dibujo"], cur["resto"], dc, cuerpos_txt])
		cur["fisica"] = 0.0
		paso["cur"] = 0.0
		cur["proceso"] = 0.0
		cur["dibujo"] = 0.0
		cur["resto"] = 0.0
	get_tree().physics_frame.connect(al_fis)
	get_tree().process_frame.connect(al_proc)
	RenderingServer.frame_pre_draw.connect(al_pre)
	RenderingServer.frame_post_draw.connect(al_post)
	var n_host := 0
	# --perfbalas=N: N balas por segundo desde los ojos del jugador en direcciones sorteadas con semilla fija (como
	# una partida con bots tiroteando, pero REPETIBLE: para comparar A/B lo que cuesta rehacer lo que rompen)
	var balas_ps := 0.0
	for a in OS.get_cmdline_user_args():
		if String(a).begins_with("--perfbalas="):
			balas_ps = float(String(a).substr(12))
	var rng_b := RandomNumberGenerator.new()
	rng_b.seed = 12345
	var balas_acc := 0.0
	var ojo_b: Vector3 = player.global_position + Vector3(0, 1.5, 0)
	while Time.get_ticks_msec() < fin:
		await get_tree().process_frame
		var ahora := Time.get_ticks_usec()
		dts.append((ahora - t_prev) / 1000.0)
		t_prev = ahora
		if balas_ps > 0.0:
			balas_acc += balas_ps * minf(float(dts[dts.size() - 1]), 100.0) / 1000.0
			while balas_acc >= 1.0:
				balas_acc -= 1.0
				var ang := rng_b.randf() * TAU
				var dir_b := Vector3(cos(ang), rng_b.randf_range(-0.25, 0.35), sin(ang)).normalized()
				world.shoot(ojo_b, dir_b, 60.0, 40)
		if dts.size() % 8 == 0:      # 1 de cada 8 (x8): pedirlo cada cuadro sincroniza el hilo de render separado
			gpu += RenderingServer.viewport_get_measured_render_time_gpu(vp) * 8.0
			cpu += RenderingServer.viewport_get_measured_render_time_cpu(vp) * 8.0
		llamadas += RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_DRAW_CALLS_IN_FRAME)
		objetos += RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_OBJECTS_IN_FRAME)
		tri += RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_PRIMITIVES_IN_FRAME)
		maxnodos = maxi(maxnodos, int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT)))
		maxfis = maxi(maxfis, int(Performance.get_monitor(Performance.PHYSICS_3D_ACTIVE_OBJECTS)))
		n += 1
		if n % 10 == 0 and world and world.has_method("get_stats"):
			fases["host"] += float((world.get_stats() as Dictionary).get("t_host_ms", 0.0))
			n_host += 1
	var o := dts.duplicate()
	o.sort()
	var k := maxf(1.0, n)
	var med: float = o[o.size() / 2]
	var p99: float = o[int(o.size() * 0.99)]
	var bajo1 := 0.0
	var cuenta1 := maxi(1, o.size() / 100)
	for i in cuenta1:
		bajo1 += float(o[o.size() - 1 - i])
	bajo1 /= cuenta1
	# VAIVEN: cuanto cambia un fotograma del anterior (media y p95). Dos fotogramas de 10 y 22 ms dan la misma mediana
	# que dos de 16, pero se notan a tirones (lo que el usuario llama "fps inestables")
	var saltos: Array = []
	for i in range(1, dts.size()):
		saltos.append(absf(float(dts[i]) - float(dts[i - 1])))
	saltos.sort()
	var vaiven := 0.0
	for v in saltos:
		vaiven += float(v)
	vaiven /= maxf(1.0, saltos.size())
	var vaiven95: float = float(saltos[int(saltos.size() * 0.95)]) if saltos.size() > 0 else 0.0
	var sobre17 := 0
	var sobre33 := 0
	for v in o:
		if float(v) > 16.7:
			sobre17 += 1
		if float(v) > 33.4:
			sobre33 += 1
	var bloques := -1
	if world and world.has_method("get_stats"):
		bloques = int((world.get_stats() as Dictionary).get("bodies", -1))
	print("[perfmapa] %s · %.0f s · mediana %.1f ms (%.0f fps) · 1%% bajo %.1f ms (%.0f fps) · p99 %.1f · >16,7 ms: %d de %d · >33 ms: %d" % [
		Net.mapa_jugado, segundos, med, 1000.0 / maxf(0.1, med), bajo1, 1000.0 / maxf(0.1, bajo1), p99, sobre17, o.size(), sobre33])
	print("[perfmapa]   vaiven entre fotogramas seguidos: media %.2f ms · p95 %.2f ms" % [vaiven, vaiven95])
	print("[perfmapa]   GPU %.2f ms · CPU de render %.2f ms · llamadas %.0f · objetos %.0f · triangulos %.0f k · nodos max %d · fisica despierta max %d · bloques %d" % [
		gpu / k, cpu / k, llamadas / k, objetos / k, tri / k / 1000.0, maxnodos, maxfis, bloques])
	# QUIEN SE PROCESA CADA FOTOGRAMA: los nodos con _process o _physics_process encendido, por clase y script
	var cuenta := {}
	var pila: Array = [get_tree().root]
	while not pila.is_empty():
		var nd: Node = pila.pop_back()
		for h in nd.get_children():
			pila.append(h)
		if nd.is_processing() or nd.is_physics_processing():
			var sc: Script = nd.get_script()
			var clave := nd.get_class() + ("(" + sc.resource_path.get_file() + ")" if sc != null else "")
			var tipo := ("P" if nd.is_processing() else "") + ("F" if nd.is_physics_processing() else "")
			clave += "[" + tipo + "]"
			cuenta[clave] = int(cuenta.get(clave, 0)) + 1
	var cks := cuenta.keys()
	cks.sort_custom(func(x, y): return int(cuenta[x]) > int(cuenta[y]))
	var lc := PackedStringArray()
	for ck in cks.slice(0, 30):
		lc.append("%s x%d" % [ck, cuenta[ck]])
	print("[perfmapa]   procesados: %s" % ", ".join(lc))
	# Y LOS QUE PROCESA GODOT POR DENTRO (NOTIFICATION_INTERNAL_PROCESS / _PHYSICS): particulas, audio 3D, esqueletos...
	var cuenta_int := {}
	pila = [get_tree().root]
	var total_nodos := 0
	while not pila.is_empty():
		var nd2: Node = pila.pop_back()
		total_nodos += 1
		for h in nd2.get_children():
			pila.append(h)
		if nd2.is_processing_internal() or nd2.is_physics_processing_internal():
			var clave2 := nd2.get_class() + "[" + ("P" if nd2.is_processing_internal() else "") + ("F" if nd2.is_physics_processing_internal() else "") + "]"
			cuenta_int[clave2] = int(cuenta_int.get(clave2, 0)) + 1
	var cks2 := cuenta_int.keys()
	cks2.sort_custom(func(x, y): return int(cuenta_int[x]) > int(cuenta_int[y]))
	var lc2 := PackedStringArray()
	for ck in cks2.slice(0, 30):
		lc2.append("%s x%d" % [ck, cuenta_int[ck]])
	print("[perfmapa]   procesados por dentro (de %d nodos): %s" % [total_nodos, ", ".join(lc2)])
	print("[perfmapa]   paso de jolt por fotograma: %.2f ms (dentro de la fisica)" % (paso["total"] / k))
	print("[perfmapa]   fases por fotograma (ms): fisica %.2f · proceso %.2f (de ello el _process del mundo de voxels %.2f) · dibujo %.2f · resto %.2f" % [
		fases["fisica"] / k, fases["proceso"] / k, fases["host"] / maxf(1.0, n_host), fases["dibujo"] / k, fases["resto"] / k])
	mf.informe()
	print("[perfmapa]   sombreados compilados en la prueba: %d" % int(comp["total"]))
	# LA MEMORIA (2026-10-01: con poca RAM libre, Windows comprime y saca paginas y el juego se para ~120 ms al tocarlas)
	var st_m: Dictionary = world.get_stats() if world and world.has_method("get_stats") else {}
	print("[perfmapa]   memoria: Godot %.0f MB (pico %.0f) · video %.0f MB (texturas %.0f, buferes %.0f) · mundo voxels %.0f MB · mallas en CPU: completa %.0f, LOD1 %.0f, LOD2 %.0f, oclusor %.0f, colision %.0f · bloques %.0f MB · nodos %d · objetos %d" % [
		OS.get_static_memory_usage() / 1048576.0, OS.get_static_memory_peak_usage() / 1048576.0,
		Performance.get_monitor(Performance.RENDER_VIDEO_MEM_USED) / 1048576.0,
		Performance.get_monitor(Performance.RENDER_TEXTURE_MEM_USED) / 1048576.0,
		Performance.get_monitor(Performance.RENDER_BUFFER_MEM_USED) / 1048576.0,
		float(st_m.get("mem_world_mb", -1.0)), float(st_m.get("mem_malla_full_mb", -1.0)), float(st_m.get("mem_malla_lod1_mb", -1.0)),
		float(st_m.get("mem_malla_lod2_mb", -1.0)), float(st_m.get("mem_malla_occ_mb", -1.0)), float(st_m.get("mem_malla_col_mb", -1.0)),
		float(st_m.get("mem_bloques_vox_mb", -1.0)), int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT)), int(Performance.get_monitor(Performance.OBJECT_COUNT))])
	print("[perfmapa]   en la GPU (triangulos): bloques %d k · LOD1 %d k · LOD2 %d k · sombras %d k (%d mallas, %d en uso, %d por rehacer, %d en cola, %d regiones deben proyectar)" % [
		int(st_m.get("gpu_tris_bloques", 0)) / 1000, int(st_m.get("gpu_tris_lod1", 0)) / 1000, int(st_m.get("gpu_tris_lod2", 0)) / 1000,
		int(st_m.get("gpu_tris_sombra", 0)) / 1000, int(st_m.get("gpu_sombras_mallas", 0)), int(st_m.get("gpu_sombras_usadas", 0)),
		int(st_m.get("gpu_sombras_pendientes", 0)), int(st_m.get("gpu_sombras_cola", 0)), int(st_m.get("gpu_sombras_deben", 0))])
	print("[perfmapa]   bloques por estado de su region: cerca %d k · LOD1 %d k · LOD2 %d k · fuera de la vista %d k" % [
		int(st_m.get("gpu_tris_bloques_e0", 0)) / 1000, int(st_m.get("gpu_tris_bloques_e1", 0)) / 1000,
		int(st_m.get("gpu_tris_bloques_e2", 0)) / 1000, int(st_m.get("gpu_tris_bloques_e3", 0)) / 1000])
	if world and world.has_method("get_stats"):
		var stf: Dictionary = world.get_stats()
		var lf := PackedStringArray()
		for kf in stf.keys():
			if String(kf).begins_with("t_h") or String(kf).begins_with("fis_") or String(kf) in ["jobs_pending", "regions_dirty", "uploads"]:
				lf.append("%s %s" % [kf, str(stf[kf]).pad_decimals(2) if typeof(stf[kf]) == TYPE_FLOAT else str(stf[kf])])
		print("[perfmapa]   mundo: %s" % ", ".join(lf))
	for tl in tirones:
		print("[perfmapa]   tiron %s" % tl)
	# TODAS las claves de Prof: media por fotograma y peor tramo (las de dentro: bot., cr., pp., au., ex., fx., main.)
	var ks := Prof.acc.keys()
	ks.sort_custom(func(x, y): return int(Prof.acc[x]) > int(Prof.acc[y]))
	var linea := PackedStringArray()
	for kk in ks:
		var med_k := float(Prof.acc[kk]) / 1000.0 / k
		if med_k >= 0.05 or int(Prof.peor.get(kk, 0)) > 8000:
			linea.append("%s %.2f/%.0f" % [kk, med_k, int(Prof.peor.get(kk, 0)) / 1000.0])
	print("[perfmapa]   claves (media/peor ms): %s" % ", ".join(linea))
	if "--cierrediag" in OS.get_cmdline_user_args():
		_cierre_diag()
		return
	get_tree().quit()


## --cierrediag (con --perfmapa): EN QUE PIEZA PETA EL CIERRE. Libera la partida hijo a hijo y luego cada autoload,
## imprimiendo antes de cada uno; el ultimo "[cierre] libero" antes de morir es el culpable.
func _cierre_diag() -> void:
	set_process(false)
	set_physics_process(false)
	for c in get_children():
		print("[cierre] libero main/%s (%s)" % [c.name, c.get_class()])
		c.free()
		await get_tree().process_frame
		await get_tree().process_frame
	print("[cierre] partida vacia; autoloads")
	var raiz := get_tree().root
	for c in raiz.get_children():
		if c == self or c == get_tree().current_scene:
			continue
		print("[cierre] libero /root/%s (%s)" % [c.name, c.get_class()])
		c.free()
		await get_tree().process_frame
	var a := OS.get_cmdline_user_args()
	for arg in a:
		if String(arg).begins_with("--cierreespera="):
			print("[cierre] espero %s s antes de salir" % String(arg).get_slice("=", 1))
			await get_tree().create_timer(float(String(arg).get_slice("=", 1))).timeout
	print("[cierre] todo liberado: quit")
	get_tree().quit()


## --perfpartes: CUANTO CUESTA CADA PARTE, apagandola unos segundos (solo para medir: la partida se ve rara mientras).
## Mide el hilo principal por fases (fisica + proceso) con todo encendido y luego sin cada grupo de nodos.
func _perf_partes() -> void:
	await get_tree().create_timer(8.0).timeout
	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
	Engine.max_fps = 0
	player.set("invulnerable", true)
	# --perfquieto: sin bots ni criaturas y sin tocar nada (las medidas salen estables: lo que cuesta la partida en reposo)
	if "--perfquieto" in OS.get_cmdline_user_args():
		for bq in get_tree().get_nodes_in_group("enemies"):
			if is_instance_valid(bq):
				bq.queue_free()
		for cq in get_tree().get_nodes_in_group("criaturas"):
			if is_instance_valid(cq):
				cq.queue_free()
		player.set_process_input(false)
		await get_tree().create_timer(1.0).timeout
	var grupos := {
		"armas (weapon_model)": func(nd: Node) -> bool: return nd.get_script() != null and String(nd.get_script().resource_path).ends_with("weapon_model.gd"),
		"muñecos (avatar_animator)": func(nd: Node) -> bool: return nd.get_script() != null and String(nd.get_script().resource_path).ends_with("avatar_animator.gd"),
		"bots (enemy)": func(nd: Node) -> bool: return nd.get_script() != null and String(nd.get_script().resource_path).ends_with("enemy.gd"),
		"interfaz (Control)": func(nd: Node) -> bool: return nd is Control or nd is CanvasLayer,
		"efectos (effects, hab_fx)": func(nd: Node) -> bool: return nd.get_script() != null and (String(nd.get_script().resource_path).ends_with("effects.gd") or String(nd.get_script().resource_path).ends_with("hab_fx.gd")),
		"red y cuentas (net, cuenta, salas, grupo)": func(nd: Node) -> bool: return nd.get_script() != null and String(nd.get_script().resource_path).get_file() in ["net.gd", "cuenta.gd", "salas_online.gd", "grupo.gd", "rescate.gd"],
	}
	# --perfquieto: lo que queda en reposo, pieza a pieza
	if "--perfquieto" in OS.get_cmdline_user_args():
		grupos = {}
		for f in ["hud.gd", "etiquetas_equipo.gd", "killfeed.gd", "minimap.gd", "boton_habilidad.gd", "marcador_hud.gd",
				"avatar_animator.gd", "weapon_model.gd", "audio.gd", "effects.gd", "hab_fx.gd", "habilidad.gd", "net.gd",
				"cuenta.gd", "salas_online.gd", "grupo.gd", "rescate.gd", "cargador_caido.gd"]:
			grupos[f] = func(nd: Node) -> bool: return nd.get_script() != null and String(nd.get_script().resource_path).get_file() == f
		grupos["VoxelWorld (C++)"] = func(nd: Node) -> bool: return nd == world
	# --perfpartesinternos: lo que Godot procesa POR DENTRO (esqueletos, particulas, audio 3D...). Solo para medir:
	# mientras esta apagado los muñecos no se mueven y las particulas se congelan.
	var internos := "--perfpartesinternos" in OS.get_cmdline_user_args()
	if internos:
		grupos = {
			"Skeleton3D (por dentro)": func(nd: Node) -> bool: return nd is Skeleton3D,
			"GPUParticles3D (por dentro)": func(nd: Node) -> bool: return nd is GPUParticles3D,
			"AudioStreamPlayer3D (por dentro)": func(nd: Node) -> bool: return nd is AudioStreamPlayer3D,
			"muñecos (avatar_animator)": func(nd: Node) -> bool: return nd.get_script() != null and String(nd.get_script().resource_path).ends_with("avatar_animator.gd"),
		}
	# --perfpartes=ui: la interfaz, pieza a pieza
	if "--perfpartesui" in OS.get_cmdline_user_args():
		grupos = {}
		for f in ["hud.gd", "etiquetas_equipo.gd", "killfeed.gd", "minimap.gd", "boton_habilidad.gd", "marcador_hud.gd"]:
			grupos[f] = func(nd: Node) -> bool: return nd.get_script() != null and String(nd.get_script().resource_path).get_file() == f
		grupos["Control sin script"] = func(nd: Node) -> bool: return nd is Control and nd.get_script() == null
	var medir := func(seg: float) -> Array:
		var t0 := Time.get_ticks_usec()
		var n := 0
		var fin := Time.get_ticks_msec() + int(seg * 1000.0)
		while Time.get_ticks_msec() < fin:
			await get_tree().process_frame
			n += 1
		return [(Time.get_ticks_usec() - t0) / 1000.0 / maxf(1.0, n), n]
	await medir.call(2.0)
	var base: Array = await medir.call(6.0)
	print("[perfpartes] todo encendido: %.2f ms por fotograma" % float(base[0]))
	# ABAB (la partida cambia sola: combates, destruccion que se acumula): cada grupo se apaga y se enciende 3 veces,
	# 2,5 s cada tramo, y la diferencia es la media de (apagado - media de los encendidos de al lado)
	for nombre in grupos:
		var difs: Array = []
		var n_ap := 0
		var antes: Array = await medir.call(2.5)
		for vuelta in 3:
			var apagados: Array = []
			var pila: Array = [get_tree().root]
			while not pila.is_empty():
				var nd: Node = pila.pop_back()
				for h in nd.get_children():
					pila.append(h)
				if nd == self or nd == player:
					continue
				if internos and (grupos[nombre] as Callable).call(nd) and (nd.is_processing_internal() or nd.is_physics_processing_internal() or nd.is_processing()):
					apagados.append([nd, nd.is_processing(), nd.is_physics_processing(), nd.is_processing_internal(), nd.is_physics_processing_internal()])
					nd.set_process(false)
					nd.set_physics_process(false)
					nd.set_process_internal(false)
					nd.set_physics_process_internal(false)
				elif not internos and (grupos[nombre] as Callable).call(nd) and (nd.is_processing() or nd.is_physics_processing()):
					apagados.append([nd, nd.is_processing(), nd.is_physics_processing()])
					nd.set_process(false)
					nd.set_physics_process(false)
			n_ap = apagados.size()
			await get_tree().process_frame
			var r: Array = await medir.call(2.5)
			for e in apagados:
				if is_instance_valid(e[0]):
					(e[0] as Node).set_process(bool(e[1]))
					(e[0] as Node).set_physics_process(bool(e[2]))
					if e.size() > 3:
						(e[0] as Node).set_process_internal(bool(e[3]))
						(e[0] as Node).set_physics_process_internal(bool(e[4]))
			await get_tree().process_frame
			var despues: Array = await medir.call(2.5)
			difs.append(float(r[0]) - (float(antes[0]) + float(despues[0])) * 0.5)
			antes = despues
		var media := 0.0
		for d in difs:
			media += float(d)
		media /= maxf(1.0, difs.size())
		print("[perfpartes] sin %s (%d nodos): %+.2f ms por fotograma (vueltas %s)" % [nombre, n_ap, media,
			", ".join(PackedStringArray(difs.map(func(x): return "%+.1f" % float(x))))])
	var fin2: Array = await medir.call(6.0)
	print("[perfpartes] todo encendido otra vez: %.2f ms" % float(fin2[0]))
	get_tree().quit()


## Un tramo de `seg` segundos medido: ms por fotograma (reloj de pared), GPU, lo que se dibuja y las fases del hilo
## principal (fisica / proceso / dibujo, ver _perf_mapa)
func _medir_tramo(seg: float) -> Dictionary:
	var vp := get_viewport().get_viewport_rid()
	RenderingServer.viewport_set_measure_render_time(vp, true)
	var r := {"ms": 0.0, "gpu": 0.0, "llamadas": 0.0, "objetos": 0.0, "tri": 0.0, "fisica": 0.0, "proceso": 0.0, "dibujo": 0.0, "peor": 0.0}
	var marcas := {"fis": -1, "proc": -1, "pre": -1}
	var al_fis := func() -> void:
		if int(marcas["fis"]) < 0:
			marcas["fis"] = Time.get_ticks_usec()
	var al_proc := func() -> void:
		var ahora := Time.get_ticks_usec()
		if int(marcas["fis"]) >= 0:
			r["fisica"] += (ahora - int(marcas["fis"])) / 1000.0
		marcas["proc"] = ahora
	var al_pre := func() -> void:
		marcas["pre"] = Time.get_ticks_usec()
		if int(marcas["proc"]) >= 0:
			r["proceso"] += (int(marcas["pre"]) - int(marcas["proc"])) / 1000.0
	var al_post := func() -> void:
		if int(marcas["pre"]) >= 0:
			r["dibujo"] += (Time.get_ticks_usec() - int(marcas["pre"])) / 1000.0
		marcas["fis"] = -1
	get_tree().physics_frame.connect(al_fis)
	get_tree().process_frame.connect(al_proc)
	RenderingServer.frame_pre_draw.connect(al_pre)
	RenderingServer.frame_post_draw.connect(al_post)
	var n := 0
	var t0 := Time.get_ticks_usec()
	var prev := t0
	var fin := Time.get_ticks_msec() + int(seg * 1000.0)
	while Time.get_ticks_msec() < fin:
		await get_tree().process_frame
		var ahora := Time.get_ticks_usec()
		r["peor"] = maxf(float(r["peor"]), (ahora - prev) / 1000.0)
		prev = ahora
		r["gpu"] += RenderingServer.viewport_get_measured_render_time_gpu(vp)
		r["llamadas"] += RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_DRAW_CALLS_IN_FRAME)
		r["objetos"] += RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_OBJECTS_IN_FRAME)
		r["tri"] += RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_PRIMITIVES_IN_FRAME)
		n += 1
	get_tree().physics_frame.disconnect(al_fis)
	get_tree().process_frame.disconnect(al_proc)
	RenderingServer.frame_pre_draw.disconnect(al_pre)
	RenderingServer.frame_post_draw.disconnect(al_post)
	var k := maxf(1.0, n)
	r["ms"] = (Time.get_ticks_usec() - t0) / 1000.0 / k
	for c in ["gpu", "llamadas", "objetos", "tri", "fisica", "proceso", "dibujo"]:
		r[c] = float(r[c]) / k
	return r


func _texto_tramo(r: Dictionary) -> String:
	var st: Dictionary = world.get_stats() if world and world.has_method("get_stats") else {}
	return "%.1f ms (%.0f fps, peor %.0f) · fisica %.1f proceso %.1f dibujo %.1f · GPU %.1f · llamadas %.0f objetos %.0f tri %.0f k · cuerpos %s despiertos %s formas %s instancias %s congelados %s grupos %s" % [
		float(r["ms"]), 1000.0 / maxf(0.1, float(r["ms"])), float(r["peor"]), float(r["fisica"]), float(r["proceso"]), float(r["dibujo"]),
		float(r["gpu"]), float(r["llamadas"]), float(r["objetos"]), float(r["tri"]) / 1000.0,
		str(st.get("bodies_solid", "?")), str(st.get("bodies_awake", "?")), str(st.get("shapes_total", "?")),
		str(st.get("piezas_instancias", "?")), str(st.get("bodies_congelados", "?")), str(st.get("grupos_fundidos", "?"))]


## --escombrostest: MUCHOS ESCOMBROS SIN EXPLOSIONES (2026-09-30, pedido: "genera escombros hasta llegar casi a 20 fps,
## deja que duerman y mira si sube"). Se arrancan trozos de 3x3x3 voxels de lo que se ve (place_detached: el camino de
## la red, sin tallar ni explotar), sin bots ni criaturas, hasta bajar de 22 fps (o 4.000 trozos). Luego se para y se
## mide cada 5 s durante 60 s: si se recupera y que queda vivo (cuerpos, despiertos, formas, dibujos sueltos).
func _escombros_test() -> void:
	await get_tree().create_timer(8.0).timeout
	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
	Engine.max_fps = 0
	# --escombrosconbots: los bots se quedan (andan sobre los escombros: cada uno tira un rayo por tick contra los bloques)
	for b in get_tree().get_nodes_in_group("enemies"):
		if is_instance_valid(b) and not "--escombrosconbots" in OS.get_cmdline_user_args():
			b.queue_free()
	for c in get_tree().get_nodes_in_group("criaturas"):
		if is_instance_valid(c):
			c.queue_free()
	player.set("invulnerable", true)
	player.set_process_input(false)
	await get_tree().create_timer(1.0).timeout
	var base: Dictionary = await _medir_tramo(5.0)
	print("[escombros] antes: %s" % _texto_tramo(base))
	var vs: float = world.get_voxel_size()
	var cam := get_viewport().get_camera_3d()
	var mascara := PackedByteArray()
	mascara.resize(4)
	mascara.fill(255)
	var trozos := 0
	var t_seg := Time.get_ticks_msec()
	var cuadros := 0
	while trozos < 4000:
		for i in 6:
			var dir := (-cam.global_transform.basis.z + Vector3(randf_range(-0.7, 0.7), randf_range(-0.2, 0.4), randf_range(-0.7, 0.7))).normalized()
			var rr: Dictionary = world.raycast(cam.global_position, dir, 60.0)
			if not bool(rr.get("hit", false)):
				continue
			var pt: Vector3 = (rr["position"] as Vector3) - (rr["normal"] as Vector3) * vs * 1.5
			var o := Vector3i(int(floor(pt.x / vs)) - 1, int(floor(pt.y / vs)) - 1, int(floor(pt.z / vs)) - 1)
			world.place_detached(o, Vector3i(3, 3, 3), mascara, Vector3(randf_range(-1.0, 1.0), 1.0, randf_range(-1.0, 1.0)), Vector3.ZERO)
			trozos += 1
		await get_tree().process_frame
		cuadros += 1
		if Time.get_ticks_msec() - t_seg >= 1000:
			var fps := cuadros * 1000.0 / float(Time.get_ticks_msec() - t_seg)
			var st: Dictionary = world.get_stats()
			print("[escombros] %d trozos · %.0f fps · cuerpos %s despiertos %s" % [trozos, fps, str(st.get("bodies_solid", "?")), str(st.get("bodies_awake", "?"))])
			t_seg = Time.get_ticks_msec()
			cuadros = 0
			if fps < 22.0:
				break
	print("[escombros] PARA de soltar: %d trozos" % trozos)
	# --escombrosrayos: lo que cuesta el rayo de los bots (raycast_con_piezas) con todos esos bloques en el mapa
	if "--escombrosrayos" in OS.get_cmdline_user_args():
		await get_tree().create_timer(6.0).timeout
		var t0r := Time.get_ticks_usec()
		for k in 1000:
			var pr := cam.global_position + Vector3(randf_range(-20.0, 20.0), 0.0, randf_range(-20.0, 20.0))
			world.raycast_con_piezas(pr + Vector3(0, 0.9, 0), Vector3.DOWN, 3.5)
		var st_r: Dictionary = world.get_stats()
		print("[escombros] 1000 rayos de suelo: %.1f ms (%.1f us cada uno) con %s bloques" % [(Time.get_ticks_usec() - t0r) / 1000.0,
			(Time.get_ticks_usec() - t0r) / 1000.0, str(st_r.get("bodies_solid", "?"))])
		get_tree().quit()
		return
	for i in (6 if "--escombrostiros" in OS.get_cmdline_user_args() else 12):
		var r: Dictionary = await _medir_tramo(5.0)
		print("[escombros] +%2d s: %s" % [(i + 1) * 5, _texto_tramo(r)])
	# --escombrostiros: con todo dormido, 40 BALAS (pistola, potencia 45) a lo que se ve en 10 s, y cuanto despierta
	if "--escombrostiros" in OS.get_cmdline_user_args():
		for t in 40:
			var dir2 := (-cam.global_transform.basis.z + Vector3(randf_range(-0.6, 0.6), randf_range(-0.3, 0.1), randf_range(-0.6, 0.6))).normalized()
			world.shoot(cam.global_position, dir2, 60.0, 45)
			await get_tree().create_timer(0.25).timeout
			if t % 8 == 7:
				var st2: Dictionary = world.get_stats()
				print("[escombros] tiros %d · despiertos %s congelados %s" % [t + 1, str(st2.get("bodies_awake", "?")), str(st2.get("bodies_congelados", "?"))])
		for i in 10:
			var r2: Dictionary = await _medir_tramo(4.0)
			print("[escombros] tras los tiros +%2d s: %s" % [(i + 1) * 4, _texto_tramo(r2)])
	get_tree().quit()


## --perfderiva: LA PARTIDA SE VUELVE LENTA CON EL TIEMPO? Los bots juegan (rompen, mueren, reaparecen) y cada 15 s se
## mide un tramo: ms, fases, GPU, lo que se dibuja y lo que hay vivo (cuerpos, congelados, grupos, chunks, nodos)
func _perf_deriva() -> void:
	await get_tree().create_timer(8.0).timeout
	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
	Engine.max_fps = 0
	player.set("invulnerable", true)
	var tramos := 8
	for f in OS.get_cmdline_user_args():
		if String(f).begins_with("--perfderiva="):
			tramos = int(String(f).substr(13))
	for i in tramos:
		var r: Dictionary = await _medir_tramo(15.0)
		var st: Dictionary = world.get_stats()
		print("[deriva] %3d s: %s · chunks %s visibles %s · tri mundo %s · nodos %d · voxels rotos %s" % [(i + 1) * 15, _texto_tramo(r),
			str(st.get("chunks", "?")), str(st.get("chunks_visible", "?")), str(st.get("tris_visible", "?")),
			int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT)), str(st.get("voxels_destroyed", "?"))])
	get_tree().quit()


## --gpuab: CUANTO CUESTA CADA AJUSTE GRAFICO EN LA GPU (ABAB, sin bots, quieto mirando la ciudad). Para cada opcion se
## alterna su valor del preset con el mas barato tres veces y se da la media de la diferencia de GPU y de fotograma.
## Los valores van a Settings.gfx_forzado (solo en memoria) y se aplican con apply_graphics.
func _gpu_ab() -> void:
	await get_tree().create_timer(8.0).timeout
	# --gpuespera=N (2026-10-02): N s de pelea CON los bots antes de congelar (la destruccion, los efectos y sus muñecos en
	# escena), y no se quitan: lo que se mide es lo que cuesta una partida con bots
	var espera_pelea := 0.0
	for qe in OS.get_cmdline_user_args():
		if String(qe).begins_with("--gpuespera="):
			espera_pelea = float(String(qe).substr(12))
	if espera_pelea > 0.0:
		player.set("invulnerable", true)
		await get_tree().create_timer(espera_pelea).timeout
	# --gpudestrozo=N[,x,y,z] (2026-10-05, captura del movil a 30 fps "con mucha destruccion"): N explosiones contra las
	# paredes de alrededor (rayos en abanico desde el jugador, a 1,5 y 4 m de alto), 25 s para que caigan los escombros, y
	# luego lo de siempre. Asi la GPU se mide con la escena destrozada.
	for qd in OS.get_cmdline_user_args():
		if String(qd).begins_with("--gpudestrozo="):
			var pd := String(qd).substr(14).split(",")
			var n_ex := int(pd[0])
			if pd.size() >= 4:
				player.global_position = Vector3(float(pd[1]), float(pd[2]), float(pd[3]))
				player.velocity = Vector3.ZERO
			player.set("invulnerable", true)
			var hechas := 0
			var quitados := 0
			for k in n_ex * 4:
				if hechas >= n_ex:
					break
				var ang := float(k) * 2.39996 + 0.3
				var alto := 1.5 if k % 2 == 0 else 4.0
				var o: Vector3 = player.global_position + Vector3(0, alto, 0)
				var h: Dictionary = world.raycast(o, Vector3(cos(ang), 0.0, sin(ang)), 28.0)
				if not h.get("hit", false):
					continue
				quitados += int(world.explode(h.position, 2.6, 255))
				hechas += 1
				await get_tree().create_timer(0.25).timeout
			var espera_d: float = float(pd[4]) if pd.size() >= 5 else 25.0
			print("[gpupausa] destrozo: %d explosiones, %d voxels; esperando %.1f s a los escombros" % [hechas, quitados, espera_d])
			await get_tree().create_timer(espera_d).timeout
			var sd: Dictionary = world.get_stats()
			print("[gpupausa] limpieza: quitados por el tope %s, por el tiempo %s" % [str(sd.get("escombros_quitados", "?")), str(sd.get("escombros_limpiados", "?"))])
			print("[gpupausa] destrozo hecho: bloques %s (escombros chicos %s, congelados %s, despiertos %s) · triangulos visibles %s, de bloques en la GPU %s" % [
				str(sd.get("bodies_active", "?")), str(sd.get("escombros_chicos", "?")), str(sd.get("bodies_congelados", "?")),
				str(sd.get("bodies_awake", "?")), str(sd.get("tris_visible", "?")), str(sd.get("gpu_tris_bloques", "?"))])
			for i in 3:
				await get_tree().process_frame
			print("[gpupausa] destrozo, particulas: %s de %s · su update %.2f ms" % [str(sd.get("debris_active", "?")), str(sd.get("debris_capacity", "?")),
				float(sd.get("t_debris_ms", 0.0))])
			print("[gpupausa] destrozo, mundo: tris_total %s · sombra %s · lod1 %s · lod2 %s · sombra en la GPU %s · chunks visibles %s · llamadas %d · objetos %d · primitivas %d" % [
				str(sd.get("tris_total", "?")), str(sd.get("shadow_tris", "?")), str(sd.get("gpu_tris_lod1", "?")), str(sd.get("gpu_tris_lod2", "?")),
				str(sd.get("gpu_tris_sombra", "?")), str(sd.get("chunks_visible", "?")),
				int(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME)), int(Performance.get_monitor(Performance.RENDER_TOTAL_OBJECTS_IN_FRAME)),
				int(Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME))])
	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
	Engine.max_fps = 0
	for bq in (get_tree().get_nodes_in_group("enemies") if espera_pelea <= 0.0 else []):
		if is_instance_valid(bq):
			bq.queue_free()
	player.set("invulnerable", true)
	player.set_process_input(false)
	await get_tree().create_timer(1.5).timeout
	# --gpupausa: LO QUE CUESTA CADA COSA EN LA GPU DE VERDAD. Con la partida en marcha la CPU manda y la GPU integrada
	# baja su reloj, asi que su tiempo medido no dice nada. Con el arbol en pausa la CPU casi no hace nada y el fotograma
	# es lo que tarda la GPU a tope; se apaga cada ajuste ABAB (3 vueltas de 2,5 s) y se mira cuanto baja el fotograma.
	if "--gpupausa" in OS.get_cmdline_user_args():
		get_tree().paused = true
		# --aoforzado=N tambien aqui (con el arbol en pausa no llega a aplicarse donde se aplica jugando)
		for q in OS.get_cmdline_user_args():
			if String(q).begins_with("--aoforzado="):
				var nv_ao := int(String(q).substr(12))
				_ao_nivel(nv_ao)
				print("[gpupausa] oclusion volumetrica forzada a %d" % nv_ao)
		var medir_p := func(seg: float) -> float:
			var t0p := Time.get_ticks_usec()
			var np := 0
			var finp := Time.get_ticks_msec() + int(seg * 1000.0)
			while Time.get_ticks_msec() < finp:
				await get_tree().process_frame
				np += 1
			return (Time.get_ticks_usec() - t0p) / 1000.0 / maxf(1.0, np)
		await medir_p.call(3.0)
		var base_p: float = await medir_p.call(4.0)
		print("[gpupausa] en pausa, todo como en ULTRA: %.2f ms por fotograma (%.0f fps)" % [base_p, 1000.0 / base_p])
		# --gpupausabase: solo esa medida (para comparar dos versiones de algo con dos corridas)
		if "--gpupausabase" in OS.get_cmdline_user_args():
			var base2: float = await medir_p.call(4.0)
			print("[gpupausa] y otra vez: %.2f ms" % base2)
			get_tree().quit()
			return
		if "--gpupausasombreado" in OS.get_cmdline_user_args():
			var mat_p: ShaderMaterial = world.opaque_material as ShaderMaterial
			var sh_orig_p: Shader = mat_p.shader
			var sh_sinluz := Shader.new()
			sh_sinluz.code = "shader_type spatial;
render_mode cull_back, unshaded;
void fragment() { ALBEDO = COLOR.rgb; }
"
			var sh_conluz := Shader.new()
			sh_conluz.code = "shader_type spatial;
render_mode cull_back, depth_draw_opaque, specular_schlick_ggx;
void fragment() { ALBEDO = COLOR.rgb; ROUGHNESS = 0.8; }
"
			for variante in [["minimo con luz", sh_conluz], ["minimo sin luz", sh_sinluz]]:
				var difs_s: Array = []
				for vuelta in 3:
					var a_s: float = await medir_p.call(2.5)
					mat_p.shader = variante[1]
					await get_tree().process_frame
					await get_tree().process_frame
					var b_s: float = await medir_p.call(2.5)
					mat_p.shader = sh_orig_p
					await get_tree().process_frame
					await get_tree().process_frame
					difs_s.append(b_s - a_s)
				print("[gpupausa] mundo con sombreado %s: %+.2f ms (vueltas %s)" % [variante[0], (float(difs_s[0]) + float(difs_s[1]) + float(difs_s[2])) / 3.0,
					", ".join(PackedStringArray(difs_s.map(func(x): return "%+.1f" % float(x))))])
			get_tree().quit()
			return
		# --gpupausaparticulas (con --gpudestrozo y poca espera): lo que cuestan las PARTICULAS DE ESCOMBRO del nucleo en
		# la GPU (quietas, el arbol esta en pausa): sin dibujarlas, y dibujadas sin sombra
		if "--gpupausaparticulas" in OS.get_cmdline_user_args() and world.has_method("get_debris_instance"):
			var inst_p: RID = world.get_debris_instance()
			var sumas_p := {"con": 0.0, "sin": 0.0, "sin_sombra": 0.0}
			for vuelta in 3:
				for caso in ["con", "sin", "sin_sombra"]:
					RenderingServer.instance_set_visible(inst_p, caso != "sin")
					RenderingServer.instance_geometry_set_cast_shadows_setting(inst_p,
						RenderingServer.SHADOW_CASTING_SETTING_OFF if caso == "sin_sombra" else RenderingServer.SHADOW_CASTING_SETTING_ON)
					await medir_p.call(0.5)
					sumas_p[caso] += float(await medir_p.call(2.0)) / 3.0
			print("[gpupausa] particulas: con %.2f ms · sin dibujarlas %+.2f · sin su sombra %+.2f" % [sumas_p["con"],
				sumas_p["sin"] - sumas_p["con"], sumas_p["sin_sombra"] - sumas_p["con"]])
			RenderingServer.instance_set_visible(inst_p, true)
		# --gpupausaescombros (con --gpudestrozo): lo que baja la GPU con el TOPE DE ESCOMBROS a 400, 200 y 100 (se quitan
		# de verdad, de mas a menos: cada medida es con menos escombros que la anterior)
		if "--gpupausaescombros" in OS.get_cmdline_user_args() and world.has_method("recortar_escombros"):
			var cam_e := get_viewport().get_camera_3d()
			world.process_mode = Node.PROCESS_MODE_ALWAYS     # que rehaga las mallas fundidas de los congelados
			await medir_p.call(2.0)
			var antes_e: float = await medir_p.call(3.0)
			print("[gpupausa] escombros: con todos (%s chicos) %.2f ms" % [str(world.get_stats().get("escombros_chicos", "?")), antes_e])
			for tope_e in [400, 200, 100, 0]:
				var q: PackedInt64Array = world.recortar_escombros(tope_e, cam_e.global_position, -cam_e.global_basis.z, 100000)
				await medir_p.call(3.0)
				var con_e: float = await medir_p.call(3.0)
				print("[gpupausa] escombros: tope %d (quitados %d) %.2f ms (%+.2f)" % [tope_e, q.size(), con_e, con_e - antes_e])
			get_tree().quit()
			return
		# --gpupausalente (con --conlluvia): lo que cuesta EL AGUA EN LA LENTE, en la misma corrida (entre corridas el PC
		# varia mas que lo que se mide): sin lente, la lente de ahora y la de antes (lluvia_lente_mips), ABAB x3
		if "--gpupausalente" in OS.get_cmdline_user_args() and hud.lluvia_rect != null:
			var lr: ColorRect = hud.lluvia_rect
			var lm := lr.material as ShaderMaterial
			var sh_nueva: Shader = lm.shader
			var sh_vieja: Shader = load("res://shaders/lluvia_lente_mips.gdshader")
			var sumas := {"sin": 0.0, "nueva": 0.0, "vieja": 0.0, "copia": 0.0}
			for vuelta in 3:
				for caso in ["sin", "nueva", "vieja", "copia"]:
					lr.visible = caso != "sin"
					lm.shader = sh_vieja if caso == "vieja" else sh_nueva
					lm.set_shader_parameter("cantidad", 1.0)
					lm.set_shader_parameter("diag_sin_gotas", 1 if caso == "copia" else 0)   # solo copiar y repintar
					await get_tree().process_frame
					await medir_p.call(0.5)
					sumas[caso] += float(await medir_p.call(2.5)) / 3.0
			print("[gpupausa] lente: sin %.2f ms · la de ahora %.2f (%+.2f) · la de antes %.2f (%+.2f)" % [sumas["sin"],
				sumas["nueva"], sumas["nueva"] - sumas["sin"], sumas["vieja"], sumas["vieja"] - sumas["sin"]])
			print("[gpupausa] lente sin calcular las gotas (la copia de la pantalla y repintarla): %+.2f ms" % (sumas["copia"] - sumas["sin"]))
			# y lo demas de la lluvia, con la lente puesta: las gotas que caen (particulas) y el suelo mojado
			lm.set_shader_parameter("diag_sin_gotas", 0)
			lr.visible = true
			var om := world.opaque_material as ShaderMaterial
			var otras := {"todo": 0.0, "sin_particulas": 0.0, "seco": 0.0, "sin_ondas": 0.0, "sin_borde": 0.0, "farolas": 0.0, "sin_corte": 0.0, "paredes": 0.0}
			for vuelta in 3:
				for caso in ["todo", "sin_particulas", "seco", "sin_ondas", "sin_borde", "farolas", "sin_corte", "paredes"]:
					if _rain_fx != null:
						_rain_fx.visible = caso != "sin_particulas"
					om.set_shader_parameter("mojado", 0.0 if caso == "seco" else _mojado)
					om.set_shader_parameter("ondas", 0.0 if caso == "seco" or caso == "sin_ondas" else _ondas)
					om.set_shader_parameter("lluvia_detalle", 0.0 if caso == "sin_borde" else 1.0)
					om.set_shader_parameter("diag_mojado_exacto", 0.0 if caso == "farolas" else 1.0)
					om.set_shader_parameter("mojado_exacto_paredes", 1.0 if caso == "paredes" else 0.0)
					om.set_shader_parameter("lamp_alcance_max", 1e6 if caso == "sin_corte" else _lamp_alcance_max())
					await get_tree().process_frame
					await medir_p.call(0.5)
					otras[caso] += float(await medir_p.call(2.5)) / 3.0
			print("[gpupausa] lluvia: con todo %.2f ms · sin las gotas que caen %+.2f · con el suelo seco %+.2f" % [otras["todo"],
				otras["sin_particulas"] - otras["todo"], otras["seco"] - otras["todo"]])
			print("[gpupausa] con las PAREDES mojadas tambien por el camino exacto (lo de antes): %+.2f ms" % (otras["paredes"] - otras["todo"]))
			print("[gpupausa] mojado por partes: sin ondas %+.2f · sin el borde bajo los aleros %+.2f · farolas sin el camino exacto %+.2f · SIN EL CORTE del camino exacto %+.2f (alcance %.1f m, se apagan a %.1f m) · farolas encendidas %s" % [
				otras["sin_ondas"] - otras["todo"], otras["sin_borde"] - otras["todo"], otras["farolas"] - otras["todo"], otras["sin_corte"] - otras["todo"],
				_lamp_alcance_max(), _lamp_pool[0].distance_fade_begin + _lamp_pool[0].distance_fade_length if not _lamp_pool.is_empty() else -1.0, str(_lamp_cocinadas)])
			get_tree().quit()
			return
		# --gpupausalamparas: lo que cuestan las FAROLAS COCINADAS (el bucle del sombreado), encendiendolas y apagandolas
		if "--gpupausalamparas" in OS.get_cmdline_user_args() and _lamp_cocinadas:
			var mats_l: Array = [world.opaque_material, world.glass_material]
			var difs_k: Array = []
			var con_k := 0.0
			for vuelta in 3:
				var a_k: float = await medir_p.call(2.5)
				con_k += a_k / 3.0
				for m in mats_l:
					(m as ShaderMaterial).set_shader_parameter("lamp_on", 0.0)
				await get_tree().process_frame
				var b_k: float = await medir_p.call(2.5)
				for m in mats_l:
					(m as ShaderMaterial).set_shader_parameter("lamp_on", 1.0)
				await get_tree().process_frame
				difs_k.append(b_k - a_k)
