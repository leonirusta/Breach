## LA ZANCADA ELASTICA, MEDIDA. Dos preguntas: ¿el pie sigue plantado (no patina) y no se hunde bajo
## el suelo? Se mueve un avatar suelto a cada velocidad, se sigue el pie de apoyo por el mundo y se
## compara lo que barre hacia atras con lo que deberia barrer, que es justo la velocidad de avance.
func _zancada_test() -> void:
	await get_tree().create_timer(3.0).timeout
	var AvCls = load("res://scripts/avatar_animator.gd")
	var av = AvCls.new()
	add_child(av)
	av.build(1.7, false, Color(1, 1, 1), false)
	# El avatar de prueba esta en el origen, fuera del encuadre, y el animador SE SALTA a los que no
	# se ven (es su optimizacion de LOD). Marcandolo como primera persona se anima siempre.
	av._first_person = true
	await get_tree().process_frame
	print("[zancada] EL PIE PLANTADO tiene que barrer hacia atras a la MISMA velocidad a la que")
	print("[zancada] avanza el cuerpo. Lo que sobre o falte, es lo que patina.")
	print("[zancada] %-9s %5s  %6s %7s  %8s  %s" % ["", "vel", "caden", "zancada", "pie", "patina"])
	for warp in [false, true]:
		# apagada = zancada 1.0 a mano (antes era AvCls.CADENCIA_MAX, que ya no existe)
		print("[zancada] --- zancada elastica %s" % ("ACTIVADA" if warp else "apagada"))
		for caso in [["andar", 3.4, Vector3(0, 0, -3.4)], ["esprint", 5.0, Vector3(0, 0, -5.0)],
				["atras", 2.55, Vector3(0, 0, 2.55)], ["lateral", 2.89, Vector3(2.89, 0, 0)]]:
			var v: float = caso[1]
			var lv: Vector3 = caso[2]
			for i in 60:
				av.drive_locomotion(lv, false, true, 0, 1.0 / 60.0)
				if not warp:
					av.zancada = 1.0
				av._process(1.0 / 60.0)
			var dur: float = float(av._baked(av.current_clip)["dur"]) / maxf(av.anim_speed, 0.01)
			var pasos: int = int(dur * 480.0)
			var eje := 2 if absf(lv.z) > absf(lv.x) else 0
			var signo: float = -signf(lv.z if eje == 2 else lv.x)   # el pie va al reves que el cuerpo
			# primera pasada: a que altura esta el suelo para este clip
			var suelo := 1e9
			var muestras: Array = []
			for i in pasos:
				av.drive_locomotion(lv, false, true, 0, 1.0 / 480.0)
				if not warp:
					av.zancada = 1.0
				av._process(1.0 / 480.0)

				muestras.append(_pie_apoyo(av))
				suelo = minf(suelo, float(muestras[-1].y))
			# velocidad del pie SOLO mientras esta plantado (a menos de 2 cm del suelo)
			var vel: Array = []
			for i in range(1, muestras.size()):
				var a0: Vector3 = muestras[i - 1]
				var a1: Vector3 = muestras[i]
				if a1.y > suelo + 0.02 or a0.y > suelo + 0.02:
					continue
				var dc: float = (a1.z - a0.z) if eje == 2 else (a1.x - a0.x)
				if absf(dc) > 0.05:
					continue                      # cambio de pie de apoyo, no es movimiento real
				vel.append(dc * signo * 480.0)
			vel.sort()
			var med: float = float(vel[vel.size() / 2]) if not vel.is_empty() else 0.0
			print("[zancada] %-9s %5.2f  %6.2f %7.2f  %8.2f  %5.0f %%  %8.3f m" % [
				caso[0], v, av.anim_speed, av.zancada, med, (med - v) / v * 100.0, suelo])
	get_tree().quit()

## El pie que esta abajo, en metros del mundo.
func _pie_apoyo(av) -> Vector3:
	var sk: Skeleton3D = av.skeleton
	var pl: Vector3 = sk.global_transform * sk.get_bone_global_pose(av.bone_idx["foot_l"]).origin
	var pr: Vector3 = sk.global_transform * sk.get_bone_global_pose(av.bone_idx["foot_r"]).origin
	return pl if pl.y < pr.y else pr


