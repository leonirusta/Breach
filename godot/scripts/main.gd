					break
				player.global_position = b.global_position + Vector3(0.4, 0.2, 0)
				player.velocity = Vector3.ZERO
	print("[bombtest] %s FIN" % role)
	get_tree().quit()


## Fin de ronda: unos segundos de resultado y vuelta a empezar (todos vivos, en su base).
func _on_round_over(_winner: String, _reason: String) -> void:
	# EN EL BATTLE ROYALE NO HAY RONDAS: caer el ultimo de tu "bando" no es perder una ronda y revivir a los
	# 6 s; es estar eliminado. El final lo decide zona_br.gd (ultimo en pie).
	if zona_br != null and is_instance_valid(zona_br):
		return
	if ciudad3:
		return            # el atraco no tiene rondas: su final lo lleva el marcador de la ciudad
	# DUELO A MUERTE: llegar al objetivo acaba la PARTIDA, no la ronda. Aqui se esperaba seis segundos
	# y se arrancaba otra ronda -revivir, volver a la base, bots nuevos-, asi que al ganar no pasaba
	# nada: se seguia jugando en el mismo mapa y nadie volvia al lobby.
	if dm_mode and Net.es_dm_elim():
		_elim_fin_ronda(_winner)
		return
	if dm_mode:
		if _vigia_fin_test and Net.is_online() and not Net.hosting:
			return      # --vigiafintest: el invitado no se entera por aqui (prueba del vigia)
		_dm_fin(_winner)
		return
	# BOMBA: LA PARTIDA SE ACABA AL LLEGAR A TANTAS RONDAS.
	#
	# Antes no acababa NUNCA: las rondas se sumaban sin tope, no habia pantalla de victoria y nadie
	# ganaba un solo punto de experiencia por jugarla. Era el modo principal del juego y el unico sin
	# final.
	if bomb_mode and (Net.score_t >= RONDAS_PARA_GANAR or Net.score_ct >= RONDAS_PARA_GANAR):
		_bomba_fin(Net.TEAM_T if Net.score_t >= RONDAS_PARA_GANAR else Net.TEAM_CT)
		return
	# MVP DE LA RONDA (2026-11-01): el que mas mato (dos o mas, sin empate)
	if bomb_mode and hud:
		var mvp: Array = preload("res://scripts/logros.gd").mvp_ronda()
		if not mvp.is_empty():
			hud.anuncio("MVP DE LA RONDA · %s · %d bajas" % [Net.nombre_para_ver(String(mvp[0])) if Net.has_method("nombre_para_ver") else String(mvp[0]), int(mvp[1])])
	# PUNTO DE PARTIDA (2026-11-01): a un equipo le falta una ronda
	if bomb_mode and hud and (Net.score_t == RONDAS_PARA_GANAR - 1 or Net.score_ct == RONDAS_PARA_GANAR - 1):
		var ambos: bool = Net.score_t == Net.score_ct
		var mio_cerca: bool = (Net.score_t if Net.my_team() == Net.TEAM_T else Net.score_ct) == RONDAS_PARA_GANAR - 1
		var txt_pp := "¡ÚLTIMA RONDA! · gana quien la gane" if ambos else ("PUNTO DE PARTIDA · una ronda y ganáis" 			if mio_cerca else "PUNTO DE PARTIDA DEL RIVAL · no podéis fallar")
		# despues del MVP de la ronda, que no se pisen
		get_tree().create_timer(2.8).timeout.connect(func(): if is_instance_valid(hud): hud.anuncio(txt_pp))
	if Net.soy_espectador:
		return          # el espectador no revive ni vuelve a ninguna base: sigue mirando la ronda nueva
	await get_tree().create_timer(6.0).timeout
	Net.new_round()
	if is_instance_valid(player) and player.has_method("revive"):
		player.revive()
	spawn_at_team_base(Net.my_team())
	# Y LOS BOTS, DE CERO. Se borran los que quedaran vivos y se reparte la plantilla entera otra vez:
	# asi cada ronda empieza diez contra diez, con sus puestos y sus parejas recalculados, en vez de
	# arrastrar a los cuatro supervivientes de la ronda anterior.
	# ...pero NO en red. Los bots estan deshabilitados a proposito en partidas online (hay dos
	# condiciones `not Net.is_online()` en el arranque), asi que reponerlos aqui habria hecho brotar
	# una plantilla entera de bots en una partida LAN donde no deben existir. Lo mismo hay que
	# preguntar aqui.
	if bomb_mode and enemies != null and Settings.bots_enabled and _me_toca_crear_bots():
		for e in enemies.get_children():
			e.queue_free()
		await get_tree().process_frame
		spawn_enemies()
	# ronda nueva: nadie lleva la C4 y vuelve a estar en el suelo de la base terrorista
	Net.net_bomb_carrier(0)
	if bomb_mode:
		spawn_loose_c4()


