func _mazo_grid() -> void:
	await get_tree().create_timer(5.0).timeout
	player.set("invulnerable", true)
	player.switch_weapon(2)
	for _i in 40:
		await get_tree().process_frame
	Input.action_press("sprint")
	Input.action_press("move_forward")
	player.touch_move = Vector2(0.0, -1.0)
	var _p0: Vector3 = player.global_position
	for _i in 60:
		player.global_position = _p0
		await get_tree().process_frame
	var poses: Array = [
		[Vector3(0, 0, -125), Vector3(0.06, 0.00, 0.14)],
		[Vector3(0, 0, -125), Vector3(0.06, -0.10, 0.14)],
		[Vector3(0, 0, -125), Vector3(0.06, -0.20, 0.14)],
		[Vector3(0, 0, -125), Vector3(0.06, -0.30, 0.14)],
		[Vector3(0, 0, -125), Vector3(0.06, -0.40, 0.14)],
		[Vector3(0, 0, -125), Vector3(0.06, -0.55, 0.14)]]
	# CLAVADO EN EL SITIO: corriendo de verdad hacia delante, en 4 s se sale de la plataforma del mapa de
	# pruebas y se mata; entonces el arma se esconde y TODAS las fotos salian vacias.
	var pos0: Vector3 = player.global_position
	player.set("invulnerable", true)
	for i in poses.size():
		player.set("mazo_rot_test", poses[i][0])
		player.set("mazo_off_test", poses[i][1])
		for _f in 30:
			player.global_position = pos0
			await get_tree().process_frame
		for _f2 in 3:
			await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("user://mazo_%d.png" % i)
		print("[mazogrid] %d  rot %s  off %s" % [i, str(poses[i][0]), str(poses[i][1])])
	get_tree().quit(0)

func _esprint_foto() -> void:
	await get_tree().create_timer(5.0).timeout
	player.set("invulnerable", true)
	var armas := [[1, "ranura2"]] if "--rapido" in OS.get_cmdline_user_args() else [[0, "ranura1"], [1, "ranura2"], [2, "ranura3"]]
	for _sr in OS.get_cmdline_user_args():   # --soloranura=N: solo esa (1..3), para iterar poses rapido
		if String(_sr).begins_with("--soloranura="):
			var _i := clampi(int(String(_sr).substr(13)) - 1, 0, 2)
			armas = [[_i, "ranura%d" % (_i + 1)]]
	for par in armas:
		player.switch_weapon(int(par[0]))
		for _i in 40:
			await get_tree().process_frame
		for vista in (["fp"] if "--rapido" in OS.get_cmdline_user_args() else ["fp", "tp"]):
			player.set_third_person(vista == "tp")
			for _i in 20:
				await get_tree().process_frame
			for modo in (["corriendo"] if "--rapido" in OS.get_cmdline_user_args() else ["quieto", "corriendo"]):
				# correr: se le fuerza el estado y la velocidad hacia delante durante un rato
				# CORRER DE VERDAD: hay que PULSAR las teclas. Poniendo `sprinting` a mano no vale, porque
				# el jugador la recalcula desde el mando en cada paso de fisica y la apagaba al instante
				# (las primeras fotos salieron con la pose de cadera creyendo que era la de esprintar).
				if modo == "corriendo":
					for a_g in OS.get_cmdline_user_args():   # --sprintgiro=grados: hacia donde corre (un sitio despejado)
						if String(a_g).begins_with("--sprintgiro=") and "look" in player:
							player.look = Vector2(deg_to_rad(float(String(a_g).substr(13))), 0.0)
					Input.action_press("sprint")
					Input.action_press("move_forward")
					player.touch_move = Vector2(0.0, -1.0)
				for _f in 50:
					await get_tree().process_frame
				if modo == "corriendo":
					print("[esprintfoto] esprint=%s peso=%.2f · brazos visibles %s · mano libre %.2f · arma %s" % [str(player.sprinting), player._sprint_w,
						str(player.fp_arms.visible if player.fp_arms else null), float(player.fp_arms.get("mano_libre_w")) if player.fp_arms else -1.0,
						String(Weapons.LIST[player.current].get("kind", ""))])
					var fa = player.fp_arms
					if fa and fa.skeleton and player.weapon_model:
						var mano_g: String = "hand_l" if fa._swap_hands else "hand_r"
						var mg: Vector3 = fa.skeleton.global_transform * fa.skeleton.get_bone_global_pose(fa.bone_idx[mano_g]).origin
						var gp: Vector3 = player.weapon_model.global_transform * player.weapon_model.grip_pos
						print("[esprintfoto] muñeca del gatillo -> empuñadura: %.3f m" % mg.distance_to(gp))
				for _f2 in 3:
					await RenderingServer.frame_post_draw
				var nombre := "esprint_%s_%s_%s" % [par[1], vista, modo]
				get_viewport().get_texture().get_image().save_png("user://%s.png" % nombre)
				# --sprinttira: 6 fotogramas mas corriendo, cada 0,1 s (el balanceo de la zancada)
				if modo == "corriendo" and "--sprinttira" in OS.get_cmdline_user_args():
					for k_t in 6:
						player.bob_t += 1.05     # la zancada, aunque la pared no le deje avanzar
						await get_tree().create_timer(0.1).timeout
						await RenderingServer.frame_post_draw
						get_viewport().get_texture().get_image().save_png("user://%s_%d.png" % [nombre, k_t])
				print("[esprintfoto] %s" % nombre)
				Input.action_release("sprint")
				Input.action_release("move_forward")
				player.touch_move = Vector2.ZERO
	player.set_third_person(false)
	get_tree().quit(0)


## --escudofoto: FOTO DEL ESCUDO EN PRIMERA PERSONA, en guardia y apuntando. El usuario: "el visor no
## esta centrado, hay que moverlo a la izquierda". Con la foto se mide en pixeles cuanto se desvia la
## ventana del centro de la pantalla, en vez de moverlo a ojo.
func _escudo_foto() -> void:
	await get_tree().create_timer(5.0).timeout
	Settings.loadout["primary"] = "escudo_pistola"
	Weapons.rebuild()
	player.refresh_ammo_slots()
	player.switch_weapon(0)
	for _i in 60:
		await get_tree().process_frame
	# MIRANDO AL CIELO, si se pide: con el fondo liso, lo que tape la mira es por fuerza el escudo o la
	# pistola, no una columna del mapa que caiga delante (que con el zoom de apuntar se agranda igual).
	if "--cielo" in OS.get_cmdline_user_args():
		player.look_at_point(player.global_position + Vector3(0, 60, -20))
	# "dispara": el caso del movil. Gatillo apretado SIN apuntar: la pistola sale por el canto y dispara.
	# --escudosoltar: apuntar 1 s y soltar; cuanto tarda la pistola en volver detras del escudo
	if "--escudosoltar" in OS.get_cmdline_user_args():
		for disparando in [false, true, "solo_gatillo"]:
			player.set_touch_aim(not (disparando is String))
			if disparando is String:
				disparando = true
			player.set_touch_fire(disparando)
			for _i in 60:
				await get_tree().process_frame
			player.set_touch_fire(false)
			player.set_touch_aim(false)
			var t0 := Time.get_ticks_msec()
			var linea := ""
			for _i in 120:
				await get_tree().process_frame
				var ap: float = float(player.avatar.escudo_estado().get("apunta", 0.0))
				if int(Time.get_ticks_msec() - t0) % 100 < 18:
					linea += "%d:%.2f%s%s " % [Time.get_ticks_msec() - t0, ap, "P" if player.aiming else "", "A" if player.avatar.aiming else ""]
				if ap <= 0.001:
					print("[escudosoltar] %s: vuelve a cubrirse en %d ms (aiming=%s) · %s" % ["disparando" if disparando else "solo apuntando", Time.get_ticks_msec() - t0, str(player.aiming), linea])
					break
	# "vuelve": justo despues de dejar de disparar, la pistola volviendo detras del escudo (sin la mano del gatillo)
	if "--escudovuelve" in OS.get_cmdline_user_args():
		player.set_touch_fire(true)
		for _i in 45:
			await get_tree().process_frame
		player.set_touch_fire(false)
		for k in 10:
			for _i in 8:
				await get_tree().process_frame
			await RenderingServer.frame_post_draw
			get_viewport().get_texture().get_image().save_png("user://escudo_vuelve%d.png" % k)
	for par in [["guardia", false, false], ["dispara", false, true], ["apunta", true, false]]:
		player.set_touch_aim(bool(par[1]))
		player.set_touch_fire(bool(par[2]))
		for _i in 45:
			await get_tree().process_frame
		for _f in 3:
			await RenderingServer.frame_post_draw
		var img := get_viewport().get_texture().get_image()
		img.save_png("user://escudo_%s.png" % String(par[0]))
		var r: Rect2 = player._ventana_escudo_en_pantalla()
		var centro: Vector2 = get_viewport().get_visible_rect().size * 0.5
		print("[escudofoto] %s -> user://escudo_%s.png (%dx%d) · ventana %s · su centro %s · el de la pantalla %s · desvio %s px" % [
			par[0], par[0], img.get_width(), img.get_height(), str(r), str(r.get_center().round()),
			str(centro), str((r.get_center() - centro).round())])
	# y un arma normal (la ranura 2), para ver el tamaño de la mira al apuntar
	player.set_touch_fire(false)
	player.set_touch_aim(false)
	player.switch_weapon(1)
	for _i in 60:
		await get_tree().process_frame
	for par2 in [["fusil_cadera", false], ["fusil_apunta", true]]:
		player.set_touch_aim(bool(par2[1]))
		for _i in 45:
			await get_tree().process_frame
		for _f in 3:
			await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("user://escudo_%s.png" % String(par2[0]))
		print("[escudofoto] %s guardada" % par2[0])
	get_tree().quit(0)


## --volar=x,y,z,r|x,y,z,r|...: explosiones en puntos fijos cada 0,7 s y, durante 25 s, la lista de bloques
## (voxels, posicion, estado) cada segundo. Para ver COMO cae algo del mapa de pruebas: si se levanta, si
## flota, si se congela en el aire, si se deshace.
func _volar_test(spec: String) -> void:
	await get_tree().create_timer(4.0).timeout
	for _e in 600:
		var _si: Dictionary = world.get_stats()
		if not bool(_si.get("loading", false)) and int(_si.get("jobs_pending", 0)) == 0:
			break
		await get_tree().process_frame
	for e in enemies.get_children():
		e.queue_free()
	player.invulnerable = true
	var puntos: Array = []
	for tok in spec.split("|"):
		var v := String(tok).split(",")
		if v.size() >= 4:
			puntos.append([Vector3(float(v[0]), float(v[1]), float(v[2])), float(v[3])])
	for p in puntos:
		world.explode(p[0], p[1], 255)
		print("[volar] t=%.2f BOOM en %s r=%.1f" % [Time.get_ticks_msec() / 1000.0, str(p[0]), p[1]])
		await get_tree().create_timer(0.7).timeout
	var t0 := Time.get_ticks_msec()
	while Time.get_ticks_msec() - t0 < 25000:
		await get_tree().create_timer(1.0).timeout
		var lista: Array = world.bodies_info()
		var grandes := PackedStringArray()
		var sueltos := 0
		for b in lista:
			if int(b["voxels"]) >= 500:
				var pos: Vector3 = b["pos"]
				grandes.append("%dvox@(%.1f,%.2f,%.1f)%s%s v%.2f" % [int(b["voxels"]), pos.x, pos.y, pos.z,
					"C" if bool(b["congelado"]) else "", "A" if bool(b["anclado"]) else "", float(b["vel"])])
			else:
				sueltos += 1
		print("[volar] t=%2d s · bloques %d (pequenos %d): %s" % [(Time.get_ticks_msec() - t0) / 1000, lista.size(), sueltos, " ".join(grandes)])
		if "--picar" in OS.get_cmdline_user_args() and (Time.get_ticks_msec() - t0) / 1000 == 12 and not lista.is_empty():
			var mayor: Dictionary = lista[0]
			for b in lista:
				if int(b["voxels"]) > int(mayor["voxels"]):
					mayor = b
			var pm: Vector3 = mayor["pos"]
			var antes: int = int(world.get_stats().get("debris_active", 0))
			var quitados: int = world.carve_body_near(pm + Vector3(0, 0.3, 0), 0.5, 255)
			await get_tree().process_frame
			print("[volar] PICAR el bloque de %d vox en %s: quita %d voxels · escombro activo %d -> %d" % [int(mayor["voxels"]), str(pm), quitados, antes, int(world.get_stats().get("debris_active", 0))])
	if "--diagsync" in OS.get_cmdline_user_args():
		return      # dentro del banco de sincronia: la partida sigue para que se comparen las dos maquinas
	get_tree().quit(0)


## --auditaflotadores: lista lo que NO toca un ancla en el mapa cargado (10 cm en PC), intacto o no. Es lo
## que se cae en cascada en cuanto danas algo cerca (regla pristine). Para encontrar lo que el generador
## dejo sin pegar: voxels, centro y cuantos chunks ocupa, de mayor a menor.
func _audita_flotadores_test() -> void:
	await get_tree().create_timer(4.0).timeout
	for _e in 600:
		var _si: Dictionary = world.get_stats()
		if not bool(_si.get("loading", false)) and int(_si.get("jobs_pending", 0)) == 0 and int(_si.get("mesh_results_pending", 0)) == 0:
			break
		await get_tree().process_frame
	var t0 := Time.get_ticks_msec()
	var lista: Array = world.audit_floaters()
	var total := 0
	for g in lista:
		total += int(g["voxels"])
	print("[flotadores] %s: %d conjuntos sin ancla, %d voxels (%d ms)" % [current_map, lista.size(), total, Time.get_ticks_msec() - t0])
	for i in mini(60, lista.size()):
		var g: Dictionary = lista[i]
		var c: Vector3 = g["centro"]
		print("[flotadores] %8d vox  %3d chunks  centro (%6.1f, %5.1f, %6.1f)" % [int(g["voxels"]), int(g["chunks"]), c.x, c.y, c.z])
	var cubos := [0, 0, 0, 0, 0]
	for g in lista:
		var v := int(g["voxels"])
		cubos[0 if v < 100 else (1 if v < 1000 else (2 if v < 10000 else (3 if v < 100000 else 4)))] += 1
	print("[flotadores] por tamano: <100: %d · <1k: %d · <10k: %d · <100k: %d · 100k+: %d" % cubos)
	get_tree().quit(0)


## --bancofps: EL BANCO DE VERDAD, repetible. El de --goliatfps servia para ver el problema, pero como
## el jefe anda y pelea solo, dos corridas no median lo mismo (24, 35, 46 fps con los mismos ajustes) y
## asi no se puede optimizar nada. Aqui NO hay nadie vivo, el jugador esta clavado mirando siempre al
## mismo sitio, y la destruccion son explosiones en puntos fijos cada medio segundo. Dos fases:
##   1) 10 s quieto      -> lo que cuesta DIBUJAR el mapa (la linea base)
##   2) 15 s demoliendo  -> lo que anade la destruccion
## Variantes para probar sin tocar el juego: --oclusion, --sombras=N, --nosombras, --lejos=N.
func _banco_fps_test() -> void:
	await get_tree().create_timer(6.0).timeout
	if "--techoprueba" in OS.get_cmdline_user_args():
		var tam: Vector3 = world.get_world_size()
		var px: float = tam.x / float(TECHO_PX)
		var pz: float = tam.z / float(TECHO_PX)
		var t0 := Time.get_ticks_usec()
		_techo_gd = false
		_techo_filas(0, TECHO_PX - 1, 0, TECHO_PX, px, pz)
		var t_c := Time.get_ticks_usec() - t0
		var a := _techo_datos.duplicate()
		t0 = Time.get_ticks_usec()
		_techo_gd = true
		_techo_filas(0, TECHO_PX - 1, 0, TECHO_PX, px, pz)
		var t_g := Time.get_ticks_usec() - t0
		_techo_gd = false
		var dif := 0
		for i in a.size():
			if a[i] != _techo_datos[i]:
				dif += 1
		print("[techoprueba] casillas distintas %d de %d · C++ %.1f ms · GDScript %.1f ms" % [dif, a.size(), t_c / 1000.0, t_g / 1000.0])
		get_tree().quit()
		return
	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
	Engine.max_fps = 0
	for c in get_tree().get_nodes_in_group("criaturas"):
		if is_instance_valid(c):
			c.queue_free()
	# los bots tambien fuera: en un mapa de atraco (Monaco) pelean entre si y revientan cosas distintas cada
	# vez, y el banco daba 20, 50 y 71 fps en el mismo sitio. Se borran sin matarlos, asi no reaparecen.
	for b in get_tree().get_nodes_in_group("enemies"):
		if is_instance_valid(b):
			b.queue_free()
	if pve:
		pve.set_process(false)
		pve.set_physics_process(false)
	player.set("invulnerable", true)
	# un sitio fijo de cuarentena mirando a la ciudad (medido a mano: hay edificios delante)
	# --sitio=x,y,z,giro: otro sitio fijo (para medir en otros mapas, p. ej. Monaco)
	var _sitio := Vector3(147.8, 2.0, 59.2)
	var _giro := 200.0
	for _s in OS.get_cmdline_user_args():
		if String(_s).begins_with("--sitio="):
			var _v := String(_s).substr(8).split(",")
			if _v.size() >= 3:
				_sitio = Vector3(float(_v[0]), float(_v[1]), float(_v[2]))
			if _v.size() >= 4:
				_giro = float(_v[3])
	# EN ATRACO, AL ELEGIR BANDO EL JUEGO RECOLOCA AL JUGADOR despues de que el banco lo haya puesto (salia
	# amarillo en una corrida y violeta en otra, mirando a sitios distintos): se coloca aqui y OTRA VEZ justo
	# antes de medir, y se imprime donde queda para poder comprobarlo
	var _colocar := func() -> void:
		player.global_position = _sitio
		player.velocity = Vector3.ZERO
		# el raton capturado movia la vista entre corridas (-11..3 grados): el jugador no lee entrada en el banco
		player.set_process_input(false)
		player.set_process_unhandled_input(false)
		player.rotation.y = deg_to_rad(_giro)
		if "look" in player:
			player.look = Vector2(deg_to_rad(_giro), deg_to_rad(80.0 if "--mirarcielo" in OS.get_cmdline_user_args() else -6.0))
	player.global_position = _sitio
	player.rotation.y = deg_to_rad(_giro)
	# --mirarcielo: la camara al cielo. Si mirando al vacio cuesta lo mismo que mirando a la ciudad,
	# el problema no es lo que se dibuja.
	var _pitch := deg_to_rad(80.0 if "--mirarcielo" in OS.get_cmdline_user_args() else -6.0)
	if player.has_node("Camera3D"):
		(player.get_node("Camera3D") as Node3D).rotation.x = _pitch
	# el guion del jugador escribe rotation.y y la camara desde `look` CADA cuadro: si no se fija tambien
	# aqui, el banco mira a donde apuntase el raton y una corrida no rompe lo mismo que otra
	if "look" in player:
		player.look = Vector2(deg_to_rad(_giro), _pitch)
	if "--oclusion" in OS.get_cmdline_user_args():
		get_viewport().use_occlusion_culling = true
		if world.has_method("set_use_occluders"):
			world.set_use_occluders(true)   # sin esto no hay oclusores y no se recorta nada (medido: 0)
	if "--sinrecortesol" in OS.get_cmdline_user_args() and world.has_method("set_shadow_light_dir"):
		world.set_shadow_light_dir(Vector3.ZERO)   # caster de sombras con TODAS las caras, como antes
	for _a in OS.get_cmdline_user_args():
		if String(_a).begins_with("--sombras=") and sun:
			sun.directional_shadow_max_distance = float(String(_a).substr(10))
		if String(_a).begins_with("--lejos="):
			world.set_render_distance_scale(float(String(_a).substr(8)))
	if "--nosombras" in OS.get_cmdline_user_args() and sun:
		sun.shadow_enabled = false
	if "--sinfisica" in OS.get_cmdline_user_args():
		world.set_phys_updates(false)
	# --soltarlod2: los bloques de las regiones que se ven con LOD2 tambien sueltan su malla fina (menos memoria, LOD1
	# un instante tras un salto lejano; ver VoxelWorld.set_soltar_bloques)
	if "--soltarlod2" in OS.get_cmdline_user_args() and world.has_method("set_soltar_bloques"):
		world.set_soltar_bloques(2)
	if "--sinlente" in OS.get_cmdline_user_args() and hud:
		hud.set_lente(0)
	if "--sinao" in OS.get_cmdline_user_args():
		set_voxel_ao(false)      # la oclusion de voxels es una pasada a pantalla completa: medir cuanto cuesta
	# mas piezas de la GPU, una a una: luces, MSAA, motion blur
	if "--sinluces" in OS.get_cmdline_user_args():
		for _l in find_children("*", "OmniLight3D", true, false) + find_children("*", "SpotLight3D", true, false):
			(_l as Light3D).visible = false
	if "--sinmsaa" in OS.get_cmdline_user_args():
		get_viewport().msaa_3d = Viewport.MSAA_DISABLED
	if "--sinmblur" in OS.get_cmdline_user_args() and hud and ("mblur" in hud) and hud.mblur:
		(hud.mblur as CanvasItem).visible = false
	# --capsula / --sinsnap: hipotesis sobre el coste de move_and_slide (cilindro vs capsula; el snap al suelo)
	if "--capsula" in OS.get_cmdline_user_args():
		var _cs := CapsuleShape3D.new()
		_cs.radius = 0.35
		_cs.height = 1.6
		(player.get("col") as CollisionShape3D).shape = _cs
	if "--sinsnap" in OS.get_cmdline_user_args():
		player.floor_snap_length = 0.0
	for _a3 in OS.get_cmdline_user_args():
		if String(_a3).begins_with("--maxpasos="):
			Engine.max_physics_steps_per_frame = int(String(_a3).substr(11))
	if "--sincompresion" in OS.get_cmdline_user_args() and world.has_method("set_compress_attributes"):
		world.set_compress_attributes(false)
	if "--sinlimiteescombro" in OS.get_cmdline_user_args():
		Audio.escombro_gap = 0.0      # como estaba antes: un sonido por escombro que aterriza
	if "--caja" in OS.get_cmdline_user_args():
		var _bx := BoxShape3D.new()
		_bx.size = Vector3(0.7, 1.6, 0.7)
		(player.get("col") as CollisionShape3D).shape = _bx
	if "--sinestructura" in OS.get_cmdline_user_args():
		world.set_structural_load(false)
	if "--cielosimple" in OS.get_cmdline_user_args():
		var sk := Sky.new()
		sk.sky_material = ProceduralSkyMaterial.new()
		(env.environment as Environment).sky = sk
	var _e: Environment = env.environment
	if "--noglow" in OS.get_cmdline_user_args():
		_e.glow_enabled = false
	if "--nonieblavol" in OS.get_cmdline_user_args():
		_e.volumetric_fog_enabled = false
	if "--noniebla" in OS.get_cmdline_user_args():
		_e.fog_enabled = false
		_e.volumetric_fog_enabled = false
	for _a2 in OS.get_cmdline_user_args():
		if String(_a2).begins_with("--escala="):
			get_viewport().scaling_3d_scale = float(String(_a2).substr(9))
	print("[bancofps] tope de fps %d · vsync %d · tope de pasos de fisica por cuadro %d" % [Engine.max_fps, DisplayServer.window_get_vsync_mode(), Engine.max_physics_steps_per_frame])
	var _gv := PackedStringArray()
	for _k in Settings.GFX_OPTIONS.keys():
		if Settings.GFX_PRESETS.has(_k):
			_gv.append("%s=%s" % [String(_k), str(Settings.gfx_value(String(_k), quality))])
	print("[bancofps] ajustes: ", " ".join(_gv))
	print("[bancofps] pantalla %s · escala3d %.2f · glow %s · niebla %s/vol %s" % [
		str(get_viewport().get_visible_rect().size), get_viewport().scaling_3d_scale,
		str(_e.glow_enabled), str(_e.fog_enabled), str(_e.volumetric_fog_enabled)])
	# --sinarma / --sininterfaz: para ver cuanto cuestan el arma en primera persona y la interfaz
	if "--sinarma" in OS.get_cmdline_user_args():
		for n in player.find_children("*", "MeshInstance3D", true, false):
			(n as MeshInstance3D).visible = false
		for n in player.find_children("*", "Node3D", true, false):
			if String(n.name).to_lower().contains("weapon") or String(n.name).to_lower().contains("arma"):
				(n as Node3D).visible = false
	if "--sininterfaz" in OS.get_cmdline_user_args():
		for n in get_tree().get_nodes_in_group("hud"):
			if n is CanvasItem:
				(n as CanvasItem).visible = false
		if hud:
			hud.visible = false
	for _q in 120:
		await get_tree().process_frame
	# ...y hasta que el mundo este OCIOSO (bloques, regiones, colision y trabajos): si no, la fase 'quieto'
	# media el final de la carga y salia distinta cada vez
	var _esp := 0
	while _esp < 1200:
		var _si: Dictionary = world.get_stats()
		if int(_si.get("blocks_dirty", 0)) == 0 and int(_si.get("regions_dirty", 0)) == 0 and int(_si.get("phys_queue", 0)) == 0 and int(_si.get("jobs_pending", 0)) == 0 and int(_si.get("mesh_results_pending", 0)) == 0:
			break
		await get_tree().process_frame
		_esp += 1
	_colocar.call()
	for _q2 in 30:
		await get_tree().process_frame
	print("[bancofps] jugador en %s mirando %.0f° · bando %s" % [str(player.global_position.snapped(Vector3(0.1, 0.1, 0.1))), rad_to_deg(player.rotation.y), Net.my_team()])
	var _s0: Dictionary = world.get_stats()
	print("[bancofps] ocioso tras %d cuadros de espera · bloques sucios %d · regiones %d · cola fisica %d · trabajos %d" % [
		_esp, _s0.get("blocks_dirty", 0), _s0.get("regions_dirty", 0), _s0.get("phys_queue", 0), _s0.get("jobs_pending", 0)])
	# --bancofoto: guarda lo que ve el banco, para comprobar que el sitio elegido mira a algo
	if "--bancofoto" in OS.get_cmdline_user_args():
		await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("user://bancofps.png")
		print("[bancofps] foto en ", ProjectSettings.globalize_path("user://bancofps.png"))
	Prof.reset()
	# --explosiones=N y --radio=R: cuantas y de que tamano (por defecto 30 de 2,2 m cada medio segundo; con 1 se ve
	# lo que hace UNA explosion como en el juego real)
	var _n_max := 1 << 30
	var _radio := 2.2
	for _a4 in OS.get_cmdline_user_args():
		if String(_a4).begins_with("--explosiones="):
			_n_max = int(String(_a4).substr(14))
		if String(_a4).begins_with("--radio="):
			_radio = float(String(_a4).substr(8))
	var medir := func(segundos: float, romper: bool) -> Array:
		var ts: Array[float] = []
		var t0 := Time.get_ticks_usec()
		var tp := t0
		var siguiente := 0.0
		var n_exp := 0
		var pf0 := Engine.get_physics_frames()
		var pf_prev := pf0
		var tph: Array[float] = []
		var tpr: Array[float] = []
		var lentos_det: Array = []
		Prof.reset()
		while Time.get_ticks_usec() - t0 < int(segundos * 1e6):
			await get_tree().process_frame
			var ahora := Time.get_ticks_usec()
			ts.append(float(ahora - tp) / 1000.0)
			# TIME_PHYSICS_PROCESS es el PEOR paso del frame, no la suma: se multiplica por los pasos que hubo
			var _pfn := Engine.get_physics_frames()
			var _pms: float = Performance.get_monitor(Performance.TIME_PHYSICS_PROCESS) * 1000.0
			tph.append(_pms * float(_pfn - pf_prev))
			tpr.append(Performance.get_monitor(Performance.TIME_PROCESS) * 1000.0)
			# los peores fotogramas, con sus ticks de fisica y el peor paso: para saber si el bajon es la fisica
			# poniendose al dia o trabajo del hilo principal (mallas, piezas, efectos)
			lentos_det.append([float(ahora - tp) / 1000.0, _pfn - pf_prev, _pms, Time.get_ticks_msec() - int(t0 / 1000)])
			pf_prev = _pfn
			tp = ahora
			var t: float = float(ahora - t0) / 1e6
			if romper and t >= siguiente and n_exp < _n_max:
				siguiente = t + 0.5
				# puntos fijos delante del jugador: siempre la misma demolicion
				var frente: Vector3 = -player.global_transform.basis.z
				var sitio: Vector3 = player.global_position + frente * (9.0 + 1.2 * (n_exp % 5)) 					+ Vector3.UP * (1.0 + 0.8 * float(n_exp % 3)) + player.global_transform.basis.x * (float(n_exp % 7) - 3.0)
				world.explode(sitio, _radio, 255)
				n_exp += 1
		ts.sort()
		tph.sort()
		tpr.sort()
		lentos_det.sort_custom(func(a, b): return a[0] > b[0])
		var _peores := PackedStringArray()
		for _i in mini(8, lentos_det.size()):
			var _d: Array = lentos_det[_i]
			_peores.append("%.0fms(t%d f%.0f @%ds)" % [_d[0], _d[1], _d[2], _d[3] / 1000])
		print("[bancofps] peores %s: " % ("DEMOL" if romper else "QUIETO"), " ".join(_peores))
		var lentos := 0
		for x in ts:
			if x > 16.7:
				lentos += 1
		var st: Dictionary = world.get_stats()
		return [ts[ts.size() / 2], ts[int(ts.size() * 0.95)], 100.0 * float(lentos) / float(ts.size()), n_exp,
			st.get("tris_visible", 0), st.get("t_struct_ms", 0.0), st.get("piezas_instancias", 0),
			RenderingServer.viewport_get_measured_render_time_gpu(get_viewport().get_viewport_rid()),
			RenderingServer.viewport_get_measured_render_time_cpu(get_viewport().get_viewport_rid()),
			Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME),
			tpr[tpr.size() / 2],
			tph[tph.size() / 2],
			float(Engine.get_physics_frames() - pf0) / float(maxi(1, ts.size())), Prof.report()]
	Engine.max_fps = 0
	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
	var quieto: Array = await medir.call(10.0, false)
	# --sinromper: solo la fase quieta (para atribuir la GPU no hace falta demoler)
	var roto: Array = quieto if "--sinromper" in OS.get_cmdline_user_args() else await medir.call(15.0, true)
	var st0: Dictionary = world.get_stats()
	print("[bancofps] calidad %s · oclusion %s · sombras %.0f m (%s) · distancia %.0f m" % [
		str(st0.get("quality", "?")), str(get_viewport().use_occlusion_culling),
		sun.directional_shadow_max_distance if sun else -1.0,
		"si" if (sun and sun.shadow_enabled) else "no", st0.get("render_distance", 0.0)])
	print("[bancofps] desprendido: grupos por desconexion %d · por sobrecarga %d · voxels %d · fallos estructurales %d · piezas %d" % [
		int(st0.get("groups_plain", 0)), int(st0.get("groups_structural", 0)), int(st0.get("group_voxels", 0)),
		int(st0.get("struct_failures", 0)), int(st0.get("pieces_total", 0))])
	print("[bancofps] piezas: por sobrecarga %d (%d voxels) · sueltas %d (%d voxels) · de 10k+ voxels %d · la mayor %d voxels" % [
		int(st0.get("pz_estruct", 0)), int(st0.get("vox_estruct", 0)), int(st0.get("pz_sueltas", 0)), int(st0.get("vox_sueltas", 0)),
		int(st0.get("pz_grandes", 0)), int(st0.get("pz_mayor", 0))])
	print("[bancofps] geometria: tris totales %d · visibles %d · sombra %d · oclusores %d (%d tris) · AO quad %s" % [
		int(st0.get("tris_total", 0)), int(st0.get("tris_visible", 0)), int(st0.get("shadow_tris", 0)),
		int(st0.get("occluders", 0)), int(st0.get("occluder_tris", 0)),
		str(_ao_on)])
	for par in [["QUIETO   ", quieto], ["DEMOLIEND", roto]]:
		var r: Array = par[1]
		print("[bancofps] %s mediana %6.2f ms (%3.0f fps) · p95 %6.2f ms · lentos %3.0f%% · explosiones %2d | tris %6d estructura %6.1f ms piezas %4d | gpu %5.2f cpu %5.2f dibujos %4d | proceso %5.2f fisica %5.2f (medianas) · ticks/frame %.2f" % [
			par[0], r[0], 1000.0 / maxf(0.01, r[0]), r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9], r[10], r[11], r[12]])
	# en que se va el tiempo del guion (Prof) y de la extension (fases t_h_*), medias del banco entero
	print("[bancofps] bots vivos al final: %d · VRAM %.0f MB · RAM %.0f MB" % [get_tree().get_nodes_in_group("enemies").size(),
		Performance.get_monitor(Performance.RENDER_VIDEO_MEM_USED) / 1048576.0, Performance.get_monitor(Performance.MEMORY_STATIC) / 1048576.0])
	print("[bancofps] fisica al final: cuerpos estaticos %d · rigidos %d · despiertos %d · formas %d (peor %d) · cajas congeladas %d" % [
		st0.get("static_bodies", 0), st0.get("bodies_rigid", 0), st0.get("bodies_awake", 0), st0.get("shapes_total", 0), st0.get("shapes_max", 0), st0.get("cajas_congelado", 0)])
	print("[bancofps] guion QUIETO   : ", quieto[13])
	print("[bancofps] guion DEMOLIEND: ", roto[13])
	var _fases := PackedStringArray()
	for _k in st0.keys():
		if String(_k).begins_with("t_h") or String(_k) == "t_update_ms":
			_fases.append("%s %.2f" % [String(_k), float(st0[_k])])
	print("[bancofps] extension: ", " ".join(_fases))
	get_tree().quit(0)


## --goliatfps: EL BANCO DE LA DEMOLICION. El usuario: "el Goliat cuando destruye empieza a sentir mucho
## lag". Aqui el jefe tira una casa a golpes durante 25 segundos mientras se apunta CADA FOTOGRAMA lo que
## tarda, y al final salen la mediana, el 1% peor y en que se va el tiempo (vxcore, fisica, render). Es
## la unica forma de saber si una optimizacion sirve: el "va mas fluido" a ojo no vale.
func _goliat_fps_test() -> void:
	await get_tree().create_timer(8.0).timeout
	if pve == null:
		print("[goliatfps] FALLO: hace falta --map=pve_cuarentena")
		get_tree().quit(1)
		return
	pve.empezar_ya(10)
	var g = null
	for _w in 40:
		await get_tree().create_timer(1.0).timeout
		for c in get_tree().get_nodes_in_group("criaturas"):
			if is_instance_valid(c) and String(c.get("tipo")) == "goliat":
				g = c
		if g != null:
			break
	if g == null:
		print("[goliatfps] FALLO: no ha salido el Goliat")
		get_tree().quit(1)
		return
	player.set("invulnerable", true)
	# una casa cerca: el primer muro que se encuentre a partir de 7 m
	var pared := Vector3.INF
	var hacia := Vector3.ZERO
	for i in 48:
		var a2: float = TAU * float(i) / 48.0
		var dir := Vector3(cos(a2), 0, sin(a2))
		for alt in [1.5, 3.0, 5.0]:
			var h: Dictionary = world.raycast(g.global_position + Vector3.UP * alt, dir, 45.0)
			if not h.get("hit", false):
				continue
			var d: float = (h["position"] - g.global_position).length()
			if d > 7.0 and (pared == Vector3.INF or d < (pared - g.global_position).length()):
				pared = h["position"]
				hacia = dir
	if pared == Vector3.INF:
		print("[goliatfps] FALLO: no hay pared cerca")
		get_tree().quit(1)
		return
	# el jefe pegado al muro y el jugador mirando desde 9 m (lo que ve el jugador es parte del coste)
	g.global_position = pared - hacia * 3.0
	player.global_position = pared - hacia * 11.0 + Vector3.UP * 1.0
	for _q in 60:
		await get_tree().physics_frame
	# SIN VSYNC: con el vsync puesto, un fotograma que se pasa de 16,7 ms espera al siguiente refresco y
	# se mide 33 ms aunque solo le sobrara 1 ms. Para optimizar hace falta el coste de verdad.
	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
	Engine.max_fps = 0
	# variantes que se pueden probar sin tocar el juego: --oclusion, --sombras=N, --nosombras
	var _args := " ".join(OS.get_cmdline_user_args())
	if "--oclusion" in OS.get_cmdline_user_args():
		get_viewport().use_occlusion_culling = true
	for _a in OS.get_cmdline_user_args():
		if String(_a).begins_with("--sombras=") and sun:
			sun.directional_shadow_max_distance = float(String(_a).substr(10))
	if "--nosombras" in OS.get_cmdline_user_args() and sun:
		sun.shadow_enabled = false
	print("[goliatfps] variante: oclusion %s · sombras %.0f m (%s)" % [
		str(get_viewport().use_occlusion_culling),
		sun.directional_shadow_max_distance if sun else -1.0,
		"encendidas" if (sun and sun.shadow_enabled) else "apagadas"])
	var tiempos: Array[float] = []
	Prof.reset()
	var t_ini := Time.get_ticks_usec()
	var t_prev := t_ini
	var golpes := 0
	var muestras: Array = []
	while Time.get_ticks_usec() - t_ini < 25_000_000:
		await get_tree().process_frame
		var ahora := Time.get_ticks_usec()
		tiempos.append(float(ahora - t_prev) / 1000.0)
		t_prev = ahora
		Prof.frames += 1
		# que no pare de romper: se le fuerza el golpe en cuanto se le pasa el enfriamiento
		# (con --sinromper no rompe nada: es la linea base de la misma escena, para poder comparar)
		if g._romper_t <= 0.0 and not g.muerta and not ("--sinromper" in OS.get_cmdline_user_args()):
			g.global_position = pared - hacia * 3.0
			g._romper_delante(hacia)
			golpes += 1
		if tiempos.size() % 90 == 0:
			var st: Dictionary = world.get_stats()
			muestras.append("%5.1fs piezas %4d cuerpos %3d/%3d | host %5.2f (upd %.2f sube %.2f bloq %.2f reg %.2f fis %.2f nace %.2f cuerpos %.2f escombro %.2f) | estr %6.2f escaneo %5.2f grumos %5.2f | malla %5.2f | explota %5.2f" % [
				float(ahora - t_ini) / 1e6, st.get("pieces_total", 0), st.get("bodies_active", 0), st.get("bodies_rigid", 0),
				st.get("t_host_ms", 0.0), st.get("t_h_update", 0.0), st.get("t_h_upload", 0.0), st.get("t_h_blocks", 0.0),
				st.get("t_h_regions", 0.0), st.get("t_h_phys", 0.0), st.get("t_h_spawn", 0.0), st.get("t_h_bodies", 0.0),
				st.get("t_h_debris", 0.0), st.get("t_struct_ms", 0.0), st.get("t_struct_scan_ms", 0.0),
				st.get("t_clumps_ms", 0.0), st.get("t_mesh_job_ms", 0.0), st.get("t_explode_total_ms", 0.0)])
			muestras.append("       mundo: calidad %s · tris visibles %7d · sombras %7d · occluders %3d · distancia %4.0f m" % [
				str(st.get("quality", "?")), st.get("tris_visible", 0), st.get("shadow_tris", 0),
				st.get("occluders", 0), st.get("render_distance", 0.0)])
			muestras.append("       render: cpu %5.2f gpu %5.2f | objetos %5d dibujos %5d tris %7d | vxcore dibuja: instancias %4d multimallas %4d" % [
				RenderingServer.viewport_get_measured_render_time_cpu(get_viewport().get_viewport_rid()),
				RenderingServer.viewport_get_measured_render_time_gpu(get_viewport().get_viewport_rid()),
				Performance.get_monitor(Performance.RENDER_TOTAL_OBJECTS_IN_FRAME),
				Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME),
				Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME),
				st.get("piezas_instancias", 0), st.get("grupos_fundidos", 0)])
			muestras.append("       piezas: sueltas dibujandose %4d · congeladas %4d · grupos %4d (sucios %3d) · formas de colision %5d (peor %3d) · cuerpos despiertos %3d" % [
				st.get("piezas_instancias", 0), st.get("piezas_congeladas", 0), st.get("grupos_fundidos", 0),
				st.get("grupos_sucios", 0), st.get("shapes_total", 0), st.get("shapes_max", 0),
				st.get("bodies_awake", 0)])
			muestras.append("       godot: proceso %5.2f fisica %5.2f | cuerpos fisicos %4d estaticos %5d pares %5d | nodos %4d" % [
				Performance.get_monitor(Performance.TIME_PROCESS) * 1000.0,
				Performance.get_monitor(Performance.TIME_PHYSICS_PROCESS) * 1000.0,
				Performance.get_monitor(Performance.PHYSICS_3D_ACTIVE_OBJECTS),
				st.get("static_bodies", 0), Performance.get_monitor(Performance.PHYSICS_3D_COLLISION_PAIRS),
				Performance.get_monitor(Performance.OBJECT_NODE_COUNT)])
	tiempos.sort()
	var n := tiempos.size()
	var lentos := 0
	for t in tiempos:
		if t > 16.7:
			lentos += 1
	for m in muestras:
		print("[goliatfps] ", m)
	print("[goliatfps] guiones de GDScript: ", Prof.report())
	print("[goliatfps] A*: peor fotograma %.1f ms · fotogramas por encima de 16 ms %d · por quien %s · bichos vivos %d" % [
		AstarTurno.peor_us / 1000.0, AstarTurno.fotogramas_sobre_16, str(AstarTurno.por_quien),
		get_tree().get_nodes_in_group("criaturas").size()])
	print("[goliatfps] %d fotogramas en 25 s · golpes %d · mediana %.1f ms (%.0f fps) · p95 %.1f ms · peor %.1f ms · por encima de 16,7 ms: %d%%" % [
		n, golpes, tiempos[n / 2], 1000.0 / maxf(0.01, tiempos[n / 2]), tiempos[int(n * 0.95)], tiempos[n - 1],
		int(100.0 * float(lentos) / maxf(1.0, float(n)))])
	get_tree().quit(0)


## --goliatpared: ¿ATRAVIESA LAS PAREDES? El usuario: "entro a una casa y la traspasa". Se busca un muro
## cerca del jefe, se pone al jugador AL OTRO LADO y se le deja ir a por el un minuto, mirando cada
## cuarto de segundo si su cuerpo esta metido dentro de algo solido. Con `--cajachica` se mide igual
## pero con la caja de colision de antes (1,2 m de ancho para un bicho de 3,6), para comparar.
func _goliat_pared_test() -> void:
	await get_tree().create_timer(8.0).timeout
	if pve == null:
		print("[goliatpared] FALLO: hace falta --map=pve_cuarentena")
		get_tree().quit(1)
		return
	pve.empezar_ya(10)
	var g = null
	for _w in 40:
		await get_tree().create_timer(1.0).timeout
		for c in get_tree().get_nodes_in_group("criaturas"):
			if is_instance_valid(c) and String(c.get("tipo")) == "goliat":
				g = c
		if g != null:
			break
	if g == null:
		print("[goliatpared] FALLO: no ha salido el Goliat")
		get_tree().quit(1)
		return
	g.set("caja_chica", "--cajachica" in OS.get_cmdline_user_args())
	player.set("invulnerable", true)
	# UN MURO CERCA: se tira un rayo en abanico y se coge el primero que choque entre 6 y 18 m
	var pared := Vector3.INF
	var hacia := Vector3.ZERO
	for i in 48:
		var a2: float = TAU * float(i) / 48.0
		var dir := Vector3(cos(a2), 0, sin(a2))
		for alt in [1.5, 3.0, 5.0]:
			var h: Dictionary = world.raycast(g.global_position + Vector3.UP * alt, dir, 45.0)
			if not h.get("hit", false):
				continue
			var d: float = (h["position"] - g.global_position).length()
			if d > 7.0 and (pared == Vector3.INF or d < (pared - g.global_position).length()):
				pared = h["position"]
				hacia = dir
	if pared == Vector3.INF:
		print("[goliatpared] FALLO: no hay ninguna pared cerca del jefe")
		get_tree().quit(1)
		return
	player.global_position = pared + hacia * 5.0 + Vector3.UP * 1.0
	var p0: Vector3 = g.global_position
	var dentro := 0
	var muestras := 0
	var cerca := 999.0
	var radio: float = float(g.datos.get("radio", 1.8))
	var alto: float = float(g.datos.get("alto", 6.5))
	for _t in 240:
		await get_tree().create_timer(0.25).timeout
		var q: Vector3 = g.global_position
		muestras += 1
		# ¿esta su cuerpo metido en algo solido? (caja de verdad, 0,3 m por dentro para no contar el suelo)
		if world.box_solid(q + Vector3(-radio + 0.3, 0.6, -radio + 0.3), q + Vector3(radio - 0.3, alto - 0.6, radio - 0.3)):
			dentro += 1
		cerca = minf(cerca, q.distance_to(player.global_position))
		if cerca < 4.0:
			break
	print("[goliatpared] caja %s · %d de %d muestras con el cuerpo DENTRO de un muro (%.0f%%) · se acerco a %.1f m · avanzo %.1f m" % [
		"chica (la de antes)" if g.get("caja_chica") else "entera", dentro, muestras,
		100.0 * float(dentro) / maxf(1.0, float(muestras)), cerca, p0.distance_to(g.global_position)])
	get_tree().quit(0)


## --goliatmira: ¿LLEGA A TOCARTE? El usuario: "parece que muerde al aire y los brazos no le llegan".
## Se planta al jefe delante, se le fuerza cada ataque y se mide, EN EL FOTOGRAMA DEL IMPACTO, a que
## distancia se quedan de tu pecho el morro y la mano. Primero con la correccion de `mirar_bicho.gd`
## apagada (lo que hacia antes) y despues encendida, para ver la diferencia en metros.
func _goliat_mira_test() -> void:
	await get_tree().create_timer(8.0).timeout
	if pve == null:
		print("[goliatmira] FALLO: hace falta --map=pve_cuarentena")
		get_tree().quit(1)
		return
	pve.empezar_ya(10)
	var g = null
	for _w in 40:
		await get_tree().create_timer(1.0).timeout
		for c in get_tree().get_nodes_in_group("criaturas"):
			if is_instance_valid(c) and String(c.get("tipo")) == "goliat":
				g = c
		if g != null:
			break
	if g == null:
		print("[goliatmira] FALLO: no ha salido el Goliat")
		get_tree().quit(1)
		return
	# que no se muera nadie mientras se mide
	player.set("invulnerable", true)
	for c in get_tree().get_nodes_in_group("criaturas"):
		if c != g and is_instance_valid(c):
			c.queue_free()
	var skel: Skeleton3D = null
	for n in (g._modelo.find_children("*", "Skeleton3D", true, false) if g._modelo else []):
		skel = n as Skeleton3D
	if skel == null:
		print("[goliatmira] FALLO: el modelo no trae esqueleto")
		get_tree().quit(1)
		return
	var punto := func(hueso: String) -> Vector3:
		var i := skel.find_bone(hueso)
		return (skel.global_transform * skel.get_bone_global_pose(i).origin) if i >= 0 else Vector3.INF
	var ataques: Array = g.datos.get("ataques", [])
	print("[goliatmira] ataque        | morro a tu pecho | mano a tu pecho")
	for apagada in [true, false]:
		g.set("mirada_apagada", apagada)
		for nombre in ["mordisco", "zarpazo", "zarpazo_izq", "zarpazo_doble"]:
			var at := {}
			for a2 in ataques:
				if String(a2.get("anim", "")) == nombre:
					at = a2
			if at.is_empty():
				continue
			# EL JEFE Y EL JUGADOR EN EL MISMO SUELO. Plantandolos a pelo, el jefe acababa subido a lo
			# que hubiera debajo (5 m mas arriba) y las distancias no median nada.
			var lejos: float = minf(float(at.get("alcance", 4.0)) - 0.6, 4.0)
			g.global_position = player.global_position + Vector3(0, 0.2, -lejos)
			g.velocity = Vector3.ZERO
			g.rotation.y = 0.0
			for _q in 30:
				await get_tree().physics_frame
			g.jugador = player
			g._ataque = at
			g._ataque_t = 9.0
			g._golpe_t = float(at.get("amago", 0.55))
			g._anim_bloqueo = g._golpe_t + 1.0
			g._anim_play(nombre, true)
			var morro := 99.0
			var mano := 99.0
			# LAS DISTANCIAS LAS DA EL PROPIO MODIFICADOR: desde aqui, get_bone_global_pose devuelve la
			# pose de la ANIMACION y no la corregida, y parecia que no servia de nada.
			var md0 = g.get("_mirador")
			while g._golpe_t >= 0.0:
				await get_tree().physics_frame
				await RenderingServer.frame_post_draw
				if md0 != null and md0.dist_morro >= 0.0:
					morro = minf(morro, md0.dist_morro)
				if md0 != null and md0.dist_mano >= 0.0:
					mano = minf(mano, md0.dist_mano)
			print("[goliatmira] %-13s | %s | morro %.2f m | mano %.2f m" % [
				nombre, "SIN mirada" if apagada else "CON mirada", morro, mano])
			await get_tree().create_timer(1.2).timeout
	get_tree().quit(0)


func _golpe_manos_test() -> void:
	await get_tree().create_timer(8.0).timeout
	if pve == null:
		print("[golpemanos] FALLO: hace falta --map=pve_cuarentena")
		get_tree().quit(1)
