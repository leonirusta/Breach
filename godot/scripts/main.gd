# LO QUE EL MAPA TRAE EN SUS JSON: agua, puertas y botin. Como el `.sites.json` con la bomba: si el
# archivo esta junto al mapa, se usa, sea el mapa que sea. Formatos en agua.gd, puertas.gd y botin.gd.
# ---------------------------------------------------------------------------------------------------
const AguaScript := preload("res://scripts/agua.gd")
const PuertasScript := preload("res://scripts/puertas.gd")
const BotinScript := preload("res://scripts/botin.gd")
const VehiculosScript := preload("res://scripts/vehiculos.gd")
const InventarioScript := preload("res://scripts/inventario_br.gd")
const SaltoScript := preload("res://scripts/salto_br.gd")
const ZonaScript := preload("res://scripts/zona_br.gd")
var salto_br = null               ## salto_br.gd: el avion del principio (o null)
var _bots_br = null                ## bots_br.gd: el cerebro de battle royale de los bots
var zona_br = null                ## zona_br.gd: la zona que se cierra (o null)


func _empezar_salto() -> void:
	if is_instance_valid(salto_br):
		salto_br.queue_free()
	salto_br = SaltoScript.new()
	salto_br.name = "SaltoBR"
	add_child(salto_br)
	salto_br.empezar(self, world, player)
	if is_instance_valid(zona_br):
		zona_br.queue_free()
	zona_br = ZonaScript.new()
	zona_br.name = "ZonaBR"
	add_child(zona_br)
	zona_br.empezar(self, world, player, salto_br)
	# LAS RATAS (ratas.gd): si el br.json las pide (la HABITACION)
	var cfg_ratas: Dictionary = SaltoScript.config_br(current_map).get("ratas", {})
	if not cfg_ratas.is_empty():
		var rt = load("res://scripts/ratas.gd").new()
		rt.name = "Ratas"
		add_child(rt)
		rt.empezar(self, world, player, cfg_ratas)
	# EL TREN DE JUGUETE (tren_cuarto.gd): si el br.json trae su via
	var cfg_tren: Dictionary = SaltoScript.config_br(current_map).get("tren", {})
	if not cfg_tren.is_empty():
		var tr = load("res://scripts/tren_cuarto.gd").new()
		add_child(tr)
		tr.empezar(self, world, cfg_tren)
	if "--pruebasalto" in OS.get_cmdline_user_args():
		_prueba_salto()
	elif "--pruebazona" in OS.get_cmdline_user_args():
		_prueba_zona()
	elif "--pruebafin" in OS.get_cmdline_user_args():
		_prueba_fin()


## --pruebasalto: EL AVION Y EL SALTO, midiendo. Espera a estar sobre la isla, salta, y comprueba que se cae
## deprisa, que el paracaidas se abre solo a su altura, que se aterriza sin perder vida, que los bots saltan
## y llegan al suelo, y cuanto cuesta. Sin --headless saca ademas fotos en user:// (avion, caida, paracaidas).
func _prueba_salto() -> void:
	var fallos := [0]           # en un Array: la lambda no puede reasignar una variable de fuera
	var linea := func(ok: bool, que: String) -> void:
		if not ok:
			fallos[0] += 1
		print("[pruebasalto] %s  %s" % ["OK   " if ok else "FALLO", que])
	# las fotos, solo si se piden: leer la imagen de la GPU y guardar el PNG son ~0,75 s de parón cada una,
	# y salian en la medida de fps como si fueran del juego
	var fotos: bool = DisplayServer.get_name() != "headless" and "--fotos" in OS.get_cmdline_user_args()
	var sb = salto_br
	for i in 30:
		await get_tree().physics_frame
	linea.call(player.br_control == sb and sb.estado == sb.ESPERA, "espera en el suelo antes de despegar")
	var t_esp := Time.get_ticks_msec()
	while sb.estado == sb.ESPERA and Time.get_ticks_msec() - t_esp < 60000:
		await get_tree().physics_frame
	for i in 10:
		await get_tree().physics_frame
	linea.call(player.br_control == sb and sb.estado == sb.AVION, "el jugador empieza en el avion")
	var pa: Vector3 = sb.pos_avion()
	linea.call(player.global_position.distance_to(pa) < 8.0 and pa.y > 150.0, "va dentro del avion a %.0f m (%s)" % [pa.y, str(player.global_position)])
	if fotos:
		await get_tree().create_timer(1.0).timeout
		_foto_prueba("salto_avion")
	var fps_avion: Array = []
	var seg := -1
	while sb.t < sb._t_dentro.x + 3.0:
		await get_tree().physics_frame
		if int(sb.t) != seg:
			seg = int(sb.t)
			fps_avion.append(Engine.get_frames_per_second())
	print("[pruebasalto] fps en el avion, segundo a segundo: %s" % str(fps_avion))
	var vida0: float = player.health
	sb.saltar()
	linea.call(sb.estado == sb.LIBRE, "salta del avion")
	var vmax := 0.0
	var t0 := Time.get_ticks_msec()
	var foto_libre := false
	var foto_pc := false
	var fps_caida: Array = []
	var seg2 := -1
	while sb.estado != sb.FIN and Time.get_ticks_msec() - t0 < 90000:
		await get_tree().physics_frame
		vmax = maxf(vmax, -player.velocity.y)
		if int((Time.get_ticks_msec() - t0) / 1000) != seg2:
			seg2 = int((Time.get_ticks_msec() - t0) / 1000)
			fps_caida.append(Engine.get_frames_per_second())
			var st2: Dictionary = world.get_stats()
			print("[pruebasalto] t=%d %s alt %.0f · %d fps · tris %d · host max %.1f ms · upload %.1f · regiones %.1f · sombras %.1f · bloques %.1f" % [
				seg2, ["avion", "libre", "paracaidas", "fin"][sb.estado], player.global_position.y, Engine.get_frames_per_second(),
				int(st2.get("tris_visible", 0)), float(st2.get("t_host_max_ms", 0)), float(st2.get("t_hmax_upload", 0)),
				float(st2.get("t_hmax_regions", 0)), float(st2.get("t_hmax_reg_shadow", 0)), float(st2.get("t_hmax_blocks", 0))])
		if fotos and not foto_libre and sb.estado == sb.LIBRE and Time.get_ticks_msec() - t0 > 2500:
			foto_libre = true
			_foto_prueba("salto_caida")
		if fotos and not foto_pc and sb.estado == sb.PARACAIDAS:
			foto_pc = true
			await get_tree().create_timer(1.5).timeout
			_foto_prueba("salto_paracaidas")
	var tt := (Time.get_ticks_msec() - t0) / 1000.0
	print("[pruebasalto] fps cayendo, segundo a segundo: %s" % str(fps_caida))
	linea.call(vmax > 25.0, "en caida libre baja deprisa (max %.1f m/s)" % vmax)
	linea.call(sb.abierto_a > 20.0 and sb.abierto_a < 45.0, "el paracaidas se abre solo a %.0f m del suelo" % sb.abierto_a)
	linea.call(sb.estado == sb.FIN and player.br_control == null, "aterriza y vuelve a mandar el jugador (%.1f s de caida)" % tt)
	linea.call(player.health >= vida0, "aterriza sin perder vida (%.0f)" % player.health)
	var agua_o_suelo: bool = player.is_on_floor() or (is_instance_valid(agua) and agua.profundidad(player.global_position) > 0.5)
	linea.call(agua_o_suelo, "esta en el suelo o en el agua en %s" % str(player.global_position))
	# los bots: todos a tierra antes de que el avion acabe la ruta y un rato mas
	var t1 := Time.get_ticks_msec()
	while sb._bots_en_el_aire() > 0 and Time.get_ticks_msec() - t1 < 60000:
		await get_tree().physics_frame
	var en_tierra := 0
	for b in sb._bots:
		# aterrizado cuenta aunque luego lo hayan matado y ya no exista (pelean nada mas tocar suelo)
		if int(b["fase"]) == sb.FIN and (not is_instance_valid(b["n"]) or b["n"].process_mode == Node.PROCESS_MODE_INHERIT):
			en_tierra += 1
		else:
			print("[pruebasalto] bot sin aterrizar: fase %d valido %s salta a %.1f s %s" % [int(b["fase"]), str(is_instance_valid(b["n"])),
				float(b["t"]), str(b["n"].global_position) if is_instance_valid(b["n"]) else "-"])
	linea.call(sb._bots.is_empty() or en_tierra == sb._bots.size(), "los bots saltan y aterrizan (%d de %d)" % [en_tierra, sb._bots.size()])
	# TODOS CONTRA TODOS: ningun bot es aliado de otro ni tuyo, y en 30 s de partida se matan entre ellos
	var equipos := {}
	var aliados := 0
	var con_bando := 0          # en `enemies` tambien cuelgan cadaveres: solo cuentan los que tienen bando
	for e in enemies.get_children():
		if "team" in e:
			con_bando += 1
			equipos[String(e.team)] = true
			if e.has_method("is_ally_of") and e.is_ally_of(String(player.team)):
				aliados += 1
	var cuenta_eq := {}
	for e in enemies.get_children():
		if "team" in e:
			cuenta_eq[String(e.team)] = cuenta_eq.get(String(e.team), []) + [
				"%s vida %.0f %s" % [e.name, float(e.health) if "health" in e else -1.0, "borrandose" if e.is_queued_for_deletion() else ""]]
	for q in cuenta_eq.keys():
		if cuenta_eq[q].size() > 1:
			print("[pruebasalto] bando repetido %s: %s" % [q, str(cuenta_eq[q])])
	linea.call(equipos.size() == con_bando and aliados == 0,
		"cada bot en su bando (%d bandos para %d bots) y ninguno aliado tuyo (%d)" % [equipos.size(), con_bando, aliados])
	if is_instance_valid(zona_br):
		player.invulnerable = true
		var v0: int = zona_br.vivos().size()
		var fps_t: Array = []
		Prof.acc.clear()
		Prof.peor.clear()
		Prof.frames = 0
		AstarTurno.por_quien.clear()
		var t_prof := Time.get_ticks_msec()
		for s2 in 30:
			await get_tree().create_timer(1.0).timeout
			fps_t.append(Engine.get_frames_per_second())
		var v1: int = zona_br.vivos().size()
		print("[pruebasalto] con los bots en tierra, fps segundo a segundo: %s" % str(fps_t))
		# EN QUE SE VA EL TIEMPO con los bots peleando: lo que mide Prof, en ms por cuadro, de mas a menos
		var claves: Array = Prof.acc.keys()
		claves.sort_custom(func(a, b): return int(Prof.acc[a]) > int(Prof.acc[b]))
		var nf: int = maxi(1, Prof.frames)
		var partes: Array = []
		for k in claves.slice(0, 16):
			partes.append("%s %.2f/%.0f" % [k, int(Prof.acc[k]) / 1000.0 / nf, int(Prof.peor.get(k, 0)) / 1000.0])
		print("[pruebasalto] perfil (ms/cuadro media/peor, %d cuadros en %.0f s): %s" % [nf, (Time.get_ticks_msec() - t_prof) / 1000.0, " · ".join(partes)])
		for q in AstarTurno.por_quien.keys():
			var a: Array = AstarTurno.por_quien[q]
			print("[pruebasalto] A* %s: %d busquedas, %.1f ms en total, peor %.1f ms" % [q, int(a[0]), int(a[1]) / 1000.0, int(a[2]) / 1000.0])
		var st: Dictionary = world.get_stats()
		print("[pruebasalto] extension: host %.1f ms (max %.1f) · fisica %.1f · escombros %.1f · piezas %d · cuerpos %d · tris %d" % [
			float(st.get("t_host_ms", 0)), float(st.get("t_host_max_ms", 0)), float(st.get("t_h_phys", 0)), float(st.get("t_h_debris", 0)),
			int(st.get("pieces", st.get("piezas", 0))), int(st.get("bodies", 0)), int(st.get("tris_visible", 0))])
		var vp := get_viewport().get_viewport_rid()
		RenderingServer.viewport_set_measure_render_time(vp, true)
		await get_tree().create_timer(0.5).timeout
		print("[pruebasalto] render: cpu %.1f gpu %.1f ms · proceso %.1f fisica %.1f ms" % [RenderingServer.viewport_get_measured_render_time_cpu(vp),
			RenderingServer.viewport_get_measured_render_time_gpu(vp), Performance.get_monitor(Performance.TIME_PROCESS) * 1000.0,
			Performance.get_monitor(Performance.TIME_PHYSICS_PROCESS) * 1000.0])
		linea.call(v1 < v0, "los bots se pelean entre ellos: de %d vivos a %d en 30 s" % [v0, v1])
	print("[pruebasalto] FIN: %s" % ("TODO OK" if fallos[0] == 0 else "%d fallos" % fallos[0]))
	get_tree().quit()


## --pruebazona: LA ZONA QUE SE CIERRA. Salta enseguida, aterriza y comprueba los circulos (cada uno dentro del
## anterior y sobre tierra), el muro en cada momento del ciclo, el daño fuera (sin que lo pare el chaleco), que
## dentro no hay daño, que los bots se van hacia la zona y que se reaparece dentro. Con --fotos: el muro y el mapa.
func _prueba_zona() -> void:
	var fallos := [0]
	var linea := func(ok: bool, que: String) -> void:
		if not ok:
			fallos[0] += 1
		print("[pruebazona] %s  %s" % ["OK   " if ok else "FALLO", que])
	var fotos: bool = DisplayServer.get_name() != "headless" and "--fotos" in OS.get_cmdline_user_args()
	var sb = salto_br
	var zb = zona_br
	while sb.estado == sb.ESPERA:
		await get_tree().physics_frame
	while sb.t < sb._t_dentro.x + 1.0:
		await get_tree().physics_frame
	sb.saltar()
	# a tierra en el centro de la primera zona
	var c1: Vector3 = zb.circulos[1]
	var suelo: Vector3 = world.find_ground(Vector3(c1.x, 0.0, c1.z))
	player.global_position = suelo + Vector3(0, 0.3, 0)
	player.velocity = Vector3.ZERO
	sb._aterrizar(player)
	for i in 20:
		await get_tree().physics_frame
	# 1) los circulos
	var encajan := true
	var tierra := true
	for k in range(1, zb.circulos.size()):
		var a: Vector3 = zb.circulos[k - 1]
		var b: Vector3 = zb.circulos[k]
		if Vector2(a.x - b.x, a.z - b.z).length() + b.y > a.y + 0.5:
			encajan = false
		var g: Vector3 = world.find_ground(Vector3(b.x, 0.0, b.z))
		if g.y < 3.4:
			tierra = false
	linea.call(encajan, "cada zona cae entera dentro de la anterior (%d zonas)" % (zb.circulos.size() - 1))
	linea.call(tierra, "todos los centros estan en tierra, no en el mar")
	# 2) el muro a lo largo del ciclo
	zb.t = 10.0
	linea.call(zb.fase() == 0 and zb.siguiente() == null and absf(zb.muro().y - zb.RADIO_INICIAL) < 0.1, "antes de la primera: sin zona anunciada")
	zb.t = zb.PRIMERA + 5.0
	linea.call(zb.fase() == 1 and zb.siguiente() != null and absf(zb.muro().y - zb.RADIO_INICIAL) < 0.1, "anunciada la zona 1, el muro aun no se mueve")
	zb.t = zb.PRIMERA + zb.CICLO - zb.CIERRE * 0.5
	var medio: float = zb.muro().y
	linea.call(medio < zb.RADIO_INICIAL - 1.0 and medio > zb.circulos[1].y + 1.0, "a media cerrada el muro esta entre las dos (r %.0f)" % medio)
	zb.t = zb.PRIMERA + zb.CICLO + 3.0
	linea.call(zb.fase() == 2 and absf(zb.muro().y - zb.circulos[1].y) < 0.1, "a los 2 min ya es la zona 1 y se anuncia la 2")
	# 3) daño fuera, sin que lo pare el chaleco; dentro nada
	player.invulnerable = false
	player.poner_armadura(100.0)
	# con la zona 2 (150 m) hay tierra fuera del muro dentro del mapa: se busca en 16 direcciones
	zb.t = zb.PRIMERA + 2.0 * zb.CICLO + 3.0
	var mz: Vector3 = zb.muro()
	var fuera_p := Vector3(-1, -1, -1)
	for i in 16:
		var a := i * TAU / 16.0
		var q := Vector3(mz.x + cos(a) * (mz.y + 12.0), 0.0, mz.z + sin(a) * (mz.y + 12.0))
		if q.x < 15.0 or q.z < 15.0 or q.x > world.get_world_size().x - 15.0 or q.z > world.get_world_size().z - 15.0:
			continue
		var g: Vector3 = world.find_ground(q)
		if g.y > 3.6:
			fuera_p = g
			break
	player.health = player.vida_max()
	player.global_position = fuera_p + Vector3(0, 0.3, 0)
	var v0: float = player.health
	var t0 := Time.get_ticks_msec()
	while Time.get_ticks_msec() - t0 < 3300:
		player.global_position = Vector3(fuera_p.x, player.global_position.y, fuera_p.z)
		await get_tree().physics_frame
	var perdida: float = v0 - player.health
	var esperado: float = zb.DANO[zb.fase()] * 3.0
	linea.call(perdida >= esperado * 0.66 and perdida <= esperado * 1.5 and player.armor >= 99.0,
		"fuera se pierde vida (%.0f en 3 s, fase %d = %d/s) y el chaleco no la para (%.0f)" % [perdida, zb.fase(), int(zb.DANO[zb.fase()]), player.armor])
	if fotos:
		player.look.x = atan2(-(mz.x - fuera_p.x), -(mz.z - fuera_p.z))
		player.rotation.y = player.look.x
		await get_tree().create_timer(0.5).timeout
		await _foto_prueba("zona_muro_fuera")
	player.global_position = world.find_ground(Vector3(mz.x, 0.0, mz.z)) + Vector3(0, 0.3, 0)
	var v1: float = player.health
	for i in 150:
		await get_tree().physics_frame
	linea.call(player.health >= v1, "dentro no se pierde vida")
	# 4) los bots
	var avisados := 0
	var fuera_bots := 0
	for e in enemies.get_children():
		if e is Node3D and e.process_mode != Node.PROCESS_MODE_DISABLED:
			var sg: Vector3 = zb.siguiente()
			if Vector2(e.global_position.x - sg.x, e.global_position.z - sg.z).length() > sg.y * 0.8:
				fuera_bots += 1
				if e.has_meta("zona_fase"):
					avisados += 1
	linea.call(fuera_bots == 0 or avisados == fuera_bots, "los bots fuera de la zona que viene van hacia ella (%d de %d)" % [avisados, fuera_bots])
	# 5) reaparecer dentro
	var rp: Vector3 = punto_aparicion_suelto()
	linea.call(zb.dentro(rp, 1.0), "se reaparece dentro de la zona (%s)" % str(rp))
	if fotos:
		zb.alternar_mapa()
		await get_tree().create_timer(0.4).timeout
		await _foto_prueba("zona_mapa")
		zb.alternar_mapa()
		player.global_position = world.find_ground(Vector3(mz.x, 0.0, mz.z)) + Vector3(0, 0.3, 0)
		player.look.x = atan2(-(fuera_p.x - mz.x), -(fuera_p.z - mz.z))
		player.rotation.y = player.look.x
		await get_tree().create_timer(0.6).timeout
		await _foto_prueba("zona_muro_dentro")
	print("[pruebazona] FIN: %s" % ("TODO OK" if fallos[0] == 0 else "%d fallos" % fallos[0]))
	get_tree().quit()


## --pruebafin: ULTIMO EN PIE. Salta y aterriza; con --morir te matan (no reapareces, quedas eliminado con tu
## puesto y miras a otro); sin el, caen todos los bots (no vuelven) y ganas. Mira tambien los botones del movil.
func _prueba_fin() -> void:
	var fallos := [0]
	var linea := func(ok: bool, que: String) -> void:
		if not ok:
			fallos[0] += 1
		print("[pruebafin] %s  %s" % ["OK   " if ok else "FALLO", que])
	var sb = salto_br
	var zb = zona_br
	while sb.estado == sb.ESPERA:
		await get_tree().physics_frame
	while sb.t < sb._t_dentro.x + 1.0:
		await get_tree().physics_frame
	sb.saltar()
	var c1: Vector3 = zb.circulos[1]
	player.global_position = world.find_ground(Vector3(c1.x, 0.0, c1.z)) + Vector3(0, 0.3, 0)
	player.velocity = Vector3.ZERO
	sb._aterrizar(player)
	for i in 90:
		await get_tree().physics_frame
	var n0: int = zb.vivos().size()
	linea.call(n0 >= 2 and zb.max_vivos >= 2, "cuenta los vivos: %d (tu y los bots, esten donde esten)" % n0)
	var mc = hud.get("mobile") if hud else null
	if mc != null and is_instance_valid(mc) and mc.get("buttons") != null:
		var b: Dictionary = mc.buttons
		var ok_b: bool = (not b.has("heal") or b["heal"].visible) and (not b.has("mapa") or b["mapa"].visible)
		linea.call(ok_b, "en la isla se ven CURAR y MAPA")
	if "--morir" in OS.get_cmdline_user_args():
		player.invulnerable = false
		player.take_damage(99999.0)
		for i in 60:
			await get_tree().physics_frame
		linea.call(player.spectating and zb.mi_puesto == n0, "muerto: eliminado, sin reaparecer, puesto #%d de %d" % [zb.mi_puesto, n0])
		for i in 480:
			await get_tree().physics_frame
		linea.call(player.spectating, "8 s despues sigue eliminado (no reaparece)")
		linea.call(is_instance_valid(player.spectate_target), "mira a otro que sigue vivo")
	else:
		var bots: Array = enemies.get_children()
		for e in bots:
			if e is Node3D and e.has_method("take_damage"):
				e.process_mode = Node.PROCESS_MODE_INHERIT
				e.take_damage(99999.0)
		for i in 150:
			await get_tree().physics_frame
		linea.call(zb.terminada and zb.mi_puesto == 1, "caen todos los bots: VICTORIA (puesto %d)" % zb.mi_puesto)
		if DisplayServer.get_name() != "headless" and "--fotos" in OS.get_cmdline_user_args():
			await _foto_prueba("fin_victoria")
		for i in 480:
			await get_tree().physics_frame
		var vuelven := 0
		for e in enemies.get_children():
			if e is Node3D and ("health" not in e or float(e.health) > 0.0) and not e.is_queued_for_deletion():
				vuelven += 1
		linea.call(vuelven == 0, "los bots no reaparecen (%d vivos 8 s despues)" % vuelven)
	print("[pruebafin] FIN: %s" % ("TODO OK" if fallos[0] == 0 else "%d fallos" % fallos[0]))
	get_tree().quit()


## --botonesmovil (con --touch): que botones del movil se ven en este mapa. CURAR y MAPA, solo en el battle royale.
## --pruebademoler: ¿SE RECUPERAN LOS FPS DESPUES DE DEMOLER? Se planta al jugador en un sitio de la ciudad
## mirando a un edificio, se miden 10 s quieto (la linea base), se tiran N bombas grandes, y despues se mide
## un minuto entero por segundos, con lo que dice el motor: asi se ve si la bajada es lo que se esta cayendo
## (se recupera) o algo que queda para siempre (no se recupera).
##   --map=isla --pruebademoler [--sitio=x,y,z,giro] [--bombas=N] [--radio=R]
func _prueba_demoler() -> void:
	for i in 120:
		await get_tree().physics_frame
	for e in enemies.get_children():
		e.queue_free()
	await get_tree().process_frame
	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
	Engine.max_fps = 0
	player.invulnerable = true
	if is_instance_valid(salto_br):
		salto_br.queue_free()
	var sitio := Vector3(CX_PRUEBA, 0.0, CZ_PRUEBA)
	var giro := 0.0
	var bombas := 6
	var radio := 4.5
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--sitio="):
			var v := a.substr(8).split(",")
			if v.size() >= 3:
				sitio = Vector3(float(v[0]), float(v[1]), float(v[2]))
			if v.size() >= 4:
				giro = float(v[3])
		elif a.begins_with("--bombas="):
			bombas = int(a.substr(9))
		elif a.begins_with("--radio="):
			radio = float(a.substr(8))
	player.global_position = sitio
	player.velocity = Vector3.ZERO
	player.look = Vector2(deg_to_rad(giro), -0.1)
	player.rotation.y = player.look.x
	world.set_player_position(sitio)
	for i in 180:
		await get_tree().physics_frame
	var medir := func(que: String, segundos: int) -> void:
		var fps: Array = []
		var trozos: Array = []
		for s2 in segundos:
			await get_tree().create_timer(1.0).timeout
			fps.append(Engine.get_frames_per_second())
			var st: Dictionary = world.get_stats()
			trozos.append("%d/%d/%d/%d" % [int(st.get("debris_active", 0)), int(st.get("bodies_solid", 0)),
				int(st.get("static_bodies", 0)), int(st.get("tris_visible", 0)) / 1000])
		print("[demoler] %s fps: %s" % [que, str(fps)])
		print("[demoler] %s escombro/bloques/colisiones/ktris: %s" % [que, " ".join(trozos)])
	await medir.call("QUIETO   ", 10)
	var fwd: Vector3 = -player.global_transform.basis.z
	var objetivo: Vector3 = player.global_position + fwd * 22.0 + Vector3(0, 6.0, 0)
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--objetivo="):
			var v2 := a.substr(11).split(",")
			if v2.size() >= 3:
				objetivo = Vector3(float(v2[0]), float(v2[1]), float(v2[2]))
	for i in bombas:
		var p: Vector3 = objetivo + Vector3(randf_range(-5, 5), randf_range(-3, 7), randf_range(-5, 5))
		world.explode(p, radio, 255)
		effects.explosion(p, radio)
		await get_tree().create_timer(0.5).timeout
	print("[demoler] %d bombas de %.1f m tiradas" % [bombas, radio])
	await medir.call("DESPUES  ", 60)
	var st2: Dictionary = world.get_stats()
	var tg := Time.get_ticks_usec()
	for i in 20:
		world.get_stats()
	print("[demoler] al final: get_stats cuesta %.2f ms con %d bloques" % [(Time.get_ticks_usec() - tg) / 20000.0, int(st2.get("bodies_solid", 0))])
	print("[demoler] al final: %s" % str(st2))
	var claves: Array = Prof.acc.keys()
	claves.sort_custom(func(a, b): return int(Prof.acc[a]) > int(Prof.acc[b]))
	var partes: Array = []
	for k in claves.slice(0, 12):
		partes.append("%s %.2f/%.0f" % [k, int(Prof.acc[k]) / 1000.0 / maxi(1, Prof.frames), int(Prof.peor.get(k, 0)) / 1000.0])
	print("[demoler] perfil: %s" % " ".join(partes))
	get_tree().quit()


## --pruebavehiculo: ¿SE CONDUCE? Se lleva al jugador al vehiculo del tipo que se pida, se sube, acelera
## 8 s recto, frena, gira y se baja; se dice cuanto se ha movido y a que velocidad. Con el helicoptero,
## sube con el colectivo y se mira que gane altura.
##   --map=isla --pruebavehiculo [--tipo=coche|moto|todoterreno|helicoptero]
## --cochelan (en las dos copias, en la isla): EL ACOMPAÑANTE VE MOVERSE EL COCHE. El anfitrion se sube al
## volante del coche mas cercano al centro y acelera; el invitado se sube despues y tiene que ir de
## acompañante y ver el coche moverse igual que el conductor.
func _coche_lan_test() -> void:
	await get_tree().create_timer(15.0).timeout
	player.invulnerable = true
	if is_instance_valid(salto_br):
		salto_br.queue_free()
		player.br_control = null
	var mejor := -1
	var md := 1e9
	for i in vehiculos.puntos.size():
		if String(vehiculos.puntos[i]["tipo"]) != "coche":
			continue
		var d: float = vehiculos.puntos[i]["pos"].distance_to(Vector3(250, 0, 250))
		if d < md:
			md = d
			mejor = i
	var p: Vector3 = vehiculos.puntos[mejor]["pos"]
	player.global_position = Vector3(p.x + (2.5 if Net.hosting else -2.5), 40.0, p.z)
	world.set_player_position(player.global_position)
	await get_tree().create_timer(8.0).timeout
	if not Net.hosting:
		await get_tree().create_timer(4.0).timeout      # el conductor ya va dentro
		var cv = vehiculos.nodos.get(mejor)
		print("[cochelan] INVITADO: yo en %s · el coche %s en %s · remoto %s · ocupados %s" % [str(player.global_position.snapped(Vector3.ONE * 0.1)),
			str(mejor), str(cv.global_position.snapped(Vector3.ONE * 0.1)) if cv else "(sin nodo)", str(cv.remoto) if cv else "-", str(cv.ocupados) if cv else "-"])
		if cv:
			player.global_position = cv.global_position + cv.global_transform.basis.x * 2.0 + Vector3(0, 0.3, 0)
			await get_tree().create_timer(0.5).timeout
	vehiculos.usar_desde_jugador(player)
	var v = vehiculos.conduciendo
	print("[cochelan] %s: dentro %s · asiento %d · motivo '%s'" % ["ANFITRION" if Net.hosting else "INVITADO",
		str(v != null), int(v.mi_asiento) if v != null else -1, vehiculos.motivo])
	if Net.hosting:
		await get_tree().create_timer(8.0).timeout      # parado, esperando al acompañante
	else:
		await get_tree().create_timer(4.0).timeout
	for k in 12:
		if Net.hosting:
			player.set("touch_vehiculo", Vector3(0, -1, 0))   # acelerar
		await get_tree().create_timer(1.0).timeout
		if v != null and is_instance_valid(v):
			print("[cochelan] %s t %d coche en %s" % ["ANFITRION" if Net.hosting else "INVITADO", k, str(v.global_position.snapped(Vector3.ONE * 0.1))])
	get_tree().quit()


## 60 FPS ESTABLES: CONTROL AUTOMATICO DE CALIDAD (pedido 2026-09-21: "60 fps minimos y estables sin dañar nada").
##
## Medido en la cuarentena con la iGPU de referencia: la escena base ya cuesta 14-18 ms de GPU en caliente (la
## grafica integrada baja de velocidad al calentarse) y los efectos suman 3-7 ms mas; con 16,7 ms de presupuesto
## no hay un interruptor que de 60 fijos. Asi que cada 2 s se mira el tiempo de GPU y el cuadro, y si no caben
## en 60 fps se baja UN escalon de lo caro; con margen de sobra durante 8 s se devuelve uno. Nunca pasa de lo
## que el jugador puso en GRAFICOS (es el techo) ni guarda nada: solo cambia lo que se aplica al vuelo sin
## recargar el mapa ni rehacer sombras (sin tirones al cambiar). Los dos ultimos escalones
## bajan la resolución 3D temporalmente: es la palanca de GPU que más recupera FPS en móvil.
##   escalon 1 desenfoque de movimiento fuera · 2 oclusion volumetrica <= media · 3 <= baja · 4 MSAA -> FXAA
##   · 5 sin resplandor · 6 sin oclusion volumetrica · 7/8 menos resolución 3D
const AUTO_MAX := 8
const AUTO_BAJA_MS := 16.0          ## cuadro medio por encima: no caben 60
const AUTO_SUBE_GPU_MS := 10.5      ## GPU por debajo de esto 8 s seguidos: sobra para subir un escalon
var _auto_nivel := 0
var _auto_t := 0.0
var _auto_frames := 0
var _auto_tiempo := 0.0
var _auto_gpu := 0.0
var _auto_gpu_n := 0
var _auto_holgura := 0.0
var _auto_mide := false

func _auto_fps(delta: float) -> void:
	# Se rige por Settings.adaptive_quality (encendido de fábrica). Antes exigía además
	# `--autofps`, una marca de desarrollo que no existe en una APK normal, por lo que el
	# regulador jamás se activaba para jugadores.
	if loading or "--lagbench" in OS.get_cmdline_user_args():
		return
	var vp_rid := get_viewport().get_viewport_rid()
	if not _auto_mide:
		_auto_mide = true
		RenderingServer.viewport_set_measure_render_time(vp_rid, true)
	_auto_t += delta
	_auto_frames += 1
	_auto_tiempo += delta
	# UNA MUESTRA DE GPU CADA 8 CUADROS (2026-10-20): con el hilo de render separado, pedir el tiempo de GPU obliga a
	# esperar a ese hilo (Godot avisa: "RenderingServer synchronizations on every frame"); cada cuadro anulaba el
	# trabajo en paralelo. La media de 2 s sale igual con 1 de cada 8.
	if _auto_frames % 8 == 1:
		_auto_gpu += RenderingServer.viewport_get_measured_render_time_gpu(vp_rid)
		_auto_gpu_n += 1
	if _auto_t < 2.0:
		return
	var cuadro_ms := _auto_tiempo * 1000.0 / maxf(1.0, _auto_frames)
	var gpu_ms := _auto_gpu / maxf(1.0, _auto_gpu_n)
	_auto_t = 0.0
	_auto_frames = 0
	_auto_tiempo = 0.0
	_auto_gpu = 0.0
	_auto_gpu_n = 0
	var antes := _auto_nivel
	# CONTRA EL TOPE DE FPS (2026-10-14, bug): con el tope a 60 (el movil) o la sincronizacion vertical cada cuadro dura
	# 16,7 ms, mas que AUTO_BAJA_MS (16): el regulador creia que no llegaba y bajaba un escalon cada 2 s hasta el ultimo
	# (resolucion minima). El umbral es ahora el cuadro del tope + un 10 %.
	var tope_fps: float = Engine.max_fps if Engine.max_fps > 0 else float(DisplayServer.screen_get_refresh_rate()) if DisplayServer.window_get_vsync_mode() != DisplayServer.VSYNC_DISABLED else 0.0
	var baja_ms: float = maxf(AUTO_BAJA_MS, 1000.0 / tope_fps * 1.10) if tope_fps > 1.0 else AUTO_BAJA_MS
	if cuadro_ms > baja_ms and _auto_nivel < AUTO_MAX:
		_auto_nivel += 1
		_auto_holgura = 0.0
	elif gpu_ms < AUTO_SUBE_GPU_MS and cuadro_ms < baja_ms and _auto_nivel > 0:
		_auto_holgura += 2.0
		if _auto_holgura >= 8.0:
			_auto_nivel -= 1
			_auto_holgura = 0.0
	else:
		_auto_holgura = 0.0
	if _auto_nivel != antes:
		print("[autofps] cuadro %.1f ms · GPU %.1f ms -> escalon %d" % [cuadro_ms, gpu_ms, _auto_nivel])
		_auto_aplicar()
		if hud:
			hud.flash_message("Rendimiento: resolución dinámica %s" % ("reducida" if _auto_nivel >= 7 else "ajustada"))


## Lo del escalon actual, con el ajuste del jugador como techo.
func _auto_aplicar() -> void:
	var g := func(k: String) -> int: return Settings.gfx_value(k, quality)
	var n := _auto_nivel
	Settings.motion_blur = 0.0 if n >= 1 else [0.0, 0.22, 0.45, 0.8][g.call("motion_blur")]
	var ao: int = g.call("voxel_ao")
	if n >= 6:
		ao = 0
	elif n >= 3:
		ao = mini(ao, 1)
	elif n >= 2:
		ao = mini(ao, 2)
	_ao_nivel(ao)
	var aa: int = g.call("antialias")
	if n >= 4 and aa >= 2:
		aa = 1
	var vp := get_viewport()
	vp.screen_space_aa = Viewport.SCREEN_SPACE_AA_FXAA if aa == 1 else Viewport.SCREEN_SPACE_AA_DISABLED
	vp.msaa_3d = [Viewport.MSAA_DISABLED, Viewport.MSAA_DISABLED, Viewport.MSAA_2X, Viewport.MSAA_4X][aa]
	# en el MOVIL sin resplandor (2026-10-13: son varias pasadas a pantalla completa cada fotograma); --glowmovil = con el
	(env.environment as Environment).glow_enabled = g.call("glow") == 1 and n < 5 and (not Settings.is_mobile() or "--glowmovil" in OS.get_cmdline_user_args())
	# Resolución dinámica sólo DESPUÉS de recortar los adornos. Nunca sube de lo que el
	# jugador eligió y vuelve a ese valor al recuperarse el rendimiento.
	var escala_base: int = g.call("render_scale")
	var escala_auto: int = max(0, escala_base - max(0, n - 6))
	vp.scaling_3d_scale = [0.25, 0.33, 0.4, 0.5, 0.65, 0.75, 0.85, 1.0][escala_auto]


## --tirones: EL VIGILANTE DE BAJONES DE FPS, en vivo. Cada segundo: fps medios y el peor fotograma. Y en cada
## tiron (un fotograma de mas de TIRON_MS) que se lo comio: proceso y fisica de Godot, llamadas de dibujo,
## cuerpos, y las fases de GDScript de `Prof` que mas crecieron en ESE fotograma.
const TIRON_MS := 40.0
var _tir_acc := {}
var _tir_seg := 0.0
var _tir_n := 0
var _tir_peor := 0.0
var _tir_mide := false

var _tir_ao_forzado := false
var _tir_modo_puesto := false

func _diag_tirones(delta: float) -> void:
	if not "--tirones" in OS.get_cmdline_user_args():
		return
	# --modofps=vsync|tope|mailbox: como se limitan los 60 fps (A/B del ciclo de velocidad de la iGPU)
	if not _tir_modo_puesto and not loading:
		_tir_modo_puesto = true
		for q in OS.get_cmdline_user_args():
			match q:
				"--modofps=tope":
					DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
					Engine.max_fps = 60
				"--modofps=mailbox":
					DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_MAILBOX)
					Engine.max_fps = 60
	# --aoforzado=N: la oclusion volumetrica a ese nivel en esta partida (A/B sin tocar los ajustes guardados)
	if not _tir_ao_forzado and not loading:
		for q in OS.get_cmdline_user_args():
			if q.begins_with("--aoforzado="):
				_tir_ao_forzado = true
				var nv := int(q.substr(12))
				_ao_nivel(nv)
	var ms := delta * 1000.0
	_tir_seg += delta
	_tir_n += 1
	_tir_peor = maxf(_tir_peor, ms)
	if ms > TIRON_MS and _tir_n > 1:
		var sube: Array = []
		for k in Prof.acc.keys():
			var d: float = float(Prof.acc[k] - int(_tir_acc.get(k, 0))) / 1000.0
			if d > 1.0:
				sube.append([d, k])
		sube.sort_custom(func(x, y): return x[0] > y[0])
		var top := ""
		for e in sube.slice(0, 4):
			top += " %s %.1f" % [e[1], e[0]]
		var st: Dictionary = world.get_stats() if world else {}
		print("[tiron] %.0f ms · proceso %.1f fisica %.1f ms · dibujo %d llamadas · cuerpos %d · bloques %d · piezas %d%s" % [ms,
			Performance.get_monitor(Performance.TIME_PROCESS) * 1000.0, Performance.get_monitor(Performance.TIME_PHYSICS_PROCESS) * 1000.0,
			int(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME)), int(st.get("bodies_total", st.get("bodies", 0))),
			int(st.get("pieces_total", 0)), int(st.get("pz_sueltas", 0)), (" · gdscript:" + top) if top != "" else ""])
	if _tir_seg >= 1.0:
		# CUANTO SE LLEVA LA GRAFICA Y CUANTO EL PROCESADOR en dibujar el fotograma (medido por Godot): asi se
		# sabe si el bajon es de la GPU (la escena) o de la CPU (juego, motor, envio de dibujo)
		var vp_rid := get_viewport().get_viewport_rid()
		if not _tir_mide:
			_tir_mide = true
			RenderingServer.viewport_set_measure_render_time(vp_rid, true)
		var oi: Dictionary = world.get_occupancy_info() if world and world.has_method("get_occupancy_info") else {}
		print("[occ] pendientes %s · subidas este cuadro %s" % [str(oi.get("pending_layers", "-")), str(oi.get("uploads_frame", "-"))])
		print("[fps] %.0f · peor fotograma %.0f ms · dibujo: GPU %.1f ms, CPU %.1f ms · llamadas %d · triangulos %.0f mil · proceso %.1f fisica %.1f ms" % [
			_tir_n / _tir_seg, _tir_peor, RenderingServer.viewport_get_measured_render_time_gpu(vp_rid),
			RenderingServer.viewport_get_measured_render_time_cpu(vp_rid),
			int(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME)),
			Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME) / 1000.0,
			Performance.get_monitor(Performance.TIME_PROCESS) * 1000.0, Performance.get_monitor(Performance.TIME_PHYSICS_PROCESS) * 1000.0])
		_tir_seg = 0.0
		_tir_n = 0
		_tir_peor = 0.0
	_tir_acc = Prof.acc.duplicate()


## --fotocolor=<nombre>: a los 20 s, foto de lo que se ve (user://color_<nombre>.png). Para comparar la
## conversion de color (con --tonemap=filmic, la de antes). Con --fotosangre, antes se tiran unas salpicaduras
## de sangre contra la pared de delante, para ver la mancha.
func _foto_color(nombre: String) -> void:
	if "--fotolluvia" in OS.get_cmdline_user_args():
		await get_tree().create_timer(4.0).timeout
		set_rain(true)
		_mojado = 0.999            # empapado ya, sin esperar a que se moje (va subiendo solo hasta 1)
		await get_tree().create_timer(14.0).timeout
		# mirando al suelo a unos metros, que es donde se ven los reflejos
		player.look_at_point(player.global_position + (-player.global_transform.basis.z) * 6.0 + Vector3(0, -1.2, 0))
		# --fotomesa: al borde del tablero de la mesa del mapa de pruebas (el techo grande), mirando lo que
		# queda debajo: es donde se ve el limite entre mojado y seco
		# --fotopared: de frente a una pared que da a la calle, para ver los chorretones
		if "--fotopared" in OS.get_cmdline_user_args():
			player.global_position = Vector3(16.5, 1.0, 17.5)
			world.set_player_position(player.global_position)
			await get_tree().create_timer(1.0).timeout
			player.look_at_point(Vector3(14.0, 2.0, 14.0))
		if "--fotomesa" in OS.get_cmdline_user_args():
			player.global_position = Vector3(16.5, 1.0, 17.5)
			world.set_player_position(player.global_position)
			await get_tree().create_timer(1.0).timeout
			player.look_at_point(Vector3(12.0, 0.8, 12.5))
	else:
		await get_tree().create_timer(18.0).timeout
	if "--fotosangre" in OS.get_cmdline_user_args() and effects != null:
		var ar: Array = player._aim_ray(12.0)
		var r: Dictionary = world.raycast(ar[0], ar[1], 12.0)
		if r.get("hit", false):
			var hp: Vector3 = r["position"]
			for k in 6:
				var off := Vector3(randf_range(-0.8, 0.8), randf_range(-0.5, 0.5), randf_range(-0.8, 0.8))
				effects.blood(hp - (ar[1] as Vector3) * 1.2 + off * 0.3, ar[1])
			print("[fotocolor] sangre contra la pared a %.1f m" % (ar[0] as Vector3).distance_to(hp))
	# --fotoquema: una explosion a 7 m delante, y la foto a los 1,5 s (brasas encendidas) y otra al final
	if "--fotoquema" in OS.get_cmdline_user_args():
		var ar2: Array = player._aim_ray(30.0)
		var r2: Dictionary = world.raycast(ar2[0], ar2[1], 30.0)
		var sitio: Vector3 = r2["position"] if r2.get("hit", false) else (ar2[0] as Vector3) + (ar2[1] as Vector3) * 7.0
		Net.net_explode(world, sitio, 1.6, 255)
		if effects:
			effects.explosion(sitio, 1.6)
		await get_tree().create_timer(1.5).timeout
		get_viewport().get_texture().get_image().save_png("user://color_%s_brasa.png" % nombre)
		await get_tree().create_timer(8.0).timeout
	if "--fototormenta" in OS.get_cmdline_user_args() and tormenta != null:
		await get_tree().create_timer(1.0).timeout
		# de frente a donde va a caer: se fuerza la direccion mirando hacia delante
		var ar: Array = player._aim_ray(1.0)
		tormenta.cae_un_rayo(260.0, ar[1])
		await get_tree().create_timer(0.06).timeout
		get_viewport().get_texture().get_image().save_png("user://color_%s_rayo.png" % nombre)
	await get_tree().create_timer(2.0).timeout
	# fps de los ultimos 3 s (para comparar el coste de los efectos)
	var n_fr := 0
	var t_fr := 0.0
	while t_fr < 3.0:
		await get_tree().process_frame
		t_fr += get_process_delta_time()
		n_fr += 1
	print("[fotocolor] %s: %.1f fps" % [nombre, n_fr / t_fr])
	var ruta := "user://color_%s.png" % nombre
	get_viewport().get_texture().get_image().save_png(ruta)
	print("[fotocolor] %s" % ProjectSettings.globalize_path(ruta))
	get_tree().quit()


## --brgana: GANAR UN BATTLE ROYALE. A los 20 s caen todos los bots (en el avion o donde esten) y se mira que
## salga la pantalla de VICTORIA y que se cobre. En red, con --brmuere en el invitado, el invitado cae antes.
func _br_gana_test() -> void:
	await get_tree().create_timer(20.0).timeout
	var oro0: int = Settings.monedas
	var exp0: int = Settings.experiencia
	if "--brmuere" in OS.get_cmdline_user_args() and not Net.hosting:
		# en el avion no se recibe daño: se cae a mano, como cae el que muere en tierra
		print("[brgana] INVITADO: me dejo caer")
		player.invulnerable = false
		player.health = 0.0
		player.die()
		for i in 40:
			await get_tree().create_timer(1.0).timeout
			if is_instance_valid(zona_br) and zona_br.terminada:
				break
		print("[brgana] INVITADO: zona terminada %s · pantalla de victoria %s (no deberia: he muerto)" % [
			str(zona_br.terminada) if is_instance_valid(zona_br) else "?", str(hud.tiene_pantalla_victoria())])
		Settings.monedas = oro0
		Settings.experiencia = exp0
		Settings.save()
		get_tree().quit()
		return
	await get_tree().create_timer(5.0).timeout
	var n := 0
	for e in enemies.get_children():
		if ("health" in e) and float(e.health) > 0.0 and e.has_method("take_damage"):
			e.take_damage(99999.0, Vector3.ZERO)
			n += 1
	print("[brgana] %d bots abatidos · vivos segun la zona: %d" % [n, zona_br.vivos().size() if is_instance_valid(zona_br) else -1])
	for i in 20:
		await get_tree().create_timer(1.0).timeout
		if hud.tiene_pantalla_victoria():
			break
	print("[brgana] zona terminada %s · pantalla de victoria %s · oro %d -> %d · exp %d -> %d" % [
		str(zona_br.terminada) if is_instance_valid(zona_br) else "?", str(hud.tiene_pantalla_victoria()),
		oro0, Settings.monedas, exp0, Settings.experiencia])
	if not hud.tiene_pantalla_victoria() and is_instance_valid(zona_br):
		for v in zona_br.vivos():
			print("[brgana]   sigue vivo: %s (%s)" % [str(v[1]), str(v[0])])
	# la prueba no cobra: el premio iba al perfil de verdad de quien la lanza
	Settings.monedas = oro0
	Settings.experiencia = exp0
	Settings.save()
	get_tree().quit()


## --pruebacontexto (con --touch): EL BOTON COGER / SUBIR DEL MOVIL. Te pone junto a un coche y junto a
## un arma del suelo, saca una foto de cada uno (user://contexto_*.png), pulsa el boton y mira si ha servido.
func _prueba_contexto() -> void:
	for i in 150:
		await get_tree().physics_frame
	player.invulnerable = true
	if is_instance_valid(salto_br):
		salto_br.queue_free()
		player.br_control = null
	hud.set_combat_ui_visible(true)      # el avion los esconde y aqui se ha quitado a mano
	var mc = hud.mobile if hud and is_instance_valid(hud.mobile) else null
	if mc == null:
		print("[contexto] no hay mandos tactiles (falta --touch)")
		get_tree().quit()
		return
	# 1) UN ARMA
	var arma := -1
	var md := 1e9
	for i in botin.puntos.size():
		if botin.contenido(i).begins_with("arma:"):
			var d: float = botin.puntos[i]["pos"].distance_to(player.global_position)
			if d < md:
				md = d
				arma = i
	var q: Vector3 = botin.puntos[arma]["pos"]
	player.global_position = q + Vector3(1.0, 0.3, 0.0)
	world.set_player_position(player.global_position)
	player.look_at_point(q)
	for i in 90:
		await get_tree().physics_frame
	var antes := String(Weapons.LIST[player.current].get("id", ""))
	print("[contexto] yo %s · arma %s · a mano %s · a_mano_para %s" % [str(player.global_position), str(q),
		str(arma in botin._a_mano), str(botin.a_mano_para(player))])
	var txt: String = mc._ctx.text if mc._ctx and mc._ctx.visible else "(sin boton)"
	get_viewport().get_texture().get_image().save_png("user://contexto_arma.png")
	if mc._ctx and mc._ctx.visible:
		mc._ctx.pressed.emit()
	for i in 30:
		await get_tree().physics_frame
	print("[contexto] arma %s: boton '%s' · ranuras %s · punto ahora '%s' (antes llevaba %s)" % [
		botin.contenido(arma) if botin.contenido(arma) != "" else "vacio", txt.replace("\n", " / "),
		str(Weapons.LIST.map(func(w): return w.get("id", ""))), botin.contenido(arma), antes])
	# 2) UN COCHE
	var mejor := -1
	md = 1e9
	for i in vehiculos.puntos.size():
		var d: float = vehiculos.puntos[i]["pos"].distance_to(player.global_position)
		if d < md:
			md = d
			mejor = i
	var p: Vector3 = vehiculos.puntos[mejor]["pos"]
	player.global_position = Vector3(p.x + 2.5, 40.0, p.z)
	world.set_player_position(player.global_position)
	for i in 240:
		await get_tree().physics_frame
	player.look_at_point(vehiculos.nodos[mejor].global_position if vehiculos.nodos.has(mejor) else p)
	for i in 30:
		await get_tree().physics_frame
	txt = mc._ctx.text if mc._ctx and mc._ctx.visible else "(sin boton)"
	get_viewport().get_texture().get_image().save_png("user://contexto_coche.png")
	if mc._ctx and mc._ctx.visible:
		mc._ctx.pressed.emit()
	for i in 30:
		await get_tree().physics_frame
	var dentro = player.get("br_control")
	print("[contexto] %s a %.1f m: boton '%s' · dentro: %s · boton despues: %s" % [
		vehiculos.puntos[mejor]["tipo"], player.global_position.distance_to(p), txt.replace("\n", " / "),
		str(dentro != null), str(mc._ctx.visible)])
	get_tree().quit()


func _prueba_vehiculo() -> void:
	for i in 150:
		await get_tree().physics_frame
	if vehiculos == null or not is_instance_valid(vehiculos):
		print("[vehiculo] el mapa no trae vehiculos")
		get_tree().quit()
		return
	var tipo := "coche"
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--tipo="):
			tipo = a.substr(7)
	player.invulnerable = true
	if is_instance_valid(salto_br):
		salto_br.queue_free()
		player.br_control = null
	# al punto mas cercano de ese tipo (el gestor lo creara al llegar)
	var mejor := -1
	var mejor_d := 1e9
	for i in vehiculos.puntos.size():
		if String(vehiculos.puntos[i]["tipo"]) != tipo:
			continue
		var d: float = vehiculos.puntos[i]["pos"].distance_to(player.global_position)
		if d < mejor_d:
			mejor_d = d
			mejor = i
	if mejor < 0:
		print("[vehiculo] no hay ningun %s en el mapa" % tipo)
		get_tree().quit()
		return
	var p: Vector3 = vehiculos.puntos[mejor]["pos"]
	player.global_position = Vector3(p.x + 2.0, 40.0, p.z)
	world.set_player_position(player.global_position)
	for i in 240:
		await get_tree().physics_frame
	var v = vehiculos.nodos.get(mejor)
	if v == null or not is_instance_valid(v):
		print("[vehiculo] el %s no se ha creado (puntos %d, creados %d)" % [tipo, vehiculos.puntos.size(), vehiculos.creados])
		get_tree().quit()
		return
	print("[vehiculo] %s en %s (suelo a %.1f m del punto del mapa) · color %s en %d superficies" % [
		tipo, str(v.global_position.round()), v.global_position.y - p.y, str(v.color), v.pintadas])
	player.global_position = v.global_position + Vector3(1.5, 0.5, 0.0)
	await get_tree().physics_frame
	if not vehiculos.usar_desde_jugador(player):
		print("[vehiculo] NO SE HA PODIDO SUBIR")
		get_tree().quit()
		return
	print("[vehiculo] subido")
	var desde: Vector3 = v.global_position
	var antes: Vector3 = desde
	var recorrido := 0.0
	var vmax := 0.0
	var alto := 0.0
	for i in 480:                                  # 8 s empujando
		if tipo == "helicoptero":
			Input.action_press("jump")
		else:
			Input.action_press("move_forward")
		await get_tree().physics_frame
		vmax = maxf(vmax, v.linear_velocity.length())
		alto = maxf(alto, v.global_position.y - desde.y)
		recorrido += v.global_position.distance_to(antes)
		antes = v.global_position
	var fwd_ini: Vector3 = -v.global_transform.basis.z
	var avance_w: float = (v.global_position - desde).dot(fwd_ini)
	# ¿Y LA DIRECCION? Con A el morro tiene que irse a la izquierda (yaw creciente en Godot).
	var yaw0: float = v.global_rotation.y
	for i in 120:
		Input.action_press("move_forward")
		Input.action_press("move_left")
		await get_tree().physics_frame
	Input.action_release("move_left")
	var giro_a: float = wrapf(v.global_rotation.y - yaw0, -PI, PI)
	Input.action_release("move_forward")
	Input.action_release("jump")
	if tipo != "helicoptero":
		print("[vehiculo] con A el morro va a la %s (%.0f grados)" % [
			"IZQUIERDA" if giro_a > 0.05 else ("DERECHA (MAL)" if giro_a < -0.05 else "nada"), rad_to_deg(giro_a)])
	var hacia_delante: float = avance_w
	var anduvo: float = recorrido
	print("[vehiculo] con W va %s (%.1f m en su morro)" % ["ADELANTE" if hacia_delante > 1.0 else "ATRAS (MAL)", hacia_delante])
	var st_v: Dictionary = world.get_stats()
	print("[vehiculo] voxels rotos embistiendo: %d · atropellados %d · vida del vehiculo %.0f" % [
		int(st_v.get("voxels_destroyed", 0)), v._atropellados, v.vida])
	print("[vehiculo] %s: recorrido %.1f m · punta %.1f m/s (%.0f km/h) · subida %.1f m · vida %.0f" % [
		tipo, anduvo, vmax, vmax * 3.6, alto, v.vida])
	for i in 120:
		await get_tree().physics_frame
	v.salir()
	await get_tree().physics_frame
	var fuera: bool = player.br_control == null and player.global_position.distance_to(v.global_position) > 0.8
	print("[vehiculo] bajado: %s · jugador en %s" % ["SI" if fuera else "NO", str(player.global_position.round())])
	get_tree().quit()


## --pruebaasientos: ¿CABEN LOS COMPAÑEROS? Se coge un coche, se ocupan asientos "desde la red" (como si
## los cogieran otros jugadores) y se mira que el local acabe donde toca, que nadie repita asiento, que no
## se pueda quitar el volante y que al bajarse quede libre su sitio.
##   --map=isla --pruebaasientos
func _prueba_asientos() -> void:
	for i in 150:
		await get_tree().physics_frame
	if vehiculos == null or not is_instance_valid(vehiculos):
		print("[asientos] el mapa no trae vehiculos")
		get_tree().quit()
		return
	player.invulnerable = true
	if is_instance_valid(salto_br):
		salto_br.queue_free()
		player.br_control = null
	var mejor := -1
	for i in vehiculos.puntos.size():
		if String(vehiculos.puntos[i]["tipo"]) == "coche":
			mejor = i
			break
	var p: Vector3 = vehiculos.puntos[mejor]["pos"]
	player.global_position = Vector3(p.x + 2.0, 30.0, p.z)
	world.set_player_position(player.global_position)
	for i in 240:
		await get_tree().physics_frame
	var v = vehiculos.nodos.get(mejor)
	if v == null or not is_instance_valid(v):
		print("[asientos] no se ha creado el coche")
		get_tree().quit()
		return
	var fallos: Array = []
	print("[asientos] %s con %d asientos" % [v.tipo, v.asientos()])
	# dos "compañeros" cogen el volante y el de al lado
	vehiculos.asiento_remoto(v.id, 0, 777, true)
	vehiculos.asiento_remoto(v.id, 1, 778, true)
	player.global_position = v.global_position + Vector3(1.2, 0.5, 0.0)
	await get_tree().physics_frame
	if not vehiculos.usar_desde_jugador(player):
		fallos.append("con el volante y el copiloto cogidos no me he podido subir detras")
	elif v.mi_asiento != 2:
		fallos.append("me he sentado en el %d y tocaba el 2" % v.mi_asiento)
	if v.conductor != null:
		fallos.append("me he puesto a conducir un coche que lleva otro")
	if not v.remoto:
		fallos.append("el coche deberia ir mandado por el que tiene el volante")
	print("[asientos] de pasajero en el %d · ocupados %s" % [v.mi_asiento, str(v.ocupados.keys())])
	for i in 60:
		await get_tree().physics_frame
	var pegado: float = player.global_position.distance_to(v.to_global(v.asiento_pos(2)))
	if pegado > 0.6:
		fallos.append("el pasajero no va en su asiento (a %.2f m)" % pegado)
	v.salir()
	await get_tree().physics_frame
	if v.ocupados.has(2):
		fallos.append("al bajarme mi asiento se ha quedado ocupado")
	if player.br_control != null:
		fallos.append("me he bajado pero sigo atado al coche")
	# ahora solo, tiene que tocarme el volante
	vehiculos.asiento_remoto(v.id, 0, 777, false)
	vehiculos.asiento_remoto(v.id, 1, 778, false)
	player.global_position = v.global_position + Vector3(1.2, 0.5, 0.0)
	await get_tree().physics_frame
	if not vehiculos.usar_desde_jugador(player) or v.mi_asiento != 0 or v.conductor == null:
		fallos.append("con el coche vacio no me he puesto al volante")
	print("[asientos] %s%s" % ["BIEN" if fallos.is_empty() else "MAL: ", " · ".join(fallos)])
	get_tree().quit()


## --pruebaentrar: APRIETO E AL LADO DEL COCHE Y NO ENTRO. Reproduce lo que hace el jugador de verdad
## (player.interact(), no el atajo del gestor) desde varias distancias y por los cuatro costados, y dice
## en cada caso si se ha subido y, si no, por que.
##   --map=isla --pruebaentrar [--tipo=coche]
func _prueba_entrar() -> void:
	for i in 150:
		await get_tree().physics_frame
	if vehiculos == null or not is_instance_valid(vehiculos):
		print("[entrar] el mapa no trae vehiculos")
		get_tree().quit()
		return
	var tipo := "coche"
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--tipo="):
			tipo = a.substr(7)
	player.invulnerable = true
	if is_instance_valid(salto_br):
		salto_br.queue_free()
		player.br_control = null
	var idx := -1
	for i in vehiculos.puntos.size():
		if String(vehiculos.puntos[i]["tipo"]) == tipo:
			idx = i
			break
	var p: Vector3 = vehiculos.puntos[idx]["pos"]
	player.global_position = Vector3(p.x + 2.0, 30.0, p.z)
	world.set_player_position(player.global_position)
	for i in 240:
		await get_tree().physics_frame
	var v = vehiculos.nodos.get(idx)
	if v == null or not is_instance_valid(v):
		print("[entrar] el %s NI SIQUIERA EXISTE como nodo (creados %d de %d puntos)" % [tipo, vehiculos.creados, vehiculos.puntos.size()])
		get_tree().quit()
		return
	print("[entrar] %s en %s · congelado %s · asientos libres %d" % [tipo, str(v.global_position.round()),
		str(v.freeze), v.asientos() - v.ocupados.size()])
	for caso in [Vector3(1.0, 0, 0), Vector3(2.0, 0, 0), Vector3(3.0, 0, 0), Vector3(0, 0, 2.5), Vector3(-2.0, 0, 0)]:
		if player.br_control != null:
			v.salir()
			await get_tree().physics_frame
		player.global_position = v.global_position + caso + Vector3(0, 0.6, 0)
		player.velocity = Vector3.ZERO
		await get_tree().physics_frame
		# SE PULSA LA TECLA DE VERDAD, no solo se llama a interact(): el fallo era justo ese, que el coche
		# leia la MISMA pulsacion que te habia subido y te bajaba en el acto.
		Input.action_press("interact")
		player.interact()
		await get_tree().physics_frame
		Input.action_release("interact")
		await get_tree().physics_frame
		await get_tree().physics_frame
		var dentro: bool = player.br_control != null
		print("[entrar] desde %s (%.1f m): %s%s" % [str(caso), caso.length(),
			"DENTRO en el asiento %d" % v.mi_asiento if dentro else "NO", "" if dentro else "  (%s)" % vehiculos.motivo])
	get_tree().quit()


## --pruebaembestir: LO QUE ME LLEVO POR DELANTE. Se pone un coche mirando a un edificio de la ciudad a
## 30 m y se acelera contra el a fondo; se cuenta cuantos voxels se ha llevado, cuanta vida le ha costado
## y a que velocidad llegaba. Despues se repite a paso de hombre: ahi no tiene que romper nada.
##   --map=isla --pruebaembestir
func _prueba_embestir() -> void:
	for i in 150:
		await get_tree().physics_frame
	player.invulnerable = true
	if is_instance_valid(salto_br):
		salto_br.queue_free()
	player.br_control = null
	if vehiculos == null or not is_instance_valid(vehiculos):
		print("[embestir] el mapa no trae vehiculos")
		get_tree().quit()
		return
	# un sitio de la ciudad con pared delante: se busca con un rayo horizontal desde la plaza
	var centro := Vector3(CX_PRUEBA, 6.0, CZ_PRUEBA)
	player.global_position = centro
	world.set_player_position(centro)
	for i in 120:
		await get_tree().physics_frame
	# UNA PARED DISTINTA PARA CADA CASO: si todos embisten la misma, el primero abre el boquete y los
	# demas pasan por el agujero y salen "0 voxels rotos" (pasaba, y parecia que el coche no rompia nada).
	var dirs: Array = []
	for g in 72:
		var d := Vector3(cos(TAU * g / 72.0), 0.0, sin(TAU * g / 72.0))
		var rr: Dictionary = world.raycast(centro + Vector3(0, 1.2, 0), d, 60.0)
		if not rr.hit:
			continue
		var dd: float = centro.distance_to(rr.position)
		if dd < 22.0 or dd > 45.0:
			continue
		var lejos := true
		for d0 in dirs:
			if d0.dot(d) > 0.6:
				lejos = false
		if lejos:
			dirs.append(d)
	if dirs.is_empty():
		print("[embestir] no he encontrado pared a la que tirarme")
		get_tree().quit()
		return
	print("[embestir] %d paredes distintas a mano" % dirs.size())
	var casos: Array = [["moto A FONDO", 8.0, "moto"], ["coche A FONDO", 8.0, "coche"],
		["todoterreno A FONDO", 8.0, "todoterreno"], ["coche AL PASO", 1.2, "coche"]]
	var n_caso := 0
	for caso in casos:
		var dir: Vector3 = dirs[n_caso % dirs.size()]
		n_caso += 1
		var pos: Vector3 = centro - dir * 2.0
		var v = vehiculos._crear_en(pos, dir, String(caso[2]))
		if v == null:
			print("[embestir] no he podido poner el coche")
			break
		await get_tree().physics_frame
		player.global_position = v.global_position + Vector3(0, 1.0, 0)
		v.entrar(player, 0)
		var antes: int = int(world.get_stats().get("voxels_destroyed", 0))
		var vida0: float = v.vida
		var punta := 0.0
		var segundos: float = float(caso[1])
		for i in int(segundos * 60):
			if not String(caso[0]).ends_with("AL PASO"):
				Input.action_press("move_forward")
			else:
				v.linear_velocity = dir * 1.8          # a paso de hombre, sin acelerar
			await get_tree().physics_frame
			punta = maxf(punta, v.linear_velocity.length())
		Input.action_release("move_forward")
		await get_tree().physics_frame
		var rotos: int = int(world.get_stats().get("voxels_destroyed", 0)) - antes
		print("[embestir] %s: punta %.0f km/h · voxels rotos %d · le ha costado %.0f de vida" % [
			caso[0], punta * 3.6, rotos, vida0 - v.vida])
		if is_instance_valid(v) and v.conductor != null:
			v.salir()
		await get_tree().physics_frame
	get_tree().quit()


## --pruebainventario: ¿SE ABRE Y TIENE SENTIDO LO QUE PONE? Abre el inventario, cuenta lo que hay en
## cada columna y saca una foto. Sin --fotos no saca nada (la foto cuesta 0,75 s).
