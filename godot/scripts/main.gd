## Mapa: Dust 2 importado del mod de Teardown (10 cm en PC, 20 cm en móvil/LOW) o ciudad procedural.
func _load_world() -> void:
	var args := OS.get_cmdline_user_args()
	var map_name: String = Settings.map
	if "--city" in args:
		map_name = "city"
	elif "--dust2" in args:          # el nombre viejo del mapa: sigue valiendo como flag
		map_name = "dust"
	for f in args:
		if f.begins_with("--map="):
			map_name = f.substr(6)
	# EL TUTORIAL (tutorial.gd): lo pide el vestibulo para el jugador nuevo (Settings.tutorial_activo, solo en memoria) o
	# --tutorial. Settings.map no se toca: al volver, el jugador tiene el mapa que tenia.
	if Settings.tutorial_activo or "--tutorial" in args:
		map_name = "tutorial"
	# EL MODO SALE DEL MAPA. Antes venia de un ajuste guardado, asi que bastaba jugar una partida de
	# oleadas para que a partir de ahi TODOS los mapas salieran con los puestos del PvE plantados
	# delante, de noche y lloviendo. Cada mapa tiene su tipo de juego y se decide aqui.
	Settings.modo = Settings.modo_de_mapa(map_name)
	# el mapa de ESTA partida para las reglas del submodo (Net, "LOS SUBMODOS"): con --map= no es Settings.map
	Net.mapa_jugado = map_name
	# UNA SALA SIN BOTS (pestaña SALAS: el boton BOTS del anfitrion, 2026-10-13, pedido): se apagan como en los mapas sin
	# bots, solo en memoria
	if map_name in Settings.MAPAS_SIN_BOTS or (Net.is_online() and Net.sala_sin_premio and not Net.sala_bots):
		if Settings.bots_enabled:
			Settings.bots_apagados_por_mapa = true
		Settings.bots_enabled = false     # solo en memoria: es cosa de este mapa, no un ajuste tuyo
	elif Settings.bots_apagados_por_mapa:
		Settings.bots_apagados_por_mapa = false
		Settings.bots_enabled = true      # los apago el mapa de antes (la sala de espera), no tu
	if "--pve" in args or "--pvetest" in args:
		Settings.modo = "pve"      # para probar el PvE sin pasar por el lobby
	# con el modo ya decidido, la vida con la que se empieza (300, o 100 en el PvE: player.vida_max)
	if player and player.has_method("vida_max"):
		player.health = player.vida_max()
		player.health_changed.emit(player.health)
	if map_name != "city":
		# cualquier res://maps/<nombre>.vxmap (10 cm) con su variante <nombre>_lo.vxmap (20 cm, móvil/LOW)
		# EN RED, TODOS AL MISMO TAMAÑO DE VOXEL. Esto miraba SOLO la maquina local, asi que un PC
		# (calidad >= 1) cargaba el mapa de 10 cm y un movil el de 20 cm: en una partida LAN entre los
		# dos, cada uno estaba jugando en un MUNDO DISTINTO. Y como los mensajes de destruccion viajan
		# en voxels ENTEROS (`place_settled`, `place_detached`), esas coordenadas significan cosas
		# distintas a cada lado. Medido en el banco de dos instancias con --calidad=3 contra
		# --calidad=0: 170 chunks y 1.184.372 voxels en desacuerdo, COINCIDENCIA 12,4 %.
		#
		# Se juega a 20 cm, que es la unica resolucion que TODOS los aparatos pueden cargar: en el APK
		# solo se empaquetan los `_lo`, asi que un movil no puede seguir a un PC ni queriendo. Un PC
		# pierde detalle en LAN; a cambio los dos ven el mismo mundo, que es la condicion para que
		# cualquier otra cosa (fisica, derrumbes, disparos) pueda coincidir.
		# 2026-09-18 (pedido): EL PC CORRE COMO EL MOVIL, tambien a solas: mapa de 20 cm siempre. Asi lo que se ve,
		# se rompe y se derrumba es lo mismo en PC, en el movil y en LAN, y el banco mide lo que juega la gente.
		# --hi fuerza el de 10 cm para comparar.
		var hi: bool = "--hi" in args
		if Net.is_online() and hi:
			hi = false
			print("[red] mapa a 20 cm: en LAN todos los aparatos cargan la misma resolucion")
		var base := "res://maps/%s" % map_name
		var path := base + ".vxmap" if hi else base + "_lo.vxmap"
		if not FileAccess.file_exists(path):
			path = base + "_lo.vxmap" if FileAccess.file_exists(base + "_lo.vxmap") else (base + ".vxmap" if FileAccess.file_exists(base + ".vxmap") else "")
		if path != "":
			var t_carga := Time.get_ticks_msec()
			var bytes := FileAccess.get_file_as_bytes(path)
			# la sombra de las esquinas ANTES de mallar (si no, se rehace todo el mapa despues, de fondo)
			if world.has_method("set_ao_cerca"):
				world.set_ao_cerca(int(Settings.gfx_value("ao_cerca", quality)) == 1)
			var cargado: bool = bytes.size() > 0 and world.load_map(bytes)
			print("[Breach] %s leido y cargado en %d ms (bloquea el hilo principal) (t=%.1f s)" % [path.get_file(), Time.get_ticks_msec() - t_carga, Time.get_ticks_msec() / 1000.0])
			if cargado:
				current_map = map_name
				# la soldadura de flotadores solo en los mapas grandes hechos por generador (pedido): los
				# demas se cargan tal cual vienen
				var generado: bool = _mapa_generado(map_name)
				if world.has_method("set_weld_floaters"):
					world.set_weld_floaters(generado)
				# en ellos NO hay derrumbe por carga ni vuelco (pedido): solo conectividad, soldadura y
				# desgaste por caidas
				if world.has_method("set_structural_load") and generado:
					world.set_structural_load(false)
				return
		push_warning("No se pudo cargar el mapa '%s'; se genera la ciudad." % map_name)
	# Ciudad procedural: 12,5 cm en PC con calidad HIGH/ULTRA (112 m); 25 cm en móvil o gama baja (160 m).
	# 2026-09-21 (pedido): SIN OPCION. "Detalle de voxel" ya no esta en el menu: todos a 25 cm, a solas y en
	# red, para que PC y movil jueguen siempre la misma ciudad. --fine sigue forzando la fina para comparar.
	var fine: bool = "--fine" in args
	# EN RED, LA MISMA CIUDAD PARA TODOS. La fina (12,5 cm, 160 m) solo la genera un PC de calidad alta; un
	# movil genera la gruesa (25 cm, 224 m). Son dos ciudades DISTINTAS -otro tamaño, otras calles-, asi
	# que un PC y un movil en la misma sala no jugaban en el mismo mapa. Igual que los mapas importados
	# van a 20 cm en red, la ciudad va a la gruesa.
	if Net.is_online() and fine:
		fine = false
		print("[red] ciudad a 25 cm: en red todos los aparatos generan la misma")
	# El mundo de la ciudad medía 28x6x28 chunks: con voxels de 12,5 cm son 112 m de lado y sólo
	# 24 m de ALTO, así que ninguna torre podía pasar de ahí por mucho que la pidiera el generador.
	# Se sube el techo y se ensancha la parcela para que quepa una ciudad vertical de verdad.
	if fine:
		world.set_voxel_size(0.125)
		world.set_chunks(Vector3i(40, 14, 40))   # 160 x 56 x 160 m
	else:
		world.set_voxel_size(0.25)
		world.set_chunks(Vector3i(28, 8, 28))    # 224 x 64 x 224 m (móvil / gama baja)
	world.generate_city(world.get_seed())
	current_map = "city"

var current_map := "city"

## MAPAS GRANDES SALIDOS DE UN GENERADOR (tools/generar_mapa_*.py): Monaco y la isla. Se cargan
## soldando los adornos sueltos a la pared (906 en Monaco, ver docs/10_CONSTRUIR_MAPAS.md) y SIN el modelo
## de carga, que a esa escala tiraba edificios enteros tras cuatro explosiones. Va por prefijo para que
## las variantes de prueba ("monaco_viejo", "isla_b") se carguen igual que el mapa del que salen.
const MAPAS_GENERADOS := ["monaco", "isla"]

static func _mapa_generado(m: String) -> bool:
	for pre in MAPAS_GENERADOS:
		if m.begins_with(pre):
			return true
	return false

## Punto de suelo aleatorio con hueco libre encima (para colocar bots en un mapa importado).
func _random_ground_point() -> Vector3:
	var size: Vector3 = world.get_world_size()
	for attempt in 40:
		var p := Vector3(randf_range(size.x * 0.1, size.x * 0.9), 0.0, randf_range(size.z * 0.1, size.z * 0.9))
		var g: Vector3 = world.find_ground(p)
		if g.y < 0.0 or g.y > size.y - 3.0:
			continue
		var r: Dictionary = world.raycast(g + Vector3(0, 0.3, 0), Vector3.UP, 2.2)
		if r.hit:
			continue
		# NI EN EL FONDO DEL MAR. Para el motor el agua es aire y debajo hay arena: el rayo da con el fondo
		# y lo toma por suelo. Un sitio de bomba o una ronda de bots a cuatro metros bajo el agua no vale.
		if _bajo_agua(g):
			continue
		return g
	return player.global_position + Vector3(3, 0, 3)

## EL CIELO. Hasta ahora el fondo era un color liso: se veia un azul plano por encima de los
## edificios y ya. Este shader pinta sol, luna con sus fases, nubes por ruido y estrellas, y saca la
## hora del dia de la ROTACION DEL SOL, que es la que el juego ya mueve para el modo noche.
## La luna es una segunda luz direccional: el shader usa la primera como sol y la segunda como luna.
var _luna: DirectionalLight3D = null

## LA DIRECCION DEL SOL, A LA EXTENSION. El caster de sombras de cada region se queda solo con las caras
## que miran al sol: las otras nunca son lo mas cercano a la luz y solo costaban vertices en la pasada de
## sombras (1,42 M de triangulos, mas que la escena entera; medido en Monaco con --bancofps).
func _avisar_sol_sombras() -> void:
	if world and sun and world.has_method("set_shadow_light_dir"):
		world.set_shadow_light_dir(-sun.global_transform.basis.z)


func _montar_cielo() -> void:
	var we := get_node_or_null("WorldEnvironment") as WorldEnvironment
	if we == null or we.environment == null:
		return
	var sh := load("res://shaders/cielo.gdshader")
	if sh == null:
		return
	var mat := ShaderMaterial.new()
	mat.shader = sh
	if ResourceLoader.exists("res://assets/estrellas.png"):
		mat.set_shader_parameter("stars_texture", load("res://assets/estrellas.png"))
	var cielo := Sky.new()
	cielo.sky_material = mat
	# a media resolucion: el cielo no necesita el detalle entero y en una integrada se nota
	cielo.radiance_size = Sky.RADIANCE_SIZE_128
	# Y EL REFLEJO, A PLAZOS. Esto es lo que costaba los fps. El cubo de reflejo del cielo (de donde
	# sale la luz ambiental) se rehace cuando el cielo cambia, y este cielo cambia SIEMPRE porque las
	# nubes se mueven con el reloj: en AUTOMATIC, que es lo de fabrica, se rehacia entero cada cuadro.
	# Medido en el banco (--cielobench), mirando arriba con la pantalla llena de cielo:
	#     fondo de color liso ....... 14,1 ms
	#     AUTOMATIC ................. 19,9 ms   <- casi 6 ms de mas, un tercio del presupuesto a 60
	#     QUALITY ................... 21,4 ms
	#     REALTIME .................. 19,7 ms
	#     INCREMENTAL ............... 14,9 ms   <- practicamente gratis
	# INCREMENTAL reparte ese trabajo entre varios cuadros. Lo unico que se paga es que la luz
	# ambiental tarda un poco en enterarse de que ha cambiado el cielo, y como las nubes van despacio
	# eso no se ve. El cielo dibujado en pantalla es exactamente el mismo.
	cielo.process_mode = Sky.PROCESS_MODE_INCREMENTAL
	# (2026-09-30: y ahora el cielo es QUIETO -cielo.gdshader ya no usa TIME-, asi que el mapa de reflejos solo se rehace
	# cuando cambia la hora o el sol: el resto del tiempo no cuesta nada)
	# OJO: `env` (el miembro) es el NODO WorldEnvironment; lo que hay que tocar es su RECURSO
	# Environment. Poniendole `.sky` al nodo no pasa nada y el cielo se quedaba sin montar.
	var env2 := we.environment
	env2.sky = cielo
	env2.background_mode = Environment.BG_SKY
	env2.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	env2.fog_sky_affect = 0.10          # que la niebla no se coma el cielo (ver apply_quality)
	env2.volumetric_fog_sky_affect = 0.0
	# LA LUZ AMBIENTAL DEL CIELO, BAJADA DE 0,55 A 0,24. Este era el motivo de que los interiores no
	# se vieran oscuros, y no habia exposicion que lo arreglara: la exposicion es GLOBAL, no puede
	# oscurecer solo el hueco de una puerta.
	#
	# El ambiente del cielo NO proyecta sombra: entra igual en una casa cerrada que en la calle, asi
	# que rellenaba el interior entero. El sol si la proyecta -dentro no entra-, pero el ambiente lo
	# compensaba y el interior quedaba casi tan claro como fuera.
	#
	# A 0,24 el sol domina donde da y dentro apenas queda relleno: los interiores se van oscuros de
	# verdad, y entonces la adaptacion de la vista por fin tiene algo a lo que adaptarse. Es tambien
	# la proporcion real: en un dia de sol, la sombra recibe del orden de una octava parte.
	env2.ambient_light_energy = 0.24
	# LAS NUBES. `clouds_cutoff` es el corte del ruido: cuanto MAS alto, menos nube pasa el filtro.
	# Estaba en 0.30 (el valor de fabrica del shader) y con buen tiempo el cielo salia pelado: por eso
	# no se veia ni una. `clouds_weight` no es cuantas hay, es lo NEGRAS que van, y estaba en 0.
	mat.set_shader_parameter("clouds_cutoff", 0.20)
	mat.set_shader_parameter("clouds_fuzziness", 0.55)
	mat.set_shader_parameter("clouds_scale", 1.30)
	mat.set_shader_parameter("clouds_speed", 2.5)
	mat.set_shader_parameter("clouds_weight", 0.05)
	mat.set_shader_parameter("clouds_blur", 0.18)
	_cielo_mat = mat
	# si la campaña ya habia pedido su hora (amanecer, atardecer) antes de montarse el cielo, se le aplica ahora
	if _cielo_modo.size() == 2:
		if String(_cielo_modo[0]) == "nevada":
			cielo_nevado(float(_cielo_modo[1]))
		elif String(_cielo_modo[0]) == "anochecer":
			cielo_anochecer(float(_cielo_modo[1]))
		elif String(_cielo_modo[0]) == "atardecer":
			cielo_atardecer(float(_cielo_modo[1]))
		elif String(_cielo_modo[0]) == "amanecer":
			cielo_amanecer(float(_cielo_modo[1]))
		elif String(_cielo_modo[0]) == "tarde":
			cielo_tarde(float(_cielo_modo[1]))
	print("[cielo] montado: fondo=%d ambiente=%d estrellas=%s" % [
		env2.background_mode, env2.ambient_light_source,
		"si" if mat.get_shader_parameter("stars_texture") != null else "NO"])
	# LA LUNA: segunda luz direccional, enfrente del sol. Sin sombras y con casi nada de energia: esta
	# para que el shader sepa donde dibujarla, no para iluminar el mapa.
	if _luna == null:
		_luna = DirectionalLight3D.new()
		_luna.name = "Luna"
		_luna.light_energy = 0.05
		_luna.light_color = Color(0.7, 0.78, 1.0)
		_luna.shadow_enabled = false
		add_child(_luna)
	_actualizar_luna()


var _cielo_mat: ShaderMaterial = null

## La luna va enfrente del sol, un poco ladeada: asi de dia no se ve y de noche sale por el otro
## lado. Se llama al cambiar la hora (dia/noche).
## EL CIELO, ENCENDIDO O NO. Apagado no es "el shader puesto a cero": se cambia el fondo a color
## liso y se quita el cielo del entorno, que es lo unico que de verdad deja de costar. Y con el
## fondo liso la luz ambiental tiene que salir de algun sitio, asi que pasa a ser un color.
func _aplicar_cielo() -> void:
	var we := get_node_or_null("WorldEnvironment") as WorldEnvironment
	if we == null or we.environment == null:
		return
	var e := we.environment
	# EL CIELO SE MONTA SIEMPRE, TAMBIEN EN LISO (2026-09-30, pedido: "en Liso cambia la iluminacion, se ve oscuro, casi
	# no se ve nada"): la luz ambiental y los reflejos salen de el, asi que la luz es la misma con o sin. Lo unico que
	# cambia en Liso es el FONDO, un color plano (el cielo ya no se dibuja en pantalla). El mapa de reflejos se rehace a
	# plazos (INCREMENTAL) y a 128: eso cuesta casi nada. Antes, en Liso la luz ambiental pasaba a un color fijo.
	if _cielo_mat == null:
		_montar_cielo()
	if _cielo_mat == null:
		# sin el sombreado del cielo: lo de antes
		e.background_mode = Environment.BG_COLOR
		e.background_color = Color(0.42, 0.58, 0.80)
		e.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
		e.ambient_light_color = Color(0.62, 0.68, 0.80)
		return
	e.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	e.reflected_light_source = Environment.REFLECTION_SOURCE_SKY
	if _cielo_on:
		e.background_mode = Environment.BG_SKY
	else:
		e.background_mode = Environment.BG_COLOR
		e.background_color = Color(0.42, 0.58, 0.80)
	if _luna:
		_luna.visible = true          # la luna es una luz para el sombreado del cielo (el reflejo): tambien en Liso


# ---------------------------------------------------------------------------
# EL CIELO HORNEADO (2026-09-30, pedido: "si el cielo es quieto, que se calcule una vez y no gaste fps"). El cielo de
# verdad (cielo.gdshader: ruido de nubes, sol, luna, estrellas) se pinta UNA vez en una foto panoramica, y esa foto es el
# cielo: de fondo cada pixel solo la lee (lo que cuesta un fondo liso) y el mapa de reflejos sale de una imagen quieta,
# que se calcula una vez. Se vuelve a hornear solo si cambia algo (la hora, el sol, la luna, el modo de la campaña):
# `_cielo_horno_tick` mira una firma cada medio segundo.
#
# La foto la pinta el MISMO sombreado, pasado a lienzo (`_sombreado_cielo_lienzo`): EYEDIR sale de la posicion en la
# panoramica (la misma cuenta que usa Godot para leerla) y las luces van como parametros. Lo que se cambia del cielo
# (`_cielo_mat`, los cielo_amanecer, cielo_nevado...) se copia a la foto. `--sinhorno`: el cielo de antes (A/B).
# ---------------------------------------------------------------------------
var _cielo_pano: PanoramaSkyMaterial = null
var _cielo_lienzo_sh: Shader = null
var _cielo_horno_firma := ""
var _cielo_horno_t := 0.0
var _horneando_cielo := false
var _sin_horno := "--sinhorno" in OS.get_cmdline_user_args()


func _cielo_firma() -> String:
	var f := str(night) + str(_cielo_modo)
	if sun:
		f += str(sun.global_transform.basis.z.snapped(Vector3.ONE * 0.002)) + str(sun.visible)
	if _luna:
		f += str(_luna.global_transform.basis.z.snapped(Vector3.ONE * 0.002))
	return f


func _cielo_horno_tick(dt: float) -> void:
	if _sin_horno or _cielo_mat == null or _horneando_cielo:
		return
	_cielo_horno_t -= dt
	if _cielo_horno_t > 0.0:
		return
	_cielo_horno_t = 0.5
	var f := _cielo_firma()
	if f != _cielo_horno_firma:
		_cielo_horno_firma = f
		_hornear_cielo()


## cielo.gdshader (shader_type sky) pasado a canvas_item: lo mismo, pintado sobre una panoramica
func _sombreado_cielo_lienzo() -> Shader:
	var orig = load("res://shaders/cielo.gdshader")
	if orig == null:
		return null
	var c: String = (orig as Shader).code
	var pares := [
		["render_mode\\s+use_quarter_res_pass\\s*;", ""],
		["shader_type\\s+sky\\s*;", "shader_type canvas_item;\nuniform vec3 _l0_dir = vec3(0.0, 1.0, 0.0);\nuniform bool _l0_on = true;\nuniform vec3 _l1_dir = vec3(0.0, -1.0, 0.0);\nuniform bool _l1_on = true;\n"],
		["\\bEYEDIR\\b", "_eyedir"],
		["\\bLIGHT0_DIRECTION\\b", "_l0_dir"],
		["\\bLIGHT1_DIRECTION\\b", "_l1_dir"],
		["\\bLIGHT0_ENABLED\\b", "_l0_on"],
		["\\bLIGHT1_ENABLED\\b", "_l1_on"],
		["\\bAT_QUARTER_RES_PASS\\b", "true"],
		["\\bAT_CUBEMAP_PASS\\b", "false"],
		["\\bQUARTER_RES_COLOR\\b", "vec4(0.0)"],
		["\\bCOLOR\\b", "_col"],
		# la direccion de cada pixel de la panoramica (la misma que usa Godot para leerla: u = (atan(x, -z) + PI) / TAU,
		# v = acos(y) / PI) y el color, que se escribe al final
		["void\\s+sky\\s*\\(\\s*\\)\\s*\\{", "void fragment() {\n\tfloat _ph = UV.x * 6.28318530718 - 3.14159265359;\n\tfloat _th = UV.y * 3.14159265359;\n\tvec3 _eyedir = vec3(-sin(_th) * sin(_ph), cos(_th), -sin(_th) * cos(_ph));\n\tvec3 _col = vec3(0.0);"],
	]
	for par in pares:
		var re := RegEx.new()
		re.compile(String(par[0]))
		c = re.sub(c, String(par[1]), true)
	var fin := c.rfind("}")
	if fin < 0:
		return null
	c = c.substr(0, fin) + "\tCOLOR = vec4(_col, 1.0);\n}\n"
	var sh := Shader.new()
	sh.code = c
	return sh


func _hornear_cielo() -> void:
	var we := get_node_or_null("WorldEnvironment") as WorldEnvironment
	if we == null or we.environment == null or we.environment.sky == null or _cielo_mat == null:
		return
	_horneando_cielo = true
	if _cielo_lienzo_sh == null:
		_cielo_lienzo_sh = _sombreado_cielo_lienzo()
	if _cielo_lienzo_sh == null:
		_horneando_cielo = false
		return
	var ancho := 1024 if Settings.is_mobile() else 2048
	var sv := SubViewport.new()
	sv.size = Vector2i(ancho, ancho / 2)
	sv.disable_3d = true
	sv.transparent_bg = false
	sv.use_hdr_2d = true            # el sol va a 10x el blanco: sin esto el reflejo salia apagado
	sv.render_target_update_mode = SubViewport.UPDATE_ONCE
	var r := ColorRect.new()
	r.size = Vector2(sv.size)
	var m := ShaderMaterial.new()
	m.shader = _cielo_lienzo_sh
	for u in (_cielo_mat.shader as Shader).get_shader_uniform_list():
		var n := String(u["name"])
		m.set_shader_parameter(n, _cielo_mat.get_shader_parameter(n))
	# las dos luces como las ve el cielo: el sol (la primera) y la luna (la segunda), apuntando HACIA ellas
	if sun:
		m.set_shader_parameter("_l0_dir", sun.global_transform.basis.z.normalized())
		m.set_shader_parameter("_l0_on", sun.visible)
	if _luna:
		m.set_shader_parameter("_l1_dir", _luna.global_transform.basis.z.normalized())
		m.set_shader_parameter("_l1_on", _luna.visible)
	else:
		m.set_shader_parameter("_l1_on", false)
	r.material = m
	sv.add_child(r)
	add_child(sv)
	await RenderingServer.frame_post_draw
	await RenderingServer.frame_post_draw
	var img := sv.get_texture().get_image()
	sv.queue_free()
	_horneando_cielo = false
	if img == null or img.is_empty() or not is_inside_tree():
		return
	var tex := ImageTexture.create_from_image(img)
	if _cielo_pano == null:
		_cielo_pano = PanoramaSkyMaterial.new()
		_cielo_pano.filter = true
	_cielo_pano.panorama = tex
	var cielo := we.environment.sky
	if cielo.sky_material != _cielo_pano:
		cielo.sky_material = _cielo_pano
	# una imagen quieta: el mapa de reflejos se calcula una vez, entero y bien
	cielo.process_mode = Sky.PROCESS_MODE_QUALITY
	if "--cielohornofoto" in OS.get_cmdline_user_args():
		img.save_png("user://cielo_horneado.png")


## NOCHE CERRADA (la campaña): la noche normal deja el sol a -28 grados, por encima del horizonte, y el
## shader del cielo (shaders/cielo.gdshader) decide dia o noche por la altura de esa luz: se veia un cielo de
## tarde azul con nubes blancas. Aqui se pintan los colores de DIA con los de noche -azul casi negro, nubes de
## humo gris oscuro, sin disco de sol- y el cielo es de noche pase lo que pase con las luces.
## EL AMANECER (episodio 3): el sol a 12 grados sobre el mar, luz calida y sombras largas; cielo azul arriba
## y naranja en el horizonte, nubes de melocoton; ambiente tibio y las farolas apagadas.
func cielo_amanecer(azimut: float) -> void:
	if night:
		set_night(false)
	if _day.is_empty():
		_save_day()
	_cielo_modo = ["amanecer", azimut]
	sun.rotation_degrees = Vector3(-12.0, azimut, 0.0)
	sun.light_color = Color(1.0, 0.76, 0.54)
	sun.light_energy = float(_day["sun_e"]) * 1.05
	_avisar_sol_sombras()
	var e: Environment = env.environment
	e.ambient_light_color = Color(0.70, 0.62, 0.60)
	e.ambient_light_energy = float(_day["amb_e"]) * 0.95
	e.fog_light_color = Color(0.96, 0.74, 0.56)
	_show_lamps(false)
	if _cielo_mat == null:
		return
	var m := _cielo_mat
	m.set_shader_parameter("day_top_color", Color(0.30, 0.50, 0.78))
	m.set_shader_parameter("day_bottom_color", Color(0.96, 0.76, 0.60))
	m.set_shader_parameter("sunset_top_color", Color(0.36, 0.46, 0.72))
	m.set_shader_parameter("sunset_bottom_color", Color(1.0, 0.60, 0.38))
	m.set_shader_parameter("horizon_color", Color(1.0, 0.66, 0.42))
	m.set_shader_parameter("sun_color", Vector3(10.0, 6.8, 3.2))
	m.set_shader_parameter("sun_sunset_color", Vector3(10.0, 4.2, 1.2))
	m.set_shader_parameter("clouds_edge_color", Color(1.0, 0.80, 0.62))
	m.set_shader_parameter("clouds_top_color", Color(1.0, 0.93, 0.84))
	m.set_shader_parameter("clouds_middle_color", Color(0.98, 0.82, 0.68))
	m.set_shader_parameter("clouds_bottom_color", Color(0.82, 0.62, 0.58))


## LA NEVADA (episodio 6, 2026-09-30): de dia, cielo cubierto y gris, luz fria y NEVANDO. La nieve cuaja a medias
## (`nieve_tope` 0,3): del todo (y aun a 0,45, medido en captura) las placas de hielo fino del lago salian casi igual de
## blancas que las gruesas.
func cielo_nevado(azimut: float) -> void:
	if night:
		set_night(false)
	if raining:
		set_rain(false)
	if _day.is_empty():
		_save_day()
	_cielo_modo = ["nevada", azimut]
	sun.rotation_degrees = Vector3(-34.0, azimut, 0.0)
	sun.light_color = Color(0.86, 0.9, 1.0)
	sun.light_energy = float(_day["sun_e"]) * 0.6
	_avisar_sol_sombras()
	var e: Environment = env.environment
	e.ambient_light_color = Color(0.76, 0.82, 0.92)
	e.ambient_light_energy = float(_day["amb_e"]) * 1.1
	e.fog_light_color = Color(0.82, 0.86, 0.92)
	e.fog_enabled = true
	e.fog_density = maxf(e.fog_density, 0.012)
	_show_lamps(false)
	nieve_tope = 0.3
	if not nevando:
		nevando = true
		if _nieve_fx == null:
			_nieve_fx = _make_nieve()
			add_child(_nieve_fx)
		_nieve_fx.emitting = true
	if _cielo_mat == null:
