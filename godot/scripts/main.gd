## LA LLUVIA SE APAGA SOLA SI DA LAG (2026-10-28, pedido): UNA SOLA VEZ por aparato, la primera partida con lluvia mide
## 8 s con ella; si no llega a 58 fps, mide 8 s sin ella y, si sin lluvia va al menos un 8 % mejor, apaga el ajuste
## "Lluvia" (guardado; quien la quiera la vuelve a encender en GRAFICOS). Si no gana, la lluvia vuelve. Con el tope de fps
## por debajo de 60 no se mide. --lluviarevision fuerza la prueba aunque ya se hiciera.
func _lluvia_revision() -> void:
	var forzar := "--lluviarevision" in OS.get_cmdline_user_args()
	if (Settings.lluvia_revisada and not forzar) or (Engine.max_fps > 0 and Engine.max_fps < 60):
		return
	await get_tree().create_timer(6.0).timeout
	if not is_inside_tree() or not raining:
		return
	var con := await _medir_fps(8.0)
	print("[lluvia] revision: %.1f fps con lluvia" % con)
	if con >= 58.0:
		_lluvia_revisada_guardar()
		return
	set_rain(false)
	await get_tree().create_timer(2.0).timeout
	if not is_inside_tree():
		return
	var sin := await _medir_fps(8.0)
	print("[lluvia] revision: %.1f fps sin lluvia" % sin)
	if sin >= con * 1.08:
		Settings.gfx["lluvia"] = 0
		print("[lluvia] da lag en este aparato: ajuste Lluvia apagado")
	else:
		set_rain(true)
		if Settings.is_touch():
			_lluvia_movil_ligera()
	_lluvia_revisada_guardar()


func _lluvia_revisada_guardar() -> void:
	Settings.lluvia_revisada = true
	Settings.save()


func _medir_fps(seg: float) -> float:
	var f0 := Engine.get_frames_drawn()
	var t0 := Time.get_ticks_usec()
	await get_tree().create_timer(seg).timeout
	return float(Engine.get_frames_drawn() - f0) / maxf(0.001, float(Time.get_ticks_usec() - t0) / 1e6)



# ---------------------------------------------------------------------------
# LAS LUCES TAPADAS NO SE PROCESAN (2026-10-12, pedido: "las luces que no se ven, detras de las paredes, que no se
# procesen"). Al mundo los faroles le alumbran cocinados (lamparas.gdshaderinc: no cuestan como luces); las Light3D solo
# alumbran muñecos, armas y objetos. Una cuya bombilla no se ve desde la camara (un rayo choca antes) y que no llega a la
# camara (no hay nada suyo que alumbrar que se vea) se esconde; al verse otra vez, vuelve. Se miran LAMP_OCLU_POR_TICK
# por tick, cada LAMP_OCLU_S. --sinoclusionluces = como antes.
# ---------------------------------------------------------------------------
const LAMP_OCLU_S := 0.12
const LAMP_OCLU_POR_TICK := 24
var _lamps_on := false
var _lamp_ocl: PackedByteArray = PackedByteArray()
var _lamp_ocl_i := 0
var _lamp_ocl_t := 0.0
static var _sin_oclu_luces: int = -1

func _lamp_tapada(i: int) -> bool:
	return i < _lamp_ocl.size() and _lamp_ocl[i] != 0

func _lamp_oclusion_tick(dt: float) -> void:
	if _sin_oclu_luces < 0:
		_sin_oclu_luces = 1 if "--sinoclusionluces" in OS.get_cmdline_user_args() else 0
	if _sin_oclu_luces == 1 or not _lamps_on or _lamp_pool.is_empty() or world == null or player == null or player.cam == null:
		return
	_lamp_ocl_t -= dt
	if _lamp_ocl_t > 0.0:
		return
	_lamp_ocl_t = LAMP_OCLU_S
	if _lamp_ocl.size() != _lamp_pool.size():
		_lamp_ocl.resize(_lamp_pool.size())
		_lamp_ocl.fill(0)
	var cp: Vector3 = player.cam.global_position
	var n := _lamp_pool.size()
	for _k in mini(LAMP_OCLU_POR_TICK, n):
		_lamp_ocl_i = (_lamp_ocl_i + 1) % n
		var i := _lamp_ocl_i
		if _lamp_dead[i] != 0:
			continue
		var o: Light3D = _lamp_pool[i]
		var lp: Vector3 = o.global_position
		var d: float = cp.distance_to(lp)
		var alcance: float = float(_lamp_range[i]) if i < _lamp_range.size() else 6.0
		var tapada := false
		if d > alcance + 1.0 and (not o.distance_fade_enabled or d < o.distance_fade_begin + o.distance_fade_length):
			# la bombilla, vista desde la camara (el rayo se para un poco antes de ella: su propia lampara)
			var h: Dictionary = world.raycast(cp, (lp - cp) / d, d - 0.7)
			tapada = bool(h.get("hit", false))
		var b: int = 1 if tapada else 0
		if b != _lamp_ocl[i]:
			_lamp_ocl[i] = b
			o.visible = _lamps_on and not tapada



## DE NOCHE EL 40 % DE LAS PARTIDAS (2026-10-12, pedido: "60 % de dia y 40 de noche"): como la lluvia, el mismo sorteo en
## toda la sala (Net.semilla_partida) y en los mismos mapas. La noche es la de la campaña (set_night + cielo_noche_cerrada:
## farolas, bombillas y ventanas encendidas). --nochesiempre / --sinnocheazar.
const PROB_NOCHE := 0.40
var _noche_partida := false

func _noche_al_azar() -> void:
