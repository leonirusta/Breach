## --botstrabados (2026-10-02, pedido: "en la cafeteria hay bots que se traban"): CENSO DE BOTS QUIETOS. Cada segundo mira
## cada bot vivo que piensa aqui; si en 8 s no se ha alejado 1 m de donde estaba y NO esta peleando (sin objetivo a la
## vista), lo apunta: sitio (redondeado a 1 m), estado, si llevaba camino y a cuanto estaba el siguiente punto. Cada 30 s
## imprime los sitios donde mas se traban. Con --perfmapa los bots juegan solos.
func _bots_trabados() -> void:
	var nombres := ["GUARDIA", "PATRULLA", "INVESTIGA", "COMBATE", "BUSCA"]
	var hist := {}           # bot -> [[t, pos], ...]
	var sitios := {}         # "x,y,z" -> {n, estados, con_camino, sin_camino, dist_sig}
	var trabados_ya := {}    # bot -> t del ultimo apunte (no se cuenta dos veces el mismo parón)
	var t := 0.0
	await get_tree().create_timer(6.0).timeout
	while is_inside_tree():
		await get_tree().create_timer(1.0).timeout
		t += 1.0
		if enemies == null:
			continue
		for e in enemies.get_children():
			if not is_instance_valid(e) or not ("team" in e) or bool(e.get("remoto")) or float(e.get("health")) <= 0.0:
				continue
			var h: Array = hist.get(e, [])
			h.append([t, e.global_position])
			while h.size() > 9:
				h.pop_front()
			hist[e] = h
			if h.size() < 9:
				continue
			var lejos := 0.0
			for x in h:
				lejos = maxf(lejos, (x[1] as Vector3).distance_to(h[0][1]))
			var tgt = e.get("target")
			var peleando: bool = int(e.get("state")) == 3 and tgt != null and is_instance_valid(tgt) 				and e.global_position.distance_to((tgt as Node3D).global_position) < 60.0
			if lejos >= 1.0 or peleando:
				continue
			if trabados_ya.has(e) and t - float(trabados_ya[e]) < 8.0:
				continue
			trabados_ya[e] = t
			var p: Vector3 = e.global_position
			var k := "%d,%d,%d" % [roundi(p.x), roundi(p.y), roundi(p.z)]
			var s: Dictionary = sitios.get(k, {"n": 0, "estados": {}, "con_camino": 0, "sin_camino": 0, "dist_sig": 0.0})
			s.n += 1
			var nom: String = nombres[clampi(int(e.get("state")), 0, 4)]
			s.estados[nom] = int(s.estados.get(nom, 0)) + 1
			var camino: PackedVector3Array = e.get("path") if e.get("path") != null else PackedVector3Array()
			if camino.size() > 0:
				s.con_camino += 1
				s.dist_sig = p.distance_to(camino[0])
			else:
				s.sin_camino += 1
			sitios[k] = s
			var pi: int = int(e.get("path_i"))
			var wp: Vector3 = camino[pi] if pi < camino.size() else Vector3.INF
			var bloq_wp := false
			if wp != Vector3.INF:
				var dh := Vector3(wp.x - p.x, 0.0, wp.z - p.z)
				if dh.length() > 0.01:
					bloq_wp = bool(e.call("_blocked_at", p + dh.normalized() * 0.3))
			var vel: Vector3 = e.get("velocity")
			print("[trabados] t=%d bot %s (%s) quieto en %s · %s · camino %d (va por el %d: %s, a %.2f m, bloqueado hacia el %s) · vel %.2f · suelo %s · metido %s · destino %s a %.1f m · rodeo %.1f rompe %.1f" % [
				int(t), str(e.get("red_id")), str(e.get("team")), str(p.snapped(Vector3.ONE * 0.1)), nom, camino.size(), pi,
				str(wp.snapped(Vector3.ONE * 0.1)) if wp != Vector3.INF else "-", p.distance_to(wp) if wp != Vector3.INF else -1.0,
				str(bloq_wp), Vector2(vel.x, vel.z).length(), str(e.get("on_floor")), str(bool(e.call("_blocked_at", p))),
				str((e.get("move_target") as Vector3).snapped(Vector3.ONE * 0.1)), p.distance_to(e.get("move_target")),
				float(e.get("_pd_rodeo_t")), float(e.get("_pd_rompiendo_t"))])
		if int(t) % 30 == 0 and not sitios.is_empty():
			var ks := sitios.keys()
			ks.sort_custom(func(a, b): return int(sitios[a].n) > int(sitios[b].n))
			print("[trabados] === a los %d s: %d paradas en %d sitios ===" % [int(t), ks.reduce(func(acc, k2): return acc + int(sitios[k2].n), 0), ks.size()])
			for k3 in ks.slice(0, 12):
				print("[trabados]   %s · %d veces · %s · con camino %d / sin %d" % [k3, int(sitios[k3].n), str(sitios[k3].estados),
					int(sitios[k3].con_camino), int(sitios[k3].sin_camino)])


