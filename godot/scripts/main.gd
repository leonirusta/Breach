## Tres equipos, bases alrededor de la caja fuerte, y a elegir equipo. Los bots y el atraco empiezan al
## cerrar la eleccion (_close_team_select).
func _ciudad_tres_equipos() -> void:
	ciudad3 = true
	Net.equipos = [Net.TEAM_T, Net.TEAM_CT, Net.TEAM_V]
	player.reaparece_en_base = true
	var v: Vector3 = _pick_vault_spot()
	if v == Vector3.ZERO:
		v = world.get_spawn_position()
	bases_equipo = _bases_alrededor(v)
	# los bots van hacia la caja: el "centro" del duelo es la calle bajo el edificio de la caja
	dm_centro = _ground_near(Vector3(v.x, 0.6, v.z))
	print("[ciudad3] caja en %s · bases %s" % [str(v.round()), str(bases_equipo)])
	_caja_siguiente = v
	_cajas_usadas = []
	ciudad_terminada = false
	puntos_equipo = {}
	for eq in Net.equipos:
		puntos_equipo[String(eq)] = 0
	# EL EQUIPO TOCA AL AZAR: no hay pantalla de eleccion. Se sortea entre los equipos que tengan sitio
	# (en LAN el anfitrion sigue equilibrando: si el sorteado estaba lleno, te pone en el que tenga menos
	# gente). _pick_team cierra la eleccion y eso arranca bots y atraco, igual que al elegir a mano.
	var libres: Array = []
	for eq in Net.equipos:
		if Net.team_available(String(eq)):
			libres.append(String(eq))
