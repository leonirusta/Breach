			print("[navtest] %s -> %s: %d puntos, fin %s (a %.1f m del destino), completo %s, %.1f ms (gd %.1f ms)" % [from, tg, pth.size(), endp, endp.distance_to(tg), str(stn.get("nav_last_complete", "?")), stn.get("nav_last_ms", -1.0), (Time.get_ticks_usec() - t0n) / 1000.0])
	if _diag_frames == 1100 and "--tpcluster" in OS.get_cmdline_user_args():
		player.global_position = Vector3(100.0, 8.0, 46.0)
		player.look_at_point(Vector3(107.6, 2.8, 40.4))
	if _diag_frames in [200, 500] and "--tpbots" in OS.get_cmdline_user_args():
		# teletransporte junto a un grupo de bots para verlos (frame 200: sitio A, frame 500: sitio B)
		var idx := 0 if _diag_frames == 200 else 1
		if enemies.get_child_count() > idx:
			var e0: Node3D = enemies.get_child(idx)
			var f := Vector3(1, 0, 0)
			var pp: Vector3 = world.find_ground(e0.global_position + f * 6.0)
			player.global_position = pp + Vector3(0, 0.6, 0)
			player.look_at_point(e0.global_position + Vector3(0, 1.0, 0))
			print("[tpbots] jugador a %s mirando al bot en %s" % [player.global_position, e0.global_position])
	if _diag_frames in [60, 600, 1200, 1800] and "--botsdbg" in OS.get_cmdline_user_args():
		var alive := enemies.get_child_count()
		print("[botsdbg] f%d: bots %d, bajas %d, jugador %s" % [_diag_frames, alive, kills, player.global_position])
		for e in enemies.get_children():
			print("[botsdbg]   bot %d pos %s vida %.0f estado %d dist %.1f | objetivo %s camino %d directo %d rover %s" % [e.get_instance_id() % 1000, e.global_position, e.health, e.state, e.global_position.distance_to(player.global_position), e.move_target, e.path.size(), e.direct_t, str(e.rover)])
	Prof.add("main.tail.d", Time.get_ticks_usec() - _t0)
	if _diag_frames == 120 and "--explodetest" in OS.get_cmdline_user_args():
		# prueba de humo (headless): una explosión y un resumen por consola. SÓLO con --explodetest: sin el flag
		# esto explotaba a 6 m del jugador 2 s después de entrar en cualquier mapa ("algo se rompe solo al empezar").
		var c: Vector3 = world.get_building_centers()[0] if world.get_building_centers().size() > 0 else player.global_position + Vector3(6, 1, 0)
		var removed: int = world.explode(Vector3(c.x, c.y + 1.5, c.z), 4.0, 255)
		print("[Breach] explosión de prueba: %d voxels eliminados" % removed)
	elif _diag_frames == 100:
		var _t100 := Time.get_ticks_usec()
		print("[Breach] frame 100: jugador en %s (suelo: %s), vida %.0f" % [player.global_position, player.is_on_floor(), player.health])
		Prof.add("main.tail.f100print", Time.get_ticks_usec() - _t100)
		# en PvE los hijos de `enemies` son criaturas (criatura.gd), sin avatar de soldado
		if enemies.get_child_count() > 0 and "avatar" in enemies.get_child(0) and enemies.get_child(0).avatar:
			var e = enemies.get_child(0)
			var aabb := AABB()
			var first := true
			for n in e.avatar.find_children("*", "MeshInstance3D", true, false):
				var a: AABB = n.global_transform * n.get_aabb()
				aabb = a if first else aabb.merge(a)
				first = false
			print("[Breach] avatar bot: escala %s, huesos %d, clip %s, AABB tamaño %s, pos %s" % [e.avatar.scale, e.avatar.bone_idx.size(), e.avatar.current_clip, aabb.size, e.global_position])
		Prof.add("main.tail.f100", Time.get_ticks_usec() - _t100)
	elif _diag_frames in [200, 300, 450, 600]:
		var _t200 := Time.get_ticks_usec()
		var st: Dictionary = world.get_stats()
		Prof.add("main.tail.f200stats", Time.get_ticks_usec() - _t200)
		print("[Breach] frame %d: cuerpos %d (rigid %d), escombros %d, piezas %d (derrumbe %d, sueltas %d, %d voxels), diminutas %d, update %.2f ms, host %.2f ms (máx %.1f), jobs %d | estructura: %s it %d fallos %d fragmentos %d peor %.2f %.1f ms/it" % [
			_diag_frames, st.get("bodies_active", 0), st.get("bodies_rigid", 0), st.get("debris_active", 0), st.get("pieces_total", 0),
			st.get("groups_structural", 0), st.get("groups_plain", 0), st.get("group_voxels", 0), st.get("tiny_pieces", 0),
			st.get("t_update_ms", 0.0), st.get("t_host_ms", 0.0), st.get("t_host_max_ms", 0.0), st.get("jobs_pending", 0),
			"ACTIVA" if st.get("struct_active", 0) > 0 else "dormida", st.get("struct_iterations", 0), st.get("struct_failures", 0), st.get("struct_fragments", 0), st.get("struct_worst_ratio", 0.0), st.get("t_struct_ms", 0.0)])
		Prof.add("main.tail.f200", Time.get_ticks_usec() - _t200)
	Prof.add("main.tail", Time.get_ticks_usec() - _t0)

# ------------------------------------------------------------------ MODO FOTO
## LA FOTO NO SE SACA CON TUS AJUSTES DE JUGAR. Lo pidio el usuario: al pulsar SACAR FOTO se pone TODO
## al maximo de verdad (no el preset ULTRA, que en esta maquina esta capado a proposito para que vaya
## fluido: resolucion a la mitad y sombras bajas), se quita el desenfoque de enfoque para que salga
## nitida de punta a punta, se esconde el arma y se espera a que el mundo TERMINE de cargar a esa
## distancia. Si se disparara antes, la foto saldria con agujeros donde aun no hay malla. Despues se
## devuelve tu configuracion tal cual estaba, hasta la ultima opcion del menu.
##
## Lo que NO se toca: la camara al cuerpo, la lente y la vineta. Eso es el ASPECTO que hayas elegido,
## no calidad; si juegas con bodycam, tu foto sale con bodycam.
## Sin las DISTANCIAS (vision, LOD, detalle): subirlas manda a mallar el mapa otra vez y habia que esperar segundos
## (pedido: la foto, al instante). Lo demas, al maximo.
const FOTO_CLAVES_MAX := ["render_scale", "shadows", "antialias", "voxel_ao", "glow"]

func foto_modo_max() -> Dictionary:
	var prev := {
		"gfx_custom": Settings.gfx_custom,
		"gfx": Settings.gfx.duplicate(true),
		"quality": quality,
		"override": Settings.quality_override,
		"focus": Settings.focus_mode,
		"nodos": [],
	}
	# el arma, los brazos y el escudo fuera de la foto
	for n in [player.weapon_pivot, player.get("fp_arms"), player.get("_esc_pivot")]:
		if n != null and is_instance_valid(n) and n is Node3D and (n as Node3D).visible:
			prev["nodos"].append(n)
			(n as Node3D).visible = false
	# todo al maximo: el valor mas alto de cada opcion, que no es el del preset ULTRA
	var g: Dictionary = Settings.gfx.duplicate(true)
	if not Settings.gfx_custom:
		g = Settings.gfx_preset(quality)
	for k in FOTO_CLAVES_MAX:
		if Settings.GFX_OPTIONS.has(k):
			g[k] = (Settings.GFX_OPTIONS[k] as Array).size() - 1
	# sin desenfoque de enfoque ni estela de movimiento: es una foto, no un plano en movimiento
	g["focus"] = 0
	g["desenfoque"] = 0
	g["motion_blur"] = 0
	Settings.focus_mode = 0
	Settings.gfx = g
	Settings.gfx_custom = true
	Settings.quality_override = 3
	apply_quality(3)
	return prev


func foto_modo_restaurar(prev: Dictionary) -> void:
	if prev.is_empty():
		return
	for n in prev.get("nodos", []):
		if is_instance_valid(n):
			(n as Node3D).visible = true
	Settings.gfx = prev["gfx"]
	Settings.gfx_custom = bool(prev["gfx_custom"])
	Settings.quality_override = int(prev["override"])
	Settings.focus_mode = int(prev["focus"])
	apply_quality(int(prev["quality"]))


## A ESPERAR QUE EL MUNDO ESTE ENTERO. Subir la distancia de vision manda a cargar mallas nuevas; si se
## dispara antes de que lleguen, la foto sale con boquetes. Se espera a que no quede trabajo pendiente,
## con un tope de tiempo para no dejar al jugador colgado si algo se atasca.
func foto_esperar_mundo(segundos: float = 3.0) -> void:
	var t0 := Time.get_ticks_msec()
	while Time.get_ticks_msec() - t0 < int(segundos * 1000.0):
		var st: Dictionary = world.get_stats()
		if int(st.get("jobs_pending", 0)) == 0 and int(st.get("mesh_results_pending", 0)) == 0 \
				and int(st.get("blocks_dirty", 0)) == 0 and int(st.get("regions_dirty", 0)) == 0:
			break
		await get_tree().process_frame
	for _i in 4:
		await get_tree().process_frame


# ------------------------------------------------------------------ MODO ENFOQUE
## LO QUE ESTA BORROSO NO HACE FALTA DIBUJARLO FINO. Lo pidio el usuario: "cuando enfocás, lo demás lo
## desenfoca; ahí podríamos quitarle calidad de resolución a las cosas borrosas, total no las vamos a
## ver". Y tiene razón: apuntando, la profundidad de campo difumina TODO menos lo que estás mirando, así
## que la resolución que se gasta en el fondo se la come el desenfoque igual.
##
## Mientras apuntas: el 3D se dibuja a menos resolución, las sombras se acortan y la pasada de lente se
## apaga. Lo nítido (la mira y lo que apuntas) ocupa poca pantalla y además el ADS cierra el ángulo de
## visión, así que el detalle que se pierde no se ve; lo que se gana son fotogramas justo en el momento
## en el que estás disparando, que es cuando más falta hacen.
##
## Con histéresis (0,65 para entrar y 0,35 para salir): sin ella, apuntando a medias la resolución
## cambiaría varias veces por segundo y eso sí se nota.
const ENFOQUE_ESCALA := 0.78       ## lo que se multiplica la resolución del 3D al apuntar
const ENFOQUE_SOMBRA := 0.60       ## y la distancia de las sombras
var _enfoque_activo := false
var _enfoque_escala0 := 0.0
var _enfoque_sombra0 := 0.0
var _enfoque_lente0 := -1

func _enfoque_barato() -> void:
	if player == null or not is_instance_valid(player):
		return
	# sin desenfoque no hay nada que aprovechar: el fondo se ve nítido y bajarle la resolución se notaría
	if int(Settings.focus_mode) <= 0 or float(Settings.focus_amount) <= 0.0:
		if _enfoque_activo:
			_enfoque_barato_off()
		return
	var k: float = float(player.get("_focus_w"))
	if not _enfoque_activo and k > 0.65:
		_enfoque_activo = true
		var vp := get_viewport()
		_enfoque_escala0 = vp.scaling_3d_scale
		vp.scaling_3d_scale = maxf(0.30, _enfoque_escala0 * ENFOQUE_ESCALA)
		if sun:
			_enfoque_sombra0 = sun.directional_shadow_max_distance
			sun.directional_shadow_max_distance = _enfoque_sombra0 * ENFOQUE_SOMBRA
		if hud and hud.has_method("set_lente"):
			_enfoque_lente0 = int(hud.lente_nivel)
			if _enfoque_lente0 > 0:
				hud.set_lente(0)
	elif _enfoque_activo and k < 0.35:
		_enfoque_barato_off()


func _enfoque_barato_off() -> void:
	_enfoque_activo = false
	if _enfoque_escala0 > 0.0:
		get_viewport().scaling_3d_scale = _enfoque_escala0
	if sun and _enfoque_sombra0 > 0.0:
		sun.directional_shadow_max_distance = _enfoque_sombra0
	if hud and hud.has_method("set_lente") and _enfoque_lente0 > 0:
		hud.set_lente(_enfoque_lente0)
	_enfoque_lente0 = -1


## Diagnostico de partida LAN: cuenta los avatares remotos que se ven y prueba la destruccion
## replicada, para comprobar que los dos equipos acaban con el mismo mapa.
func _lan_report() -> void:
	var secs := 16
	for f in OS.get_cmdline_user_args():
		if f.begins_with("--lansecs="):
			secs = int(f.substr(10))
	var role := "ANFITRION" if Net.hosting else "CLIENTE"
	if "--lanwalk" in OS.get_cmdline_user_args():
		_lan_walk()
	for i in secs:
		await get_tree().create_timer(1.0).timeout
		var names: Array = []
		for r in Net.remotes.values():
			if is_instance_valid(r):
				var clip := "?"
				var sp := 0.0
				if r.avatar:
					clip = String(r.avatar.current_clip)
					sp = float(r.avatar.anim_speed) if "anim_speed" in r.avatar else 0.0
				names.append("%s@%.1f,%.1f,%.1f clip=%s x%.2f vel=%.1f arma=%s disparos=%d" % [
					r.player_name, r.global_position.x, r.global_position.y, r.global_position.z,
					clip, sp, r.net_vel.length(), "si" if r.has_weapon() else "NO", r.shots_seen])
		# ¿EL ARMA DEL COMPANERO APUNTA A DONDE EL APUNTA? Se compara la direccion real (su guiñada y
		# su cabeceo, que viajan) con hacia donde mira el cañon de su avatar, y a que altura sale la
		# boca respecto a su ojo. Si no coinciden, se le ve disparar a un sitio y la bala va a otro.
		for r2 in Net.remotes.values():
			if not is_instance_valid(r2) or r2.avatar == null or r2.avatar._wm == null:
				continue
			# MIRANDOLE DE VERDAD: el avatar deja de animarse cuando se sale del encuadre, asi que
			# medirlo de espaldas daria un numero inventado. Se le apunta y se le dan unos frames.
			player.look_at_point(r2.global_position + Vector3(0, 1.5, 0))
			for _f in 6:
				await get_tree().process_frame
			var wm2 = r2.avatar._wm
			if not is_instance_valid(wm2):
				continue
			var real: Vector3 = (Quaternion(Vector3.UP, r2.rotation.y) * Quaternion(Vector3.RIGHT, r2.target_pitch)) * Vector3.FORWARD
			var canon: Vector3 = -wm2.global_transform.basis.z
			var boca2: Vector3 = wm2.global_transform * wm2.muzzle_pos
			var av2 = r2.avatar
			print("[lanapunta] %s  cabeceo %.1f · desvio del cañon %.1f grados · boca a %.2f m · clip %s | raiz_arma %s externa %s marcador %s cuello %s | pista %.2f bajada %.2f apuntando %.2f desde_disparo %.2f" % [
				r2.player_name, rad_to_deg(r2.target_pitch), rad_to_deg(acos(clampf(real.dot(canon), -1.0, 1.0))),
				boca2.y - r2.global_position.y, String(av2.current_clip),
				str(av2.weapon_root != null), str(av2._external_weapon), str(av2.grip_marker != null),
				str(av2.bone_idx.has("neck")), av2._pista_w, av2._lower_w, av2._dbg_aim_ef, av2._since_fire])
			print("             arma '%s' id '%s' una_mano %s · raiz del arma en %s giro %s · brazo %.1f grados" % [
				String(av2.weapon_kind), String(av2._wm.arma_id), str(av2._one_hand),
				str((av2.weapon_root as Node3D).position.round()), str((av2.weapon_root as Node3D).rotation_degrees.round()),
				rad_to_deg(av2._arm_pitch)])
		var st: Dictionary = world.get_stats()
		print("[lantest] %s t=%ds  avatares remotos %d %s  |  yo en %.1f,%.1f,%.1f  |  voxels solidos %d | piezas %d (estructurales %d, sueltos %d) cuerpos %d revox %d" % [
			role, i + 1, Net.remotes.size(), str(names),
			player.global_position.x, player.global_position.y, player.global_position.z,
			int(st.get("voxels_solid", 0)), int(st.get("pieces_total", 0)), int(st.get("groups_structural", 0)),
			int(st.get("groups_plain", 0)), int(st.get("bodies_total", 0)), int(st.get("revox_total", 0))])
		print("[lansync]   sueltas out %d (%d celdas, %d SOLIDAS) in %d (%d celdas, %d ya aire) | asientos out %d (%d celdas) in %d celdas, saltadas %d | tallas de cuerpo %d" % [
			int(st.get("sync_sueltas_out", 0)), int(st.get("sync_celdas_sueltas_out", 0)), int(st.get("sync_celdas_solidas", 0)),
			int(st.get("sync_sueltas_in", 0)), int(st.get("sync_celdas_sueltas_in", 0)), int(st.get("sync_celdas_ya_aire", 0)),
			int(st.get("sync_asientos_out", 0)), int(st.get("sync_celdas_asiento_out", 0)),
			int(st.get("sync_celdas_asiento_in", 0)), int(st.get("sync_celdas_asiento_salt", 0)),
			int(st.get("sync_tallas_cuerpo", 0))])
		# el anfitrion pega un pelotazo a los 5 s: los dos equipos deben perder los MISMOS voxels
		if i == 4 and Net.hosting:
			var at: Vector3 = player.global_position + Vector3(3, 0, 0)
			print("[lantest] ANFITRION: explosion de prueba en %.1f,%.1f,%.1f" % [at.x, at.y, at.z])
			Net.net_explode(world, at, 4.0, 255)
		# ...y a los 8 s una rafaga, que es lo que hace el jugador de verdad: un disparo tiene que
		# quitar los MISMOS voxels en las dos maquinas, y lo que se caiga por quedarse sin apoyo
		# tiene que caerse en las dos.
		# ...y a los 6 s se tira un edificio entero, REPLICADO: es la prueba dura del solver, que es
		# quien decide que se desprende. Si las dos maquinas no lo parten igual, aqui se ve.
		# --lanmesa: el derribo de la MESA del mapa de pruebas, replicado. Escenario fijo y repetible.
		if i == 5 and Net.hosting and "--lanmesa" in OS.get_cmdline_user_args():
			for dx in [-3.0, 3.0]:
				for dz in [-3.0, 3.0]:
					Net.net_explode(world, Vector3(11.0 + dx, 1.35, 11.0 + dz), 1.15, 255)
			print("[lantest] ANFITRION: patas de la mesa reventadas")
		# --lanmesa2: solo las DOS patas del lado -x. Es el caso que decide el modelo de vuelco (el
		# centro de masas se sale del apoyo), asi que es el que de verdad comprueba que la decision de
		# derrumbe se replica y no solo el corte de los voxels.
		if i == 5 and Net.hosting and "--lanmesa2" in OS.get_cmdline_user_args():
			for dz in [-3.0, 3.0]:
				Net.net_explode(world, Vector3(8.0, 1.35, 11.0 + dz), 1.15, 255)
			print("[lantest] ANFITRION: 2 patas del lado -x reventadas (vuelco)")
		if i == 5 and Net.hosting and "--landerribo" in OS.get_cmdline_user_args():
			var centros: PackedVector3Array = world.get_building_centers()
			if not centros.is_empty():
				var mejor: Vector3 = centros[0]
				var bd := INF
				for c in centros:
					var dc := Vector2(c.x - player.global_position.x, c.z - player.global_position.z).length()
					if dc < bd:
						bd = dc
						mejor = c
				for k in range(20):
					var ang := TAU * k / 20.0
					Net.net_explode(world, Vector3(mejor.x + cos(ang) * 9.5, 1.9, mejor.z + sin(ang) * 9.5), 3.4, 255)
				Net.net_explode(world, Vector3(mejor.x, 1.9, mejor.z), 6.0, 255)
				print("[lantest] ANFITRION: derribo del edificio en %.1f,%.1f" % [mejor.x, mejor.z])
		# --lantiro: UN disparo, y al rato OTRO por el mismo sitio. Es el caso que cuenta el jugador:
		# el primero lo ve solo el que dispara y el segundo lo ven los dos. Con un tiro por vez se ve
		# exactamente cual de los dos replica y cual no.
		if i in [5, 8] and Net.hosting and "--lantiro" in OS.get_cmdline_user_args():
			var ojo1: Vector3 = player.global_position + Vector3(0, 1.6, 0)
			# se busca algo a lo que disparar de verdad: la primera direccion que pegue en voxels
			var dir1 := Vector3(1, -0.04, 0).normalized()
			if not _lantiro_dir.is_empty():
				dir1 = _lantiro_dir[0]
			else:
				# se busca un ESCOMBRO: algo que vea la fisica y que NO sea el mapa (el mapa lo ve
				# tambien el rayo de voxels a la misma distancia). Es lo que dispara el jugador.
				var esp0 := get_world_3d().direct_space_state
				for ang in range(0, 360, 3):
					for alt in [-0.25, -0.12, 0.0, 0.12]:
						var d := Vector3(cos(deg_to_rad(ang)), alt, sin(deg_to_rad(ang))).normalized()
						var q0 := PhysicsRayQueryParameters3D.create(ojo1, ojo1 + d * 16.0)
						q0.exclude = [player.get_rid()]
						var h0 := esp0.intersect_ray(q0)
						if h0.is_empty() or h0.get("collider") != null:
							continue          # eso es un jugador o un bot, no un escombro
						var dv0: float = 1e9
						var hv0: Dictionary = world.raycast(ojo1, d, 16.0)
						if hv0.get("hit", false):
							dv0 = float(hv0.distance)
						if dv0 > ojo1.distance_to(h0.position) + 0.5:
							dir1 = d          # la fisica ve algo delante de los voxels: un escombro
							_lantiro_dir.append(d)
							break
					if not _lantiro_dir.is_empty():
						break
			var esp := get_world_3d().direct_space_state
			var q1 := PhysicsRayQueryParameters3D.create(ojo1, ojo1 + dir1 * 40.0)
			q1.exclude = [player.get_rid()]
			var hj1 := esp.intersect_ray(q1)
			var dj1: float = ojo1.distance_to(hj1.position) if hj1 else -1.0
			var hv1: Dictionary = world.raycast(ojo1, dir1, 40.0)
			var tope1: float = 40.0
			if hj1:
				tope1 = minf(tope1, dj1 + 0.10)
			var antes := int(world.get_stats().get("voxels_solid", 0))
			var r1: Dictionary = Net.net_shoot(world, ojo1, dir1, tope1, 200)
			var pimp := ojo1 + dir1 * maxf(0.0, tope1 - 0.10)   # lo que hace fire() con el cascote
			world.carve_body_near(pimp, 0.12 + 0.0015 * 200.0, 255)
			Net.net_escombro(pimp, 0.12 + 0.0015 * 200.0)
			await get_tree().process_frame
			var despues := int(world.get_stats().get("voxels_solid", 0))
			print("[lantiro] t=%ds · fisica %s a %.2f m (colisionador %s) · voxels a %.2f m · tope %.2f · quitados %d · tallas de cuerpo %d" % [
				i + 1, "SI" if hj1 else "no", dj1, str(hj1.get("collider")) if hj1 else "-",
				float(hv1.distance) if hv1.get("hit", false) else -1.0, tope1, antes - despues,
				int(world.get_stats().get("sync_tallas_cuerpo", 0))])
		if i == 8 and Net.hosting and "--lanrafaga" in OS.get_cmdline_user_args():
			var ojo: Vector3 = player.global_position + Vector3(0, 1.6, 0)
			for k in 12:
				var d3 := Vector3(1.0, -0.06 + k * 0.012, 0.10 * sin(k)).normalized()
				Net.net_shoot(world, ojo, d3, 40.0, 200)
			print("[lantest] ANFITRION: rafaga de 12 disparos")
		# --metralla=N: LA METRALLETA DE VERDAD. Lo que conto el usuario no es una rafaga corta contra
		# una pared quieta: es disparar muy rapido MOVIENDO la mira. Cada bala cae donde la anterior ya
		# abrio agujero, asi que lo que una bala encuentra DEPENDE de las balas de antes, y ahi es
		# donde las dos maquinas se pueden separar. Se dispara una bala por cuadro barriendo el punto
		# de mira, que es justo el caso que se le desincronizaba.
		if i == 8 and Net.hosting and _metralla_n() > 0:
			var ojo2: Vector3 = player.global_position + Vector3(0, 1.6, 0)
			var n2: int = _metralla_n()
			var base2: Vector3 = player.global_position
			for k in n2:
				var t2: float = float(k) / float(maxi(1, n2))
				# SE MUEVE Y GIRA MIENTRAS DISPARA, que es como se juega: el usuario lo pidio asi. El
				# ojo se desplaza y la mira barre, o sea que cada bala sale de otro sitio y va a otro
				# lado, y el agujero que abre la de antes le cambia el blanco a la siguiente.
				player.global_position = base2 + Vector3(0.0, 0.0, -1.5 + 3.0 * t2)
				var ojo3: Vector3 = player.global_position + Vector3(0, 1.6, 0)
				var d4 := Vector3(1.0, -0.25 + 0.45 * t2, -0.35 + 0.70 * sin(t2 * 9.0)).normalized()
				player.look_at_point(ojo3 + d4 * 10.0)
				Net.net_shoot(world, ojo3, d4, 40.0, 200)
				await get_tree().process_frame     # una por cuadro, como la cadencia real
			print("[lantest] ANFITRION: metralleta de %d balas barriendo la mira" % n2)
	# LA HUELLA DEL MAPA, chunk a chunk: con esto se compara de verdad, no solo el total
	if world.has_method("resumen_chunks"):
		var lineas := PackedStringArray()
		for fila in world.resumen_chunks():
			lineas.append("%d %d %d %d" % [fila[0], fila[1], fila[2], fila[3]])
		lineas.sort()
		var f := FileAccess.open("user://huella_%s.txt" % ("host" if Net.hosting else "cliente"), FileAccess.WRITE)
		if f:
			f.store_string("
".join(lineas))
			f.close()
			print("[lantest] huella escrita: %d chunks" % lineas.size())
	print("[lantest] %s FIN" % role)
	get_tree().quit()


## Cuantas balas pide `--metralla=N` (0 = la prueba esta apagada).
func _metralla_n() -> int:
	for f in OS.get_cmdline_user_args():
		if String(f).begins_with("--metralla="):
			return int(String(f).substr(11))
	return 0


## Mueve al jugador local por su cuenta (sólo para las pruebas de red): camina, gira y dispara,
## para poder comprobar desde el otro equipo que el avatar remoto anima y dispara de verdad.
var _lanwalk_tiro := 0.0
var _fis_t := 0.0
var _fis_hitos := {}
# --mesatest=N: patas que volar en la MESA del mapa de pruebas. -1 = la prueba esta apagada.
var _mesatest_n: int = _leer_mesatest()
var _mesa_sonda := 0

func _leer_mesatest() -> int:
	for a in OS.get_cmdline_user_args():
		if String(a).begins_with("--mesatest="):
			return clampi(int(String(a).split("=")[1]), 0, 4)
	return -1

func _lan_walk() -> void:
	var t2 := 0.0
	while is_instance_valid(player):
		await get_tree().process_frame
		t2 += get_process_delta_time()
		Input.action_press("move_forward")
		if fmod(t2, 6.0) < 3.0:
			Input.action_press("sprint")
		else:
			Input.action_release("sprint")
		player.look.x = wrapf(player.look.x + 0.55 * get_process_delta_time(), -PI, PI)
		# DISPARANDO DE VERDAD. Pulsar la accion no bastaba (el banco no pasa por el mismo camino que
		# el raton) y el compañero no veia un solo tiro: `disparos=0` en el informe.
		if t2 - _lanwalk_tiro > 0.35:
			_lanwalk_tiro = t2
			if player.has_method("fire"):
				player.set_ammo(player.current, maxi(int(player.ammo[player.current]), 5))
				player.fire()


## Crea la C4 plantada. Lo llama net.gd en TODOS los equipos con la misma transformada, asi que
## la bomba esta en el mismo sitio para todos y la cuenta atras arranca a la vez.
## Cada bando aparece en SU base: los terroristas en el spawn del mapa (donde nace la C4) y la
## policia en el suyo, que viene en el .sites.json de cada mapa (ct_spawn). Antes todos aparecian
## en el mismo sitio, asi que elegir bando no cambiaba donde nacias.
## EN EL ATRACO SE REAPARECE ALREDEDOR DEL OBJETIVO, no en la base. Naciendo en la base te tocaba
## cruzar el mapa entero cada vez que te mataban, y para cuando llegabas el cubo ya estaba ingresado:
## morir te dejaba fuera de la partida de hecho. Alrededor del cubo vuelves al tiroteo, pero nunca
## encima de el (nada de reaparecer y robarlo en el sitio): ANILLO_MIN es lo que hay que correr.
##
## Devuelve ZERO si no hay atraco o si no se encuentra suelo, y entonces quien llama sigue con su base.
const ANILLO_MIN := 22.0
const ANILLO_MAX := 42.0

func punto_reaparicion_atraco() -> Vector3:
	# EN LA CAMPAÑA se vuelve en el ultimo refugio alcanzado (o en la azotea de salida)
	if pve != null and is_instance_valid(pve) and pve.has_method("punto_control"):
		var pc: Vector3 = pve.punto_control()
		if pc != Vector3.ZERO:
			return pc + Vector3(randf_range(-1.5, 1.5), 0.0, randf_range(-1.5, 1.5))
	if not is_instance_valid(heist):
		return Vector3.ZERO
	var centro := Vector3.ZERO
	if heist.cube != null and is_instance_valid(heist.cube):
		centro = heist.cube.global_position
	elif heist.vault != null and is_instance_valid(heist.vault):
		centro = heist.vault.global_position
	else:
		return Vector3.ZERO
	# angulos al azar y sin orden: si se barriera el circulo de 0 a 360 siempre saldria por el este
	var angulos: Array = []
	for i in 12:
		angulos.append(TAU * float(i) / 12.0 + randf_range(-0.26, 0.26))
	angulos.shuffle()
	for a in angulos:
		var r: float = randf_range(ANILLO_MIN, ANILLO_MAX)
		var p := Vector3(centro.x + cos(a) * r, centro.y, centro.z + sin(a) * r)
		var g: Vector3 = _ground_near(p)
		if g.y < 0.0:
			continue                       # sin suelo: fuera del mapa o sobre el vacio
		var sitio := g + Vector3(0, 0.6, 0)
		if not _room_free(sitio):
			continue                       # dentro de un muro o de un mueble
		return sitio
	return Vector3.ZERO


var _carga_hasta_salida := false

func _quitar_carga_salida() -> void:
	if not _carga_hasta_salida:
		return
	_carga_hasta_salida = false
	if hud:
		hud.set_loading(false)


func spawn_at_team_base(team: String) -> void:
	if "--fotoscarga" in " ".join(OS.get_cmdline_user_args()):
		print("[entrada] %d ms: salida del equipo %s (carga puesta: %s)" % [Time.get_ticks_msec(), team, str(_carga_hasta_salida)])
	if _carga_hasta_salida:
		# ya en la salida buena: la pantalla de carga se va medio segundo despues, con los bots ya puestos y la luz del
		# mapa (la tarde de la cafeteria) ya aplicada: si no, se veia la base vacia y con otro color un instante
		get_tree().create_timer(0.5).timeout.connect(_quitar_carga_salida)
	var p := Vector3.ZERO
	if bases_equipo.has(team):
		p = bases_equipo[team]
	elif team == Net.TEAM_CT and ct_spawn != Vector3.ZERO:
		p = ct_spawn
	elif team == Net.TEAM_T and t_spawn != Vector3.ZERO:
		p = t_spawn      # en duelo a muerte los terroristas tambien tienen base propia
	else:
		p = world.get_spawn_position()
	# DUELO TODOS CONTRA TODOS: cada uno sale solo, en el punto mas alejado de todos (sin asiento de compañeros)
	if dm_mode and Net.es_dm_todos():
		player.global_position = _sitio_libre(_salida_todos(team) + Vector3(0, 0.6, 0))
		player.velocity = Vector3.ZERO
		world.set_player_position(player.global_position)
		player.check_bomb_spawn_rule()
		return
	# DUELO A MUERTE CON PUNTOS DE REAPARICION (los trae el .dm.json): la primera vez, en la base con el equipo;
	# despues, en el punto del propio lado mas alejado de los rivales.
	if dm_mode and dm_salidas.has(team) and not bases_equipo.has(team):
		if _dm_ya_salio:
			p = _salida_dm(team)
		_dm_ya_salio = true
	# SEPARACION ENTRE COMPAÑEROS, para no nacer unos dentro de otros.
	#
	# El asiento se saca de los NUMEROS DE JUGADOR ORDENADOS, no del orden en que entraron. Antes se
	# recorria la lista tal cual y se paraba al llegar al mio, contando solo a los que ya tuvieran
	# equipo: si el otro todavia no lo tenia asignado -y con el reparto automatico eso pasa justo en
	# ese instante- los dos sacaban asiento 0, nacian EN EL MISMO SITIO y se empujaban sin parar hasta
	# que uno se apartaba. Lo conto el usuario jugando en LAN.
	#
	# Ordenando por numero, cada uno saca un asiento distinto y todos calculan lo mismo.
	var seat := 0
	if Net.is_online():
		var companeros: Array = []
		for id in Net.players.keys():
			var eq := String(Net.players[id].get("team", ""))
			if eq == team or eq == "":      # los que aun no tienen bando tambien ocupan sitio
				companeros.append(int(id))
		companeros.sort()
		seat = maxi(0, companeros.find(multiplayer.get_unique_id()))
	var ang := TAU * float(seat) / 6.0
	var off := Vector3(cos(ang), 0, sin(ang)) * (1.2 * float(seat))
	player.global_position = _sitio_libre(p + off + Vector3(0, 0.6, 0))
	player.velocity = Vector3.ZERO
	world.set_player_position(player.global_position)
	player.check_bomb_spawn_rule()


## UN SITIO DONDE NO HAYA NADIE.
##
## El asiento reparte a los que nacen a la vez, pero no cubre lo demas: reaparecer encima de alguien
## que ya estaba ahi, o dos que vuelven a la vez tras una ronda. Dos personajes solapados se empujan
## el uno al otro sin parar -es la fisica haciendo su trabajo- y hay que apartarse para que cese.
##
## Se mira alrededor en circulos y se coge el primer hueco. Si no hay ninguno se devuelve el sitio de
## partida: mejor empujarse un momento que aparecer dentro de una pared.
## LOS BOTS TAMBIEN OCUPAN SITIO. Lo conto el usuario: "los bot aparecen pegados, 2 pegados; uno
## camina y el otro queda pegado en su espalda". Es que nacian en el MISMO punto: los puestos de un
## sitio de bomba se sorteaban con `randi()` sin mirar si ya habia alguien, asi que con cuatro
## puestos y cinco bots dos caian encima. Y a diferencia de las personas, los bots no se empujan
## -se mueven sobre la rejilla de voxels, sin fisica-, asi que no se separan NUNCA por si solos:
## se quedan uno dentro de otro hasta que uno se va andando.
func _sitio_libre(deseado: Vector3) -> Vector3:
	var ocupados: Array = []
	for r in Net.remotes.values():
		if is_instance_valid(r):
			ocupados.append(r.global_position)
	if enemies != null:
		for e in enemies.get_children():
			if is_instance_valid(e) and e is Node3D:
				ocupados.append(e.global_position)
	if ocupados.is_empty():
		return deseado
	# UN HUECO SIN SUELO NO ES UN HUECO. Apartarse de un compañero no puede acabar en el vacio: en el
	# banco los dos jugadores aparecieron, se cayeron y murieron nada mas empezar.
	var libre := func(punto: Vector3) -> bool:
		for o in ocupados:
			if Vector2(punto.x - o.x, punto.z - o.z).length() < 1.1:
				return false
		if world == null or not world.has_method("raycast"):
			return true
		var abajo: Dictionary = world.raycast(punto + Vector3(0, 0.2, 0), Vector3.DOWN, 4.0)
		return bool(abajo.get("hit", false))
	if libre.call(deseado):
		return deseado
	for anillo in range(1, 4):
		for k in 8:
			var a := TAU * float(k) / 8.0
			var q := deseado + Vector3(cos(a), 0, sin(a)) * (1.3 * float(anillo))
			if libre.call(q):
				return q
	return deseado


