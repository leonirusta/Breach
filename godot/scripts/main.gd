	if "--sinnocheazar" in args or night:
		return
	if current_map in MAPAS_SIN_LLUVIA or current_map in MAPAS_SIN_NOCHE or current_map in Settings.MAPAS_PVE or Settings.tutorial_activo:
		return
	if FileAccess.file_exists("res://maps/%s.campana.json" % current_map):
		return
	var noche: bool
	if Net.is_online() and Net.semilla_partida != 0:
		noche = Net.semilla_noche(int(Net.semilla_partida), PROB_NOCHE)
	else:
		noche = randf() < PROB_NOCHE
	if not noche and not ("--nochesiempre" in args):
		return
	_noche_partida = true
	_faroles_tarde = true          # de noche los faroles alumbran (de tarde, en la cafeteria, no)
