## LA BARRA DE VIDA NO SE PUEDE BORRAR AL RECIBIR UN TIRO. Medida que no engana el grano ni el tinte:
## cuantos pixeles ROJOS DE LA BARRA (rojo saturado, que el mundo casi nunca tiene) hay en su zona.
##   1. tranquilo
##   2. herido y girando, con el ORDEN VIEJO: la aberracion puesta a mano justo encima de la barra y sin
##      su copia de pantalla, como estaba antes del arreglo
##   3. herido y girando, con el orden nuevo
## Si la aberracion era la culpable, el 2 se queda sin rojo y el 3 lo conserva.
func _vida_test() -> void:
	await get_tree().create_timer(4.0).timeout
	if team_overlay != null:
		Net.choose_team(Net.TEAM_T)
		_close_team_select()
	await get_tree().create_timer(2.0).timeout
	player.invulnerable = true
	var barra: Control = hud.health_bar
	var xf := barra.get_global_transform()
	var a: Vector2 = xf * Vector2.ZERO
	var b: Vector2 = xf * barra.size
	var zona := Rect2i(Vector2i(int(a.x) + 2, int(a.y) + 1), Vector2i(maxi(int(b.x - a.x) - 4, 1), maxi(int(b.y - a.y) - 2, 1)))
	print("[vida] barra de vida en %s" % str(zona))
	var rojo := func(img: Image) -> float:
		var si := 0
		var n := 0
		for y in range(zona.position.y, zona.position.y + zona.size.y):
			for x in range(zona.position.x, zona.position.x + zona.size.x, 2):
				var c := img.get_pixel(x, y)
				n += 1
				if c.r > 0.45 and c.r > c.g * 1.8 and c.r > c.b * 1.8:
					si += 1
		return float(si) / maxf(float(n), 1.0)
	var forzar := func() -> void:
		hud.set_motion_blur(Vector2(0.012, 0.0))
		hud.damage_t = 0.6
	for i in 4:
		await RenderingServer.frame_post_draw
	var img1 := get_viewport().get_texture().get_image()
	print("[vida] 1. tranquilo: %.0f %% de rojo de barra" % (rojo.call(img1) * 100.0))
	# 2. ORDEN VIEJO
	var copia: BackBufferCopy = hud.aberration_copia
	var idx_ab: int = hud.aberration.get_index()
	var idx_copia: int = copia.get_index() if copia else -1
	if copia:
		hud.root.remove_child(copia)
	hud.root.move_child(hud.aberration, hud.health_bar.get_index() + 1)
	RenderingServer.frame_pre_draw.connect(forzar)
	await get_tree().create_timer(0.5).timeout
	for i in 4:
		await RenderingServer.frame_post_draw
	var img2 := get_viewport().get_texture().get_image()
	RenderingServer.frame_pre_draw.disconnect(forzar)
	print("[vida] 2. herido, ORDEN VIEJO: %.0f %% de rojo de barra · aberracion visible %s" % [rojo.call(img2) * 100.0, str(hud.aberration.visible)])
	# 3. ORDEN NUEVO
	if copia:
		hud.root.add_child(copia)
		hud.root.move_child(copia, idx_copia)
	hud._efectos_orden()
	hud.damage_t = 0.0
