func _cartas_efecto_test() -> void:
	await get_tree().create_timer(6.0).timeout
	var ok := true
	var mira := func(nombre: String, real: float, esperado: float) -> void:
		var bien := absf(real - esperado) < 0.01
		print("[cartasefecto] %s %s: %.3f (esperado %.3f)" % ["ok  " if bien else "MAL ", nombre, real, esperado])
		if not bien:
			ok = false
	var guardadas: Dictionary = Settings.cartas.duplicate(true)
	var equipadas: Array = Settings.cartas_equipadas.duplicate()
	Cuenta.perfil = {}
	Cuenta.token = ""
	var ids := ["vampiro", "rescatista", "definitiva", "blindaje", "piel_dura"]
	Settings.cartas = {}
	for id in ids:
		Settings.cartas[id] = {"n": 10, "c": 0}
	Settings.cartas_equipadas = ids.duplicate()
	player._leer_cartas()
	var v_vamp: float = Cartas.valor_a("vampiro", 10)
	var v_resc: float = Cartas.valor_a("rescatista", 10)
	var v_def: float = Cartas.valor_a("definitiva", 10)
	var v_bli: float = Cartas.valor_a("blindaje", 10)
	var v_piel: float = Cartas.valor_a("piel_dura", 10)
	print("[cartasefecto] nivel 10: vampiro %.1f, rescatista %.2f, definitiva %.3f, blindaje %.2f, piel dura %.2f" % [v_vamp, v_resc, v_def, v_bli, v_piel])
	player.invulnerable = false
	player.armor = 0.0
	player.casco = 0.0
	# BLINDAJE / PIEL DURA / sin tipo
	var golpe := func(tipo: String) -> float:
		player.health = 100.0
		player.golpe_tipo = tipo
		player.take_damage(40.0, Vector3.ZERO)
		return 100.0 - float(player.health)
	var sin_tipo: float = golpe.call("")
	mira.call("explosion/caida sin rebaja (40 de daño, con el nivel del personaje)", sin_tipo, sin_tipo)
	mira.call("BLINDAJE: bala", golpe.call("bala"), sin_tipo * (1.0 - v_bli))
	mira.call("PIEL DURA: cuerpo a cuerpo", golpe.call("cuerpo"), sin_tipo * (1.0 - v_piel))
	mira.call("el tipo se gasta en un golpe", golpe.call(""), sin_tipo)
	# por la red, como llega el daño de otro jugador (Net._aplicar_dano: el empujon decide)
	player.health = 100.0
	Net._aplicar_dano(40.0, Vector3(0, 0, 3.2), 0, false)
	mira.call("por red, bala (empuje 3,2)", 100.0 - float(player.health), sin_tipo * (1.0 - v_bli))
	player.health = 100.0
	Net._aplicar_dano(40.0, Vector3(0, 0, 24.0), 0, false)
	mira.call("por red, mazo (empuje 24)", 100.0 - float(player.health), sin_tipo * (1.0 - v_piel))
	player.health = 100.0
	Net._hit(40.0, Vector3.ZERO, "cuerpo")
	mira.call("por red, zarpazo (_hit cuerpo)", 100.0 - float(player.health), sin_tipo * (1.0 - v_piel))
	# VAMPIRO
	player.health = 30.0
	player.carta_baja()
	mira.call("VAMPIRO: 30 de vida + una baja", float(player.health), minf(30.0 + v_vamp, player.vida_max()))
	# RECARGA DE DEFINITIVA
	var hab = player._hab
	if hab != null:
		hab.recarga_total = 25.0
		hab.recarga = 25.0
		player.carta_baja()
		mira.call("DEFINITIVA: una baja (s de recarga que quedan)", float(hab.recarga), 25.0 - (hab.CARGA_BAJA + v_def) * 25.0)
		hab.recarga = 25.0
		player.carta_asistencia()
		mira.call("DEFINITIVA: una asistencia", float(hab.recarga), 25.0 - v_def * 25.0)
		hab.recarga = 25.0
		var LogrosS := preload("res://scripts/logros.gd")
		LogrosS.limpiar()
		LogrosS.dano("Rival")
		LogrosS.feed("Otro", "Rival")
		mira.call("DEFINITIVA: asistencia por el registro de bajas (logros)", float(hab.recarga), 25.0 - v_def * 25.0)
		hab.recarga = 0.0
	else:
		print("[cartasefecto] MAL  el jugador no tiene habilidad")
		ok = false
	# RESCATISTA
	mira.call("RESCATISTA: la RCP dura (s)", 4.5 / (1.0 + float(player.carta_rescatista())), 4.5 / (1.0 + v_resc))
	player.spectating = true
	player.revivir_aqui(player.global_position, v_resc)
	mira.call("RESCATISTA: el levantado vuelve con (fraccion de vida)", float(player.health) / player.vida_max(), 0.5 + v_resc * 0.5)
	var resc = get_tree().get_first_node_in_group("rescate")
	if resc:
		resc.aplicar("rcp|1.234", 0, "p999", Vector3.ZERO)
		mira.call("RESCATISTA: la duracion viaja con la accion de red", float(resc._rcp_dura.get("p999", 0.0)), 1.234)
		resc.aplicar("rcp_fin", 0, "p999", Vector3.ZERO)
	# lo de antes, como estaba
	Settings.cartas = guardadas
	Settings.cartas_equipadas = equipadas
	Cartas.refrescar()
	print("[cartasefecto] %s" % ("TODO BIEN" if ok else "HAY FALLOS"))
	get_tree().quit(0 if ok else 1)


