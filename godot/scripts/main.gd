func _dm_casi_tick() -> void:
	if dm_mode and Net.es_dm_todos() and Engine.get_physics_frames() % 20 == 0:
		_dm_primero_tick()
	if not dm_mode or Net.es_dm_todos() or Engine.get_physics_frames() % 20 != 0:
		return
	for eq in dm_bajas.keys():
		var n := int(dm_bajas[eq])
