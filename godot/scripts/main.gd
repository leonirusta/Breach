## --pasapuertas: SE PUEDE CRUZAR CADA PUERTA ANDANDO. El jugador se pone a 2,5 m delante de la puerta,
## mirandola, y anda hacia delante (la tecla de verdad) 4 s: cuenta como cruzada si acaba al otro lado.
## Se prueban las N primeras puertas del mapa y se listan las que no se dejan pasar, con lo que hay en medio.
func _pasa_puertas_test() -> void:
	for i in 120:
		await get_tree().physics_frame
	# EL SALTO DEL BR MANDA SOBRE EL JUGADOR: sin quitarlo, esta prueba movia a un jugador que seguia
	# dentro del avion a 168 m de altura y salian todas las puertas como "no se puede pasar".
	if is_instance_valid(salto_br):
		salto_br.queue_free()
	player.br_control = null
	player.invulnerable = true
	player.velocity = Vector3.ZERO
	if player.health <= 0.0:
		player.health = player.vida_max()
	var n := 0
	var pasan := 0
	var malas: Array = []
	var lista: Array = puertas.puertas if is_instance_valid(puertas) else []
	var desde := 0
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--desde="):
			desde = int(a.substr(8))
	for k in range(desde, lista.size(), maxi(1, lista.size() / 30)):
		var pu = lista[k]
		if not is_instance_valid(pu) or pu.caida:
			continue
		n += 1
		var datos := "%s, %s, ancho %.2f alto %.2f, en %s" % [pu.tipo, "doble" if pu.doble else "simple", pu.ancho, pu.alto, str(pu.global_position)]
		var xf: Transform3D = pu.global_transform
		var fz: Vector3 = pu.global_transform.basis.z
		var lado := 1.0 if k % 2 == 0 else -1.0
		var ini: Vector3 = pu.global_position + fz * 2.5 * lado + Vector3(0, 0.2, 0)
		player.global_position = ini
		player.velocity = Vector3.ZERO
		var hacia: Vector3 = -fz * lado
		player.look = Vector2(atan2(-hacia.x, -hacia.z), 0.0)
		player.rotation.y = player.look.x
		for i in 5:
			await get_tree().physics_frame
		Input.action_press("move_forward")
		for i in 240:
			await get_tree().physics_frame
		Input.action_release("move_forward")
		var l: Vector3 = xf.affine_inverse() * player.global_position
		var cayo: bool = not is_instance_valid(pu) or pu.caida
		if l.z * lado < -0.5:
			pasan += 1
		else:
			var r: Dictionary = world.raycast(ini + Vector3(0, 1.0, 0), hacia, 5.0)
			var q := PhysicsRayQueryParameters3D.create(ini + Vector3(0, 1.0, 0), ini + Vector3(0, 1.0, 0) + hacia * 5.0)
			q.exclude = [player.get_rid()]
			var h := get_world_3d().direct_space_state.intersect_ray(q)
			malas.append("puerta %d (%s%s): se queda a z=%.2f · jugador en %s vida %.0f espectando %s br %s · voxel delante a %s · fisica: %s" % [
				k, datos, ", SE CAYO" if cayo else "", l.z * lado, str(player.global_position), player.health, str(player.spectating),
				str(player.br_control != null),
				("%.2f m" % float(r.distance)) if r.get("hit", false) else "nada",
				(str(h.collider) + " a %.2f m" % ini.distance_to(h.position)) if h else "nada"])
	print("[pasapuertas] %d de %d puertas se cruzan andando" % [pasan, n])
	for m in malas:
		print("[pasapuertas]   NO: " + m)
	get_tree().quit()


func _foto_prueba(nombre: String) -> void:
	await RenderingServer.frame_post_draw
	var img := get_viewport().get_texture().get_image()
	var ruta := "user://%s.png" % nombre
	img.save_png(ruta)
	var st: Dictionary = world.get_stats()
	print("[pruebasalto] foto %s · %d fps · tris visibles %d" % [ProjectSettings.globalize_path(ruta), Engine.get_frames_per_second(),
		int(st.get("visible_tris", st.get("tris_visible", -1)))])

var agua = null                   ## agua.gd (o null)
var puertas = null                ## puertas.gd
var botin = null                  ## botin.gd
var vehiculos = null              ## vehiculos.gd (coches, motos y el helicoptero)
var inventario = null             ## inventario_br.gd (solo en battle royale)
## El mapa trae botin: se sale con poca municion, cada uno nace en un sitio distinto y al morir se
## pierde lo recogido. Es lo que convierte un mapa normal en uno de "buscar y sobrevivir".
var hay_botin := false


func _montar_extras_mapa() -> void:
	for n in [agua, puertas, botin, vehiculos]:
		if is_instance_valid(n):
			n.queue_free()
	agua = null
	puertas = null
	botin = null
	vehiculos = null
	hay_botin = false
	if current_map == "city":
		return
	if FileAccess.file_exists(AguaScript.ruta(current_map)):
		var a = AguaScript.new()
		a.name = "Agua"
		add_child(a)
		if a.cargar(current_map, world):
			agua = a
			a.set_calidad(Settings.gfx_value("agua", quality) > 0)
		else:
			a.queue_free()
	if FileAccess.file_exists(PuertasScript.ruta(current_map)):
		var pu = PuertasScript.new()
		pu.name = "Puertas"
		add_child(pu)
		if pu.cargar(current_map, world, self):
			puertas = pu
		else:
			pu.queue_free()
	if FileAccess.file_exists(BotinScript.ruta(current_map)):
		var b = BotinScript.new()
		b.name = "Botin"
		add_child(b)
		if b.cargar(current_map, world, self):
			botin = b
			hay_botin = true
		else:
			b.queue_free()
	if FileAccess.file_exists(VehiculosScript.ruta(current_map)):
		var ve = VehiculosScript.new()
		ve.name = "Vehiculos"
		add_child(ve)
		if ve.cargar(current_map, world, self):
			vehiculos = ve
		else:
			ve.queue_free()
	# LA CORTINA DEL BATTLE ROYALE. Entre que arranca la partida y despega el avion pasan unos segundos
	# en los que el jugador esta plantado en el suelo y el mundo AUN NO ESTA MALLADO: lo unico que se
	# dibuja es la lamina de agua, y la pantalla se ve azul ("antes que empiece el avion se ve como
	# agua"). Se tapa desde el primer momento y la quita el avion al despegar.
	if Settings.es_battle_royale(current_map):
		cortina_br(true)
	# EL INVENTARIO es cosa del battle royale: en bomba o en oleadas no hay nada que ordenar.
	if is_instance_valid(inventario):
		inventario.queue_free()
		inventario = null
	if Settings.es_battle_royale(current_map) and is_instance_valid(player):
		var inv = InventarioScript.new()
		inv.name = "InventarioBR"
		add_child(inv)
		inv.montar(self, player)
		inventario = inv
	# POCA MUNICION DE SALIDA: un cargador de reserva por arma. La municion de verdad esta en el suelo.
	# Se aplica despues, cuando main rehace las ranuras (refresh_ammo_slots lee este valor).
	if is_instance_valid(player):
		player.reserva_cargadores = 1 if hay_botin else -1


## ¿Esta este punto en el fondo del agua? (sin agua en el mapa, nunca)
func _bajo_agua(p: Vector3) -> bool:
	return is_instance_valid(agua) and agua.profundidad(p + Vector3(0, 0.1, 0)) > 0.6


## Los puntos de salida del mapa (cabecera del .vxmap) que no estan bajo el agua. El 0 tambien vale: en
## un mapa de botin no hay base de nadie.
func _puntos_aparicion() -> Array:
	var out: Array = []
	if world == null or not world.has_method("get_spawn_points"):
		return out
	for q in world.get_spawn_points():
		if not _bajo_agua(q):
			out.append(q)
	return out


## DONDE NACE CADA UNO AL EMPEZAR. Todos aparecian en `get_spawn_position()`, el mismo punto para todos:
## en un mapa de quinientos metros hecho para buscar botin y encontrarse por el camino, eso era empezar
## la partida en un tiroteo. Cada jugador coge un punto distinto: el asiento sale de los numeros de
## jugador ORDENADOS (igual en todas las maquinas, como en spawn_at_team_base) y el arranque de la lista
## de la semilla de la partida, asi que cada partida se empieza en sitios distintos.
func _aparicion_inicial() -> Vector3:
	var pts := _puntos_aparicion()
	if pts.size() < 2:
		return Vector3.ZERO
	var asiento := 0
	if Net.is_online():
		var ids: Array = []
		for id in Net.players.keys():
			ids.append(int(id))
		ids.sort()
		asiento = maxi(0, ids.find(multiplayer.get_unique_id()))
	var base: int = (Net.semilla_partida if Net.is_online() else randi()) & 0xffff
	# paso grande y primo con casi cualquier tamaño de lista: dos asientos seguidos caen lejos
	var i: int = (base + asiento * 7) % pts.size()
	return _ground_near(pts[i])


## AL REAPARECER EN UN MAPA CON BOTIN: el punto de salida mas alejado de todos los demas personajes, de
## entre unos cuantos al azar. Nada de volver al mismo sitio ni al lado de quien te acaba de matar.
## ZERO si el mapa no tiene botin o no trae puntos (y entonces el jugador sigue con lo de siempre).
func punto_aparicion_suelto() -> Vector3:
	if not hay_botin:
		return Vector3.ZERO
	var pts := _puntos_aparicion()
	# CON ZONA, SE REAPARECE DENTRO: reaparecer fuera del muro era volver a morir a los pocos segundos
	if zona_br != null and is_instance_valid(zona_br) and zona_br.en_marcha:
		var dentro_z: Array = pts.filter(func(q): return zona_br.dentro(q, 6.0))
		if not dentro_z.is_empty():
			pts = dentro_z
		else:
			var c: Vector3 = zona_br.muro()
			var g: Vector3 = world.find_ground(Vector3(c.x, 0.0, c.z))
			if g.y > 0.0:
				pts = [g]
	if pts.is_empty():
		return Vector3.ZERO
	var otros: Array = []
	for r in Net.remotes.values():
		if is_instance_valid(r):
			otros.append(r.global_position)
	for e in enemies.get_children():
		if e is Node3D and is_instance_valid(e):
			otros.append(e.global_position)
	var mejor: Vector3 = pts[randi() % pts.size()]
	var mejor_d := -1.0
	for k in mini(8, pts.size()):
		var q: Vector3 = pts[randi() % pts.size()]
		var d := INF
		for o in otros:
			d = minf(d, Vector2(q.x - o.x, q.z - o.z).length())
		if d > mejor_d:
			mejor_d = d
			mejor = q
	return _sitio_libre(_ground_near(mejor) + Vector3(0, 0.6, 0))


## --pruebaisla: carga el mapa (el que se pida con --map=), cuenta lo que han montado agua.json,
## puertas.json y botin.json, y comprueba lo basico de cada cosa moviendo al jugador: que flota en el
## agua, que una puerta se abre al acercarse y que un botin se recoge. Imprime OK/FALLO por cada cosa.
func _prueba_isla() -> void:
	for i in 90:
		await get_tree().physics_frame
	var fallos := 0
	var linea := func(ok: bool, que: String) -> void:
		print("[pruebaisla] %s  %s" % ["OK   " if ok else "FALLO", que])
	print("[pruebaisla] mapa %s · mundo %s · voxel %.3f m · spawn %s · %d puntos de salida" % [
		current_map, str(world.get_world_size()), world.get_voxel_size(), str(world.get_spawn_position()),
		world.get_spawn_points().size()])
	print("[pruebaisla] agua %s · puertas %d · botin %d puntos (%d con algo) · reserva de salida %d cargador(es)" % [
		"si" if is_instance_valid(agua) else "no",
		puertas.puertas.size() if is_instance_valid(puertas) else 0,
		botin.puntos.size() if is_instance_valid(botin) else 0,
		botin.cuantos_quedan() if is_instance_valid(botin) else 0,
		player.reserva_cargadores])
	player.invulnerable = true
	# 0) LO QUE CUESTAN parados (el gestor de puertas y el del botin), en 300 ticks de fisica
	var cp0: int = int(Prof.acc.get("puertas", 0))
	var cb0: int = int(Prof.acc.get("botin", 0))
	for i in 300:
		await get_tree().physics_frame
	print("[pruebaisla] coste medio: puertas %.3f ms/tick · botin %.3f ms/tick (peor %.2f / %.2f ms)" % [
		(int(Prof.acc.get("puertas", 0)) - cp0) / 300000.0, (int(Prof.acc.get("botin", 0)) - cb0) / 300000.0,
		int(Prof.peor.get("puertas", 0)) / 1000.0, int(Prof.peor.get("botin", 0)) / 1000.0])
	# 1) AGUA: un sitio con agua de verdad (mas de dos metros hasta el fondo), soltado desde arriba
	var agua_p := Vector3.ZERO
	var agua_s := -INF
	if is_instance_valid(agua):
		var p0 := Vector3.ZERO
		var sup := -INF
		var candidatos: Array = []
		for c in agua.cuerpos:
			var r: Rect2 = c["rect"]
			candidatos.append(Vector3(r.get_center().x, 0.0, r.get_center().y))
		if agua.mar_y > -INF:
			# el mar: de cada borde del rectangulo jugable hacia dentro, hasta dar con agua honda
			var lim: Rect2 = agua.limite if agua.hay_limite else Rect2(Vector2.ZERO, Vector2(world.get_world_size().x, world.get_world_size().z))
			for k in 12:
				var f: float = 2.0 + float(k) * 4.0
				candidatos.append(Vector3(lim.position.x + f, 0.0, lim.get_center().y))
				candidatos.append(Vector3(lim.end.x - f, 0.0, lim.get_center().y))
				candidatos.append(Vector3(lim.get_center().x, 0.0, lim.position.y + f))
				candidatos.append(Vector3(lim.get_center().x, 0.0, lim.end.y - f))
		for q in candidatos:
			var s_q: float = agua.superficie_en(q.x, q.z)
			var fondo_q: Dictionary = world.raycast(Vector3(q.x, s_q + 0.02, q.z), Vector3.DOWN, 60.0)
			if bool(fondo_q.get("hit", false)) and float(fondo_q["position"].y) < s_q - 2.0:
				p0 = q
				sup = s_q
				break
		if sup == -INF:
			print("[pruebaisla] no encuentro agua con mas de 2 m de fondo")
		agua_p = p0
		agua_s = sup
		player.global_position = Vector3(p0.x, sup + 1.5, p0.z)
		player.velocity = Vector3.ZERO
		world.set_player_position(player.global_position)
		for i in 150:
			await get_tree().physics_frame
		var pies: float = player.global_position.y
		var ojos: float = pies + 1.45
		var flota: bool = player.nadando and ojos > sup and pies < sup - 0.9
		print("[pruebaisla] superficie %.2f · pies %.2f · ojos %.2f · nadando %s" % [sup, pies, ojos, str(player.nadando)])
		linea.call(flota, "flota con la cabeza fuera del agua")
		fallos += 0 if flota else 1
		# con ventana, una foto nadando (para mirarla a ojo: el shader solo se compila con renderizador)
		if DisplayServer.get_name() != "headless":
			player.look = Vector2(0.6, -0.25)
			for i in 20:
				await get_tree().process_frame
			get_viewport().get_texture().get_image().save_png("user://pruebaisla_agua.png")
			print("[pruebaisla] foto nadando: %s" % ProjectSettings.globalize_path("user://pruebaisla_agua.png"))
		# bucear: agachado se hunde y la camara queda bajo el agua (tinte + sonido amortiguado)
		Input.action_press("crouch")
		for i in 60:
			await get_tree().physics_frame
		await get_tree().process_frame
		var hundido: bool = agua.esta_submarino()
		Input.action_release("crouch")
		linea.call(hundido, "agachado bucea y la camara queda bajo el agua")
		fallos += 0 if hundido else 1
		for i in 90:
			await get_tree().physics_frame
		# el rayo de las balas no ve el agua: desde encima de la lamina hacia abajo tiene que dar en el fondo
		var rr: Dictionary = world.raycast(Vector3(p0.x, sup + 1.0, p0.z), Vector3.DOWN, 30.0)
		var fondo_ok: bool = bool(rr.get("hit", false)) and float(rr["position"].y) < sup
		linea.call(fondo_ok, "world.raycast atraviesa el agua y da en el fondo")
		fallos += 0 if fondo_ok else 1
		# el limite: empujado fuera del rectangulo jugable, vuelve a su borde
		if agua.hay_limite:
			var fuera := Vector3(agua.limite.position.x - 6.0, player.global_position.y + 0.5, agua.limite.get_center().y)
			player.global_position = fuera
			for i in 5:
				await get_tree().physics_frame
			var dentro: bool = agua.dentro_limite(player.global_position)
			linea.call(dentro, "el limite del mapa devuelve al jugador dentro")
			fallos += 0 if dentro else 1
	else:
		linea.call(false, "el mapa no trae agua.json")
		fallos += 1
	# 2) PUERTA: a 1,6 m por delante de la primera, y a esperar
	if is_instance_valid(puertas) and not puertas.puertas.is_empty():
		var pu = puertas.puertas[0]
		var ante: Vector3 = pu.to_global(Vector3(0, 0.1, 1.6))
		player.global_position = ante
		player.velocity = Vector3.ZERO
		world.set_player_position(ante)
		for i in 50:
			await get_tree().physics_frame
		var abierta: bool = is_instance_valid(pu) and absf(pu.abierta) > 0.95
		print("[pruebaisla] puerta 0 en %s: abierta %.2f, marco %d/%d sondas, cuerpo %s · jugador en %s (vida %.0f, espectando %s)" % [
			str(pu.global_position), pu.abierta, pu.sondas_solidas(world), pu.sondas_iniciales, str(pu.tiene_cuerpo()),
			str(player.global_position), player.health, str(player.spectating)])
		linea.call(abierta, "la puerta se abre al acercarse")
		fallos += 0 if abierta else 1
		# se abre hacia el lado contrario: la hoja no puede quedar en el lado del jugador
		var hoja_lejos: bool = pu.to_local(ante).z * pu.abierta < 0.0
		linea.call(hoja_lejos, "se abre hacia el lado contrario a quien llega")
		fallos += 0 if hoja_lejos else 1
		# y se cierra sola al irse
		player.global_position = pu.to_global(Vector3(0, 0.1, 9.0))
		# 2 s de espera sin nadie y ~1 s de muelle hasta quedarse quieta
		for i in 270:
			await get_tree().physics_frame
		var cerrada: bool = is_instance_valid(pu) and absf(pu.abierta) < 0.05
		linea.call(cerrada, "se cierra sola al quedarse sin nadie")
		fallos += 0 if cerrada else 1
		# si se vuela el muro de alrededor, se cae
		if pu.sondas_iniciales > 0:
			for q in [Vector3(-pu.ancho * 0.5 - 0.5, 1.2, 0), Vector3(pu.ancho * 0.5 + 0.5, 1.2, 0), Vector3(0, pu.alto + 0.4, 0)]:
				world.explode(pu.to_global(q), 1.4, 255)
			player.global_position = pu.to_global(Vector3(0, 0.1, 6.0))
			for i in 200:
				await get_tree().physics_frame
			var cayo: bool = not is_instance_valid(pu) or pu.caida
			linea.call(cayo, "sin marco la puerta se cae")
			fallos += 0 if cayo else 1
	else:
		linea.call(false, "el mapa no trae puertas.json")
		fallos += 1
	# 2b) LA FISICA DE LAS PUERTAS: una explosion la sacude, vuelve sola, y un disparo que la atraviesa la empuja
	if is_instance_valid(puertas) and puertas.puertas.size() > 3:
		var pf = null
		for k in range(2, puertas.puertas.size()):
			var q = puertas.puertas[k]
			if is_instance_valid(q) and not q.caida and q.sondas_iniciales > 0:
				pf = q
				break
		if pf != null:
			player.global_position = pf.global_position + Vector3(40, 0, 40)      # lejos: que no la abra
			for i in 15:
				await get_tree().physics_frame
			var fz: Vector3 = pf.global_transform.basis.z
			var a0: float = pf.ang
			puertas.onda(pf.global_position + fz * 3.0 + Vector3(0, 1.0, 0), 1.2)
			for i in 12:
				await get_tree().physics_frame
			var sacude: float = absf(pf.ang - a0)
			linea.call(sacude > 0.05, "una explosion cerca sacude la puerta (%.2f rad)" % sacude)
			fallos += 0 if sacude > 0.05 else 1
			for i in 240:
				await get_tree().physics_frame
			linea.call(absf(pf.ang) < 0.06, "y vuelve sola a su sitio (%.3f rad)" % pf.ang)
			fallos += 0 if absf(pf.ang) < 0.06 else 1
			var a1: float = pf.ang
			puertas.disparo(pf.global_position + fz * 6.0 + Vector3(0, 1.2, 0) + pf.global_transform.basis.x * (pf.ancho * 0.25), -fz, 20.0, 2.0)
			for i in 6:
				await get_tree().physics_frame
			var tiro: float = absf(pf.ang - a1)
			linea.call(tiro > 0.02, "un disparo que atraviesa la hoja la empuja (%.2f rad)" % tiro)
			fallos += 0 if tiro > 0.02 else 1
	# 2d) ROMPER PUERTAS: a tiros una de madera (90 de vida) y a mazazos otra
	if is_instance_valid(puertas):
		var de_madera: Array = []
		for k in range(3, puertas.puertas.size()):
			var q = puertas.puertas[k]
			if is_instance_valid(q) and not q.caida and q.tipo == "madera" and not q.doble:
				de_madera.append(k)
			if de_madera.size() >= 2:
				break
		if de_madera.size() >= 2:
			var r0: int = puertas.rotas_total
			var pa = puertas.puertas[de_madera[0]]
			var fa: Vector3 = pa.global_transform.basis.z
			var tiros := 0
			while is_instance_valid(pa) and not pa.caida and tiros < 10:
				puertas.disparo(pa.global_position + fa * 5.0 + Vector3(0, 1.2, 0) + pa.global_transform.basis.x * (pa.ancho * 0.2), -fa, 10.0, 1.0, 30.0)
				tiros += 1
				await get_tree().physics_frame
			var trozos := 0
			for c in get_tree().current_scene.get_children():
				if c is RigidBody3D and c.collision_layer == 0:
					trozos += 1
			linea.call(puertas.rotas_total == r0 + 1 and tiros == 3, "a tiros: una puerta de madera se rompe al 3er disparo de 30 (%d tiros)" % tiros)
			fallos += 0 if (puertas.rotas_total == r0 + 1 and tiros == 3) else 1
			linea.call(trozos >= 6, "salta en tablones con fisica (%d trozos)" % trozos)
			fallos += 0 if trozos >= 6 else 1
			var pb = puertas.puertas[de_madera[1]]
			var fb: Vector3 = pb.global_transform.basis.z
			var golpes := 0
			while is_instance_valid(pb) and not pb.caida and golpes < 6:
				puertas.golpe(pb.global_position + fb * 1.5 + Vector3(0, 1.2, 0) + pb.global_transform.basis.x * (pb.ancho * 0.2), -fb, 3.0, 34.0 * 2.5)
				golpes += 1
				await get_tree().physics_frame
			linea.call(puertas.rotas_total == r0 + 2 and golpes == 2, "a mazazos se rompe al 2o golpe (%d)" % golpes)
			fallos += 0 if (puertas.rotas_total == r0 + 2 and golpes == 2) else 1
	# 2c) VENDAS Y BOTIQUINES: se usan y curan lo que dicen (invulnerable: que ningun bot descuadre la cuenta)
	player.vendas = 1
	player.botiquines = 1
	player.health = 100.0
	player.usar_cura("venda")
	var t_cura := Time.get_ticks_msec()
	while player.curando != "" and Time.get_ticks_msec() - t_cura < 6000:
		await get_tree().physics_frame
	var tras_venda: float = player.health
	var venda_ok: bool = absf(tras_venda - (100.0 + player.vida_max() * player.VENDA_CURA)) < 1.0 and player.vendas == 0
	linea.call(venda_ok, "la venda cura un 15 %% en %.1f s (100 -> %.0f)" % [(Time.get_ticks_msec() - t_cura) / 1000.0, tras_venda])
	fallos += 0 if venda_ok else 1
	player.usar_cura("botiquin")
	t_cura = Time.get_ticks_msec()
	for i in 30:
		await get_tree().physics_frame
	player.fire()                 # disparar corta la cura y no se gasta el botiquin
	var cortada: bool = player.curando == "" and player.botiquines == 1
	linea.call(cortada, "disparar corta la cura sin gastarla")
	fallos += 0 if cortada else 1
	player.usar_cura("botiquin")
	t_cura = Time.get_ticks_msec()
	while player.curando != "" and Time.get_ticks_msec() - t_cura < 9000:
		await get_tree().physics_frame
	var bot_ok: bool = player.health >= player.vida_max() - 0.5 and player.botiquines == 0
	linea.call(bot_ok, "el botiquin deja la vida entera en %.1f s (%.0f)" % [(Time.get_ticks_msec() - t_cura) / 1000.0, player.health])
	fallos += 0 if bot_ok else 1
	# 3) BOTIN: la municion al pasar por encima, y un arma con interactuar
	if is_instance_valid(botin):
		var id_venda := -1
		for i in botin.puntos.size():
			if botin.contenido(i) == "venda":
				id_venda = i
				break
		if id_venda >= 0:
			var v0: int = player.vendas
			player.global_position = botin.puntos[id_venda]["pos"] + Vector3(0, 0.1, 0)
			player.velocity = Vector3.ZERO
			for i in 40:
				await get_tree().physics_frame
			var v_ok: bool = player.vendas > v0 and botin.contenido(id_venda) == ""
			linea.call(v_ok, "las vendas se recogen al pasar por encima (%d -> %d)" % [v0, player.vendas])
			fallos += 0 if v_ok else 1
		var id_mun := -1
		var id_arma := -1
		for i in botin.puntos.size():
			var c: String = botin.contenido(i)
			if c == "municion" and id_mun < 0:
				id_mun = i
			elif c.begins_with("arma:") and id_arma < 0:
				id_arma = i
		if id_mun >= 0:
			var ranura_fuego := -1
			for i in Weapons.LIST.size():
				if player._de_fuego(Weapons.LIST[i]):
					ranura_fuego = i
					break
			var antes: int = player.reserve[ranura_fuego] if ranura_fuego >= 0 else 0
			player.global_position = botin.puntos[id_mun]["pos"] + Vector3(0, 0.1, 0)
			player.velocity = Vector3.ZERO
			for i in 40:
				await get_tree().physics_frame
			var despues: int = player.reserve[ranura_fuego] if ranura_fuego >= 0 else 0
			var cogida: bool = botin.contenido(id_mun) == "" and despues > antes
			print("[pruebaisla] municion: reserva %d -> %d" % [antes, despues])
			linea.call(cogida, "la municion se recoge al pasar por encima")
			fallos += 0 if cogida else 1
		if id_arma >= 0:
			var arma: String = botin.arma_de(botin.contenido(id_arma))
			player.global_position = botin.puntos[id_arma]["pos"] + Vector3(0.8, 0.1, 0)
			for i in 20:
				await get_tree().physics_frame
			var ranura: int = player.ranura_para_arma(arma)
			var vieja: String = String(Weapons.LIST[ranura]["id"]) if ranura >= 0 else ""
			player.interact()
			for i in 10:
				await get_tree().physics_frame
			var ahora: String = String(Weapons.LIST[ranura]["id"]) if ranura >= 0 else ""
			var queda: String = botin.contenido(id_arma)
			var cambio: bool = ahora == arma and queda == "arma:" + vieja
			print("[pruebaisla] arma: ranura %d %s -> %s · en el suelo queda '%s'" % [ranura, vieja, ahora, queda])
			linea.call(cambio, "el arma se coge con interactuar y la vieja queda en el suelo")
			fallos += 0 if cambio else 1
		# el casco: se recoge y para un 30 % de un golpe
		for i in botin.puntos.size():
			if botin.contenido(i) == "casco":
				player.global_position = botin.puntos[i]["pos"] + Vector3(0, 0.1, 0)
				for k in 30:
					await get_tree().physics_frame
				var c0: float = player.casco
				player.invulnerable = false
				var v0: float = player.health
				player.take_damage(20.0)
				var paro: float = v0 - player.health
				player.invulnerable = true
				var ok_c: bool = c0 > 0.0 and paro < 20.0 * 0.75
				print("[pruebaisla] casco %.0f · un golpe de 20 quita %.1f de vida" % [c0, paro])
				linea.call(ok_c, "el casco se recoge y se come parte del golpe")
				fallos += 0 if ok_c else 1
				break
	else:
		linea.call(false, "el mapa no trae botin.json")
		fallos += 1
	# 4) UN BOT EN EL AGUA flota (no se va andando por el fondo) y abre una puerta al llegar. Se le pone
	# el bando contrario para que tenga a quien perseguir: sin objetivo un bot no se mueve ni cae.
	if is_instance_valid(agua) and agua_s > -INF:
		var sup2: float = agua_s
		player.global_position = Vector3(agua_p.x + 6.0, sup2 + 1.0, agua_p.z)   # que tenga a quien seguir
		var bot := ENEMY_SCENE.instantiate()
		enemies.add_child(bot)
		bot.global_position = Vector3(agua_p.x, sup2 - 0.2, agua_p.z)
		bot.setup(world, player, 990)
		bot.team = Net.TEAM_CT
		for i in 120:
			await get_tree().physics_frame
		var by: float = bot.global_position.y if is_instance_valid(bot) else -99.0
		var bot_flota: bool = is_instance_valid(bot) and by > sup2 - 1.5 and by < sup2 - 0.9
		print("[pruebaisla] bot en el agua: pies a %.2f (superficie %.2f)" % [by, sup2])
		linea.call(bot_flota, "un bot en el agua flota con la cabeza fuera")
		fallos += 0 if bot_flota else 1
		if is_instance_valid(bot):
			bot.queue_free()
	if is_instance_valid(puertas) and puertas.puertas.size() > 1 and is_instance_valid(puertas.puertas[1]):
		var pu2 = puertas.puertas[1]
		player.global_position = pu2.to_global(Vector3(0, 0.1, 15.0))
		var bot2 := ENEMY_SCENE.instantiate()
		enemies.add_child(bot2)
		bot2.global_position = pu2.to_global(Vector3(0.3, 0.1, -1.5))
		bot2.setup(world, player, 991)
		bot2.set_physics_process(false)          # quieto: solo cuenta que este al lado
		for i in 40:
			await get_tree().physics_frame
		var abre_bot: bool = absf(pu2.abierta) > 0.95
		linea.call(abre_bot, "la puerta se abre tambien para un bot")
		fallos += 0 if abre_bot else 1
		bot2.queue_free()
	print("[pruebaisla] FIN: %s (%d fallos)" % ["TODO OK" if fallos == 0 else "HAY FALLOS", fallos])
	get_tree().quit()


## --botinlan (banco de dos instancias, con --lanhost/--lanjoin): el invitado coge una municion y un
## arma; al final cada maquina imprime su semilla y lo que ha cambiado en el botin. Tienen que salir
## IGUALES en las dos: misma arma en cada punto y los mismos puntos vacios.
func _botin_lan_test() -> void:
	await get_tree().create_timer(14.0).timeout
	if not is_instance_valid(botin):
		print("[botinlan] el mapa no trae botin")
		get_tree().quit()
		return
	var quien := "ANFITRION" if Net.hosting else "INVITADO"
	print("[botinlan] %s: semilla %d · arma del punto 0: %s" % [quien, botin.semilla, botin.contenido(0)])
	if not Net.hosting:
		player.invulnerable = true
		for i in botin.puntos.size():
			var c: String = botin.contenido(i)
			if c == "municion":
				player.global_position = botin.puntos[i]["pos"] + Vector3(0, 0.1, 0)
				for k in 40:
					await get_tree().physics_frame
				print("[botinlan] INVITADO: municion del punto %d -> '%s'" % [i, botin.contenido(i)])
				break
		for i in botin.puntos.size():
			var c: String = botin.contenido(i)
			if c.begins_with("arma:"):
				player.global_position = botin.puntos[i]["pos"] + Vector3(0.8, 0.1, 0)
				for k in 20:
					await get_tree().physics_frame
				player.interact()
				for k in 30:
					await get_tree().physics_frame
				print("[botinlan] INVITADO: arma del punto %d %s -> '%s' · en la mano %s" % [
					i, c, botin.contenido(i), String(Weapons.LIST[player.current]["id"])])
				break
	await get_tree().create_timer(6.0).timeout
	var cambios: Array = []
	var ids: Array = botin.estado.keys()
	ids.sort()
	for id in ids:
		cambios.append("%d=%s(v%d)" % [id, botin.estado[id]["c"], botin.estado[id]["v"]])
	print("[botinlan] %s FIN: %s" % [quien, ", ".join(cambios)])
	get_tree().quit()


