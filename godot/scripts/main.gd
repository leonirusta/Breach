# ---------------------------------------------------------------------------------------------------------------------
# --equipostest (en las DOS copias, como --tirolan; 2026-09-30): LOS SUBMODOS EN RED, de punta a punta. El submodo se
# fuerza SOLO en el anfitrion (--submodo=...): que el invitado lo tenga igual es lo primero que se mira.
#   battle royale  --lanmap=isla --submodo=escuadra [--bots_br=6]   (o =solo)
#   duelo          --lanmap=hangar --submodo=equipos --dmobjetivo=3 (o =todos)
# El ANFITRION lleva el guion: le dice al invitado que ataque (Net.net_aviso("equipostest:<orden>")) y mira SU vida:
# balas (el rayo del servidor), mazo (el mismo rayo, de cerca), cohete, granada y la onda de una habilidad
# (Combat.damage_tubo). Primero siendo del mismo bando (no debe bajar) y luego de bandos distintos (debe bajar), o al
# reves segun el modo. Despues los bots: los de tu bando no reciben tus explosiones ni te eligen de blanco. Y el final:
# battle royale -> caen todas las escuadras menos una (con el invitado ya muerto: su escuadra gana igual); duelo -> el
# anfitrion hace las bajas del objetivo y se mira el marcador y las tablas del final (dos, o una en todos contra todos).
# Sin --headless, --equipostestfotos=<carpeta> deja fotos de las etiquetas de compañero y de la lista de la escuadra.
# ---------------------------------------------------------------------------------------------------------------------
var _et_fallos := 0
var _et_quien := ""
var _et_fotos := ""


func _et_linea(ok: bool, que: String) -> void:
	if not ok:
		_et_fallos += 1
	print("[equipostest] %s %s  %s" % [_et_quien, "OK   " if ok else "FALLO", que])


func _et_esperar(s: float) -> void:
	await get_tree().create_timer(s).timeout


## Todos los bots quietos (en las dos maquinas): que no disparen ni muevan la vida del que mide
func _et_congelar_bots(quietos: bool) -> void:
	for e in enemies.get_children():
		if is_instance_valid(e) and "team" in e:
			e.process_mode = Node.PROCESS_MODE_DISABLED if quietos else Node.PROCESS_MODE_INHERIT


func _et_foto(nombre: String) -> void:
	if _et_fotos == "" or DisplayServer.get_name() == "headless":
		return
	await RenderingServer.frame_post_draw
	var ruta := _et_fotos.path_join("%s_%s.png" % [nombre, "anfitrion" if Net.hosting else "invitado"])
	get_viewport().get_texture().get_image().save_png(ruta)
	print("[equipostest] foto %s" % ruta)


func _equipos_test() -> void:
	_et_quien = "ANFITRION" if Net.hosting else "INVITADO "
	for a in OS.get_cmdline_user_args():
		if String(a).begins_with("--equipostestfotos="):
			_et_fotos = String(a).substr(19)
			DirAccess.make_dir_recursive_absolute(_et_fotos)
	# el otro, los bandos y el mapa
	for _i in 2400:
		await get_tree().process_frame
		if not Net.remotes.is_empty() and Net.my_team() != "":
			break
	await _et_esperar(4.0)
	if Net.remotes.is_empty():
		_et_linea(false, "no veo al otro: no se puede probar")
		get_tree().quit()
		return
	var otro_id: int = int(Net.remotes.keys()[0])
	var br: bool = Settings.es_battle_royale(current_map)
	var sub := Net.submodo()
	# el anfitrion va a cambiar de bando al invitado (Net.poner_bando): su jugador lo sigue
	if not Net.teams_changed.is_connected(_bando_de_red_cambia):
		Net.teams_changed.connect(_bando_de_red_cambia)
	print("[equipostest] %s mapa %s · submodo «%s» (de la sala «%s») · yo «%s» · el otro «%s»" % [_et_quien, current_map, sub,
		Net.room_sub, Net.my_team(), Net.team_of(otro_id)])
	_et_linea(sub in ["escuadra", "solo", "equipos", "todos"], "la sala lleva submodo y lo tengo: «%s»" % sub)
	# (en el battle royale en solitario la etiqueta de bando no cuenta: tu jugador sigue siendo "t", como siempre)
	if not (br and Net.todos_contra_todos()):
		_et_linea(String(player.team) == Net.my_team(), "mi jugador lleva el bando de la red (%s)" % String(player.team))
	# BATTLE ROYALE: fuera del avion y al suelo, los dos juntos (la misma zona en las dos maquinas: misma semilla)
	var sitio := Vector3.ZERO
	if br and is_instance_valid(salto_br) and is_instance_valid(zona_br):
		var sb = salto_br
		while sb.estado == sb.ESPERA:
			await get_tree().physics_frame
		while sb.t < sb._t_dentro.x + 1.0:
			await get_tree().physics_frame
		sb.saltar()
		var c1: Vector3 = zona_br.circulos[1]
		sitio = world.find_ground(Vector3(c1.x, 0.0, c1.z))
		player.global_position = (sitio if Net.hosting else world.find_ground(sitio + Vector3(0, 0, 6))) + Vector3(0, 0.3, 0)
		player.velocity = Vector3.ZERO
		sb._aterrizar(player)
		zona_br.escala_tiempo = 0.0         # la zona quieta: su daño por segundo no se mezcla con lo que se mide
	elif dm_mode:
		sitio = _ground_near(dm_centro)
		player.global_position = (sitio if Net.hosting else _ground_near(sitio + Vector3(0, 0, 6))) + Vector3(0, 0.3, 0)
		player.velocity = Vector3.ZERO
	await _et_esperar(3.0)
	_et_congelar_bots(true)
	if br and Net.es_escuadras():
		var cuenta := {}
		for e in enemies.get_children():
			if is_instance_valid(e) and "team" in e:
				cuenta[String(e.team)] = int(cuenta.get(String(e.team), 0)) + 1
		for pid in Net.players.keys():
			var eqp := Net.team_of(int(pid))
			cuenta[eqp] = int(cuenta.get(eqp, 0)) + 1
		var bien := true
		for k in cuenta.keys():
			bien = bien and Net.es_escuadra(String(k)) and int(cuenta[k]) <= Net.ESCUADRA_MAX
		_et_linea(bien, "escuadras de hasta 4 (personas + bots): %s" % str(cuenta))
		if not "--escuadrasolo" in OS.get_cmdline_user_args():
			_et_linea(Net.my_team() == Net.team_of(otro_id), "los dos sin grupo, juntos en la misma escuadra (%s)" % Net.my_team())
	if Net.hosting:
		await _et_guion_anfitrion(otro_id, br)
	else:
		await _et_invitado(otro_id)
	print("[equipostest] %s FIN: %s" % [_et_quien, "TODO OK" if _et_fallos == 0 else "%d FALLOS" % _et_fallos])
	await _et_esperar(1.0)
	get_tree().quit()


## EL INVITADO: hace lo que le mandan, atacando al anfitrion desde donde esta (6 m), y se va cuando se lo dicen
func _et_invitado(otro_id: int) -> void:
	var fin := [false]
	player.invulnerable = true                 # sus propias explosiones no le tumban mientras ataca
	Net.aviso_pve.connect(func(t: String):
		if not t.begins_with("equipostest:"):
			return
		var orden := t.substr(12)
		if orden == "fin":
			fin[0] = true
			return
		_et_atacar(orden, otro_id))
	var t0 := Time.get_ticks_msec()
	while not fin[0] and Time.get_ticks_msec() - t0 < 240000:
		await get_tree().process_frame
	# lo que dice el final en esta maquina
	if is_instance_valid(zona_br) and Net.es_escuadras():
		_et_linea(zona_br.terminada and zona_br.mi_puesto == 1,
			"battle royale: MI ESCUADRA GANA aunque yo haya caido (puesto %d, terminada %s)" % [zona_br.mi_puesto, str(zona_br.terminada)])
	if dm_mode:
		_et_fin_duelo()


func _et_atacar(orden: String, otro_id: int) -> void:
	var r = Net.remotes.get(otro_id)
	if r == null or not is_instance_valid(r):
		return
	var blanco: Vector3 = (r as Node3D).global_position
	match orden:
		"bala":
			# desde un sitio a 6 m con la linea de tiro LIBRE (el servidor mira la pared de ahora: con una caja en medio
			# el tiro no llega, y eso seria el mapa, no las reglas)
			var off := Vector3(0, 0, 6.0)
			for cand in [Vector3(0, 0, 6), Vector3(6, 0, 0), Vector3(0, 0, -6), Vector3(-6, 0, 0), Vector3(4.2, 0, 4.2),
					Vector3(-4.2, 0, 4.2), Vector3(4.2, 0, -4.2), Vector3(-4.2, 0, -4.2)]:
				var pie: Vector3 = _ground_near(blanco + cand)
				var ojo_c: Vector3 = pie + Vector3(0, 1.45, 0)
				var hacia_c: Vector3 = (blanco + Vector3(0, 1.0, 0)) - ojo_c
				var rw: Dictionary = world.raycast(ojo_c, hacia_c.normalized(), hacia_c.length())
				if absf(pie.y - blanco.y) < 1.5 and not bool(rw.get("hit", false)):
					off = pie - blanco
					break
			for _k in 5:
				blanco = (r as Node3D).global_position
				player.global_position = blanco + off
				player.velocity = Vector3.ZERO
				var ojo: Vector3 = player.global_position + Vector3(0, 1.45, 0)
				Net.pedir_disparo(ojo, ((blanco + Vector3(0, 1.0, 0)) - ojo).normalized(), 60.0, 24.0, 5.0)
				await _et_esperar(0.25)
			player.global_position = blanco + Vector3(0, 0, 6.0)
		"mazo":
			player.global_position = blanco + Vector3(0, 0, 1.6)
			player.velocity = Vector3.ZERO
			await _et_esperar(0.3)
			blanco = (r as Node3D).global_position
			var ojo2: Vector3 = player.global_position + Vector3(0, 1.45, 0)
			Net.pedir_disparo(ojo2, ((blanco + Vector3(0, 1.0, 0)) - ojo2).normalized(), 3.0,
				float(Weapons.get_def("sledge").get("damage", 60.0)), 4.0)
			await _et_esperar(0.3)
			player.global_position = blanco + Vector3(0, 0, 6.0)
		"cohete":
			var rk := ROCKET_SCENE_ET.instantiate()
			add_child(rk)
			rk.global_position = blanco + Vector3(0.6, 2.2, 0)
			rk.effects = effects
			rk.setup(world, Vector3.DOWN, player, 4.0, 1, 130.0)
		"granada":
			var g := GRENADE_SCENE_ET.instantiate()
			add_child(g)
			g.global_position = blanco + Vector3(0.4, 0.4, 0)
			g.autor = player
			g.fuse = 0.4
			g.setup(world, Vector3.ZERO)
		"onda":
			var ojo3: Vector3 = player.global_position + Vector3(0, 1.45, 0)
			var hacia: Vector3 = ((blanco + Vector3(0, 1.0, 0)) - ojo3).normalized()
			Combat.damage_tubo(get_tree(), ojo3, blanco + Vector3(0, 1.0, 0) + hacia * 2.0, 1.4, 60.0, player, Vector3.ZERO, {}, true, true)
		"morir":
			player.invulnerable = false
			player.take_damage(99999.0)
	print("[equipostest] INVITADO  ataco con %s (yo %s, el %s)" % [orden, Net.my_team(), Net.team_of(otro_id)])


const GRENADE_SCENE_ET := preload("res://scenes/grenade.tscn")
const ROCKET_SCENE_ET := preload("res://scenes/rocket.tscn")


## EL ANFITRION: manda cada ataque y mira su vida. `mismo` = somos del mismo bando (no debe bajar).
func _et_ronda(mismo: bool, que: String) -> void:
	# la foto de la etiqueta del compañero (su nombre del color del bando y su vida, a traves de lo que haya)
	if mismo and _et_fotos != "" and not Net.remotes.is_empty():
		var rc = Net.remotes.values()[0]
		if is_instance_valid(rc):
			player.look_at_point((rc as Node3D).global_position + Vector3(0, 1.0, 0))
			await _et_esperar(1.5)
			await _et_foto("1_etiqueta_companero")
	for orden in ["bala", "mazo", "cohete", "granada", "onda"]:
		player.invulnerable = false
		player.health = player.vida_max()
		player.health_changed.emit(player.health)
		await _et_esperar(0.4)
		var antes: float = player.health
		Net._diag_tiro = orden in ["bala", "mazo"]        # el servidor cuenta por que acierta o no
		Net.net_aviso("equipostest:" + orden)
		await _et_esperar(3.0)
		var despues: float = player.health
		var bajo: bool = despues < antes - 0.5
		_et_linea(bajo != mismo, "%s · %-7s: vida %.0f -> %.0f (%s)" % [que, orden, antes, despues,
			"no me hace daño" if not bajo else "me hace daño"])
	player.health = player.vida_max()
	player.health_changed.emit(player.health)


func _et_guion_anfitrion(otro_id: int, br: bool) -> void:
	await _et_foto("1_etiquetas")
	var mio := Net.my_team()
	var ffa: bool = Net.todos_contra_todos()
	var otro_eq := Net.team_of(otro_id)
	# 1) como empiezan
	if ffa:
		var rr = Net.remotes[otro_id]
		_et_linea(not rr.is_friendly(), "todos contra todos: el otro no es compañero (%s / %s)" % [mio, otro_eq])
		await _et_ronda(false, "TODOS CONTRA TODOS")
		# aunque la etiqueta coincida (en el battle royale en solitario las personas son todas "t"), sigue sin haber compañeros
		Net.poner_bando(otro_id, mio)
		await _et_esperar(1.5)
		await _et_ronda(false, "TODOS, MISMA ETIQUETA")
		Net.poner_bando(otro_id, otro_eq)         # y vuelve a lo suyo (el final mira de quien es cada bando)
		await _et_esperar(1.5)
	else:
		var juntos: bool = mio == otro_eq
		if juntos:
			await _et_ronda(true, "COMPAÑEROS (%s)" % mio)
			Net.poner_bando(otro_id, "e9" if br else (Net.TEAM_CT if mio == Net.TEAM_T else Net.TEAM_T))
			await _et_esperar(1.5)
			await _et_ronda(false, "RIVALES (%s / %s)" % [mio, Net.team_of(otro_id)])
		else:
			await _et_ronda(false, "RIVALES (%s / %s)" % [mio, otro_eq])
			Net.poner_bando(otro_id, mio)
			await _et_esperar(1.5)
			await _et_ronda(true, "COMPAÑEROS (%s)" % mio)
		Net.poner_bando(otro_id, mio)             # para el final, del mismo bando
		await _et_esperar(1.5)
	# 2) los bots: los de tu bando ni reciben tus explosiones ni te eligen de blanco
	var aliado = null
	var rival = null
	for e in enemies.get_children():
		if not is_instance_valid(e) or not ("team" in e) or float(e.get("health")) <= 0.0:
			continue
		# (sin escudo balistico: el escudo se come la onda por delante, y eso no es cosa de bandos)
		var con_escudo: bool = e.avatar != null and is_instance_valid(e.avatar) and e.avatar.has_method("escudo_activo") \
			and e.avatar.escudo_activo()
		if String(e.team) == mio and aliado == null and not ffa and not con_escudo:
			aliado = e
		elif String(e.team) != mio and rival == null and not con_escudo:
			rival = e
	var centro_b: Vector3 = player.global_position + Vector3(4, 0, 0)
	for b in [aliado, rival]:
		if b != null:
			(b as Node3D).global_position = centro_b + Vector3(0, 0.3, 0.8 if b == aliado else -0.8)
	await _et_esperar(0.5)
	# se mide en el mismo fotograma (el daño de la explosion es inmediato): asi no se cuela el de la zona, que va por segundos
	var v_al: float = float(aliado.health) if aliado != null else 0.0
	var v_ri: float = float(rival.health) if rival != null else 0.0
	Combat.damage_around(get_tree(), centro_b + Vector3(0, 0.5, 0), 5.0, 40.0, player, false, true)
	var v_al2: float = float(aliado.health) if aliado != null else 0.0
	var v_ri2: float = float(rival.health) if rival != null else 0.0
	await _et_esperar(0.5)
	if aliado != null:
		_et_linea(is_equal_approx(v_al2, v_al), "bot de mi bando (%s): mi explosion no le hace daño (%.0f -> %.0f)" % [
			String(aliado.team), v_al, v_al2])
		aliado._pick_target()
		_et_linea(aliado.target != player, "bot de mi bando: no me elige de blanco")
	if rival != null:
		_et_linea(v_ri2 < v_ri, "bot rival (%s): mi explosion si (%.0f -> %.0f)" % [String(rival.team), v_ri, v_ri2])
	# 3) el final
	if br:
		await _et_final_br(otro_id)
	elif dm_mode:
		await _et_final_duelo()
	Net.net_aviso("equipostest:fin")


## BATTLE ROYALE: el invitado cae (su escuadra sigue: la mia), y luego caen todos los bots de las demas escuadras
func _et_final_br(otro_id: int) -> void:
	if not Net.es_escuadras():
		# en solitario gana el ultimo en pie: caen todos los bots y el invitado
		Net.net_aviso("equipostest:morir")
		await _et_esperar(2.0)
		_et_congelar_bots(false)
		for e in enemies.get_children():
			if is_instance_valid(e) and "team" in e and e.has_method("take_damage"):
				e.take_damage(99999.0)
		await _et_esperar(4.0)
		_et_linea(zona_br.terminada and zona_br.mi_puesto == 1, "battle royale en solitario: el ultimo en pie gana (puesto %d)" % zona_br.mi_puesto)
		return
	var mia := Net.my_team()
	Net.net_aviso("equipostest:morir")
	await _et_esperar(2.5)
	_et_linea(not zona_br.terminada, "cae el invitado pero su escuadra (la mia) sigue: la partida no se acaba")
	var quedan := {}
	_et_congelar_bots(false)
	for e in enemies.get_children():
		if is_instance_valid(e) and "team" in e and e.has_method("take_damage"):
			if String(e.team) != mia:
				e.take_damage(99999.0)
			elif float(e.health) > 0.0:
				quedan[String(e.team)] = true
	await _et_esperar(4.0)
	_et_linea(zona_br.terminada and zona_br.mi_puesto == 1,
		"queda UNA escuadra (la %s): gana y se acaba (terminada %s, puesto %d, escuadras que hubo %d)" % [
		Net.nombre_equipo(mia), str(zona_br.terminada), zona_br.mi_puesto, zona_br.max_escuadras])
	var cfg: Dictionary = ultimo_fin_cfg
	var eqs: Array = cfg.get("equipos", [])
	_et_linea(eqs.size() == 1 and String(eqs[0].get("equipo", "")) == mia and (cfg.get("filas", []) as Array).size() >= 2,
		"la pantalla del final: una tabla, la de mi escuadra (%s), con %d filas" % [
		String(eqs[0].get("nombre", "?")) if eqs.size() > 0 else "-", (cfg.get("filas", []) as Array).size()])
	await _et_mostrar_tabla_final()


## DUELO: el anfitrion hace las bajas que hacen falta (bots de otro bando) y se acaba para los dos
func _et_final_duelo() -> void:
	_et_congelar_bots(false)
	var objetivo: int = dm_objetivo_todos if Net.es_dm_todos() else dm_objetivo
	var hechas := 0
	for e in enemies.get_children():
		if hechas >= objetivo:
			break
		if is_instance_valid(e) and "team" in e and String(e.team) != Net.my_team() and float(e.health) > 0.0:
			e.ultimo_atacante = player
			e.take_damage(99999.0)
			hechas += 1
			await _et_esperar(0.6)
	await _et_esperar(3.0)
	_et_fin_duelo()
	await _et_mostrar_tabla_final()


## Lo que dice el final del duelo en esta maquina (las dos lo miran)
func _et_fin_duelo() -> void:
	var cfg: Dictionary = ultimo_fin_cfg
	if cfg.is_empty():
		_et_linea(false, "duelo: no ha llegado el final (terminado %s)" % str(dm_terminado))
		return
	var eqs: Array = cfg.get("equipos", [])
	var filas: Array = cfg.get("filas", [])
	if Net.es_dm_todos():
		_et_linea(eqs.size() == 1 and String(eqs[0]["equipo"]) == "todos" and filas.all(func(f): return String(f["equipo"]) == "todos"),
			"todos contra todos: UNA tabla con todos (%d filas) · marcador %s · gane %s" % [filas.size(), str(cfg.get("marcador")), str(cfg.get("gane"))])
		_et_linea(bool(cfg.get("gane")) == Net.hosting, "gana quien llego a las bajas (el anfitrion): gane=%s" % str(cfg.get("gane")))
	else:
		var bandos := {}
		for f in filas:
			bandos[String(f["equipo"])] = true
		var marc: Array = cfg.get("marcador", [0, 0])
		_et_linea(eqs.is_empty() and bandos.has(Net.TEAM_T) and bandos.has(Net.TEAM_CT),
			"equipos: el final lleva DOS tablas (tu equipo y el rival) · filas de %s" % str(bandos.keys()))
		_et_linea(int(marc[0]) >= dm_objetivo and bool(cfg.get("gane")),
			"equipos: marcador %s (objetivo %d) · gane %s" % [str(marc), dm_objetivo, str(cfg.get("gane"))])


## Sin --headless: la tabla del final, ya, para la foto (se saltan la entrada, el nivel y los mejores)
func _et_mostrar_tabla_final() -> void:
	if _et_fotos == "" or DisplayServer.get_name() == "headless" or ultimo_fin_cfg.is_empty():
		return
	await _et_esperar(1.0)
	for c in get_children():
		var sc = c.get_script()
		if sc != null and String(sc.resource_path).get_file() in ["fin_intro.gd", "fin_nivel.gd", "mejores_jugadores.gd"]:
			c.queue_free()
	var cfg: Dictionary = ultimo_fin_cfg
	hud.visible = true
	hud.mostrar_victoria_final(bool(cfg.get("gane")), cfg.get("marcador", [0, 0]), cfg.get("filas", []), cfg.get("premio", {}),
		String(cfg.get("tema", "")), String(cfg.get("titulo", "")), cfg.get("equipos", []))
	await _et_esperar(3.5)
	await _et_foto("9_tabla_final")


## --escuadrasreparto (sin red, en cualquier mapa): EL REPARTO DE ESCUADRAS del anfitrion (Net.repartir_escuadras y el
## que llega tarde) con salas inventadas en memoria: los grupos del lobby enteros, los sueltos rellenando y nadie por
## encima de cuatro. No toca nada de verdad: la lista de la sala se devuelve como estaba.
func _escuadras_reparto_test() -> void:
	await get_tree().create_timer(2.0).timeout
	_et_quien = "REPARTO"
	var antes: Dictionary = Net.players.duplicate(true)
	var casos := [
		["seis sin grupo", {1: "", 2: "", 3: "", 4: "", 5: "", 6: ""}],
		["un grupo de 3, uno de 2 y tres sueltos", {1: "A", 2: "A", 3: "A", 4: "B", 5: "B", 6: "", 7: "", 8: ""}],
		["un grupo de 5 (no cabe en una) y dos sueltos", {1: "C", 2: "C", 3: "C", 4: "C", 5: "C", 6: "", 7: ""}],
		["dos grupos de 2 y uno de 4", {1: "D", 2: "D", 3: "E", 4: "E", 5: "F", 6: "F", 7: "F", 8: "F"}],
	]
	for caso in casos:
		var sala: Dictionary = caso[1]
		Net.players = {}
		for id in sala.keys():
			Net.players[id] = {"name": "J%d" % id, "grupo": String(sala[id]), "grupo_lider": false}
		Net.repartir_escuadras()
		var por_escuadra := {}
		var grupo_en := {}
		var bien := true
		for id in sala.keys():
			var eq := String(Net.players[id].get("team", ""))
			por_escuadra[eq] = int(por_escuadra.get(eq, 0)) + 1
			var g := String(sala[id])
			if g != "":
				if not grupo_en.has(g):
					grupo_en[g] = {}
				grupo_en[g][eq] = true
		for eq in por_escuadra.keys():
			bien = bien and Net.es_escuadra(String(eq)) and int(por_escuadra[eq]) <= Net.ESCUADRA_MAX
		for g in grupo_en.keys():
			var n_grupo := 0
			for id in sala.keys():
				if String(sala[id]) == g:
					n_grupo += 1
			# un grupo de hasta cuatro, en UNA escuadra; si es mas grande, en las justas
			bien = bien and (grupo_en[g] as Dictionary).size() == int(ceil(n_grupo / float(Net.ESCUADRA_MAX)))
		var minimo := int(ceil(sala.size() / float(Net.ESCUADRA_MAX)))
		_et_linea(bien and por_escuadra.size() <= minimo + 1, "%s -> %s" % [String(caso[0]), str(por_escuadra)])
	# EL QUE LLEGA TARDE: con su grupo si cabe, si no a la mas llena con hueco, si no una nueva
	Net.players = {1: {"name": "J1", "grupo": "G", "team": "e1"}, 2: {"name": "J2", "grupo": "", "team": "e1"},
		3: {"name": "J3", "grupo": "", "team": "e2"}, 9: {"name": "J9", "grupo": "G"}}
	var t9 := Net._escuadra_para_el_que_llega(9)
	_et_linea(t9 == "e1", "llega tarde con su grupo (en la e1, con hueco) -> %s" % t9)
	Net.players[9]["team"] = t9
	Net.players[4] = {"name": "J4", "grupo": "", "team": "e1"}
	Net.players[10] = {"name": "J10", "grupo": "G"}
	var t10 := Net._escuadra_para_el_que_llega(10)
	_et_linea(t10 == "e2", "llega tarde con su grupo, pero la suya esta llena -> a la mas llena con hueco: %s" % t10)
	Net.players = antes
	print("[equipostest] REPARTO FIN: %s" % ("TODO OK" if _et_fallos == 0 else "%d FALLOS" % _et_fallos))
	get_tree().quit()


## --equiposfoto=<carpeta> (sin red, sin --headless; con --map=isla --submodo=escuadra o --map=hangar --submodo=equipos):
## LAS ETIQUETAS DE LOS COMPAÑEROS en partida. Battle royale: se salta del avion y se aterriza en la primera zona, tres bots
## de tu escuadra delante (uno detras de una pared si la hay) y fotos de la vista, de la lista de la escuadra y del mapa
## grande (M) con sus puntos. Duelo: los bots de tu equipo delante. Los bots, quietos.
func _equipos_foto(carpeta: String) -> void:
	DirAccess.make_dir_recursive_absolute(carpeta)
	var foto := func(n: String) -> void:
		await RenderingServer.frame_post_draw
		var ruta := carpeta.path_join(n + ".png")
		get_viewport().get_texture().get_image().save_png(ruta)
		print("[equiposfoto] %s" % ruta)
	await get_tree().create_timer(3.0).timeout
	var sitio := Vector3.ZERO
	if is_instance_valid(salto_br) and is_instance_valid(zona_br):
		var sb = salto_br
		while sb.estado == sb.ESPERA:
			await get_tree().physics_frame
		while sb.t < sb._t_dentro.x + 1.0:
			await get_tree().physics_frame
		sb.saltar()
		var c1: Vector3 = zona_br.circulos[1]
		sitio = world.find_ground(Vector3(c1.x, 0.0, c1.z)) + Vector3(0, 0.3, 0)
		player.global_position = sitio
		player.velocity = Vector3.ZERO
		sb._aterrizar(player)
		zona_br.escala_tiempo = 0.0
	else:
		sitio = _ground_near(dm_centro if dm_centro != Vector3.ZERO else player.global_position) + Vector3(0, 0.3, 0)
		player.global_position = sitio
	player.invulnerable = true
	await get_tree().create_timer(2.0).timeout
	# los bots de tu bando, delante, en abanico; los demas lejos
	var mios: Array = []
	for e in enemies.get_children():
		if is_instance_valid(e) and "team" in e:
			e.process_mode = Node.PROCESS_MODE_DISABLED
			if String(e.team) == Net.my_team() and mios.size() < 3:
				mios.append(e)
	# fuera del avion (el salto los lleva en su asiento hasta que les toca saltar)
	if is_instance_valid(salto_br):
		for b in salto_br._bots:
			if b["n"] in mios:
				b["fase"] = salto_br.FIN
				(b["n"] as Node3D).visible = true
	var delante := Vector3(0, 0, -1)
	for i in mios.size():
		var ang := -0.5 + 0.5 * i
		var d := 7.0 + 5.0 * i
		var q: Vector3 = _ground_near(sitio + delante.rotated(Vector3.UP, ang) * d)
		(mios[i] as Node3D).global_position = q + Vector3(0, 0.05, 0)
		(mios[i] as Node3D).rotation.y = randf() * TAU
		if "health" in mios[i]:
			mios[i].health = [100.0, 62.0, 31.0][i]
	player.look_at_point(sitio + delante * 10.0 + Vector3(0, 1.0, 0))
	if player.has_method("set_third_person"):
		player.set_third_person(false)
	await get_tree().create_timer(2.5).timeout
	await foto.call("1_etiquetas_%s" % Net.submodo())
	if is_instance_valid(zona_br):
		zona_br.alternar_mapa()
		await get_tree().create_timer(1.0).timeout
		await foto.call("2_mapa_grande_%s" % Net.submodo())
		zona_br.alternar_mapa()
	print("[equiposfoto] FIN (%d compañeros delante, bando %s)" % [mios.size(), Net.my_team()])
	get_tree().quit()


## --cielofps: LO QUE CUESTA EL CIELO en la GPU, mirando un poco hacia arriba (media pantalla de cielo): con el cielo y
## en Liso, ABAB. (2026-09-30: el cielo recalculaba sus nubes a resolucion completa aunque tenia la pasada a un cuarto.)
var _cielo_pitch := 15.0      ## --cielofps: grados hacia arriba (--cielopitch=80: la pantalla entera de cielo)
func _cielo_fps_test() -> void:
	for f in OS.get_cmdline_user_args():
		if String(f).begins_with("--cielopitch="):
			_cielo_pitch = float(String(f).substr(13))
	await get_tree().create_timer(8.0).timeout
	var vp := get_viewport().get_viewport_rid()
	RenderingServer.viewport_set_measure_render_time(vp, true)
	if player and "look" in player:
		player.look.y = deg_to_rad(float(_cielo_pitch))
	for ronda in 4:
		_cielo_on = ronda % 2 == 0
		_aplicar_cielo()
		await get_tree().create_timer(1.5).timeout
		var suma := 0.0
		var n := 0
		var fin := Time.get_ticks_msec() + 4000
