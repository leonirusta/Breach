## --cartastodastest (con --personaje=0, el soldado del gancho: recarga por tiempo): LAS CATORCE CARTAS, UNA POR UNA, a
## nivel 10 y solo en memoria. Cada una sola equipada; se mira lo que hace en el juego contra lo que dice la carta.
func _cartas_todas_test() -> void:
	await get_tree().create_timer(8.0).timeout
	Settings._es_foto = 1
	Cuenta.perfil = {}
	Cuenta.token = ""
	player.invulnerable = false
	player.armor = 0.0
	player.casco = 0.0
	var malas := [0]
	var res := func(nombre: String, bien: bool, txt: String) -> void:
		print("[cartastodas] %s %-28s %s" % ["ok  " if bien else "MAL ", nombre, txt])
		if not bien:
			malas[0] += 1
	var poner := func(id: String) -> float:
		Settings.cartas = {}
		Settings.cartas_equipadas = []
		if id != "":
			Settings.cartas[id] = {"n": 10, "c": 0}
			Settings.cartas_equipadas = [id]
		Cartas.refrescar()
		player._leer_cartas()
		return Cartas.valor_a(id, 10) if id != "" else 0.0
	var w: Dictionary = Weapons.LIST[player.current]
	# DAÑO
	poner.call("")
	var d0: float = player._dmg(w)
	var v: float = poner.call("dano")
	res.call("AUMENTO DE DAÑO", absf(player._dmg(w) - d0 * (1.0 + v)) < 0.01, "%.1f -> %.1f (+%.0f %%)" % [d0, player._dmg(w), v * 100.0])
	# MUNICION AL ELIMINAR
	v = poner.call("municion")
	player.set_ammo(player.current, 0)
	player.carta_baja()
	var mag := int(w.mag)
	var esp := mini(mag, maxi(1, int(ceil(float(mag) * v))))
	res.call("MUNICIÓN AL ELIMINAR", int(player.ammo[player.current]) == esp, "cargador vacio + una baja: %d balas (esperado %d de %d)" % [int(player.ammo[player.current]), esp, mag])
	player.set_ammo(player.current, mag)
	# SALUD MAXIMA
	poner.call("")
	var vm0: float = player.vida_max()
	v = poner.call("vida")
	res.call("SALUD MÁX.", absf(player.vida_max() - vm0 * (1.0 + v)) < 0.01, "%.0f -> %.0f" % [vm0, player.vida_max()])
	# REGENERACION
	v = poner.call("regeneracion")
	player.health = 50.0
	player._ultimo_combate_t = -100.0
	var t0 := Time.get_ticks_msec()
	await get_tree().create_timer(2.0).timeout
	var subio: float = float(player.health) - 50.0
	var por_s: float = subio / ((Time.get_ticks_msec() - t0) * 0.001)
	res.call("REGEN. DE SALUD", subio > 0.5 and absf(por_s - v) < v * 0.25, "%.1f de vida por s (la carta: %.1f)" % [por_s, v])
	player.health = player.vida_max()
	# VELOCIDAD
	var inicio: Vector3 = player.global_position
	# hacia donde no haya pared en 15 m
	var giro := 0.0
	for i in 16:
		var g := i * TAU / 16.0
		var d := Vector3(-sin(g), 0, -cos(g))
		if not bool(world.raycast(inicio + Vector3(0, 0.6, 0), d, 15.0).get("hit", false)):
			giro = g
			break
	var medir_vel := func() -> float:
		player.global_position = inicio
		player.velocity = Vector3.ZERO
		player.look.x = giro
		player.rotation.y = giro
		for _i in 20:
			await get_tree().physics_frame
		Input.action_press("move_forward")
		var vmax := 0.0
		for _i in 60:
			await get_tree().physics_frame
			vmax = maxf(vmax, Vector2(player.velocity.x, player.velocity.z).length())
		Input.action_release("move_forward")
		return vmax
	poner.call("")
	var s0: float = await medir_vel.call()
	v = poner.call("velocidad")
	var s1: float = await medir_vel.call()
	res.call("VEL. DE MOVIMIENTO", absf(s1 - s0 * (1.0 + v)) < s0 * 0.04, "%.2f -> %.2f m/s (esperado %.2f)" % [s0, s1, s0 * (1.0 + v)])
	# SALTO
	var medir_salto := func() -> float:
		for _i in 40:
			await get_tree().physics_frame
		var y0: float = player.global_position.y
		player.do_touch_jump()
		var alto := 0.0
		for _i in 150:
			await get_tree().physics_frame
			alto = maxf(alto, player.global_position.y - y0)
		return alto
	poner.call("")
	var j0: float = await medir_salto.call()
	v = poner.call("salto")
	var j1: float = await medir_salto.call()
	res.call("SALTO ALTO", absf(j1 - j0 * (1.0 + v)) < 0.08, "%.2f -> %.2f m (esperado %.2f)" % [j0, j1, j0 * (1.0 + v)])
	# DESTRUCCION: un tiro a una pared con la potencia de la bala sin carta y con ella (voxels quitados)
	var ojo: Vector3 = player.global_position + Vector3(0, 1.4, 0)
	var dir := Vector3.ZERO
	for i in 24:
		var d := Vector3(cos(i * TAU / 24.0), 0, sin(i * TAU / 24.0))
		var h: Dictionary = world.raycast(ojo, d, 30.0)
		if bool(h.get("hit", false)):
			dir = d
			break
	if dir == Vector3.ZERO:
		res.call("DAÑO POR DESTRUCCIÓN", false, "no hay pared cerca para probar")
	else:
		poner.call("")
		var pot0 := mini(999, int(w.power))
		var r0: Dictionary = world.shoot(ojo, dir, 30.0, pot0)
		v = poner.call("destruccion")
		var extra := clampi(int(round((player._carta_destruccion - 0.15) / 0.54 * 3.0)), 0, 3)
		var pot1 := mini(999, int(round(float(w.power) * (1.0 + v)))) + 10000 * extra
		var r1: Dictionary = world.shoot(ojo + Vector3(0, 0.9, 0), dir, 30.0, pot1)
		res.call("DAÑO POR DESTRUCCIÓN", int(r1.get("removed", 0)) >= int(r0.get("removed", 0)) + extra and extra == 3,
			"un balazo: %d voxels sin carta, %d con ella a nivel 10 (+%d de mas)" % [int(r0.get("removed", 0)), int(r1.get("removed", 0)), extra])
	# EXPLOSION AMPLIA
	poner.call("")
	var e0: float = player._radio_expl(4.0)
	v = poner.call("explosion")
	res.call("EXPLOSIÓN AMPLIA", absf(player._radio_expl(4.0) - e0 * (1.0 + v)) < 0.01, "radio del cohete %.2f -> %.2f m" % [e0, player._radio_expl(4.0)])
	# ENFRIAMIENTO
	poner.call("")
	var hab = player._hab
	var f0: float = hab.factor_recarga() if hab else 1.0
	v = poner.call("enfriamiento")
	var f1: float = hab.factor_recarga() if hab else 1.0
	res.call("REDUCCIÓN DE ENFRIAMIENTO", absf(f1 - (1.0 - minf(v, 0.6))) < 0.01 and f1 < f0, "recarga x%.2f -> x%.2f" % [f0, f1])
	# RECARGA DE DEFINITIVA (soldado: recarga por tiempo)
	v = poner.call("definitiva")
	if hab != null and not hab.usa_energia():
		hab.recarga_total = 25.0
		hab.recarga = 25.0
		player.carta_baja()
		var tras_baja: float = float(hab.recarga)
		hab.recarga = 25.0
		player.carta_asistencia()
		var tras_asis: float = float(hab.recarga)
		res.call("RECARGA DE DEFINITIVA", absf(tras_baja - (25.0 - (hab.CARGA_BAJA + v) * 25.0)) < 0.05 and absf(tras_asis - (25.0 - v * 25.0)) < 0.05,
			"25 s de recarga: tras una baja %.1f s, tras una asistencia %.1f s" % [tras_baja, tras_asis])
	else:
		res.call("RECARGA DE DEFINITIVA", false, "este personaje usa energia: probar con --personaje=0")
	# VAMPIRO
	v = poner.call("vampiro")
	player.health = 30.0
	player.carta_baja()
	res.call("VAMPIRO", absf(float(player.health) - minf(30.0 + v, player.vida_max())) < 0.01, "30 de vida + una baja = %.1f" % float(player.health))
	# RESCATISTA
	v = poner.call("rescatista")
	res.call("RESCATISTA", absf(player.carta_rescatista() - v) < 0.001, "RCP %.0f %% mas rapida, revive con %.0f %% de vida" % [v * 100.0, (0.5 + v / 2.0) * 100.0])
	# BLINDAJE y PIEL DURA
	var golpe := func(tipo: String) -> float:
		player.health = 100.0
		player.golpe_tipo = tipo
		player.take_damage(40.0, Vector3.ZERO)
		return 100.0 - float(player.health)
	poner.call("")
	var g_bala: float = golpe.call("bala")
	var g_cuerpo: float = golpe.call("cuerpo")
	v = poner.call("blindaje")
	var g1: float = golpe.call("bala")
	res.call("BLINDAJE", absf(g1 - g_bala * (1.0 - v)) < 0.05, "bala de 40: %.1f -> %.1f" % [g_bala, g1])
	v = poner.call("piel_dura")
	var g2: float = golpe.call("cuerpo")
	res.call("PIEL DURA", absf(g2 - g_cuerpo * (1.0 - v)) < 0.05, "golpe de 40: %.1f -> %.1f" % [g_cuerpo, g2])
	player.health = player.vida_max()
	print("[cartastodas] %s" % ("TODO BIEN" if malas[0] == 0 else "%d MAL" % malas[0]))
	get_tree().quit()



## --cartuchostest (--map=pruebas): LA DE BOMBEO CARTUCHO A CARTUCHO. Falta 1 -> mete 1; faltan 4 y se dispara a
## media recarga -> se corta y dispara con lo que haya metido.
func _cartuchos_test() -> void:
	await get_tree().create_timer(7.0).timeout
	Settings._es_foto = 1
	var i := -1
	for k in Weapons.LIST.size():
		if bool(Weapons.LIST[k].get("bombeo", false)):
			i = k
	if i < 0:
		i = player.current
		Weapons.LIST[i] = (Weapons.catalog()["escopeta_bomba"] as Dictionary).duplicate(true)
	player.switch_weapon(i)
	await get_tree().create_timer(1.0).timeout
	var w: Dictionary = Weapons.LIST[player.current]
	var mag := int(w.mag)
	player.set_reserve(player.current, 30)
