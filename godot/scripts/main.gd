## --robotest: EL TERMINAL SE PUEDE ROBAR. Tiempos (20 s la caja, 120 s el ingreso, 7 s el robo), el
## terminal del color de quien mete el cubo, un bot de otro color al lado le cambia el color en 7 s, y
## los puntos del ingreso van al equipo que lo tenia al acabar.
func _robo_test() -> void:
	for _i in 120:
		if team_overlay != null:
			break
		await get_tree().create_timer(0.5).timeout
	Net.choose_team(Net.TEAM_V)
	_close_team_select()
	for _i in 60:
		await get_tree().create_timer(0.5).timeout
		if heist != null and heist.vault != null:
			break
	print("[robo] tiempos: caja %.0f s · ingreso %.0f s · robo %.0f s" % [heist.OPEN_TIME, heist.DEPOSIT_TIME, heist.CAPTURE_TIME])
	var mirar := func(obj: Vector3):
		var v: Vector3 = obj - player.cam.global_position
		player.look.x = atan2(-v.x, -v.z)
		player.look.y = atan2(v.y, Vector2(v.x, v.z).length())
	# FOTO 1: los bots AMARILLOS abriendo la caja, a mitad -> barra redonda amarilla
	for e in enemies.get_children():
		e.process_mode = Node.PROCESS_MODE_DISABLED
	player.global_position = heist.vault.global_position + Vector3(0, 0, 25)
	player.velocity = Vector3.ZERO
	for _f in 40:
		heist.bot_abriendo(Net.TEAM_CT, heist.BOT_OPEN_TIME * 0.6 / 40.0)
		mirar.call(heist.vault.global_position + Vector3(0, 1.2, 0))
		await get_tree().process_frame
	for _f in 3:
		heist.bot_abriendo(Net.TEAM_CT, 0.0)
		await RenderingServer.frame_post_draw
	get_viewport().get_texture().get_image().save_png("user://robo_caja_amarilla.png")
	print("[robo] foto caja: %s" % ProjectSettings.globalize_path("user://robo_caja_amarilla.png"))
	for e in enemies.get_children():
		e.process_mode = Node.PROCESS_MODE_INHERIT
	heist._open_vault()
	await get_tree().process_frame
	# el cubo, al terminal (lo mete MI equipo)
	var slot: Vector3 = heist.cashout.global_position + Vector3(0, 0.9, 0)
	heist.cube.global_position = slot
	for _f in 5:
		await get_tree().process_frame
	print("[robo] ingresando %s · del equipo %s (yo %s)" % [str(heist.out_state == 2), heist.out_equipo, Net.my_team()])
	# yo me voy lejos; un bot AMARILLO se planta al lado del terminal
	player.global_position = heist.cashout.global_position + Vector3(40, 0, 0)
	var ladron = null
	for e in enemies.get_children():
		if "team" in e and String(e.team) == Net.TEAM_T:
			ladron = e
			break
	for e in enemies.get_children():
		if e != ladron:
			e.process_mode = Node.PROCESS_MODE_DISABLED      # solo el ladron, para medir limpio
	ladron.global_position = heist.cashout.global_position + Vector3(1.5, 0.2, 0)
	var t0 := Time.get_ticks_msec()
	var cambio_a := -1.0
	for _i in 120:
		await get_tree().create_timer(0.1).timeout
		ladron.global_position = heist.cashout.global_position + Vector3(1.5, 0.2, 0)
		if heist.out_equipo == Net.TEAM_T:
			cambio_a = (Time.get_ticks_msec() - t0) / 1000.0
			break
	print("[robo] el bot amarillo se queda el terminal a los %.1f s (tiene que ser ~7) · equipo ahora %s" % [cambio_a, heist.out_equipo])
	# FOTO 2: el ingreso ya es AMARILLO -> la barra redonda del terminal cambia a amarillo
	heist.out_t = heist.DEPOSIT_TIME * 0.4
	for _f in 20:
		mirar.call(heist.cashout.global_position + Vector3(0, 1.5, 0))
		await get_tree().process_frame
	await RenderingServer.frame_post_draw
	get_viewport().get_texture().get_image().save_png("user://robo_terminal_amarillo.png")
	print("[robo] foto terminal: %s" % ProjectSettings.globalize_path("user://robo_terminal_amarillo.png"))
	# y el ingreso acaba: puntos para el amarillo, no para mi
	var antes: Dictionary = puntos_equipo.duplicate()
	heist.out_t = heist.DEPOSIT_TIME - 0.2
	await get_tree().create_timer(0.6).timeout
	print("[robo] puntos antes %s · despues %s (el amarillo +1000, el violeta igual)" % [str(antes), str(puntos_equipo)])
	get_tree().quit(0)


