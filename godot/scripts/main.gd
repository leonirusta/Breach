## --materiales: QUE TRAE DE VERDAD LA PALETA DE ESTE MAPA. La tabla por defecto del motor tiene los
## 242 huecos de paleta con la misma dureza, pero el .vxmap escribe la fisica de cada entrada al
## cargarse: hasta que no hay mapa cargado no se sabe que es metal y que no. Esto lo dice.
func _materiales_test() -> void:
	await get_tree().create_timer(2.0).timeout
	var cuenta := {}
	for m in range(1, 256):
		var i: Dictionary = world.get_material_info(m)
		if i.is_empty():
			continue
		var k := "%s|%d" % [String(i.get("class", "?")), int(i.get("strength", 0))]
		cuenta[k] = int(cuenta.get(k, 0)) + 1
	var ks: Array = cuenta.keys()
	ks.sort()
	print("[materiales] %s: %d combinaciones distintas" % [current_map, ks.size()])
	for k in ks:
		var p2: PackedStringArray = String(k).split("|")
		var golpes := 3 if String(p2[0]) == "metal" else (2 if String(p2[0]) in ["stone", "concrete", "anchor"] else 1)
		print("   clase %-9s dureza %3s -> %2d materiales -> %d golpe(s) de mazo" % [p2[0], p2[1], cuenta[k], golpes])
	get_tree().quit()


## --tirolan: EL DISPARO ENTRE JUGADORES, DE PUNTA A PUNTA EN RED. Es la prueba que de verdad dice si
## el servidor autoritativo funciona: el invitado apunta al anfitrion y dispara, y lo que hay que ver
## es que la vida la quita EL ANFITRION tras rebobinar, no el que disparo.
## --mesamazo=N: LA MESA A GOLPES, como la corta el jugador. Se sierran N patas (las del lado -x primero)
## con golpes de mazo de verdad (el mismo carve_beam de _mazazo_pared), uno por segundo, y despues se
## mira 25 s que hace el tablero: si se queda, si cae recto o si vuelca hacia donde ya no hay patas.
## Con VX_LOGSTRUCT=1/2 en el entorno, el analizador cuenta sus decisiones.
func _mesa_mazo_test(n: int) -> void:
	await get_tree().create_timer(3.0).timeout
	player.invulnerable = true
	# JUNTO A LA MESA, como quien la pica: el mundo solo rehace la colision de Jolt cerca del jugador, y a
	# 14 m el tablero soltado se quedaba atrapado dentro de su propia colision vieja
	player.global_position = Vector3(11.0, 1.0, 17.5)
	var patas: Array = [Vector3(-3, 0, -3), Vector3(-3, 0, 3), Vector3(3, 0, -3), Vector3(3, 0, 3)]
	# --mesaorden=3,1,0: que patas y en que orden (0 -x-z, 1 -x+z, 2 +x-z, 3 +x+z). Por defecto las del lado -x
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--mesaorden="):
			var orden: Array = []
			for k in a.substr(12).split(","):
				orden.append(patas[int(k)])
			patas = orden
			n = mini(n, patas.size())
	var t0 := Time.get_ticks_msec()
	# --mesarapido: todas las patas en el mismo frame (un solo evento para el analizador)
	var rapido: bool = "--mesarapido" in OS.get_cmdline_user_args()
	for i in n:
		var c: Vector3 = Vector3(11.0, 0.0, 11.0) + patas[i]
		# un tajo de lado a lado a 1,6 m, en dos alturas: de un golpe no se corta una pata de 80 cm
		var golpes := 0
		# --mesatajo=alto: un tajo de ~80 cm, como el que deja el mazo a golpes (las patas al 82 %)
