## --tiendalan: LA TIENDA Y LA PALANCA DEL JEFE, EN RED.
##
## Tres cosas que pidio el usuario de una vez:
##   1. "cuando compro botiquin los jugadores no ven que spawnearon botiquines en el piso, no los
##      pueden agarrar" -> los compra el INVITADO y se cuentan en las dos maquinas; despues los
##      recoge el anfitrion y tienen que desaparecer tambien en la del invitado;
##   2. "agrega un boton para empezar la oleada 10 de una" -> la palanca tiene que existir en las dos
##      pantallas y en el MISMO sitio (antes por red solo viajaban dos puestos);
##   3. "en la oleada 10 no tienen que spawnear criaturas, solo el boss".
func _tienda_lan_test() -> void:
	await get_tree().create_timer(16.0).timeout
	if not Net.is_online() or pve == null:
		print("[tienda] FALLO: hace falta LAN y mapa de oleadas")
		get_tree().quit(1)
		return
	var quien := "ANFITRION" if Net.hosting else "INVITADO"
	if is_instance_valid(player):
		player.invulnerable = true
	# el oro no puede ser el problema de la prueba
	if Net.hosting:
		pve.oro = 99999
	await get_tree().create_timer(3.0).timeout
	var cajas := func() -> Array:
		var l: Array = []
		for n in (pve.get("_botiquines") as Dictionary).values():
			if is_instance_valid(n):
				l.append(n)
		return l
	# ---- 2. la palanca, donde este
	var palanca := Vector3.INF
	for p in (pve.get("_puestos") as Array):
		if String(p["id"]) == "jefe" and is_instance_valid(p["nodo"]):
			palanca = (p["nodo"] as Node3D).global_position
	var tienda := Vector3.INF
	for p in (pve.get("_puestos") as Array):
		if String(p["id"]) == "tienda" and is_instance_valid(p["nodo"]):
			tienda = (p["nodo"] as Node3D).global_position
	print("[tienda] %s: palanca del jefe %s · a %.2f m de la tienda" % [
		quien, "SI" if palanca != Vector3.INF else "NO", palanca.distance_to(tienda) if palanca != Vector3.INF else -1.0])
	print("[tienda] %s: palanca en %.1f,%.1f,%.1f" % [quien, palanca.x, palanca.y, palanca.z])
	if not Net.hosting:
		# ---- 1. EL INVITADO COMPRA
		pve._comprar("botiquin")
		print("[tienda] INVITADO: compro un botiquin")
		await get_tree().create_timer(4.0).timeout
		print("[tienda] INVITADO: veo %d botiquines" % cajas.call().size())
		await get_tree().create_timer(10.0).timeout
		print("[tienda] INVITADO: tras recogerlos el anfitrion veo %d botiquines" % cajas.call().size())
		# ---- el cartel de arriba: ¿PARPADEA? Se mira cien veces en cinco segundos, con la oleada en
		#      marcha, y se cuentan las que esta vacio.
		await get_tree().create_timer(14.0).timeout
		var vacias := 0
		var muestras := 0
		for _m in 100:
			await get_tree().create_timer(0.05).timeout
			muestras += 1
			if String(hud.objective_label.text) == "":
				vacias += 1
		print("[tienda] INVITADO: cartel de arriba vacio en %d de %d muestras · dice «%s»" % [
			vacias, muestras, String(hud.objective_label.text)])
		await get_tree().create_timer(12.0).timeout
		# ---- 3. la oleada del jefe, contada desde aqui tambien
		var tipos_i := {}
		for c in get_tree().get_nodes_in_group("criaturas"):
			if is_instance_valid(c):
				tipos_i[String(c.get("tipo"))] = int(tipos_i.get(String(c.get("tipo")), 0)) + 1
		print("[tienda] INVITADO: en la oleada del jefe veo %s · contador de bajas %d · bajas del modo %d" % [
			str(tipos_i), int(hud._kills), int(pve.bajas)])
		get_tree().quit(0)
		return
	# ANFITRION
	await get_tree().create_timer(4.0).timeout
	var vistas: Array = cajas.call()
	print("[tienda] ANFITRION: veo %d botiquines (los compro el invitado)" % vistas.size())
	# los recojo todos: me hiero y me paso por encima de cada uno
	for b in vistas:
		player.health = 20.0
		player.global_position = (b as Node3D).global_position
		for _f in 6:
			await get_tree().process_frame
	await get_tree().create_timer(2.0).timeout
	print("[tienda] ANFITRION: tras recogerlos me quedan %d" % cajas.call().size())
	# ---- el contador de bajas necesita bajas: una oleada normal, y se mata a tres
	pve.empezar_ya()
	for _w in 30:
		await get_tree().create_timer(1.0).timeout
		if (pve.get("_vivos") as Array).size() >= 3:
			break
	await get_tree().create_timer(10.0).timeout     # el invitado mide el cartel mientras tanto
	var muertos := 0
	for c in (pve.get("_vivos") as Array).duplicate():
		if muertos >= 3:
			break
		if is_instance_valid(c):
			c.take_damage(1.0e9)
			muertos += 1
	await get_tree().create_timer(1.0).timeout
	print("[tienda] ANFITRION: he matado %d · contador de bajas %d · bajas del modo %d" % [
		muertos, int(hud._kills), int(pve.bajas)])
	# el resto, fuera, para volver a estar entre oleadas
	for c in (pve.get("_vivos") as Array).duplicate():
		if is_instance_valid(c):
			c.take_damage(1.0e9)
	pve.set("_cola", [])
	for _w in 20:
		await get_tree().create_timer(1.0).timeout
		if bool(pve.get("_esperando")):
			break
	# ---- 3. palanca del jefe
	await get_tree().create_timer(2.0).timeout
	print("[tienda] ANFITRION: esperando entre oleadas=%s · salto al jefe" % str(bool(pve.get("_esperando"))))
	pve.empezar_ya(10)
	var tipos := {}
	for _w in 30:
		await get_tree().create_timer(1.0).timeout
		if not get_tree().get_nodes_in_group("criaturas").is_empty():
			break
	await get_tree().create_timer(8.0).timeout
	for c in get_tree().get_nodes_in_group("criaturas"):
		if is_instance_valid(c):
			tipos[String(c.get("tipo"))] = int(tipos.get(String(c.get("tipo")), 0)) + 1
	print("[tienda] ANFITRION: oleada %d · criaturas %s" % [int(pve.oleada), str(tipos)])
	await get_tree().create_timer(6.0).timeout
	get_tree().quit(0)


## --migrapve: SE VA EL ANFITRION EN MITAD DE UNA OLEADA. ¿SIGUE LA PARTIDA?
##
## Lo conto el usuario: "si el host se va del juego no pasa a ser host otro jugador, el juego quedo
## roto, no funcionaba nada". La prueba de relevo que habia (--migratest) usaba el mapa de pruebas,
## sin criaturas ni bots, y pasaba: justo lo que se rompia no estaba en la prueba.
##
## Se mide en el que toma el relevo: que se crea anfitrion TAMBIEN dentro del modo oleadas, que las
## criaturas sigan ahi, que PIENSEN (ya no son copias) y que SE MUEVAN.
func _migra_pve_test() -> void:
	await get_tree().create_timer(14.0).timeout
	if not Net.is_online() or pve == null:
		print("[migrapve] FALLO: hace falta LAN y mapa de oleadas")
		get_tree().quit(1)
		return
	if is_instance_valid(player):
		player.invulnerable = true
	var quien := "ANFITRION" if Net.hosting else "INVITADO %d" % multiplayer.get_unique_id()
	if Net.hosting:
		if pve.has_method("_empezar_oleada"):
			pve._empezar_oleada()
		for _e in 40:
			await get_tree().create_timer(1.0).timeout
			if (pve.get("_vivos") as Array).size() >= 3:
				break
		await get_tree().create_timer(6.0).timeout
		print("[migrapve] ANFITRION: %d criaturas en pie · me caigo AHORA" % (pve.get("_vivos") as Array).size())
		OS.kill(OS.get_process_id())
		return
	# los invitados esperan al relevo
	var era_host := false
	for i in 70:
		await get_tree().create_timer(1.0).timeout
		if Net.hosting:
			era_host = true
			break
		if i > 55:
			break
	if not era_host:
		# no me ha tocado a mi: aguanto y me voy
		await get_tree().create_timer(10.0).timeout
		print("[migrapve] %s: no soy el sucesor · online=%s" % [quien, str(Net.is_online())])
		get_tree().quit(0)
		return
	await get_tree().create_timer(4.0).timeout
	var soy_host_pve: bool = bool(pve.get("_soy_host"))
	var copias := 0
	var piensan := 0
	var pos0 := {}
	for c in get_tree().get_nodes_in_group("criaturas"):
		if not is_instance_valid(c) or bool(c.get("muerta")):
			continue
		if bool(c.get("remota")):
			copias += 1
		else:
			piensan += 1
		pos0[c] = (c as Node3D).global_position
	await get_tree().create_timer(5.0).timeout
	var se_mueven := 0
	for c in pos0.keys():
		if is_instance_valid(c) and (c as Node3D).global_position.distance_to(pos0[c]) > 0.5:
			se_mueven += 1
	print("[migrapve] SUCESOR: red hosting=%s · pve _soy_host=%s · criaturas: %d piensan, %d copias sin cerebro · %d se han movido en 5 s" % [
		str(Net.hosting), str(soy_host_pve), piensan, copias, se_mueven])
	var fallos := 0
	if not soy_host_pve:
		print("[migrapve] MAL: la red dice que mando yo, pero el modo oleadas sigue creyendose invitado")
		fallos += 1
	if piensan + copias == 0:
		print("[migrapve] MAL: las criaturas han desaparecido al irse el anfitrion")
		fallos += 1
	if copias > 0:
		print("[migrapve] MAL: quedan %d copias sin cerebro" % copias)
		fallos += 1
	if piensan > 0 and se_mueven == 0:
		print("[migrapve] MAL: hay criaturas pero ninguna se mueve")
		fallos += 1
	if fallos == 0:
		print("[migrapve] BIEN: la partida sigue, y las criaturas son mias y se mueven")
	print("[migrapve] %s (%d fallos)" % ["TODO BIEN" if fallos == 0 else "HAY FALLOS", fallos])
	get_tree().quit(0 if fallos == 0 else 1)


## --cadavercae: ¿SE CAE EL CADAVER DE UN COMPAÑERO, Y REVIVE EL ANFITRION AL SUPERAR LA OLEADA?
##
## Dos cosas que pidio el usuario en el mismo mensaje:
##   1. "si un compañero muere quiero que su cuerpo caiga con fisicas, que no quede flotando";
##   2. "hay un error al terminar la horda, no respawnea, sigue espectando".
##
## Para lo primero se mata al invitado EN EL AIRE -que es cuando se ve el fallo- y se mira desde el
## anfitrion cuanto baja su avatar. Para lo segundo muere el ANFITRION, que era el caso roto: el aviso
## de revivir lo emitia el mismo y en su maquina no habia nadie escuchando.
func _cadaver_cae_test() -> void:
	await get_tree().create_timer(16.0).timeout
	if not Net.is_online() or pve == null:
		print("[cadaver] FALLO: hace falta LAN y mapa de oleadas")
		get_tree().quit(1)
		return
	if not Net.hosting:
		# el invitado se sube al aire y se muere ahi
		if is_instance_valid(player):
			player.global_position += Vector3(0, 6.0, 0)
			await get_tree().create_timer(0.2).timeout
			if player.has_method("die"):
				player.die()
			print("[cadaver] INVITADO: muerto a 6 m del suelo")
		await get_tree().create_timer(40.0).timeout
		get_tree().quit(0)
		return
	# ANFITRION: mira caer el cadaver del otro
	var r = null
	for _w in 30:
		await get_tree().create_timer(1.0).timeout
		for x in Net.remotes.values():
			if is_instance_valid(x) and bool(x.dead):
				r = x
		if r != null:
			break
	if r == null:
		print("[cadaver] FALLO: el companero no ha muerto")
		get_tree().quit(1)
		return
	await get_tree().create_timer(4.0).timeout
	var fallos := 0
	# EL CUERPO, HUESO A HUESO. Con ragdoll el nodo se queda donde murio y lo que cae son los huesos,
	# asi que la altura del nodo ya no dice nada: se mira donde estan la cabeza, el pecho y el hueso
	# mas bajo, en el mundo.
	var av = r.avatar
	var con_ragdoll: bool = "_ragdoll" in r and is_instance_valid(r._ragdoll)
	if av == null or av.skeleton == null:
		print("[cadaver] FALLO: el avatar del companero no tiene esqueleto")
		get_tree().quit(1)
		return
	var sk: Skeleton3D = av.skeleton
	var mundo_hueso := func(nombre: String) -> Vector3:
		if not av.bone_idx.has(nombre):
			return Vector3(INF, INF, INF)
		return (sk.global_transform * sk.get_bone_global_pose(int(av.bone_idx[nombre]))).origin
	var cabeza: Vector3 = mundo_hueso.call("head")
	var cuello: Vector3 = mundo_hueso.call("neck")
	var pecho: Vector3 = mundo_hueso.call("chest")
	var mas_bajo := INF
	for bn in av.bone_idx.keys():
		mas_bajo = minf(mas_bajo, (mundo_hueso.call(String(bn)) as Vector3).y)
	var suelo := -INF
	var rs: Dictionary = world.raycast(Vector3(pecho.x, pecho.y + 1.0, pecho.z), Vector3.DOWN, 30.0)
	if bool(rs.get("hit", false)):
		suelo = float((rs["position"] as Vector3).y)
	print("[cadaver] ragdoll=%s · hueso mas bajo a %.2f m del suelo · cabeza-cuello %.2f m · cabeza-pecho %.2f m" % [
		str(con_ragdoll), mas_bajo - suelo, cabeza.distance_to(cuello), cabeza.distance_to(pecho)])
	if not con_ragdoll:
		print("[cadaver] MAL: el cadaver no cae con fisicas (sin ragdoll)")
		fallos += 1
	if mas_bajo - suelo > 0.6:
		print("[cadaver] MAL: el cuerpo se queda flotando (el hueso mas bajo a %.2f m del suelo)" % (mas_bajo - suelo))
		fallos += 1
	else:
		print("[cadaver] BIEN: el cuerpo esta en el suelo")
	# LA CABEZA: vivo, del hueso de la cabeza al del pecho hay unos 0,3 m. Si se mete dentro del torso,
	# esa distancia se hunde. Por debajo de 0,15 m es que la cabeza no se ve.
	if cabeza.distance_to(pecho) < 0.15:
		print("[cadaver] MAL: la cabeza esta metida dentro del pecho")
		fallos += 1
	else:
		print("[cadaver] BIEN: la cabeza sigue en su sitio")
	# Y AHORA EL ANFITRION SE MUERE Y SE SUPERA LA OLEADA: tiene que volver a la pelea.
	if is_instance_valid(player) and player.has_method("die"):
		player.die()
		await get_tree().create_timer(2.0).timeout
		print("[cadaver] ANFITRION: muerto, espectando=%s" % str(bool(player.spectating)))
	if pve.has_method("_revivir_caidos"):
		Net.net_revivir_caidos()
		await get_tree().create_timer(3.0).timeout
	var sigo: bool = "spectating" in player and bool(player.spectating)
	print("[cadaver] ANFITRION tras el aviso de revivir: espectando=%s vida=%.0f" % [
		str(sigo), player.health])
	if sigo:
		print("[cadaver] MAL: el anfitrion no revive al superar la oleada")
		fallos += 1
	else:
		print("[cadaver] BIEN: el anfitrion vuelve a la pelea")
	print("[cadaver] %s (%d fallos)" % ["TODO BIEN" if fallos == 0 else "HAY FALLOS", fallos])
	get_tree().quit(0 if fallos == 0 else 1)


## --tirozombi: SI UN INVITADO LE PEGA A UN ZOMBI, ¿SE ENTERA EL ANFITRION?
##
## Lo conto el usuario: "mato a zombis y ellos los siguen viendo vivos". La vida de un bicho la lleva
## el anfitrion, pero el daño del invitado no salia de su maquina: le bajaba la vida A SU COPIA. En su
## pantalla el bicho moria; en las demas seguia vivo y pegando.
##
## Se mide la vida del MISMO bicho (el de numero de red mas bajo) en las dos maquinas antes y despues
## de que el invitado le meta un tiro.
func _tiro_zombi_test() -> void:
	await get_tree().create_timer(16.0).timeout
	if not Net.is_online() or pve == null:
		print("[tirozombi] FALLO: hace falta LAN y mapa de oleadas")
		get_tree().quit(1)
		return
	var quien := "ANFITRION" if Net.hosting else "INVITADO"
	if is_instance_valid(player):
		player.invulnerable = true
	if Net.hosting and pve.has_method("_empezar_oleada"):
		pve._empezar_oleada()
	for _e in 40:
		await get_tree().create_timer(1.0).timeout
		if not get_tree().get_nodes_in_group("criaturas").is_empty():
			break
	await get_tree().create_timer(6.0).timeout
	var bicho: Node3D = null
	var mejor := 1 << 30
	for n in get_tree().get_nodes_in_group("criaturas"):
		if not is_instance_valid(n) or bool(n.get("muerta")):
			continue
		var rid := int(n.get("red_id"))
		if rid >= 0 and rid < mejor:
			mejor = rid
			bicho = n
	if bicho == null:
		print("[tirozombi] %s FALLO: no hay bicho" % quien)
		get_tree().quit(1)
		return
	var vida0: float = float(bicho.get("vida"))
	print("[tirozombi] %s: bicho %d con %.0f de vida" % [quien, mejor, vida0])
	if not Net.hosting:
		# EL INVITADO LE PEGA. Se usa `take_damage` directamente para no depender de la punteria: lo
		# que se prueba es el CAMINO del daño, no si la bala acierta.
		bicho.take_damage(40.0, Vector3(0, 0, 1))
		print("[tirozombi] INVITADO: le he metido 40 de daño")
	await get_tree().create_timer(4.0).timeout
	var vida1: float = float(bicho.get("vida")) if is_instance_valid(bicho) else -1.0
	print("[tirozombi] %s: vida %.0f -> %.0f" % [quien, vida0, vida1])
	if Net.hosting:
		if vida1 < vida0 - 1.0:
			print("[tirozombi] BIEN: el daño del invitado le ha llegado al anfitrion")
			get_tree().quit(0)
		else:
			print("[tirozombi] MAL: el invitado le pego y aqui el bicho sigue entero")
			get_tree().quit(1)
	else:
		if vida1 < vida0 - 1.0:
			print("[tirozombi] (en el invitado la vida tambien baja: se la manda el anfitrion)")
		else:
			print("[tirozombi] (en el invitado la vida no baja aqui: la lleva el anfitrion)")
		await get_tree().create_timer(6.0).timeout
		get_tree().quit(0)


## --zurranalmuerto: ¿A QUIEN LE PEGAN LOS ZOMBIS CUANDO CAE UN COMPAÑERO?
##
## Lo conto el usuario: "el me esta espectando, pero yo veo su avatar y los zombis le siguen pegando
## al avatar ahi quieto". Dos agujeros encadenados: el avatar de un amigo NO TIENE vida -la lleva su
## maquina-, asi que la criatura lo daba por vivo siempre; y al elegir objetivo se partia del objetivo
## ACTUAL, asi que en cuanto ese objetivo era el amigo muerto se perdia la referencia al jugador de
## casa y no habia a quien cambiar.
##
## Se cuenta lo unico que importa: de las criaturas vivas, a cuantas tienen por objetivo al MUERTO y a
## cuantas al vivo. Y despues de revivir, que el avatar deje de estar desplomado.
func _zurran_al_muerto_test() -> void:
	await get_tree().create_timer(16.0).timeout
	if not Net.is_online() or pve == null:
		print("[zurran] FALLO: hace falta LAN y mapa de oleadas")
		get_tree().quit(1)
		return
	if not Net.hosting:
		if is_instance_valid(player) and player.has_method("die"):
			player.die()
			print("[zurran] INVITADO: muerto, espectando=%s" % str(bool(player.spectating)))
		await get_tree().create_timer(24.0).timeout
		# y revive, para mirar si en la otra pantalla se levanta
		if is_instance_valid(player) and player.has_method("revivir_en_oleada"):
			player.revivir_en_oleada()
			print("[zurran] INVITADO: revivido, vida=%.0f" % player.health)
		await get_tree().create_timer(14.0).timeout
		get_tree().quit(0)
		return
	if is_instance_valid(player):
		player.invulnerable = true
	if pve.has_method("_empezar_oleada"):
		pve._empezar_oleada()
	for _e in 40:
		await get_tree().create_timer(1.0).timeout
		if not get_tree().get_nodes_in_group("criaturas").is_empty():
			break
	await get_tree().create_timer(8.0).timeout
	var muerto = null
	for r in Net.remotes.values():
		if is_instance_valid(r):
			muerto = r
	if muerto == null:
		print("[zurran] FALLO: no veo el avatar del companero")
		get_tree().quit(1)
		return
	var cuenta := func(etq: String) -> Array:
		var al_muerto := 0
		var a_mi := 0
		var otros := 0
		for c in get_tree().get_nodes_in_group("criaturas"):
			if not is_instance_valid(c) or bool(c.get("muerta")):
				continue
			var obj = c.get("jugador")
			if obj == muerto:
				al_muerto += 1
			elif obj == player:
				a_mi += 1
			else:
				otros += 1
		print("[zurran] %s: %d bichos van al MUERTO · %d a mi · %d a otra cosa · su avatar dead=%s" % [
			etq, al_muerto, a_mi, otros, str(bool(muerto.dead))])
		return [al_muerto, a_mi]
	var a: Array = cuenta.call("con el companero muerto")
	await get_tree().create_timer(10.0).timeout
	var b: Array = cuenta.call("diez segundos despues")
	var fallos := 0
	if int(a[0]) > 0 or int(b[0]) > 0:
		print("[zurran] MAL: hay bichos pegandole a un muerto")
		fallos += 1
	else:
		print("[zurran] BIEN: ningun bicho le pega al muerto")
	if int(b[1]) == 0:
		print("[zurran] MAL: y tampoco vienen a por mi, que estoy vivo")
		fallos += 1
	else:
		print("[zurran] BIEN: los bichos vienen a por el que sigue en pie (%d)" % int(b[1]))
	# Y CUANDO REVIVE, QUE SE LEVANTE. Se ESPERA al cambio en vez de mirar a una hora fija: las dos
	# instancias no arrancan a la vez y mirando a ciegas se comprobaba antes de que el otro reviviera.
	var revivio := false
	for _w in 30:
		await get_tree().create_timer(1.0).timeout
		if not bool(muerto.dead):
			revivio = true
			break
	await get_tree().create_timer(1.0).timeout
	var tieso: bool = muerto.avatar != null and ("_limp_t" in muerto.avatar) and float(muerto.avatar._limp_t) >= 0.0
	print("[zurran] tras revivir: llego el aviso=%s dead=%s desplomado=%s" % [
		str(revivio), str(bool(muerto.dead)), str(tieso)])
	if not revivio:
		print("[zurran] (no llego a revivir en el tiempo de la prueba: el desplome no se puede juzgar)")
	if tieso:
		print("[zurran] MAL: revivio pero su avatar sigue desplomado")
		fallos += 1
	else:
		print("[zurran] BIEN: revivio y su avatar vuelve a estar de pie")
	print("[zurran] %s (%d fallos)" % ["TODO BIEN" if fallos == 0 else "HAY FALLOS", fallos])
	get_tree().quit(0 if fallos == 0 else 1)


## --muertopegado: ¿SE QUEDA EL MUERTO DONDE CAYO, O TE SIGUE?
##
## Lo conto el usuario: "en modo zombi, mate a un compañero, me estaba espectando, y su avatar
## aparecio". Al morir se pasa a mirar desde un compañero, y esa camara mueve EL CUERPO del jugador
## (`player.gd::_update_spectate`), que sigue mandando su sitio: el cadaver se levantaba y se te
## pegaba a la espalda.
##
## Se mide lo unico que importa: cuanto se mueve el avatar del muerto en la pantalla del vivo, y si la
## distancia entre los dos se queda clavada -senal de que te sigue- mientras el vivo se aleja.
func _muerto_pegado_test() -> void:
	await get_tree().create_timer(16.0).timeout
	if not Net.is_online():
		print("[pegado] FALLO: hace falta LAN")
		get_tree().quit(1)
		return
	if not Net.hosting:
		# EL INVITADO SE MUERE Y SE PONE A MIRAR. Es el papel del compañero del usuario.
		if is_instance_valid(player) and player.has_method("die"):
			player.die()
			print("[pegado] INVITADO: muerto y espectando=%s" % str(bool(player.spectating)))
		await get_tree().create_timer(30.0).timeout
		get_tree().quit(0)
		return
	# EL ANFITRION sigue vivo y se va andando: si el cadaver le sigue, se vera.
	if is_instance_valid(player):
		player.invulnerable = true
	await get_tree().create_timer(4.0).timeout
	var r = null
	for x in Net.remotes.values():
		if is_instance_valid(x):
			r = x
	if r == null:
		print("[pegado] FALLO: no veo el avatar del companero")
		get_tree().quit(1)
		return
	var donde_cayo: Vector3 = r.global_position
	var yo0: Vector3 = player.global_position
	print("[pegado] ANFITRION: el companero cayo en %.1f,%.1f,%.1f" % [
		donde_cayo.x, donde_cayo.y, donde_cayo.z])
	var mal := 0
	for paso in 6:
		# me alejo cuatro metros de golpe, seis veces
		player.global_position += Vector3(4.0, 0.0, 0.0)
		await get_tree().create_timer(2.0).timeout
		var movido: float = r.global_position.distance_to(donde_cayo)
		var a_mi: float = r.global_position.distance_to(player.global_position)
		print("[pegado] paso %d: yo a %.1f m de donde cayo · su avatar se ha movido %.2f m · lo tengo a %.1f m" % [
			paso + 1, player.global_position.distance_to(yo0), movido, a_mi])
		if movido > 2.0:
			mal += 1
	if mal == 0:
		print("[pegado] BIEN: el muerto se queda donde cayo")
	else:
		print("[pegado] MAL: el cadaver se ha movido en %d de 6 pasos (te sigue)" % mal)
	get_tree().quit(0 if mal == 0 else 1)


## --zombicadaver: AL MATAR UN ZOMBI, ¿QUE QUEDA EN EL SITIO?
##
## Lo conto el usuario: "al matar un zombi aparece en su lugar de muerte un avatar del soldado". En vez
## de adivinar quien lo crea, se mata un bicho a proposito y se hace un CENSO de todo lo que hay
## alrededor del punto de la muerte, antes y despues, con su clase y su script. Lo que salga de mas es
## el culpable, y con nombre y apellidos.
func _zombi_cadaver_test() -> void:
	await get_tree().create_timer(10.0).timeout
	if pve == null:
		print("[zcad] FALLO: no hay PvE (hace falta --map=pve_cuarentena)")
		get_tree().quit(1)
		return
	# LA OLEADA LA LANZA EL ANFITRION. Llamandolo en las dos maquinas, el invitado se ponia a sacar
	# criaturas SUYAS -las oleadas son del anfitrion- y la prueba medía dos partidas superpuestas.
	if (not Net.is_online() or Net.hosting) and pve.has_method("_empezar_oleada"):
		pve._empezar_oleada()
	# LA SIRENA DURA QUINCE SEGUNDOS antes de que salga el primer bicho, asi que esperando diez no
	# habia a quien matar y la prueba se rendia sin probar nada.
	for _esp in 30:
		await get_tree().create_timer(1.0).timeout
		if not get_tree().get_nodes_in_group("criaturas").is_empty():
			break
	await get_tree().create_timer(3.0).timeout
	# LA MISMA VICTIMA EN LAS DOS MAQUINAS: la de numero de red mas bajo. Asi el invitado puede hacer
	# el censo alrededor del mismo bicho sin que nadie le diga cual es.
	var victima: Node3D = null
	var mejor := 1 << 30
	for n in get_tree().get_nodes_in_group("criaturas"):
		if not is_instance_valid(n) or bool(n.get("muerta")):
			continue
		var rid := int(n.get("red_id"))
		if rid >= 0 and rid < mejor:
			mejor = rid
			victima = n
	if victima == null:
		print("[zcad] FALLO: no hay ningun bicho vivo que matar (grupo=%d vivos=%d cola=%d esperando=%s alarma=%.1f)" % [
			get_tree().get_nodes_in_group("criaturas").size(),
			(pve.get("_vivos") as Array).size(), (pve.get("_cola") as Array).size(),
			str(bool(pve.get("_esperando"))), float(pve.get("_alarma_t"))])
		get_tree().quit(1)
		return
	var sitio: Vector3 = victima.global_position
	print("[zcad] victima: %s (%s) en %.1f,%.1f,%.1f" % [
		victima.name, String(victima.get("tipo")), sitio.x, sitio.y, sitio.z])
	var censo := func(etq: String) -> void:
		var cerca: Array = []
		# el arbol entero, a mano: `_all_nodes` es del lobby y aqui no existe
		var pila: Array = [get_tree().current_scene]
		var todos: Array = []
		while not pila.is_empty():
			var nd: Node = pila.pop_back()
			if nd == null:
				continue
			todos.append(nd)
			pila.append_array(nd.get_children())
		for n in todos:
			if not (n is Node3D) or not is_instance_valid(n):
				continue
			var d: float = (n as Node3D).global_position.distance_to(sitio)
			if d > 5.0:
				continue
			var scr := ""
			if n.get_script() != null:
				scr = String(n.get_script().resource_path).get_file()
			cerca.append("%s[%s%s] a %.1fm" % [n.name, n.get_class(), ("/" + scr) if scr != "" else "", d])
		print("[zcad] %s: %d nodos a menos de 5 m" % [etq, cerca.size()])
		for c in cerca:
			print("[zcad]    %s" % c)
	var quien := "SOLO"
	if Net.is_online():
		quien = "ANFITRION" if Net.hosting else "INVITADO"
	print("[zcad] %s: la victima es el bicho %d" % [quien, mejor])
	censo.call("ANTES de morir")
	# MATA EL ANFITRION, que es quien lleva la vida de los bichos. El invitado solo mira: lo que
	# interesa es si en SU pantalla aparece algo que no estaba.
	if not Net.is_online() or Net.hosting:
		victima.take_damage(1.0e9, Vector3(0, 1, 0))
	await get_tree().create_timer(3.0).timeout
	censo.call("3 s DESPUES")
	await get_tree().create_timer(8.0).timeout
	censo.call("11 s DESPUES")
	get_tree().quit(0)


## --muertepve: CON BANDO PUESTO, ¿SE ENTERA EL MODO OLEADAS DE QUE HE MUERTO?
##
## `player.die()` tiene varios caminos y solo uno avisa a `pve.gd`. El del modo bomba -espectar y
## callar- se elegia con solo tener bando, y desde que las salas online reparten bando solas SIEMPRE
## se tiene: en una partida de zombis morias, te quedabas de espectador y la partida no se acababa
## nunca, porque nadie habia contado tu muerte. Es lo que conto el usuario: "el espectador quedo
## espectando, no lo llevo a la pantalla de derrota".
##
## Se prueba en solitario, que es donde la respuesta es inmediata: sin compañeros, caer YO es perder,
## asi que `pve.terminado` tiene que ponerse en cuanto muero. Una sola instancia, sin red.
func _muerte_pve_test() -> void:
	await get_tree().create_timer(10.0).timeout
	if pve == null:
		print("[muertepve] FALLO: no hay PvE (mapa %s; hace falta --map=pve_cuarentena)" % current_map)
		get_tree().quit(1)
		return
	# CON BANDO, que es lo que dispara el fallo. Sin bando el jugador cae por el camino bueno de
	# casualidad y la prueba pasaria sin haber probado nada.
	player.team = Net.TEAM_T
	Net.round_live = true
	Net._bandos_de_ronda.clear()
	print("[muertepve] bando='%s' round_live=%s terminado=%s" % [
		player.team, str(Net.round_live), str(pve.terminado)])
	player.die()
	await get_tree().create_timer(2.0).timeout
	var espect: bool = "spectating" in player and bool(player.spectating)
	var fin: bool = "terminado" in pve and bool(pve.terminado)
	print("[muertepve] tras morir: espectando=%s · partida terminada=%s" % [str(espect), str(fin)])
	if fin:
		print("[muertepve] BIEN: el modo oleadas se entero de la muerte")
	else:
		print("[muertepve] MAL: muerto y espectando para siempre, sin pantalla de derrota")
	get_tree().quit(0 if fin else 1)


## --botspegados: ¿NACEN LOS BOTS UNOS ENCIMA DE OTROS?
##
## Lo conto el usuario: "los bot aparecen pegados, 2 pegados; uno camina y el otro queda pegado en su
## espalda". Los bots no se empujan -se mueven leyendo voxels, sin fisica-, asi que si nacen en el
## mismo punto se quedan uno DENTRO de otro hasta que a uno le toca irse andando.
##
## Se mide lo unico que importa: la distancia del par MAS CERCANO, al nacer y un rato despues.
func _bots_pegados_test() -> void:
	await get_tree().create_timer(6.0).timeout
	# SIN BANDO NO HAY BOTS: en bomba el juego espera a que elijas, y una prueba no tiene dedos. Se
	# elige bando y se pide la cuadrilla a mano.
	if enemies != null and enemies.get_child_count() == 0:
		Net.choose_team(Net.TEAM_T)
		await get_tree().create_timer(1.0).timeout
		spawn_enemies()
		await get_tree().create_timer(2.0).timeout
	var pegados := func() -> Array:
		var peor := 1e9
		var cerca := 0
		var lista: Array = []
		for e in enemies.get_children():
			if is_instance_valid(e) and e is Node3D:
				lista.append(e.global_position)
		for i in lista.size():
			for j in range(i + 1, lista.size()):
				var d: float = Vector2(lista[i].x - lista[j].x, lista[i].z - lista[j].z).length()
				peor = minf(peor, d)
				if d < 0.7:
					cerca += 1
		return [lista.size(), peor, cerca]
	var a0: Array = pegados.call()
	print("[pegados] al nacer: %d bots · par mas cercano %.2f m · %d pares a menos de 0,70 m" % [
		int(a0[0]), float(a0[1]), int(a0[2])])
	await get_tree().create_timer(15.0).timeout
	var a1: Array = pegados.call()
	print("[pegados] a los 15 s: %d bots · par mas cercano %.2f m · %d pares a menos de 0,70 m" % [
		int(a1[0]), float(a1[1]), int(a1[2])])
	var mal: int = int(a0[2]) + int(a1[2])
	print("[pegados] %s (%d pares pegados)" % ["BIEN: ninguno encima de otro" if mal == 0 else "MAL", mal])
	get_tree().quit(0 if mal == 0 else 1)


## --eliminatest: ¿SE ACABA LA RONDA DEJANDO BOTS VIVOS?
##
## Lo conto el usuario: "cuando un jugador real muere gana las partidas pero los bot siguen vivos, no
## los cuentan". El arbitraje miraba `players`, que son PERSONAS: en cuanto caia el unico humano de un
## bando, ese bando se daba por eliminado con sus cinco bots en pie.
##
## HACE FALTA SALA DE VERDAD, aunque no haya nadie dentro: sin red, `alive_count` tiene un atajo que
## devuelve 1 siempre -en solitario no hay bandos que contar- y la prueba estaria midiendo el atajo y
## no el arreglo. Se lanza junto a `--lanhost=`:
##   Godot --headless --path godot -- --lanhost=sala --lanmap=dust2 --eliminatest
func _elimina_test() -> void:
	await get_tree().create_timer(8.0).timeout
	var fallos := 0
	if not Net.is_online():
		print("[elimina] FALLO: hace falta --lanhost=, sin red la cuenta no se puede probar")
		get_tree().quit(1)
		return
	var acabo := {"si": false}
	Net.round_over.connect(func(_w: String, _r: String): acabo["si"] = true)
	# un humano en cada bando, los dos vivos, y cinco bots de los T
	Net.round_live = true
	Net._bandos_de_ronda.clear()
	Net.dm_mode = false
	Net.players = {1: {"name": "anfitrion", "team": Net.TEAM_T}, 2: {"name": "amigo", "team": Net.TEAM_CT}}
	Net.dead_players = {}
	Net.bots_por_bando = {Net.TEAM_T: 5, Net.TEAM_CT: 0}
	# cae el UNICO humano de los T: con cinco bots suyos vivos la ronda NO se puede acabar
	Net.dead_players[1] = true
	Net.revisar_eliminacion()
	if acabo["si"]:
		print("[elimina] FALLO: ronda terminada con 5 bots del bando en pie")
		fallos += 1
	else:
		print("[elimina] OK  muere el humano y la ronda sigue: quedan %d bots" % Net.en_pie(Net.TEAM_T))
	# y ahora caen tambien los bots: ahi si se acaba
	Net.bots_por_bando = {Net.TEAM_T: 0, Net.TEAM_CT: 0}
	Net.revisar_eliminacion()
	if acabo["si"]:
		print("[elimina] OK  sin humano y sin bots, la ronda se acaba")
	else:
		print("[elimina] FALLO: bando entero eliminado y la ronda no acaba")
		fallos += 1
	print("[elimina] %s (%d fallos)" % ["TODO BIEN" if fallos == 0 else "HAY FALLOS", fallos])
	get_tree().quit(0 if fallos == 0 else 1)


## --empujetest: ¿NACEN ENCIMA UNO DE OTRO Y SE EMPUJAN?
##
## Lo conto el usuario: dos personas entran a una partida LAN y los personajes se empujan sin parar
## hasta que uno se aparta. Es lo que pasa cuando dos cuerpos nacen en el mismo punto.
##
## Se mide lo unico que importa: LA DISTANCIA entre los dos al nacer, y si se estan moviendo solos
## sin que nadie toque nada -que es el empuje-.
func _empuje_test() -> void:
	# LOS DOS EN EL MISMO BANDO, que es el caso que falla.
	#
	# Con el reparto automatico cada uno cae en un equipo distinto y nacen en bases opuestas, a
	# cincuenta metros: ahi no hay empuje que valga y la prueba pasaria sin haber probado nada.
	# Compartir base es lo que hace que se nazca uno encima de otro.
	await get_tree().create_timer(9.0).timeout
	Net.choose_team(Net.TEAM_T)
	await get_tree().create_timer(2.0).timeout
	spawn_at_team_base(Net.TEAM_T)
	await get_tree().create_timer(1.0).timeout
	if Net.remotes.is_empty():
		print("[empuje] esperando al otro jugador...")
		for i in 30:
			await get_tree().create_timer(1.0).timeout
			if not Net.remotes.is_empty():
				break
	if Net.remotes.is_empty():
		print("[empuje] FALLO: no ha entrado nadie, no se puede medir")
		get_tree().quit(1)
		return
	var otro = Net.remotes.values()[0]
	var d0: float = player.global_position.distance_to(otro.global_position)
	print("[empuje] al nacer estamos a %.2f m" % d0)

	# AHORA A LO BRUTO: EL ANFITRION SE PEGA AL OTRO.
	#
	# Es la unica forma de medir el empuje sin depender de en que equipo acabe cada uno. El invitado
	# se queda quieto -su posicion la manda el- y yo me pongo encima: si me desplazo solo, me esta
	# empujando. Lo hace el anfitrion porque el invitado no puede mover al otro.
	if not Net.hosting:
		await get_tree().create_timer(20.0).timeout
		get_tree().quit()
		return
	player.global_position = otro.global_position + Vector3(0.3, 0.0, 0.0)
	player.velocity = Vector3.ZERO
	await get_tree().create_timer(1.0).timeout
	var mi0: Vector3 = player.global_position
	print("[empuje] me he pegado al otro: %.2f m" % player.global_position.distance_to(otro.global_position))
	await get_tree().create_timer(6.0).timeout
	var corrido: float = mi0.distance_to(player.global_position)
	print("[empuje] sin tocar nada me he desplazado %.2f m" % corrido)
	var fallos := 0
	if d0 < 1.0:
		print("[empuje] FALLO: hemos nacido a menos de un metro (uno dentro del otro)")
		fallos += 1
	else:
		print("[empuje] OK  nacemos separados (%.2f m)" % d0)
	# pegados a proposito, lo sano es apartarse un poco y PARAR. Si sigue corriendo metros, es el
	# bucle que conto el usuario.
	if corrido > 3.0:
		print("[empuje] FALLO: el empuje no para (%.2f m y subiendo)" % corrido)
		fallos += 1
	else:
		print("[empuje] OK  estando pegados me aparto %.2f m y se acaba" % corrido)
	print("[empuje] %s (%d fallos)" % ["TODO BIEN" if fallos == 0 else "HAY FALLOS", fallos])
	get_tree().quit(0 if fallos == 0 else 1)


## --bombafin: ¿SE ACABA LA PARTIDA DE BOMBA Y SE COBRA?
##
## Era el unico modo sin final: las rondas se sumaban sin tope y nadie ganaba nada. Se le dan rondas
## al marcador hasta el objetivo y se mira que salga el podio y que el premio no sea cero.
func _bomba_fin_test() -> void:
	await get_tree().create_timer(4.0).timeout
	if not bomb_mode:
		print("[bombafin] FALLO: este mapa no es de bomba (%s)" % current_map)
		get_tree().quit(1)
		return
	var fallos := 0
	var exp0 := Settings.experiencia
	var oro0 := Settings.monedas
	# unas cuantas bajas para que la tabla tenga algo que enseñar
	_dm_anotar("Rival", Net.TEAM_CT, _mi_nombre(), Net.my_team())
	_dm_anotar("Rival", Net.TEAM_CT, _mi_nombre(), Net.my_team())
	print("[bombafin] rondas para ganar: %d · marcador %d-%d" % [
		RONDAS_PARA_GANAR, Net.score_t, Net.score_ct])

	# QUE GANE EL MIO. El premio solo se paga al que gana, asi que forzar el marcador de un bando sin
	# mirar en cual estoy medía "he perdido", que es justo el caso en que no se cobra nada.
	Net.choose_team(Net.TEAM_T)
	await get_tree().process_frame
	print("[bombafin] mi equipo: «%s» · modo pruebas: %s · cuenta: %s" % [
		Net.my_team(), str(Settings.modo_pruebas), "si" if Cuenta.conectado() else "no"])
	for i in RONDAS_PARA_GANAR:
		Net.score_t += 1
	_on_round_over(Net.TEAM_T, "prueba")
	await get_tree().create_timer(2.0).timeout

	if not _bomba_terminada:
		print("[bombafin] FALLO: se llego a %d rondas y la partida no acabo" % RONDAS_PARA_GANAR)
		fallos += 1
	else:
		print("[bombafin] OK  la partida acaba al llegar a %d rondas" % RONDAS_PARA_GANAR)
	if not hud.tiene_pantalla_victoria():
		print("[bombafin] FALLO: no hay pantalla de victoria")
		fallos += 1
	else:
		print("[bombafin] OK  sale el podio")
	var gano_exp := Settings.experiencia - exp0
	var gano_oro := Settings.monedas - oro0
	if Settings.modo_pruebas:
		print("[bombafin] (modo pruebas puesto: no se cobra a proposito, no es fallo)")
	elif Cuenta.conectado():
		print("[bombafin] (con cuenta el premio lo paga el servidor, no el saldo local)")
	elif gano_exp <= 0 or gano_oro <= 0:
		print("[bombafin] FALLO: no se ha cobrado nada (exp %d, oro %d)" % [gano_exp, gano_oro])
		fallos += 1
	else:
		print("[bombafin] OK  cobrado: %d EXP y %d de oro" % [gano_exp, gano_oro])
	# la tabla tiene que traer las bajas que se anotaron
	if int(dm_stats.get(_mi_nombre(), {}).get("bajas", 0)) < 2:
		print("[bombafin] FALLO: las bajas de bomba no se anotan")
		fallos += 1
	else:
		print("[bombafin] OK  las bajas se anotan tambien en bomba")
	Settings.experiencia = exp0
	Settings.monedas = oro0
	Settings.save()
	print("[bombafin] %s (%d fallos)" % ["TODO BIEN" if fallos == 0 else "HAY FALLOS", fallos])
	get_tree().quit(0 if fallos == 0 else 1)


## --repartotest: ¿PIENSAN LOS DOS, O SIGUE CARGANDO UNO SOLO?
##
## Lo que hay que ver es que los bots se REPARTAN y que los que le tocan al invitado SE MUEVAN de
## verdad: si el reparto se hiciera pero el invitado no pensara, los bots se quedarian clavados y
## seria peor que antes.
func _reparto_test() -> void:
	Settings.bots_enabled = true
	await get_tree().create_timer(14.0).timeout
	var quien := "ANFITRION" if Net.hosting else "INVITADO"
	var total := enemies.get_child_count() if enemies else 0
	var mios := _bots_mios_red.size() if not Net.hosting else 0
	if Net.hosting:
		for bid in Net.duenos_bot.keys():
			if int(Net.duenos_bot[bid]) == 1:
				mios += 1
	print("[reparto] %s: %d bots en escena · pienso por %d" % [quien, total, mios])

	# ¿se mueven los del invitado? se apunta donde estan y se mira un rato despues
	var antes := {}
	for e in enemies.get_children():
		if is_instance_valid(e) and "red_id" in e:
			antes[int(e.red_id)] = e.global_position
	await get_tree().create_timer(10.0).timeout
	var movidos := 0
	for e in enemies.get_children():
		if is_instance_valid(e) and "red_id" in e and antes.has(int(e.red_id)):
			if e.global_position.distance_to(antes[int(e.red_id)]) > 0.5:
				movidos += 1
	print("[reparto] %s: se han movido %d de %d bots" % [quien, movidos, total])

	if Net.hosting:
		var repartidos := Net.duenos_bot.size()
		var gente := {}
		for bid in Net.duenos_bot.keys():
			gente[int(Net.duenos_bot[bid])] = int(gente.get(int(Net.duenos_bot[bid]), 0)) + 1
		print("[reparto] ANFITRION: reparto = %s (%d bots entre %d jugadores)" % [
			str(gente), repartidos, Net.player_count()])
		var ok_reparto: bool = gente.size() >= 2 and repartidos > 0
		var ok_mueven: bool = movidos > 0
		print("[reparto] %s" % ("TODO BIEN" if ok_reparto and ok_mueven else
			("FALLO: el reparto no llega a los dos" if not ok_reparto else "FALLO: los bots no se mueven")))
		get_tree().quit(0 if ok_reparto and ok_mueven else 1)
	else:
		await get_tree().create_timer(6.0).timeout
		get_tree().quit()


## --migratest: SI EL ANFITRION SE VA, ¿SIGUE LA PARTIDA?
##
## Hacen falta TRES instancias: la que hospeda y se muere, y dos invitados que tienen que acabar
## jugando juntos. Con dos no se prueba nada: el que queda seria anfitrion de si mismo y eso no
## demuestra que nadie se reenganche.
##
## El anfitrion se cierra a lo bruto a los 25 s, que es como se va alguien de verdad: sin avisar.
func _migra_test() -> void:
	await get_tree().create_timer(10.0).timeout
	var quien := "ANFITRION" if Net.hosting else "INVITADO %d" % multiplayer.get_unique_id()
	print("[migra] %s: en partida · %d jugadores · sucesor seria %d" % [
		quien, Net.player_count(), Net.sucesor()])
	if Net.hosting:
		await get_tree().create_timer(15.0).timeout
		print("[migra] ANFITRION: me caigo AHORA (sin avisar)")
		OS.kill(OS.get_process_id())
		return
	# los invitados: aguantar y ver si acaban juntos
	for i in 60:
		await get_tree().create_timer(1.0).timeout
		if Net.is_online() and Net.player_count() >= 2 and i > 25:
			print("[migra] %s: OK, la partida sigue · soy %s · %d jugadores" % [
				quien, "el nuevo anfitrion" if Net.hosting else "invitado", Net.player_count()])
			await get_tree().create_timer(4.0).timeout
			get_tree().quit(0)
			return
	print("[migra] %s: FALLO, me he quedado sin partida (online=%s, jugadores=%d)" % [
		quien, str(Net.is_online()), Net.player_count()])
	get_tree().quit(1)


## --botsmeven: ¿LOS BOTS VEN AL JUGADOR DE LA OTRA MAQUINA?
##
## El usuario lo vio jugando: entro a la partida desde el movil y los bots no le hacian ni caso. La
## IA vive en el anfitrion y elegia a quien atacar mirando SOLO al jugador de su propia maquina.
##
## Se mide desde el ANFITRION, que es donde piensan los bots: cuantos han elegido como objetivo al
## invitado. Con que uno le tenga fichado ya esta demostrado que existe para ellos.
func _bots_me_ven_test() -> void:
	await get_tree().create_timer(8.0).timeout
	if not Net.hosting:
		# el invitado solo tiene que estar ahi, quieto y visible
		for i in 40:
			await get_tree().create_timer(1.0).timeout
		get_tree().quit()
		return
	Settings.bots_enabled = true
	var fallos := 0
	print("[botsmeven] ANFITRION: %d jugadores, %d bots" % [
		Net.player_count(), enemies.get_child_count() if enemies else 0])
	if Net.remotes.is_empty():
		print("[botsmeven] FALLO: no hay ningun jugador remoto en la partida")
		get_tree().quit(1)
		return

	var remoto = Net.remotes.values()[0]
	var id_rem := int(remoto.peer_id) if "peer_id" in remoto else 0
	print("[botsmeven] mi equipo «%s» · equipo del invitado «%s» · remotos %d · su avatar %s" % [
		Net.my_team(), Net.team_of(id_rem), Net.remotes.size(),
		"válido" if is_instance_valid(remoto) else "NO VÁLIDO"])
	var por_equipo := {}
	for e in enemies.get_children():
		if "team" in e:
			por_equipo[String(e.team)] = int(por_equipo.get(String(e.team), 0)) + 1
	print("[botsmeven] bots por equipo: %s" % str(por_equipo))
	# NOTA DE UNA MEDICION QUE ESTABA MAL PLANTEADA.
	#
	# Aqui habia una "fase 1" que miraba si los bots apuntaban al invitado SIN TOCAR NADA, y daba 0 de
	# 8. Parecia un fallo y no lo era: en el banco el invitado se queda quieto en su base, al otro lado
	# del mapa, mientras los bots pelean en el centro. Que no le apunten desde sesenta metros es lo
	# correcto, no un problema.
	#
	# La pregunta que si vale es la de abajo: con un enemigo AL LADO, ¿le considera? Eso es lo que
	# fallaba de verdad -no estaba en la lista de objetivos- y es lo que hay que vigilar.
	await get_tree().create_timer(4.0).timeout
	var cerca := 0
	for e in enemies.get_children():
		if is_instance_valid(e) and "target" in e and e.target == remoto:
			cerca += 1
	print("[botsmeven] sin tocar nada (invitado quieto en su base, lejos): %d de %d · informativo" % [
		cerca, enemies.get_child_count()])

	# SE LE PONE UN BOT ENEMIGO AL LADO.
	#
	# Sin esto la prueba no medía lo que creía: los jugadores estan quietos en su base y SIEMPRE hay
	# otro bot mas cerca, asi que "no le apuntan" no distinguia entre "no le ven" y "le ven pero les
	# pilla lejos". Pegando un bot del bando contrario a tres metros, si aun asi elige a otro es que
	# para el no existe.
	var vigia: Node = null
	for e in enemies.get_children():
		if is_instance_valid(e) and "team" in e and String(e.team) != Net.team_of(id_rem) and e.health > 0.0:
			vigia = e
			break
	if vigia == null:
		print("[botsmeven] FALLO: no hay ningun bot del bando contrario al invitado")
		get_tree().quit(1)
		return
	vigia.global_position = remoto.global_position + Vector3(3.0, 0.0, 0.0)
	print("[botsmeven] bot «%s» puesto a 3 m del invitado" % String(vigia.team))

	var apuntando := 0
	for intento in 25:
		await get_tree().create_timer(1.0).timeout
		apuntando = 0
		for e in enemies.get_children():
			if is_instance_valid(e) and "target" in e and e.target == remoto:
				apuntando += 1
		if is_instance_valid(vigia):
			vigia.global_position = remoto.global_position + Vector3(3.0, 0.0, 0.0)
		if apuntando > 0:
			break
	var a_quien := {}
	for e in enemies.get_children():
		if is_instance_valid(e) and "target" in e:
			var t = e.target
			var nom := "nadie"
			if is_instance_valid(t):
				nom = "EL INVITADO" if t == remoto else ("el anfitrion" if t == player else "otro bot")
			a_quien[nom] = int(a_quien.get(nom, 0)) + 1
	print("[botsmeven] a quien apuntan los bots: %s" % str(a_quien))
	if apuntando > 0:
		print("[botsmeven] OK  %d bot(s) han elegido al jugador de la otra maquina como objetivo" % apuntando)
	else:
		print("[botsmeven] FALLO: ningun bot mira al invitado (para ellos no existe)")
		fallos += 1

	print("[botsmeven] %s (%d fallos)" % ["TODO BIEN" if fallos == 0 else "HAY FALLOS", fallos])
	get_tree().quit(0 if fallos == 0 else 1)


func _bots_lan_test() -> void:
	await get_tree().create_timer(6.0).timeout
	var quien := "ANFITRION" if Net.hosting else "INVITADO"
	var n0 := enemies.get_child_count() if enemies else 0
	var pos0: Array = []
	for e in enemies.get_children():
		if "id" in e:
			pos0.append(e.global_position)
	print("[botslan] %s: bots en escena = %d" % [quien, n0])
	await get_tree().create_timer(8.0).timeout
	var movidos := 0
	var i := 0
	for e in enemies.get_children():
		if "id" in e and i < pos0.size():
			if e.global_position.distance_to(pos0[i]) > 0.5:
				movidos += 1
			i += 1
	var n1 := enemies.get_child_count() if enemies else 0
	print("[botslan] %s: bots ahora = %d · se han movido %d" % [quien, n1, movidos])
	if not Net.hosting:
		print("[botslan] INVITADO: %s" % ("OK: ve los bots del anfitrion y se mueven" if n1 > 0 and movidos > 0 else ("MAL: no le llega nada" if n1 == 0 else "MAL: llegan pero no se mueven")))
	get_tree().quit()


## --cuentatest=<url>: EL JUEGO CONTRA EL SERVIDOR DE CUENTAS, de punta a punta.
##
## Registra una cuenta nueva, termina una partida y comprueba que el premio llega DEL SERVIDOR y que
## el perfil se actualiza. Es la prueba que dice si `cuenta.gd` y `servidor/index.js` se entienden:
## los dos por separado ya tienen sus bancos, pero eso no garantiza que hablen el mismo idioma.
var _srv_mal := 0

func comprobar_srv(nombre: String, cond: bool) -> void:
	if not cond:
		_srv_mal += 1
	print("[cuenta]   %s %s" % ["ok  " if cond else "MAL ", nombre])


func _cuenta_test() -> void:
	var url := ""
	for f in OS.get_cmdline_user_args():
		if f.begins_with("--cuentatest="):
			url = f.substr(13)
	if url == "":
		print("[cuenta] falta la url: --cuentatest=http://127.0.0.1:8781")
		get_tree().quit(); return
	Cuenta.url = url
	Cuenta.token = ""
	Cuenta.perfil = {}
	var usuario := "prueba%d" % (Time.get_unix_time_from_system() as int % 100000)
	print("[cuenta] servidor %s · usuario %s" % [url, usuario])

	Cuenta.registrar(usuario, "clave123")
	var t := 0.0
	while Cuenta.ocupado and t < 15.0:
		await get_tree().process_frame
		t += get_process_delta_time()
	print("[cuenta] registrado: %s · nivel %d · %d EXP · %d monedas" % [
		str(Cuenta.conectado()), Cuenta.nivel(), Cuenta.experiencia(), Cuenta.monedas()])
	if not Cuenta.conectado():
		print("[cuenta] MAL: no se pudo registrar")
		get_tree().quit(); return

	# partida ganada de 15 minutos: el servidor tiene que pagarla
	var exp0 := Cuenta.experiencia()
	Cuenta.terminar_partida("pve", true, 900, 10, 47, 5200)
	t = 0.0
	while Cuenta.ocupado and t < 15.0:
		await get_tree().process_frame
		t += get_process_delta_time()
	var pr: Dictionary = Cuenta.ultimo_premio
	print("[cuenta] partida ganada -> +%d EXP +%d oro · cuenta %d EXP / %d monedas" % [
		int(pr.get("exp", 0)), int(pr.get("oro", 0)), Cuenta.experiencia(), Cuenta.monedas()])
	var pago_ok: bool = int(pr.get("exp", 0)) > 0 and Cuenta.experiencia() == exp0 + int(pr.get("exp", 0))

	# partida perdida: no paga
	var exp1 := Cuenta.experiencia()
	Cuenta.terminar_partida("pve", false, 900, 10, 47, 5200)
	t = 0.0
	while Cuenta.ocupado and t < 15.0:
		await get_tree().process_frame
		t += get_process_delta_time()
	var perder_ok: bool = Cuenta.experiencia() == exp1
	print("[cuenta] partida perdida -> +%d EXP · cuenta %d EXP" % [int(Cuenta.ultimo_premio.get("exp", 0)), Cuenta.experiencia()])

	# Y AHORA POR EL CAMINO DE VERDAD: `Settings.premiar` con los datos de la partida. Es el que usan
	# los tres finales de modo, asi que es el que hay que probar, no solo la llamada directa.
	var exp2 := Cuenta.experiencia()
	var devuelto: Dictionary = Settings.premiar(true, 0, 0,
		{"modo": "dm", "segundos": 600, "bajas": 12})
	comprobar_srv("premiar() con cuenta NO paga en local (lo hace el servidor)",
		int(devuelto.get("exp", -1)) == 0 and bool(devuelto.get("servidor", false)))
	t = 0.0
	while Cuenta.ocupado and t < 15.0:
		await get_tree().process_frame
		t += get_process_delta_time()
	comprobar_srv("...y el servidor si ha pagado", Cuenta.experiencia() > exp2)
	print("[cuenta] premiar() -> el servidor sumo %d EXP" % (Cuenta.experiencia() - exp2))
	print("[cuenta] %s" % ("OK: el juego y el servidor se entienden" if (pago_ok and perder_ok and _srv_mal == 0) else "MAL"))
	# LA PRUEBA NO PUEDE DEJAR RASTRO. Al entrar, `cuenta.gd` guarda url y token en `user://cuenta.cfg`,
	# asi que sin esto el jugador se encontraba el campo "servidor" apuntando a 127.0.0.1:8781 -un
	# servidor de pruebas que no existe- la proxima vez que abriera el juego. Paso de verdad.
	Cuenta.salir()
	Cuenta.url = ""
	Cuenta._guardar()
	print("[cuenta] configuracion de cuenta restaurada (la prueba no deja rastro)")
	get_tree().quit()


## --pvepremio: LO QUE SE GANA Y LO QUE NO, en el modo oleadas.
##
## Comprueba las tres cosas que no existian hasta ahora: que morir SOLO acaba la partida en DERROTA,
## que perder no paga, y que ganar suma experiencia y oro a la cuenta y se guarda.
func _pve_premio_test() -> void:
	await get_tree().create_timer(4.0).timeout
	var m0: int = Settings.monedas
	var e0: int = Settings.experiencia
	print("[premio] cuenta al empezar: nivel %d · %d EXP · %d monedas" % [Settings.nivel(), e0, m0])
	# 1) PERDER no paga
	var per: Dictionary = Settings.premiar(false, 999, 999)
	print("[premio] perder -> exp %d oro %d · cuenta %d EXP / %d monedas" % [
		int(per.exp), int(per.oro), Settings.experiencia, Settings.monedas])
	var perder_ok: bool = Settings.experiencia == e0 and Settings.monedas == m0
	# 2) GANAR paga y se guarda
	var gan: Dictionary = Settings.premiar(true, 600, 400)
	var ganar_ok: bool = Settings.experiencia == e0 + 600 and Settings.monedas == m0 + 400
	print("[premio] ganar  -> exp %d oro %d · cuenta %d EXP / %d monedas · nivel %d%s" % [
		int(gan.exp), int(gan.oro), Settings.experiencia, Settings.monedas, Settings.nivel(),
		" (SUBE)" if bool(gan.subio) else ""])
	# 3) MORIR SOLO acaba la partida
	var companeros: int = pve._companeros_vivos() if pve else -1
	if pve:
		pve.jugador_caido()
	var fin_ok: bool = pve != null and bool(pve.terminado)
	print("[premio] compañeros vivos %d · morir solo -> partida terminada: %s" % [companeros, str(fin_ok)])
	# 4) LA TIENDA SE ACUMULA: comprar dos veces tiene que valer el doble, no quedarse en el tope
	var r0: int = int(player.reserve[0])
	var a0: float = float(player.armor)
	pve._aplicar_compra("municion"); pve._aplicar_compra("municion")
	pve._aplicar_compra("armadura"); pve._aplicar_compra("armadura"); pve._aplicar_compra("armadura")
	var r1: int = int(player.reserve[0])
	var a1: float = float(player.armor)
	print("[premio] tienda: reserva %d -> %d · armadura %.0f -> %.0f (tope %.0f)" % [
		r0, r1, a0, a1, float(player.armadura_tope)])
	var tienda_ok: bool = r1 > r0 and a1 > 100.0
	print("[premio] tienda acumula: %s" % ("OK" if tienda_ok else "MAL"))
	print("[premio] %s" % ("OK" if (perder_ok and ganar_ok and fin_ok and tienda_ok) else "MAL"))
	# la cuenta se deja como estaba: una prueba no puede regalarte oro
	Settings.experiencia = e0
	Settings.monedas = m0
	Settings.save()
	get_tree().quit()


## FINAL DEL MODO OLEADAS. Lo llama `pve.gd` al ganar (diez oleadas) o al caer sin compañeros.
##
## Va por la MISMA pantalla que los demas modos, pero forzando el cartel: en el PvE no hay equipos y
## la pantalla decidia victoria/derrota comparando con el tuyo, asi que al morir salia sin decir nada.
func fin_pve(gano: bool, oleada: int, bajas_pve: int, puntos: int, premio: Dictionary) -> void:
	# LA SECUENCIA DEL FINAL, EN ZOMBI (mas miedosa: fin_intro y compañia con tema "zombi"). Las bajas de cada uno
	# son de verdad: cada maquina cuenta solo las suyas (criatura.gd) y aqui las manda a las demas
	# (Net.net_bajas_pve), que las tienen para cuando sale la tabla, unos segundos despues.
	if Net.soy_espectador:
		_espectador_fin()
		return
	var mias: int = Combat.partida_bajas_pve
	Net.net_bajas_pve(_mi_nombre(), mias)
	var campana := pve != null and pve.has_method("punto_control")
	var eq := Net.my_team()
	var filas_zombi := func() -> Array:
		var out: Array = [{"nombre": _mi_nombre(), "equipo": eq, "bajas": mias, "muertes": 0 if gano else 1, "es_yo": true}]
		for id in Net.players.keys():
			if int(id) == multiplayer.get_unique_id():
				continue
			var n := _nombre_peer(int(id))
			out.append({"nombre": n, "equipo": eq, "bajas": int(Net.bajas_pve_de.get(n, 0)), "muertes": 0, "es_yo": false})
		return out
	# la pantalla de nivel: lo que se ha hecho en la partida (la barra sube con el premio real y cada fila dice lo
	# que le toca de el: fin_nivel.gd)
	var logros: Array = []
	var fila := func(tipo: String, texto: String, veces: int, exp: int, color: Color, emblema: String) -> void:
		if veces > 0:
			logros.append({"tipo": tipo, "texto": texto, "veces": veces, "exp": exp, "color": color, "emblema": emblema})
	if campana:
		fila.call("tramos", "TRAMOS DE LA HUIDA", oleada, oleada * 40, Color(0.62, 0.5, 0.36), "estrella")
	else:
		fila.call("oleadas", "OLEADAS SUPERADAS", oleada, oleada * 60, Color(0.62, 0.5, 0.36), "estrella")
	fila.call("criaturas", "ZOMBIS ABATIDOS", mias, mias * 4, Color(0.62, 0.05, 0.08), "calavera")
	if gano:
		fila.call("victoria", "RESCATADOS" if campana else "SUPERVIVIENTE", 1, 1200 if campana else 600, Color(0.72, 0.56, 0.3), "corona")
	fila.call("partida", "PARTIDA COMPLETADA", 1, 200, Color(0.3, 0.36, 0.3), "estrella")
	secuencia_fin({"gane": gano, "tema": "zombi", "mios": oleada, "rivales": bajas_pve,
		"intro": {"etiqueta_mia": "TRAMO" if campana else "OLEADA", "etiqueta_rival": "ZOMBIS ABATIDOS"},
		"filas": filas_zombi, "logros": logros, "premio": premio, "marcador": [bajas_pve, 0],
		"equipos": [{"equipo": eq, "nombre": "SUPERVIVIENTES", "tanteo": bajas_pve,
			"claro": Color(0.34, 0.44, 0.32), "oscuro": Color(0.2, 0.28, 0.19)}]})


## Rondas que hay que ganar para llevarse la partida de bomba. Siete es media hora larga con gente y
## unos diez minutos con bots: lo bastante para que las rondas importen, sin que se haga eterno.
const RONDAS_PARA_GANAR := 7


## FIN DE PARTIDA EN MODO BOMBA: podio, tabla y premio, como en los demas modos.
##
## Esto llega a TODOS: `Net._round_end` es `call_local`, asi que el marcador y el aviso de fin caen en
## las dos pantallas a la vez y cada uno calcula SU premio con sus propias bajas. Con cuenta, el que
## decide cuanto se cobra es el servidor.
func _bomba_fin(ganador: String) -> void:
	if _bomba_terminada:
		return
	_bomba_terminada = true
	_fin_resuelto = true
	Net.net_fin_partida(ganador, "bomba")
	if Net.soy_espectador:
		_espectador_fin()
		return
	if is_instance_valid(player):
		player.set_process_input(false)
		player.set_process_unhandled_input(false)
	var mi := _mi_nombre()
	var filas: Array = []
	for nombre in dm_stats.keys():
		var st: Dictionary = dm_stats[nombre]
		filas.append({"nombre": nombre, "equipo": st["equipo"], "bajas": st["bajas"],
			"muertes": st["muertes"], "es_yo": nombre == mi})
	var gane: bool = ganador == Net.my_team()
	Estadisticas.fin_partida(gane)
	var mis_bajas: int = int(dm_stats.get(mi, {}).get("bajas", 0))
	# LA EXPERIENCIA SALE DE LOS LOGROS, como en el duelo (el servidor los valida para bomba: index.js)
	var LogrosS := preload("res://scripts/logros.gd")
	var mvp: bool = _soy_mvp(filas)
	var logros: Array = LogrosS.lista(gane, mvp)
	var exp_antes: int = Cuenta.experiencia() if Cuenta.conectado() else Settings.experiencia
	var premio: Dictionary = Settings.premiar(gane, LogrosS.total(logros), 300,
		{"modo": "bomba", "segundos": segundos_partida(), "bajas": mis_bajas,
		"puntos": int(Net.score_t if Net.my_team() == Net.TEAM_T else Net.score_ct),
		"dano": int(Combat.partida_dano), "objetivos": Combat.partida_objetivos, "mvp": mvp,
		"logros": LogrosS.para_servidor(gane, mvp)})
	var mias_r: int = Net.score_ct if Net.my_team() == Net.TEAM_CT else Net.score_t
	var suyas_r: int = Net.score_t if Net.my_team() == Net.TEAM_CT else Net.score_ct
	secuencia_fin({"gane": gane, "mios": mias_r, "rivales": suyas_r, "filas": filas, "logros": logros,
		"exp_antes": exp_antes, "premio": premio, "marcador": [mias_r, suyas_r],
		"intro": {"etiqueta_mia": "TUS RONDAS", "etiqueta_rival": "RONDAS RIVAL"}})


## ¿SOY EL MVP? El mismo criterio que el podio (hud.mostrar_victoria): mas bajas, y a igualdad menos
## muertes. Con cero bajas no hay MVP que valga.
## AL ACABAR LA PARTIDA, EL JUEGO SE PARA. Con la pantalla de victoria puesta, los bots seguian disparando,
## las criaturas atacando, las oleadas saliendo y a ti te podian matar detras del panel ("el juego sigue
## corriendo en segundo plano"). Se congela lo que JUEGA: bots, criaturas, oleadas y la entrada y el cuerpo
## del jugador. El mundo (escombro que termina de caer) y la red siguen: en LAN el anfitrion tiene que
## seguir mandando y el boton de volver al lobby tiene que llegar a todos.
func _congelar_fin_partida() -> void:
	if enemies != null:
		for e in enemies.get_children():
			e.process_mode = Node.PROCESS_MODE_DISABLED
	for c in get_tree().get_nodes_in_group("criaturas"):
		if is_instance_valid(c) and c is Node:
			(c as Node).process_mode = Node.PROCESS_MODE_DISABLED
	if pve:
		pve.set_process(false)
		pve.set_physics_process(false)
	if is_instance_valid(player):
		player.invulnerable = true
		player.set_process_input(false)
		player.set_process_unhandled_input(false)
		player.velocity = Vector3.ZERO
		player.set_physics_process(false)
		player.set_process(false)
	if hud and hud.has_method("set_motion_blur"):
		hud.set_motion_blur(Vector2.ZERO)   # si se paro corriendo, que no se quede la pantalla emborronada


func _soy_mvp(filas: Array) -> bool:
	# EL MVP ES EL DE MAS PUNTOS (puntuacion.gd), el mismo que sale el primero en MEJORES JUGADORES
	var P := preload("res://scripts/puntuacion.gd")
	if not P.tabla.is_empty():
		var mejor_n := ""
		var mp := -1
		for f in filas:
			var pt := P.puntos(String(f["nombre"]))
			if pt > mp or (pt == mp and bool(f.get("es_yo", false))):
				mp = pt
				mejor_n = String(f["nombre"])
		return mejor_n == _mi_nombre() and mp > 0
	var mejor = null
	for f in filas:
		if mejor == null or int(f["bajas"]) > int(mejor["bajas"]) \
				or (int(f["bajas"]) == int(mejor["bajas"]) and int(f["muertes"]) < int(mejor["muertes"])) \
				or (int(f["bajas"]) == int(mejor["bajas"]) and int(f["muertes"]) == int(mejor["muertes"]) and bool(f.get("es_yo", false))):
			mejor = f
	return mejor != null and bool(mejor.get("es_yo", false)) and int(mejor["bajas"]) > 0


## Fila de la tabla de `nombre`, creandola si no existe. `equipo` vacio no pisa el que ya tuviera.
func _dm_fila(nombre: String, equipo: String) -> Dictionary:
	if not dm_stats.has(nombre):
		dm_stats[nombre] = {"equipo": equipo, "bajas": 0, "muertes": 0}
	elif equipo != "":
		dm_stats[nombre]["equipo"] = equipo
	return dm_stats[nombre]


## Una muerte: suma a la victima, y la baja al asesino si lo hay y no es el mismo (un cohete propio
## no te da puntos por matarte).
func _dm_anotar(victima: String, equipo_v: String, asesino: String, equipo_a: String) -> void:
	if victima != "":
		_dm_fila(victima, equipo_v)["muertes"] += 1
	if asesino != "" and asesino != victima:
		_dm_fila(asesino, equipo_a)["bajas"] += 1
	_dm_publicar()
	_dm_sonido_marcador()


## BF: QUIEN VA GANANDO. Al cambiar quien lidera suena el aviso, y el locutor dice si vamos ganando o
## perdiendo, al principio, a mitad o al final de la partida segun lo cerca que este el objetivo.
var _dm_lider := 0      ## 1 vamos ganando, -1 perdiendo, 0 empate
func _dm_sonido_marcador() -> void:
	if not Net.dm_mode:
		return
	var mio := Net.my_team()
	var nos := int(dm_bajas.get(mio, 0))
	var ellos := int(dm_bajas.get(Net.TEAM_CT if mio == Net.TEAM_T else Net.TEAM_T, 0))
	if Net.es_dm_todos():
		# todos contra todos: tus bajas contra las del mejor rival
		var mt: Array = dm_todos_marcador()
		nos = int(mt[0])
		ellos = int(mt[1])
	var lider: int = signi(nos - ellos)
	if lider == _dm_lider or lider == 0:
		_dm_lider = lider if lider != 0 else _dm_lider
		return
	_dm_lider = lider
	Audio.ui("ventaja" if lider > 0 else "desventaja", -6.0)
	var avance: float = float(maxi(nos, ellos)) / maxf(float(dm_objetivo_todos if Net.es_dm_todos() else dm_objetivo), 1.0)
	var fase := "pronto" if avance < 0.34 else ("medio" if avance < 0.75 else "final")
	Audio.voz(("ganando_" if lider > 0 else "perdiendo_") + fase, 1, 20.0)


