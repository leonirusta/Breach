				(float(difs_k[0]) + float(difs_k[1]) + float(difs_k[2])) / 3.0, ", ".join(PackedStringArray(difs_k.map(func(x): return "%+.1f" % float(x))))])
			# y por partes: sin el especular, y con como mucho 1, 2 y 4 faroles por pixel
			for prueba in [["sin especular", "lamp_con_esp", 0.0, 1.0], ["sin la parte cercana", "lamp_dbg", 1, 0], ["sin el volumen", "lamp_dbg", 2, 0]]:
				var a_q: float = await medir_p.call(2.5)
