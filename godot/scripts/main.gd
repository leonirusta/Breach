# --- DUELO A MUERTE ------------------------------------------------------------------------------

## Un punto para `equipo`. Cuando alguien llega al objetivo, se acabo.
func _dm_punto(equipo: String) -> void:
	if dm_terminado or not dm_mode:
		return
	if Net.is_online() and not Net.hosting:
		return      # en red cuenta el anfitrion (ver Net.net_dm_marcador)
	var k := "t" if equipo == Net.TEAM_T else "ct"
	dm_bajas[k] = int(dm_bajas[k]) + 1
	hud.set_dm_marcador(int(dm_bajas["t"]), int(dm_bajas["ct"]), dm_objetivo)
	# primero el marcador y luego el fin: el invitado tiene que ver la baja que gana antes del cartel
	_dm_publicar()
	if int(dm_bajas[k]) >= dm_objetivo:
		dm_terminado = true
		# el cartel de fin de partida lo pone el HUD al recibir round_over, en todos los jugadores
		Net.end_round(equipo, "Primero en llegar a %d bajas" % dm_objetivo)


# --- DUELO A MUERTE TODOS CONTRA TODOS (2026-09-30, submodo "todos": Net.es_dm_todos) ------------------------------
# Cada uno es su propio bando: las personas "p<peer>" (se lo pone el anfitrion en Net._set_team) y los bots "dm1",
# "dm2"... La baja es de quien la hace (dm_stats, la tabla de siempre) y gana el primero en llegar a
# `dm_objetivo_todos`. Se sale y se reaparece en el punto mas alejado de todos (_salida_todos). Al final, UNA tabla.
## Cuantos hay en la partida contando a las personas: los bots rellenan hasta aqui (y uno se va si entra alguien)
const DM_TODOS_JUGADORES := 8
const BOTS_MOVIL_MIO := 4        ## en el movil: tu bando, contandote (tu + 3 bots: 4 contra 4, pedido 2026-10-15)
const BOTS_MOVIL_RIVAL := 4      ## y el rival (4 bots): 7 bots en total

func _bots_movil() -> bool:
	return Settings.is_mobile() and not ("--bots9" in OS.get_cmdline_user_args())

func _dm_todos_jugadores() -> int:
	return 7 if _bots_movil() else DM_TODOS_JUGADORES
## Las bajas para ganar en todos contra todos (el .dm.json puede traer "objetivo_todos"; si no, el 40 % del de equipos)
var dm_objetivo_todos := 20


func _bots_dm_todos() -> void:
	var n: int = maxi(0, _dm_todos_jugadores() - _personas_en_partida())
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--bots_dm="):
			n = int(a.substr(10))           # para medir con menos (o mas)
	_bots_mios = 0
	for i in n:
		_dm_soltar_bot("dm%d" % (i + 1), i, nombre_bot(i))
	print("[dm] TODOS CONTRA TODOS: %d bots para %d persona(s) · gana quien llegue a %d bajas" % [n, _personas_en_partida(), dm_objetivo_todos])


func _personas_en_partida() -> int:
	return maxi(1, Net.players.size()) if Net.is_online() else 1


func _bots_dm_todos_vivos() -> int:
	var n := 0
	for e in enemies.get_children():
		if is_instance_valid(e) and "team" in e and String(e.team).begins_with("dm") and "health" in e and float(e.health) > 0.0 \
				and not e.is_queued_for_deletion():
			n += 1
	return n


## La baja ya esta en la tabla (_dm_anotar): ¿ha llegado `asesino` a las que hacen falta? Solo el anfitrion (o sin red).
func _dm_punto_todos(asesino: String) -> void:
	if dm_terminado or not dm_mode:
		return
	if Net.is_online() and not Net.hosting:
		return      # en red cuenta el anfitrion (ver Net.net_dm_marcador)
	hud.set_dm_marcador(0, 0, dm_objetivo_todos)
	_dm_publicar()
	if asesino == "" or not dm_stats.has(asesino):
		return
	if int(dm_stats[asesino]["bajas"]) >= dm_objetivo_todos:
		dm_terminado = true
		# el ganador va como su bando ("p<peer>" o "dm<n>"): cada maquina sabe si es el suyo (_dm_fin)
		Net.end_round(String(dm_stats[asesino]["equipo"]), "%s llega a %d bajas" % [asesino, dm_objetivo_todos])


## Para el marcador de arriba (hud._refresh_score): [tus bajas, las del mejor rival, su nombre, las que hacen falta]
func dm_todos_marcador() -> Array:
	var mi := _mi_nombre()
	var mias := int(dm_stats.get(mi, {}).get("bajas", 0))
	var mejor := 0
	var lider := ""
	for nombre in dm_stats.keys():
		if String(nombre) == mi:
			continue
		var b := int(dm_stats[nombre].get("bajas", 0))
		if b > mejor or lider == "":
			mejor = b
			lider = String(nombre)
	return [mias, mejor, Net.nombre_para_ver(lider, "UN RIVAL"), dm_objetivo_todos]


## DONDE SALE ALGUIEN EN TODOS CONTRA TODOS: cualquier punto del mapa vale (las dos bases, las salidas de los dos lados y
## un anillo alrededor del centro de la pelea) y se elige uno de los dos mas alejados del rival mas cercano, que aqui es
## cualquiera que no sea `equipo`.
var _puntos_todos: Array = []

func _salida_todos(equipo: String) -> Vector3:
	if _puntos_todos.is_empty():
		for eq in dm_salidas.keys():
			_puntos_todos.append_array(dm_salidas[eq])
		for b in [t_spawn, ct_spawn]:
			if b != Vector3.ZERO:
				_puntos_todos.append(b)
		if dm_centro != Vector3.ZERO and t_spawn != Vector3.ZERO and ct_spawn != Vector3.ZERO:
			var r0: float = t_spawn.distance_to(ct_spawn) * 0.5
			for k in 12:
				for f in [0.4, 0.75]:
					var a: float = TAU * float(k) / 12.0 + (0.26 if f > 0.5 else 0.0)
					var q: Vector3 = _ground_near(dm_centro + Vector3(cos(a), 0.0, sin(a)) * r0 * float(f))
					if absf(q.y - dm_centro.y) < 4.0 and (dm_altura_ok(q)):
						_puntos_todos.append(q)
		if _puntos_todos.is_empty():
			_puntos_todos.append(world.get_spawn_position())
	var rivales: Array = []
	for id in Net.remotes.keys():
		var r = Net.remotes[id]
		if is_instance_valid(r) and Net.team_of(int(id)) != equipo and not Net.is_dead(int(id)):
			rivales.append((r as Node3D).global_position)
	for e in enemies.get_children():
		if e is Node3D and is_instance_valid(e) and "team" in e and String(e.team) != equipo and "health" in e and float(e.health) > 0.0:
			rivales.append((e as Node3D).global_position)
	if is_instance_valid(player) and String(player.team) != equipo and float(player.health) > 0.0:
		rivales.append(player.global_position)
	var orden: Array = []
	for q2 in _puntos_todos:
		var d := INF
		for o in rivales:
			d = minf(d, (q2 as Vector3).distance_to(o))
		orden.append([d, q2])
	orden.sort_custom(func(a, b): return a[0] > b[0])
	return orden[randi() % mini(2, orden.size())][1]


## Un punto del anillo vale si esta por encima de la altura minima del duelo (no en un sotano ni fuera del mapa)
func dm_altura_ok(q: Vector3) -> bool:
	return q.y > Net.dm_altura_minima + 0.5


## Reponer un bot del bando que acaba de perder uno, en SU base. Esto es lo contrario del modo
## bomba, donde reaparecer a mitad de ronda era el fallo: aqui no hay rondas que ganar quedandote
## solo, el marcador es de bajas, asi que la pelea tiene que seguir.
func _dm_reponer_bot(equipo: String, nombre: String = "") -> void:
	if not is_inside_tree() or loading or dm_terminado or not Settings.bots_activos():
		return
	if equipo == "":
		return
	# TODOS CONTRA TODOS: vuelve el mismo bot (su bando es solo suyo) mientras no sobren (si ha entrado gente, uno menos)
	if Net.es_dm_todos():
		if _bots_dm_todos_vivos() + _personas_en_partida() < _dm_todos_jugadores():
			_dm_soltar_bot(equipo, 0, nombre)
		return
	# ...pero solo si a ese bando le faltan: si no, cada muerte sumaria uno de mas
	var vivos := 0
	for e in enemies.get_children():
		if "team" in e and String(e.team) == equipo:
			vivos += 1
	var mio := Net.my_team()
	if mio == "":
		mio = Net.TEAM_T
	var tope: int = _faltan_bots(equipo)
	if vivos >= tope:
		return
	_dm_soltar_bot(equipo, vivos, nombre)


## Un bot de `equipo` en su base, con su cometido de duelo a muerte: ir al centro y pelear.
func _dm_soltar_bot(equipo: String, indice: int, nombre: String = "") -> void:
	var _tr := Time.get_ticks_usec()
	var e := ENEMY_SCENE.instantiate()
	Prof.add("main.reponer.crear", Time.get_ticks_usec() - _tr)
	_tr = Time.get_ticks_usec()
	enemies.add_child(e)
	Prof.add("main.reponer.meter", Time.get_ticks_usec() - _tr)
	_tr = Time.get_ticks_usec()
	var base: Vector3 = _salida_dm(equipo) if dm_salidas.has(equipo) else _base_de(equipo)
	var enfrente: Vector3 = dm_centro if dm_centro != Vector3.ZERO else base
	e.global_position = _sitio_bot(base, enfrente, indice % _bots_por_equipo(), _bots_por_equipo())
	if not _sin_montar_una:
		e.tinte_build = _color_bando_bot(equipo == Net.my_team(),
			Net.color_equipo(equipo).lerp(Color.WHITE, 0.45) if ciudad3 else Color(0, 0, 0, 0))
	e.setup(world, player, 700 + enemies.get_child_count())
	if e.red_id == 0:
		e.red_id = _nuevo_id_bot()   # el numero que viaja por la red
	e.team = equipo
	e.died.connect(_on_enemy_died)
	_dm_rol(e, base)
	Prof.add("main.reponer.setup", Time.get_ticks_usec() - _tr)
	_tr = Time.get_ticks_usec()
	_pintar_bot(e, equipo == Net.my_team(), indice,
		Net.color_equipo(equipo).lerp(Color.WHITE, 0.45) if ciudad3 else Color(0, 0, 0, 0))
	Prof.add("main.reponer.pintar", Time.get_ticks_usec() - _tr)
	if ciudad3 and nombre == "":
		# en la ciudad hay DOS equipos rivales: "RIVAL 3" saldria repetido. Se llaman por su color.
		nombre = "%s %d" % [Net.nombre_equipo(equipo).replace("EQUIPO ", ""), indice + 1]
	if nombre != "":
		e.nombre_marcador = nombre
		if equipo == Net.my_team() and e.has_method("set_bot_name"):
			e.set_bot_name(nombre)
	hud.set_bots_alive(enemies.get_child_count())


## DONDE REAPARECE ALGUIEN DE `equipo` si el mapa trae puntos de reaparicion: de los de su lado, uno de los dos mas
## alejados del rival mas cercano (con un poco de azar, para no salir siempre del mismo sitio).
func _salida_dm(equipo: String) -> Vector3:
	var pts: Array = dm_salidas.get(equipo, [])
	if pts.is_empty():
		return _base_de(equipo)
	var rivales: Array = []
	for id in Net.remotes.keys():
		var r = Net.remotes[id]
		if is_instance_valid(r) and Net.team_of(int(id)) != equipo:
			rivales.append((r as Node3D).global_position)
	for e in enemies.get_children():
		if e is Node3D and is_instance_valid(e) and "team" in e and String(e.team) != equipo:
			rivales.append((e as Node3D).global_position)
	if is_instance_valid(player) and "team" in player and String(player.team) != equipo and String(player.team) != "":
		rivales.append(player.global_position)
	var orden: Array = []
	for q in pts:
		var d := INF
		for o in rivales:
			d = minf(d, (q as Vector3).distance_to(o))
		orden.append([d, q])
	orden.sort_custom(func(a, b): return a[0] > b[0])
	return orden[randi() % mini(2, orden.size())][1]


## EL COMETIDO EN DUELO A MUERTE: nadie defiende nada. La ruta son puntos alrededor del CENTRO del
## mapa -donde se cruzan los dos bandos- y se pasa por ellos sin pararse, asi que la pelea ocurre
## donde tiene que ocurrir y no en dos bases mirandose de lejos.
func _dm_rol(e, base: Vector3) -> void:
	var centro: Vector3 = dm_centro if dm_centro != Vector3.ZERO else base
	var ruta: Array = []
	for k in 6:
		var a: float = TAU * float(k) / 6.0 + randf() * 0.6
		var r: float = randf_range(4.0, 14.0)
		var q: Vector3 = _ground_near(centro + Vector3(cos(a), 0.0, sin(a)) * r)
		if absf(q.y - centro.y) < 6.0:
			ruta.append(q)
	if ruta.is_empty():
		ruta.append(centro)
	ruta.shuffle()
	e.rol = "reaccion"          # acude a donde se lie, venga de donde venga
	e.rover = true
	e.guard_t = randf_range(0.3, 1.0)
	e.assign_site(centro, ruta)


## EL DUELO A MUERTE, DE PUNTA A PUNTA. Que cargue las dos bases, que cada bando nazca en la suya,
## que se junten en el centro, que el marcador suba y que los muertos vuelvan.
func _dm_test() -> void:
	await get_tree().create_timer(5.0).timeout
	if team_overlay != null:
		Net.choose_team(Net.TEAM_T)
		_close_team_select()
	for _i in 60:
		if enemies.get_child_count() > 0:
			break
		await get_tree().create_timer(0.5).timeout
	await get_tree().create_timer(2.0).timeout
	player.invulnerable = true
	print("[dm] modo=%s objetivo=%d · T %s · CT %s · centro %s" % [
		str(dm_mode), dm_objetivo, str(t_spawn.round()), str(ct_spawn.round()), str(dm_centro.round())])
	# cada bando en su base
	var mal := 0
	for e in enemies.get_children():
		var base: Vector3 = ct_spawn if String(e.team) == Net.TEAM_CT else t_spawn
		var otra: Vector3 = t_spawn if String(e.team) == Net.TEAM_CT else ct_spawn
		if e.global_position.distance_to(base) > e.global_position.distance_to(otra):
			mal += 1
	print("[dm] %d bots · en la base equivocada: %d" % [enemies.get_child_count(), mal])
	# a los 45 s: cuantos se han acercado al centro y como va el marcador
	for paso in 3:
		await get_tree().create_timer(15.0).timeout
		var cerca := 0
		var lejos := 0.0
		for e in enemies.get_children():
			var d: float = e.global_position.distance_to(dm_centro)
			if d < 25.0:
				cerca += 1
			lejos = maxf(lejos, d)
		var EnemyCls = load("res://scripts/enemy.gd")
		print("[dm] t=%2ds  bots=%2d  centro:%2d  lejos %5.1f m  marcador %d-%d  cuerpos %d (tope %d)" % [
			(paso + 1) * 15, enemies.get_child_count(), cerca, lejos,
			int(dm_bajas["t"]), int(dm_bajas["ct"]),
			get_tree().get_nodes_in_group("corpse").size(), EnemyCls.max_corpses])
	get_tree().quit()


## LOS CADAVERES SE DISUELVEN A LOS 3 S. Se matan tres bots y se cuentan los cuerpos en el suelo a
## los 2,5 s (siguen todos), a los 3,6 s (disolviendose: ya fuera del grupo) y a los 5,5 s (ninguno).
func _blando_test() -> void:
	await get_tree().create_timer(4.0).timeout
	if team_overlay != null:
		Net.choose_team(Net.TEAM_T)
		_close_team_select()
	for _i in 40:
		if enemies.get_child_count() > 0:
			break
		await get_tree().create_timer(0.5).timeout
	var n := 0
	for e in enemies.get_children():
		if n >= 3:
			break
		if e.has_method("take_damage"):
			e.take_damage(9999.0)
			n += 1
	for marca in [[2.5, "siguen en el suelo"], [1.1, "a los 3,6 s (deben irse)"], [1.9, "a los 5,5 s (ninguno)"]]:
		await get_tree().create_timer(float(marca[0])).timeout
		var nodos := get_tree().root.find_children("Corpse", "RigidBody3D", true, false)
		print("[disuelve] %-26s en el grupo 'corpse': %d · nodos de cadaver vivos: %d" % [
			String(marca[1]), get_tree().get_nodes_in_group("corpse").size(), nodos.size()])
	print("[disuelve] _disolver_on = %s" % str(_disolver_on))
	get_tree().quit()


## EL AGUA EN LA LENTE CON CAMARA DE CUERPO Y DESENFOQUE A LA VEZ. Se encoge la interfaz como hace la
## camara de cuerpo, se fuerza lluvia y un giro de camara, y se mira: que el agua tape la pantalla
## entera (sus esquinas contra las del visor), que vaya por encima del desenfoque con su copia de
## pantalla en medio, y una foto para verlo.
##
## Se fuerza en `frame_pre_draw`, que llega despues de todos los _process: si no, el propio juego
## -que no ve lluvia ni giro- lo apagaria en el mismo cuadro.
func _lluvia_lente_test() -> void:
	await get_tree().create_timer(4.0).timeout
	if team_overlay != null:
		Net.choose_team(Net.TEAM_T)
		_close_team_select()
	await get_tree().create_timer(1.0).timeout
	hud._ui_centrar(true)
	var forzar := func() -> void:
		hud.lens_rain(1.0, 0.05)
		hud.set_motion_blur(Vector2(0.012, 0.0))
	RenderingServer.frame_pre_draw.connect(forzar)
	await get_tree().create_timer(3.0).timeout
	var vp: Vector2 = get_viewport().get_visible_rect().size
	for par in [["agua", hud.lluvia_rect], ["desenfoque", hud.mblur]]:
		var r: Control = par[1]
		if r == null:
			print("[lente] %s: NO EXISTE" % par[0])
			continue
		var xf := r.get_global_transform()
		var tl: Vector2 = xf * Vector2.ZERO
		var br: Vector2 = xf * r.size
		var cubre: bool = tl.x <= 1.0 and tl.y <= 1.0 and br.x >= vp.x - 1.0 and br.y >= vp.y - 1.0
		print("[lente] %-10s de (%.0f, %.0f) a (%.0f, %.0f) · visor %.0fx%.0f -> %s" % [
			par[0], tl.x, tl.y, br.x, br.y, vp.x, vp.y, "PANTALLA COMPLETA" if cubre else "RECORTADO"])
	# (sin desenfoque de movimiento en los ajustes no hay mblur: solo se mira la copia y el agua)
	var i_mb: int = hud.mblur.get_index() if hud.mblur != null else -1
	var ok_orden: bool = i_mb < hud.lluvia_copia.get_index() 		and hud.lluvia_copia.get_index() < hud.lluvia_rect.get_index()
	print("[lente] orden: desenfoque %d · copia %d · agua %d -> %s · copia visible %s · agua visible %s" % [
		i_mb, hud.lluvia_copia.get_index(), hud.lluvia_rect.get_index(),
		"BIEN" if ok_orden else "MAL", str(hud.lluvia_copia.visible), str(hud.lluvia_rect.visible)])
	for i in 4:
		await RenderingServer.frame_post_draw
	get_viewport().get_texture().get_image().save_png("user://lluvialente.png")
	print("[lente] foto en user://lluvialente.png")
	RenderingServer.frame_pre_draw.disconnect(forzar)
	get_tree().quit()


## EL MENU CON CAMARA DE CUERPO COMPLETA. La lente de ojo de pez dobla lo que tiene debajo, pero el
## raton se comprueba contra la posicion real de cada boton: si el menu va debajo de la lente, lo que
## ves y lo que pulsas no coinciden. Se comprueba que el menu cuelgue de la capa y no de `root`, que
## vaya dibujado DESPUES de la lente, que no este encogido, y se simula un clic de raton de verdad en
## el centro del boton CERRAR para ver que le llega a el. Y una foto: el menu tiene que salir recto.
func _menu_bodycam_test() -> void:
	await get_tree().create_timer(4.0).timeout
	if team_overlay != null:
		Net.choose_team(Net.TEAM_T)
		_close_team_select()
	await get_tree().create_timer(1.0).timeout
	set_bodycam(2)
	for _f in 20:
		await get_tree().process_frame
	hud.toggle_menu()
	for _f in 6:
		await get_tree().process_frame
	var mp: Control = hud.menu_panel
	var lente_visible: bool = hud.ojo_rect != null and hud.ojo_rect.visible
	var encima: bool = mp.get_parent() == hud and mp.get_index() > hud.root.get_index()
	print("[menubc] lente de ojo de pez visible: %s · escala del HUD %.2f" % [str(lente_visible), hud.root.scale.x])
	print("[menubc] el menu cuelga de: %s · dibujado despues de root (encima de la lente): %s · escala real %.2f" % [
		mp.get_parent().name, str(encima), mp.get_global_transform().get_scale().x])
	# el boton CERRAR, y un clic de raton de verdad en su centro
	var cerrar: Button = null
	for b in mp.find_children("*", "Button", true, false):
		if String((b as Button).text).begins_with("CERRAR"):
			cerrar = b
	var llego := [false]
	cerrar.pressed.connect(func() -> void: llego[0] = true)
	var c: Vector2 = cerrar.get_global_rect().get_center()
	print("[menubc] ventana %s · lienzo %s" % [str(DisplayServer.window_get_size()), str(get_viewport().get_visible_rect().size)])
	# EN COORDENADAS DEL LIENZO, con push_input(..., true). Input.parse_input_event las toma de la
	# VENTANA, y si la ventana no mide lo mismo que el lienzo de 1280x720 el clic cae en otro sitio:
	# eso mediria la prueba, no el juego.
	var mov := InputEventMouseMotion.new()
	mov.position = c
	mov.global_position = c
	get_viewport().push_input(mov, true)
	await get_tree().process_frame
	var bajo: Control = get_viewport().gui_get_hovered_control()
	print("[menubc] bajo el raton en ese punto: %s (%s)" % [
		str(bajo.name) if bajo else "nada", String((bajo as Button).text) if bajo is Button else "-"])
	for fase in [true, false]:
		var ev := InputEventMouseButton.new()
		ev.button_index = MOUSE_BUTTON_LEFT
		ev.pressed = fase
		ev.position = c
		ev.global_position = c
		get_viewport().push_input(ev, true)
		await get_tree().process_frame
	await get_tree().process_frame
	print("[menubc] clic en el centro de CERRAR (%.0f, %.0f) -> %s" % [c.x, c.y, "LE LLEGO A CERRAR" if llego[0] else "NO LE LLEGO"])
	# se vuelve a abrir para la foto (CERRAR lo acaba de cerrar)
	if hud.menu_panel == null:
		hud.toggle_menu()
	for i in 6:
		await RenderingServer.frame_post_draw
	get_viewport().get_texture().get_image().save_png("user://menubodycam.png")
	print("[menubc] foto en user://menubodycam.png")
	get_tree().quit()


## Una PERSONA ha caido (Net.dm_muerte): punto para el bando contrario. Las muertes de los bots
## entran por _on_enemy_died; las de los jugadores no pasaban por ningun sitio que contara, asi que
## en LAN -donde no hay bots- el marcador no se movia nunca.
func _dm_muerte_humana(equipo_victima: String, victima_id: int = 0, asesino_id: int = 0) -> void:
	if not dm_mode or equipo_victima == "":
		return
	var yo: int = multiplayer.get_unique_id() if Net.is_online() else 1
	var invitado: bool = Net.is_online() and not Net.hosting
	var kname := ""
	var kteam := ""
	if asesino_id != 0:
		kname = _nombre_peer(asesino_id)
		kteam = Net.team_of(asesino_id)
	elif victima_id == yo and is_instance_valid(player):
		# lo ha matado un bot: eso no viaja por red, lo sabe el propio jugador
		kname = _nombre_nodo(player.ultimo_atacante)
		kteam = _equipo_nodo(player.ultimo_atacante)
		if invitado and kname != "":
			Net.net_dm_asesino_bot(kname, kteam)
	if invitado:
		return      # la tabla y el marcador me los manda el anfitrion
	_dm_anotar(_nombre_peer(victima_id), equipo_victima, kname, kteam)
	if Net.es_dm_elim():
		return
	if Net.es_dm_todos():
		_dm_punto_todos(kname)
	else:
		_dm_punto(Net.TEAM_CT if equipo_victima == Net.TEAM_T else Net.TEAM_T)


## FIN DE LA PARTIDA DE DUELO A MUERTE. Se para la pelea -nadie mata ni muere mientras se mira el
## podio- y se abre la pantalla de victoria. Esto corre en cada jugador al recibir round_over.

func _dm_fin(ganador: String = "") -> void:
	# El aviso de final puede repetirse por red. La primera llamada ya congela la
	# partida y arranca la secuencia; las siguientes no deben crearla otra vez.
	if _fin_resuelto:
		return
	dm_terminado = true
	_fin_resuelto = true
	print("[fin] final del duelo: gana %s" % ganador)
	Net.net_fin_partida(ganador, "dm")     # el anfitrion lo repite a todos (ver Net, "EL FIN DE LA PARTIDA")
	if Net.soy_espectador:
		_espectador_fin()
		return
	if is_instance_valid(player):
		player.invulnerable = true
	# todos en la tabla, aunque no hayan matado ni muerto: personas y bots que sigan en pie
	for id in Net.players.keys():
		_dm_fila(_nombre_peer(int(id)), Net.team_of(int(id)))
	_dm_fila(_mi_nombre(), Net.my_team())
	if enemies != null:
		for e in enemies.get_children():
			if "nombre_marcador" in e and String(e.nombre_marcador) != "":
				_dm_fila(String(e.nombre_marcador), String(e.team))
			e.process_mode = Node.PROCESS_MODE_DISABLED
	var mi := _mi_nombre()
	var filas: Array = []
	for nombre in dm_stats.keys():
		var st: Dictionary = dm_stats[nombre]
		filas.append({"nombre": nombre, "equipo": st["equipo"], "bajas": st["bajas"],
			"muertes": st["muertes"], "es_yo": nombre == mi})
	# NO SE VUELVE SOLO AL LOBBY: la pantalla lleva un boton para eso, abajo a la derecha, y cada uno
	# se queda mirando el podio lo que quiera. Mientras tanto el jugador no recibe entrada: un clic en
	# el boton no tiene que disparar el arma ni volver a capturar el raton.
	if is_instance_valid(player):
		player.set_process_input(false)
		player.set_process_unhandled_input(false)
	# PREMIO DEL DUELO A MUERTE. Hasta ahora ningun modo daba nada: `Settings.monedas` solo se
	# restaba al comprar, asi que el monedero no se podia llenar jugando.
	var gane: bool = ganador == Net.my_team()
	Estadisticas.fin_partida(gane)
	var mis_bajas: int = int(dm_stats.get(mi, {}).get("bajas", 0))
	# LA EXPERIENCIA SALE DE LOS LOGROS (logros.gd): lo que se enseña en la pantalla de nivel es lo que se gana
	var LogrosS := preload("res://scripts/logros.gd")
	var soy_mvp: bool = _soy_mvp(filas)
	var logros: Array = LogrosS.lista(gane, soy_mvp)
	# con cuenta, la experiencia de antes es la de la CUENTA (la del servidor), no la de este aparato
	var exp_antes: int = Cuenta.experiencia() if Cuenta.conectado() else Settings.experiencia
	# en el duelo a muerte no hay bomba ni cubo: el objetivo es llegar a DIEZ bajas
	var premio: Dictionary = Settings.premiar(gane, LogrosS.total(logros), 250,
		{"modo": "dm", "segundos": segundos_partida(), "bajas": mis_bajas,
		"dano": int(Combat.partida_dano), "objetivos": 1 if mis_bajas >= 10 else 0,
		"mvp": soy_mvp, "logros": LogrosS.para_servidor(gane, soy_mvp)})
	# TODOS CONTRA TODOS: UNA SOLA TABLA con todos, tus bajas contra las del mejor rival y tu puesto
	if Net.es_dm_todos():
		var mejor_rival := 0
		var puesto := 1
		for f in filas:
			f["equipo"] = "todos"
			if not bool(f.get("es_yo", false)):
				mejor_rival = maxi(mejor_rival, int(f["bajas"]))
				if int(f["bajas"]) > mis_bajas:
					puesto += 1
		secuencia_fin({"gane": gane, "mios": mis_bajas, "rivales": mejor_rival, "filas": filas, "logros": logros,
			"exp_antes": exp_antes, "premio": premio, "marcador": [mis_bajas, mejor_rival],
			"intro": {"etiqueta_mia": "TUS BAJAS", "etiqueta_rival": "MEJOR RIVAL", "sin_banderas": Net.es_dm_elim()},
			"equipos": [{"equipo": "todos", "nombre": "TODOS CONTRA TODOS", "tanteo": "#%d" % puesto,
				"claro": Color(0.86, 0.62, 0.12), "oscuro": Color(0.6, 0.4, 0.06)}]})
		return
	var mios: int = int(dm_bajas["ct"]) if Net.my_team() == Net.TEAM_CT else int(dm_bajas["t"])
	var suyos: int = int(dm_bajas["t"]) if Net.my_team() == Net.TEAM_CT else int(dm_bajas["ct"])
	secuencia_fin({"gane": gane, "mios": mios, "rivales": suyos, "filas": filas, "logros": logros,
		"exp_antes": exp_antes, "premio": premio, "marcador": [mios, suyos],
		# el duelo SIN REAPARECER no va por bajas: sin los "0 · 0" de los lados (pedido 2026-10-15)
		"intro": {"sin_banderas": Net.es_dm_elim()}})


## LA SECUENCIA DEL FINAL, EN TODOS LOS MODOS (2026-09-28, pedido: "la pantalla de victoria nueva en todos los
## modos, y en zombis mas miedosa"). Era solo del duelo a muerte; los demas iban al podio viejo.
##   1. la entrada (fin_intro): la partida congelada, el rayo (zombi: tres zarpazos), las banderas y el titulo
##   2. la pantalla de nivel (fin_nivel): los logros uno a uno y la barra de experiencia (la del servidor con cuenta)
##   3. los mejores jugadores (mejores_jugadores)
##   4. la tabla del final (victoria_final): una, dos o tres tablas, con IR AL VESTIBULO e IR A BATALLA
## cfg: gane, mios, rivales, intro {etiqueta_mia, etiqueta_rival, texto}, tema ("" o "zombi"), filas (Array o
## Callable: en zombis las bajas de los demas llegan por red mientras tanto), logros, exp_antes, premio,
## marcador [tuyo, rival], titulo, equipos (las tablas de victoria_final; vacio = tu equipo y el rival).
var _fin_en_marcha := false
## Lo ultimo que se le paso a secuencia_fin (el banco de los submodos, --equipostest, mira las tablas del final)
var ultimo_fin_cfg: Dictionary = {}

func secuencia_fin(cfg: Dictionary) -> void:
	if _fin_en_marcha:
		return
	_fin_en_marcha = true
	ultimo_fin_cfg = cfg
	# EL ESPECTADOR NO TIENE FINAL PROPIO (ni nivel, ni premio, ni podio que sea suyo): aviso y al vestibulo
	if Net.soy_espectador:
		_espectador_fin()
		return
	if is_instance_valid(player):
		player.invulnerable = true
		player.set_process_input(false)
		player.set_process_unhandled_input(false)
	var tema := String(cfg.get("tema", ""))
	var gane := bool(cfg.get("gane", false))
	var premio: Dictionary = cfg.get("premio", {})
	# la experiencia de antes: la de la cuenta, o la de este aparato menos lo que acaba de cobrar
	var exp_antes: int = int(cfg["exp_antes"]) if cfg.has("exp_antes") else \
		(Cuenta.experiencia() if bool(premio.get("servidor", false)) else Settings.experiencia - int(premio.get("exp", 0)))
	_congelar_fin_partida()
	Audio.ui("objetivo_tomado", 0.0)
	if hud:
		hud.visible = false           # la partida congelada, sin marcador ni etiquetas encima
	# LA CAMARA DE CINE (2026-10-28, pedido): recorre la destruccion en bucle debajo de las pantallas del final
	if not ("--sincamarafin" in OS.get_cmdline_user_args()) and world and is_instance_valid(player):
		preload("res://scripts/camara_fin.gd").empezar(self, world, player.cam)
	var extra: Dictionary = (cfg.get("intro", {}) as Dictionary).duplicate()
	extra["tema"] = tema
	var intro = preload("res://scripts/fin_intro.gd").mostrar(self, gane, int(cfg.get("mios", 0)), int(cfg.get("rivales", 0)), extra)
	await intro.terminado
	# LA PANTALLA DE NIVEL. CON CUENTA, LO QUE DICE EL SERVIDOR: espera su respuesta (fin_nivel.gd, `del_servidor`)
	var aspecto: Array = []
	var arma_mia: Array = ["rifle", ""]
	if is_instance_valid(player) and player.avatar:
		aspecto = player.avatar.build_args
		arma_mia = [String(player.avatar.weapon_kind), String(player.avatar._arma_id)]
	var niv = preload("res://scripts/fin_nivel.gd").mostrar(self, cfg.get("logros", []), exp_antes, int(premio.get("exp", 0)),
		_mi_nombre(), aspecto, arma_mia, bool(premio.get("servidor", false)), tema)
	await niv.terminado
	# MEJORES JUGADORES: los cinco con mas puntos, con su personaje y sus me gusta
	var fuente = cfg.get("filas", [])
	var filas: Array = fuente.call() if fuente is Callable else fuente
	var mj = preload("res://scripts/mejores_jugadores.gd").mostrar(self, _mejores_jugadores(filas), tema)
	mj.info_partida = info_partida_reporte()
	await mj.terminado
	if hud:
		hud.visible = true
		hud.mostrar_victoria_final(gane, cfg.get("marcador", [int(cfg.get("mios", 0)), int(cfg.get("rivales", 0))]), filas, premio,
			tema, String(cfg.get("titulo", "")), cfg.get("equipos", []))
	_congelar_fin_partida()


## --botslan: ¿VE EL INVITADO LOS BOTS DEL ANFITRION?
##
## Es la prueba que decide si la replica funciona. El anfitrion crea bots como siempre; el invitado
## NO crea ninguno por su cuenta, asi que todo lo que tenga en escena le ha llegado por la red. Si
## sale 0, es que no llega nada; si salen pero no se mueven, es que llega el nacimiento y no el
## estado.
## --tardedanio: EL QUE ENTRA A MITAD, ¿VE LOS AGUJEROS QUE YA HAY?
##
## El anfitrion rompe medio muro antes de que llegue nadie. El que entra despues tiene que acabar con
## EL MISMO numero de voxels: si no, esta viendo paredes donde los demas ven agujeros, y eso no se
## arregla ya en toda la partida.
func _tarde_danio_test() -> void:
	await get_tree().create_timer(10.0).timeout
	if Net.hosting:
		# a romper, antes de que llegue nadie
		var o: Vector3 = player.global_position + Vector3(0, 1.2, 0)
		for i in 40:
			Net.net_shoot(world, o, Vector3(1, 0, 0), 40.0, 220)
			await get_tree().create_timer(0.05).timeout
		Net.net_explode(world, o + Vector3(4, 0, 0), 3.0, 900)
		await get_tree().create_timer(2.0).timeout
		print("[tardedanio] ANFITRION: he roto cosas · voxels ahora = %d · historial = %d golpes" % [
			int(world.get_stats().get("voxels_solid", 0)), Net.historial.size()])
		# y se queda esperando a que llegue el otro y compare
		for i in 40:
			await get_tree().create_timer(1.0).timeout
			if Net.player_count() >= 2:
				break
		await get_tree().create_timer(25.0).timeout
		print("[tardedanio] ANFITRION: voxels al final = %d" % int(world.get_stats().get("voxels_solid", 0)))
		get_tree().quit(0)
		return
	# el que llega tarde
	await get_tree().create_timer(14.0).timeout
	print("[tardedanio] INVITADO: voxels en mi mundo = %d" % int(world.get_stats().get("voxels_solid", 0)))
	get_tree().quit(0)


## --trestiros: LO QUE DESTRUYE UN INVITADO, ¿LO VEN LOS DEMAS INVITADOS?
##
## HACEN FALTA TRES. Con dos no se puede ver el fallo: uno de los dos siempre es el anfitrion, y al
## anfitrion si le llega todo. Es una estrella —nadie esta conectado a nadie salvo al anfitrion—, asi
## que lo que manda un invitado por `rpc()` no llega a los OTROS invitados si nadie lo reparte.
##
## Dispara SOLO el segundo invitado. Los otros dos cuentan cuantos voxels han perdido.
func _tres_tiros_test() -> void:
	# YA NO HACE FALTA ESPERAR A MANO: el juego no deja empezar hasta que todos han cargado. Antes,
	# con 16 s fijos, cada corrida daba una cosa (30 disparos recibidos, luego 60, luego 0) porque se
	# estaba midiendo una carrera. Ahora se espera a que el propio juego diga que se juega.
	for i in 90:
		await get_tree().create_timer(1.0).timeout
		if Net.is_online() and Net.partida_arrancada and not loading:
			break
	# SIN BOTS: tambien disparan y rompen, y su ruido se mezcla con lo que quiero medir. La primera
	# medicion limpia dio 236/210/225 y la diferencia era esto, no los disparos.
	Settings.bots_enabled = false
	if enemies != null:
		for e in enemies.get_children():
			e.queue_free()
	print("[trestiros] el juego dice que se puede jugar · jugadores=%d · sin bots" % Net.player_count())
	await get_tree().create_timer(2.0).timeout
	var soy := multiplayer.get_unique_id() if Net.is_online() else 1
	var quien := "ANFITRION" if Net.hosting else "INVITADO %d" % soy
	if not Net.is_online() or Net.player_count() < 3:
		print("[trestiros] %s: hacen falta TRES jugadores (hay %d)" % [quien, Net.player_count()])
		await get_tree().create_timer(30.0).timeout
		get_tree().quit(1)
		return
	var antes: int = int(world.get_stats().get("voxels_solid", 0))

	# el que dispara es el invitado de numero mas alto, y lo decide cada uno por su cuenta
	var ids: Array = []
	for id in Net.players.keys():
		if int(id) != 1:
			ids.append(int(id))
	ids.sort()
	var tirador: int = int(ids[-1]) if not ids.is_empty() else 0
	if soy == tirador:
		print("[trestiros] %s: disparo yo, 30 balas · online=%s game=%s peer=%s" % [
			quien, str(Net.is_online()), "si" if Net.game != null else "NO",
			str(multiplayer.multiplayer_peer != null)])
		var o: Vector3 = player.global_position + Vector3(0, 1.2, 0)
		var d := Vector3(1, 0, 0)
		var mandados := 0
		for i in 30:
			Net.net_shoot(world, o, d, 40.0, 220)
			mandados += 1
			await get_tree().create_timer(0.08).timeout
		print("[trestiros] %s: he llamado a net_shoot %d veces" % [quien, mandados])
	await get_tree().create_timer(8.0).timeout
	var despues: int = int(world.get_stats().get("voxels_solid", 0))
	var perdidos := antes - despues
	print("[trestiros] %s: voxels destruidos en MI pantalla = %d · disparos ajenos recibidos %d, aplicados %d, perdidos %d" % [
		quien, perdidos, Net.tiros_recibidos, Net.tiros_aplicados, Net.tiros_perdidos])
	await get_tree().create_timer(6.0).timeout
	get_tree().quit(0)


## --lanzombis: ¿VE EL INVITADO LOS ZOMBIS, Y REVIVE AL SUPERAR LA OLEADA?
##
## OJO CON EL NOMBRE: NO puede empezar por "--pve". El lobby arranca la partida el solo con cualquier
## flag que empiece asi, y entonces se salta la creacion de la sala: las dos instancias acababan
## jugando SOLAS (online=false) y la prueba medía dos partidas de un jugador creyendo medir una LAN.
##
## Dos cosas que el usuario vio jugando y que solo pasan en red:
##   1. recibia daño de bichos que NO VEIA (se perdio los avisos mientras cargaba el mapa);
##   2. al superar la oleada salia la tienda y los muertos seguian de espectadores.
func _pve_lan_test() -> void:
	await get_tree().create_timer(14.0).timeout
	var quien := "ANFITRION" if Net.hosting else "INVITADO"
	print("[pvelan] %s: online=%s hosting=%s jugadores=%d modo=%s pve=%s" % [
		quien, str(Net.is_online()), str(Net.hosting), Net.player_count(),
		Settings.modo, "si" if pve != null else "NO"])
	if pve == null:
		print("[pvelan] %s: FALLO, no hay PvE en marcha (mapa %s)" % [quien, current_map])
		get_tree().quit(1)
		return
	# CON BANDO PUESTO, que es como se juega de verdad. Las salas online reparten bando solas desde
	# que los bots simulan jugadores, y `player.die()` miraba el bando ANTES que el modo oleadas: sin
	# esto la prueba corre sin bando y no pisa nunca ese camino, que es justo el que fallaba.
	if Net.my_team() == "":
		Net.choose_team(Net.TEAM_T if Net.hosting else Net.TEAM_CT)
		await get_tree().create_timer(1.0).timeout
	print("[pvelan] %s: bando '%s'" % [quien, Net.my_team()])
	# INVULNERABLES ANTES DE QUE SALGA LA OLEADA. Dos jugadores de banco no se mueven ni disparan:
	# mueren en los primeros segundos, y en cuanto cae el ultimo la partida se da por TERMINADA y el
	# anfitrion DEJA DE MANDAR posturas. Midiendo despues de eso las copias del invitado parecen
	# congeladas -y se midio: 255 paquetes mandados y ni uno mas- y parece un fallo gordo de red
	# cuando lo unico que pasa es que la partida ya habia acabado. Se les quita al terminar de medir.
	if is_instance_valid(player):
		player.invulnerable = true
	# que empiece la oleada aunque nadie pulse nada
	if Net.hosting and pve.has_method("_empezar_oleada"):
		pve._empezar_oleada()
	await get_tree().create_timer(12.0).timeout

	# ID A ID, Y VARIAS VECES. Contar bichos una vez no basta: el usuario ve los invisibles DESPUES de
	# un rato y de varias oleadas, no al empezar. Cada maquina escupe la LISTA DE NUMEROS de red que
	# tiene, y comparando las dos listas se sabe exactamente cual falta y en que momento.
	# Ademas se mira la VIDA: "los zombies lo seguian y no recibia daño" tambien hay que poder verlo.
	var mios := 0
	for vuelta in 10:
		var ids: Array = []
		for n in get_tree().get_nodes_in_group("criaturas"):
			if is_instance_valid(n) and not bool(n.get("muerta")):
				ids.append(int(n.get("red_id")))
		ids.sort()
		mios = ids.size()
		var vida: float = float(player.health) if is_instance_valid(player) else -1.0
		# EN QUE ESTADO ESTA EL JUGADOR. Vino de una medicion que no cuadraba: vida 0 durante un
		# minuto, sin espectador y sin derrota. Con la vida sola no se distingue "muerto y esperando"
		# de "a cero y sin que nadie se haya enterado", que es el estado en el que los bichos dejan de
		# atacarte -miran `health > 0`- y parece que te siguen sin hacerte daño.
		var espect: bool = "spectating" in player and bool(player.spectating)
		var invul: bool = "invulnerable" in player and bool(player.invulnerable)
		var yo: int = multiplayer.get_unique_id() if Net.is_online() else 1
		print("[pvelan] %s t=%02d criaturas=%d vida=%.0f espectando=%s invul=%s muerto_para_red=%s ids=%s" % [
			quien, vuelta, mios, vida, str(espect), str(invul), str(Net.is_dead(yo)),
			",".join(PackedStringArray(ids.map(func(x): return str(x))))])
		# ¿VEMOS TODOS LO MISMO? Que el invitado TENGA los catorce bichos no quiere decir que los vea
		# HACER lo mismo: el invitado no piensa, recibe postura y animacion diez veces por segundo y se
		# desliza hacia ellas. Aqui cada maquina escupe, bicho a bicho, donde lo tiene y que animacion
		# le esta poniendo, con la hora del reloj; comparando los dos volcados se sabe cuanto se
		# separan de verdad las dos pantallas.
		var ahora_reloj: float = Time.get_unix_time_from_system()
		print("[zdiag] %s t=%02d posturas mandadas=%d recibidas=%d terminado=%s oleada=%d" % [
			quien, vuelta, int(pve.get("_diag_mandados")), int(pve.get("_diag_recibidos")),
			str(bool(pve.get("terminado"))), int(pve.get("oleada"))])
		for n in get_tree().get_nodes_in_group("criaturas"):
			if not is_instance_valid(n) or bool(n.get("muerta")):
				continue
			print("[zsync] %s %.2f %d %.2f %.2f %.2f %s" % [
				quien, ahora_reloj, int(n.get("red_id")), n.global_position.x, n.global_position.y,
				n.global_position.z, String(n.get("_anim_actual"))])
		await get_tree().create_timer(3.0).timeout
	# y ahora mortales otra vez, que lo que viene se mide con muertes de verdad
	if is_instance_valid(player):
		player.invulnerable = false
		player.health = 8.0
	await get_tree().create_timer(14.0).timeout
	# LAS TRES COSAS QUE EL USUARIO VIO EN UNA PARTIDA DE VERDAD, medidas aqui:
	#   1. muertos todos, la pantalla de DERROTA no llegaba nunca;
	#   2. al revivir tras superar la oleada, los bichos ya no te hacian daño;
	#   3. bichos que pegan y no se ven.
	var fallos := 0
	var pve_terminado: bool = pve != null and ("terminado" in pve) and bool(pve.terminado)
	var todos_muertos := true
	for id in Net.players.keys():
		if not Net.is_dead(int(id)):
			todos_muertos = false
	if todos_muertos and not pve_terminado:
		print("[pvelan] %s FALLO: todos muertos y la partida sigue sin declarar derrota" % quien)
		fallos += 1
	elif todos_muertos:
		print("[pvelan] %s OK  todos muertos -> partida terminada" % quien)
	# 2. QUE EL REVIVIDO VUELVA A SER MORTAL. Se revive a mano y se mira el banderin de invulnerable,
	#    que es el que se quedaba puesto desde la escena de "te tiene".
	if is_instance_valid(player):
		if "spectating" in player and bool(player.spectating) and player.has_method("revivir_en_oleada"):
			player.revivir_en_oleada()
			await get_tree().create_timer(1.0).timeout
		var inv: bool = "invulnerable" in player and bool(player.invulnerable)
		if inv:
			print("[pvelan] %s FALLO: revivido pero INVULNERABLE (los bichos no le harian daño)" % quien)
			fallos += 1
		else:
			print("[pvelan] %s OK  revivido y mortal (vida %.0f)" % [quien, player.health])
	if Net.hosting:
		print("[pvelan] %s (%d fallos)" % ["TODO BIEN" if fallos == 0 else "HAY FALLOS", fallos])
		get_tree().quit(0 if fallos == 0 else 1)
		return
	# el invitado es el que tiene que verlas: si no ve ninguna, es el fallo de los zombis invisibles
	if mios == 0:
		print("[pvelan] INVITADO FALLO: no veo ni un bicho (los invisibles que pegan)")
		fallos += 1
	else:
		print("[pvelan] INVITADO OK  veo los bichos del anfitrion")
	# y ahora el revivir: se finge que he caido y que el anfitrion supera la oleada
	if is_instance_valid(player) and player.has_method("die"):
		player.die()
		await get_tree().create_timer(2.0).timeout
		var espectando: bool = "spectating" in player and bool(player.spectating)
		print("[pvelan] INVITADO: tras morir, espectando=%s" % str(espectando))
		Net.revivir_todos.connect(func(): print("[pvelan] INVITADO: me llega la orden de revivir"))
	await get_tree().create_timer(10.0).timeout
	print("[pvelan] %s (%d fallos)" % ["TODO BIEN" if fallos == 0 else "HAY FALLOS", fallos])
	get_tree().quit(0 if fallos == 0 else 1)


## --desatasco: EL GOLPE DE DESATASCO, EN EL SITIO REAL DONDE SE ATASCO EL GOLIAT.
##
## (93, 1, 161), medido en vivo con el usuario jugando. Alli le encerraban hormigon (170) y metal (220)
## y su golpe tenia potencia 160. Se planta al Goliat ahi, da UN golpe, y se cuenta:
##   - el solido ROMPIBLE que le rodea (anillo de su radio + 1,2 m, de los pies a la cabeza);
##   - el SUELO bajo sus pies, que el usuario pidio que no se tocara.
## --zombirag: "LOS ZOMBIES AL MATARLOS NO HACEN RAGDOLL, SE QUEDAN DUROS PARADOS". Se matan criaturas de
## verdad (con el daño de un tiro) y se mira si su esqueleto se mueve despues: cuanto baja la cabeza y
## cuantos huesos cambian de pose entre el instante de la muerte y dos segundos despues.
func _zombi_rag_test() -> void:
	await get_tree().create_timer(8.0).timeout
	if pve == null:
		print("[zombirag] FALLO: hace falta --map=pve_cuarentena")
		get_tree().quit(1)
		return
	player.invulnerable = true
	pve.empezar_ya(0)
	var bichos: Array = []
	for _w in 30:
		await get_tree().create_timer(1.0).timeout
		bichos = get_tree().get_nodes_in_group("criaturas").filter(func(c): return is_instance_valid(c) and not c.muerta)
		if bichos.size() >= 4:
			break
	print("[zombirag] criaturas vivas: %d" % bichos.size())
	var n := 0
	for c in bichos.slice(0, 6):
		# delante del jugador, en el suelo, para que haya colision
		c.global_position = player.global_position + (-player.global_transform.basis.z) * (3.0 + n * 1.5) + Vector3.UP * 0.3
		n += 1
	for _f in 20:
		await get_tree().physics_frame
	var datos_bichos := []
	for c in bichos.slice(0, 6):
		var hs: Array = c._modelo.find_children("*", "Skeleton3D", true, false) if c._modelo else []
		var skel: Skeleton3D = hs[0] if not hs.is_empty() else null
		datos_bichos.append([c, skel])
	# A TIROS DE VERDAD, con el arma del jugador (`player.fire`): se le apunta al pecho y se dispara hasta
	# que cae y un poco mas, que es lo que hace uno jugando.
	var fwd: Vector3 = -player.global_transform.basis.z
	if "--zombirag=tiros" in OS.get_cmdline_user_args():
		for d in datos_bichos:
			var c = d[0]
			if not is_instance_valid(c):
				continue
			var extra := 0
			for _t in 200:
				var obj: Vector3 = c.global_position + Vector3.UP * 1.1
				var v: Vector3 = obj - player.cam.global_position
				player.look.x = atan2(-v.x, -v.z)
				player.look.y = atan2(v.y, Vector2(v.x, v.z).length())
				player.fire_cd = 0.0
				player.fire()
				await get_tree().create_timer(0.1).timeout
				if c.muerta:
					extra += 1
					if extra > (0 if "--sinremate" in OS.get_cmdline_user_args() else 6):
						break
			if is_instance_valid(c._ragdoll):
				for rb in c._ragdoll._cuerpos.values():
					rb.contact_monitor = true
					rb.max_contacts_reported = 6
			await get_tree().create_timer(1.8).timeout
			var skel: Skeleton3D = d[1]
			if is_instance_valid(skel):
				var ymin := 1.0e9
				var ymax := -1.0e9
				for i in skel.get_bone_count():
					var q: Vector3 = (skel.global_transform * skel.get_bone_global_pose(i)).origin
					ymin = minf(ymin, q.y)
					ymax = maxf(ymax, q.y)
				var rd = c._ragdoll
				var info := "sin ragdoll"
				if is_instance_valid(rd):
					var dorm := 0
					var alto_rb := -1.0e9
					for rb in rd._cuerpos.values():
						if is_instance_valid(rb):
							if rb.sleeping:
								dorm += 1
							alto_rb = maxf(alto_rb, rb.global_position.y - ymin)
					info = "ragdoll %d cuerpos, %d dormidos, cuerpo mas alto a %.2f m" % [rd._cuerpos.size(), dorm, alto_rb]
					if ymax - ymin > 0.8:
						for nb in rd._cuerpos.keys():
							var rb = rd._cuerpos[nb]
							var toca := []
							for o in rb.get_colliding_bodies():
								toca.append("%s(%s)" % [o.name, o.get_class()])
							print("[zombirag]      %s y=%.2f vel=%.2f toca %s" % [nb, rb.global_position.y - ymin, rb.linear_velocity.length(), str(toca)])
						var pc: Vector3 = rd._cuerpos.values()[0].global_position
						print("[zombirag]      bicho vivo mas cerca: %.2f m · jugador a %.2f m · cadaver-capsula frozen=%s" % [
							get_tree().get_nodes_in_group("criaturas").filter(func(o): return is_instance_valid(o) and not o.muerta).map(func(o): return o.global_position.distance_to(pc)).min() if true else 0.0,
							player.global_position.distance_to(pc), str(c._cuerpo.freeze if is_instance_valid(c._cuerpo) else "?")])
				print("[zombirag] a tiros: muerta=%s · altura del esqueleto %.2f m (de pie ~1.6, tumbado < 0.6) · %s" % [str(c.muerta), ymax - ymin, info])
			else:
				print("[zombirag] a tiros: esqueleto ya no existe")
	else:
		for ronda in 4:
			for d in datos_bichos:
				d[0].take_damage(float(d[0].datos.get("vida", 100.0)) * 0.2, fwd * 6.6)
			await get_tree().create_timer(0.08).timeout
		for d in datos_bichos:
			d[0].take_damage(9999.0, fwd * 6.6)
	if "--zombirag=tiros" in OS.get_cmdline_user_args():
		print("[zombirag] eventos %s" % str(CriaturaScript.eventos))
		var r := {"bajas": Combat.partida_bajas_pve, "dano": int(Combat.partida_dano), "objetivos": 0, "mvp": true}
		print("[premio] a tiros: mis bajas %d · daño %d · monedas ganando %s · perdiendo %s" % [
			Combat.partida_bajas_pve, int(Combat.partida_dano), str(Settings.monedas_de_partida(r, true)),
			str(Settings.monedas_de_partida(r, false))])
		get_tree().quit(0)
		return
	await get_tree().physics_frame
	await get_tree().physics_frame
	var foto := func(skel: Skeleton3D) -> Array:
		var out := []
		if skel == null or not is_instance_valid(skel):
			return out
		for i in skel.get_bone_count():
			out.append((skel.global_transform * skel.get_bone_global_pose(i)).origin)
		return out
	var antes := []
	for d in datos_bichos:
		antes.append(foto.call(d[1]))
	await get_tree().create_timer(4.0).timeout
	for k in datos_bichos.size():
		var c = datos_bichos[k][0]
		var skel: Skeleton3D = datos_bichos[k][1]
		var despues: Array = foto.call(skel)
		var movidos := 0
		var max_baja := 0.0
		for i in mini(despues.size(), (antes[k] as Array).size()):
			var dv: Vector3 = despues[i] - antes[k][i]
			if dv.length() > 0.05:
				movidos += 1
			max_baja = maxf(max_baja, -dv.y)
		var rd = c._ragdoll if is_instance_valid(c) else null
		var cuerpos := 0
		var dormidos := 0
		if is_instance_valid(rd):
			for rb in rd._cuerpos.values():
				if is_instance_valid(rb):
					cuerpos += 1
					if rb.sleeping:
						dormidos += 1
		var ymin := 1.0e9
		var ymax := -1.0e9
		for q in despues:
			ymin = minf(ymin, (q as Vector3).y)
			ymax = maxf(ymax, (q as Vector3).y)
		print("[zombirag]    altura del cuerpo tras 2 s: %.2f m (de pie ~1.6, tumbado < 0.6)" % (ymax - ymin))
		print("[zombirag] %s: huesos %d, movidos %d, lo que mas bajo %.2f m · ragdoll %s (%d cuerpos, %d dormidos) · anim %s" % [
			String(c.tipo) if is_instance_valid(c) else "?", skel.get_bone_count() if skel else -1, movidos, max_baja,
			str(is_instance_valid(rd)), cuerpos, dormidos,
			(c._anim.is_playing() if is_instance_valid(c) and c._anim else "sin")])
	print("[zombirag] eventos %s" % str(CriaturaScript.eventos))
	get_tree().quit(0)


## --golpemanos: LOS GOLPES DEL GOLIAT NO SON EXPLOSIONES. El usuario: "el boss golpea y se escucha el
## ruido de una explosion de granada o misil". Se le hace dar cada golpe que rompe (al suelo, arrancar la
## roca, desatasco) y se cuentan las explosiones (fuego + estruendo) y si rompio algo.
## --apuntacorriendo: APUNTAR MIENTRAS CORRES. El usuario: "veo como el arma sube de mas y se acomoda".
## Se corre, se apunta, y se mira la ALTURA del arma fotograma a fotograma: no puede subir por encima de
## donde acaba (la mira), que es justo lo que hacia al mezclarse la pose de correr con la de apuntar.
func _apuntar_corriendo_test() -> void:
	await get_tree().create_timer(6.0).timeout
	player.set("invulnerable", true)
	Input.action_press("sprint")
	Input.action_press("move_forward")
	player.touch_move = Vector2(0.0, -1.0)
	for _i in 70:
		await get_tree().process_frame
	var y_corriendo: float = player.weapon_pivot.position.y
	player.set_touch_aim(true)
	var y_max := -99.0
	for _i in 60:
		await get_tree().process_frame
		y_max = maxf(y_max, player.weapon_pivot.position.y)
	for _i in 40:
		await get_tree().process_frame
	var y_final: float = player.weapon_pivot.position.y
	Input.action_release("sprint")
	Input.action_release("move_forward")
	player.touch_move = Vector2.ZERO
	var sube: float = (y_max - y_final) * 100.0
	print("[apuntacorriendo] corriendo y=%.3f · apuntando y=%.3f · lo mas alto durante el cambio y=%.3f" % [
		y_corriendo, y_final, y_max])
	print("[apuntacorriendo] se pasa de largo %.1f cm · %s" % [sube, "BIEN (no sube de mas)" if sube < 1.5 else "MAL: sigue subiendo de mas"])
	get_tree().quit(0 if sube < 1.5 else 1)


## --killcamtest: LA CAMARA DE MUERTE Y EL ESPECTADOR. Se mata al jugador con un bot enemigo y se
## comprueba: que la camara se va con QUIEN TE MATO y mira a donde caiste, que al acabar pasa a
## espectar a un compañero, y que disparando se cambia de compañero (antes miraba siempre al mismo).
## --saltohabtest: EL SALTO DEMOLEDOR, CUANTO Y COMO DE ALTO. Al suelo a 14 m, al frente en horizontal y al cielo: la
## altura de la cima sobre donde salio, lo que recorre y lo que dura (sin contar el impulso ni el golpe).
func _salto_test() -> void:
	await get_tree().create_timer(7.0).timeout
	player.invulnerable = true
	for e in enemies.get_children():
		e.queue_free()
	var h = player.get("_hab")
	var p0: Vector3 = player.global_position
	var ojo: float = player.cam.global_position.y - p0.y
	for caso in [["al suelo a 14 m", -atan(ojo / 14.0)], ["al frente", 0.0], ["al cielo (60 grados)", deg_to_rad(60.0)],
			["derecho arriba", deg_to_rad(88.0)]]:
		print("[saltotest] %s: coloco" % String(caso[0]))
		player.global_position = p0
		player.velocity = Vector3.ZERO
		await get_tree().create_timer(0.8).timeout
		player.look = Vector2(0.9, float(caso[1]))
		await get_tree().physics_frame
		h.tipo = "salto"
		h.recarga = 0.0
		print("[saltotest]   activar -> %s (fase %s, clip %s)" % [str(h.activar()), h.fase, player.avatar.current_clip])
		var cima := -INF
		var vuela := 0.0
		var t := 0.0
		var fase_antes := ""
		while t < 6.0:
			await get_tree().physics_frame
			var dt := get_physics_process_delta_time()
			t += dt
			if h.fase != fase_antes:
				fase_antes = h.fase
				print("[saltotest]   t=%.2f fase=%s clip=%s pos=%s vel=%s" % [t, h.fase, player.avatar.current_clip, str(player.global_position), str(player.velocity)])
			cima = maxf(cima, player.global_position.y - p0.y)
			if h.fase == "salto":
				vuela += dt
			if h.fase == "salto_golpe" or h.fase == "":
				break
		var p1: Vector3 = player.global_position
		print("[saltotest] %-22s cima %.1f m sobre la salida · recorre %.1f m · vuela %.2f s (calculado %.2f)" % [
			String(caso[0]), cima, Vector2(p1.x - p0.x, p1.z - p0.z).length(), vuela, float(h._salto_dur)])
		await get_tree().create_timer(1.0).timeout
	get_tree().quit()


