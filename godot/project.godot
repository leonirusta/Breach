[input_devices]

pointing/emulate_mouse_from_touch=false

[physics]

common/max_physics_steps_per_frame=2
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=6

[rendering]

driver/threads/thread_model=2

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
occlusion_culling/occlusion_rays_per_thread=1024
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.08, 1)
